  "keyEvents": [
    {
      "title": "Abimelek søker støtte i Sikem",
      "description": "Abimelek overtalte sin mors slektninger i Sikem til å støtte ham som hersker, og de ga ham sytti sølvstykker fra Ba'al-Berits tempel for å leie menn.",
      "verses": [
        {
          "bookId": 7,
          "chapter": 9,
          "verses": [
            1,
