  ],
  "keyEvents": [
    {
      "title": "Kallet som ung",
      "description": "Gud kalte Jeremia til profet allerede fra mors liv, og lovet å være med ham tross motstand.",
      "verses": [
        {
          "bookId": 24,
          "chapter": 1,
          "verses": [
            4,
            5,
            6,
            7,
            8,
            9,
            10
          ]
        }
      ]
    },
    {
      "title": "Advarselen til Juda",
      "description": "Jeremia advarte folket om at de hadde forlatt Herren, kilden med levende vann, for sprukne brønner.",
      "verses": [
        {
          "bookId": 24,
          "chapter": 2,
          "verses": [
            11,
            12,
            13
          ]
        }
      ]
    },
    {
      "title": "I brønnen",
      "description": "Jeremia ble kastet i en gjørmete brønn for sine profetier, men ble reddet av etiopieren Ebed-Melek.",
      "verses": [
        {
          "bookId": 24,
          "chapter": 38,
          "verses": [
            6,
            7,
            10,
            11,
            12,
            13
          ]
        }
      ]
    },
    {
      "title": "Den nye pakt",
      "description": "Jeremia profeterte om en ny pakt der Gud ville skrive sin lov på hjertene og tilgi folkets synd.",
      "verses": [
        {
          "bookId": 24,
          "chapter": 31,
          "verses": [
            31,
            32,
            33,
            34
          ]
        }
      ]
    },
    {
      "title": "Håp for fremtiden",
      "description": "Tross ødeleggelsen lovet Jeremia at Gud hadde fredsplaner for folket, med fremtid og håp.",
      "verses": [
        {
          "bookId": 24,
          "chapter": 29,
          "verses": [
            11,
            12,
            13,
            14
          ]
        }
      ]
    }
