  "keyEvents": [
    {
      "title": "Sjimi forbanner David",
      "description": "Da David flyktet fra Jerusalem under Absaloms opprør, kom Sjimi ut og forbannet ham, kastet steiner og jord på ham, og kalte ham en blodets mann og en Belials mann.",
      "verses": [
        {
          "bookId": 10,
