          ]
        }
      ]
    },
    {
      "title": "Abisjaj vil drepe Sjimi",
      "description": "Abisjaj, sønn av Seruja, ville hugge hodet av Sjimi for å ha forbannet kongen, men David nektet og sa at Herren hadde bedt Sjimi om å forbanne ham.",
      "verses": [
        {
          "bookId": 10,
          "chapter": 16,
          "verses": [
            9,
            10,
            11
          ]
        }
      ]
    },
    {
      "title": "Sjimi ber om tilgivelse",
      "description": "Etter Absaloms nederlag kom Sjimi med tusen mann fra Benjamin og kastet seg ned for David ved Jordan og ba om nåde. David sverget at han ikke skulle drepe ham.",
      "verses": [
        {
          "bookId": 10,
          "chapter": 19,
          "verses": [
            16,
            17,
            18,
            19,
            20,
            21,
            22,
            23
          ]
        }
      ]
    },
    {
      "title": "Davids instruks til Salomo om Sjimi",
      "description": "På sitt dødsleie ga David sin sønn Salomo beskjed om å ikke la Sjimi slippe ustraffet, men å bringe hans grå hår ned til dødsriket med blod.",
      "verses": [
        {
          "bookId": 11,
          "chapter": 2,
          "verses": [
            8,
            9
          ]
        }
      ]
    },
    {
      "title": "Salomo setter betingelser for Sjimi",
      "description": "Kong Salomo påla Sjimi å bo i Jerusalem og aldri forlate byen, med trussel om dødsstraff dersom han brøt avtalen. Sjimi aksepterte betingelsen.",
      "verses": [
        {
          "bookId": 11,
          "chapter": 2,
          "verses": [
            36,
            37,
            38
          ]
        }
      ]
    },
    {
      "title": "Sjimis henrettelse",
      "description": "Da to av Sjimis slaver rømte til Gat, dro Sjimi dit for å hente dem tilbake og brøt dermed avtalen med Salomo. Salomo ga ordre om at Sjimi skulle henrettes, og Benaja slo ham i hjel.",
      "verses": [
