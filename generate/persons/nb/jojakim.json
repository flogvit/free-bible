      "sallum"
    ],
    "spouse": "nehusta-mor",
    "children": [
      "jojakin"
    ]
  },
  "relatedPersons": [
    "jeremia",
    "nebukadnesar",
    "daniel",
    "baruk"
  ],
  "keyEvents": [
    {
      "title": "Innsatt som konge av farao Neko",
      "description": "Etter at Joahas ble avsatt, innsatte farao Neko Eljakim som konge og endret navnet hans til Jojakim. Han måtte betale tribut til Egypt.",
      "verses": [
        {
          "bookId": 12,
          "chapter": 23,
          "verses": [
            34,
            35
          ]
        }
      ]
    },
    {
      "title": "Gjorde det som var ondt i Herrens øyne",
      "description": "Jojakim fulgte ikke sin far Josias gudfryktige eksempel, men førte folket bort fra Herren og praktiserte avgudsdyrkelse.",
      "verses": [
        {
          "bookId": 12,
          "chapter": 23,
          "verses": [
            36,
            37
          ]
        }
      ]
    },
    {
      "title": "Brenner Jeremias bokrull",
      "description": "Da Jeremias profetier ble lest for kongen, skar han bokrullen i stykker og kastet den i ilden, i trass mot Guds ord.",
      "verses": [
        {
          "bookId": 24,
          "chapter": 36,
          "verses": [
            21,
            22,
            23,
            24,
            25
          ]
        }
      ]
    },
    {
      "title": "Blir vasall under Nebukadnesar",
      "description": "Kong Nebukadnesar av Babylon kom opp mot Jerusalem, og Jojakim ble hans tjener i tre år før han gjorde opprør.",
      "verses": [
        {
          "bookId": 12,
          "chapter": 24,
          "verses": [
            1
          ]
        }
      ]
    },
    {
      "title": "Drepte profeten Uria",
      "description": "Jojakim forfulgte profeter som talte Guds ord og henrettet profeten Uria som hadde profetert mot Jerusalem.",
      "verses": [
        {
          "bookId": 24,
          "chapter": 26,
          "verses": [
            20,
            21,
            22,
            23
          ]
        }
      ]
    },
    {
      "title": "Hans død og ettermæle",
      "description": "Jeremia profeterte at Jojakim skulle få et eselsbegravelse og bli kastet utenfor Jerusalems porter uten ære.",
      "verses": [
        {
          "bookId": 24,
          "chapter": 22,
          "verses": [
            18,
            19
          ]
        }
      ]
    }
