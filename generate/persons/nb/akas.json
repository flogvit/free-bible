{
  "id": "akas",
  "name": "Akas (Jotams sønn)",
  "title": "Judas ugudelige konge",
  "era": "divided-kingdom",
  "lifespan": "ca. 735-715 f.Kr.",
  "summary": "Akas var konge av Juda og sønn av den gudfryktige Jotam. Han var en av de mest ugudelige kongene i Judas historie, som innførte avgudsdyrkelse og til og med ofret sin egen sønn til avguden Molok. Hans regjering var preget av utenrikspolitisk krise og åndelig forfall.",
  "roles": [
    "konge"
  ],
  "family": {
    "father": "jotam",
    "mother": null,
    "siblings": [],
    "spouse": "abi",
    "children": [
      "hiskia"
    ]
  },
  "relatedPersons": [
    "jesaja",
    "hiskia",
    "tiglat-pileser",
    "pekah",
    "resin"
  ],
  "keyEvents": [
    {
      "title": "Blir konge over Juda",
      "description": "Akas ble konge som tjueåring og regjerte i seksten år i Jerusalem. Han fulgte ikke Herrens veier som sin stamfar David.",
      "verses": [
        {
          "bookId": 12,
          "chapter": 16,
          "verses": [
            1,
            2
          ]
        }
      ]
    },
    {
      "title": "Ofrer sin sønn til avguden",
      "description": "Akas lot sin sønn gå gjennom ilden etter de avskyelige skikkene til folkeslagene som Herren hadde drevet ut for israelittene.",
      "verses": [
        {
          "bookId": 12,
          "chapter": 16,
          "verses": [
            3,
            4
          ]
        }
      ]
    },
    {
      "title": "Den syrisk-efraimitiske krig",
      "description": "Kong Resin av Syria og kong Pekah av Israel beleiret Jerusalem. Jesaja møtte Akas med løfte om at fiendenes plan ikke skulle lykkes.",
      "verses": [
        {
          "bookId": 23,
          "chapter": 7,
          "verses": [
            1,
            2,
            3,
            4,
            10,
            11,
            12,
            13,
            14
          ]
        }
      ]
    },
    {
      "title": "Søker hjelp hos Assyria",
      "description": "I stedet for å stole på Gud, sendte Akas gull og sølv fra tempelet til assyrerkongen Tiglat-Pileser og ba om militær hjelp.",
      "verses": [
        {
          "bookId": 12,
          "chapter": 16,
          "verses": [
            7,
            8,
            9
          ]
        }
      ]
    },
    {
      "title": "Bygger hedensk alter i tempelet",
      "description": "Etter å ha sett et alter i Damaskus, fikk Akas bygget en kopi og satte det opp i Herrens tempel, og endret tempelets gudstjeneste.",
      "verses": [
        {
          "bookId": 12,
          "chapter": 16,
          "verses": [
            10,
            11,
            12,
            13,
            14,
            15,
            16
          ]
        }
      ]
    },
    {
      "title": "Akas' død og ettermæle",
      "description": "Akas døde og ble begravet i Jerusalem, men ikke i kongegravene. Hans sønn Hiskia ble konge etter ham og reverserte farens ugudelige reformer.",
      "verses": [
        {
          "bookId": 14,
