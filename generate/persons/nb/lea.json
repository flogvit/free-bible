  "keyEvents": [
    {
      "title": "Bryllupet med Jakob",
      "description": "Laban ga Lea til Jakob i stedet for Rakel på bryllupsnatten, noe som førte til Jakobs fortvilelse.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 29,
          "verses": [
            23,
            24,
            25
          ]
        }
      ]
    },
    {
      "title": "Gud så hennes smerte",
      "description": "Herren så at Lea var uelsket og åpnet hennes morsliv. Hun fødte Ruben og sa: 'Herren har sett min nød.'",
      "verses": [
        {
          "bookId": 1,
          "chapter": 29,
          "verses": [
            31,
            32
          ]
        }
      ]
    },
    {
      "title": "Judas fødsel",
      "description": "Da Lea fødte sin fjerde sønn, Juda, sa hun: 'Denne gang vil jeg prise Herren.' Fra Juda kom kongeslekten.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 29,
          "verses": [
            35
          ]
        }
      ]
    },
    {
      "title": "Levis fødsel",
      "description": "Lea fødte Levi, som ble stamfar til presteslekten og levittene.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 29,
          "verses": [
            34
          ]
        }
      ]
    },
    {
      "title": "Begravet med fedrene",
      "description": "Lea ble begravet i Makpela-hulen sammen med Abraham, Sara, Isak og Rebekka - familiens gravsted.",
      "verses": [
