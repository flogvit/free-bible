        {
          "bookId": 1,
          "chapter": 16,
          "verses": [
            11,
            12
          ]
        }
      ]
    },
    {
      "title": "Omskjærelsen",
      "description": "Ismael ble omskåret da han var 13 år, sammen med Abraham og alle menn i husholdet.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 17,
          "verses": [
            23,
            25,
            26
          ]
        }
      ]
    },
    {
      "title": "Løftet om tolv fyrster",
      "description": "Gud lovet Abraham at Ismael skulle bli fruktbar og bli far til tolv fyrster og et stort folk.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 17,
          "verses": [
            20
          ]
        }
      ]
    },
    {
      "title": "Sendt bort i ørkenen",
      "description": "Ismael og Hagar ble sendt bort etter at Sara så ham le av Isak. Gud reddet dem i ørkenen.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 21,
          "verses": [
