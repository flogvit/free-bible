  ],
  "keyEvents": [
    {
      "title": "Opphøyes til øverste embetsmann",
      "description": "Kong Ahasverus opphøyet Haman til den høyeste posisjonen blant alle sine fyrster, og alle kongens tjenere måtte bøye kne for ham.",
      "verses": [
        {
          "bookId": 17,
          "chapter": 3,
          "verses": [
            1,
            2
          ]
        }
      ]
    },
    {
      "title": "Mordekai nekter å bøye seg",
      "description": "Jøden Mordekai nektet å bøye kne eller kaste seg ned for Haman, noe som vakte Hamans raseri og førte til hans ønske om hevn.",
      "verses": [
        {
          "bookId": 17,
          "chapter": 3,
          "verses": [
            2,
            3,
            4,
            5
          ]
        }
      ]
    },
    {
      "title": "Planen om folkemord",
      "description": "Haman overbeviste kong Ahasverus om å utstede et dekret om å utrydde alle jøder i riket på den trettende dagen i måneden adar.",
      "verses": [
        {
          "bookId": 17,
          "chapter": 3,
          "verses": [
            8,
            9,
            10,
            11,
            12,
            13
          ]
        }
      ]
    },
    {
      "title": "Galgen reises for Mordekai",
      "description": "På sin kone Seresjs råd lot Haman reise en galge på femti alen for å henge Mordekai, mens han planla å be kongen om tillatelse.",
      "verses": [
        {
          "bookId": 17,
          "chapter": 5,
          "verses": [
            14
          ]
        }
      ]
    },
    {
      "title": "Ydmykelsen av Haman",
      "description": "Haman ble tvunget til å ære Mordekai offentlig ved å føre ham gjennom byen på kongens hest, iført kongelige klær.",
      "verses": [
        {
          "bookId": 17,
          "chapter": 6,
          "verses": [
            10,
            11,
            12
          ]
        }
      ]
    },
    {
      "title": "Hamans fall og henrettelse",
      "description": "Dronning Ester avslørte Hamans onde plan for kongen, og Haman ble hengt på den samme galgen han hadde reist for Mordekai.",
      "verses": [
        {
