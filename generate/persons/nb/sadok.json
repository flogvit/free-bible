  "keyEvents": [
    {
      "title": "Tjener som øversteprest under David",
      "description": "Sadok tjente som øversteprest sammen med Abjatar under kong Davids regjeringstid, og de delte ansvaret for prestetjenesten.",
      "verses": [
        {
          "bookId": 10,
          "chapter": 8,
          "verses": [
            17
          ]
        }
      ]
    },
    {
      "title": "Forble trofast under Absaloms opprør",
      "description": "Da Absalom gjorde opprør mot sin far David, ville Sadok følge kongen med paktens ark, men David sendte ham tilbake til Jerusalem som spion.",
      "verses": [
        {
          "bookId": 10,
          "chapter": 15,
          "verses": [
            24,
            25,
            26,
            27,
            29
          ]
        }
      ]
    },
    {
      "title": "Formidlet etterretning til David",
      "description": "Sadok og Abjatar sendte sine sønner for å bringe viktig informasjon til David om Absaloms planer, noe som bidro til Davids seier.",
      "verses": [
        {
          "bookId": 10,
          "chapter": 17,
          "verses": [
            15,
            16,
            17,
            21
          ]
        }
      ]
    },
    {
      "title": "Støttet Salomo som tronarving",
      "description": "Mens Abjatar støttet Adonja, forble Sadok trofast mot Davids ønske om at Salomo skulle bli konge.",
      "verses": [
        {
          "bookId": 11,
          "chapter": 1,
          "verses": [
            8,
            26
          ]
        }
      ]
    },
    {
      "title": "Salvet Salomo til konge",
      "description": "Sadok og profeten Natan salvet Salomo til konge ved Gihon-kilden etter Davids befaling, og sikret dermed den rettmessige tronarvingen.",
      "verses": [
        {
          "bookId": 11,
          "chapter": 1,
          "verses": [
            34,
            38,
            39,
            45
          ]
        }
      ]
    },
    {
      "title": "Ble eneste øversteprest",
      "description": "Etter at Abjatar ble avsatt av Salomo for sin støtte til Adonja, ble Sadok den eneste øversteprest i Israel.",
      "verses": [
        {
          "bookId": 11,
          "chapter": 2,
