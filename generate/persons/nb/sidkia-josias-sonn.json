{
  "id": "sidkia-josias-sonn",
  "name": "Sidkia (Josias sønn)",
  "title": "Judas siste konge",
  "era": "divided-kingdom",
  "lifespan": "ca. 618-586 f.Kr.",
  "summary": "Sidkia var den siste kongen av Juda før Babylons ødeleggelse av Jerusalem. Han ble innsatt som vasallkonge av Nebukadnesar, men hans opprør mot Babylon førte til Jerusalems fall og tempelets ødeleggelse i 586 f.Kr. Hans regjering var preget av svakhet og ulydighet mot Guds ord gjennom profeten Jeremia.",
  "roles": [
    "konge"
  ],
  "family": {
    "father": "josia",
    "mother": "hamutal",
    "siblings": [
      "jojakim",
      "joakas-jehus-sonn",
      "sjallum"
    ],
    "spouse": null,
    "children": []
  },
  "relatedPersons": [
    "jeremia",
    "nebukadnesar",
    "jojakin",
    "gedalja"
  ],
  "keyEvents": [
    {
      "title": "Innsatt som konge av Nebukadnesar",
      "description": "Nebukadnesar innsatte Sidkia som konge over Juda etter å ha bortført Jojakin til Babylon. Han var 21 år gammel da han ble konge og regjerte i elleve år.",
      "verses": [
        {
          "bookId": 12,
          "chapter": 24,
          "verses": [
            17,
            18
          ]
        }
      ]
    },
    {
      "title": "Gjorde det som var ondt i Herrens øyne",
      "description": "Sidkia fulgte ikke Herrens vilje og nektet å ydmyke seg for profeten Jeremia som talte Herrens ord til ham.",
      "verses": [
        {
          "bookId": 14,
          "chapter": 36,
          "verses": [
            12,
            13
          ]
        }
      ]
    },
    {
      "title": "Hemmelige samtaler med Jeremia",
      "description": "Sidkia søkte råd fra Jeremia i hemmelighet flere ganger, men manglet mot til å følge profetens råd om å overgi seg til babylonerne.",
      "verses": [
        {
          "bookId": 24,
          "chapter": 38,
          "verses": [
            14,
            15,
            16,
            17,
            18
          ]
        }
      ]
    },
    {
      "title": "Opprør mot Babylon",
      "description": "Sidkia brøt sin ed til Nebukadnesar og gjorde opprør ved å søke hjelp fra Egypt, noe som førte til Babylons beleiring av Jerusalem.",
      "verses": [
        {
          "bookId": 26,
          "chapter": 17,
          "verses": [
            15,
            16,
            17,
            18,
            19
          ]
        }
      ]
    },
    {
      "title": "Jerusalems fall og Sidkias flukt",
      "description": "Da byen falt, flyktet Sidkia om natten, men ble fanget på Jeriko-sletten. Han ble ført til Nebukadnesar i Ribla for dom.",
      "verses": [
        {
          "bookId": 12,
          "chapter": 25,
          "verses": [
            4,
            5,
            6
          ]
        }
      ]
    },
    {
      "title": "Sidkias grusomme skjebne",
      "description": "Nebukadnesar lot Sidkias sønner bli drept foran hans øyne, deretter ble hans øyne stukket ut, og han ble ført i lenker til Babylon hvor han døde.",
      "verses": [
        {
          "bookId": 24,
          "chapter": 52,
          "verses": [
            10,
            11
          ]
        }
      ]
    }
  ],
