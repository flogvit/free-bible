  "keyEvents": [
    {
      "title": "Benjamins fødsel og Rakels død",
      "description": "Benjamin ble født nær Betlehem mens familien var på reise. Rakel døde under fødselen og kalte ham Ben-Oni (min smertes sønn), men Jakob ga ham navnet Benjamin (lykkes sønn).",
      "verses": [
        {
          "bookId": 1,
          "chapter": 35,
          "verses": [
            16,
            17,
            18,
            19,
            20
          ]
        }
      ]
    },
    {
      "title": "Jakobs beskyttelse av Benjamin",
      "description": "Etter at Josef ble antatt død, nektet Jakob å la Benjamin reise til Egypt med brødrene sine, i frykt for å miste også ham.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 42,
          "verses": [
            4,
            36,
            38
          ]
        }
      ]
    },
    {
      "title": "Benjamin reiser til Egypt",
      "description": "På grunn av hungersnøden ble Jakob til slutt tvunget til å sende Benjamin til Egypt med brødrene sine for å kjøpe korn.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 43,
          "verses": [
            13,
            14,
            15,
            16
          ]
        }
      ]
    },
    {
      "title": "Josefs sølvbeger i Benjamins sekk",
      "description": "Josef testet brødrene sine ved å plante sitt sølvbeger i Benjamins sekk, noe som førte til at Juda tilbød seg selv som slave i Benjamins sted.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 44,
          "verses": [
            1,
            2,
            12,
            13,
            33,
            34
          ]
        }
      ]
    },
    {
      "title": "Gjenforening med Josef",
      "description": "Da Josef avslørte sin identitet, omfavnet han Benjamin og gråt, og Benjamin gråt ved hans hals.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 45,
          "verses": [
            14,
            22
          ]
        }
      ]
    },
    {
      "title": "Jakobs velsignelse",
      "description": "På dødsleiet velsignet Jakob Benjamin og beskrev ham som en glupsk ulv som fortærer bytte om morgenen og deler rov om kvelden.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 49,
          "verses": [
            27
          ]
        }
      ]
    }
  ],
