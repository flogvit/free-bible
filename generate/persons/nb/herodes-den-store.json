{
  "id": "herodes-den-store",
  "name": "Herodes den store",
  "title": "Jødenes konge",
  "era": "jesus",
  "lifespan": "73-4 f.Kr.",
  "summary": "Herodes var konge over Judea under romersk overherredømme. Han er kjent for massive byggeprosjekter, inkludert utvidelsen av tempelet i Jerusalem, men også for sin brutalitet og paranoia. Han er beryktet for barnemordet i Betlehem i forsøket på å drepe den nyfødte Messias.",
  "roles": [
    "konge"
  ],
  "family": {
    "father": "antipater",
    "mother": null,
    "siblings": [],
    "spouse": null,
    "children": [
      "arkelaus",
      "herodes-antipas",
      "filip"
    ]
  },
  "relatedPersons": [
    "jesus",
    "vismennene"
  ],
  "keyEvents": [
    {
      "title": "Vismennenes ankomst",
      "description": "Vismenn fra Østen kom til Jerusalem og spurte etter jødenes nyfødte konge. Herodes ble foruroliget.",
      "verses": [
        {
          "bookId": 40,
          "chapter": 2,
          "verses": [
            1,
            2,
            3
          ]
        }
      ]
    },
    {
      "title": "Forhøret om Messias",
      "description": "Herodes samlet yppersteprestene og spurte hvor Messias skulle fødes. De svarte: i Betlehem.",
      "verses": [
        {
          "bookId": 40,
          "chapter": 2,
          "verses": [
            4,
            5,
            6
          ]
        }
      ]
    },
    {
      "title": "Det falske ønske",
      "description": "Herodes sendte vismennene til Betlehem og ba dem gi beskjed så han kunne 'tilbe' barnet - men planla å drepe det.",
      "verses": [
        {
          "bookId": 40,
          "chapter": 2,
          "verses": [
            7,
            8
          ]
        }
      ]
    },
    {
      "title": "Raseriet",
      "description": "Da Herodes skjønte at vismennene hadde lurt ham, ble han rasende og planla å drepe alle guttebarn i Betlehem.",
      "verses": [
        {
          "bookId": 40,
          "chapter": 2,
          "verses": [
            16
          ]
        }
      ]
    },
    {
      "title": "Barnemordet",
      "description": "Herodes lot drepe alle guttebarn i Betlehem som var to år eller yngre - oppfyllelsen av Jeremias profeti om gråt i Rama.",
      "verses": [
        {
          "bookId": 40,
          "chapter": 2,
          "verses": [
            16,
            17,
            18
          ]
        }
      ]
    }
