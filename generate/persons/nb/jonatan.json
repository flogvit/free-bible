  "keyEvents": [
    {
      "title": "Seieren ved Mikmas",
      "description": "Jonatan og hans våpenbærer angrep filisternes forpost alene og skapte panikk som førte til israels seier.",
      "verses": [
        {
          "bookId": 9,
          "chapter": 14,
          "verses": [
            6,
            12,
            13,
            14,
            15
          ]
        }
      ]
    },
    {
      "title": "Vennskapspakten med David",
      "description": "Etter Davids seier over Goliat ble Jonatan og Davids sjeler knyttet sammen. Jonatan elsket David som seg selv.",
      "verses": [
        {
          "bookId": 9,
          "chapter": 18,
          "verses": [
            1,
            3,
            4
          ]
        }
      ]
    },
    {
      "title": "Forsvaret av David",
      "description": "Jonatan advarte David om farens mordplaner og talte Davids sak for Saul.",
      "verses": [
        {
          "bookId": 9,
          "chapter": 19,
          "verses": [
            1,
            2,
            4,
            5,
            6
          ]
        }
      ]
    },
    {
      "title": "Avskjeden ved steinen",
      "description": "Jonatan brukte pil-signalet for å advare David om at han måtte flykte. De gråt sammen og fornyet sin pakt.",
      "verses": [
        {
          "bookId": 9,
          "chapter": 20,
          "verses": [
            35,
            37,
            41,
            42
          ]
        }
      ]
    },
    {
      "title": "Døden på Gilboa",
      "description": "Jonatan falt sammen med sin far og brødre i kamp mot filisterne på Gilboa-fjellet. David sørget dypt over ham.",
      "verses": [
        {
