  ],
  "keyEvents": [
    {
      "title": "Fosterfar for Ester",
      "description": "Mordekai tok seg av sin foreldreløse kusine Hadassa (Ester) og oppfostret henne som sin egen datter.",
      "verses": [
        {
          "bookId": 17,
          "chapter": 2,
          "verses": [
            5,
            6,
            7
          ]
        }
      ]
    },
    {
      "title": "Konspirasjonen avslørt",
      "description": "Mordekai oppdaget en konspirasjon mot kong Ahasveros og varslet om den gjennom Ester, noe som reddet kongens liv.",
      "verses": [
        {
          "bookId": 17,
          "chapter": 2,
          "verses": [
            21,
            22,
            23
          ]
        }
      ]
    },
    {
      "title": "Nektet å bøye seg",
      "description": "Mordekai nektet å bøye seg for Haman, noe som vakte Hamans raseri og førte til planen om å utrydde jødene.",
      "verses": [
        {
          "bookId": 17,
          "chapter": 3,
          "verses": [
            2,
            4,
            5,
            6
          ]
        }
      ]
    },
    {
      "title": "Utfordringen til Ester",
      "description": "Mordekai sendte bud til Ester og utfordret henne: 'Hvem vet om du ikke er kommet til dronningverdigheten for en tid som denne?'",
      "verses": [
        {
          "bookId": 17,
          "chapter": 4,
          "verses": [
            13,
            14
          ]
        }
      ]
    },
    {
      "title": "Opphøyelsen",
      "description": "Etter Hamans fall ble Mordekai opphøyd til kongens nestkommanderende og arbeidet for sitt folks beste.",
      "verses": [
        {
