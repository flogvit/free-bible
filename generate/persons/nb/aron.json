{
  "id": "aron",
  "name": "Aron",
  "title": "Israels første øversteprest",
  "era": "exodus",
  "lifespan": "ca. 1530-1407 f.Kr.",
  "summary": "Aron var Moses' eldre bror og Israels første øversteprest. Han var Moses' talsmann overfor Farao og ledet folket i tilbedelse. Selv om han sviktet ved å lage gullkalven, ble han og hans etterkommere satt til prestetjeneste for alltid.",
  "roles": [
    "prest",
    "leder"
  ],
  "family": {
    "father": "amram",
    "mother": "jokebed",
    "siblings": [
      "moses",
      "miriam"
    ],
    "spouse": "elisjeba",
    "children": [
      "nadab",
      "abihu",
      "eleasar",
      "itamar"
    ]
  },
  "relatedPersons": [
    "moses",
    "miriam",
    "farao"
  ],
  "keyEvents": [
    {
      "title": "Kallet til å hjelpe Moses",
      "description": "Gud sendte Aron for å møte Moses i ørkenen og være hans talsmann fordi Moses mente han ikke kunne tale.",
      "verses": [
        {
          "bookId": 2,
          "chapter": 4,
          "verses": [
            14,
            15,
            16,
            27,
            28
          ]
        }
      ]
    },
    {
      "title": "For Farao",
      "description": "Aron talte til Farao på Moses' vegne og kastet staven som ble til en slange foran egypternes vismenn.",
      "verses": [
        {
          "bookId": 2,
          "chapter": 7,
          "verses": [
            9,
            10,
            12
          ]
        }
      ]
    },
    {
      "title": "Gullkalven",
      "description": "Da Moses var på fjellet, ga Aron etter for folkets press og laget en gullkalv som de tilba.",
      "verses": [
        {
          "bookId": 2,
          "chapter": 32,
          "verses": [
            1,
            2,
            3,
            4,
            5,
            24
          ]
        }
      ]
    },
    {
      "title": "Innvielsen til prest",
      "description": "Aron og sønnene ble innviet til prestetjeneste med spesielle klær og et syv dagers rituale.",
      "verses": [
        {
          "bookId": 3,
          "chapter": 8,
          "verses": [
            6,
            12,
            30,
            33,
            36
          ]
        }
      ]
    },
    {
      "title": "Staven som blomstret",
      "description": "For å bekrefte Arons utvelgelse lot Gud hans stav blomstre og bære mandler over natten.",
      "verses": [
        {
          "bookId": 4,
          "chapter": 17,
          "verses": [
            8,
            9,
            10,
            11
          ]
        }
      ]
    }
  ],
