          ]
        }
      ]
    },
    {
      "title": "Syv års arbeid",
      "description": "Jakob arbeidet syv år for å få Rakel, men de virket som få dager fordi han elsket henne så høyt.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 29,
          "verses": [
            18,
            20
          ]
        }
      ]
    },
    {
      "title": "Labans bedrag",
      "description": "Laban lurte Jakob og ga ham Lea i stedet. Jakob måtte arbeide syv år til for å få Rakel.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 29,
          "verses": [
            23,
            25,
            26,
            27,
            28
          ]
        }
      ]
    },
    {
      "title": "Josefs fødsel",
      "description": "Etter lang barnløshet husket Gud på Rakel, og hun fødte Josef. Hun sa: 'Gud har tatt bort min skam.'",
      "verses": [
        {
          "bookId": 1,
          "chapter": 30,
          "verses": [
            22,
            23,
            24
          ]
        }
      ]
    },
    {
      "title": "Døden ved Benjamins fødsel",
      "description": "Rakel døde da hun fødte Benjamin på veien til Efrat. Med siste pust kalte hun ham Ben-Oni, men Jakob kalte ham Benjamin.",
