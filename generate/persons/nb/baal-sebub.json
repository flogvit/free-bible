    {
      "title": "Beelzebul-anklagen mot Jesus",
      "description": "Fariseerne anklaget Jesus for å drive ut demoner ved Beelzebul, demonenes fyrste – et navn beslektet med Ba'al-Sebub. Jesus avviste anklagen og viste at Satan ikke kan drive ut Satan.",
      "verses": [
        {
          "bookId": 40,
          "chapter": 12,
          "verses": [
            24,
            25,
            26,
            27
          ]
        }
      ]
    },
    {
      "title": "Jesus advarer disiplene om Beelzebul",
      "description": "Jesus fortalte sine disipler at hvis de hadde kalt husets herre for Beelzebul, ville de i enda større grad kalle hans husfolk det, og han oppmuntret dem til ikke å frykte mennesker.",
      "verses": [
        {
          "bookId": 40,
