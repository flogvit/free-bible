    "kaifas"
  ],
  "keyEvents": [
    {
      "title": "Forhøret av Jesus",
      "description": "De jødiske lederne brakte Jesus til Pilatus. Han spurte: 'Er du jødenes konge?' Jesus svarte: 'Du sier det.'",
      "verses": [
        {
          "bookId": 40,
          "chapter": 27,
          "verses": [
            1,
            2,
            11
          ]
        }
      ]
    },
    {
      "title": "Fant ingen skyld",
      "description": "Pilatus forhørte Jesus og fant ingen skyld i ham. Han forsøkte å frigi ham, men folket ropte på Barabbas.",
      "verses": [
        {
          "bookId": 43,
          "chapter": 18,
          "verses": [
            38
          ]
        },
        {
          "bookId": 42,
          "chapter": 23,
          "verses": [
            4,
            14,
            22
          ]
        }
      ]
    },
    {
      "title": "Hustruens drøm",
      "description": "Pilatus' hustru sendte bud om at han ikke måtte ha noe med 'denne rettferdige mannen' å gjøre - hun hadde hatt en vond drøm.",
      "verses": [
        {
          "bookId": 40,
          "chapter": 27,
          "verses": [
            19
          ]
        }
      ]
    },
    {
      "title": "Vasket hendene",
      "description": "Pilatus vasket hendene for mengden og sa: 'Jeg er uskyldig i denne mannens blod.' Folket tok skylden på seg.",
      "verses": [
        {
          "bookId": 40,
          "chapter": 27,
          "verses": [
            24,
            25
          ]
        }
      ]
    },
    {
      "title": "Dødsdommen",
      "description": "Pilatus ga etter for presset, lot Jesus piske og overga ham til korsfestelse. Han skrev inskripsjonen: 'Jødenes konge.'",
      "verses": [
        {
          "bookId": 40,
          "chapter": 27,
          "verses": [
            26
          ]
        },
