    {
      "title": "Reisen til Egypt",
      "description": "Gad var blant Jakobs sønner som reiste til Egypt under hungersnøden og til slutt bosatte seg der med hele familien.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 46,
