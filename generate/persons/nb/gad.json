            16
          ]
        }
      ]
    },
    {
      "title": "Jakobs velsignelse",
      "description": "På dødsleiet velsignet Jakob sine sønner. Om Gad profeterte han at røverbander skulle trenge inn på ham, men han skulle trenge inn på dem bakfra.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 49,
          "verses": [
            19
          ]
        }
      ]
    },
    {
      "title": "Gads sønner",
      "description": "Gads syv sønner er navngitt i Skriften og ble grunnleggerne av klanene i Gads stamme.",
