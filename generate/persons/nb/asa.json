          ]
        }
      ]
    },
    {
      "title": "Avsettelse av dronningmoren Maaka",
      "description": "Asa avsatte til og med sin egen bestemor Maaka fra hennes stilling som dronningmor fordi hun hadde laget et avskyelig Asjera-bilde.",
      "verses": [
        {
          "bookId": 14,
          "chapter": 15,
          "verses": [
            16
          ]
        }
      ]
    },
    {
      "title": "Pakten med Ben-Hadad mot Israel",
      "description": "Da Baesa av Israel truet Juda, inngikk Asa en pakt med Ben-Hadad av Aram i stedet for å stole på Herren. Profeten Hanani irettesatte ham for dette.",
      "verses": [
        {
          "bookId": 14,
          "chapter": 16,
