{
  "id": "nebukadnesar",
  "name": "Nebukadnesar",
  "title": "Babylons mektige konge",
  "era": "exile",
  "lifespan": "ca. 634-562 f.Kr.",
  "summary": "Nebukadnesar var Babylons mektigste konge som erobret Jerusalem og førte jødene i eksil. Han er kjent fra Daniels bok for sine drømmer, den brennende ovnen, og sin midlertidige galskap. Til slutt æret han Daniels Gud som 'kongenes Konge'.",
  "roles": [
    "konge"
  ],
  "family": {
    "father": "nabopolassar",
    "mother": null,
    "siblings": [],
    "spouse": null,
    "children": [
      "belsasar"
    ]
  },
  "relatedPersons": [
    "daniel",
    "hananja",
    "misjael",
    "asarja"
  ],
  "keyEvents": [
    {
      "title": "Jerusalems erobring",
      "description": "Nebukadnesar beleiret og erobret Jerusalem, førte folket i eksil og tok med tempelets kar til Babylon.",
      "verses": [
        {
          "bookId": 12,
          "chapter": 24,
          "verses": [
            10,
            11,
            13,
            14
          ]
        }
      ]
    },
    {
      "title": "Drømmen om statuen",
      "description": "Nebukadnesar hadde en drøm om en statue av forskjellige metaller. Bare Daniel kunne tyde den som verdensrikenes historie.",
      "verses": [
        {
          "bookId": 27,
          "chapter": 2,
          "verses": [
            31,
            32,
            36,
            37,
            38,
            44,
            47
          ]
        }
      ]
    },
    {
      "title": "Den brennende ovnen",
      "description": "Nebukadnesar kastet Daniels tre venner i ildovnen fordi de nektet å tilbe gullstatuen, men de overlevde uskadd.",
      "verses": [
        {
          "bookId": 27,
          "chapter": 3,
          "verses": [
            19,
            20,
            25,
            26,
            27,
            28,
            29
          ]
        }
      ]
    },
    {
      "title": "Galskapen",
      "description": "På grunn av sitt hovmod ble Nebukadnesar slått med galskap og levde som et dyr i syv år til han æret Gud.",
      "verses": [
        {
          "bookId": 27,
          "chapter": 4,
          "verses": [
            30,
            31,
            32,
            33,
            34
          ]
        }
      ]
    },
    {
      "title": "Lovprisningen",
      "description": "Etter gjenopprettelsen lovet og æret Nebukadnesar himmelens Konge som 'kongenes Konge og herrenes Herre'.",
      "verses": [
        {
          "bookId": 27,
          "chapter": 4,
          "verses": [
            34,
            35,
            37
          ]
        }
      ]
    }
  ],
