{
  "id": "joab",
  "name": "Joab (Serujas sønn)",
  "title": "Davids hærfører",
  "era": "united-kingdom",
  "lifespan": "ca. 1040-970 f.Kr.",
  "summary": "Joab var Davids nevø og hans øverstkommanderende gjennom det meste av hans regjeringstid. Han var en briljant, men hensynsløs militær strateg som vant mange seire for Israel, men som også begikk flere brutale drap som til slutt førte til hans fall.",
  "roles": [
    "hærfører",
    "kriger",
    "leder"
  ],
  "family": {
    "father": null,
    "mother": "seruja",
    "siblings": [
      "abisjaj",
      "asael-serujas-sonn"
    ],
    "spouse": null,
    "children": []
  },
  "relatedPersons": [
    "david",
    "abner",
    "absalom",
    "amasa",
    "salomo",
    "adonja",
    "uria"
  ],
  "keyEvents": [
    {
      "title": "Erobringen av Jerusalem",
      "description": "Joab ledet angrepet på Jerusalem gjennom vannsjaktene og ble dermed Davids øverstkommanderende.",
      "verses": [
        {
          "bookId": 13,
          "chapter": 11,
          "verses": [
            6
          ]
        }
      ]
    },
    {
      "title": "Drapet på Abner",
      "description": "Joab drepte Abner, Sauls tidligere hærfører, ved Hebrons port for å hevne sin bror Asaels død, til tross for at David hadde gitt Abner fritt leide.",
      "verses": [
        {
          "bookId": 10,
          "chapter": 3,
          "verses": [
            27,
            28,
            29,
            30
          ]
        }
      ]
    },
    {
      "title": "Urias død",
      "description": "På Davids ordre sørget Joab for at Uria ble plassert i den farligste delen av slaget, noe som førte til hans død.",
      "verses": [
        {
          "bookId": 10,
          "chapter": 11,
          "verses": [
            14,
            15,
            16,
            17
          ]
        }
      ]
    },
    {
      "title": "Drapet på Absalom",
      "description": "Joab drepte Absalom da han hang fast i et tre under opprøret, til tross for Davids uttrykkelige ordre om å skåne ham.",
      "verses": [
        {
          "bookId": 10,
          "chapter": 18,
          "verses": [
            14,
            15
          ]
        }
      ]
    },
    {
      "title": "Drapet på Amasa",
      "description": "Joab drepte sin fetter Amasa, som David hadde utnevnt til å erstatte ham som hærfører, ved å stikke ham med sverd mens han hilste på ham.",
      "verses": [
        {
          "bookId": 10,
          "chapter": 20,
          "verses": [
            9,
            10
          ]
        }
      ]
    },
    {
      "title": "Støtte til Adonja og henrettelse",
      "description": "Joab støttet Adonjas forsøk på å ta tronen i stedet for Salomo. Etter Davids død befalte Salomo at Joab skulle henrettes ved alteret der han hadde søkt tilflukt.",
      "verses": [
        {
          "bookId": 11,
          "chapter": 2,
          "verses": [
            28,
            29,
            30,
            31,
            34
          ]
        }
      ]
    }
  ],
