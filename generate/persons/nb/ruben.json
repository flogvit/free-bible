  "keyEvents": [
    {
      "title": "Født som førstefødt",
      "description": "Ruben ble født som Jakobs første sønn med Lea. Hans navn betyr 'se, en sønn', for Lea håpet at Jakob nå ville elske henne.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 29,
          "verses": [
            32
          ]
        }
      ]
    },
    {
      "title": "Fant dudaim til sin mor",
      "description": "Som gutt fant Ruben dudaim (alruner) på marken og brakte dem til sin mor Lea, noe som førte til en avtale mellom Lea og Rakel.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 30,
          "verses": [
            14,
            15,
            16
          ]
        }
      ]
    },
    {
      "title": "Syndet med Bilha",
      "description": "Ruben lå med Bilha, sin fars medhutsru, noe som var en alvorlig synd som førte til at han mistet sin førstefødselsrett.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 35,
          "verses": [
            22
          ]
        }
      ]
    },
    {
      "title": "Forsøkte å redde Josef",
      "description": "Da brødrene ville drepe Josef, overbeviste Ruben dem om å kaste ham i en brønn i stedet, med plan om å redde ham senere.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 37,
          "verses": [
            21,
            22,
            29,
            30
          ]
        }
      ]
    },
    {
      "title": "Tilbød sine sønner som garanti",
      "description": "Ruben tilbød sine to sønners liv som garanti for Benjamin da familien trengte å reise til Egypt for korn.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 42,
          "verses": [
            37
          ]
        }
      ]
    },
    {
      "title": "Jakobs profeti om Ruben",
      "description": "På dødsleiet profeterte Jakob at Ruben, selv om han var førstefødt, ikke skulle ha forrang fordi han hadde vanhelliget sin fars leie.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 49,
          "verses": [
            3,
            4
          ]
        }
      ]
    }
  ],
