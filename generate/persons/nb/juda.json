  "keyEvents": [
    {
      "title": "Forslaget om å selge Josef",
      "description": "Da brødrene ville drepe Josef, foreslo Juda å selge ham til ismaelittene i stedet.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 37,
          "verses": [
            26,
            27,
            28
          ]
        }
      ]
    },
    {
      "title": "Tamar og tvillingene",
      "description": "Juda fikk sønnene Peres og Serah med svigerdatteren Tamar. Gjennom Peres kom kongeslekten.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 38,
          "verses": [
            27,
            28,
            29,
            30
          ]
        }
      ]
    },
    {
      "title": "Gisselbudet for Benjamin",
      "description": "Juda tilbød seg selv som gissel for Benjamin overfor Josef og holdt en gripende tale.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 44,
          "verses": [
            18,
            32,
            33,
            34
          ]
        }
      ]
    },
    {
      "title": "Jakobs velsignelse",
      "description": "Jakob profeterte at Juda skulle ha kongespir og at det ikke skulle vike før Fredsfyrsten kom.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 49,
          "verses": [
            8,
            9,
            10
          ]
        }
      ]
    },
    {
      "title": "I Messias' ættelinje",
      "description": "Gjennom Juda og Tamar kom Peres, og fra ham David og til slutt Jesus Kristus.",
      "verses": [
        {
          "bookId": 40,
          "chapter": 1,
          "verses": [
            2,
            3
          ]
        }
      ]
    }
