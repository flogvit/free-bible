{
  "id": "esau",
  "name": "Esau",
  "title": "Edoms stamfar",
  "era": "patriarchs",
  "lifespan": "ca. 1850-1750 f.Kr.",
  "summary": "Esau var Isaks førstefødte sønn og Jakobs tvillingbror. Han var en dyktig jeger og farens favoritt. Han solgte sin førstefødselsrett til Jakob for et måltid linsesuppe, og mistet farens velsignelse. Han ble stamfar til edomittene og forsonet seg senere med Jakob.",
  "roles": [
    "patriark"
  ],
  "family": {
    "father": "isak",
    "mother": "rebekka",
    "siblings": [
      "jakob-israel"
    ],
    "spouse": null,
    "children": []
  },
  "relatedPersons": [
    "isak",
    "rebekka",
    "jakob-israel"
  ],
  "keyEvents": [
    {
      "title": "Fødselen",
      "description": "Esau ble født først av tvillingene, rød og lodden. Jakob holdt i hælen hans da han kom ut.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 25,
          "verses": [
            24,
            25,
            26
          ]
        }
      ]
    },
    {
      "title": "Førstefødselsretten solgt",
      "description": "Esau kom sulten hjem fra marken og solgte sin førstefødselsrett til Jakob for et måltid linsesuppe.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 25,
          "verses": [
            29,
            30,
            31,
            32,
            33,
            34
          ]
        }
      ]
    },
    {
      "title": "Velsignelsen tapt",
      "description": "Jakob lurte til seg farens velsignelse ved å kle seg i Esaus klær. Da Esau kom, var det for sent.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 27,
          "verses": [
            30,
            34,
            36,
            38,
            41
          ]
        }
      ]
    },
    {
      "title": "Planen om hevn",
      "description": "Esau planla å drepe Jakob etter farens død, noe som førte til at Jakob flyktet til Laban.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 27,
          "verses": [
            41,
            42,
            43
          ]
        }
      ]
    },
    {
      "title": "Forsoningen",
      "description": "Etter mange år møtte Esau Jakob igjen. I stedet for hevn løp han ham i møte og omfavnet ham.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 33,
          "verses": [
            1,
            3,
            4,
            9,
            10,
            11
          ]
        }
      ]
    }
  ],
