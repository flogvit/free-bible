  "keyEvents": [
    {
      "title": "Profeten Ahias profeti",
      "description": "Profeten Ahia fra Sjilo rev sin nye kappe i tolv stykker og ga Jeroboam ti av dem som tegn på at han skulle bli konge over ti stammer i Israel.",
