        }
      ]
    },
    {
      "title": "Fødselen i Betlehem",
      "description": "Maria fødte Jesus i en stall i Betlehem og la ham i en krybbe fordi det ikke var rom i herberget.",
      "verses": [
        {
          "bookId": 42,
          "chapter": 2,
          "verses": [
            4,
