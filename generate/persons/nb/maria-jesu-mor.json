            6,
            7
          ]
        }
      ]
    },
    {
      "title": "Simeons profeti",
      "description": "Da Jesus ble fremstilt i tempelet, profeterte Simeon at et sverd skulle gjennombore Marias sjel.",
      "verses": [
        {
          "bookId": 42,
          "chapter": 2,
          "verses": [
