  "keyEvents": [
    {
      "title": "Sendt til David med gaver",
      "description": "Kong Toi sendte sin sønn Joram til kong David for å hilse ham og velsigne ham, fordi David hadde slått Hadadeser, som hadde ført krig mot Toi.",
      "verses": [
        {
          "bookId": 10,
          "chapter": 8,
          "verses": [
            10
          ]
        }
      ]
    },
    {
      "title": "Overlevering av kostbare gaver",
      "description": "Joram hadde med seg gjenstander av sølv, gull og bronse som gaver til David. Disse representerte Hamats takknemlighet og ønske om fred med Israel.",
      "verses": [
        {
          "bookId": 10,
          "chapter": 8,
          "verses": [
            10,
            11
          ]
        }
      ]
    },
    {
      "title": "Davids helligelse av gavene",
      "description": "Kong David helliget gavene fra Joram til Herren, sammen med sølvet og gullet han hadde tatt fra andre folk han hadde underlagt seg.",
      "verses": [
        {
          "bookId": 10,
          "chapter": 8,
          "verses": [
            11,
            12
          ]
        }
      ]
    },
    {
      "title": "Parallellberetning i Første Krønikebok",
      "description": "Den samme begivenheten beskrives i Første Krønikebok, der Joram kalles Hadoram. Han ble sendt for å ønske David til lykke med seieren over Hadadeser.",
      "verses": [
