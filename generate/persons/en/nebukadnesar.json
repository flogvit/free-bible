{
  "id": "nebukadnesar",
  "name": "Nebuchadnezzar",
  "title": "The Mighty King of Babylon",
  "era": "exile",
  "lifespan": "c. 634–562 BC",
  "summary": "Nebuchadnezzar was the most powerful king of Babylon who conquered Jerusalem and led the Jews into exile. He is known from the book of Daniel for his dreams, the fiery furnace, and his temporary madness. In the end, he honored Daniel's God as 'King of Kings.'",
  "roles": [
    "king"
  ],
  "family": {
    "father": "nabopolassar",
    "mother": null,
    "siblings": [],
    "spouse": null,
    "children": [
      "Belshazzar"
    ]
  },
  "relatedPersons": [
    "Daniel",
    "Hananiah-false-prophet",
    "Mishael",
    "Azariah"
  ],
  "keyEvents": [
    {
      "title": "The Conquest of Jerusalem",
      "description": "Nebuchadnezzar besieged and conquered Jerusalem, led the people into exile, and took the temple vessels to Babylon.",
      "verses": [
        {
          "bookId": 12,
          "chapter": 24,
          "verses": [
            10,
            11,
            13,
            14
          ]
        }
      ]
    },
    {
      "title": "The Dream of the Statue",
      "description": "Nebuchadnezzar had a dream about a statue made of different metals. Only Daniel could interpret it as the history of world empires.",
      "verses": [
        {
          "bookId": 27,
          "chapter": 2,
          "verses": [
            31,
            32,
            36,
            37,
            38,
            44,
            47
          ]
        }
      ]
    },
    {
      "title": "The Fiery Furnace",
      "description": "Nebuchadnezzar threw Daniel's three friends into the fiery furnace because they refused to worship the golden statue, but they survived unharmed.",
      "verses": [
        {
          "bookId": 27,
          "chapter": 3,
          "verses": [
            19,
            20,
            25,
            26,
            27,
            28,
            29
          ]
        }
      ]
    },
    {
      "title": "Madness",
      "description": "Because of his pride, Nebuchadnezzar was struck with madness and lived like a beast for seven years until he honored God.",
      "verses": [
        {
          "bookId": 27,
          "chapter": 4,
          "verses": [
            30,
            31,
            32,
            33,
            34
          ]
        }
      ]
    },
    {
      "title": "Praise",
      "description": "After his restoration, Nebuchadnezzar praised and honored the King of heaven as 'King of kings and Lord of lords'.",
      "verses": [
        {
          "bookId": 27,
          "chapter": 4,
          "verses": [
            34,
            35,
            37
          ]
        }
      ]
    }
  ],
