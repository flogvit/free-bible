{
  "id": "balak",
  "name": "Balak (King of Moab)",
  "title": "The King Who Tried to Curse Israel",
  "era": "conquest",
  "lifespan": "c. 1400 BC",
  "summary": "Balak was king of Moab when the Israelites approached the Promised Land after their wilderness journey. He feared Israel's military strength and tried to get the prophet Balaam to curse God's people, but God turned the curses into blessings.",
  "roles": [
    "king"
  ],
  "family": {
    "father": "sippor",
    "mother": null,
    "siblings": [],
    "spouse": null,
    "children": []
  },
  "relatedPersons": [
    "Balaam",
    "Moses"
  ],
  "keyEvents": [
    {
      "title": "Fears Israel's Arrival",
      "description": "When Balak saw how many Israelites there were and what they had done to the Amorites, he was filled with fear and consulted with the elders of Midian.",
      "verses": [
        {
          "bookId": 4,
          "chapter": 22,
          "verses": [
            2,
            3,
            4
          ]
        }
      ]
    },
    {
      "title": "Sends for Balaam",
      "description": "Balak sent messengers to the prophet Balaam with rich gifts and asked him to come and curse Israel, believing that Balaam's words held power.",
      "verses": [
        {
          "bookId": 4,
          "chapter": 22,
          "verses": [
            5,
            6,
            7
          ]
        }
      ]
    },
    {
      "title": "Takes Balaam to Viewpoints",
      "description": "Balak led Balaam to three different places—Bamoth-Baal, the top of Pisgah, and the top of Peor—in hopes of getting him to curse Israel.",
      "verses": [
        {
          "bookId": 4,
          "chapter": 22,
          "verses": [
            41
          ]
        },
        {
          "bookId": 4,
          "chapter": 23,
          "verses": [
            14,
            28
          ]
        }
      ]
    },
    {
      "title": "Receives Blessings Instead of Curses",
      "description": "To Balak's great frustration, Balaam blessed Israel four times instead of cursing them, because God put the words in the prophet's mouth.",
      "verses": [
        {
          "bookId": 4,
          "chapter": 23,
          "verses": [
            11,
            12
          ]
        },
        {
          "bookId": 4,
          "chapter": 24,
          "verses": [
            10
          ]
        }
      ]
    },
    {
      "title": "A Warning Example",
      "description": "Balaam's actions are later referred to in the Bible as a warning example of hostility toward God's people and attempts to oppose God's will.",
      "verses": [
        {
          "bookId": 6,
          "chapter": 24,
          "verses": [
            9
          ]
        },
