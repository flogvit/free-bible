{
  "id": "samuel",
  "name": "Samuel",
  "title": "Prophet and Judge",
  "era": "judges",
  "lifespan": "c. 1100–1020 BC",
  "summary": "Samuel was the last of the judges and the first great prophet after Moses. He was dedicated to the Lord from birth by his mother Hannah, grew up in the temple under Eli, and anointed both Saul and David as kings over Israel.",
  "roles": [
    "prophet",
    "judge",
    "priest"
  ],
  "family": {
    "father": "elkana",
    "mother": "hanna",
    "siblings": [],
    "spouse": null,
    "children": [
      "joel",
      "abia"
    ]
  },
  "relatedPersons": [
    "eli",
    "saul",
    "david",
    "hanna"
  ],
  "keyEvents": [
    {
      "title": "Hannah's Vow and the Birth of Samuel",
      "description": "Hannah prayed to God for a son and promised to dedicate him to the Lord's service. Samuel was born in answer to her prayer.",
      "verses": [
        {
          "bookId": 9,
          "chapter": 1,
          "verses": [
            10,
            11,
            20,
            27,
            28
          ]
        }
      ]
    },
    {
      "title": "God's Call in the Night",
      "description": "As a boy in the temple, Samuel heard God's voice three times during the night and was consecrated as a prophet.",
      "verses": [
        {
          "bookId": 9,
          "chapter": 3,
          "verses": [
            4,
            5,
            6,
            7,
            8,
            9,
            10
          ]
        }
      ]
    },
    {
      "title": "The Anointing of Saul",
      "description": "Samuel anointed Saul as Israel's first king in response to the people's demand for a monarch.",
      "verses": [
        {
          "bookId": 9,
          "chapter": 10,
          "verses": [
            1,
            24
          ]
        }
      ]
    },
    {
      "title": "The Rejection of Saul",
      "description": "Samuel proclaimed that God had rejected Saul as king because of his disobedience.",
      "verses": [
        {
          "bookId": 9,
          "chapter": 15,
          "verses": [
            22,
            23,
            26,
            28
          ]
        }
      ]
    },
    {
      "title": "The Anointing of David",
      "description": "Samuel anointed the young shepherd David as king, and from that day on the Spirit of the Lord came upon him.",
      "verses": [
        {
          "bookId": 9,
          "chapter": 16,
          "verses": [
            12,
            13
          ]
        }
      ]
    }
  ],
