    "joab",
    "natan"
  ],
  "keyEvents": [
    {
      "title": "Uriah in Battle Against the Ammonites",
      "description": "Uriah served as a loyal soldier during the siege of Rabbah, the capital of the Ammonites, while King David remained in Jerusalem.",
      "verses": [
        {
          "bookId": 10,
          "chapter": 11,
          "verses": [
            1
          ]
        }
      ]
    },
    {
      "title": "David Commits Adultery with Bathsheba",
      "description": "While Uriah was at war, David took his wife Bathsheba to himself and made her pregnant, setting off a series of tragic events.",
      "verses": [
        {
          "bookId": 10,
          "chapter": 11,
          "verses": [
            2,
            3,
            4,
            5
          ]
        }
      ]
    },
    {
      "title": "Uriah Refuses to Go Home",
      "description": "David called Uriah back from the front lines and urged him to go home to his wife, but Uriah refused to enjoy the comforts of home while his fellow soldiers were in the field. This demonstrated his deep loyalty and integrity.",
      "verses": [
        {
          "bookId": 10,
          "chapter": 11,
          "verses": [
            6,
            7,
            8,
            9,
            10,
            11,
            12,
            13
          ]
        }
      ]
    },
    {
      "title": "David's Death Plan for Uriah",
      "description": "When David could not conceal the adultery, he sent Uriah back to the front with a sealed letter to the commander Joab, ordering him to place Uriah where the fighting was fiercest and then withdraw from him.",
      "verses": [
        {
          "bookId": 10,
          "chapter": 11,
          "verses": [
            14,
            15,
            16,
            17
          ]
        }
      ]
    },
    {
      "title": "Uriah's Death in Battle",
      "description": "Joab followed David's instructions, and Uriah fell in battle outside the walls of Rabbah. David then took Bathsheba as his wife.",
      "verses": [
        {
          "bookId": 10,
          "chapter": 11,
          "verses": [
            17,
            24,
            25,
            26,
            27
          ]
        }
      ]
    },
    {
      "title": "Nathan's Judgment and Uriah's Legacy",
      "description": "The prophet Nathan confronted David with his sin against Uriah, and God judged David severely for the murder. Uriah is also mentioned in Jesus' genealogy in Matthew, where Bathsheba is referred to as \"Uriah's wife\".",
      "verses": [
        {
          "bookId": 10,
