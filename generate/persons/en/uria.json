{
  "id": "uria",
  "name": "Uriah",
  "title": "The Faithful Hittite",
  "era": "united-kingdom",
  "lifespan": "c. 1000 BC",
  "summary": "Uriah the Hittite was one of King David's brave warriors and the husband of Bathsheba. He is known for his unwavering loyalty and integrity, even when David tried to cover up his own adultery. David eventually arranged for Uriah to be killed in battle, an act that was strongly condemned by God through the prophet Nathan.",
  "roles": [
    "warrior"
