  "keyEvents": [
    {
      "title": "Flight from the Massacre at Nob",
      "description": "Abiathar was the only one who survived when Doeg the Edomite killed the priests at Nob on Saul's orders. He fled to David carrying the ephod.",
      "verses": [
        {
          "bookId": 9,
          "chapter": 22,
          "verses": [
            20,
            21,
            22,
            23
          ]
        }
      ]
    },
    {
      "title": "Service as Priest for David",
      "description": "Abiathar brought the ephod to David and used it to seek God's will for David during his flight from Saul.",
      "verses": [
        {
          "bookId": 9,
          "chapter": 23,
          "verses": [
            6,
            9,
            10,
            11,
            12
          ]
        }
      ]
    },
    {
      "title": "Bringing the Ark of the Covenant back to Jerusalem",
      "description": "Abiathar and Zadok carried the Ark of the Covenant back to Jerusalem when David fled from Absalom, but David asked them to take the ark back to the city.",
      "verses": [
        {
          "bookId": 10,
          "chapter": 15,
          "verses": [
            24,
            25,
            26,
            27,
            28,
            29,
            35,
            36
          ]
        }
      ]
    },
    {
      "title": "Intelligence operations during Absalom's rebellion",
      "description": "During Absalom's rebellion, Abiathar and Zadok served as David's spies in Jerusalem, sending information through their sons Jonathan and Ahimaaz.",
      "verses": [
        {
          "bookId": 10,
          "chapter": 17,
          "verses": [
            15,
            16,
            17
          ]
        }
      ]
    },
    {
      "title": "Support for Adonijah as heir to the throne",
      "description": "Abiathar supported Adonijah in his attempt to seize the throne before David died, unlike Zadok who supported Solomon.",
      "verses": [
        {
          "bookId": 11,
          "chapter": 1,
          "verses": [
            7,
            19,
            25
          ]
        }
      ]
    },
    {
      "title": "Removal of Abiathar",
      "description": "King Solomon removed Abiathar from the priesthood and banished him to his estate in Anathoth. This fulfilled the Lord's word concerning the house of Eli.",
      "verses": [
        {
          "bookId": 11,
          "chapter": 2,
