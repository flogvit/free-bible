  ],
  "keyEvents": [
    {
      "title": "The Trial of Jesus",
      "description": "The Jewish leaders brought Jesus to Pilate. He asked: 'Are you the king of the Jews?' Jesus answered: 'You say so.'",
      "verses": [
        {
          "bookId": 40,
          "chapter": 27,
          "verses": [
            1,
            2,
            11
          ]
        }
      ]
    },
    {
      "title": "Found No Guilt",
      "description": "Pilate questioned Jesus and found no guilt in him. He tried to release him, but the people shouted for Barabbas.",
      "verses": [
