        }
      ]
    },
    {
      "title": "The Wife's Dream",
      "description": "Pilate's wife sent word that he should have nothing to do with 'this righteous man' - she had had a bad dream.",
      "verses": [
        {
          "bookId": 40,
          "chapter": 27,
          "verses": [
            19
          ]
        }
      ]
    },
    {
      "title": "Washed His Hands",
      "description": "Pilate washed his hands before the crowd and said, \"I am innocent of this man's blood.\" The people took the blame.",
      "verses": [
        {
          "bookId": 40,
          "chapter": 27,
          "verses": [
            24,
            25
          ]
        }
      ]
    },
    {
      "title": "The Death Sentence",
      "description": "Pilate gave in to the pressure, had Jesus flogged, and handed him over to be crucified. He wrote the inscription: \"King of the Jews.\"",
