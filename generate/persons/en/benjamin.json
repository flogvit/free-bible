  "keyEvents": [
    {
      "title": "The Birth of Benjamin and the Death of Rachel",
      "description": "Benjamin was born near Bethlehem while the family was traveling. Rachel died during childbirth and named him Ben-Oni (son of my sorrow), but Jacob gave him the name Benjamin (son of the right hand).",
      "verses": [
        {
          "bookId": 1,
          "chapter": 35,
          "verses": [
            16,
            17,
            18,
            19,
            20
          ]
        }
      ]
    },
    {
      "title": "Jacob's protection of Benjamin",
      "description": "After Joseph was presumed dead, Jacob refused to let Benjamin travel to Egypt with his brothers, fearing he might lose him too.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 42,
          "verses": [
            4,
            36,
            38
          ]
        }
      ]
    },
    {
      "title": "Benjamin travels to Egypt",
      "description": "Due to the famine, Jacob was finally forced to send Benjamin to Egypt with his brothers to buy grain.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 43,
          "verses": [
            13,
            14,
            15,
            16
          ]
        }
      ]
    },
    {
      "title": "Joseph's silver cup in Benjamin's sack",
      "description": "Joseph tested his brothers by planting his silver cup in Benjamin's sack, which led Judah to offer himself as a slave in Benjamin's place.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 44,
          "verses": [
            1,
            2,
            12,
            13,
            33,
            34
          ]
        }
      ]
    },
    {
      "title": "Reunion with Joseph",
      "description": "When Joseph revealed his identity, he embraced Benjamin and wept, and Benjamin wept on his neck.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 45,
          "verses": [
            14,
            22
          ]
        }
      ]
    },
    {
      "title": "Jacob's blessing",
      "description": "On his deathbed, Jacob blessed Benjamin and described him as a ravenous wolf that devours prey in the morning and divides plunder in the evening.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 49,
          "verses": [
            27
          ]
        }
      ]
    }
  ],
