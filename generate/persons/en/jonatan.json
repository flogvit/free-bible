{
  "id": "jonatan",
  "name": "Jonathan",
  "title": "David's Faithful Friend",
  "era": "united-kingdom",
  "lifespan": "c. 1060–1010 BC",
  "summary": "Jonathan was King Saul's eldest son and heir to the throne, but he is best known for his deep friendship with David. Despite his father's hatred toward David, Jonathan remained loyal to his friend and protected him. He died alongside his father in battle against the Philistines.",
  "roles": [
    "warrior"
  ],
  "family": {
    "father": "saul",
    "mother": "akinoam",
    "siblings": [
      "Ish-bosheth",
      "Mical",
      "Merab"
    ],
    "spouse": null,
    "children": [
      "Mephibosheth"
    ]
  },
  "relatedPersons": [
    "Saul",
    "David",
    "Mephibosheth"
  ],
  "keyEvents": [
    {
      "title": "The Victory at Michmash",
      "description": "Jonathan and his armor-bearer attacked the Philistine outpost alone, creating panic that led to Israel's victory.",
      "verses": [
        {
          "bookId": 9,
          "chapter": 14,
          "verses": [
            6,
            12,
            13,
            14,
            15
          ]
        }
      ]
    },
    {
      "title": "Covenant of Friendship with David",
      "description": "After David's victory over Goliath, Jonathan and David were bound together in soul. Jonathan loved David as himself.",
      "verses": [
        {
          "bookId": 9,
          "chapter": 18,
          "verses": [
            1,
            3,
            4
          ]
        }
      ]
    },
    {
      "title": "The Defense of David",
      "description": "Jonathan warned David of his father's murder plans and pleaded David's case before Saul.",
      "verses": [
        {
          "bookId": 9,
          "chapter": 19,
          "verses": [
            1,
            2,
            4,
            5,
            6
          ]
        }
      ]
    },
    {
      "title": "The Farewell at the Stone",
      "description": "Jonathan used the arrow signal to warn David that he must flee. They wept together and renewed their covenant.",
      "verses": [
        {
          "bookId": 9,
          "chapter": 20,
          "verses": [
            35,
            37,
            41,
            42
          ]
        }
      ]
    },
    {
      "title": "Death on Gilboa",
      "description": "Jonathan fell alongside his father and brothers in battle against the Philistines on Mount Gilboa. David mourned deeply for him.",
