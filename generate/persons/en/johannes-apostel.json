{
  "id": "johannes-apostel",
  "name": "John",
  "title": "The disciple whom Jesus loved",
  "era": "jesus",
  "lifespan": "c. 6–100 AD",
  "summary": "John was one of Jesus' three closest disciples, often called 'the disciple whom Jesus loved'. He witnessed the most important events in Jesus' life, stood by the cross, and took care of Mary. He wrote the Gospel of John, three letters, and Revelation.",
  "roles": [
    "apostle",
    "disciple",
    "prophet"
  ],
  "family": {
    "father": "sebedeus",
    "mother": "salome-sebedeus-kone",
    "siblings": [
      "jakob-sebedeus"
    ],
    "spouse": null,
    "children": []
  },
  "relatedPersons": [
    "jesus",
    "peter",
    "jakob-sebedeus",
    "maria-jesu-mor"
  ],
  "keyEvents": [
    {
      "title": "The Call by the Sea",
      "description": "Jesus called John and his brother James while they were mending their nets with their father.",
      "verses": [
        {
          "bookId": 40,
          "chapter": 4,
          "verses": [
            21,
            22
          ]
        }
      ]
    },
    {
      "title": "At the Last Supper table",
      "description": "John leaned against Jesus' chest during the last meal.",
      "verses": [
        {
          "bookId": 43,
          "chapter": 13,
          "verses": [
            23,
            24,
            25
          ]
        }
      ]
    },
    {
      "title": "At the Cross",
      "description": "John was the only one of the twelve who stood at the cross when Jesus died.",
      "verses": [
        {
          "bookId": 43,
          "chapter": 19,
          "verses": [
            25,
            26,
            27
          ]
        }
      ]
    },
    {
      "title": "At the Empty Tomb",
      "description": "John ran to the tomb with Peter and saw and believed.",
      "verses": [
        {
          "bookId": 43,
          "chapter": 20,
          "verses": [
            3,
            4,
            8
          ]
        }
      ]
    },
    {
      "title": "After the Resurrection",
      "description": "John recognized Jesus by the Sea of Tiberias before the others.",
      "verses": [
        {
          "bookId": 43,
          "chapter": 21,
          "verses": [
            7,
            20,
            21,
            22,
            23,
            24
          ]
        }
      ]
    },
    {
      "title": "The Visions on Patmos",
      "description": "John received Revelation while exiled on Patmos.",
      "verses": [
        {
