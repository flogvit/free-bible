{
  "id": "baal-sebub",
  "name": "Ba'al-Zebub",
  "title": "Ekron's idol",
  "era": "divided-kingdom",
  "summary": "Ba'al-Zebub (\"lord of the flies\") was a Philistine idol worshipped in the city of Ekron. He is best known from the account where King Ahaziah of Israel sent messengers to consult this idol about his illness, which provoked God's anger and the prophet Elijah's condemnation. In the New Testament, the related form Beelzebul is used as a name for the prince of demons.",
  "roles": [],
  "family": {
    "father": null,
    "mother": null,
    "siblings": [],
    "spouse": null,
    "children": []
  },
  "relatedPersons": [
    "akasja-akabs-sonn-konge-av-israel",
    "elia",
    "jesus"
  ],
  "keyEvents": [
    {
      "title": "King Ahaziah consults Ba'al-Zebub",
      "description": "After King Ahaziah fell through the lattice in his upper room at Samaria and became ill, he sent messengers to Ekron to consult Ba'al-Zebub about whether he would recover.",
      "verses": [
        {
          "bookId": 12,
          "chapter": 1,
          "verses": [
            1,
            2
          ]
        }
      ]
    },
    {
      "title": "Elijah's condemnation",
      "description": "The angel of the Lord sent the prophet Elijah to meet Ahaziah's messengers and ask if there was no God in Israel that the king should go to consult Ba'al-Zebub, the god of Ekron. Elijah declared that Ahaziah would die.",
      "verses": [
        {
          "bookId": 12,
          "chapter": 1,
          "verses": [
            3,
            4,
            5,
            6
          ]
        }
      ]
    },
    {
      "title": "Ahaziah's repeated attempts and judgment",
      "description": "Ahaziah sent three groups of soldiers to bring Elijah, but the first two groups were consumed by fire from heaven. The prophet's judgment against the king's idolatry of Ba'al-Zebub was confirmed when Ahaziah died.",
      "verses": [
        {
          "bookId": 12,
          "chapter": 1,
          "verses": [
            9,
            10,
            11,
            12,
            13,
            14,
            15,
            16,
            17
          ]
        }
      ]
    },
    {
      "title": "The accusation of Beelzebul against Jesus",
      "description": "The Pharisees accused Jesus of driving out demons by Beelzebul, the prince of demons—a name related to Ba'al-Zebub. Jesus rejected the accusation and showed that Satan cannot drive out Satan.",
      "verses": [
        {
          "bookId": 40,
          "chapter": 12,
          "verses": [
            24,
            25,
            26,
            27
          ]
        }
      ]
    },
    {
      "title": "Jesus warns the disciples about Beelzebul",
      "description": "Jesus told his disciples that if they had called the master of the house Beelzebul, they would have called his household members even more so, and he encouraged them not to fear people.",
      "verses": [
        {
          "bookId": 40,
          "chapter": 10,
          "verses": [
            25
          ]
        }
      ]
    },
    {
      "title": "Luke's account of the Beelzebul controversy",
      "description": "Also in the Gospel of Luke, the accusation is reported that Jesus cast out demons by Beelzebul, and Jesus responds with the parable about a divided kingdom that cannot stand.",
      "verses": [
        {
          "bookId": 42,
          "chapter": 11,
          "verses": [
            15,
            16,
            17,
            18,
            19
          ]
        }
      ]
    }
  ],
