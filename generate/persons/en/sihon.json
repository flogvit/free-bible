{
  "id": "sihon",
  "name": "Sihon (Amorite king)",
  "title": "The Defeated King of the Amorites",
  "era": "conquest",
  "lifespan": "c. 1400 BC",
  "summary": "Sihon was the king of the Amorites who ruled in Heshbon east of the Jordan. He refused to let Israel pass through his land and was defeated by the Israelites under Moses' leadership. His defeat became a significant testimony to God's power and a precursor to the conquest of Canaan.",
