  "keyEvents": [
    {
      "title": "Refused Israel Passage",
      "description": "When Israel asked for permission to pass peacefully through his land on the way to Canaan, Sihon refused and gathered his army to fight against them.",
      "verses": [
        {
          "bookId": 4,
          "chapter": 21,
          "verses": [
            21,
            22,
            23
          ]
        }
      ]
    },
    {
      "title": "Defeated at Jahaz",
      "description": "Sihon marched out against Israel at Jahaz but was completely defeated. Israel took all his land from the Arnon to the Jabbok.",
      "verses": [
        {
          "bookId": 4,
          "chapter": 21,
          "verses": [
            23,
            24,
            25
          ]
        }
      ]
    },
    {
      "title": "The Conquest of Heshbon",
      "description": "The Israelites captured Heshbon, Sihon's capital city, and all the cities in the Amorite kingdom were settled by Israel.",
      "verses": [
        {
          "bookId": 4,
          "chapter": 21,
          "verses": [
