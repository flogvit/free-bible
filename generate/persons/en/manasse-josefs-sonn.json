{
  "id": "manasse-josefs-sonn",
  "name": "Manasse (Joseph's son)",
  "title": "Joseph's firstborn in Egypt",
  "era": "patriarchs",
  "lifespan": "c. 1700 BC",
  "summary": "Manasse was the firstborn son of Joseph and his Egyptian wife Asenath. He was born in Egypt before the famine and became the ancestor of one of Israel's twelve tribes. His name means 'the one who causes to forget', because God made Joseph forget all his hardship.",
  "roles": [
    "patriarch",
    "leader"
  ],
  "family": {
    "father": "josef-gt",
    "mother": "asenat",
    "siblings": [
      "efraim-josefs-sonn"
    ],
    "spouse": null,
    "children": [
      "makir"
    ]
  },
  "relatedPersons": [
    "jakob-israel",
    "josef-gt",
    "efraim-josefs-sonn",
    "potifera"
  ],
  "keyEvents": [
    {
      "title": "Manasseh's birth in Egypt",
      "description": "Manasseh was born as Joseph's firstborn son in Egypt, during the seven good years before the famine. Joseph gave him the name Manasseh because God had made him forget all his hardship.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 41,
          "verses": [
            50,
            51
          ]
        }
      ]
    },
    {
      "title": "Jacob's blessing",
      "description": "When Jacob was old, he blessed Joseph's sons. To Joseph's surprise, Jacob placed his right hand on the younger Ephraim and gave him the greater blessing over Manasseh.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 48,
          "verses": [
            13,
            14,
            17,
            18,
            19,
            20
          ]
        }
      ]
    },
    {
      "title": "Manasse Adopted by Jacob",
      "description": "Jacob adopted Manasseh and Ephraim as his own sons, so that they would be counted on equal footing with his other sons and become patriarchs in Israel.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 48,
          "verses": [
            5,
            6
          ]
        }
      ]
    },
    {
      "title": "The Tribe of Manasseh in the Census",
      "description": "Manasseh's descendants were counted as a distinct tribe in Israel during the wilderness wanderings and received land on both sides of the Jordan.",
      "verses": [
        {
          "bookId": 4,
          "chapter": 1,
          "verses": [
            34,
            35
          ]
        }
      ]
    },
    {
      "title": "Land Allocation for Manasseh",
      "description": "The tribe of Manasseh received a large inheritance extending both east and west of the Jordan, becoming one of the largest tribes in Israel.",
      "verses": [
        {
          "bookId": 6,
          "chapter": 17,
          "verses": [
            1,
            2,
            5,
            6
          ]
        }
      ]
    }
  ],
  "aliases": [
    "Manasseh's"
  ],
