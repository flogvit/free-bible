          ]
        }
      ]
    },
    {
      "title": "Gathering of the Remnant at Mizpah",
      "description": "Gedaliah settled in Mizpah, and Jewish military leaders and scattered groups came to him there. He encouraged them to work the land and serve the Babylonians.",
      "verses": [
        {
          "bookId": 24,
          "chapter": 40,
          "verses": [
            8,
            9,
            10,
            11,
            12
          ]
        }
      ]
    },
    {
      "title": "Warning of an Assassination Plot",
      "description": "Johanan son of Kareah warned Gedaliah that Ishmael son of Nethaniah planned to kill him, but Gedaliah did not believe him and rejected the warning.",
      "verses": [
        {
          "bookId": 24,
          "chapter": 40,
          "verses": [
            13,
            14,
            15,
            16
          ]
        }
      ]
    },
    {
      "title": "The Murder of Gedaliah",
      "description": "Ishmael son of Nethaniah, of royal descent, came to Mizpah and killed Gedaliah along with the Jews and Babylonians who were with him. This murder marked the end of Jewish self-rule in Judah.",
      "verses": [
        {
          "bookId": 12,
          "chapter": 25,
          "verses": [
            25,
            26
          ]
        },
        {
          "bookId": 24,
          "chapter": 41,
          "verses": [
            1,
            2,
            3
          ]
        }
      ]
    },
    {
      "title": "Johanan Pursues Ishmael",
      "description": "When Johanan and the other commanders heard about the murder, they pursued Ishmael and rescued the captives he had taken from Mizpah, but Ishmael himself escaped to the Ammonites.",
      "verses": [
        {
          "bookId": 24,
          "chapter": 41,
          "verses": [
            11,
            12,
            13,
            14,
            15,
            16
          ]
        }
      ]
    },
    {
      "title": "Flight to Egypt",
      "description": "After Gedaliah's death, the remaining people feared Babylonian revenge and fled to Egypt, despite the prophet Jeremiah's warning that they should stay in the land.",
