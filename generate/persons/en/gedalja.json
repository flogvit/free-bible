  ],
  "keyEvents": [
    {
      "title": "Appointment as Governor",
      "description": "After the destruction of Jerusalem, Nebuchadnezzar appointed Gedaliah son of Ahikam as governor over those who remained in Judah.",
      "verses": [
        {
          "bookId": 12,
          "chapter": 25,
          "verses": [
