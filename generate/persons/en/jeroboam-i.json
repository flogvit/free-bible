            32,
            33
          ]
        }
      ]
    },
    {
      "title": "The Man of God from Judah",
      "description": "A man of God from Judah came and prophesied against the altar at Bethel while Jeroboam was standing there. When the king reached out his hand to seize him, his hand withered.",
      "verses": [
        {
          "bookId": 11,
          "chapter": 13,
