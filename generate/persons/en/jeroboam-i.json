{
  "id": "jeroboam-i",
  "name": "Jeroboam I",
  "title": "Israel's first king after the division of the kingdom",
  "era": "divided-kingdom",
  "lifespan": "c. 931–910 BC",
  "summary": "Jeroboam I was the first king over the northern kingdom of Israel after the united monarchy split following Solomon's death. He was originally a capable official under Solomon, but later became known for leading Israel away from the Lord by setting up golden calves in Bethel and Dan.",
  "roles": [
    "king",
    "leader"
  ],
