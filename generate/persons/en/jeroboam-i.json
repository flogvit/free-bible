    "Solomon",
    "Rehoboam",
    "Ahijah"
  ],
  "keyEvents": [
    {
      "title": "The Prophecy of the Prophet Ahijah",
      "description": "The prophet Ahijah from Shiloh tore his new cloak into twelve pieces and gave ten of them to Jeroboam as a sign that he would become king over ten tribes in Israel.",
      "verses": [
        {
          "bookId": 11,
          "chapter": 11,
          "verses": [
