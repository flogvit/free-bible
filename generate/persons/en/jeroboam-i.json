          ]
        }
      ]
    },
    {
      "title": "Flight to Egypt",
      "description": "When Solomon tried to kill Jeroboam after the prophecy, he fled to Egypt and stayed there with Pharaoh Shishak until Solomon's death.",
      "verses": [
        {
          "bookId": 11,
          "chapter": 11,
          "verses": [
            40
          ]
        }
      ]
    },
    {
      "title": "Becomes King of Israel",
      "description": "After Solomon's death and Rehoboam's harsh response to the people, the ten northern tribes made Jeroboam king over Israel.",
      "verses": [
        {
          "bookId": 11,
          "chapter": 12,
          "verses": [
            12,
            13,
            14,
            15,
            16,
            17,
