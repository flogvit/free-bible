{
  "id": "sjimi",
  "name": "Shimei",
  "title": "The Benjamite Who Cursed King David",
  "era": "united-kingdom",
  "lifespan": "c. 1000 BC",
  "summary": "Shimei, son of Gera, was a man from the tribe of Benjamin and from Saul's family. He is best known for cursing and throwing stones at King David when he fled from his son Absalom. After Absalom's fall, Shimei begged for mercy and received forgiveness from David, but Solomon eventually had him executed for his earlier crimes.",
  "roles": [
    "warrior"
  ],
  "family": {
    "father": "gera",
    "mother": null,
    "siblings": [],
    "spouse": null,
    "children": []
  },
  "relatedPersons": [
    "david",
    "absalom",
    "salomo",
    "saul",
    "abisjaj",
    "siba"
  ],
  "keyEvents": [
    {
      "title": "Shimei Curses David",
      "description": "When David fled from Jerusalem during Absalom's rebellion, Shimei came out and cursed him, threw stones and dirt at him, and called him a man of blood and a man of Belial.",
      "verses": [
        {
          "bookId": 10,
          "chapter": 16,
          "verses": [
            5,
            6,
            7,
            8,
            9,
            10,
            11,
            12,
            13
          ]
        }
      ]
    },
    {
      "title": "Abishai Wants to Kill Shimei",
      "description": "Abishai, son of Zeruiah, wanted to cut off Shimei's head for cursing the king, but David refused and said that the Lord had told Shimei to curse him.",
      "verses": [
        {
          "bookId": 10,
          "chapter": 16,
          "verses": [
            9,
            10,
            11
          ]
        }
      ]
    },
    {
      "title": "Shimei Asks for Forgiveness",
      "description": "After Absalom's defeat, Shimei came with a thousand men from Benjamin and threw himself down before David at the Jordan, begging for mercy. David swore that he would not kill him.",
      "verses": [
        {
          "bookId": 10,
          "chapter": 19,
          "verses": [
            16,
            17,
            18,
            19,
            20,
            21,
            22,
            23
          ]
        }
      ]
    },
    {
      "title": "David's Instruction to Solomon Regarding Shimei",
      "description": "On his deathbed, David instructed his son Solomon not to let Shimei go unpunished, but to bring his gray head down to the realm of the dead with blood.",
      "verses": [
        {
          "bookId": 11,
          "chapter": 2,
          "verses": [
            8,
            9
          ]
        }
      ]
    },
    {
      "title": "Solomon Sets Conditions for Shimei",
      "description": "King Solomon ordered Shimei to live in Jerusalem and never leave the city, threatening him with death if he broke the agreement. Shimei accepted the condition.",
      "verses": [
        {
          "bookId": 11,
          "chapter": 2,
          "verses": [
            36,
            37,
            38
          ]
        }
      ]
    },
    {
      "title": "Shimei's Execution",
      "description": "When two of Shimei's slaves fled to Gath, Shimei went there to retrieve them, thereby breaking his agreement with Solomon. Solomon ordered that Shimei be executed, and Benaiah struck him down.",
      "verses": [
        {
          "bookId": 11,
          "chapter": 2,
          "verses": [
            39,
            40,
            41,
            42,
            43,
            44,
            46
          ]
        }
      ]
    }
  ],
