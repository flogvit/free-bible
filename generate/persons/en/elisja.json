            14
          ]
        }
      ]
    },
    {
      "title": "The Widow and the Jar of Oil",
      "description": "Elisha helped a prophet's widow who was in debt by having God miraculously multiply her oil, so that she could sell it and pay off her debts.",
      "verses": [
        {
          "bookId": 12,
          "chapter": 4,
          "verses": [
            1,
            2,
            3,
            4,
            5,
            6,
            7
          ]
        }
      ]
    },
    {
      "title": "The Shunammite's Son Raised from the Dead",
      "description": "Elisha brought back to life the dead son of the wealthy woman from Shunem, who had first been given a child through Elisha's prophecy.",
      "verses": [
        {
          "bookId": 12,
          "chapter": 4,
          "verses": [
            32,
            33,
            34,
            35,
            36,
            37
          ]
        }
      ]
    },
    {
      "title": "Elisha and the Syrian Army",
      "description": "When the Syrians surrounded the city of Dothan to capture Elisha, the prophet asked God to strike the enemy with blindness. He then led them to Samaria and asked the king to give them food instead of killing them.",
      "verses": [
