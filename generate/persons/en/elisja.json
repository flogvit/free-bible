  "keyEvents": [
    {
      "title": "Elisha's Calling",
      "description": "Elijah threw his cloak over Elisha while he was plowing with twelve yoke of oxen, and Elisha left everything to follow Elijah as his servant and successor.",
      "verses": [
        {
          "bookId": 11,
          "chapter": 19,
          "verses": [
            19,
            20,
            21
          ]
        }
      ]
    },
    {
      "title": "Elisha Receives a Double Portion of the Spirit",
      "description": "When Elijah was taken up to heaven in a chariot of fire, Elisha called out after him and took up Elijah's cloak. He received a double portion of Elijah's spirit, which he had asked for.",
      "verses": [
        {
          "bookId": 12,
          "chapter": 2,
          "verses": [
            9,
            10,
            11,
            12,
            13,
            14
          ]
        }
      ]
    },
    {
      "title": "The Healing of Naaman",
      "description": "Elisha instructed the Syrian commander Naaman to wash seven times in the Jordan River to be healed of his leprosy, and Naaman was restored to health.",
      "verses": [
        {
          "bookId": 12,
          "chapter": 5,
          "verses": [
            1,
            2,
            3,
            4,
            5,
            6,
