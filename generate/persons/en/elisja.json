{
  "id": "elisja",
  "name": "Elisha",
  "title": "The Prophet with a Double Portion of the Spirit",
  "era": "divided-kingdom",
  "lifespan": "c. 850–800 BC",
  "summary": "Elisha was a powerful prophet in Israel who succeeded Elijah. He performed many miracles and served as God's spokesperson through the reigns of several kings in the northern kingdom. He is known for receiving a double portion of Elijah's spirit and for his numerous miracles that testified to God's power and care.",
