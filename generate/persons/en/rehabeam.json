          ]
        }
      ]
    },
    {
      "title": "Spiritual Decline in Judah",
      "description": "During Rehoboam's reign, Judah fell into idolatry with high places, sacred pillars, and Asherah poles on every hill, and there was even temple prostitution in the land.",
      "verses": [
        {
          "bookId": 11,
          "chapter": 14,
          "verses": [
            22,
            23,
            24
          ]
        }
      ]
    },
    {
      "title": "Pharaoh Shishak's Invasion",
      "description": "In Rehoboam's fifth year as king, Pharaoh Shishak of Egypt attacked Jerusalem and took the treasures from the temple and the royal palace, including Solomon's shields of gold.",
      "verses": [
        {
          "bookId": 11,
          "chapter": 14,
          "verses": [
            25,
            26,
            27,
            28
          ]
        }
      ]
    },
    {
      "title": "Fortifying Judah",
      "description": "Rehoboam fortified cities in Judah and Benjamin to strengthen the kingdom's defenses, and Levites and devout Israelites from the northern kingdom sought refuge with him.",
      "verses": [
        {
          "bookId": 14,
          "chapter": 11,
