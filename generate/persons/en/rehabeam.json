    "sjisjak"
  ],
  "keyEvents": [
    {
      "title": "The Division of the Kingdom at Shechem",
      "description": "When Rehoboam gathered Israel at Shechem to be crowned, the people asked for relief from their burdens. He rejected the advice of the elders and followed the harsh counsel of the young men, which led ten tribes to break away.",
