          ]
        }
      ]
    },
    {
      "title": "The Prophet Shemaiah Prevents Civil War",
      "description": "When Rehoboam assembled an army of 180,000 men to reconquer the northern kingdom, the prophet Shemaiah spoke God's word and prevented war between the brothers.",
      "verses": [
        {
          "bookId": 11,
          "chapter": 12,
          "verses": [
