{
  "id": "rehabeam",
  "name": "Rehoboam",
  "title": "The first king of Judah after the division of the kingdom",
  "era": "divided-kingdom",
  "lifespan": "c. 972–913 BC",
  "summary": "Rehoboam was the son of King Solomon and the first king of the southern kingdom of Judah after Israel split into two. His harsh leadership and rejection of the people's counsel led directly to the division, where the ten northern tribes broke away under Jeroboam.",
