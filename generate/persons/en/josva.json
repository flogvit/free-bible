{
  "id": "josva",
  "name": "Joshua",
  "title": "Moses' Successor",
  "era": "conquest",
  "lifespan": "c. 1500–1390 BC",
  "summary": "Joshua was Moses' servant and successor who led Israel into the Promised Land. He was one of the two spies who believed that Israel could conquer Canaan. As a military leader, he conquered Jericho and the rest of the land, and divided it among the tribes.",
  "roles": [
    "leader",
    "warrior"
  ],
  "family": {
    "father": "nun",
    "mother": null,
    "siblings": [],
    "spouse": null,
    "children": []
  },
  "relatedPersons": [
    "Moses",
    "Caleb"
  ],
  "keyEvents": [
    {
      "title": "The Call to Leadership",
      "description": "After Moses' death, God called Joshua to lead the people across the Jordan with the promise: 'Be strong and courageous!'",
      "verses": [
        {
          "bookId": 6,
          "chapter": 1,
          "verses": [
            1,
            2,
            3,
            5,
            6,
            9
          ]
        }
      ]
    },
    {
      "title": "The Spies' Report",
      "description": "As one of twelve spies, Joshua and Caleb believed that God would give them victory over the giants in Canaan.",
      "verses": [
        {
          "bookId": 4,
          "chapter": 14,
          "verses": [
            6,
            7,
            8,
            9,
            30
          ]
        }
      ]
    },
    {
      "title": "Crossing the Jordan",
      "description": "Joshua led the people across the Jordan on dry ground when the priests carrying the ark stepped into the river.",
      "verses": [
        {
          "bookId": 6,
          "chapter": 3,
          "verses": [
            14,
            15,
            16,
            17
          ]
        }
      ]
    },
    {
      "title": "The Fall of Jericho",
      "description": "Joshua followed God's command to march around Jericho for seven days, and the walls fell at the sound of the trumpets.",
      "verses": [
        {
          "bookId": 6,
          "chapter": 6,
          "verses": [
            2,
            3,
            4,
            5,
            20
          ]
        }
      ]
    },
    {
      "title": "Renewal of the Covenant",
      "description": "In his farewell speech, Joshua challenged the people to choose whom they would serve: 'As for me and my house, we will serve the Lord.'",
      "verses": [
        {
          "bookId": 6,
          "chapter": 24,
          "verses": [
            14,
            15,
            24
          ]
        }
      ]
    }
