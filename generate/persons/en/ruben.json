{
  "id": "ruben",
  "name": "Reuben (Leah's son)",
  "title": "Jacob's firstborn",
  "era": "patriarchs",
  "lifespan": "c. 1750 BC",
  "summary": "Reuben was Jacob's firstborn son with Leah and the ancestor of one of Israel's twelve tribes. He tried to save Joseph from his brothers' murder plans, but lost his birthright due to sin against his father. His tribe settled east of the Jordan.",
  "roles": [
    "patriarch"
  ],
