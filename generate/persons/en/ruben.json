    "Moses"
  ],
  "keyEvents": [
    {
      "title": "Born as the Firstborn",
      "description": "Reuben was born as Jacob's first son with Leah. His name means 'see, a son', for Leah hoped that Jacob would now love her.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 29,
          "verses": [
            32
          ]
        }
      ]
    },
    {
      "title": "Found Duda'im for His Mother",
      "description": "As a boy Reuben found duda'im (mandrakes) in the field and brought them to his mother Leah, which led to an agreement between Leah and Rachel.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 30,
          "verses": [
            14,
            15,
            16
          ]
        }
      ]
    },
    {
      "title": "Sinned with Bilhah",
      "description": "Reuben slept with Bilhah, his father's concubine, which was a serious sin that caused him to lose his birthright.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 35,
          "verses": [
            22
          ]
        }
      ]
    },
    {
      "title": "Attempted to save Joseph",
      "description": "When the brothers wanted to kill Joseph, Reuben convinced them to throw him into a pit instead, planning to rescue him later.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 37,
          "verses": [
            21,
            22,
            29,
            30
          ]
        }
      ]
    },
    {
      "title": "Offered his sons as security",
      "description": "Reuben offered the lives of his two sons as security for Benjamin when the family needed to travel to Egypt for grain.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 42,
          "verses": [
            37
          ]
        }
      ]
    },
    {
      "title": "Jacob's prophecy about Reuben",
      "description": "On his deathbed, Jacob prophesied that Reuben, though he was the firstborn, would not have preeminence because he had defiled his father's bed.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 49,
          "verses": [
            3,
            4
          ]
        }
      ]
    }
  ],
