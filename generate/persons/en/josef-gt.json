{
  "id": "josef-gt",
  "name": "Joseph",
  "title": "From Slave to Ruler in Egypt",
  "era": "patriarchs",
  "lifespan": "c. 1750–1640 BC",
  "summary": "Joseph was Jacob's favorite son who was sold into slavery by his brothers, but rose to become the second-highest ruler in Egypt. He saved his family from famine and showed forgiveness. His life is a picture of Christ.",
