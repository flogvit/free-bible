  "keyEvents": [
    {
      "title": "Promoted to the Highest Office",
      "description": "King Ahasuerus promoted Haman to the highest position among all his princes, and all the king's servants had to bow down before him.",
      "verses": [
        {
          "bookId": 17,
          "chapter": 3,
          "verses": [
            1,
            2
          ]
        }
      ]
    },
    {
      "title": "Mordecai Refuses to Bow",
      "description": "The Jew Mordecai refused to bow or kneel before Haman, which aroused Haman's fury and led to his desire for revenge.",
      "verses": [
        {
          "bookId": 17,
          "chapter": 3,
          "verses": [
            2,
            3,
            4,
            5
          ]
        }
      ]
    },
    {
      "title": "The Genocide Plan",
      "description": "Haman persuaded King Ahasuerus to issue a decree to destroy all the Jews in the empire on the thirteenth day of the month of Adar.",
      "verses": [
        {
          "bookId": 17,
          "chapter": 3,
          "verses": [
            8,
            9,
            10,
            11,
            12,
            13
          ]
        }
      ]
    },
    {
      "title": "A Gallows Built for Mordecai",
      "description": "On the advice of his wife Zeresh, Haman had a gallows fifty cubits high built to hang Mordecai, while he planned to ask the king for permission.",
      "verses": [
        {
          "bookId": 17,
          "chapter": 5,
          "verses": [
            14
          ]
        }
      ]
    },
    {
      "title": "The Humiliation of Haman",
      "description": "Haman was forced to honor Mordecai publicly by leading him through the city on the king's horse, dressed in royal garments.",
      "verses": [
        {
          "bookId": 17,
          "chapter": 6,
          "verses": [
            10,
            11,
            12
          ]
        }
      ]
    },
    {
      "title": "Haman's Fall and Execution",
      "description": "Queen Esther revealed Haman's evil plot to the king, and Haman was hanged on the very gallows he had built for Mordecai.",
      "verses": [
