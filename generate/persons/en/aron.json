{
  "id": "aron",
  "name": "Aaron",
  "title": "Israel's first high priest and Moses' spokesperson",
  "era": "exodus",
  "lifespan": "c. 1530–1407 BC (died at age 123)",
  "summary": "Aaron, Moses' older brother from the tribe of Levi, was appointed by God as prophet and spokesman for Moses before Pharaoh during the exodus from Egypt. As Israel's first high priest, he began a priesthood that would continue through generations, leading the people in worship and sacrifices at the tabernacle. Despite serious failures – especially when he yielded to the people's pressure and made the golden calf – God confirmed his calling by making his staff bloom and bear almonds. Aaron also demonstrated his intercessory role by standing between the living and the dead with the censer, stopping a deadly plague. The Aaronic priesthood formed the foundation of Old Testament sacrificial service and pointed forward to the ultimate high priest in Christ's priesthood according to the order of Melchizedek.",
  "roles": [
    "high priest",
    "prophet",
    "spokesperson for Moses",
    "leader",
    "intercessor"
  ],
  "family": {
    "father": "amram",
    "mother": "jokebed",
    "siblings": [
      "moses",
      "miriam"
    ],
    "spouse": "elisjeba",
    "children": [
      "nadab-arons-sonn",
      "abihu",
      "eleasar-arons-sonn",
      "itamar"
    ]
  },
  "relatedPersons": [
    "moses",
    "miriam",
    "farao-exodus"
  ],
  "keyEvents": [
    {
      "title": "The Call to Help Moses",
      "description": "God sent Aaron to meet Moses in the wilderness to be his spokesman, because Moses felt he could not speak well enough. Aaron was to speak to the people and to Pharaoh on Moses' behalf.",
      "verses": [
        {
          "bookId": 2,
          "chapter": 4,
          "verses": [
            14,
            15,
            16,
            27,
            28
          ]
        }
      ]
    },
    {
      "title": "Aaron's Staff Before Pharaoh",
      "description": "Aaron spoke to Pharaoh on Moses' behalf and threw down his staff before Pharaoh and his servants, and the staff became a snake. When the magicians of Egypt did the same with their sorcery, Aaron's staff swallowed up theirs.",
      "verses": [
        {
          "bookId": 2,
          "chapter": 7,
          "verses": [
            9,
            10,
            11,
            12
          ]
        }
      ]
    },
    {
      "title": "The Golden Calf",
      "description": "While Moses was away for a long time on Mount Sinai, Aaron gave in to the people's pressure and made a golden calf from their gold jewelry. The people worshiped the calf, which led to God's anger and serious consequences for Israel.",
      "verses": [
        {
          "bookId": 2,
          "chapter": 32,
          "verses": [
            1,
            2,
            3,
            4,
            5,
            6,
            24
          ]
        }
      ]
    },
    {
      "title": "Consecration as High Priest",
      "description": "Aaron and his sons were consecrated for priestly service through a seven-day ritual that included washing, putting on holy garments, anointing with oil, and offering sacrifices.",
      "verses": [
        {
          "bookId": 3,
          "chapter": 8,
          "verses": [
            6,
            12,
            13,
            30,
            33,
            36
          ]
        }
      ]
    },
    {
      "title": "Aaron Stops the Plague",
      "description": "When a plague struck the people of Israel after Korah's rebellion, Aaron took the incense burner and stood between the dead and the living, and the plague stopped. This act showed Aaron's role as intercessor in his position as high priest.",
      "verses": [
        {
          "bookId": 4,
          "chapter": 17,
          "verses": [
            11,
            12,
            13
          ]
        }
      ]
    },
    {
      "title": "The Staff That Budded",
      "description": "When there was a rebellion against Aaron's priesthood, God caused his staff to bud and bear ripe almonds overnight as a sign that Aaron was God's chosen priest. The staff was kept as a lasting testimony.",
      "verses": [
        {
          "bookId": 4,
          "chapter": 17,
          "verses": [
            16,
            17,
            18,
            19,
            20,
            21,
            23,
            24,
            25
          ]
        }
      ]
    },
    {
      "title": "Aaron's Death on Mount Hor",
      "description": "Aaron died on Mount Hor at the border of the land of Edom. Before his death, his high priestly garments were taken from him and given to his son Eleazar, who took over the priestly service. All Israel mourned for Aaron for thirty days.",
      "verses": [
        {
          "bookId": 4,
          "chapter": 20,
          "verses": [
            22,
            23,
            24,
            25,
            26,
            27,
            28,
            29
          ]
        }
      ]
    }
  ],
