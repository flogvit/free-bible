    "natan"
  ],
  "keyEvents": [
    {
      "title": "Servant as High Priest under David",
      "description": "Zadok served as high priest alongside Abiathar during King David's reign, and they shared responsibility for the priestly duties.",
      "verses": [
        {
          "bookId": 10,
          "chapter": 8,
          "verses": [
            17
          ]
        }
      ]
    },
    {
      "title": "Remained Faithful During Absalom's Rebellion",
      "description": "When Absalom rebelled against his father David, Zadok wanted to follow the king with the ark of the covenant, but David sent him back to Jerusalem as a spy.",
      "verses": [
        {
          "bookId": 10,
          "chapter": 15,
          "verses": [
            24,
            25,
            26,
            27,
            29
          ]
        }
      ]
    },
    {
      "title": "Delivered intelligence to David",
      "description": "Zadok and Abiathar sent their sons to bring important information to David about Absalom's plans, which contributed to David's victory.",
      "verses": [
        {
          "bookId": 10,
          "chapter": 17,
          "verses": [
            15,
            16,
            17,
            21
          ]
        }
      ]
    },
    {
      "title": "Supported Solomon as heir to the throne",
      "description": "While Abiathar supported Adonijah, Zadok remained loyal to David's wish that Solomon should become king.",
      "verses": [
        {
          "bookId": 11,
          "chapter": 1,
          "verses": [
            8,
            26
          ]
        }
      ]
    },
    {
      "title": "Anointed Solomon as king",
      "description": "Zadok and the prophet Nathan anointed Solomon as king at the Gihon spring by David's command, thereby securing the rightful heir to the throne.",
      "verses": [
        {
          "bookId": 11,
          "chapter": 1,
          "verses": [
            34,
            38,
            39,
            45
          ]
        }
      ]
    },
    {
      "title": "Became the sole high priest",
      "description": "After Abiathar was removed from office by Solomon for supporting Adonijah, Zadok became the only high priest in Israel.",
      "verses": [
        {
          "bookId": 11,
          "chapter": 2,
          "verses": [
            26,
            27,
            35
          ]
        }
      ]
    }
  ],
