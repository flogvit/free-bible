{
  "id": "sadok",
  "name": "Zadok (High Priest)",
  "title": "The Faithful High Priest",
  "era": "united-kingdom",
  "lifespan": "c. 1000 BC",
  "summary": "Zadok served as high priest under King David and Solomon, remaining loyal to David during Absalom's rebellion. He anointed Solomon as king and established the priestly lineage that served in the temple. His descendants, the Sadducees, later became a prominent religious group in Israel.",
  "roles": [
    "priest"
