          ]
        }
      ]
    },
    {
      "title": "Johanan Pursues Ishmael",
      "description": "Johanan gathered his men and pursued Ishmael after the murder of Gedaliah. He rescued the captives Ishmael had taken, but Ishmael himself escaped to the Ammonites.",
      "verses": [
        {
          "bookId": 24,
          "chapter": 41,
          "verses": [
            11,
