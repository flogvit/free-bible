{
  "id": "joab",
  "name": "Joab (son of Zeruiah)",
  "title": "David's commander-in-chief",
  "era": "united-kingdom",
  "lifespan": "c. 1040–970 BC",
  "summary": "Joab was David's nephew and his commander-in-chief for most of his reign. He was a brilliant but ruthless military strategist who won many victories for Israel, but also committed several brutal murders that ultimately led to his downfall.",
  "roles": [
    "commander-in-chief",
    "warrior",
    "leader"
  ],
  "family": {
    "father": null,
    "mother": "seruja",
    "siblings": [
      "Abishai",
      "Asahel-son-of-Zeruiah"
    ],
    "spouse": null,
    "children": []
  },
  "relatedPersons": [
    "David",
    "Abner",
    "Absalom",
    "Amasa",
    "Solomon",
    "Adonijah",
    "Uriah"
  ],
  "keyEvents": [
    {
      "title": "The Conquest of Jerusalem",
      "description": "Joab led the attack on Jerusalem through the water shafts and thus became David's commander-in-chief.",
      "verses": [
        {
          "bookId": 13,
          "chapter": 11,
          "verses": [
            6
          ]
        }
      ]
    },
    {
      "title": "The Murder of Abner",
      "description": "Joab killed Abner, Saul's former army commander, at the gate of Hebron to avenge his brother Asael's death, even though David had granted Abner safe passage.",
      "verses": [
        {
          "bookId": 10,
          "chapter": 3,
          "verses": [
            27,
            28,
            29,
            30
          ]
        }
      ]
    },
    {
      "title": "The Death of Uriah",
      "description": "At David's command, Joab ensured that Uriah was placed in the most dangerous part of the battle, which led to his death.",
      "verses": [
        {
          "bookId": 10,
          "chapter": 11,
          "verses": [
            14,
            15,
            16,
            17
          ]
        }
      ]
    },
    {
      "title": "The Murder of Absalom",
      "description": "Joab killed Absalom when he was caught hanging from a tree during the rebellion, despite David's explicit order to spare him.",
      "verses": [
        {
          "bookId": 10,
          "chapter": 18,
          "verses": [
            14,
            15
          ]
        }
      ]
    },
    {
      "title": "The Murder of Amasa",
      "description": "Joab killed his cousin Amasa, whom David had appointed to replace him as army commander, by stabbing him with a sword while greeting him.",
      "verses": [
        {
          "bookId": 10,
          "chapter": 20,
          "verses": [
            9,
            10
          ]
        }
      ]
    },
    {
      "title": "Support for Adonijah and Execution",
      "description": "Joab supported Adonijah's attempt to seize the throne instead of Solomon. After David's death, Solomon ordered Joab to be executed at the altar where he had sought refuge.",
      "verses": [
        {
          "bookId": 11,
          "chapter": 2,
          "verses": [
            28,
            29,
            30,
            31,
            34
          ]
        }
      ]
    }
  ],
