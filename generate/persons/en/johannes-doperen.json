        }
      ]
    },
    {
      "title": "The Baptism of Jesus",
      "description": "John baptized Jesus in the Jordan River. The heavens opened, the Spirit descended like a dove, and a voice said: 'This is my Son.'",
      "verses": [
        {
          "bookId": 40,
          "chapter": 3,
          "verses": [
            13,
            14,
            15,
            16,
            17
          ]
        }
      ]
    },
    {
      "title": "Lamb of God",
      "description": "John pointed to Jesus and said: 'Behold, the Lamb of God who takes away the sin of the world!' and 'He must increase, but I must decrease.'",
      "verses": [
        {
          "bookId": 43,
          "chapter": 1,
          "verses": [
            29,
            36
