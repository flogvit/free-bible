{
  "id": "johannes-doperen",
  "name": "John the Baptist",
  "title": "The Cry in the Wilderness",
  "era": "jesus",
  "lifespan": "c. 5 BC - 30 AD",
  "summary": "John the Baptist was the last prophet before the Messiah and the forerunner of Jesus. He was miraculously born to the priest Zechariah and his elderly wife Elizabeth. He lived an ascetic life in the desert, preaching repentance and baptism for the forgiveness of sins. He pointed to Jesus as 'the Lamb of God' and was executed by Herod Antipas.",
  "roles": [
    "prophet"
  ],
  "family": {
    "father": "sakarja-far-til-johannes",
    "mother": "elisabet",
    "siblings": [],
    "spouse": null,
    "children": []
  },
  "relatedPersons": [
    "jesus",
    "maria-jesu-mor",
    "herodes-antipas"
  ],
  "keyEvents": [
    {
      "title": "The Angel's Message to Zechariah",
      "description": "The angel Gabriel announced to the priest Zechariah that his elderly wife Elizabeth would bear a son who would prepare the way for the Lord.",
      "verses": [
        {
          "bookId": 42,
          "chapter": 1,
          "verses": [
            11,
            13,
            14,
            15,
            16,
            17
          ]
        }
      ]
    },
    {
      "title": "Preaching in the Desert",
      "description": "John emerged in the desert and preached a baptism of repentance. People came from all over Judea and Jerusalem.",
      "verses": [
        {
          "bookId": 40,
          "chapter": 3,
          "verses": [
            1,
