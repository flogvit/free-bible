{
  "id": "saul",
  "name": "Saul",
  "title": "Israel's first king",
  "era": "united-kingdom",
  "lifespan": "c. 1080–1010 BC",
  "summary": "Saul was Israel's first king, anointed by the prophet Samuel. He began humbly and won victories over the Philistines, but disobedience and jealousy led to his downfall. His persecution of David and consultation with a medium showed how far he had drifted from God.",
  "roles": [
    "king",
    "warrior"
  ],
  "family": {
    "father": "kisj",
    "mother": null,
    "siblings": [],
    "spouse": "akinoam",
    "children": [
      "jonatan",
      "isjbosjet",
      "mikal",
      "merab"
    ]
  },
  "relatedPersons": [
    "samuel",
    "david",
    "jonatan"
  ],
  "keyEvents": [
    {
      "title": "Anointing as king",
      "description": "Samuel anointed Saul as king in secret, after which he was chosen publicly by lot.",
      "verses": [
        {
          "bookId": 9,
          "chapter": 10,
          "verses": [
            1,
            20,
            21,
            24
          ]
        }
      ]
    },
    {
      "title": "The victory at Jabesh",
      "description": "Saul gathered Israel and defeated the Ammonites who were besieging Jabesh in Gilead, winning the people's trust.",
      "verses": [
        {
          "bookId": 9,
          "chapter": 11,
          "verses": [
            6,
            7,
            11,
            15
          ]
        }
      ]
    },
    {
      "title": "Disobedience at Gilgal",
      "description": "Saul offered sacrifices himself instead of waiting for Samuel, which led to Samuel declaring that the kingdom would be taken from him.",
      "verses": [
        {
          "bookId": 9,
          "chapter": 13,
          "verses": [
            8,
            9,
            11,
            13,
            14
          ]
        }
      ]
    },
    {
      "title": "Rejection",
      "description": "Saul spared King Agag of the Amalekites and the best of the livestock against God's command. Samuel declared: 'Obedience is better than sacrifice.'",
      "verses": [
        {
          "bookId": 9,
          "chapter": 15,
          "verses": [
            9,
            22,
            23,
            26,
            28
          ]
        }
      ]
    },
    {
      "title": "Jealousy toward David",
      "description": "After David killed Goliath, Saul became jealous and repeatedly tried to kill him.",
      "verses": [
        {
          "bookId": 9,
          "chapter": 18,
          "verses": [
            7,
            8,
            9,
            10,
            11
          ]
        }
      ]
    }
  ],
