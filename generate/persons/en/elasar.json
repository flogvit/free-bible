    },
    {
      "title": "The Red Heifer",
      "description": "Eleazar was given the responsibility to oversee the sacrifice of the red heifer outside the camp, an important purification ceremony.",
      "verses": [
        {
          "bookId": 4,
          "chapter": 19,
          "verses": [
            1,
