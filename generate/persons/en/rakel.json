  "keyEvents": [
    {
      "title": "The Meeting at the Well",
      "description": "Jacob met Rachel at the well when she came with her father's sheep, and he loved her from the first moment.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 29,
          "verses": [
            9,
            10,
            11,
            12
          ]
        }
      ]
    },
    {
      "title": "Seven Years of Labor",
      "description": "Jacob worked seven years to win Rachel, but they seemed like only a few days because he loved her so much.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 29,
          "verses": [
            18,
            20
          ]
        }
      ]
    },
    {
      "title": "Laban's Deception",
      "description": "Laban deceived Jacob and gave him Leah instead. Jacob had to work another seven years to get Rachel.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 29,
          "verses": [
            23,
            25,
            26,
            27,
            28
          ]
        }
      ]
    },
    {
      "title": "The Birth of Joseph",
      "description": "After a long period of barrenness, God remembered Rachel, and she gave birth to Joseph. She said: 'God has taken away my disgrace.'",
      "verses": [
        {
          "bookId": 1,
          "chapter": 30,
          "verses": [
            22,
            23,
            24
          ]
        }
      ]
    },
    {
      "title": "Death at the Birth of Benjamin",
      "description": "Rachel died when she gave birth to Benjamin on the way to Ephrath. With her last breath, she named him Ben-Oni, but Jacob called him Benjamin.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 35,
          "verses": [
            16,
            17,
            18,
            19,
            20
          ]
        }
      ]
    }
