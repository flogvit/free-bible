          ]
        }
      ]
    },
    {
      "title": "The Shoot from Jesse's Stump - The Messiah Prophecy",
      "description": "The prophet Isaiah prophesied that the Messiah would come as a shoot from Jesse's stump, pointing forward to Jesus Christ.",
      "verses": [
        {
          "bookId": 23,
          "chapter": 11,
          "verses": [
