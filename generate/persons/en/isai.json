          ]
        }
      ]
    },
    {
      "title": "Samuel Comes to Anoint a New King",
      "description": "God sent the prophet Samuel to Jesse in Bethlehem to anoint one of his sons as king over Israel. Jesse gathered seven of his sons for Samuel.",
      "verses": [
        {
          "bookId": 9,
          "chapter": 16,
          "verses": [
            1,
            4,
            5,
            10,
            11
          ]
        }
      ]
    },
    {
      "title": "David Anointed as King",
      "description": "After Samuel rejected all the other sons, the youngest, David, was brought from the sheep flock and anointed as the future king of Israel in Jesse's presence.",
      "verses": [
        {
          "bookId": 9,
          "chapter": 16,
          "verses": [
            12,
            13
          ]
        }
      ]
    },
    {
      "title": "Jesse Sends David to Saul's Camp",
      "description": "Jesse sent David with food to his older brothers who were serving in Saul's army. This led to David's encounter with Goliath.",
      "verses": [
        {
          "bookId": 9,
          "chapter": 17,
          "verses": [
            17,
            18,
