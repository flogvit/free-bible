    "father": "josia",
    "mother": "hamutal",
    "siblings": [
      "jojakim",
      "joakas-jehus-sonn",
      "sjallum"
    ],
    "spouse": null,
    "children": []
  },
  "relatedPersons": [
    "jeremia",
    "nebukadnesar",
    "jojakin",
    "gedalja"
  ],
  "keyEvents": [
    {
      "title": "Installed as king by Nebuchadnezzar",
      "description": "Nebuchadnezzar installed Zedekiah as king over Judah after taking Jehoiachin captive to Babylon. He was twenty-one years old when he became king and reigned for eleven years.",
      "verses": [
        {
          "bookId": 12,
          "chapter": 24,
          "verses": [
            17,
            18
          ]
        }
      ]
    },
    {
      "title": "Did what was evil in the Lord's sight",
      "description": "Zedekiah did not follow the Lord's will and refused to humble himself before the prophet Jeremiah, who spoke the Lord's words to him.",
      "verses": [
        {
          "bookId": 14,
          "chapter": 36,
          "verses": [
            12,
            13
          ]
        }
      ]
    },
    {
      "title": "Secret conversations with Jeremiah",
      "description": "Zedekiah sought counsel from Jeremiah in secret on several occasions but lacked the courage to follow the prophet's advice to surrender to the Babylonians.",
      "verses": [
        {
          "bookId": 24,
          "chapter": 38,
          "verses": [
            14,
            15,
            16,
            17,
            18
          ]
        }
      ]
    },
    {
      "title": "Rebellion against Babylon",
      "description": "Zedekiah broke his oath to Nebuchadnezzar and rebelled by seeking help from Egypt, which led to Babylon's siege of Jerusalem.",
      "verses": [
        {
          "bookId": 26,
          "chapter": 17,
          "verses": [
            15,
            16,
            17,
            18,
            19
          ]
        }
      ]
    },
    {
      "title": "The fall of Jerusalem and Zedekiah's flight",
      "description": "When the city fell, Zedekiah fled at night but was captured on the plains of Jericho. He was brought before Nebuchadnezzar in Ribla for judgment.",
      "verses": [
        {
          "bookId": 12,
          "chapter": 25,
          "verses": [
            4,
            5,
            6
          ]
        }
      ]
    },
    {
      "title": "Zedekiah's terrible fate",
      "description": "Nebuchadnezzar had Zedekiah's sons killed before his eyes, then he blinded him and took him in chains to Babylon, where he died.",
      "verses": [
        {
          "bookId": 24,
          "chapter": 52,
          "verses": [
            10,
            11
          ]
        }
      ]
    }
  ],
