  ],
  "keyEvents": [
    {
      "title": "The Proposal to Sell Joseph",
      "description": "When the brothers wanted to kill Joseph, Judah suggested selling him to the Ishmaelites instead.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 37,
          "verses": [
            26,
            27,
            28
          ]
        }
      ]
    },
    {
      "title": "Tamar and the Twins",
      "description": "Judah had sons Perez and Zerah with his daughter-in-law Tamar. Through Perez came the royal line.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 38,
          "verses": [
            27,
            28,
            29,
            30
          ]
        }
      ]
    },
    {
      "title": "The Hostage Offer for Benjamin",
      "description": "Judah offered himself as a hostage for Benjamin before Joseph and delivered a moving speech.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 44,
          "verses": [
            18,
            32,
            33,
            34
          ]
        }
      ]
    },
    {
      "title": "Jacob's Blessing",
      "description": "Jacob prophesied that Judah would hold the scepter and that it would not depart until the Prince of Peace came.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 49,
          "verses": [
            8,
            9,
            10
          ]
        }
      ]
    },
    {
      "title": "In the Line of the Messiah",
      "description": "Through Judah and Tamar came Perez, from him David, and finally Jesus Christ.",
      "verses": [
        {
          "bookId": 40,
          "chapter": 1,
          "verses": [
            2,
            3
          ]
        }
      ]
    }
  ],
