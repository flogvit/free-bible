{
  "id": "juda",
  "name": "Judah",
  "title": "Ancestor of the Royal Lineage",
  "era": "patriarchs",
  "lifespan": "c. 1750–1650 BC",
  "summary": "Judah was Jacob's fourth son with Leah and the ancestor of the tribe of Judah. From him came the royal line and eventually the Messiah. He played a key role in Joseph's story by suggesting to sell him and later offering himself as a hostage for Benjamin.",
  "roles": [
    "Patriarch"
  ],
  "family": {
    "father": "jakob-israel",
    "mother": "lea",
