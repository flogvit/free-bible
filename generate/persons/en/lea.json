        }
      ]
    },
    {
      "title": "God Saw Her Pain",
      "description": "The Lord saw that Leah was unloved and opened her womb. She bore Reuben and said: 'The Lord has seen my misery.'",
      "verses": [
        {
          "bookId": 1,
          "chapter": 29,
          "verses": [
            31,
            32
          ]
        }
      ]
    },
    {
      "title": "Judah's Birth",
      "description": "When Leah gave birth to her fourth son, Judah, she said: 'This time I will praise the Lord.' From Judah came the royal line.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 29,
          "verses": [
            35
          ]
        }
      ]
    },
    {
      "title": "Levi's Birth",
      "description": "Leah bore Levi, who became the ancestor of the priestly line and the Levites.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 29,
          "verses": [
            34
          ]
        }
      ]
    },
    {
      "title": "Buried with the Fathers",
      "description": "Leah was buried in the cave of Machpelah together with Abraham, Sarah, Isaac, and Rebekah - the family burial place.",
