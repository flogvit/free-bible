{
  "id": "esau",
  "name": "Esau",
  "title": "Ancestor of Edom",
  "era": "patriarchs",
  "lifespan": "c. 1850–1750 BC",
  "summary": "Esau was Isaac's firstborn son and Jacob's twin brother. He was a skilled hunter and his father's favorite. He sold his birthright to Jacob for a meal of lentil stew, and lost his father's blessing. He became the ancestor of the Edomites and later reconciled with Jacob.",
  "roles": [
    "patriarch"
  ],
  "family": {
    "father": "isak",
    "mother": "rebekka",
    "siblings": [
      "jakob-israel"
    ],
    "spouse": null,
    "children": []
  },
  "relatedPersons": [
    "isak",
    "rebekka",
    "jakob-israel"
  ],
  "keyEvents": [
    {
      "title": "The Birth",
      "description": "Esau was born first of the twins, red and hairy. Jacob held onto his heel as he came out.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 25,
          "verses": [
            24,
            25,
            26
          ]
        }
      ]
    },
    {
      "title": "Birthright Sold",
      "description": "Esau returned hungry from the field and sold his birthright to Jacob for a meal of lentil stew.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 25,
          "verses": [
            29,
            30,
            31,
            32,
            33,
            34
          ]
        }
      ]
    },
    {
      "title": "Blessing Lost",
      "description": "Jacob tricked his father into giving him the blessing by dressing in Esau's clothes. When Esau arrived, it was too late.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 27,
          "verses": [
            30,
            34,
            36,
            38,
            41
          ]
        }
      ]
    },
    {
      "title": "Plan for Revenge",
      "description": "Esau planned to kill Jacob after his father's death, which led to Jacob fleeing to Laban.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 27,
          "verses": [
            41,
            42,
            43
          ]
        }
      ]
    },
    {
      "title": "Reconciliation",
      "description": "After many years, Esau met Jacob again. Instead of seeking revenge, he ran to meet him and embraced him.",
      "verses": [
        {
          "bookId": 1,
          "chapter": 33,
          "verses": [
            1,
            3,
            4,
            9,
            10,
            11
          ]
        }
      ]
    }
  ],
