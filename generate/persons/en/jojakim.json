{
  "id": "jojakim",
  "name": "Jehoiakim (son of Josiah)",
  "title": "Judah's wicked king under Babylonian rule",
  "era": "divided-kingdom",
  "lifespan": "c. 634–598 BC",
  "summary": "Jehoiakim was king of Judah and son of the godly King Josiah. He reigned for eleven years and did what was evil in the Lord's sight. During his reign, Judah became a vassal state under Babylon, and he is known for burning the scroll of the prophet Jeremiah.",
  "roles": [
    "king"
  ],
  "family": {
    "father": "josia",
    "mother": "sebuda",
    "siblings": [
      "Joahaz-Jehu-son",
      "Zedekiah-Josiah-son",
      "Shallum"
    ],
    "spouse": "nehusta-mor",
    "children": [
      "Jehoiachin"
    ]
  },
  "relatedPersons": [
    "Jeremiah",
    "Nebuchadnezzar",
    "Daniel",
    "Baruch"
  ],
  "keyEvents": [
    {
      "title": "Appointed king by Pharaoh Neco",
      "description": "After Joahaz was deposed, Pharaoh Neco installed Eliakim as king and changed his name to Jehoiakim. He had to pay tribute to Egypt.",
      "verses": [
        {
          "bookId": 12,
          "chapter": 23,
          "verses": [
            34,
            35
          ]
        }
      ]
    },
    {
      "title": "Did what was evil in the Lord's sight",
      "description": "Jehoiakim did not follow his father Josiah's godly example, but led the people away from the Lord and practiced idolatry.",
      "verses": [
        {
          "bookId": 12,
          "chapter": 23,
          "verses": [
            36,
            37
          ]
        }
      ]
    },
    {
      "title": "Jeremiah's Scroll Is Burned",
      "description": "When Jeremiah's prophecies were read to the king, he cut up the scroll and threw it into the fire, in defiance of God's word.",
      "verses": [
        {
          "bookId": 24,
          "chapter": 36,
          "verses": [
            21,
            22,
            23,
            24,
            25
          ]
        }
      ]
    },
    {
      "title": "Becomes a Vassal Under Nebuchadnezzar",
      "description": "King Nebuchadnezzar of Babylon marched against Jerusalem, and Jehoiakim served him for three years before rebelling.",
      "verses": [
        {
          "bookId": 12,
          "chapter": 24,
          "verses": [
            1
          ]
        }
      ]
    },
    {
      "title": "Killed the Prophet Uriah",
      "description": "Jehoiakim persecuted prophets who spoke God's words and executed the prophet Uriah, who had prophesied against Jerusalem.",
      "verses": [
        {
          "bookId": 24,
          "chapter": 26,
          "verses": [
            20,
            21,
            22,
            23
          ]
        }
      ]
    },
    {
      "title": "His Death and Legacy",
      "description": "Jeremiah prophesied that Jehoiakim would have a donkey's burial and be cast outside Jerusalem's gates without honor.",
      "verses": [
        {
          "bookId": 24,
          "chapter": 22,
          "verses": [
            18,
            19
          ]
        }
      ]
    }
  ],
