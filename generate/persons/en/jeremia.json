{
  "id": "jeremia",
  "name": "Jeremiah",
  "title": "The Weeping Prophet",
  "era": "divided-kingdom",
  "lifespan": "c. 650–570 BC",
  "summary": "Jeremiah is called 'the weeping prophet' because he mourned over Jerusalem's sin and coming destruction. He prophesied for more than 40 years and warned against the Babylonian invasion. Despite persecution and suffering, he remained faithful and prophesied about the new covenant that God would establish.",
  "roles": [
    "prophet",
    "priest"
  ],
  "family": {
    "father": "hilkia-oversteprest",
    "mother": null,
    "siblings": [],
    "spouse": null,
    "children": []
  },
  "relatedPersons": [
    "Baruch",
    "Nebuchadnezzar",
    "Zedekiah (son of Josiah)"
  ],
  "keyEvents": [
    {
      "title": "Called as a Youth",
      "description": "God called Jeremiah to be a prophet from his mother's womb and promised to be with him despite opposition.",
      "verses": [
        {
          "bookId": 24,
          "chapter": 1,
          "verses": [
            4,
            5,
            6,
            7,
            8,
            9,
            10
          ]
        }
      ]
    },
    {
      "title": "Warning to Judah",
      "description": "Jeremiah warned the people that they had forsaken the Lord, the source of living water, for broken cisterns.",
      "verses": [
        {
          "bookId": 24,
          "chapter": 2,
          "verses": [
            11,
            12,
            13
          ]
        }
      ]
    },
    {
      "title": "In the Well",
      "description": "Jeremiah was thrown into a muddy well because of his prophecies but was rescued by the Ethiopian Ebed-Melech.",
      "verses": [
        {
          "bookId": 24,
          "chapter": 38,
          "verses": [
            6,
            7,
            10,
            11,
            12,
            13
          ]
        }
      ]
    },
    {
      "title": "The New Covenant",
      "description": "Jeremiah prophesied about a new covenant where God would write his law on hearts and forgive the people's sins.",
      "verses": [
        {
          "bookId": 24,
          "chapter": 31,
          "verses": [
            31,
            32,
            33,
            34
          ]
        }
      ]
    },
    {
      "title": "Hope for the Future",
      "description": "Despite the destruction, Jeremiah promised that God had plans of peace for the people, with a future and hope.",
      "verses": [
        {
          "bookId": 24,
          "chapter": 29,
          "verses": [
            11,
            12,
            13,
            14
          ]
        }
      ]
    }
  ],
