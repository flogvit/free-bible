  "keyEvents": [
    {
      "title": "Sent to David with Gifts",
      "description": "King Toi sent his son Joram to King David to greet him and bless him, because David had defeated Hadadezer, who had waged war against Toi.",
      "verses": [
        {
          "bookId": 10,
          "chapter": 8,
          "verses": [
            10
          ]
        }
      ]
    },
    {
      "title": "Delivery of Precious Gifts",
      "description": "Joram brought items of silver, gold, and bronze as gifts for David. These represented Hamat's gratitude and desire for peace with Israel.",
      "verses": [
        {
          "bookId": 10,
          "chapter": 8,
          "verses": [
            10,
            11
          ]
        }
      ]
    },
    {
      "title": "David's Dedication of the Gifts",
      "description": "King David dedicated Joram's gifts to the Lord, along with the silver and gold he had taken from other nations he had conquered.",
      "verses": [
        {
          "bookId": 10,
          "chapter": 8,
          "verses": [
            11,
            12
          ]
        }
      ]
    },
    {
      "title": "Parallel Account in 1 Chronicles",
      "description": "The same event is described in 1 Chronicles, where Joram is called Hadoram. He was sent to congratulate David on his victory over Hadadezer.",
