  "keyEvents": [
    {
      "title": "Jehoshaphat Becomes King of Judah",
      "description": "Jehoshaphat succeeded his father Asa as king over Judah and walked in the early ways of his father. He strengthened himself against Israel and stationed garrisons in the cities of Judah.",
      "verses": [
        {
          "bookId": 14,
          "chapter": 17,
          "verses": [
            1,
            2,
