{
  "id": "salomo",
  "name": "Solomon",
  "title": "The Wisest King",
  "era": "united-kingdom",
  "lifespan": "c. 990–931 BC",
  "summary": "Solomon was David's son and the third king of Israel. He is known for his wisdom, wealth, and the building of the temple in Jerusalem. He wrote Proverbs, Ecclesiastes, and Song of Songs, but his many foreign wives led him away from God.",
  "roles": [
    "king",
    "wise man"
  ],
  "family": {
    "father": "david",
    "mother": "batseba",
    "siblings": [
      "absalom",
      "amnon"
    ],
    "spouse": null,
    "children": [
      "rehabeam"
    ]
  },
  "relatedPersons": [
    "david",
    "batseba",
    "natan",
    "dronningen-av-saba",
    "hiram-tyrus"
  ],
  "keyEvents": [
