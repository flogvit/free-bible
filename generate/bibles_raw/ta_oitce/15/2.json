[
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 1,
    "text": "¶ பாபிலோன் அரசன் நேபுகாத்நேச்சாரால் சிறைபிடிக்கப்பட்டு, பாபிலோனுக்குக் கொண்டுபோகப்பட்டவர்களுள், சிறையிருப்பிலிருந்து அவர்களுடைய பட்டணமான எருசலேமுக்கும் யூதாவுக்கும்"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 2,
    "text": "செருபாபேல், யெசுவா, நெகேமியா, செராயா, ரெலாயா, மொர்தெகாய், பில்சான், மிஸ்பார், பிக்வாய், ரேகூம், பானா என்பவர்களுடன் திரும்பி வந்தார்கள். இவர்களுடன் திரும்பி வந்த இஸ்ரயேல் மனிதரின் பெயர் பட்டியல்:"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 3,
    "text": "பாரோஷின் சந்ததி 2,172 பேர்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 4,
    "text": "செபத்தியாவின் சந்ததி 372 பேர்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 5,
    "text": "ஆராகின் சந்ததி 775 பேர்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 6,
    "text": "யெசுவா, யோவாப்பின் வழிவந்த பாகாத் மோவாபின் சந்ததி 2,812 பேர்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 7,
    "text": "ஏலாமின் சந்ததி 1,254 பேர்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 8,
    "text": "சத்தூவின் சந்ததி 945 பேர்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 9,
    "text": "சக்காயின் சந்ததி 760 பேர்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 10,
    "text": "பானியின் சந்ததி 642 பேர்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 11,
    "text": "பெபாயின் சந்ததி 623 பேர்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 12,
    "text": "அஸ்காதின் சந்ததி 1,222 பேர்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 13,
    "text": "அதோனிகாமின் சந்ததி 666 பேர்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 14,
    "text": "பிக்வாயின் சந்ததி 2,056 பேர்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 15,
    "text": "ஆதீனின் சந்ததி 454 பேர்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 16,
    "text": "எசேக்கியாவின் வழிவந்த ஆதேரின் சந்ததி 98 பேர்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 17,
    "text": "பேஸாயின் சந்ததி 323 பேர்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 18,
    "text": "யோராகின் சந்ததி 112 பேர்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 19,
    "text": "ஆசூமின் சந்ததி 223 பேர்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 20,
    "text": "கிபாரின் சந்ததி 95 பேர்."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 21,
    "text": "பெத்லெகேமின் மனிதர் 123 பேர்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 22,
    "text": "நெத்தோபாவின் மனிதர் 56 பேர்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 23,
    "text": "ஆனதோத்தின் மனிதர் 128 பேர்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 24,
    "text": "அஸ்மாவேத்தின் மனிதர் 42 பேர்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 25,
    "text": "கீரியாத்யாரீம், கெபிரா, பேரோத் பட்டணங்களின் மனிதர் 743 பேர்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 26,
    "text": "ராமா, கேபாவின் மனிதர் 621 பேர்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 27,
    "text": "மிக்மாசின் மனிதர் 122 பேர்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 28,
    "text": "பெத்தேல், ஆயியின் மனிதர் 223 பேர்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 29,
    "text": "நேபோவின் மனிதர் 52 பேர்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 30,
    "text": "மக்பீசின் மனிதர் 156 பேர்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 31,
    "text": "மற்ற ஏலாமின் மனிதர் 1,254 பேர்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 32,
    "text": "ஆரீமின் மனிதர் 320 பேர்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 33,
    "text": "லோத், ஆதித், ஓனோ பட்டணங்களின் மனிதர் 725 பேர்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 34,
    "text": "எரிகோவின் மனிதர் 345 பேர்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 35,
    "text": "செனாகாவின் மனிதர் 3,630 பேர்."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 36,
    "text": "ஆசாரியர்கள்: யெசுவாவின் குடும்பத்தானாகிய யெதாயாவின் சந்ததி 973 பேர்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 37,
    "text": "இம்மேரின் சந்ததி 1,052 பேர்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 38,
    "text": "பஸ்கூரின் சந்ததி 1,247 பேர்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 39,
    "text": "ஆரீமின் சந்ததி 1,017 பேர்."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 40,
    "text": "லேவியர்கள்: ஓதவியாவின் வழிவந்த யெசுவா, கத்மியேல் ஆகியோரின் சந்ததி 74 பேர்."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 41,
    "text": "பாடகர்கள்: ஆசாப்பின் சந்ததி 128 பேர்."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 42,
    "text": "ஆலய வாசல் காவலர்கள்: சல்லூம் அதேர், தல்மோன், அக்கூப், அதிதா, சோபாய் ஆகியோரின் சந்ததிகள் 139 பேர்."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 43,
    "text": "திரும்பி வந்த ஆலய பணியாட்கள்: சீகா, அசுபா, தபாயோத்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 44,
    "text": "கேரோசு, சீயாகா, பாதோன்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 45,
    "text": "லெபானா, அகாபா, அக்கூப்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 46,
    "text": "ஆகாப், சல்மாயி, ஆனான்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 47,
    "text": "கித்தேல், காகார், ரயாயா,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 48,
    "text": "ரேசீன், நெக்கோதா, காசாம்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 49,
    "text": "ஊசா, பாசெயா, பேசாய்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 50,
    "text": "அஸ்னா, மெயூனீம், நெபுசீம்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 51,
    "text": "பக்பூக், அகுபா, அர்கூர்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 52,
    "text": "பஸ்லூத், மெகிதாவ், அர்ஷா,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 53,
    "text": "பர்கோஸ், சிசெரா, தேமா,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 54,
    "text": "நெத்சியா, அதிபா ஆகியோரின் சந்ததிகள்."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 55,
    "text": "திரும்பி வந்த சாலொமோனின் வேலையாட்களின் சந்ததிகள்: சோதாய், சொபெரேத், பெருதா,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 56,
    "text": "யாலா, தர்கோன், கித்தேல்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 57,
    "text": "செபத்தியா, அத்தீல், பொகெரேத் செபாயீம், ஆமி ஆகியோரின் சந்ததிகள்."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 58,
    "text": "ஆலய பணியாட்களுடன், சாலொமோனின் பணியாட்களின் சந்ததிகளும் சேர்த்து 392 பேர்."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 59,
    "text": "பின்வருவோர் தெல்மெலா, தெல்அர்ஷா, கேரூப், ஆதோன், இம்மேர் ஆகிய நகரங்களிலிருந்து திரும்பி வந்தவர்கள். ஆனால் அவர்களுக்கோ தங்கள் குடும்பங்கள் இஸ்ரயேலின் வழிவந்தவை என நிரூபிக்க முடியவில்லை."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 60,
    "text": "அவர்கள், தெலாயா, தொபியா, நெக்கோதா ஆகியோரின் சந்ததிகளான 652 பேர்."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 61,
    "text": "ஆசாரியர்களைச் சேர்ந்தவர்கள்: அபாயா, அக்கோஸ், அக்கோசு, பர்சில்லாய் ஆகியோரின் சந்ததிகள். பர்சில்லாய் என்பவன் கீலேயாத்திய மனிதனான பர்சில்லாயின் மகள்களில் ஒருத்தியைத் திருமணம் செய்ததால் இப்பெயரால் அழைக்கப்பட்டான்."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 62,
    "text": "இவர்கள் தங்கள் குடும்ப அட்டவணையைத் தேடினார்கள்; ஆனால் அவர்களால் கண்டுபிடிக்க முடியவில்லை. அதனால் அவர்கள் ஆசாரியப் பணியிலிருந்து அசுத்தமானவர்கள் எனத் தள்ளி வைக்கப்பட்டார்கள்."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 63,
    "text": "ஊரீம், தும்மீம் அணிந்த ஒரு ஆசாரியன் எழும்பும் வரைக்கும் அவர்கள் மகா பரிசுத்த உணவிலிருந்து எதையும் சாப்பிடக்கூடாது என ஆளுநன் உத்தரவிட்டான்."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 64,
    "text": "எண்ணப்பட்ட முழுத் தொகை 42,360 பேர்."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 65,
    "text": "இவர்களைத் தவிர அவர்களின் ஆண் பெண் வேலைக்காரர் 7,337 பேரும், பாடகர்களும் பாடகிகளும் 200 பேரும் இருந்தனர்."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 66,
    "text": "அவர்களிடம் 736 குதிரைகளும், 245 கோவேறு கழுதைகளும்,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 67,
    "text": "435 ஒட்டகங்களும், 6,720 கழுதைகளும் இருந்தன."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 68,
    "text": "¶ அவர்கள் எல்லோரும் எருசலேமிலுள்ள யெகோவாவின் ஆலயத்துக்கு வந்து சேர்ந்தவுடனே, குடும்பத் தலைவர்களில் சிலர் இறைவனுடைய ஆலயத்தை அதனுடைய இடத்தில் திரும்பக் கட்டுவதற்காக சுயவிருப்புக் காணிக்கைகளைக் கொடுத்தார்கள்."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 69,
    "text": "அவர்கள் தங்களால் முடியுமானவரை 61,000 தங்கக் காசுகளையும், 5,000 வெள்ளியையும், ஆசாரியருக்கான 100 உடைகளையும் அவ்வேலைக்கென ஆலயத் திரவிய களஞ்சியத்துக்குக் கொடுத்தார்கள்."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 70,
    "text": "¶ ஆசாரியர்கள், லேவியர்கள், பாடகர்கள், வாசல் காவலர்கள், ஆலய பணியாளர்கள் ஆகியோர் வேறுசில மக்களுடனும், மீதியான இஸ்ரயேலருடனும் தங்கள் சொந்தப் பட்டணங்களில் குடியமர்ந்தார்கள்."
  }
]
