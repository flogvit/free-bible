[
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 1,
    "text": "¶ ထာဝရ ဘုရား၏ ဂုဏ်ကျေးဇူးတော်ကို  ချီးမွမ်း ကြလော့။ နာမ  တော်ကို ပဌနာ  ပြုကြလော့။ အမှု တော်တို့ကို လူ  များတို့အား  ပြသ ကြလော့။"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 2,
    "text": "ထာဝရ ဘုရားကို  သီချင်း ဆိုကြလော့။ ဆာလံ သီချင်း ကို  ဆိုကြလော့။ အံ့ဘွယ် သော အမှုတော်အပေါင်း တို့ကို ဟောပြော ကြလော့။"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 3,
    "text": "သန့်ရှင်း သောနာမ တော်၌  ဝါကြွား  ဝမ်းမြောက်ကြလော့။ ထာဝရဘုရား  ကို ရှာ သောသူတို့သည် စိတ် နှလုံးရွှင်လန်း ကြစေ။"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 4,
    "text": "ထာဝရဘုရား နှင့်  တန်ခိုး တော်ကို ရှာ ကြလော့။ မျက်နှာ တော်ကို အစဉ် မပြတ်ရှာ ကြလော့။"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 5,
    "text": "စီရင်တော်မူသောအံ့ဩ ဘွယ်တို့ကို၎င်း၊ ထူးဆန်း သော အမှု တော်တို့နှင့်  နှုတ်ထွက် ပညတ် တို့ကို၎င်း အောက်မေ့ ကြလော့။"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 6,
    "text": "ထာဝရ ဘုရား၏ကျွန် အာဗြဟံ အမျိုး ၊ ရွေးကောက်  တော်မူသောယာကုပ် အနွှယ် တို့၊"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 7,
    "text": "ကိုယ်တော် မြတ် ထာဝရဘုရား  သည် ငါ တို့ ဘုရား  သခင်ဖြစ်တော်မူ၏။ မြေကြီး တပြင်လုံး ၌  တရား စီရင် ပိုင်တော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 8,
    "text": "ငါသည်သင် တို့အမွေခံ ရာဘို့ခါနာန်  ပြည် ကို သင် ၌ ပေး မည်ဟု ငါတို့အမျိုးသည် အရေ  အတွက်အားဖြင့်မများ၊"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 9,
    "text": "အလွန်နည်း ၍ ထိုပြည် ၌ ဧည့်သည် ဖြစ် လျက်နေသောအခါ၊"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 10,
    "text": "အာဗြဟံ ၌ ဂတိထား၍ ၊ ဣဇာက် ၌ ကျိန်ဆို တော်မူလျက်၊"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 11,
    "text": "ယာကုပ် ၌ မြဲမြံ သောတရား ၊ ဣသရေလ ၌ နိစ္စ ထာဝရပဋိညာဉ် ဖြစ်စေခြင်းငှါ၊"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 12,
    "text": "လူမျိုး အဆက်တထောင် တိုင်အောင် မိန့်မြွက် တော်မူသောနှုတ်ကပတ် တည်းဟူသော ဝန်ခံ ခြင်းတရားတော်ကို အစဉ်အမြဲ အောက်မေ့ တော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 13,
    "text": "သူတို့သည် တမြို့ မှ တမြို့ သို့ ၎င်း၊ တနိုင်ငံ မှ  တနိုင်ငံ သို့ ၎င်း၊ လှည့်လည် ၍ သွားကြသောအခါ၊"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 14,
    "text": "သူ တို့ကို ညှဉ်းဆဲ စေခြင်းငှါ  အဘယ်သူ အားမျှ အခွင့်ပေး တော်မ မူ။ သူ  တို့အတွက် လည်းရှင်ဘုရင် တို့ကို ဆုံးမ  လျက်၊"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 15,
    "text": "ငါ့ ထံ၌ ဘိသိတ် ခံသောသူတို့ကို မ  ထိ မခိုက်နှင့်။ ငါ ၏ ပရောဖက် တို့ကို  အပြစ် မ ပြုနှင့်ဟု မိန့်တော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 16,
    "text": "တဖန်တုံ ၊ ထိုပြည် ၌  မွတ်သိပ် ခြင်းဘေးကို ခေါ် ၍၊ အစာ  အာဟာရတည်းဟူသောအထောက် အပင့် ရှိသမျှ ကို ချိုးဖျက် တော်မူသောအခါ၊"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 17,
    "text": "ကျွန် ဖြစ်စေ ဘို့ အရောင်း ခံရသောယောသပ်  ကို သူ  တို့ရှေ့ မှာ စေလွှတ် တော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 18,
    "text": "သူ့ ကိုခြေ ချင်းခတ်၍ သံ  နှင့် ညှဉ်းဆဲ ကြ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 19,
    "text": "သူ ၏စကား  မ ပြည့်စုံ မှီတိုင်အောင်၊ ထာဝရ  ဘုရား ၏ အမိန့် တော်အတိုင်း စုံစမ်း ခြင်းကို ခံရ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 20,
    "text": "လူ တို့ကို အစိုးရ  သောအရှင်တည်းဟူသော ရှင် ဘုရင်သည် စေလွှတ် ၍  သူ့ ကို နှုတ် ပြီးမှ  ချမ်းသာ ပေးတော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 21,
    "text": "သူသည် မိမိ  အလိုရှိ သည်အတိုင်း  မင်း အရာရှိ  တို့ကို ချည်နှောင် ၍၊"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 22,
    "text": "မှူးတော်မတ်တော်တို့ကို ဆုံးမ  ပိုင် သော အခွင့်နှင့် နန်းတော် အုပ် ၊ နိုင်ငံ တော်အုပ် အရာ၌ ထိုသူ  ကို ခန့် ထားတော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 23,
    "text": "ဣသရေလ သည်လည်း အဲဂုတ္တု  ပြည်သို့ ရောက်  လာ၍ ၊ ယာကုပ် သည် ဟာမ  အမျိုးနေရာပြည် ၌  တည်းခို ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 24,
    "text": "ဘုရားသခင်သည် မိမိ  လူ တို့ကို အလွန် များပြား စေ၍ ၊ ရန်သူ တို့ထက်  အားကြီး စေတော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 25,
    "text": "မိမိ လူ တို့ကို ရန်သူတို့သည်မုန်း ၍၊ မိမိ  ကျွန် တို့ကို ပရိယာယ် ပြုမည် အကြောင်း ၊ ထိုသူ တို့ စိတ် နှလုံးကို ပြောင်းလဲ စေတော်မူ ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 26,
    "text": "တဖန်မိမိ ကျွန်  မောရှေ နှင့် ရွေးကောက် တော်မူသော အာရုန် ကို စေလွှတ် တော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 27,
    "text": "အဲဂုတ္တုပြည်သားတို့တွင်၊ လက္ခဏာ  သက်သေ တော်တို့ကိုပြ ၍ ၊ ဟာမ အမျိုးနေရာပြည် ၌  အံ့ဘွယ် သော အမှုတို့ကို ပြုကြ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 28,
    "text": "မှောင်မိုက် ကိုစေလွှတ် ၍ ၊ မိုက်မဲ စေတော်မူ၏။ သူတို့သည် နှုတ်ကပတ် တော်ကို ဆန့်ကျင် ဘက်မ ပြုရကြ။"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 29,
    "text": "သူ တို့ရေ များကို အသွေး ဖြစ်စေ ၍ ၊ ငါး များကို သေ  စေတော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 30,
    "text": "သူ တို့မြေ သည် များစွာသော ဘား  တို့ကို မင်း အိပ်ရာအခန်း တို့ ၌  ပင်ဘွား လေ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 31,
    "text": "အမိန့် တော်ရှိ၍  ယင်ရဲ နှင့်ခြင် တို့သည် တပြည်လုံး ကို  နှံ့ပြား ကြ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 32,
    "text": "မိုဃ်းရေ အစား မိုဃ်းသီး ကို၎င်း၊ သူ  တို့မြေ ပေါ်  မှာ မီးလျှံ ကို၎င်းပေး တော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 33,
    "text": "သူ တို့စပျစ် နွယ်ပင်နှင့်  သင်္ဘော သဖန်းပင်တို့ကို ထိခိုက် ၍ ၊ တပြည်လုံး ၌ရှိသောသစ်ပင် များကို ချိုး တော်မူ ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 34,
    "text": "အမိန့် တော်ရှိ၍ မ  ရေတွက်နိုင်အောင်၊ အရာဘကျိုင်း နှင့်  ယာလက်ကျိုင်း တို့သည် လာ  ၍၊"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 35,
    "text": "သူ တို့ပြည် မှာ  ဟင်းသီး ဟင်းရွက်ရှိသမျှ တို့ကို၎င်း ၊ မြေဩဇာ အသီး အနှံတို့ကို၎င်း ကိုက်စား ကြ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 36,
    "text": "သူ တို့အစွမ်း သတ္တိ အထွဋ် အမြတ်တည်းဟူသောသူ တို့ ပြည် မှာ  သားဦး အပေါင်း တို့ကို ဒဏ်ခတ် တော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 37,
    "text": "မိမိလူတို့ကို ရွှေ ငွေ ပါလျက်  ထုတ် ဆောင်တော်မူ ၍  ၊ သူ တို့အစုစု ၌  အားနည်း သော သူတ  ယောက်မျှမရှိ။"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 38,
    "text": "အဲဂုတ္တု ပြည်သည် သူ  တို့ကို ကြောက် သောကြောင့်၊ သူ  တို့သည် ထွက်သွား သောအခါ  တပြည်လုံးဝမ်းမြောက် ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 39,
    "text": "သူတို့အပေါ်မှာ မိုဃ်းတိမ် ကိုဖြန့် မိုး ၍ ၊ ညဉ့် အခါ လင်း စရာဘို့ မီး  ကိုပေးတော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 40,
    "text": "သူတို့သည် တောင်း သောအခါ  ငုံး များကို ဆောင် ခဲ့တော်မူ၍ ၊ သူ တို့ကို ကောင်းကင် မုန့် နှင့် ရောင့်ရဲ စေတော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 41,
    "text": "ကျောက် ကိုလည်း ဖွင့်လှစ် တော်မူသဖြင့် ၊ ရေ  သည် ထွက် ၍ သွေ့ ခြောက်သောအရပ်၌  မြစ် ကဲ့သို့စီးသွား  လေ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 42,
    "text": "အကြောင်း မူကား၊ မိမိ  ကျွန်  အာဗြဟံ ၌  ထားခဲ့ ဘူးသော သန့်ရှင်း သော ဂတိတော် ကို အောက်မေ့ တော်မူ ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 43,
    "text": "ရွေးကောက် တော်မူသောမိမိ လူ တို့ကို ဝမ်းမြောက်  ရွှင်လန်း ခြင်းနှင့်တကွ ထုတ် ဆောင်တော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 105,
    "verseId": 44,
