[
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 1,
    "text": "¶ ကောင်းကင် ဘုံ၌  ထာဝရဘုရား ကို ချီးမွမ်း ကြလော့။ ဘဝဂ် ပေါ် မှာ ချီးမွမ်း ကြလော့။"
  },
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 2,
    "text": "ကောင်းကင် တမန်အပေါင်း တို့၊ ထာဝရ  ဘုရား ကို ချီးမွမ်း ကြလော့။ ကောင်းကင်ဗိုလ်ခြေ အပေါင်း တို့ ချီးမွမ်း ကြလော့။"
  },
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 3,
    "text": "နေ လ တို့၊ ထာဝရ  ဘုရားကိုချီးမွမ်း ကြလော့။ ထွန်းလင်း သော ကြယ် အပေါင်း တို့၊ ချီးမွမ်း ကြလော့။"
  },
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 4,
    "text": "ကောင်းကင် အထပ်ထပ်နှင့်  ကောင်းကင် ပေါ်  မှာ ရေ  များတို့၊ ချီးမွမ်း ကြလော့။"
  },
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 5,
    "text": "ထို အရာတို့ကိုအမိန့် တော်ရှိ၍ ၊ ဖန်ဆင်း တော်မူသောကြောင့် ၊ ထာဝရဘုရား ၏နာမတော် ကို ချီးမွမ်း ကြစေ။"
  },
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 6,
    "text": "ထို အရာတို့ကို ကာလ  အစဉ်အဆက် အမြဲတည်  စေတော်မူ၍ ၊ မ ပျက် ရသောဓမ္မတာ ကို စီရင် တော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 7,
    "text": "မြေကြီး ၌ ရှိသောအရာ၊ ငါး ကြီးများ၊ နက်နဲ ရာ အရပ် များ၊"
  },
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 8,
    "text": "မီး နှင့် မိုဃ်းသီး ၊ မိုဃ်းပွင့် နှင့် အခိုး အငွေ့၊ အမိန့်  တော်ကို နားထောင် သော လေပြင်း မုန်တိုင်း၊"
  },
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 9,
    "text": "တောင် ကြီးတောင် ငယ်ရှိသမျှ ၊ အသီး ကိုသီးသောအပင် ၊ အာရဇ် ပင် ရှိသမျှ၊"
  },
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 10,
    "text": "သားရဲ နှင့် သားယဉ် အပေါင်း ၊ တွား တတ်သော တိရိစ္ဆာန်နှင့်  ပျံ တတ်သော ငှက် အစရှိသော၊"
  },
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 11,
    "text": "လောကီ ရှင် ဘုရင်များနှင့်  ပြည်သူ ပြည်သားအပေါင်း ၊ မင်း များနှင့်  လောကီ တရားသူကြီး အပေါင်း၊"
  },
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 12,
    "text": "လူပျို နှင့် အပျို များ၊ လူအို  နှင့် လူ ကလေးများတို့၊ ထာဝရဘုရား  ကို ချီးမွမ်း ကြလော့။"
  },
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 13,
    "text": "နာမတော်တပါးတည်း သာလျှင် မြတ်၍၊ ဘုန်း တော်သည်မြေကြီး  နှင့် ကောင်းကင် အပေါ် ထက်၌ ရှိသောကြောင့်၊ ထာဝရ  ဘုရား၏ နာမတော် ကို ချီးမွမ်း ကြစေ။"
  },
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 14,
    "text": "မိမိ လူစု တို့၏ဦးချို ကို  ချီးမြှင့် တော်မူသဖြင့် ၊ အနီး တော်၌ရှိသောလူစု ၊ ဣသရေလ အမျိုးသားတည်းဟူသော မိမိ သန့်ရှင်း သူအပေါင်း တို့၏  ချီးမွမ်း ရာဖြစ် တော်မူ၏။ ဟာလေလုယ။"
  }
]
