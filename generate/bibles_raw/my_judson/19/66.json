[
  {
    "bookId": 19,
    "chapterId": 66,
    "verseId": 1,
    "text": "¶ မြေကြီး သားအပေါင်း တို့၊ ဘုရား  သခင့်ရှေ့ တော်၌ ကျူးဧ သောအသံကို ပြု၍၊"
  },
  {
    "bookId": 19,
    "chapterId": 66,
    "verseId": 2,
    "text": "နာမ တော်၏ဂုဏ် ကို သီချင်း ဆိုကြလော့။ ချီးမွမ်း ခြင်း၏ ဂုဏ် အသရေကို ပြ ကြလော့။"
  },
  {
    "bookId": 19,
    "chapterId": 66,
    "verseId": 3,
    "text": "ကိုယ်တော် စီရင်သောအမှု တို့သည် အလွန်အံ့ဩ ဘွယ် ဖြစ်ကြပါ၏။ တန်ခိုး တော်ကြီး သောကြောင့် ၊ ရန်သူ တို့သည် ကိုယ်တော် ကို  တောင်းပန် ကြပါလိမ့်မည်။"
  },
  {
    "bookId": 19,
    "chapterId": 66,
    "verseId": 4,
    "text": "မြေကြီး သားအပေါင်း တို့သည် ကိုယ်တော် ကို  ကိုးကွယ် ၍ ၊ သီချင်း ဆိုကြပါစေသော။ နာမ  တော်အား  သီချင်း ဆိုကြပါစေသောဟု ဘုရား  သခင်အား  လျှောက် ထားကြလော့။"
  },
  {
    "bookId": 19,
    "chapterId": 66,
    "verseId": 5,
    "text": "ဘုရား သခင်စီရင် တော်မူသောအမှုတော်ကို လာ  ၍  ကြည့် ကြလော့။ လူ  သား တို့တွင်စီရင်တော်မူသောအမှု တို့သည် အံ့ဩ  ဘွယ် ဖြစ်ကြ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 66,
    "verseId": 6,
    "text": "ပင်လယ် ကို  ကုန်း ဖြစ် စေတော်မူ၏။ သူတို့သည် ရေစီး  ရာအရပ်ကို ခြေ ဖြင့်  ရှောက် သွားကြသည်ဖြစ်၍ ၊ ငါတို့သည် ဘုရား  သခင်၌  ဝမ်းမြောက် ကြ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 66,
    "verseId": 7,
    "text": "တန်ခိုး တော်အားဖြင့် အစဉ် အမြဲအုပ်စိုး တော်မူ၏။ မျက်စိ တော်သည် လူ  အမျိုးမျိုးတို့ကို ကြည့်ရှု သည် ဖြစ်၍ ၊ ငြင်းဆန် သောသူတို့သည် မ  ဝါကြွား ကြစေနှင့်။"
  },
  {
    "bookId": 19,
    "chapterId": 66,
    "verseId": 8,
    "text": "အချင်းလူစု တို့၊ ငါ တို့ ဘုရား  သခင်ကို ကောင်းကြီး ပေးကြလော့။ ဂုဏ်ကျေးဇူးတော်ကို ချီးမွမ်း သော စကား  သံနှင့် ကြွေးကြော် ကြလော့။"
  },
  {
    "bookId": 19,
    "chapterId": 66,
    "verseId": 9,
    "text": "ငါ တို့အသက် ကို မ  သေ စေမည်အကြောင်းနှင့် ၊ ခြေ ကိုလည်း မချော် စေမည်အကြောင်း စောင့်မ တော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 66,
    "verseId": 10,
    "text": "အိုဘုရား သခင်၊ ကိုယ်တော်သည် အကျွန်ုပ် တို့ကို စုံစမ်း တော်မူပြီ။ ငွေ ကို စစ်ဆေး သကဲ့သို့ အကျွန်ုပ် တို့ကို စစ်ဆေး တော်မူပြီ။"
  },
  {
    "bookId": 19,
    "chapterId": 66,
    "verseId": 11,
    "text": "ကျော့ကွင်း ထဲမှာ  ကျော့မိ စေ၍၊ ကျောက် ကုန်းပေါ် မှာ လေးသော ဝန် ကို တင် တော်မူပြီ။"
  },
  {
    "bookId": 19,
    "chapterId": 66,
    "verseId": 12,
    "text": "အကျွန်ုပ် တို့ ခေါင်း ပေါ် မှာ သူတပါး ကို စီး  စေတော်မူပြီ။ မီး  ၌ ၎င်း  ၊ ရေ ၌ ၎င်း  သွား ရသော်လည်း၊ ကျေးဇူးတော်ကြောင့် ကြွယ်ဝ ခြင်းသို့  ရောက် ကြပါ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 66,
    "verseId": 13,
    "text": "မီးရှို့ ရသောယဇ်ပါ လျက် အိမ် တော်သို့ အကျွန်ုပ်သွား ပါမည်။"
  },
  {
    "bookId": 19,
    "chapterId": 66,
    "verseId": 14,
    "text": "ဆင်းရဲ ခံရစဉ်အခါ ၊ အကျွန်ုပ် သည် နှုတ် ကို ဖွင့် ၍  မြွက်ဆို သည်အတိုင်း ၊ သစ္စာ ဝတ်ကို ဖြေ ပါမည်။"
  },
  {
    "bookId": 19,
    "chapterId": 66,
    "verseId": 15,
    "text": "ဆူဖြိုး သော သိုး  တို့ကို  နံ့သာ ပေါင်းနှင့်တကွ မီးရှို့ ရာယဇ် ပြု၍ ပူဇော် ပါမည်။ နွား နှင့်  ဆိတ် တို့ကိုလည်း စီရင် ပါမည်။"
  },
  {
    "bookId": 19,
    "chapterId": 66,
    "verseId": 16,
    "text": "ဘုရား သခင်ကို ကြောက်ရွံ့ သော သူအပေါင်း တို့၊ လာ  ၍  နားထောင် ကြလော့။ ငါ့ ဝိညာဉ် အဘို့  အဘယ်သို့ ကျေးဇူးပြု တော်မူသည်ကို ငါကြားပြော မည်။"
  },
  {
    "bookId": 19,
    "chapterId": 66,
    "verseId": 17,
    "text": "ငါ သည် ဘုရား  သခင်ကို နှုတ် နှင့် အော်ဟစ် ၍ ၊ ဂုဏ်တော်ကိုလည်း လျှာ နှင့် ချီးမွမ်း ရပြီ။"
  },
  {
    "bookId": 19,
    "chapterId": 66,
    "verseId": 18,
    "text": "ငါ သည် စိတ် နှလုံးထဲမှာ  ဒုစရိုက် ကို ငဲ့ကွက် လျှင် ၊ ဘုရား ရှင်သည် နားထောင် တော်မ မူ။"
  },
  {
    "bookId": 19,
    "chapterId": 66,
    "verseId": 19,
    "text": "ယခု မူကား၊ ဘုရား  သခင်သည် နားထောင် ၍၊ ငါ မြွက်ဆိုသော ပဌနာ  စကား သံကို  မှတ် တော်မူပြီ။"
  },
  {
    "bookId": 19,
    "chapterId": 66,
    "verseId": 20,
    "text": "ငါ မြွက်ဆိုသော ပဌနာ  ကို ပယ် တော်မ မူ။ ကျေးဇူး တော်ကို ငါ မှ  ရုပ်သိမ်းတော်မမူသော ဘုရား  သခင်သည် မင်္ဂလာ ရှိတော်မူစေသတည်း။"
  }
]
