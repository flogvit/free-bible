[
  {
    "bookId": 19,
    "chapterId": 75,
    "verseId": 1,
    "text": "¶ အိုဘုရား သခင်၊ အကျွန်ုပ်တို့သည် ကိုယ်တော် ကို ချီးမွမ်း ကြပါ၏။ နာမတော် နီး ကြောင်း ကို အံ့ဘွယ် သော အမှုတော်တို့သည် သက်သေခံ ကြသည်ဖြစ်၍၊ ကိုယ်တော် ကို ချီးမွမ်း ကြပါ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 75,
    "verseId": 2,
    "text": "ချိန်းချက် သော အချိန်ကာလနှင့်  ငါ တွေ့ကြုံ သောအခါ ဖြောင့်မတ် စွာ တရား  စီရင်မည်။"
  },
  {
    "bookId": 19,
    "chapterId": 75,
    "verseId": 3,
    "text": "မြေကြီး နှင့်  မြေကြီး သားအပေါင်း တို့သည် လှုပ်ရှား ခြင်းရှိသည် ဖြစ်၍၊ မြေကြီးတည်သော တိုင် တို့ကို ငါထောက် ခံရ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 75,
    "verseId": 4,
    "text": "မိုက်သောအကျင့် ကို မ  ကျင့်ကြနှင့်ဟု မိုက်  သောသူတို့ အား  ၎င်း၊ ဦးချို ကို မ  မြှောက် ကြနှင့်။"
  },
  {
    "bookId": 19,
    "chapterId": 75,
    "verseId": 5,
    "text": "သင် တို့၏ ဦးချို ကို မ  ချီးမြှောက် ကြနှင့်။ လည်ပင်း  ခိုင်မာ လျက်  မပြော ကြနှင့်ဟု မတရားသောသူတို့ အား၎င်း ငါပြောထား၏။"
  },
  {
    "bookId": 19,
    "chapterId": 75,
    "verseId": 6,
    "text": "အရှေ့ ၊ အနောက် ၊ တောင် အရပ်တို့တွင်  အဘယ်အရပ်မျှ  ကျေးဇူး မ ပြုနိုင်။"
  },
  {
    "bookId": 19,
    "chapterId": 75,
    "verseId": 7,
    "text": "ဘုရား သခင်သည် စီရင် ပိုင်တော်မူ၏။ တ  ယောက် ကို နှိမ့်ချ ၍ ၊ တ ယောက်ကို ချီးမြှောက် တော်မူ ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 75,
    "verseId": 8,
    "text": "ထာဝရဘုရား ၏လက် တော်၌  ဖလား ရှိ၏။ နီ  သောစပျစ် ရည်ပါ၏။ ဆေး  မျိုးနှင့်ရောလျက်ရှိ၏။ ထို  စပျစ်ရည်ကို  လောင်း တော်မူ၏။ အနည် အဖတ်ကိုလည်း  မတရား သော မြေ သားအပေါင်း တို့သည် ညှစ် ၍ သောက် ရကြ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 75,
    "verseId": 9,
    "text": "ငါ မူကား အစဉ် မပြတ်ချီးမွမ်း ၍ ၊ ယာကုပ် အမျိုး ၏ ဘုရား  သခင်ကို  ထောမနာသီချင်း ဆိုပါမည်။"
  },
  {
    "bookId": 19,
    "chapterId": 75,
    "verseId": 10,
    "text": "မတရား သောသူတို့၏ ဦးချို အပေါင်း ကို ငါချိုး  မည်။ တရား  သောသူတို့ ၏ဦးချို တို့မူကား၊ ချီးမြှောက် ခြင်းသို့ ရောက်ရကြလိမ့်မည်။"
  }
]
