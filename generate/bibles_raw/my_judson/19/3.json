[
  {
    "bookId": 19,
    "chapterId": 3,
    "verseId": 1,
    "text": "¶ အိုထာဝရဘုရား ၊ အကျွန်ုပ် ၏ရန်သူ တို့သည်၊ အလွန် တိုးပွါး၍၊ အကျွန်ုပ် တဘက် ၌ ထ  သောသူတို့သည် များ ကြပါ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 3,
    "verseId": 2,
    "text": "သူ သည်ဘုရား သခင်ကို အမှီ ပြု၍ ချမ်းသာ မ ရဟု အကျွန်ုပ် ကို ရည်ဆောင် ၍  ပြော သောသူ အများ  ရှိကြပါ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 3,
    "verseId": 3,
    "text": "သို့သော်လည်း ၊ အိုထာဝရဘုရား ၊ ကိုယ်တော် သည် အကျွန်ုပ် ၏အကွယ် အကာဖြစ်တော်မူ၏။ အကျွန်ုပ်  ၏ ဘုန်း လည်းဖြစ်တော်မူ၏။ အကျွန်ုပ် ၏ဦးခေါင်း ကို ချီ ကြွသော သူလည်း ဖြစ်တော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 3,
    "verseId": 4,
    "text": "ငါသည် ထာဝရဘုရား  ထံ သို့အသံ ကိုလွှင့်၍ အော်ဟစ် သောအခါ ၊ သန့်ရှင်း သော တောင် တော်ပေါ် မှာ နားထောင် တော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 3,
    "verseId": 5,
    "text": "ထာဝရဘုရား သည် ငါ့ ကိုမစ တော်မူသောကြောင့်  ၊ ငါ သည် အိပ် ၍  ပျော် ခြင်းအခွင့်နှင့် နိုး  ခြင်း အခွင့်ရှိ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 3,
    "verseId": 6,
    "text": "ငါ့ ကိုရန်ဘက်ပြု၍ ဝန်းရံ သော သူ  အထောင် အသောင်းကို ငါမ ကြောက် ဘဲနေမည်။"
  },
  {
    "bookId": 19,
    "chapterId": 3,
    "verseId": 7,
    "text": "အိုထာဝရဘုရား ထ တော်မူပါ။ အကျွန်ုပ် ၏ ဘုရား  သခင်၊ အကျွန်ုပ် ကို ကယ်မ တော်မူပါ။ ကိုယ်တော်သည် အကျွန်ုပ် ၏ ရန်သူ တို့၏ ပါး ရိုးကိုရိုက် ၍၊ မတရား  သောသူတို့၏ သွား ကိုချိုး တော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 3,
    "verseId": 8,
    "text": "ထာဝရ ဘုရား၏ ကျေးဇူး တော်ကြောင့် ချမ်းသာ ရပါ၏။ ပေးတော်မူသောကောင်းကြီးမင်္ဂလာသည် ကိုယ်တော်၏ လူစု  အပေါ် သို့ သက်ရောက်ပါစေသော။"
  }
]
