[
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 1,
    "text": "¶ ထာဝရဘုရား သည် ကောင်းမြတ် တော်မူ၍၊ ကရုဏာ  တော် အစဉ် အမြဲတည်သောကြောင့် ၊ ဂုဏ် ကျေးဇူးတော်ကို ချီးမွမ်း ကြလော့။"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 2,
    "text": "-"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 3,
    "text": "ရန်သူ ၏လက် မှ  ထာဝရဘုရား နှုတ် ၍ အရှေ့ အနောက် တောင် မြောက် အရပ်ရပ် ထဲ က စုသိမ်း သော သူတည်းဟူသော၊ ရွေး တော်မူသောသူတို့ သည် ဝန်ခံ ကြစေ။"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 4,
    "text": "သူတို့သည် တော  တွင် လူ ဆိတ်ညံရာအရပ်၌  လည် ၍၊ နေစရာ  မြို့ သို့ ရောက်သောလမ်း ကို မ  တွေ့ ကြ။"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 5,
    "text": "ဆာငတ် မွတ်သိပ် ၍  စိတ်ပျက် ကြ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 6,
    "text": "ဆင်းရဲ ခံရသောအခါ ၊ ထာဝရဘုရား ကို  အော်ဟစ်  ၍ ၊ ဆင်းရဲ ဒုက္ခထဲ က ဆယ် နှုတ်တော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 7,
    "text": "သူတို့နေစရာ မြို့ သို့  ရောက် စေခြင်းငှါ ၊ ဖြောင့်  သောလမ်း ဖြင့်  ပို့ဆောင် တော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 8,
    "text": "လူသား တို့၌ ပြုတော်မူသောကရုဏာ နှင့်  အံ့ဘွယ် သော အမှုတော်တို့ကိုထောက် ၍၊ ထာဝရဘုရား  ၏  ဂုဏ်ကျေးဇူးတော်ကို ချီးမွမ်း ကြစေ။"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 9,
    "text": "အကြောင်း မူကား၊ တောင့်တ သော ဝိညာဉ် ကို ရောင့်ရဲ စေ၍၊ မွတ်သိပ် သော ဝိညာဉ် ကိုလည်း ၊ ကောင်း  သောအရာနှင့် ဝ  စေတော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 10,
    "text": "-"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 11,
    "text": "ထိုသူတို့သည် ဘုရား  သခင်၏ အမိန့် တော်ကို ငြင်းဆန် ၍၊ အမြင့်ဆုံး သော ဘုရား၏ အကြံ တော်ကို မထီမဲ့မြင် ပြုသောကြောင့် ၊ မှောင်မိုက် ၊ သေမင်း အရိပ်၌ထိုင် လျက်၊ ဒုက္ခ  နှင့်၎င်း၊ သံကြိုး နှင့်၎င်း ချည်နှောင် လျက်နေရကြ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 12,
    "text": "ဘုရားသခင်သည် အမှု ရောက်စေ၍ ၊ သူ တို့ စိတ် ကိုနှိမ့်ချ တော်မူ၏။ သူတို့သည် လဲ  ၍ ထောက်မ သော သူမ  ရှိဘဲ၊"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 13,
    "text": "ဆင်းရဲ ခံရသောအခါ ၊ ထာဝရဘုရား ကို  အော်ဟစ်  ၍  ဆင်းရဲ ဒုက္ခထဲ က ကယ်တင် တော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 14,
    "text": "မှောင်မိုက် နှင့်  သေမင်း အရိပ်ထဲ က ထုတ်  ဆောင်၍  သူ တို့ချည်နှောင်  ခြင်းကို ဖြေ တော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 15,
    "text": "လူသား တို့၌  ပြုတော်မူသောကရုဏာ နှင့်  အံ့ဘွယ် သောအမှုတော်တို့ကိုထောက်၍၊ ထာဝရ  ဘုရား၏ ဂုဏ်ကျေးဇူးကို ချီးမွမ်း ကြစေ။"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 16,
    "text": "အကြောင်း မူကား၊ ကြေးဝါ တံခါး တို့ကို ချိုး ၍ ၊ သံ ကန့်လန့် တို့ကို အပိုင်းပိုင်းဖြတ် တော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 17,
    "text": "မိုက် သောသဘောရှိသောသူတို့ သည်လမ်း လွှဲ ၍ ၊ ဒုစရိုက် ကို ပြုသောကြောင့် ဆင်းရဲခြင်း နှင့် တွေ့ကြုံရကြ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 18,
    "text": "စား စရာမျိုးကို ရွံ ၍ သေခြင်း တံခါး ငါ့အနီး သို့ ရောက်ကြ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 19,
    "text": "ဆင်းရဲ ခံရသောအခါ  ထာဝရဘုရား ကို  အော်ဟစ်  ၍ ၊ ဆင်းရဲ ဒုက္ခထဲ က ကယ်တင် တော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 20,
    "text": "နှုတ်ကပတ် တော်ကိုလွှတ် သဖြင့် ၊ သူ တို့အနာ ကို ငြိမ်းစေ၍ ၊ ဖျက်ဆီး ခြင်းအရာများထဲ က နှုတ်ယူ တော်မူ ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 21,
    "text": "လူသား တို့၌  ပြုတော်မူသောကရုဏာ နှင့်  အံ့ဘွယ် သောအမှုတော်တို့ကိုထောက် ၍၊ ထာဝရဘုရား  ၏  ဂုဏ်ကျေးဇူးတော်ကို ချီးမွမ်း ကြစေ။"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 22,
    "text": "ကျေးဇူး တော် ဝန်ခံရာယဇ် ကို ပူဇော် ၍ ၊ ရွှင်လန်း  သော အသံနှင့်တကွ အမှုတော် တို့ကို ကြား ပြော ကြစေ။"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 23,
    "text": "သင်္ဘော စီးလျက် ပင်လယ် ကိုကူး ၍၊ ရေ  များ ပေါ်  မှာ လုပ်ဆောင် သောသူတို့ သည်၊"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 24,
    "text": "နက်နဲ ရာအရပ်၌  ထာဝရဘုရား ၏ အမှုတော် တို့နှင့်၊ အံ့ဘွယ် သော အမှုတော်တို့ကို မြင် ရကြ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 25,
    "text": "အမိန့် တော်ရှိ၍  လေပြင်း မုန်တိုင်း တိုက် သဖြင့် ၊ လှိုင်း တံပိုးတို့ကို ထ  စေ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 26,
    "text": "မိုဃ်း ကောင်းကင်တိုင်အောင်တက် လျက်၊ နက်နဲ ရာထဲသို့ ဆင်း လျက် တွေ့သောဘေး ကြောင့် ၊ သူတို့သည် စိတ်ပျက် ကြ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 27,
    "text": "တလည်လည် သွားလျက်  ယစ်မူး သော သူကဲ့သို့  တိမ်းယိမ်း လျက်နေ၍  ဉာဏ် တိမ် မြုပ်ခြင်းရှိကြ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 28,
    "text": "ဆင်းရဲ ခံရသောအခါ  ထာဝရဘုရား ကို  အော်ဟစ်  ၍ ၊ ဆင်းရဲ ဒုက္ခထဲ က ထုတ် ဆောင်တော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 29,
    "text": "လေပြင်း ကို ပျောက် စေတော်မူ၍ ၊ လှိုင်း တံပိုးများလည်း  ငြိမ်ဝပ် ကြ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 30,
    "text": "ထိုသို့  ငြိမ်ဝပ် သောကြောင့် သူတို့သည် ဝမ်းမြောက် ကြ၏။ အလို  ရှိရာ သင်္ဘော ဆိပ်သို့  ပို့ဆောင် တော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 31,
    "text": "လူ သားတို့၌  ပြုတော်မူ သော ကရုဏာ  နှင့်  အံ့ဘွယ် သော အမှုတော တို့ကို ထောက် ၍၊ ထာဝရဘုရား  ၏  ဂုဏ်ကျေးဇူးတော်ကို ချီးမွမ်း ကြစေ။"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 32,
    "text": "လူ ပရိတ်သတ် ၏ အလယ် မှာ ထာဝရ  ဘုရားကို ချီးမြှောက် ၍  အသက်ကြီး သူတို့၏ အစည်း အဝေး၌  ချီးမွမ်း ကြစေ။"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 33,
    "text": "မြစ် တို့ကို လွင်ပြင် ဖြစ် စေခြင်းငှါ၎င်း၊ စမ်း ရေ ထွက်ရာ အရပ် ကို လည်း သွေ့ ခြောက်စေခြင်းငှါ ၎င်း ပြု တော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 34,
    "text": "မြေ ကောင်းသော ပြည် ကို ပြည်သူ ပြည်သားတို့ ၏ အပြစ် ကြောင့်  ဆား မြေဖြစ်စေ တော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 35,
    "text": "တဖန်လွင်ပြင် ကို ရေ  နှင့်ပြည့် စေခြင်းငှါ ၎င်း  ၊ သွေ့ခြောက် သော အရပ် ကိုလည်း စမ်းရေ ထွက်စေ ခြင်းငှါ ၎င်း ပြု တော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 36,
    "text": "ထိုအရပ် ၌လည်း ၊ ငတ်မွတ် သောသူတို့ကို နေရာ  ချတော်မူ၍ ၊ သူတို့သည် မိမိနေ  စရာဘို့မြို့ ကို တည် ကြ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 37,
    "text": "လယ် လုပ် လျက် ၊ စပျစ် ဥယျာဉ်ကိုလည်း  စိုက်ပျိုး လျက် ၊ မြေ အသီးအနှံတို့ကို ပြုစု ကြ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 38,
    "text": "ကောင်းကြီး ပေးတော်မူ၍ ၊ သူတို့သည် အလွန်  ပွားများ ကြ၏။ သူ  တို့သိုး နွားများကိုလည်း  လျော့ စေတော်မ မူ။"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 39,
    "text": "တဖန် သူတို့သည် လျော့ ၍ ညှဉ်းဆဲ ခြင်း၊ ငြိုငြင်  ခြင်း၊ စိတ် ပူပန်ခြင်းအားဖြင့် နှိမ့်ချ လျက်နေရကြ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 40,
    "text": "မင်းသား တို့ကို အရှက်ခွဲ ၍ ၊ လမ်း မ ရှိသော တော  အရပ်၌  လည် စေတော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 41,
    "text": "ဆင်းရဲ သောသူကိုလည်း  ဒုက္ခ မှ  ထမြောက် စေ ၍  ၊ သိုးစု ကဲ့သို့ အိမ်ထောင် ပွားများ စေတော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 42,
    "text": "ဖြောင့်မတ် သောသူတို့ သည် မြင် ၍ ၊ ဝမ်းမြောက် ကြ၏။ ခပ်သိမ်း သော ဒုစရိုက် သည်လည်း  မိမိ နှုတ် ကို ပိတ် ရ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 43,
    "text": "အကြင် သူသည်ပညာရှိ ၏။ ထိုသူသည် ဤ  အမှုအရာ တို့ကို ဆင်ခြင် ၍ ၊ ထာဝရဘုရား ၏ ကရုဏာ  ကျေးဇူးတော်ကို နားလည် လိမ့်မည်။"
  }
]
