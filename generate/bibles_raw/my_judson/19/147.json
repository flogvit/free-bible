[
  {
    "bookId": 19,
    "chapterId": 147,
    "verseId": 1,
    "text": "¶ ထာဝရ ဘုရားကို ချီးမွမ်း ကောင်း သည်ဖြစ်၍၊ ချီးမွမ်း ကြလော့။ ငါ တို့၏ဘုရား သခင်ကို ထောမနာ  ပြု ခြင်းသည် သာယာ  လျောက်ပတ် သည် ဖြစ်၍၊ ထောမနာ သီချင်းဆိုကြလော့။"
  },
  {
    "bookId": 19,
    "chapterId": 147,
    "verseId": 2,
    "text": "ထာဝရဘုရား သည် ယေရုရှလင် မြို့ကို တည်ဆောက်  ၍၊ အဝေး  သို့နှင်လိုက်သော ဣသရေလ  အမျိုးသားတို့ကို စုဝေး  စေတော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 147,
    "verseId": 3,
    "text": "စိတ် ကြေမွ သောသူတို့ကို နှစ်သိမ့် စေ၍ ၊ သူ တို့၏ အနာ  ကို  ကု တော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 147,
    "verseId": 4,
    "text": "ကြယ် များကိုရေတွက် ၍ အသီးအသီး  တို့ကို သမုတ် တော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 147,
    "verseId": 5,
    "text": "ငါ တို့၏ဘုရား ရှင်သည် ကြီးမြတ် တော်မူ၏။ တန်ခိုး တော်လည်း  ကြီး ၏။ ဉာဏ် တော်သည်အနန္တ ဖြစ်၏။"
  },
  {
    "bookId": 19,
    "chapterId": 147,
    "verseId": 6,
    "text": "ထာဝရဘုရား သည် စိတ် နှိမ့်ချသောသူတို့ ကို ကြွပင့် ၍၊ မ  တရားသောသူတို့ ကိုကား၊ မြေ ပေါ် မှာ လှဲ တော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 147,
    "verseId": 7,
    "text": "ဂုဏ်တော်ကိုချီးမွမ်း လျက်  ထာဝရဘုရား  ရှေ့တော်၌ သီချင်း ဆိုကြလော့။ စောင်း တီး၍၊ ငါ တို့၏ ဘုရား  သခင်ကို  ထောမနာ သီချင်းဆိုကြလော့။"
  },
  {
    "bookId": 19,
    "chapterId": 147,
    "verseId": 8,
    "text": "ကောင်းကင် ကို မိုဃ်းတိမ် များနှင့်  ဖုံးလွှမ်း သဖြင့်၊ မြေကြီး ဘို့  မိုဃ်း ရေကိုပြင်ဆင် ၍၊ တောင် များပေါ်မှာ မြက်ပင် ကိုပေါက် စေတော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 147,
    "verseId": 9,
    "text": "မြည် တတ်သော ကျီးကန်း ကလေး မှစ၍ ၊ တိရစ္ဆာန် များတို့ကို ကျွေးမွေး တော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 147,
    "verseId": 10,
    "text": "မြင်း ၏ခွန်အား နှင့်လူ ၏လျင်မြန် ခြင်းကို  အားရ နှစ်သက်တော်မူခြင်းမ ရှိ။"
  },
  {
    "bookId": 19,
    "chapterId": 147,
    "verseId": 11,
    "text": "ကြောက်ရွံ့ သောသူနှင့် ကရုဏာ  တော်ကို  မြော်လင့် သောသူတို့ ကို ထာဝရဘုရား  နှစ်သက် တော်မူ ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 147,
    "verseId": 12,
    "text": "အိုယေရုရှလင် မြို့၊ ထာဝရဘုရား  ကို ချီးမွမ်း လော့။ အိုဇိအုန် မြို့၊ သင် ၏ဘုရား သခင်ကို ချီးမွမ်း လော့။"
  },
  {
    "bookId": 19,
    "chapterId": 147,
    "verseId": 13,
    "text": "အကြောင်း မူကား၊ သင် ၏တံခါး ကန့်လန့် တို့ကို ခိုင်မာ စေ၍၊ သင် ၏ အထဲမှာ သားသမီး  များကို ကောင်းကြီး  ပေးတော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 147,
    "verseId": 14,
    "text": "သင် ၏ပြည်စွန်း ပြည်နားမှာ အမှုအရေးကို ငြိမ်းစေ  ၍၊ အကောင်း ဆုံးသော စပါး နှင့် သင့် ကို ဝ  စွာ ကျွေးမွေးတော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 147,
    "verseId": 15,
    "text": "မြေကြီး ပေါ် သို့ဗျာဒိတ် တော်ကို လွှတ် တော်မူ၏။ နှုတ်ကပတ် တော်သည် အလျင် အမြန်ပြေး တတ်ပါ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 147,
    "verseId": 16,
    "text": "မိုဃ်းပွင့် ကို သိုးမွေး ကဲ့သို့ ချ တော်မူ၏။ နှင်းခဲ ကိုလည်း ပြာ ကဲ့သို့ ဆွတ်ဖြူ တော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 147,
    "verseId": 17,
    "text": "မိမိ မိုဃ်းသီး ကို စားနုတ် စားပေါက်ကဲ့သို့ လွှတ်  တော်မူ၍၊ ချမ်း စေတော်မူခြင်းကို  အဘယ်သူ ခံ နိုင် သနည်း။"
  },
  {
    "bookId": 19,
    "chapterId": 147,
    "verseId": 18,
    "text": "တဖန်နှုတ်ကပတ် တော်ကိုလွှတ် ၍ ၊ ထို မိုဃ်းပွင့်အစရှိသည်တို့ကို အရည် ကျိုတော်မူ၏။ မိမိ  လေ ကို လာ  စေတော်မူသဖြင့်၊ ရေ  တို့သည် စီး  ကြ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 147,
    "verseId": 19,
    "text": "နှုတ်ကပတ် အမိန့်တော်ကို ယာကုပ် အမျိုး၌ ၎င်း၊ စီရင် ထုံးဖွဲ့တော်မူချက်များကို ဣသရေလ  အမျိုး၌ ၎င်း ဘော်ပြ တော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 147,
    "verseId": 20,
    "text": "အခြားတပါးသော အမျိုးသား တို့ ၌ ထိုသို့  ပြု တော် မ  မူ။ စီရင် တော်မူချက်များကို သူ  တို့မ သိ ရကြ။ ဟာလေလုယ။"
  }
]
