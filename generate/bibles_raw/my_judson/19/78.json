[
  {
    "bookId": 19,
    "chapterId": 78,
    "verseId": 1,
    "text": "¶ ငါ ၏လူ များတို့၊ ငါ့ တရား ကို နာ  ကြလော့။ ငါ မြွက် သော စကား  ကို နားထောင် ကြလော့။"
  },
  {
    "bookId": 19,
    "chapterId": 78,
    "verseId": 2,
    "text": "ပုံ စကားကို ငါ မြွက် ဆို၍၊ ရှေး ကာလ၏ နက်နဲ သော အရာများကို ဘော်ပြ ပေအံ့။"
  },
  {
    "bookId": 19,
    "chapterId": 78,
    "verseId": 3,
    "text": "ဘိုးဘေး တို့သည် ပြော ၍ ငါ တို့သည် ကြား သိ ရ သော ထို  အရာများကို၊"
  },
  {
    "bookId": 19,
    "chapterId": 78,
    "verseId": 4,
    "text": "သား မြေးတို့မှ မ ဝှက် မထား။ ထာဝရဘုရား  ၏ ဂုဏ် ကျေးဇူးတော်နှင့် တန်ခိုး တော်ကို၎င်း၊ ပြု တော်မူသော အံ့ဩ ဘွယ်အမှုတို့ကို၎င်း ၊ ဖြစ် လတံ့သောသူတို့အား ဘော် ပြကြမည်။"
  },
  {
    "bookId": 19,
    "chapterId": 78,
    "verseId": 5,
    "text": "အကြောင်း မူကား၊ ယာကုပ် အမျိုး၌ သက်သေ တရားကိုစီရင် ၍ ၊ ဣသရေလ အမျိုး၌ ပညတ် တရားကို ထား  တော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 78,
    "verseId": 6,
    "text": "သဘော မ ဖြောင့်၊ ဘုရားသခင် ၌ စိတ်ဝိညာဉ် အမြဲမ ဆည်းကပ် သောအမျိုး၊"
  },
  {
    "bookId": 19,
    "chapterId": 78,
    "verseId": 7,
    "text": "ငြင်းဆန် ၍ ပုန်ကန် တတ်သောအမျိုး တည်းဟူသော ဘိုးဘေး  တို့ကဲ့သို့ သားမြေး တို့သည်မ ဖြစ် ၊ ဘုရားသခင် ၏အမှု တော်တို့ကိုမ မေ့။"
  },
  {
    "bookId": 19,
    "chapterId": 78,
    "verseId": 8,
    "text": "ဘုရားသခင် ကို ယုံကြည်ကိုးစား ၍၊ ပညတ်တော် တို့ကိုစောင့် စေခြင်းငှာ ထိုတရားတို့ကို ဘိုးဘေး  တို့သည်သား တို့အား ပြသ ၍ ဖြစ် လတံ့သောအမျိုး တည်းဟူသော၊ ဘွားမြင် လတံ့ သောသား တို့သည်သိနားလည် ၍၊ နောက်တဖန်မြေးမြစ် တို့အား ပြသ ကြမည်အကြောင်း ပညတ် ထားတော်မူပြီ။"
  },
  {
    "bookId": 19,
    "chapterId": 78,
    "verseId": 9,
    "text": "ဧဖရိမ် အမျိုးသား တို့သည် လေး  လက်နက် ကို စွဲကိုင် သော်လည်း၊ စစ်တိုက် သောအခါ နောက်သို့ လှည့် ကြပါသည်တကား။"
  },
  {
    "bookId": 19,
    "chapterId": 78,
    "verseId": 10,
    "text": "ဘုရား သခင်၏ သစ္စာ  တော်ကို မ  စောင့်။ တရား တော်လမ်း၌ သွား ခြင်းငှါ အလို မရှိကြ။"
  },
  {
    "bookId": 19,
    "chapterId": 78,
    "verseId": 11,
    "text": "အမှုတော် တို့ကို၎င်း ၊ ပြ တော်မူသောအံ့ဩ ဘွယ် တို့ကို၎င်း မေ့လျော့ ကြ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 78,
    "verseId": 12,
    "text": "အဲဂုတ္တု ပြည် ၊ ဇောန အရပ် တွင် သူ  တို့အဘ များ မျက်မှောက် ၌ အံ့ဘွယ် သော အမှုတို့ကို ပြု တော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 78,
    "verseId": 13,
    "text": "ပင်လယ် ကိုခွဲ ၍ သူ တို့ကိုရှောက်သွား စေတော်မူ ၏။ ရေ  များကို စုပုံ  ၍ ထား တော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 78,
    "verseId": 14,
    "text": "နေ့ အချိန်၌ကား၊ မိုဃ်းတိမ် ဖြင့် ၎င်း ၊ ညဉ့်အချိန်၌ကားတညဉ့်လုံး မီး အလင်း ဖြင့် ၎င်း သူ တို့ကို လမ်းပြ တော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 78,
    "verseId": 15,
    "text": "တော ၌ ကျောက် တို့ကိုဖေါက် ၍ ၊ ပင်လယ် ရေ ကဲ့သို့  များစွာ သော ရေကို သူတို့အား တိုက် တော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 78,
    "verseId": 16,
    "text": "ကျောက် ထဲက စီး သော ရေကိုထွက် စေ၍ ၊ မြစ် ရေ ကဲ့သို့ ရေများကို စီး  စေတော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 78,
    "verseId": 17,
    "text": "ထိုသူတို့မူကား ၊ အမြင့်ဆုံး သော ဘုရားကို တော  ၌ ပုန်ကန် သောအားဖြင့် တိုး ၍ ပြစ်မှား ကြ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 78,
    "verseId": 18,
    "text": "မိမိ တို့အလို အလျောက်အစာ ကို တောင်း ၍ စိတ် နှလုံး ထဲမှာ ဘုရား သခင်ကို စုံစမ်း ကြ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 78,
    "verseId": 19,
    "text": "ဘုရား သခင်သည် တော  ၌ စားပွဲ ကို ပြင်ဆင် နိုင် သလော။"
  },
  {
    "bookId": 19,
    "chapterId": 78,
    "verseId": 20,
    "text": "ကြည့် ကြလော့။ ကျောက် ကို ရိုက် တော်မူသဖြင့် ၊ ရေ ထွက်၍ မြစ် ရေကဲ့သို့စီး လေ၏။ မုန့် ကိုလည်း ပေး နိုင် သလော။ မိမိ လူ တို့အဘို့ အမဲ သားကိုပြင်ဆင် နိုင်သလောဟု ဘုရား  သခင်ကို ဆန့်ကျင် ဘက်ပြုလျက် ပြော ဆိုကြ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 78,
    "verseId": 21,
    "text": "ထိုစကားကို ထာဝရဘုရား  သည် ကြား ၍ အမျက်ထွက် တော်မူ၏။ ယာကုပ် အမျိုး၌ မီး လောင် ၍ ၊ ဣသရေလ အမျိုး၌ ဒေါသ မီးတက် လေ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 78,
    "verseId": 22,
    "text": "အကြောင်း မူကား၊ အထက် မိုဃ်းတိမ် တို့ကို မှာ ထားလျက်၊"
  },
  {
    "bookId": 19,
    "chapterId": 78,
    "verseId": 23,
    "text": "ကောင်းကင် တံခါး တို့ကို ဖွင့် ၍ ၊ သူ တို့ စား  စရာ ဘို့ မန္န ကို မိုဃ်း ရွာစေသဖြင့်၊"
  },
  {
    "bookId": 19,
    "chapterId": 78,
    "verseId": 24,
    "text": "ကောင်းကင် ဆန် စပါးကိုပေး တော်မူသည်ဖြစ်၍ ၊ ထိုသူ အပေါင်းတို့သည် ကြီးမြတ် သောသူတို့ ၏ အစာ  ကိုသုံး ဆောင်၍၊"
  },
  {
    "bookId": 19,
    "chapterId": 78,
    "verseId": 25,
    "text": "ဝ ပြောစွာ စားကြမည် အကြောင်း ပြု တော်မူသော်လည်း၊ သူတို့သည် ဘုရား  သခင်ကို မ ယုံကြည်။ ကယ်တင် တော်မူခြင်း ကျေးဇူးကို မ ကိုးစား ဘဲ နေကြ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 78,
    "verseId": 26,
    "text": "မိုဃ်းကောင်းကင် ၌ အရှေ့ လေကို ပယ် ၍ ၊ အားကြီး သောတောင် လေကို ဆောင် ခဲ့သဖြင့်၊"
  },
  {
    "bookId": 19,
    "chapterId": 78,
    "verseId": 27,
    "text": "သူ တို့အပေါ် သို့ အမဲသား  ကို မြေမှုန့် နှင့်အမျှ ပျံ တက်သောငှက် တို့ကို သမုဒ္ဒရာ  သဲလုံး နှင့်အမျှ ၊ မိုဃ်းရွာ စေလျက်၊"
  },
  {
    "bookId": 19,
    "chapterId": 78,
    "verseId": 28,
    "text": "သူ တို့တပ် ချ၍ ၊ နေရာ အရပ်ပတ်လည် ၌ ကျ စေ တော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 78,
    "verseId": 29,
    "text": "ထိုသို့ သူ  တို့ အလို  ရှိသည်အတိုင်း ပေး တော်မူသဖြင့် ၊ သူတို့သည် ဝ  ပြောစွာ စား  ရကြ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 78,
    "verseId": 30,
    "text": "သူတို့ တပ်မက်သောအစာကိုမရောင့်ရဲမှီ စားကြစဉ်တွင်၊"
  },
  {
    "bookId": 19,
    "chapterId": 78,
    "verseId": 31,
    "text": "ဘုရား သခင်၏အမျက် တော်သည် သက်ရောက် သဖြင့် ၊ ကျန်းမာ သောသူတို့ကို ကွပ်မျက် ၍ ၊ ဣသရေလ လူပျို တို့ကို လှဲချ တော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 78,
    "verseId": 32,
    "text": "ထို အမှုအလုံးစုံ တို့နှင့် ဣသရေလလူတို့သည် တွေ့ကြုံရသော်လည်း ၊ အံ့ဘွယ် သော အမှုတော်တို့ကြောင့် ယုံကြည် ခြင်းမ ရှိ။ ပြစ်မှား လျက် နေကြသေး ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 78,
    "verseId": 33,
    "text": "ထိုကြောင့် သူ တို့ နေ့ရက် ကာလကို အချည်းနှီး လွန် စေ၍ ၊ သူ တို့နှစ် များကို ဘေး  ဥပဒ်တွင် မြှုပ်တော်မူ ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 78,
    "verseId": 34,
    "text": "သူ တို့ကို ကွပ်မျက် တော်မူသောအခါ ကိုယ်တော် ကို ရှာ ကြ၏။ ပြန်လာ ၍ ကိုယ်တော်ကို လိုက်ရှာ ကြ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 78,
    "verseId": 35,
    "text": "ဘုရား သခင်သည် သူ  တို့၏ကျောက် ၊ အမြင့်ဆုံး သော ဘုရား  သည် သူ  တို့ကို ကယ်တင် သော အရှင်ဖြစ် တော်မူသည်ကို ထိုအခါ သတိ ရကြ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 78,
    "verseId": 36,
    "text": "သို့သော်လည်း ၊ ကိုယ်တော် ကိုနှုတ် ဖြင့် ချော့မော့ ၍ ၊ လျှာ ဖြင့် လည်း မုသာ  စကားကို လျှောက်ဆိုကြ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 78,
    "verseId": 37,
    "text": "သူ တို့စိတ် သဘောမူကား ၊ ရှေ့တော်၌ မ  ဖြောင့် ၊ သစ္စာ တော်ကို မ စောင့် ဘဲနေကြ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 78,
    "verseId": 38,
    "text": "ကိုယ်တော် မူကား ၊ ကရုဏာ စိတ်ရှိ၍ သူတို့ကို မ  ဖျက်ဆီး ဘဲ အပြစ် လွှတ် တော်မူ၏။ ကြိမ်ဖန်များစွာ စိတ် တော်ပြေ ၍ ၊ အမျက် တော် ကိုနှိုးဆော် တော်မ မူ။"
  },
  {
    "bookId": 19,
    "chapterId": 78,
    "verseId": 39,
    "text": "သူ တို့သည် အသား  ဖြစ်ကြောင်း ကို၎င်း ၊ စုတေ့၍ နောက် တဖန် မ  လာ တတ်သော ဝိညာဉ် ဖြစ်ကြောင်းကို၎င်း အောက်မေ့ တော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 78,
    "verseId": 40,
    "text": "သူတို့သည် ကိုယ်တော် ကို တော  ၌ ပုန်ကန် ၍ ၊ လူ ဆိတ်ညံရာအရပ် ၌  စိတ် တော်နာဘွယ်သော အကြောင်းကို ကြိမ်ဖန်များစွာပြုကြပါသည်တကား။"
  },
  {
    "bookId": 19,
    "chapterId": 78,
    "verseId": 41,
    "text": "ဘုရား သခင်ကို အဖန်ဖန် စုံစမ်း ၍ ဣသရေလ အမျိုး၌ သန့်ရှင်း တော်မူသောဘုရားကို ဆန့်ကျင် ဘက် ပြုကြပါသည်တကား။"
  },
  {
    "bookId": 19,
