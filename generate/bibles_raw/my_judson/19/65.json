[
  {
    "bookId": 19,
    "chapterId": 65,
    "verseId": 1,
    "text": "¶ အို ဘုရား  သခင်၊ ဇိအုန် မြို့၌  ကိုယ်တော် ရှေ့ မှာ ငြိမ်ဝပ် စွာ နေ၍  ချီးမွမ်း ရပါ၏။ ကိုယ်တော် အား လည်း သစ္စာ  ဝတ်ကို ဖြေ ရပါ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 65,
    "verseId": 2,
    "text": "ပဌနာ စကားကို နားထောင် တော်မူသောဘုရား၊ ကိုယ်တော် ထံ သို့လူသား အပေါင်း တို့သည် ချဉ်းကပ် ရကြလိမ့်မည်။"
  },
  {
    "bookId": 19,
    "chapterId": 65,
    "verseId": 3,
    "text": "မ တရားသောအမှု သည် အလွန်များ၍ အကျွန်ုပ် သည် မ  တတ်နိုင်ပါ။ သို့သော်လည်း၊ အကျွန်ုပ် တို့ ပြစ်မှား ခြင်း အပြစ်များကို ကိုယ်တော် ဖြေရှင်း တော်မူမည်။"
  },
  {
    "bookId": 19,
    "chapterId": 65,
    "verseId": 4,
    "text": "တန်တိုင်း တော်အတွင်း၌ နေ  ၍၊ အထံတော်သို့ ချဉ်းကပ် စေခြင်းငှါ ၊ ကိုယ်တော်ရွေးကောက် တော်မူသောသူသည် မင်္ဂလာ ရှိပါ၏။ သန့်ရှင်း သော ဗိမာန် တော်တည်းဟူသောအိမ် တော်၌ ကောင်း သော အရာတို့နှင့်  အကျွန်ုပ်တို့သည် ဝ  ပြောကြပါစေသော။"
  },
  {
    "bookId": 19,
    "chapterId": 65,
    "verseId": 5,
    "text": "အကျွန်ုပ် တို့ကို ကယ်တင် တော်မူသောဘုရား ၊ အကျွန်ုပ် တို့၏ ပဌနာကို နားထောင်၍ အံ့ဘွယ် သော အမှုတို့ကို တရား  တော်နှင့်အညီပြ တော်မူ၏။ ကိုယ်တော်သည် ဝေး  စွာသော မြေကြီး စွန်း နှင့် ၊ ပင်လယ် စွန်းတို့၌ နေသောသူတို့၏ ကိုးစား  ရာ ဖြစ်တော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 65,
    "verseId": 6,
    "text": "ကိုယ်တော်သည် တန်ခိုး နှင့် ပြည့်စုံ သဖြင့် ၊ အားကြီး ၍  တောင် များကို တည် စေတော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 65,
    "verseId": 7,
    "text": "သမုဒ္ဒရာ မြည် သံ၊ လှိုင်း တံပိုးဟုန်း သံ၊ လူ  တို့ ရုန်း ရင်းခတ်သံများကိုလည်း  ငြိမ်း စေတော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 65,
    "verseId": 8,
    "text": "အဝေး ဆုံးသော အရပ်တို့၌နေ သောသူတို့ သည် ကိုယ်တော် ၏ နိမိတ် များကို  မြင်၍ ကြောက်ရွံ့ ကြပါ ၏။ နေထွက် ရာအရပ်နှင့်  နေဝင် ရာအရပ်တို့ကို ရွှင်လန်း စေတော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 65,
    "verseId": 9,
    "text": "မြေကြီး ကို အကြည့် အရှုကြွလာ၍ ၊ မိုဃ်းကို များစွာရွာစေလျက်၊ ရေနှင့် ပြည့်သော ဘုရား  သခင်၏ မြစ် အားဖြင့်အလွန်ကြွယ်ဝစေတော်မူ၏။ ထို  သို့ မြေကို ပြုပြင်ပြီးမှ၊ မြေသား တို့အဘို့  စပါး ကို ပြုပြင် တော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 65,
    "verseId": 10,
    "text": "မြေရိုး တို့ကို စိုစွတ် စေ၍၊ လယ်ပြင်ကို တညီ  တည်း စီရင်ပြီးမှ၊ မိုဃ်းရွာ သောအားဖြင့်  ပြော့ စေ၍၊ ပေါက် သော အပင်များကို ကောင်းကြီး ပေးတော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 65,
    "verseId": 11,
    "text": "နှစ် တို့ကို ကျေးဇူး တော်နှင့် ပတ်ရစ် တော်မူ၍ ၊ ခြေ တော်ရာတို့သည် ဆီဥ  ယို တတ်ကြပါ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 65,
    "verseId": 12,
    "text": "သာယာ သော တော  အရပ်တို့လည်း ယို  ၍ ၊ တောင် တို့သည်လည်း ပီတိ  ခါးစည်းနှင့် စည်း လျက် ရှိကြပါ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 65,
    "verseId": 13,
    "text": "ကျက်စား ရာအရပ်တို့သည် သိုး  ဆိတ်စုတို့နှင့်  ပြည့်စုံ လျက်၊ လယ်ပြင် တို့လည်း စပါး ပင်နှင့် လွှမ်းမိုး လျက် ရှိ၍၊ ကျူးဧ သောအသံနှင့်  သီချင်း ဆိုကြပါ၏။"
  }
]
