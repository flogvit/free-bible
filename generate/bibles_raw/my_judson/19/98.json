[
  {
    "bookId": 19,
    "chapterId": 98,
    "verseId": 1,
    "text": "¶ ထာဝရဘုရား အား  အသစ် သောသီချင်း ကို ဆို  ကြလော့။ အံ့ဘွယ် သော အမှုတို့ကို ပြု တော်မူပြီ။ လက်ျာ လက်တော်နှင့်  သန့်ရှင်း သော လက်ရုံး တော်သည် ကိုယ်တော် အဘို့  ကယ်တင် ခြင်းအမှုကို ပြုလေပြီ။"
  },
  {
    "bookId": 19,
    "chapterId": 98,
    "verseId": 2,
    "text": "ထာဝရဘုရား သည် ကယ်တင် တော်မူခြင်း ကျေးဇူးကို ထင်ရှား စေ၍၊ ဖြောင့်မတ် တော်မူခြင်း တရား ကိုလည်း တပါး အမျိုးသားတို့အား ဘော်ပြ တော်မူပြီ။"
  },
  {
    "bookId": 19,
    "chapterId": 98,
    "verseId": 3,
    "text": "ဣသရေလ အမျိုးသားတို့၌  ကရုဏာ တော်နှင့်  သစ္စာ တော်ကို အောက်မေ့ တော်မူပြီ။ ငါ တို့ဘုရား သခင်၏ ကယ်တင် တော်မူခြင်းကျေးဇူးကို မြေကြီး စွန်း အပေါင်း တို့သည် မြင် ရကြပြီ။"
  },
  {
    "bookId": 19,
    "chapterId": 98,
    "verseId": 4,
    "text": "မြေကြီး သားအပေါင်း တို့၊ ထာဝရဘုရား  အား  ကြွေးကြော် ကြလော့။ အသံ  ဗလံကို ပြု၍  ရွှင်လန်းစွာ သီချင်း ဆိုလျက်  ချီးမွမ်း ကြလော့။"
  },
  {
    "bookId": 19,
    "chapterId": 98,
    "verseId": 5,
    "text": "စောင်း တီး၍ ထာဝရဘုရား အား သီချင်း ဆိုကြလော့။ စောင်း တီး၍  တုရိယာ  သံ ကို ပြုကြလော့။"
  },
  {
    "bookId": 19,
    "chapterId": 98,
    "verseId": 6,
    "text": "တံပိုး နှဲခရာ ကိုမှုတ်၍ ၊ ရှင်ဘုရင် တည်းဟူသောထာဝရဘုရား  ရှေ့ တော်၌ ကြွေးကြော် ကြလော့။"
  },
  {
    "bookId": 19,
    "chapterId": 98,
    "verseId": 7,
    "text": "ထာဝရဘုရားရှေ့တော်၌၊ ပင်လယ် နှင့် ပင်လယ် တန်ဆာ သည် အသံ  ဗလံကို ပြုစေ။ လောကဓါတ် နှင့်  လောကသား တို့သည် ထိုနည်းတူ၊"
  },
  {
    "bookId": 19,
    "chapterId": 98,
    "verseId": 8,
    "text": "မြစ် တို့သည် လက်ခုပ် တီး၍၊ တောင် ရှိသမျှ တို့ သည်လည်း ရွှင်လန်း ကြစေ။"
  },
  {
    "bookId": 19,
    "chapterId": 98,
    "verseId": 9,
    "text": "အကြောင်း မူကား၊ မြေကြီး သားတို့ကို တရား  စီရင်ခြင်းငှါ ကြွလာ တော်မူ၏။ လောကသား  တို့ကို ဖြောင့်မတ် စွာ စီရင်၍ ၊ လူများ ကို ဟုတ်မှန် ခြင်းတရား အတိုင်း  စီရင် ဆုံးဖြတ်တော်မူလတံ့။"
  }
]
