[
  {
    "bookId": 19,
    "chapterId": 87,
    "verseId": 1,
    "text": "¶ ဘုံ ဗိမာန ်တော်တိုက်မြစ် သည် သန့်ရှင်း သော တောင် ရိုးပေါ် မှာ တည်လျက်ရှိ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 87,
    "verseId": 2,
    "text": "ထာဝရဘုရား သည် ယာကုပ် ၏ နေရာ  အပေါင်း တို့ထက်  ဇိအုန် တံခါး တို့ကို သာ၍နှစ်သက် တော်မူ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 87,
    "verseId": 3,
    "text": "အိုဘုရား သခင်၏ မြို့ တော်၊ သင် သည် ဘုန်း အသရေကြီးလိမ့်မည်ဟူသောစကားကို ပြော ထားလျက် ရှိ၏။"
  },
  {
    "bookId": 19,
    "chapterId": 87,
    "verseId": 4,
    "text": "ငါ့ ကိုသိကျွမ်း သောသူတို့ တွင် ၊ ရာခပ် မြို့နှင့်  ဗာဗုလုန် မြို့ကို ငါမှတ် ထားမည်။ ဖိလိတ္တိ  ပြည်၊ တုရု  ပြည်၊ ကုရှ ပြည်တို့ကိုလည်း  ကြည့် ကြလော့။ ဤ  မည်သော ပြည်သားသည် မြို့ တော်၌ ဘွားမြင် သောသူဖြစ်၏။"
  },
  {
    "bookId": 19,
    "chapterId": 87,
    "verseId": 5,
    "text": "ဇိအုန် မြို့ကို လည်း လူ  အမျိုးမျိုးတို့သည်၊ ထိုမြို့ ၌  ဘွားမြင် ကြပြီ။ အမြင့်ဆုံး သောဘုရားသည် ထိုမြို့ ကို ကိုယ်တော်တိုင် မြဲမြံ စေတော်မူပြီဟု ပြော ဆိုကြလိမ့်မည်။"
  },
  {
    "bookId": 19,
    "chapterId": 87,
    "verseId": 6,
    "text": "ထာဝရဘုရား သည် လူမျိုး တို့ကို စာရင်း ယူတော်မူ သောအခါ ၊ ဤမည်သော အမျိုးသည် မြို့တော်၌ ဘွားမြင်သောအမျိုးဖြစ်သည်ဟု မှတ်တော်မူမည်။"
  },
  {
    "bookId": 19,
    "chapterId": 87,
    "verseId": 7,
    "text": "သီချင်း သည်နှင့် ပွဲသဘင်ခံသောသူ အစရှိသော ငါ၏ပျော်မွေ့ခြင်းအကြောင်းရှိသမျှ တို့သည် သင် ၌ ရှိကြ သတည်း။"
  }
]
