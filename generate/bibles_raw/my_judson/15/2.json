[
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 1,
    "text": "¶ -"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 2,
    "text": "ဗာဗုလုန်  ရှင်ဘုရင် နေဗုခဒ်နေဇာ သည်၊ ဗာဗုလုန် မြို့သို့ သိမ်းသွားသောလူစုထဲက ထွက် ၍ ဇေရုဗဗေလ  ၊ ယောရှု ၊ နေဟမိ ၊ သရာယ ၊ ရေလာယ ၊ မော်ဒကဲ ၊ ဗိလရှန် ၊ မိဇပါ ၊ ဗိဂဝဲ ၊ ရေဟုံ ၊ ဗာနာ တို့နှင့်အတူ လိုက်လာ ၍၊ ယေရုရှလင် မြို့အစရှိသောယုဒ ပြည်၌အသီးအသီး ဆိုင်သောမြို့ရွာ သို့ ရောက်သောနိုင်ငံတော်သားဣသရေလ လူ စာရင်း ဟူမူကား၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 3,
    "text": "ပါရုတ် အမျိုးသား နှစ် ထောင်တရာ ခုနစ် ဆယ် နှစ် ယောက်၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 4,
    "text": "ရှေဖတိ အမျိုးသား သုံး ရာ ခုနစ် ဆယ်နှစ် ယောက်၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 5,
    "text": "အာရာ အမျိုးသား ခုနစ် ရာ ခုနစ် ဆယ်ငါး ယောက်၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 6,
    "text": "ပါဟတ် မောဘအမျိုး ၊ ယောရှု ယွာဘ  အမျိုးသား နှစ် ထောင်ရှစ်  ရာ တဆယ် နှစ် ယောက်၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 7,
    "text": "ဧလံ အမျိုးသား တထောင် နှစ် ရာငါး ဆယ် လေး  ယောက်၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 8,
    "text": "ဇတ္တု  အမျိုးသား ကိုး ရာ လေး ဆယ်ငါး ယောက်၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 9,
    "text": "ဇက္ခဲ  အမျိုးသား ခုနစ် ရာ  ခြောက် ဆယ်၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 10,
    "text": "ဗာနိ အမျိုးသား ခြောက် ရာ လေး ဆယ်နှစ် ယောက်၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 11,
    "text": "ဗေဗဲ အမျိုးသား ခြောက် ရာ နှစ် ဆယ်သုံး  ယောက်၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 12,
    "text": "အာဇဂဒ်  အမျိုးသား တ ထောင်နှစ် ရာနှစ် ဆယ်နှစ် ယောက်၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 13,
    "text": "အဒေါနိကံ အမျိုးသား ခြောက် ရာ ခြောက် ဆယ်ခြောက် ယောက်၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 14,
    "text": "ဗိဂဝဲ အမျိုးသား နှစ် ထောင်ငါး ဆယ်ခြောက်  ယောက်၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 15,
    "text": "အာဒိန် အမျိုးသား လေး ရာ ငါး ဆယ်လေး  ယောက်၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 16,
    "text": "ဟေဇကိ နှင့်  အာတာ အမျိုးသား ကိုး ဆယ်ရှစ်  ယောက်၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 17,
    "text": "ဗေဇဲ  အမျိုးသား သုံး ရာ နှစ် ဆယ်သုံး ယောက်၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 18,
    "text": "ယောရ အမျိုးသား တရာ တဆယ် နှစ် ယောက်၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 19,
    "text": "ဟာရှုံ အမျိုးသား နှစ် ရာနှစ် ဆယ်သုံး ယောက်၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 20,
    "text": "ဂိဗ္ဗာ  အမျိုးသား ကိုး ဆယ်ငါး ယောက်၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 21,
    "text": "ဗက်လင် မြို့သား  တရာ နှစ် ဆယ်သုံး ယောက်၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 22,
    "text": "နေတောဖ မြို့သား  ငါး ဆယ်ခြောက် ယောက်၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 23,
    "text": "အာနသုတ် မြို့သား  တရာ နှစ် ဆယ်ရှစ် ယောက်၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 24,
    "text": "အာဇမာဝက် မြို့သား  လေး ဆယ်နှစ် ယောက်၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 25,
    "text": "ကိရယသာရိမ် မြို့၊ ခေဖိရ  မြို့၊ ဗေရုတ် မြို့သား  ခုနစ် ရာ  လေး ဆယ်သုံး ယောက်၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 26,
    "text": "ရာမ မြို့၊ ဂါဘ မြို့သား ခြောက် ရာ နှစ် ဆယ်တ ယောက်၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 27,
    "text": "မိတ်မတ် မြို့သား  တရာ နှစ် ဆယ်နှစ် ယောက်၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 28,
    "text": "ဗေသလ မြို့၊ အာဣ  မြို့သား နှစ် ရာနှစ် ဆယ်သုံး ယောက်၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 29,
    "text": "နေဗော မြို့သား  ငါး ဆယ်နှစ် ယောက်၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 30,
    "text": "မာဂဗိတ်  မြို့သား  တရာ ငါး ဆယ်ခြောက် ယောက်၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 31,
    "text": "အခြား သော ဧလံ  မြို့သား  တ ထောင်နှစ် ရာငါး ဆယ်လေး ယောက်၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 32,
    "text": "ဟာရိမ် မြို့သား  သုံး ရာ နှစ် ဆယ်၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 33,
    "text": "လောဒ မြို့၊ ဟာဒိဒ် မြို့၊ ဩနော  မြို့သား  ခုနစ် ဆယ်ငါး ယောက်၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 34,
    "text": "ယေရိခေါ မြို့သား  သုံး ရာ လေး ဆယ်ငါး ယောက်၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 35,
    "text": "သေနာ မြို့သား သုံး ထောင် ခြောက် ရာ သုံး ဆယ်တည်း။"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 36,
    "text": "¶ ယဇ်ပုရောဟိတ် စာရင်းဟူမူကား၊ ယောရှု အမျိုး  ထဲက ၊ ယေဒါယ အမျိုးသား ကိုး ရာ  ခုနစ် ဆယ်သုံး ယောက်၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 37,
    "text": "ဣမေရ အမျိုးသား တ ထောင်ငါး ဆယ်နှစ် ယောက်၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 38,
    "text": "ပါရှုရ  အမျိုးသား တ ထောင်နှစ် ရာလေး ဆယ်ခုနစ် ယောက်၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 39,
    "text": "ဟာရိမ် အမျိုးသား တ ထောင်တဆယ် ခုနစ်  ယောက်တည်း။"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 40,
    "text": "¶ လေဝိ သားစာရင်းဟူမူကား၊ ဟောဒဝိ  အမျိုး ထဲက  ယောရှု အမျိုး နှင့်  ကာဒမေလ အမျိုးသားခုနစ် ဆယ်လေး  ယောက်၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 41,
    "text": "သီချင်း သည် အာသပ် အမျိုးသား တရာ နှစ် ဆယ် ရှစ် ယောက်၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 42,
    "text": "တံခါး စောင့်အမျိုးသား တည်းဟူသောရှလ္လုံ အမျိုးသား ၊ အာတာ အမျိုးသား ၊ တာလမုန် အမျိုးသား ၊ အက္ကုပ် အမျိုးသား ၊ ဟတိတ အမျိုးသား ၊ ရှောဗဲ အမျိုးသား အပေါင်း တရာ သုံး ဆယ်ကိုး ယောက်တည်း။"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 43,
    "text": "ဘုရား ကျွန်ခံသူ၊ ဇိဟ  အမျိုးသား ၊ ဟသုဖ  အမျိုးသား ၊ တဗ္ဗောက် အမျိုးသား၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 44,
    "text": "ကေရုတ် အမျိုးသား ၊ သယာဟ အမျိုးသား ၊ ပါဒုန် အမျိုးသား၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 45,
    "text": "လေဗန အမျိုးသား ၊ ဟာဂဘ အမျိုးသား ၊ အက္ကုပ်  အမျိုးသား၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 46,
    "text": "ဟာဂပ် အမျိုးသား ၊ ရှာလမဲ အမျိုးသား ၊ ဟာနန်  အမျိုးသား၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 47,
    "text": "ဂိဒ္ဒေလ အမျိုးသား ၊ ဂါဟာ အမျိုးသား ၊ ရာယ  အမျိုးသား၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 48,
    "text": "ရေဇိန် အမျိုးသား ၊ နေကောဒ အမျိုးသား ၊ ဂဇ္ဇမ် အမျိုးသား၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 49,
    "text": "ဩဇ အမျိုးသား ၊ ပါသာ အမျိုးသား ၊ ဗေသဲ  အမျိုးသား၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 50,
    "text": "အာသနာ အမျိုးသား ၊ မဟုနိမ် အမျိုးသား ၊ နဖုသိမ် အမျိုးသား၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 51,
    "text": "ဗာကဗုတ် အမျိုးသား ၊ ဟကုဖ အမျိုးသား ၊ ဟာရဟုရ အမျိုးသား၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 52,
    "text": "ဗာဇလုပ် အမျိုးသား ၊ မဟိဒ အမျိုးသား ၊ ဟရရှ အမျိုးသား၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 53,
    "text": "ဗာကုတ် အမျိုးသား ၊ သိသရ အမျိုးသား ၊ သာမ  အမျိုးသား၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 54,
    "text": "နေဇိ အမျိုးသား ၊ ဟတိဖ အမျိုးသား တည်း။"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 55,
    "text": "¶ ရှောလမုန် ၏ အစေခံ  ကျွန်၊ သောတဲ  အမျိုးသား ၊ သောဖရက် အမျိုးသား ၊ ပေရုဒ အမျိုးသား၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 56,
    "text": "ယာလ အမျိုးသား ၊ ဒါကုန် အမျိုးသား ၊ ဂိဒ္ဒေလ  အမျိုးသား၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 57,
    "text": "ရှေဖတိ အမျိုးသား ၊ ဟတ္တိလ အမျိုးသား ၊ ပေါခရက် အမျိုးသား ၊ ဇေဗိမ်အမျိုးသား၊ အာမိ  အမျိုးသား တည်း။"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 58,
    "text": "¶ ဘုရား ကျွန်နှင့်  ရှောလမုန်  ကျွန် ပေါင်း ကား၊ သုံး  ရာ ကိုး ဆယ်နှစ် ယောက်တည်း။"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 59,
    "text": "¶ ထိုမှတပါး၊ ဣသရေလ  အမျိုး မှန်သည်မမှန်သည်ကို၎င်း၊ မိမိ  တို့ အဆွေ အမျိုးကို၎င်း၊ မ  ပြ နိုင် ဘဲ တေလမေလ  မြို့၊ တေလဟာသ  မြို့၊ ခေရုပ်  မြို့၊ အဒ္ဒန် မြို့၊ ဣမေရ  မြို့မှ  ထွက်သွား သောသူဟူမူကား၊"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 60,
