[
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 1,
    "text": "ယုဒအမျိုးသားတို့သည် စာရေးတံပြု၍ အဆွေ အမျိုးအလိုက် အမွေခံရသောမြေဟူမူကား၊ တောင်မျက် နှာ၌ ဧဒုံပြည်နယ်နှင့် နီးစပ်လျက်၊ တေမန်ပြည်စွန်းမှ စ၍ ဇိနတောဖြစ်သော၊"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 2,
    "text": "တောင်ဘက်အပိုင်းအခြားသည် သောဒုံအိုင်၌ တောင်အကွေ့မှထွက်၍၊"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 3,
    "text": "တောင်မျက်နှာနား၊ အကရဗ္ဗိမ်ကုန်းကို ရှောက် လျက် ဇိနရွာသို့ ရောက်လေ၏။ တဖန် တောင်မျက်နှာ နား၊ ကာဒေရှဗာနာရွာ၊ ဟေဇရုန်ရွာ၊ အာဒါရွာ၊ ကာကာ ရွာ၊"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 4,
    "text": "အဇမုန်ရွာကို ရှောက်သဖြင့် အဲဂုတ္တုချောင်းသို့ လိုက်၍ ပင်လယ်၌ ဆုံးလေ၏။"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 5,
    "text": "အရှေ့ဘက်၌ သောဒုံအိုင်သည် ယော်ဒန်မြစ်ဝ တိုင်အောင် အရှေ့အပိုင်းအခြားဖြစ်၏။ မြောက်ဘက် အပိုင်းအခြားသည် ယော်ဒန်မြစ်သို့ဆင်းရာ သောဒုံအိုင် ကွေ့မှ ထွက်၍၊"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 6,
    "text": "ဗေသောဂလရွာသို့၎င်း၊ ဗေသရာဗရွာ မြောက် နားမှာရှောက်လျက် ရုဗင်သားဗောဟန်၏ ကျောက်သို့ ၎င်း ရောက်လေ၏။"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 7,
    "text": "အာခေါ်ချိုင့်မြောက်ဘက်မှထွက်၍ ဒေဗိရရွာ သို့၎င်း၊ မြစ်တောင်ဘက် အဒုမ္မိမ်ကုန်းရှေ့၌ရှိသော ဂိလဂါလမြို့သို့၎င်း ရောက်ပြီးမှ၊ အင်ရှေမက်အိုင်၊ အင်္ရော ဂေလရွာလမ်းသို့ လိုက်လျက်၊"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 8,
    "text": "ဟိန္နုံသား၏ချိုင့်နား ယေရုရှလင်မြို့ရာ ယေဗု သိအရပ် တောင်ဘက်နားမှာရှောက်၍ ဟိန္နုံချိုင့်အ နောက်၊ ရေဖိမ်ချိုင့်မြောက်ဘက်၌ရှိသော တောင်ပေါ်သို့ တက်လေ၏။"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 9,
    "text": "ထိုတောင်ပေါ်မှဆင်းပြန်၍၊ နေဖတောစမ်းရေ တွင်းကို ရှောက်သဖြင့် ဧဖရုန်တောင်နှင့်ဆိုင်သော မြို့ များသို့၎င်း၊ ကိရယတ်ယာရိမ်မြို့ ရာဗာလာမြို့သို့၎င်း၊"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 10,
    "text": "ဗာလာမြို့အနောက်ဘက်နားမှာ ရှောက်လျက် စိရတောင်သို့၎င်း၊ ခေသလုန်တောင်တည်းဟူသော ယာရိမ်တောင်မြောက်ဘက်နားမှာ ရှောက်လျက် ဗက်ရှေ မက်မြို့၊ တိမနာမြို့သို့၎င်း၊"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 11,
    "text": "ဧကြုန်မြို့မြောက်ဘက်နားမှာ ရှောက်လျက် ရှိကြုန်ရွာသို့၎င်း၊ ဗာလာတောင်သို့၎င်း၊ ယာဗနေလရွာသို့ ၎င်း၊ ရောက်၍ ပင်လယ်၌ ဆုံးလေ၏။"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 12,
    "text": "အနောက်ဘက်၌ ပင်လယ်ကြီးနှင့် ပင်လယ် ကမ်းပါးသည် အနောက်အပိုင်းအခြားဖြစ်၏။ ဤရွေ့ ကား ယုဒအမျိုးသား အဆွေအမျိုးအလိုက် နေရာပြည် နယ်အပိုင်းအခြားဖြစ်သတည်း။"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 13,
    "text": "ထာဝရဘုရားမှာထားတော်မူသည်အတိုင်း၊ ယောရှုသည် ယုဒအမျိုးသားတို့တွင် ယေဖုန္န၏သား ကာ လက်အဘို့ ဟေဗြုန်မြို့တည်းဟူသော အာနကအဘအာ ဘ၏မြို့ကို ချပေးလေ၏။"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 14,
    "text": "ထိုမြို့ထဲက ကာလက်သည် အာနကသားသုံး ယောက်၊ ရှေရှဲ၊ အဟိမန်၊ တာလမဲတို့ကို နှင်ထုတ်သော နောက်၊"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 15,
    "text": "ကိရယဿေဖါအမည်ဟောင်းရှိသော ဒေဗိရ မြို့သားတို့ရှိရာသို့ တဖန်ချီသွား၍၊"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 16,
    "text": "ကိရယဿေဖါမြို့ကို တိုက်ယူလုပ်ကြံသောသူ အား ငါသည် သမီးအာခသကို ပေးစားမည်ဟုဆိုလျှင်၊"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 17,
    "text": "ကာလက်ညီ ကေနတ်၏သား ဩသံယေလ သည် ထိုမြို့ကိုတိုက်ယူ၍ ကာလက်သည် သမီးအာခသကို သူ့အားပေးစားလေ၏။"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 18,
    "text": "ထိုမိန်းမသည် ခရီးသွားစဉ်အခါ၊ လယ်တကွက် ကို အဘ၌ တောင်းခြင်းငှါ လင်နှင့်တိုင်ပင်ပြီးမှ မြည်းပေါ် ကဆင်းလေ၏။ အဘကာလက်က အဘယ်အလိုရှိသ နည်းဟု မေးလျှင်၊"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 19,
    "text": "သမီးက ကောင်းကြီးပေးစေချင်ပါ၏။ ကိုယ် တော်သည် တောင်မျက်နှာအရပ်ကို ပေးပါပြီ။ စမ်းရေ တွင်းတို့ကိုလည်း ပေးတော်မူပါဦးဟု တောင်းသည်အ တိုင်း အဘသည် အထက်စမ်းရေတွင်း၊ အောက်စမ်းရေ တွင်းတို့ကို ပေးလေ၏။"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 20,
    "text": "ဤရွေ့ကား၊ ယုဒအမျိုးသား အဆွေအမျိုးအ လိုက် ခံရသောအမွေမြေ ဖြစ်သတည်း။"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 21,
    "text": "ယုဒအမျိုးသားပိုင်သော မြို့များဟူမူကား၊ ဧဒုံ ပြည်နှင့်နီးစပ်သော တောင်ပိုင်း၌ ကပ်ဇေလမြို့၊ ဧဒေရ မြို့၊ ယာဂုရမြို့၊"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 22,
    "text": "ကိနမြို့၊ ဒိမောနမြို့၊ အာဒဒါမြို့၊"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 23,
    "text": "ကေဒေရှမြို့၊ ဟာဇော်မြို့၊ ဣသနန်မြို့၊"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 24,
    "text": "ဇိဖမြို့၊ တေလင်မြို့၊ ဗာလုတ်မြို့၊"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 25,
    "text": "ဟာဇော်မြို့သစ်၊ ဟာဇော်မြို့ဟောင်းတည်းဟူ သော ဟေဇရုန်မြို့၊"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 26,
    "text": "အာမန်မြို့၊ ရှေမမြို့၊ မောလဒမြို့၊"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 27,
    "text": "ဟာဇာဂဒ္ဒမြို့၊ ဟေရှမုန်မြို့၊ ဗက်ပါလက်မြို့၊"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 28,
    "text": "ဟာဇာရွာလမြို့၊ ဗေရရှေဘမြို့၊ ဗိဇ္ဇောသယာ မြို့၊"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 29,
    "text": "ဗာလာမြို့၊ ဣအိမ်မြို့၊ အာဇင်မြို့၊"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 30,
    "text": "ဧလတောလဒ်မြို့၊ ခေသိလမြို့၊ ဟောမာမြို့၊"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 31,
    "text": "ဇိကလတ်မြို့၊ မာဒမန္နာမြို့၊ သံသန္နာမြို့၊"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 32,
    "text": "လေဗောက်မြို့၊ ရှိလဟိမ်မြို့၊ အအိန်မြို့၊ ရိမ္မုန် မြို့၊ ရွာနှင့်တကွ မြို့ပေါင်းကား သုံးဆယ်ခြောက်မြို့ တည်း။"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 33,
    "text": "ချိုင့်၌လည်း ဧရှတောလမြို့၊ ဇောရာမြို့၊ အာရှ နာမြို့၊"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 34,
    "text": "ဇာနောမြို့၊ အင်္ဂန္နိမ်မြို့၊ တာပွါမြို့၊ ဧနံမြို့၊"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 35,
    "text": "ယာမုတ်မြို့၊ အဒုလံမြို့၊ စောခေါမြို့၊ အဇေကာ မြို့၊"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 36,
    "text": "ရှာရိမ်မြို့၊ အဒိသိမ်မြို့၊ ဂဒေရမြို့၊ ဂဒေရော သိမ်မြို့၊ ရွာနှင့်တကွ မြို့ပေါင်းကား၊ ဆယ်ငါးမြို့တည်း။"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 37,
    "text": "ထိုမှတပါး၊ ဇေနန်မြို့၊ ဟဒါရှမြို့၊ မိဂဒလဂဒ်မြို့၊"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 38,
    "text": "ဒိလန်မြို့၊ မိဇပါမြို့၊ ယောကသေလမြို့၊"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 39,
    "text": "လာခိရှမြို့၊ ဗောဇကတ်မြို့၊ ဧကလုန်မြို့၊"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 40,
    "text": "ကဗ္ဗုန်မြို့၊ လာမံမြို့၊ ကိသလိတ်မြို့၊"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 41,
    "text": "ဂဒေရုတ်မြို့၊ ဗက်ဒါဂုန်မြို့၊ နေမမြို့၊ မက္ကဒါမြို့၊ ရွာနှင့်တကွ ဆယ်ခြောက်မြို့တည်း။"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 42,
    "text": "ထိုမှတပါး၊ လိဗနမြို့၊ ဧသာမြို့၊ အာရှန်မြို့၊"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 43,
    "text": "ယိဖတမြို့၊ အာရှနာမြို့၊ နေဇိပ်မြို့၊"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 44,
    "text": "ကိလမြို့၊ အောခဇိပ်မြို့၊ မရေရှမြို့၊ ရွာနှင့်တကွ ကိုးမြို့တည်း။"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 45,
    "text": "ထိုမှတပါး ဧကြုန်မြို့နှင့်သူဆိုင်သော မြို့ရွာများ၊"
  },
  {
    "bookId": 6,
    "chapterId": 15,
    "verseId": 46,
