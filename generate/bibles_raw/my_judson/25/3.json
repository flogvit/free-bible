[
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 1,
    "text": "¶ ငါ သည် ဘုရား  သခင်၏ အမျက် တော်ကြိမ်လုံး အောက်၌  ဆင်းရဲ ခြင်းကို ခံရ  သောသူဖြစ်၏။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 2,
    "text": "ငါ့ ကိုသွေးဆောင် ၍  အလင်း သို့မ ပို့၊ မှောင်မိုက် ထဲသို့ ပို့ဆောင် တော်မူ၏။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 3,
    "text": "အကယ် စင်စစ်ငါ့ ကို  တနေ့လုံး အထပ်ထပ် ဒဏ်ခတ် တော်မူ၏။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 4,
    "text": "ငါ့ အရေ နှင့် အသား ကို ဆွေးရိ စေ၍ ငါ့ အရိုး  တို့ကိုလည်း ချိုး တော်မူ၏။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 5,
    "text": "ငါ့ တဘက် ၌ တပ် တည်၍ ခါး သောအရာ၊ ပင်ပန်း စရာအကြောင်းတို့နှင့်  ဝိုင်း တော်မူ၏။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 6,
    "text": "သေ လွန်သောသူတို့ကို ပြုတတ်သကဲ့သို့ ၊ ငါ့ ကို မိုက် သောအရပ်၌  ထား တော်မူ၏။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 7,
    "text": "ငါမ ထွက် နိုင်အောင် ဝင်း ခတ်၍ ၊ လေးသော သံကြိုး နှင့် ချည်နှောင် တော်မူ၏။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 8,
    "text": "ထိုမျှမက ငါသည် ကြွေးကြော် အော်ဟစ် ၍  ဆုတောင်း သော်လည်း ငြင်းပယ် တော်မူ၏။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 9,
    "text": "ငါ သွားရာလမ်း ကို ကျောက် ထရံနှင့် ပိတ် ၍၊ ကောက် သောလမ်းဖြင့် သွားစေတော်မူ၏။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 10,
    "text": "ငါ့ ကို ချောင်းမြောင်း သောဝက်ဝံ ကဲ့သို့၎င်း ၊ မ  ထင်ရှားသော အရပ်၌ နေသောခြင်္သေ့ ကဲ့သို့၎င်း ဖြစ် တော်မူ၏။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 11,
    "text": "ငါ့ ကိုလမ်း လွဲ စေပြီးလျှင် အပိုင်းပိုင်း ဖြတ်၍ ဖျက်ဆီး တော်မူ၏။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 12,
    "text": "လေး တော်ကိုတင် ၍  ပစ်စရာစက် အရာ၌  ငါ့ ကို ထား  တော်မူ၏။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 13,
    "text": "မြှား တော်တို့ကိုလည်း၊ ငါ့ ကျောက်ကပ် ကို  ခွင်း  စေတော်မူ၏။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 14,
    "text": "ငါသည်ငါ ၏လူ တို့တွင် ကဲ့ရဲ့  စရာအကြောင်း နှင့် တနေ့လုံး  သီချင်း ဆိုစရာအကြောင်းဖြစ် ပါသည်တကား။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 15,
    "text": "ခါး သောဆေးနှင့် ငါ့ ကိုဖြည့် ၍၊ ဒေါန နှင့်ယစ်မူး စေတော်မူ၏။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 16,
    "text": "ကျောက်စရစ် ကိုကျွေး၍  ငါ့ သွား တို့ကို ချိုး တော်မူ ၏။ မီးဖိုပြာ နှင့်  ဖုံး တော်မူ၏။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 17,
    "text": "ငါ ၏ဝိညာဉ် ကို ချမ်းသာ နှင့် ဝေး စွာ ရွေ့တော်မူသောကြောင့် ၊ ငါသည် မင်္ဂလာ အကြောင်းကို မေ့လျော့ ၏။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 18,
    "text": "သို့ဖြစ်၍ ၊ ငါ သည် ထာဝရဘုရား  ရှေ့တော်၌  အစွမ်း သတ္တိနှင့်  မြော်လင့် စရာအကြောင်းပျက် လေပြီဟု ဆို  ရ၏။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 19,
    "text": "အကျွန်ုပ် ခံရသောဆင်းရဲ ငြိုငြင် ခြင်းကို၎င်း ၊ ဒေါန နှင့်  သည်းခြေ အရည်ကို၎င်းအောက်မေ့ တော်မူပါ။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 20,
    "text": "ဧကန်အမှန်အောက်မေ့ တော်မူလိမ့်မည်။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 21,
    "text": "ထိုသို့ အကျွန်ုပ် ၏ စိတ် နှလုံးသည် ဆင်ခြင် ၍ သတိရသောအခါ  မြော်လင့် စရာအခွင့်ရှိပါ၏။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 22,
    "text": "ထာဝရဘုရား သည် သနား  တော်မူ၍  ကရုဏာ  တော်သည် မ  ကုန် သောကြောင့် ငါတို့သည် ဆုံးရှုံး ခြင်းသို့ မ  ရောက်ဘဲနေကြ၏။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 23,
    "text": "နံနက် တိုင်းကရုဏာတော်အသစ် ကိုခံရကြ၏။ သစ္စာ  တော်သည် ကြီးမြတ် ပါ၏။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 24,
    "text": "ငါ့ ဝိညာဉ် ၏ သဘောဟူမူကား၊ ထာဝရဘုရား  သည် ငါ ၏အဘို့  ဖြစ်တော်မူ၏။ ထိုကြောင့် ၊ ကိုယ်တော် ကို ငါမြော်လင့် ပါ၏။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 25,
    "text": "ကိုယ်တော် ကို မြော်လင့် သောသူနှင့်  ကိုယ်တော် ကို ရှာ သောသူ၏ စိတ် ဝိညာဉ်အား  ထာဝရဘုရား သည် ကျေးဇူး ပြုတော်မူ၏။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 26,
    "text": "ကယ်တင် တော်မူမည်ဟု မြော်လင့်လျက်၊ ငြိမ်ဝပ် စွာ စောင့် ၍  နေကောင်း ၏။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 27,
    "text": "လူ သည်အသက် ပျိုစဉ် အခါ ထမ်းဘိုး ကို ထမ်း  ကောင်း ၏။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 28,
    "text": "ထမ်းဘိုး ကို  တင် တော်မူသောကြောင့် တယောက် တည်းထိုင် ၍  ငြိမ်ဝပ် စွာနေစေ။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 29,
    "text": "မြော်လင့် စရာအခွင့်ရှိကောင်း ရှိ လိမ့်မည်ဟု ထင်လျက်၊ မိမိ  နှုတ် ကို မြေမှုန့် ၌ ကပ် စေ။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 30,
    "text": "ရိုက် သောသူအား  မိမိ ပါး ကိုပေး ၍၊ ကဲ့ရဲ့  ပြစ်တင်ခြင်းနှင့် ပြည့်ဝ စေ။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 31,
    "text": "အကြောင်း မူကား၊ ထာဝရ  ဘုရားသည် အစဉ်  စွန့်ပစ် တော်မ မူတတ်။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 32,
    "text": "ဝမ်းနည်း စေတော်မူသော်လည်း ၊ ကရုဏာ  တော် များပြား သည်နှင့်အညီ သနား တော်မူလိမ့်မည်။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 33,
    "text": "ဆင်းရဲစေချင်သောစိတ်  နှင့် လူ သား တို့ကို ညှဉ်းဆဲ ၍ ဝမ်းနည်း စေတော်မူသည်မ ဟုတ်။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 34,
    "text": "ချုပ် ထားသော ပြည် သားအပေါင်း တို့ကို ခြေ နှင့် နင်း ကြိတ်ခြင်းအမှု၊"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 35,
    "text": "လူ ခံထိုက်သောတရား ကို အမြင့်ဆုံး သော ဘုရား မျက်မှောက် ၌  ဖျက် ခြင်းအမှု၊"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 36,
    "text": "သူတပါး ကိုမ တရားသဖြင့်  ရှုံး စေခြင်းအမှုတို့ကို ထာဝရ  ဘုရားနှစ်သက်  တော်မ မူ။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 37,
    "text": "ထာဝရ ဘုရားမှာ ထားတော်မ မူဘဲ၊ အဘယ်သူ သည် ပြော ၍ တစုံတခုကို ဖြစ် စေနိုင်သနည်း။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 38,
    "text": "အမြင့်ဆုံး သော ဘုရား၏နှုတ် ထွက်ရှိသည် အတိုင်း  မင်္ဂလာ နှင့်  အမင်္ဂလာ ဖြစ် တတ်သည် မ  ဟုတ် လော။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 39,
    "text": "အသက်ရှင် သောလူ သတ္တဝါသည် အဘယ် ကြောင့် မြည်တမ်း ရမည်နည်း။ မိမိ  ဒုစရိုက် အပြစ်ကြောင့်  မြည်တမ်းရမည်လော။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 40,
    "text": "ငါ တို့သည်ကိုယ်လိုက်သောလမ်း တို့ကို စစ်ကြော စုံစမ်း၍ ၊ ထာဝရဘုရား  ထံ တော်သို့ ပြန် သွားကြကုန်အံ့။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 41,
    "text": "ကောင်းကင် ဘုံ၌ ရှိတော်မူသောဘုရား သခင့်ထံ တော်သို့ နှလုံး နှင့် လက် တို့ကို ချီကြွ ကြကုန်အံ့။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 42,
    "text": "အကျွန်ုပ် တို့သည် ပြစ်မှား ပုန်ကန် မိပါပြီ။ ကိုယ်တော် သည် အပြစ် လွှတ်တော်မ မူပါ။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 43,
    "text": "အမျက် တော်ထွက်၍  မျက်နှာ လွှဲတော်မူ၏။ တဖန် အကျွန်ုပ် တို့ကိုလိုက် ၍ ကရုဏာ  မ ရှိဘဲ ကွပ်မျက် တော်မူ၏။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 44,
    "text": "အကျွန်ုပ်တို့ ပဌနာ  စကားသည် အထံ  တော်သို့  မပေါက် နိုင်အောင်၊ မိုဃ်းတိမ် ဖြင့် ကိုယ်ကို ကွယ်ကာ တော်မူ၏။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 45,
    "text": "အကျွန်ုပ် တို့ကိုလူမျိုး တို့တွင်  လှည်းပစ်သော တန်မြက်ချေး အမှိုက် ကဲ့သို့၎င်း  ၊ ရွံစရာ အရာကဲ့သို့၎င်း ဖြစ် စေတော်မူ၏။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 46,
    "text": "ရန်သူ အပေါင်း တို့သည် အကျွန်ုပ် တို့တဘက် ၌ နှုတ် ကိုဖွင့် ကြပါ၏။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 47,
    "text": "အကျွန်ုပ် တို့သည် ကြောက်လန့် ဘွယ်သော အရာထဲသို့၎င်း ၊ တွင်း ထဲသို့၎င်း  ၊ သုတ်သင် ပယ်ရှင်းဖျက်ဆီး ခြင်းထဲသို့၎င်း  ရောက် ကြပါပြီ။"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 48,
    "text": "ငါ ၏လူမျိုး သတို့သမီး ပျက်စီး သောကြောင့် ၊ ငါ့ မျက်စိ သည် မြစ် ရေ ဖြစ်၍ စီး  လျက်ရှိ၏။"
  },
  {
    "bookId": 25,
