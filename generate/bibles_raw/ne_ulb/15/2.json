[
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 1,
    "text": "¶ राजा नबूकदनेसरको निर्वासनबाट छुटेर फर्कने प्रान्तमा भएका मानिसहरू यिनै हुन् जसलाई तिनले बेबिलोनमा कैद गरेर लगेका थिए । यी मानिसहरू यरूशलेम र यहूदियामा आ-आफ्ना सहरहरूमा फर्के ।"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 2,
    "text": "तिनीहरू यरुबाबेल, येशूअ, नहेम्याह, सरायाह, रेलयाह, मोर्दकै, बिल्शान, मिस्पार, बिग्वै, रेहूम र बानाहसँगै आए । इस्राएलका मानिसहरूको विवरण यही हो ।"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 3,
    "text": "परोशका परिवारका २,१७२"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 4,
    "text": "शपत्‍याहका परिवारका ३७२"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 5,
    "text": "आराका परिवारका ७७५"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 6,
    "text": "येशूअ र योआबका सन्‍तानबाट पहत-मोआबका परिवारका २,८१२"
  },
  {
    "bookId": 15,
