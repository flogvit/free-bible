  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 25,
    "text": "किर्यत-यारीम, कपीरा र बेरोतका मानिसहरू ७४३"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 26,
    "text": "रामा र गेबाका मानिसहरू ६२१"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 27,
    "text": "मिकमाशका मानिसहरू १२२"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 28,
    "text": "बेथेल र ऐका मानिसहरू २२३"
  },
  {
    "bookId": 15,
    "chapterId": 2,
