  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 35,
    "text": "सेनाहका मानिसहरू ३,६३० ।"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 36,
    "text": "पुजारीहरू: येशूअको वंशबाट यदायाहका परिवारका ९७३"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 37,
    "text": "इम्‍मेरका परिवारका १,०५२"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 38,
    "text": "पशहूरका परिवारका १,२४७"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 39,
    "text": "हारीमका परिवारका १,०१७ ।"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 40,
    "text": "लेवीहरू: होदबियाको वंशबाट येशूअ र कादमीएलका परिवारका ७४"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 41,
    "text": "मन्दिरका गायकहरू: आसापका परिवारका १२८"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 42,
    "text": "मन्‍दिरका द्वारपालहरू: शल्‍लूम, आतेर, तल्‍मोन, अक्‍कूब, हतीता, शोबैका परिवारहरूका जम्‍मा १३९ ।"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 43,
    "text": "मन्‍दिरका सेवकहरू: सीहा, हसूपा, तब्‍बाओत,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 44,
    "text": "केरोस, सीआ, पादोन,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 45,
    "text": "लेबाना, हगाबा, अक्‍कूब,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 46,
    "text": "हागाबा, शल्‍मै, हानान,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 47,
    "text": "गिद्देल, गहरका, रायाह,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 48,
    "text": "रसीन, नकोदा, गज्‍जाम,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 49,
    "text": "उज्‍जा, पसेह, बेजै,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 50,
    "text": "अस्‍ना, मोनिम, नेपुसीम,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 51,
    "text": "बक्‍बूक, हकूपा, हर्हुर,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 52,
    "text": "बस्‍लूत, महीदा, हर्शा,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 53,
    "text": "बर्कोस, सीसरा, तेमह,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 54,
    "text": "नसीह, र हतीपाका परिवारहरू ।"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 55,
    "text": "सोलोमनका सेवकहरूका सन्‍तानहरू: सोतै, हस्‍सोपेरेत, पारूद,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 56,
    "text": "याला, दर्कोन, गिद्देल,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 57,
    "text": "शपत्‍याह, हत्तील, पोकेरेत-हसेबायीम, र आमीका परिवारहरू ।"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 58,
    "text": "मन्‍दिरका सेवकहरू र सोलोमनका सेवकहरूका सन्‍तानहरूको सङ्ख्या जम्‍मा ३९२ थियो ।"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 59,
    "text": "तेल-मेलह, तेल-हर्शा, केरूब, आदोन र इम्‍मेर सहरबाट आएकाहरूले आफ्‍ना पुर्खाहरू इस्राएलको वंशबाट आएका हुन्‌ भनेर बताउन सकेनन्‌ । यी हुन्‌:"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 60,
    "text": "दलायाह, तोबिया, नकोदाका परिवारहरूका जम्‍मा ६५२,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 61,
    "text": "र पुजारीहरूबाट: होबायाहका, हक्‍कोसका र बर्जिल्‍लै (तिनले गिलादी बर्जिल्‍लैका छोरीहरूमध्ये एउटीलाई विवाह गरे र तिनीहरूका नाउँ राखे) परिवार ।"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 62,
    "text": "तिनीहरूले आफ्नो वंशावलीका विवरणहरू खोजे, तर ति फेला पार्न सकेनन्, त्यसैले तिनीहरूलाई अशुद्ध ठानेर पुजारीको काममा समावेश गरिएन ।"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 63,
    "text": "त्‍यसैले ऊरीम र तुम्मीमको सेवा गर्ने एक जना पुजारीले अनुमोदन नगरेसम्म तिनीहरूले पवित्र बलिदानका कुनै पनि थोक खानुहुँदैन भनी गभर्नरले तिनीहरूलाई बताए ।"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 64,
    "text": "सम्पूर्ण समुहको जम्‍मा सङ्ख्या ४२,३६० थियो,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 65,
    "text": "यसमा तिनीहरूका नोकर-नोकर्नीहरू (७,३३७ जना) र तिनीहरूका मन्दिरका गायक-गायिकाहरू (२००) समावेश थिएन ।"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 66,
    "text": "तिनीहरूका घोडाहरू ७३६ । खच्‍चरहरू २४५ ।"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 67,
    "text": "ऊँटहरू ४३५ । गधाहरू ६,७२० थिए ।"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 68,
    "text": "जब तिनीहरू यरूशलेममा परमप्रभुको मन्दिरमा गए, मुख्य पुर्खाहरूले मन्दिर निर्माणको लागि स्वेच्छा भेटीहरू चढाए ।"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 69,
    "text": "तिनीहरूले आ-आफ्नो औकातअनुसार कामको लागि रुपियाँ-पैसा दिएः ६१,००० सुनका सिक्‍का, ५,००० चाँदीका सिक्‍का र पुजारीको १०० ओटा अलखाहरू ।"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 70,
    "text": "यसरी पुजारी र लेवीहरू, मानिसहरू, मन्दिरका गायकहरू र द्वारपालहरूसाथै मन्दिरमा सेवा गर्न नियुक्त गरिएकाहरू आ-आफ्ना सहरहरूमा बसोबास गरे । इस्राएलका सबै मानिस आ-आफ्ना सहरहरूमा थिए ।"
  }
]
