[
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 1,
    "text": "¶ पर्खालको काम सिद्धिएपछि जब मैले ढोकाहरूलाई तिनका आ-आफ्ना ठाउँमा लगाएँ, र द्वारपालहरूसाथै गायक-गायिकाहरू र लेवीहरू नियुक्त गरिए,"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 2,
    "text": "मैले मेरा भाइ हनानी र किल्लाको निरीक्षण गर्ने हनानीलाई यरूशलेममाथिको जिम्मा सुम्पिदिएँ किनकि तिनी अरू धेरैभन्दा विश्‍वासयोग्य मानिस थिए, र परमेश्‍वरदेखि डराउँथे ।"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 3,
    "text": "मैले तिनीहरूलाई भनेँ, “घाम चर्को गरी नलागेसम्म यरूशलेमका मूल ढोकाहरू नखोल्नू । द्वारपालहरू पहरा बस्दा तिमीहरूले ढोकाहरू बन्दी गरी आग्ला लगाउनू । यरूशलेममा बस्‍नेहरूबाट केही पहरादारहरूलाई पहरा बस्‍ने ठाउँमा र केहीलाई चाहिँ तिनीहरूका आफ्नै घरको सामुन्‍ने राख्‍न नियुक्त गर्नू ।”"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 4,
    "text": "अब सहरचाहिँ फराकिलो र विशाल थियो, तर त्यसभित्र केही मानिसहरू मात्र थिए, र अझसम्म कुनै पनि घरको पुनर्निर्माण भएको थिएन ।"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 5,
    "text": "मेरा परमेश्‍वरले कुलीनहरू, अधिकृतहरू र मानिसहरूलाई तिनीहरूका परिवार-परिवार गरी नाउँ दर्ता गराउनका लागि भेला गराउन मेरो हृदयमा बोझ हालिदिनुभयो । मैले सुरुमा फर्केनहरूको वंशावलीको पुस्तक भेट्टाएँ जसमा यो कुरा लेखिएको थियो ।"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 6,
    "text": "“राजा नबूकदनेसरको निर्वासनबाट जाने प्रान्तमा भएका मानिसहरू यिनै हुन् जसलाई तिनले बेबिलोनमा कैद गरेर लगेका थिए । तिनीहरू यरूशलेम र यहूदियामा आ-आफ्ना सहरहरूमा फर्के ।"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 7,
    "text": "तिनीहरू यरुबाबेल, येशूअ, नहेम्याह, सरायाह, रेलयाह, मोर्दकै, बिल्शान, मिस्पार, बिग्वै, रेहूम र बानाहसँगै आएका थिए । इस्राएलका मानिसहरूको सङ्ख्या निम्‍न लिखित छ ।"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 8,
    "text": "परोशका परिवारका २,१७२"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 9,
    "text": "शपत्‍याहका परिवारका ३७२"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 10,
    "text": "आराका परिवारका ६५२"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 11,
    "text": "येशूअ र योआबका घरानाबाट पहत-मोआबका परिवारका २,८१८"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 12,
    "text": "एलामका परिवारका १,२५४"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 13,
    "text": "जत्तूका परिवारका ८४५"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 14,
    "text": "जक्‍कैका परिवारका ७६०"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 15,
    "text": "बिन्‍नूईका परिवारका ६४८"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 16,
    "text": "बेबैका परिवारका ६२८"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 17,
    "text": "अज्‍गादका परिवारका २,३२२"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 18,
    "text": "अदोनीकामका परिवारका ६६७"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 19,
    "text": "बिग्‍वैका परिवारका २,०६७"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 20,
    "text": "आदीनका परिवारका ६५५"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 21,
    "text": "हिजकियाबाट आतेरका परिवारका ९८"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 22,
    "text": "हाशूमका परिवारका ३२८"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 23,
    "text": "बेजैका परिवारका ३२४"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 24,
    "text": "हारीपका परिवारका ११२"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 25,
    "text": "गिबोनका परिवारका ९५"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 26,
    "text": "बेथलेहेम र नतोपाका मानिसहरू १८८"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 27,
    "text": "अनातोतका मानिसहरू १२८"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 28,
    "text": "बेथ-अज्‍मावेतका मानिसहरू ४२"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 29,
    "text": "किर्यत-यारीम, कपीरा र बेरोतका मानिसहरू ७४३"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 30,
    "text": "रामा र गेबाका मानिसहरू ६२१"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 31,
    "text": "मिकमाशका मानिसहरू २२"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 32,
    "text": "बेथेल र ऐका मानिसहरू १२३"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 33,
    "text": "अर्को नेबोका मानिसहरू ५२"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 34,
    "text": "अर्को एलामका मानिसहरू १,२५४"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 35,
    "text": "हारीमका मानिसहरू ३२०"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 36,
    "text": "यरीहोका मानिसहरू ३४५"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 37,
    "text": "लोद, हादीद र ओनोका मानिसहरू ७२१"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 38,
    "text": "सेनाहका मानिसहरू ३,९३०"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 39,
    "text": "पुजारीहरू: (येशूअको वंशबाट) यदायाहका परिवारका ९७३"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 40,
    "text": "इम्‍मेरका परिवारका १,०५२"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 41,
    "text": "पशहूरका परिवारका १,२४७"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 42,
    "text": "हारीमका परिवारका १,०१७"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 43,
    "text": "लेवीहरू: होदबिया, बिन्‍नूई र कादमीएलका वंशबाट येशूअका परिवारका ७४"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 44,
    "text": "गायकहरू: आसापका परिवारका १४८"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 45,
    "text": "द्वारपालहरू: शल्‍लूम, आतेर, तल्‍मोन, अक्‍कूब, हतीता, शोबैका परिवारहरूका जम्‍मा १३८"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 46,
    "text": "मन्‍दिरका सेवकहरू: सीहा, हसूपा, तब्‍बाओत,"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 47,
    "text": "कोरेस, सीआ, पादोन,"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 48,
    "text": "लेबाना, हगाबा, शल्‍मै,"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 49,
    "text": "हानान, गिद्देल, गहर,"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 50,
    "text": "रायाह, रसीन, नकोदा,"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 51,
    "text": "गज्‍जाम, उज्‍जा, पसेह,"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 52,
    "text": "बेजै, मोनिम, नेपुसीम,"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 53,
    "text": "बक्‍बूक, हकूपा, हर्हुर,"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 54,
    "text": "बस्‍लूत, महीदा, हर्शा,"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 55,
    "text": "बर्कोस, सीसरा, तेमह,"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 56,
    "text": "नसीह, र हतीपाका परिवारहरू"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 57,
    "text": "सोलोमनका सेवकहरूका सन्‍तान: सोतै, सोपेरेत, पारीद,"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 58,
    "text": "याला, दर्कोन, गिद्देल,"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 59,
    "text": "शपत्‍याह, हत्तील, पोकेरेतहसेबायीम, र अमोनका परिवारहरू ।"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 60,
    "text": "मन्‍दिरका सेवकहरू र सोलोमनका सेवकहरूका सन्‍तानको सङ्ख्या जम्‍मा ३९२"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 61,
    "text": "तेल-मेलह, तेल-हर्शा, केरूब, आदोन र इम्‍मेर सहरबाट आएकाहरूले आफ्‍ना परिवारहरू इस्राएलको वंशबाट आएका हुन्‌ भनी बताउन सकेनन्‌ । यी हुन्‌:"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 62,
    "text": "दलायाह, तोबिया, र नकोदाका परिवारहरूका जम्‍मा ६४२"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 63,
    "text": "पुजारीहरूबाट: होबायाहका परिवार, हक्‍कोसका परिवार, र बर्जिल्‍लैका परिवार (तिनले गिलादी बर्जिल्‍लैका छोरीहरूमध्ये एउटीलाई विवाह गरी तिनीहरूको नाउँ राखे) ।"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 64,
    "text": "तिनीहरूले आफ्नो वंशावलीका अभिलेखहरू खोजे, तर तिनलाई फेला पारेनन् । त्यसैले तिनीहरूलाई अशुद्ध ठानी पुजारीको कामबाट निष्काशन गरियो ।"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 65,
    "text": "पुजारीले ऊरीम र तुम्मीमसहित अनुमोदन नगरेसम्म तिनीहरूले पवित्र बलिदानका कुनै पनि थोक खान मिल्दैनथ्यो भनी राज्यपालले तिनीहरूलाई बताए ।"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 66,
    "text": "सम्पूर्ण मानिसको सङ्ख्या ४२,३६० थियो ।"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 67,
    "text": "यीबाहेक तिनीहरूका नोकर-नोकर्नीहरू ७,३३७ जना थिए । तिनीहरूका २४५ जना गायक-गायिका थिए ।"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 68,
    "text": "तिनीहरूका घोडाहरूको सङ्ख्या ७३६, खच्‍चर २४५,"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 69,
    "text": "ऊँट ४३५ र गधा ६,७२० थिए ।"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 70,
    "text": "परिवारका केही मुखियाहरूले कामको लागि दान दिए । राज्यपालले भण्डारमा १,००० सुनका सिक्‍का, ५० कचौरा र पुजारीहरूले लगाउने ५३० ओटा पोशाक दिए ।"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 71,
    "text": "परिवारका केही कामकको निम्ति मुखियाहरूले भण्डारमा २०,००० सुनका सिक्‍का र २,२०० चाँदीका सिक्‍का दिए ।"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 72,
    "text": "बाँकी मानिसहरूले २०,००० सुनका सिक्‍का, २,००० चाँदीका सिक्‍का र पुजारीले लगाउने ६७ ओटा पोशाक दिए ।"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 73,
    "text": "यसरी पुजारीहरू, लेवीहरू, द्वारपालहरू, गायक-गायिकाहरू, केही मानिसहरू, मन्दिरका सेवकहरू र सारा इस्राएल तिनीहरूका आ-आफ्ना सहरहरूमा बसे । सातौँ महिनासम्ममा इस्राएलीहरू आ-आफ्ना सहरहरूमा बसिसकेका थिए ।”"
  }
]
