[
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 1,
    "text": "¶ બાબિલનો રાજા નબૂખાદનેસ્સાર યહૂદિયાના જે લોકોને બંદીવાન કરીને બાબિલ લઈ ગયો હતો, તેઓમાંના રાજાની ગુલામીમાંથી જે મુક્ત થઈને યરુશાલેમમાં તથા યહૂદિયામાં પોતપોતાનાં નગરમાં પાછા આવ્યા તે માણસોનાં નામ આ પ્રમાણે છે:"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 2,
    "text": "ઝરુબ્બાબેલ, યેશૂઆ, નહેમ્યા, સરાયા, રએલાયા, મોર્દખાય, બિલ્શાન, મિસ્પાર, બિગ્વાય, રહૂમ, તથા બાનાહ. ઇઝરાયલી લોકોની સંખ્યા આ પ્રમાણે છે."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 3,
    "text": "¶ પારોશના વંશજો: બે હજાર એકસો બોતેર."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 4,
    "text": "શફાટયાના વંશજો: ત્રણસો બોતેર."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 5,
    "text": "આરાહના વંશજો: સાતસો પંચોતેર."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 6,
    "text": "યેશૂઆ તથા યોઆબથી પાહાથ-મોઆબના વંશજો: બે હજાર આઠસો બાર."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 7,
    "text": "¶ એલામના વંશજો: એક હજાર બસો ચોપન."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 8,
    "text": "ઝાત્તૂના વંશજો: નવસો પિસ્તાળીસ."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 9,
    "text": "ઝાકકાયના વંશજો: સાતસો સાઠ."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 10,
    "text": "બાનીના વંશજો: છસો બેતાળીસ."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 11,
    "text": "¶ બેબાયના વંશજો: છસો ત્રેવીસ."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 12,
    "text": "આઝગાદના વંશજો: એક હજાર બસો બાવીસ."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 13,
    "text": "અદોનિકામના વંશજો: છસો છાસઠ."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 14,
    "text": "બિગ્વાયના વંશજો: બે હજાર છપ્પન."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 15,
    "text": "¶ આદીનના વંશજો: ચારસો ચોપન."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 16,
    "text": "આટેરમાંના, હિઝકિયાના વંશજો: અઠ્ઠાણું."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 17,
    "text": "બેસાયના વંશજો: ત્રણસો ત્રેવીસ."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 18,
    "text": "યોરાના વંશજો: એકસો બાર."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 19,
    "text": "¶ હાશુમના લોકો: બસો ત્રેવીસ"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 20,
    "text": "ગિબ્બારના લોકો: પંચાણું."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 21,
    "text": "બેથલેહેમના લોકો: એકસો ત્રેવીસ."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 22,
    "text": "નટોફાના લોકો: છપ્પન."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 23,
    "text": "¶ અનાથોથના લોકો: એકસો અઠ્ઠાવીસ."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 24,
    "text": "આઝમાવેથના લોકો: બેતાળીસ."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 25,
    "text": "કિર્યાથ-યારીમ, કફીરા અને બેરોથના લોકો: સાતસો તેંતાળીસ."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 26,
    "text": "રામા અને ગેબાના લોકો: છસો એકવીસ."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 27,
    "text": "¶ મિખ્માશના લોકો: એકસો બાવીસ."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 28,
    "text": "બેથેલ અને આયના લોકો: બસો ત્રેવીસ."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 29,
    "text": "નબોના લોકો: બાવન."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 30,
    "text": "માગ્બીશના લોકો: એકસો છપ્પન."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 31,
    "text": "¶ બીજા એલામના લોકો: એક હજાર બસો ચોપન."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 32,
    "text": "હારીમના લોકો: ત્રણસો વીસ."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 33,
    "text": "લોદ, હાદીદ અને ઓનોના લોકો: સાતસો પચીસ."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 34,
    "text": "¶ યરીખોના લોકો: ત્રણસો પિસ્તાળીસ."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 35,
    "text": "સનાઆહના લોકો: ત્રણ હજાર છસો ત્રીસ."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 36,
    "text": "¶ યાજકોનાં નામ આ પ્રમાણે છે: યેશૂઆના કુટુંબના, યદાયાના વંશજો: નવસો તોંતેર."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 37,
    "text": "ઈમ્મેરના વંશજો: એક હજાર બાવન."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 38,
    "text": "પાશહૂરના વંશજો: એક હજાર બસો સુડતાળીસ."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 39,
    "text": "હારીમના વંશજો: એક હજાર સત્તર."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 40,
    "text": "¶ લેવીઓના નામ આ પ્રમાણે છે: હોદાવ્યાના અને યેશૂઆના તથા કાદમીએલના વંશજો: ચુંમોતેર."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 41,
    "text": "ભક્તિસ્થાનના ગાનારાઓ આ પ્રમાણે છે: આસાફના વંશજો એકસો અઠ્ઠાવીસ."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 42,
    "text": "ભક્તિસ્થાનના દ્વારપાળો: શાલ્લુમ, આટેર, ટાલ્મોન, આક્કુબ, હટીટા અને શોબાયના વંશજો: કુલ એકસો ઓગણચાળીસ."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 43,
    "text": "ભક્તિસ્થાનમાં સેવા કરવા માટે નિયુક્ત કરાયેલા: સીહા, હસૂફા, ટાબ્બાઓથ,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 44,
    "text": "કેરોસ, સીહા, પાદોન,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 45,
    "text": "લબાના, હગાબા, આક્કુબ,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 46,
    "text": "હાગાબા, શામ્લાય, અને હાનાનના વંશજો."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 47,
    "text": "¶ ગિદ્દેલ, ગહાર, રાયા,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 48,
    "text": "રસીન, નકોદા, ગાઝ્ઝામ,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 49,
    "text": "ઉઝઝા, પાસેઆ, બેસાઈ,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 50,
    "text": "આસના, મેઉનીમ, નફીસીમના વંશજો."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 51,
    "text": "¶ બાકબુક, હાકૂફા અને હાર્હૂર,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 52,
    "text": "બાસ્લુથ, મહિદા, હાર્શા,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 53,
    "text": "બાર્કોસ, સીસરા, તેમા,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 54,
    "text": "નસીઆ અને હટીફાના વંશજો."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 55,
    "text": "¶ સુલેમાનના સેવકોના વંશજો: સોટાય, હાસ્સોફેદેથ, પરૂદા,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 56,
    "text": "યાઅલાહ, દાર્કોન અને ગિદ્દેલ,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 57,
    "text": "શફાટયા, હાટ્ટીલ, પોખરેથ-હાસ્સબાઈમ અને આમીના વંશજો."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 58,
    "text": "ભક્તિસ્થાનમાં સેવા કરવા માટે નિયુક્ત કરાયેલા અને સુલેમાનના સેવકોના વંશજો: કુલ ત્રણસો બાણું હતા."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 59,
    "text": "¶ તેલ-મેલાહ, તેલ હાર્શા, કરુબ, અદાન તથા ઈમ્મેરમાંથી પાછા આવેલા જેઓ ઇઝરાયલીઓમાંના પોતાના પૂર્વજોની વંશાવળી સાબિત કરી શક્યા નહિ, તેઓનાં નામ આ પ્રમાણે છે:"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 60,
    "text": "દલાયા, ટોબિયા, અને નકોદાના વંશજો: છસો બાવન,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 61,
    "text": "યાજકોના વંશજોમાંના: હબાયાના વંશજો, હાક્કોસના વંશજો અને બાર્ઝિલ્લાય કે જેણે ગિલ્યાદી બાર્ઝિલ્લાયની દીકરીઓમાંથી એકની સાથે લગ્ન કર્યું હતું અને તેથી તેનું નામ બાર્ઝિલ્લાય પડ્યું હતું તેના વંશજો."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 62,
    "text": "તેઓએ સર્વ વંશાવળીમાં તપાસ કરી પણ તેઓનાં નામ મળ્યાં નહિ. તેઓએ યાજકપદપણાને ભ્રષ્ટ કર્યું તેથી"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 63,
    "text": "સૂબાએ તેઓને કહ્યું કે, ઉરીમ અને તુમ્મીમ દ્વારા મંજુર કરવામાં ન આવે ત્યાં સુધી પરમપવિત્ર અર્પણોમાંથી તેઓએ ખાવું નહિ."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 64,
    "text": "¶ સમગ્ર પ્રજાની કુલ સંખ્યા બેતાળીસ હજાર ત્રણસો સાઠ હતી."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 65,
    "text": "તે ઉપરાંત તેઓનાં દાસો તથા દાસીઓ સાત હજાર ત્રણસો સાડત્રીસ હતા અને તેઓમાં ભક્તિસ્થાનમાં ગાયક સ્ત્રી પુરુષોની સંખ્યા બસો હતી."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 66,
    "text": "¶ તેઓનાં જાનવરોમાં, સાતસો છત્રીસ ઘોડા, બસો પિસ્તાળીસ ખચ્ચરો,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 67,
    "text": "ચારસો પાંત્રીસ ઊંટો અને છ હજાર સાતસો વીસ ગધેડાં હતાં."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 68,
    "text": "¶ જયારે તેઓ યરુશાલેમમાં, યહોવાહના ઘરમાં ગયા, ત્યારે પિતૃઓના કુટુંબોમાંથી કેટલાક વડીલોએ, સભાસ્થાનને તેની જગ્યાએ પુનઃસ્થાપિત કરવા માટે તેઓએ રાજીખુશીથી અર્પણો આપ્યાં."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 69,
    "text": "તેઓએ પોતાની શક્તિ પ્રમાણે બાંધકામને માટે એકસઠ હજાર દારીક સોનું, પાંચ હજાર માનેહ ચાંદી અને યાજકના સો ગણવેશ આપ્યાં."
  },
  {
