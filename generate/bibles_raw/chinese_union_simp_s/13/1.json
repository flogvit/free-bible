[
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 1,
    "text": "¶ 亚当{H121}生塞特{H8352}；塞特{H8352}生以挪士{H583}；"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 2,
    "text": "以挪士{H583}生该南{H7018}；该南{H7018}生玛勒列{H4111}；玛勒列{H4111}生雅列{H3382}；"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 3,
    "text": "雅列{H3382}生以诺{H2585}；以诺{H2585}生玛土撒拉{H4968}；玛土撒拉{H4968}生拉麦{H3929}；"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 4,
    "text": "拉麦{H3929}生挪亚{H5146}；挪亚{H5146}生闪{H8035}、含{H2526}、雅弗{H3315}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 5,
    "text": "雅弗{H3315}的儿子{H1121}是歌篾{H1586}、玛各{H4031}、玛代{H4074}、雅完{H3120}、土巴{H8422}、米设{H4902}、提拉{H8494}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 6,
    "text": "歌篾{H1586}的儿子{H1121}是亚实基拿{H813}、低法{H7384}(创十章叁节作利法)、陀迦玛{H8425}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 7,
    "text": "雅完{H3120}的儿子{H1121}是以利沙{H473}、他施{H8659}、基提{H3794}、多单{H1721}(有作罗单的)。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 8,
    "text": "含{H2526}的儿子{H1121}是古实{H3568}、麦西{H4714}、弗{H6316}、迦南{H3667}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 9,
    "text": "古实{H3568}的儿子{H1121}是西巴{H5434}、哈腓拉{H2341}、撒弗他{H5454}、拉玛{H7484}、撒弗提迦{H5455}。拉玛{H7484}的儿子{H1121}是示巴{H7614}、底但{H1719}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 10,
    "text": "古实{H3568}生{H3205}宁录{H5248}；他为{H2490}世上{H776}英雄之首{H1368}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 11,
    "text": "麦西{H4714}生{H3205}路低人{H3866}、亚拿米人{H6047}、利哈比人{H3853}、拿弗土希人{H5320}、"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 12,
    "text": "帕斯鲁细人{H6625}、迦斯路希人{H3695}、迦斐託人{H3732}；从迦斐託出来{H3318}的有非利士人{H6430}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 13,
    "text": "迦南{H3667}生{H3205}长子{H1060}西顿{H6721}，又生赫{H2845}"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 14,
    "text": "和耶布斯人{H2983}、亚摩利人{H567}、革迦撒人{H1622}、"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 15,
    "text": "希未人{H2340}、亚基人{H6208}、西尼人{H5513}、"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 16,
    "text": "亚瓦底人{H721}、洗玛利人{H6786}，并哈马人{H2577}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 17,
    "text": "闪{H8035}的儿子{H1121}是以拦{H5867}、亚述{H804}、亚法撒{H775}、路德{H3865}、亚兰{H758}、乌斯{H5780}、户勒{H2343}、基帖{H1666}、米设{H4902}(创十23作玛施)。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 18,
    "text": "亚法撒{H775}生{H3205}沙拉{H7974}；沙拉{H7974}生{H3205}希伯{H5677}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 19,
    "text": "希伯{H5677}生了{H3205}两个{H8147}儿子{H1121}：一个{H259}名叫{H8034}法勒{H6389}(就是分的意思)，因为那时{H3117}人就分{H6385}地{H776}居住；法勒的兄弟{H251}名叫{H8034}约坍{H3355}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 20,
    "text": "约坍{H3355}生{H3205}亚摩答{H486}、沙列{H8026}、哈萨玛非{H2700}、耶拉{H3392}、"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 21,
    "text": "哈多兰{H1913}、乌萨{H187}、德拉{H1853}、"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 22,
    "text": "以巴录{H5858}、亚比玛利{H39}、示巴{H7614}、"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 23,
    "text": "阿斐{H211}、哈腓拉{H2341}、约巴{H3103}。这都是约坍{H3355}的儿子{H1121}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 24,
    "text": "闪{H8035}生亚法撒{H775}；亚法撒生沙拉{H7974}；"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 25,
    "text": "沙拉生希伯{H5677}；希伯生法勒{H6389}；法勒生拉吴{H7466}；"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 26,
    "text": "拉吴生西鹿{H8286}；西鹿生拿鹤{H5152}；拿鹤生他拉{H8646}；"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 27,
    "text": "他拉生亚伯兰{H87}，亚伯兰就是亚伯拉罕{H85}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 28,
    "text": "亚伯拉罕{H85}的儿子{H1121}是以撒{H3327}、以实玛利{H3458}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 29,
    "text": "以实玛利的儿子记在下面：以实玛利{H3458}的长子{H1060}是尼拜约{H5032}，其次是基达{H6938}、押德别{H110}、米比衫{H4017}、"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 30,
    "text": "米施玛{H4927}、度玛{H1746}、玛撒{H4854}、哈达{H2301}、提玛{H8485}、"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 31,
    "text": "伊突{H3195}、拿非施{H5305}、基底玛{H6929}。这都是以实玛利{H3458}的儿子{H1121}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 32,
    "text": "亚伯拉罕{H85}的妾{H6370}基土拉{H6989}所生的{H3205}儿子{H1121}，就是心兰{H2175}、约珊{H3370}、米但{H4091}、米甸{H4080}、伊施巴{H3435}、书亚{H7744}。约珊{H3370}的儿子{H1121}是示巴{H7614}、底但{H1719}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 33,
    "text": "米甸{H4080}的儿子{H1121}是以法{H5891}、以弗{H6081}、哈诺{H2585}、亚比大{H28}、以勒大{H420}。这都是基土拉{H6989}的子孙{H1121}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 34,
    "text": "亚伯拉罕{H85}生{H3205}以撒{H3327}；以撒{H3327}的儿子{H1121}是以扫{H6215}和以色列{H3478}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 35,
    "text": "以扫{H6215}的儿子{H1121}是以利法{H464}、流珥{H7467}、耶乌施{H3266}、雅兰{H3281}、可拉{H7141}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 36,
    "text": "以利法{H464}的儿子{H1121}是提幔{H8487}、阿抹{H201}、洗玻{H6825}、迦坦{H1609}、基纳斯{H7073}、亭纳{H8555}、亚玛力{H6002}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 37,
    "text": "流珥{H7467}的儿子{H1121}是拿哈{H5184}、谢拉{H2226}、沙玛{H8048}、米撒{H4199}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 38,
    "text": "西珥{H8165}的儿子{H1121}是罗坍{H3877}、朔巴{H7732}、祭便{H6649}、亚拿{H6034}、底顺{H1787}、以察{H687}、底珊{H1789}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 39,
    "text": "罗坍{H3877}的儿子{H1121}是何利{H2753}、荷幔{H1950}；罗坍{H3877}的妹子{H269}是亭纳{H8555}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 40,
    "text": "朔巴{H7732}的儿子{H1121}是亚勒文{H5935}、玛拿辖{H4506}、以巴录{H5858}、示非{H8195}、阿南{H208}。祭便{H6649}的儿子{H1121}是亚雅{H345}、亚拿{H6034}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 41,
    "text": "亚拿{H6034}的儿子{H1121}是底顺{H1787}。底顺{H1787}的儿子{H1121}是哈默兰{H2566}、伊是班{H790}、益兰{H3506}、基兰{H3763}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 42,
    "text": "以察{H687}的儿子{H1121}是辟罕{H1092}、撒番{H2190}、亚干{H3292}。底珊{H1789}的儿子{H1121}是乌斯{H5780}、亚兰{H765}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 43,
    "text": "以色列{H3478}人{H1121}未有君王{H4428}治理{H4427}之先，在以东{H123}地{H776}作王{H4428}的记在下面：有比珥{H1160}的儿子{H1121}比拉{H1106}，他的京城{H5892}名叫{H8034}亭哈巴{H1838}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 44,
    "text": "比拉{H1106}死了{H4191}，波斯拉人{H1224}谢拉{H2226}的儿子{H1121}约巴{H3103}接续他作王{H4427}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 45,
    "text": "约巴{H3103}死了{H4191}，提幔{H8489}地{H776}的人户珊{H2367}接续他作王{H4427}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 46,
    "text": "户珊{H2367}死了{H4191}，比达{H911}的儿子{H1121}哈达{H1908}接续他作王{H4427}。这哈达就是在摩押{H4124}地{H7704}杀败{H5221}米甸人{H4080}的，他的京城{H5892}名叫{H8034}亚未得{H5762}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 47,
    "text": "哈达{H1908}死了{H4191}，玛士利加人{H4957}桑拉{H8072}接续他作王{H4427}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 48,
    "text": "桑拉{H8072}死了{H4191}，大河{H5104}边的利河伯人{H7344}扫罗{H7586}接续他作王{H4427}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 49,
    "text": "扫罗{H7586}死了{H4191}，亚革波{H5907}的儿子{H1121}巴勒哈南{H1177}接续他作王{H4427}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 50,
    "text": "巴勒哈南{H1177}死了{H4191}，哈达{H1908}接续他作王{H4427}。他的京城{H5892}名叫{H8034}巴伊{H6464}，他的妻子{H802}名叫{H8034}米希他别{H4105}，是米萨合{H4314}的孙女{H1323}，玛特列{H4308}的女儿{H1323}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 51,
    "text": "哈达{H1908}死了{H4191}，以东人{H123}的族长{H441}有亭纳{H8555}族长{H441}、亚勒瓦{H5933}族长{H441}、耶帖{H3509}族长{H441}、"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 52,
    "text": "亚何利巴玛{H173}族长{H441}、以拉{H425}族长{H441}、比嫩{H6373}族长{H441}、"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 53,
    "text": "基纳斯{H7073}族长{H441}、提幔{H8487}族长{H441}、米比萨{H4014}族长{H441}、"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 54,
    "text": "玛基叠{H4025}族长{H441}、以兰{H5902}族长{H441}。这都是以东人{H123}的族长{H441}。"
  }
]
