  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 40,
    "text": "ಲೇವಿಯರಲ್ಲಿ: ಹೋದವ್ಯನವರಾದ ಯೇಷೂವ ಮತ್ತು ಕದ್ಮೀಯೇಲ್ ಇವರ ಸಂತಾನದವರು 74"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 41,
    "text": "ಗಾಯಕರಲ್ಲಿ: ಆಸಾಫ್ಯರು 128"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 42,
    "text": "ದ್ವಾರಪಾಲಕರ ಸಂತಾನದವರು: ಶಲ್ಲೂಮ್ ಸಂತಾನದವರು, ಆಟೇರ್, ಟಲ್ಮೋನ್, ಅಕ್ಕೂಬ್, ಹಟೀಟ ಮತ್ತು ಶೋಬೈ ಇವರು ಒಟ್ಟು 139."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 43,
    "text": "¶ ದೇವಸ್ಥಾನದಾಸರಲ್ಲಿ: ಜೀಹ ಸಂತಾನದವರು ಮತ್ತು ಹಸೂಫ, ಟಬ್ಬಾವೋತ್,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 44,
    "text": "ಕೇರೋಸ್, ಸೀಯಹಾ, ಪಾದೋನ್,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 45,
    "text": "ಲೆಬಾನ, ಹಗಾಬ, ಅಕ್ಕೂಬ್,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 46,
    "text": "ಹಾಗಾಬ, ಶಮ್ಲೈ, ಮತ್ತು ಹಾನಾನ್,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 47,
    "text": "ಗಿದ್ದೇಲನ ಸಂತಾನದವರು, ಗಹರ್, ರೆವಾಯ,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 48,
    "text": "ರೆಚೀನ್, ನೆಕೋದ, ಗಜ್ಜಾಮ್,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 49,
    "text": "ಉಜ್ಜ, ಪಾಸೇಹ, ಬೇಸೈ,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 50,
    "text": "ಅಸ್ನ, ಮೆಗೂನೀಮ್ ಮತ್ತು ನೆಫೀಸೀಮ್,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 51,
    "text": "ಬಕ್ಬೂಕ್ ಸಂತಾನದವರು, ಹಕ್ಕೂಫ, ಹರ್ಹೂರ್,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 52,
    "text": "ಬಚ್ಲೂತ್, ಮೆಹೀದ, ಹರ್ಷ,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 53,
    "text": "ಬರ್ಕೋಸ್, ಸೀಸೆರ, ತೆಮಹ,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 54,
    "text": "ನೆಚೀಹ ಮತ್ತು ಹಟೀಫ."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 55,
    "text": "ಸೊಲೊಮೋನನ ದಾಸರ ಸಂತಾನದವರು; ಸೋಟೈ ಸಂತಾನದವರು, ಹಸ್ಲೋಫೆರೆತ್, ಪೆರೂದ,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 56,
    "text": "ಯಾಲ, ದರ್ಕೋನ್ ಗಿದ್ದೇಲ್,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 57,
    "text": "ಶೆಫಟ್ಯ, ಹಟ್ಟೀಲ್, ಪೋಕೆರೆತ್ ಹಚ್ಚೆಬಾಯೀಮ್ ಮತ್ತು ಆಮಿ."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 58,
    "text": "ಎಲ್ಲಾ ಸಂತಾನದವರನ್ನು ದೇವಸ್ಥಾನದ ಸೇವೆಗಾಗಿ ನೇಮಿಸಿದರು ಮತ್ತು ಸೊಲೊಮೋನನ ದಾಸರೂ ಒಟ್ಟು 392."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 59,
    "text": "ಉಳಿದ ತೇಲ್ಮೆಲಹ, ತೇಲ್ಹರ್ಷ, ಕೆರೂಬ್, ಅದ್ದಾನ್ ಮತ್ತು ಇಮ್ಮೇರ್ ಎಂಬ ಊರುಗಳಿಂದ ಬಂದವರಾಗಿ ತಮ್ಮ ಗೋತ್ರವಂಶಾವಳಿಗಳನ್ನು ತೋರಿಸಿದರು."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 60,
    "text": "ಆದರೂ ತಾವು ಇಸ್ರಾಯೇಲರೆಂಬುದನ್ನು ಸ್ಥಾಪಿಸಿಲಾರದವರಾದ ದೆಲಾಯ, ಟೋಬೀಯ ಮತ್ತು ನೆಕೋದ ಇವರ ಸಂತಾನದವರು 652."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 61,
    "text": "ಯಾಜಕರಲ್ಲಿ: ಹಬಯ್ಯ, ಹಕ್ಕೋಜ್ ಮತ್ತು ಬರ್ಜಿಲ್ಲೈ ಇವರ ಸಂತಾನದವರು. (ಈ ಬರ್ಜಿಲ್ಲೈ ಎಂಬವನು ಗಿಲ್ಯಾದ್ಯನಾದ ಬರ್ಜಿಲ್ಲೈಯ ಹೆಣ್ಣುಮಕ್ಕಳಲ್ಲಿ ಒಬ್ಬಳನ್ನು ಮದುವೆಮಾಡಿಕೊಂಡು ಅವನ ಹೆಸರನ್ನೂ ಇಟ್ಟುಕೊಂಡಿದ್ದನು.)"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 62,
    "text": "ಇವರು ತಮ್ಮ ವಂಶಾವಳಿಯ ಪತ್ರಗಳನ್ನು ಹುಡುಕಿದರೂ ಅವು ಸಿಕ್ಕದ ಕಾರಣ ಅಶುದ್ಧರೆಂದು ಯಾಜಕೋದ್ಯೋಗದಿಂದ ತಿರಸ್ಕರಿಸಲ್ಪಟ್ಟರು."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 63,
    "text": "ಊರೀಮ್ ಮತ್ತು ತುಮ್ಮೀಮುಗಳ ಮೂಲಕ ದೈವನಿರ್ಣಯವನ್ನು ತಿಳಿಸಬಲ್ಲವನಾದ ಯಾಜಕನು ಬರುವ ತನಕ ಇವರು ಮಹಾಪರಿಶುದ್ಧ ಪದಾರ್ಥಗಳಲ್ಲಿ ಭೋಜನ ಮಾಡಬಾರದೆಂಬುದಾಗಿ ದೇಶಾಧಿಪತಿಯು ತೀರ್ಪುಮಾಡಿದನು."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 64,
    "text": "¶ ಸರ್ವಸಮೂಹದವರ ಒಟ್ಟು ಸಂಖ್ಯೆಯು ನಲ್ವತ್ತೆರಡು ಸಾವಿರದ ಮುನ್ನೂರ ಆರವತ್ತು."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 65,
    "text": "ಈ ಸಂಖ್ಯೆಯಲ್ಲಿ ಲೆಕ್ಕಿಸಲ್ಪಡದ ಅವರ ದಾಸದಾಸಿಯರು ಏಳು ಸಾವಿರದ ಮುನ್ನೂರ ಮೂವತ್ತೇಳು ಜನರು. ಅವರಲ್ಲಿ ಗಾಯಕರೂ, ಗಾಯಕಿಯರೂ ಇನ್ನೂರು ಜನರು ಇದ್ದರು."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 66,
    "text": "ಅವರಿಗೆ ಏಳು ನೂರ ಮೂವತ್ತಾರು ಕುದುರೆಗಳೂ, ಇನ್ನೂರ ನಲ್ವತ್ತೈದು ಹೇಸರಗತ್ತೆಗಳೂ,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 67,
    "text": "ನಾನೂರ ಮೂವತ್ತೈದು ಒಂಟೆಗಳೂ, ಆರು ಸಾವಿರದ ಏಳು ನೂರ ಇಪ್ಪತ್ತು ಕತ್ತೆಗಳೂ ಇದ್ದವು."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 68,
    "text": "ಗೋತ್ರಪ್ರಧಾನರಲ್ಲಿ ಕೆಲವರು ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಯೆಹೋವನ ಆಲಯವಿದ್ದ ಸ್ಥಳಕ್ಕೆ ಬಂದಾಗ ದೇವಾಲಯವನ್ನು ಪುನಃ ಅದರ ಸ್ಥಳದಲ್ಲಿ ಕಟ್ಟುವುದಕ್ಕೋಸ್ಕರ ಕಾಣಿಕೆಗಳನ್ನು ಕೊಟ್ಟರು."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 69,
    "text": "ಅವರು ತಮ್ಮ ಸಾಮರ್ಥ್ಯಕ್ಕನುಸಾರವಾಗಿ ಕಟ್ಟಡದ ಭಂಡಾರಕ್ಕೆ ಕೊಟ್ಟದ್ದು ಅರುವತ್ತೊಂದು ಸಾವಿರ ಬಂಗಾರದ ಪವನುಗಳು, ಎರಡು ಲಕ್ಷದ ಐವತ್ತು ಸಾವಿರ ತೊಲಾ ಬೆಳ್ಳಿ ಮತ್ತು ನೂರು ಯಾಜಕವಸ್ತ್ರಗಳು."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 70,
    "text": "¶ ದೇವಸ್ಥಾನದ ಸೇವೆಗಾಗಿ ಇದ್ದ ಯಾಜಕರು, ಲೇವಿಯರು, ಗಾಯಕರು, ದ್ವಾರಪಾಲಕರು ಮತ್ತು ಸಾಧಾರಣಜನರಲ್ಲಿ ಕೆಲವರು ಅವರವರಿಗೆ ನೇಮಕವಾದ ಪಟ್ಟಣಗಳಲ್ಲಿ ವಾಸಿಸಿದರು; ಬೇರೆ ಎಲ್ಲಾ ಇಸ್ರಾಯೇಲರು ತಮ್ಮ ತಮ್ಮ ಪಟ್ಟಣಗಳಲ್ಲಿ ವಾಸಿಸಿದರು."
  }
]
