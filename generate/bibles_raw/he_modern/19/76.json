[
  {
    "bookId": 19,
    "chapterId": 76,
    "verseId": 1,
    "text": "¶ למנצח בנגינת מזמור לאסף שיר נודע ביהודה אלהים בישראל גדול שמו׃"
  },
  {
    "bookId": 19,
    "chapterId": 76,
    "verseId": 2,
    "text": "ויהי בשלם סכו ומעונתו בציון׃"
  },
  {
    "bookId": 19,
    "chapterId": 76,
    "verseId": 3,
    "text": "שמה שבר רשפי קשת מגן וחרב ומלחמה סלה׃"
  },
  {
    "bookId": 19,
    "chapterId": 76,
    "verseId": 4,
    "text": "נאור אתה אדיר מהררי טרף׃"
  },
  {
    "bookId": 19,
    "chapterId": 76,
    "verseId": 5,
    "text": "אשתוללו אבירי לב נמו שנתם ולא מצאו כל אנשי חיל ידיהם׃"
  },
  {
    "bookId": 19,
    "chapterId": 76,
    "verseId": 6,
    "text": "מגערתך אלהי יעקב נרדם ורכב וסוס׃"
  },
  {
    "bookId": 19,
    "chapterId": 76,
    "verseId": 7,
    "text": "אתה נורא אתה ומי יעמד לפניך מאז אפך׃"
  },
  {
    "bookId": 19,
    "chapterId": 76,
    "verseId": 8,
    "text": "משמים השמעת דין ארץ יראה ושקטה׃"
  },
  {
    "bookId": 19,
    "chapterId": 76,
    "verseId": 9,
    "text": "בקום למשפט אלהים להושיע כל ענוי ארץ סלה׃"
  },
  {
    "bookId": 19,
    "chapterId": 76,
    "verseId": 10,
    "text": "כי חמת אדם תודך שארית חמת תחגר׃"
  },
  {
    "bookId": 19,
    "chapterId": 76,
    "verseId": 11,
    "text": "נדרו ושלמו ליהוה אלהיכם כל סביביו יובילו שי למורא׃"
  },
  {
    "bookId": 19,
    "chapterId": 76,
    "verseId": 12,
    "text": "יבצר רוח נגידים נורא למלכי ארץ׃"
  }
]
