[
  {
    "bookId": 19,
    "chapterId": 87,
    "verseId": 1,
    "text": "¶ לבני קרח מזמור שיר יסודתו בהררי קדש׃"
  },
  {
    "bookId": 19,
    "chapterId": 87,
    "verseId": 2,
    "text": "אהב יהוה שערי ציון מכל משכנות יעקב׃"
  },
  {
    "bookId": 19,
    "chapterId": 87,
    "verseId": 3,
    "text": "נכבדות מדבר בך עיר האלהים סלה׃"
  },
  {
    "bookId": 19,
    "chapterId": 87,
    "verseId": 4,
    "text": "אזכיר רהב ובבל לידעי הנה פלשת וצור עם כוש זה ילד שם׃"
  },
  {
    "bookId": 19,
    "chapterId": 87,
    "verseId": 5,
    "text": "ולציון יאמר איש ואיש ילד בה והוא יכוננה עליון׃"
  },
  {
    "bookId": 19,
    "chapterId": 87,
    "verseId": 6,
    "text": "יהוה יספר בכתוב עמים זה ילד שם סלה׃"
  },
  {
    "bookId": 19,
    "chapterId": 87,
    "verseId": 7,
    "text": "ושרים כחללים כל מעיני בך׃"
  }
]
