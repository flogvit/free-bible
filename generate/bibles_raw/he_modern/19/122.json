[
  {
    "bookId": 19,
    "chapterId": 122,
    "verseId": 1,
    "text": "¶ שיר המעלות לדוד שמחתי באמרים לי בית יהוה נלך׃"
  },
  {
    "bookId": 19,
    "chapterId": 122,
    "verseId": 2,
    "text": "עמדות היו רגלינו בשעריך ירושלם׃"
  },
  {
    "bookId": 19,
    "chapterId": 122,
    "verseId": 3,
    "text": "ירושלם הבנויה כעיר שחברה לה יחדו׃"
  },
  {
    "bookId": 19,
    "chapterId": 122,
    "verseId": 4,
    "text": "ששם עלו שבטים שבטי יה עדות לישראל להדות לשם יהוה׃"
  },
  {
    "bookId": 19,
    "chapterId": 122,
    "verseId": 5,
    "text": "כי שמה ישבו כסאות למשפט כסאות לבית דויד׃"
  },
  {
    "bookId": 19,
    "chapterId": 122,
    "verseId": 6,
    "text": "שאלו שלום ירושלם ישליו אהביך׃"
  },
  {
    "bookId": 19,
    "chapterId": 122,
    "verseId": 7,
    "text": "יהי שלום בחילך שלוה בארמנותיך׃"
  },
  {
    "bookId": 19,
    "chapterId": 122,
    "verseId": 8,
    "text": "למען אחי ורעי אדברה נא שלום בך׃"
  },
  {
    "bookId": 19,
    "chapterId": 122,
    "verseId": 9,
    "text": "למען בית יהוה אלהינו אבקשה טוב לך׃"
  }
]
