[
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 1,
    "text": "¶ שיר מזמור לאסף אלהים אל דמי לך אל תחרש ואל תשקט אל׃"
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 2,
    "text": "כי הנה אויביך יהמיון ומשנאיך נשאו ראש׃"
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 3,
    "text": "על עמך יערימו סוד ויתיעצו על צפוניך׃"
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 4,
    "text": "אמרו לכו ונכחידם מגוי ולא יזכר שם ישראל עוד׃"
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 5,
    "text": "כי נועצו לב יחדו עליך ברית יכרתו׃"
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 6,
    "text": "אהלי אדום וישמעאלים מואב והגרים׃"
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 7,
    "text": "גבל ועמון ועמלק פלשת עם ישבי צור׃"
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 8,
    "text": "גם אשור נלוה עמם היו זרוע לבני לוט סלה׃"
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 9,
    "text": "עשה להם כמדין כסיסרא כיבין בנחל קישון׃"
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 10,
    "text": "נשמדו בעין דאר היו דמן לאדמה׃"
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 11,
    "text": "שיתמו נדיבמו כערב וכזאב וכזבח וכצלמנע כל נסיכמו׃"
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 12,
    "text": "אשר אמרו נירשה לנו את נאות אלהים׃"
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 13,
    "text": "אלהי שיתמו כגלגל כקש לפני רוח׃"
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 14,
    "text": "כאש תבער יער וכלהבה תלהט הרים׃"
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 15,
    "text": "כן תרדפם בסערך ובסופתך תבהלם׃"
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 16,
    "text": "מלא פניהם קלון ויבקשו שמך יהוה׃"
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 17,
    "text": "יבשו ויבהלו עדי עד ויחפרו ויאבדו׃"
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 18,
    "text": "וידעו כי אתה שמך יהוה לבדך עליון על כל הארץ׃"
  }
]
