[
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 1,
    "text": "¶ שיר המעלות רבת צררוני מנעורי יאמר נא ישראל׃"
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 2,
    "text": "רבת צררוני מנעורי גם לא יכלו לי׃"
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 3,
    "text": "על גבי חרשו חרשים האריכו למענותם׃"
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 4,
    "text": "יהוה צדיק קצץ עבות רשעים׃"
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 5,
    "text": "יבשו ויסגו אחור כל שנאי ציון׃"
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 6,
    "text": "יהיו כחציר גגות שקדמת שלף יבש׃"
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 7,
    "text": "שלא מלא כפו קוצר וחצנו מעמר׃"
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 8,
    "text": "ולא אמרו העברים ברכת יהוה אליכם ברכנו אתכם בשם יהוה׃"
  }
]
