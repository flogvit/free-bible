[
  {
    "bookId": 19,
    "chapterId": 130,
    "verseId": 1,
    "text": "¶ שיר המעלות ממעמקים קראתיך יהוה׃"
  },
  {
    "bookId": 19,
    "chapterId": 130,
    "verseId": 2,
    "text": "אדני שמעה בקולי תהיינה אזניך קשבות לקול תחנוני׃"
  },
  {
    "bookId": 19,
    "chapterId": 130,
    "verseId": 3,
    "text": "אם עונות תשמר יה אדני מי יעמד׃"
  },
  {
    "bookId": 19,
    "chapterId": 130,
    "verseId": 4,
    "text": "כי עמך הסליחה למען תורא׃"
  },
  {
    "bookId": 19,
    "chapterId": 130,
    "verseId": 5,
    "text": "קויתי יהוה קותה נפשי ולדברו הוחלתי׃"
  },
  {
    "bookId": 19,
    "chapterId": 130,
    "verseId": 6,
    "text": "נפשי לאדני משמרים לבקר שמרים לבקר׃"
  },
  {
    "bookId": 19,
    "chapterId": 130,
    "verseId": 7,
    "text": "יחל ישראל אל יהוה כי עם יהוה החסד והרבה עמו פדות׃"
  },
  {
    "bookId": 19,
    "chapterId": 130,
    "verseId": 8,
    "text": "והוא יפדה את ישראל מכל עונתיו׃"
  }
]
