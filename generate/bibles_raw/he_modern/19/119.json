[
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 1,
    "text": "¶ אשרי תמימי דרך ההלכים בתורת יהוה׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 2,
    "text": "אשרי נצרי עדתיו בכל לב ידרשוהו׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 3,
    "text": "אף לא פעלו עולה בדרכיו הלכו׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 4,
    "text": "אתה צויתה פקדיך לשמר מאד׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 5,
    "text": "אחלי יכנו דרכי לשמר חקיך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 6,
    "text": "אז לא אבוש בהביטי אל כל מצותיך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 7,
    "text": "אודך בישר לבב בלמדי משפטי צדקך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 8,
    "text": "את חקיך אשמר אל תעזבני עד מאד׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 9,
    "text": "במה יזכה נער את ארחו לשמר כדברך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 10,
    "text": "בכל לבי דרשתיך אל תשגני ממצותיך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 11,
    "text": "בלבי צפנתי אמרתך למען לא אחטא לך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 12,
    "text": "ברוך אתה יהוה למדני חקיך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 13,
    "text": "בשפתי ספרתי כל משפטי פיך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 14,
    "text": "בדרך עדותיך ששתי כעל כל הון׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 15,
    "text": "בפקדיך אשיחה ואביטה ארחתיך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 16,
    "text": "בחקתיך אשתעשע לא אשכח דברך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 17,
    "text": "גמל על עבדך אחיה ואשמרה דברך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 18,
    "text": "גל עיני ואביטה נפלאות מתורתך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 19,
    "text": "גר אנכי בארץ אל תסתר ממני מצותיך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 20,
    "text": "גרסה נפשי לתאבה אל משפטיך בכל עת׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 21,
    "text": "גערת זדים ארורים השגים ממצותיך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 22,
    "text": "גל מעלי חרפה ובוז כי עדתיך נצרתי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 23,
    "text": "גם ישבו שרים בי נדברו עבדך ישיח בחקיך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 24,
    "text": "גם עדתיך שעשעי אנשי עצתי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 25,
    "text": "דבקה לעפר נפשי חיני כדברך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 26,
    "text": "דרכי ספרתי ותענני למדני חקיך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 27,
    "text": "דרך פקודיך הבינני ואשיחה בנפלאותיך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 28,
    "text": "דלפה נפשי מתוגה קימני כדברך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 29,
    "text": "דרך שקר הסר ממני ותורתך חנני׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 30,
    "text": "דרך אמונה בחרתי משפטיך שויתי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 31,
    "text": "דבקתי בעדותיך יהוה אל תבישני׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 32,
    "text": "דרך מצותיך ארוץ כי תרחיב לבי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 33,
    "text": "הורני יהוה דרך חקיך ואצרנה עקב׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 34,
    "text": "הבינני ואצרה תורתך ואשמרנה בכל לב׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 35,
    "text": "הדריכני בנתיב מצותיך כי בו חפצתי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 36,
    "text": "הט לבי אל עדותיך ואל אל בצע׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 37,
    "text": "העבר עיני מראות שוא בדרכך חיני׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 38,
    "text": "הקם לעבדך אמרתך אשר ליראתך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 39,
    "text": "העבר חרפתי אשר יגרתי כי משפטיך טובים׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 40,
    "text": "הנה תאבתי לפקדיך בצדקתך חיני׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 41,
    "text": "ויבאני חסדך יהוה תשועתך כאמרתך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 42,
    "text": "ואענה חרפי דבר כי בטחתי בדברך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 43,
    "text": "ואל תצל מפי דבר אמת עד מאד כי למשפטך יחלתי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 44,
    "text": "ואשמרה תורתך תמיד לעולם ועד׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 45,
    "text": "ואתהלכה ברחבה כי פקדיך דרשתי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 46,
    "text": "ואדברה בעדתיך נגד מלכים ולא אבוש׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 47,
    "text": "ואשתעשע במצותיך אשר אהבתי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 48,
    "text": "ואשא כפי אל מצותיך אשר אהבתי ואשיחה בחקיך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 49,
    "text": "זכר דבר לעבדך על אשר יחלתני׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 50,
    "text": "זאת נחמתי בעניי כי אמרתך חיתני׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 51,
    "text": "זדים הליצני עד מאד מתורתך לא נטיתי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 52,
    "text": "זכרתי משפטיך מעולם יהוה ואתנחם׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 53,
    "text": "זלעפה אחזתני מרשעים עזבי תורתך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 54,
    "text": "זמרות היו לי חקיך בבית מגורי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 55,
    "text": "זכרתי בלילה שמך יהוה ואשמרה תורתך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 56,
    "text": "זאת היתה לי כי פקדיך נצרתי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 57,
    "text": "חלקי יהוה אמרתי לשמר דבריך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 58,
    "text": "חליתי פניך בכל לב חנני כאמרתך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 59,
    "text": "חשבתי דרכי ואשיבה רגלי אל עדתיך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 60,
    "text": "חשתי ולא התמהמהתי לשמר מצותיך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 61,
    "text": "חבלי רשעים עודני תורתך לא שכחתי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 62,
    "text": "חצות לילה אקום להודות לך על משפטי צדקך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 63,
    "text": "חבר אני לכל אשר יראוך ולשמרי פקודיך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 64,
    "text": "חסדך יהוה מלאה הארץ חקיך למדני׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 65,
    "text": "טוב עשית עם עבדך יהוה כדברך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 66,
    "text": "טוב טעם ודעת למדני כי במצותיך האמנתי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 67,
    "text": "טרם אענה אני שגג ועתה אמרתך שמרתי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 68,
    "text": "טוב אתה ומטיב למדני חקיך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 69,
    "text": "טפלו עלי שקר זדים אני בכל לב אצר פקודיך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 70,
    "text": "טפש כחלב לבם אני תורתך שעשעתי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 71,
    "text": "טוב לי כי עניתי למען אלמד חקיך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 72,
    "text": "טוב לי תורת פיך מאלפי זהב וכסף׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 73,
    "text": "ידיך עשוני ויכוננוני הבינני ואלמדה מצותיך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 74,
    "text": "יראיך יראוני וישמחו כי לדברך יחלתי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 75,
    "text": "ידעתי יהוה כי צדק משפטיך ואמונה עניתני׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 76,
    "text": "יהי נא חסדך לנחמני כאמרתך לעבדך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 77,
    "text": "יבאוני רחמיך ואחיה כי תורתך שעשעי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 78,
    "text": "יבשו זדים כי שקר עותוני אני אשיח בפקודיך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 79,
    "text": "ישובו לי יראיך וידעו עדתיך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 80,
    "text": "יהי לבי תמים בחקיך למען לא אבוש׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 81,
    "text": "כלתה לתשועתך נפשי לדברך יחלתי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 82,
    "text": "כלו עיני לאמרתך לאמר מתי תנחמני׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 83,
    "text": "כי הייתי כנאד בקיטור חקיך לא שכחתי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 84,
    "text": "כמה ימי עבדך מתי תעשה ברדפי משפט׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 85,
    "text": "כרו לי זדים שיחות אשר לא כתורתך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 86,
    "text": "כל מצותיך אמונה שקר רדפוני עזרני׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 87,
    "text": "כמעט כלוני בארץ ואני לא עזבתי פקודיך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 88,
    "text": "כחסדך חיני ואשמרה עדות פיך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 89,
    "text": "לעולם יהוה דברך נצב בשמים׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 90,
    "text": "לדר ודר אמונתך כוננת ארץ ותעמד׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 91,
    "text": "למשפטיך עמדו היום כי הכל עבדיך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 92,
    "text": "לולי תורתך שעשעי אז אבדתי בעניי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 93,
    "text": "לעולם לא אשכח פקודיך כי בם חייתני׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 94,
    "text": "לך אני הושיעני כי פקודיך דרשתי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 95,
    "text": "לי קוו רשעים לאבדני עדתיך אתבונן׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 96,
    "text": "לכל תכלה ראיתי קץ רחבה מצותך מאד׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 97,
    "text": "מה אהבתי תורתך כל היום היא שיחתי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 98,
    "text": "מאיבי תחכמני מצותך כי לעולם היא לי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 99,
    "text": "מכל מלמדי השכלתי כי עדותיך שיחה לי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 100,
    "text": "מזקנים אתבונן כי פקודיך נצרתי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 101,
    "text": "מכל ארח רע כלאתי רגלי למען אשמר דברך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 102,
    "text": "ממשפטיך לא סרתי כי אתה הורתני׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 103,
    "text": "מה נמלצו לחכי אמרתך מדבש לפי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 104,
    "text": "מפקודיך אתבונן על כן שנאתי כל ארח שקר׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 105,
    "text": "נר לרגלי דברך ואור לנתיבתי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 106,
    "text": "נשבעתי ואקימה לשמר משפטי צדקך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 107,
    "text": "נעניתי עד מאד יהוה חיני כדברך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 108,
    "text": "נדבות פי רצה נא יהוה ומשפטיך למדני׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 109,
    "text": "נפשי בכפי תמיד ותורתך לא שכחתי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 110,
    "text": "נתנו רשעים פח לי ומפקודיך לא תעיתי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 111,
    "text": "נחלתי עדותיך לעולם כי ששון לבי המה׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 112,
    "text": "נטיתי לבי לעשות חקיך לעולם עקב׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 113,
    "text": "סעפים שנאתי ותורתך אהבתי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 114,
    "text": "סתרי ומגני אתה לדברך יחלתי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 115,
    "text": "סורו ממני מרעים ואצרה מצות אלהי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 116,
    "text": "סמכני כאמרתך ואחיה ואל תבישני משברי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 117,
    "text": "סעדני ואושעה ואשעה בחקיך תמיד׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 118,
    "text": "סלית כל שוגים מחקיך כי שקר תרמיתם׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 119,
    "text": "סגים השבת כל רשעי ארץ לכן אהבתי עדתיך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 120,
    "text": "סמר מפחדך בשרי וממשפטיך יראתי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 121,
    "text": "עשיתי משפט וצדק בל תניחני לעשקי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 122,
    "text": "ערב עבדך לטוב אל יעשקני זדים׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 123,
    "text": "עיני כלו לישועתך ולאמרת צדקך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 124,
    "text": "עשה עם עבדך כחסדך וחקיך למדני׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 125,
    "text": "עבדך אני הבינני ואדעה עדתיך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 126,
    "text": "עת לעשות ליהוה הפרו תורתך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 127,
    "text": "על כן אהבתי מצותיך מזהב ומפז׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 128,
    "text": "על כן כל פקודי כל ישרתי כל ארח שקר שנאתי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 129,
    "text": "פלאות עדותיך על כן נצרתם נפשי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 130,
    "text": "פתח דבריך יאיר מבין פתיים׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 131,
    "text": "פי פערתי ואשאפה כי למצותיך יאבתי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 132,
    "text": "פנה אלי וחנני כמשפט לאהבי שמך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 133,
    "text": "פעמי הכן באמרתך ואל תשלט בי כל און׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 134,
    "text": "פדני מעשק אדם ואשמרה פקודיך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 135,
    "text": "פניך האר בעבדך ולמדני את חקיך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 136,
    "text": "פלגי מים ירדו עיני על לא שמרו תורתך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 137,
    "text": "צדיק אתה יהוה וישר משפטיך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 138,
    "text": "צוית צדק עדתיך ואמונה מאד׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 139,
    "text": "צמתתני קנאתי כי שכחו דבריך צרי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 140,
    "text": "צרופה אמרתך מאד ועבדך אהבה׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 141,
    "text": "צעיר אנכי ונבזה פקדיך לא שכחתי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 142,
    "text": "צדקתך צדק לעולם ותורתך אמת׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 143,
    "text": "צר ומצוק מצאוני מצותיך שעשעי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 144,
    "text": "צדק עדותיך לעולם הבינני ואחיה׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 145,
    "text": "קראתי בכל לב ענני יהוה חקיך אצרה׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 146,
    "text": "קראתיך הושיעני ואשמרה עדתיך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 147,
    "text": "קדמתי בנשף ואשועה לדבריך יחלתי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 148,
    "text": "קדמו עיני אשמרות לשיח באמרתך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 149,
    "text": "קולי שמעה כחסדך יהוה כמשפטך חיני׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 150,
    "text": "קרבו רדפי זמה מתורתך רחקו׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 151,
    "text": "קרוב אתה יהוה וכל מצותיך אמת׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 152,
    "text": "קדם ידעתי מעדתיך כי לעולם יסדתם׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 153,
    "text": "ראה עניי וחלצני כי תורתך לא שכחתי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 154,
    "text": "ריבה ריבי וגאלני לאמרתך חיני׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 155,
    "text": "רחוק מרשעים ישועה כי חקיך לא דרשו׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 156,
    "text": "רחמיך רבים יהוה כמשפטיך חיני׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 157,
    "text": "רבים רדפי וצרי מעדותיך לא נטיתי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 158,
    "text": "ראיתי בגדים ואתקוטטה אשר אמרתך לא שמרו׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 159,
    "text": "ראה כי פקודיך אהבתי יהוה כחסדך חיני׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 160,
    "text": "ראש דברך אמת ולעולם כל משפט צדקך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 161,
    "text": "שרים רדפוני חנם ומדבריך פחד לבי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 162,
    "text": "שש אנכי על אמרתך כמוצא שלל רב׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 163,
    "text": "שקר שנאתי ואתעבה תורתך אהבתי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 164,
    "text": "שבע ביום הללתיך על משפטי צדקך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 165,
    "text": "שלום רב לאהבי תורתך ואין למו מכשול׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 166,
    "text": "שברתי לישועתך יהוה ומצותיך עשיתי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 167,
    "text": "שמרה נפשי עדתיך ואהבם מאד׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 168,
    "text": "שמרתי פקודיך ועדתיך כי כל דרכי נגדך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 169,
    "text": "תקרב רנתי לפניך יהוה כדברך הבינני׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 170,
    "text": "תבוא תחנתי לפניך כאמרתך הצילני׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 171,
    "text": "תבענה שפתי תהלה כי תלמדני חקיך׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 172,
    "text": "תען לשוני אמרתך כי כל מצותיך צדק׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 173,
    "text": "תהי ידך לעזרני כי פקודיך בחרתי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 174,
    "text": "תאבתי לישועתך יהוה ותורתך שעשעי׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 175,
    "text": "תחי נפשי ותהללך ומשפטך יעזרני׃"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 176,
    "text": "תעיתי כשה אבד בקש עבדך כי מצותיך לא שכחתי׃"
  }
]
