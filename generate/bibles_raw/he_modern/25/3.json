[
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 1,
    "text": "¶ אני הגבר ראה עני בשבט עברתו׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 2,
    "text": "אותי נהג וילך חשך ולא אור׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 3,
    "text": "אך בי ישב יהפך ידו כל היום׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 4,
    "text": "בלה בשרי ועורי שבר עצמותי׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 5,
    "text": "בנה עלי ויקף ראש ותלאה׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 6,
    "text": "במחשכים הושיבני כמתי עולם׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 7,
    "text": "גדר בעדי ולא אצא הכביד נחשתי׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 8,
    "text": "גם כי אזעק ואשוע שתם תפלתי׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 9,
    "text": "גדר דרכי בגזית נתיבתי עוה׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 10,
    "text": "דב ארב הוא לי אריה במסתרים׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 11,
    "text": "דרכי סורר ויפשחני שמני שמם׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 12,
    "text": "דרך קשתו ויציבני כמטרא לחץ׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 13,
    "text": "הביא בכליותי בני אשפתו׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 14,
    "text": "הייתי שחק לכל עמי נגינתם כל היום׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 15,
    "text": "השביעני במרורים הרוני לענה׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 16,
    "text": "ויגרס בחצץ שני הכפישני באפר׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 17,
    "text": "ותזנח משלום נפשי נשיתי טובה׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 18,
    "text": "ואמר אבד נצחי ותוחלתי מיהוה׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 19,
    "text": "זכר עניי ומרודי לענה וראש׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 20,
    "text": "זכור תזכור ותשיח עלי נפשי׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 21,
    "text": "זאת אשיב אל לבי על כן אוחיל׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 22,
    "text": "חסדי יהוה כי לא תמנו כי לא כלו רחמיו׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 23,
    "text": "חדשים לבקרים רבה אמונתך׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 24,
    "text": "חלקי יהוה אמרה נפשי על כן אוחיל לו׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 25,
    "text": "טוב יהוה לקוו לנפש תדרשנו׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 26,
    "text": "טוב ויחיל ודומם לתשועת יהוה׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 27,
    "text": "טוב לגבר כי ישא על בנעוריו׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 28,
    "text": "ישב בדד וידם כי נטל עליו׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 29,
    "text": "יתן בעפר פיהו אולי יש תקוה׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 30,
    "text": "יתן למכהו לחי ישבע בחרפה׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 31,
    "text": "כי לא יזנח לעולם אדני׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 32,
    "text": "כי אם הוגה ורחם כרב חסדו׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 33,
    "text": "כי לא ענה מלבו ויגה בני איש׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 34,
    "text": "לדכא תחת רגליו כל אסירי ארץ׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 35,
    "text": "להטות משפט גבר נגד פני עליון׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 36,
    "text": "לעות אדם בריבו אדני לא ראה׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 37,
    "text": "מי זה אמר ותהי אדני לא צוה׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 38,
    "text": "מפי עליון לא תצא הרעות והטוב׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 39,
    "text": "מה יתאונן אדם חי גבר על חטאו׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 40,
    "text": "נחפשה דרכינו ונחקרה ונשובה עד יהוה׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 41,
    "text": "נשא לבבנו אל כפים אל אל בשמים׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 42,
    "text": "נחנו פשענו ומרינו אתה לא סלחת׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 43,
    "text": "סכתה באף ותרדפנו הרגת לא חמלת׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 44,
    "text": "סכותה בענן לך מעבור תפלה׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 45,
    "text": "סחי ומאוס תשימנו בקרב העמים׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 46,
    "text": "פצו עלינו פיהם כל איבינו׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 47,
    "text": "פחד ופחת היה לנו השאת והשבר׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 48,
    "text": "פלגי מים תרד עיני על שבר בת עמי׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 49,
    "text": "עיני נגרה ולא תדמה מאין הפגות׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 50,
    "text": "עד ישקיף וירא יהוה משמים׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 51,
    "text": "עיני עוללה לנפשי מכל בנות עירי׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 52,
    "text": "צוד צדוני כצפור איבי חנם׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 53,
    "text": "צמתו בבור חיי וידו אבן בי׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 54,
    "text": "צפו מים על ראשי אמרתי נגזרתי׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 55,
    "text": "קראתי שמך יהוה מבור תחתיות׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 56,
    "text": "קולי שמעת אל תעלם אזנך לרוחתי לשועתי׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 57,
    "text": "קרבת ביום אקראך אמרת אל תירא׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 58,
    "text": "רבת אדני ריבי נפשי גאלת חיי׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 59,
    "text": "ראיתה יהוה עותתי שפטה משפטי׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 60,
    "text": "ראיתה כל נקמתם כל מחשבתם לי׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 61,
    "text": "שמעת חרפתם יהוה כל מחשבתם עלי׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 62,
    "text": "שפתי קמי והגיונם עלי כל היום׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 63,
    "text": "שבתם וקימתם הביטה אני מנגינתם׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 64,
    "text": "תשיב להם גמול יהוה כמעשה ידיהם׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 65,
    "text": "תתן להם מגנת לב תאלתך להם׃"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 66,
    "text": "תרדף באף ותשמידם מתחת שמי יהוה׃"
  }
]
