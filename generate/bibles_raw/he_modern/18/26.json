[
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 1,
    "text": "¶ ויען איוב ויאמר׃"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 2,
    "text": "מה עזרת ללא כח הושעת זרוע לא עז׃"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 3,
    "text": "מה יעצת ללא חכמה ותושיה לרב הודעת׃"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 4,
    "text": "את מי הגדת מלין ונשמת מי יצאה ממך׃"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 5,
    "text": "הרפאים יחוללו מתחת מים ושכניהם׃"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 6,
    "text": "ערום שאול נגדו ואין כסות לאבדון׃"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 7,
    "text": "נטה צפון על תהו תלה ארץ על בלי מה׃"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 8,
    "text": "צרר מים בעביו ולא נבקע ענן תחתם׃"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 9,
    "text": "מאחז פני כסה פרשז עליו עננו׃"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 10,
    "text": "חק חג על פני מים עד תכלית אור עם חשך׃"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 11,
    "text": "עמודי שמים ירופפו ויתמהו מגערתו׃"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 12,
    "text": "בכחו רגע הים ובתובנתו מחץ רהב׃"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 13,
    "text": "ברוחו שמים שפרה חללה ידו נחש בריח׃"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 14,
    "text": "הן אלה קצות דרכו ומה שמץ דבר נשמע בו ורעם גבורתו מי יתבונן׃"
  }
]
