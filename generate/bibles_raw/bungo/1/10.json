[
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 1,
    "text": "ノアの子セム、ハム、ヤペテの傳は是なり洪水の後彼等に子等生れたり"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 2,
    "text": "ヤペテの子はゴメル、マゴグ、マデア、ヤワン、トバル、メセク、テラスなり"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 3,
    "text": "ゴメルの子はアシケナズ、リパテ、トガルマなり"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 4,
    "text": "ヤワンの子はエリシヤ、タルシシ、キツテムおよびドダニムなり"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 5,
    "text": "是等より諸國の洲島の民は派分れ出て各其方言と其宗族と其邦國とに循ひて其地に住り"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 6,
    "text": "ハムの子はクシ、ミツライム、フテおよびカナンなり"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 7,
    "text": "クシの子はセバ、ハビラ、サブタ、ラアマ、サブテカなりラアマの子はシバおよびデダンなり"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 8,
    "text": "クシ、ニムロデを生り彼始めて世の權力ある者となれり"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 9,
    "text": "彼はヱホバの前にありて權力ある獵夫なりき是故にヱホバの前にある夫權力ある獵夫ニムロデの如しといふ諺あり"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 10,
    "text": "彼の國の起初はシナルの地のバベル、エレク、アツカデ、及びカルネなりき"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 11,
    "text": "其地より彼アッスリヤに出でニネベ、レホポテイリ、カラ"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 12,
    "text": "およびニネベとカラの間なるレセンを建たり是は大なる城邑なり"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 13,
    "text": "ミツライム、ルデ族アナミ族レハビ族ナフト族"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 14,
    "text": "バテロス族カスル族およびカフトリ族を生りカスル族よりペリシテ族出たり"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 15,
    "text": "カナン其冢子シドンおよびヘテ"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 16,
    "text": "エブス族アモリ族ギルガシ族"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 17,
    "text": "ヒビ族アルキ族セニ族"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 18,
    "text": "アルワデ族ゼマリ族ハマテ族を生り後に至りてカナン人の宗族蔓延りぬ"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 19,
    "text": "カナン人の境はシドンよりゲラルを經てガザに至りソドム、ゴモラ、アデマ、ゼボイムに沿てレシヤにまで及べり"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 20,
    "text": "是等はハムの子孫にして其宗族と其方言と其土地と其邦國に隨ひて居りぬ"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 21,
    "text": "セムはヱベルの全の子孫の先祖にしてヤペテの兄なり彼にも子女生れたり"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 22,
    "text": "セムの子はエラム、アシユル、アルパクサデルデ、アラムなり"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 23,
    "text": "アラムの子はウヅ、ホル、ゲテル、マシなり"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 24,
    "text": "アルパクサデ、シラを生みシラ、エベルを生り"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 25,
    "text": "エベルに二人の子生れたり一人の名をペレグ(分れ)といふ其は彼の代に邦國分れたればなり其弟の名をヨクタンと曰ふ"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 26,
    "text": "ヨクタン、アルモダデ、シヤレフ、ハザルマウテ、ヱラ"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 27,
    "text": "ハドラム、ウザル、デクラ"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 28,
    "text": "オバル、アビマエル、シバ"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 29,
    "text": "オフル、ハビラおよびヨバブを生り是等は皆ヨクタンの子なり"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 30,
    "text": "彼等の居住所はメシヤよりして東方の山セバルにまで至れり"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 31,
    "text": "是等はセムの子孫にして其宗族と其方言と其土地と其邦國とに隨ひて居りぬ"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 32,
    "text": "是等はノアの子の宗族にして其血統と其邦國に隨ひて居りぬ洪水の後是等より地の邦國の民は派分れ出たり"
  }
]
