[
  {
    "bookId": 1,
    "chapterId": 11,
    "verseId": 1,
    "text": "全地は一の言語一の音のみなりき"
  },
  {
    "bookId": 1,
    "chapterId": 11,
    "verseId": 2,
    "text": "茲に人衆東に移りてシナルの地に平野を得て其處に居住り"
  },
  {
    "bookId": 1,
    "chapterId": 11,
    "verseId": 3,
    "text": "彼等互に言けるは去來甎石を作り之を善く爇んと遂に石の代に甎石を獲灰沙の代に石漆を獲たり"
  },
  {
    "bookId": 1,
    "chapterId": 11,
    "verseId": 4,
    "text": "又曰けるは去來邑と塔とを建て其塔の頂を天にいたらしめん斯して我等名を揚て全地の表面に散ることを免れんと"
  },
  {
    "bookId": 1,
    "chapterId": 11,
    "verseId": 5,
    "text": "ヱホバ降臨りて彼人衆の建る邑と塔とを觀たまへり"
  },
  {
    "bookId": 1,
    "chapterId": 11,
    "verseId": 6,
    "text": "ヱホバ言たまひけるは視よ民は一にして皆一の言語を用ふ今旣に此を爲し始めたり然ば凡て其爲んと圖維る事は禁止め得られざるべし"
  },
  {
    "bookId": 1,
    "chapterId": 11,
    "verseId": 7,
    "text": "去來我等降り彼處にて彼等の言語を淆し互に言語を通ずることを得ざらしめんと"
  },
  {
    "bookId": 1,
    "chapterId": 11,
    "verseId": 8,
    "text": "ヱホバ遂に彼等を彼處より全地の表面に散したまひければ彼等邑を建ることを罷たり"
  },
  {
    "bookId": 1,
    "chapterId": 11,
    "verseId": 9,
    "text": "是故に其名はバベル(淆亂)と呼ばる是はヱホバ彼處に全地の言語を淆したまひしに由てなり彼處よりヱホバ彼等を全地の表に散したまへり"
  },
  {
    "bookId": 1,
    "chapterId": 11,
    "verseId": 10,
    "text": "セムの傳は是なりセム百歳にして洪水の後の二年にアルパクサデを生り"
  },
  {
    "bookId": 1,
    "chapterId": 11,
    "verseId": 11,
    "text": "セム、アルパクサデを生し後五百年生存へて男子女子を生り"
  },
  {
    "bookId": 1,
    "chapterId": 11,
    "verseId": 12,
    "text": "アルパクサデ三十五歳に及びてシラを生り"
  },
  {
    "bookId": 1,
    "chapterId": 11,
    "verseId": 13,
    "text": "アルパクサデ、シラを生し後四百三年生存へて男子女子を生り"
  },
  {
    "bookId": 1,
    "chapterId": 11,
    "verseId": 14,
    "text": "シラ三十歳におよびてエベルを生り"
  },
  {
    "bookId": 1,
    "chapterId": 11,
    "verseId": 15,
    "text": "シラ、エベルを生し後四百三年生存へて男子女子を生り"
  },
  {
    "bookId": 1,
    "chapterId": 11,
    "verseId": 16,
    "text": "エベル三十四歳におよびてペレグを生り"
