[
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 1,
    "text": "アダムの傳の書は是なり神人を創造りたまひし日に神に象りて之を造りたまひ"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 2,
    "text": "彼等を男女に造りたまへり彼等の創造られし日に神彼等を祝してかれらの名をアダムと名けたまへり"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 3,
    "text": "アダム百三十歳に及びて其像に循ひ己に象りて子を生み其名をセツと名けたり"
  },
  {
    "bookId": 1,
    "chapterId": 5,
