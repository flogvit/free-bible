[
  {
    "bookId": 1,
    "chapterId": 7,
    "verseId": 1,
    "text": "ヱホバ、ノアに言たまひけるは汝と汝の家皆方舟に入べし我汝がこの世の人の中にてわが前に義を視たればなり"
  },
  {
    "bookId": 1,
    "chapterId": 7,
    "verseId": 2,
    "text": "諸の潔き獸を牝牡七宛汝の許に取り潔らぬ獸を牝牡二"
  },
  {
    "bookId": 1,
    "chapterId": 7,
    "verseId": 3,
    "text": "亦天空の鳥を雌雄七宛取て種を全地の面に生のこらしむべし"
  },
  {
    "bookId": 1,
    "chapterId": 7,
    "verseId": 4,
    "text": "今七日ありて我四十日四十夜地に雨ふらしめ我造りたる萬有を地の面より拭去ん"
  },
  {
    "bookId": 1,
    "chapterId": 7,
    "verseId": 5,
    "text": "ノア、ヱホバの凡て己に命じたまひし如くなせり"
  },
  {
    "bookId": 1,
    "chapterId": 7,
    "verseId": 6,
    "text": "地に洪水ありける時にノア六百歳なりき"
  },
  {
    "bookId": 1,
    "chapterId": 7,
    "verseId": 7,
    "text": "ノア其子等と其妻および其子等の妻と倶に洪水を避て方舟にいりぬ"
  },
  {
    "bookId": 1,
    "chapterId": 7,
    "verseId": 8,
    "text": "潔き獸と潔らざる獸と鳥および地に匍ふ諸の物"
  },
  {
    "bookId": 1,
    "chapterId": 7,
    "verseId": 9,
    "text": "牝牡二宛ノアに來りて方舟にいりぬ神のノアに命じたまへるが如し"
  },
  {
    "bookId": 1,
    "chapterId": 7,
    "verseId": 10,
    "text": "かくて七日の後洪水地に臨めり"
  },
  {
    "bookId": 1,
    "chapterId": 7,
    "verseId": 11,
    "text": "ノアの齡の六百歳の二月即ち其月の十七日に當り此日に大淵の源皆潰れ天の戸開けて"
  },
  {
    "bookId": 1,
    "chapterId": 7,
    "verseId": 12,
    "text": "雨四十日四十夜地に注げり"
  },
  {
    "bookId": 1,
    "chapterId": 7,
    "verseId": 13,
    "text": "此日にノアとノアの子セム、ハム、ヤペテおよびノアの妻と其子等の三人の妻諸倶に方舟にいりぬ"
  },
  {
    "bookId": 1,
    "chapterId": 7,
    "verseId": 14,
    "text": "彼等および諸の獸其類に從ひ諸の家畜其類に從ひ都て地に匍ふ昆蟲其類に從ひ諸の禽即ち各樣の類の鳥皆其類に從ひて入りぬ"
  },
  {
    "bookId": 1,
    "chapterId": 7,
    "verseId": 15,
    "text": "即ち生命の氣息ある諸の肉なる者二宛ノアに來りて方舟にいりぬ"
  },
  {
    "bookId": 1,
    "chapterId": 7,
    "verseId": 16,
    "text": "入たる者は諸の肉なる者の牝牡にして皆いりぬ神の彼に命じたまへるが如しヱホバ乃ち彼を閉置たまへり"
  },
  {
    "bookId": 1,
    "chapterId": 7,
    "verseId": 17,
    "text": "洪水四十日地にありき是において水増し方舟を浮めて方舟地の上に高くあがれり"
  },
  {
    "bookId": 1,
    "chapterId": 7,
    "verseId": 18,
    "text": "而して水瀰漫りて大に地に増しぬ方舟は水の面に漂へり"
  },
  {
    "bookId": 1,
    "chapterId": 7,
    "verseId": 19,
    "text": "水甚大に地に瀰漫りければ天下の高山皆おほはれたり"
  },
  {
    "bookId": 1,
    "chapterId": 7,
    "verseId": 20,
    "text": "水はびこりて十五キユビトに上りければ山々おほはれたり"
  },
  {
    "bookId": 1,
    "chapterId": 7,
    "verseId": 21,
    "text": "凡そ地に動く肉なる者鳥家畜獸地に匍ふ諸の昆蟲および人皆死り"
  },
  {
    "bookId": 1,
    "chapterId": 7,
    "verseId": 22,
    "text": "即ち凡そ其鼻に生命の氣息のかよふ者都て乾土にある者は死り"
  },
  {
    "bookId": 1,
    "chapterId": 7,
    "verseId": 23,
    "text": "斯地の表面にある萬有を人より家畜昆蟲天空の鳥にいたるまで盡く拭去たまへり是等は地より拭去れたり唯ノアおよび彼とともに方舟にありし者のみ存れり"
  },
  {
    "bookId": 1,
    "chapterId": 7,
    "verseId": 24,
    "text": "水百五十日のあひだ地にはびこりぬ"
  }
]
