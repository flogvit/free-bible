[
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 1,
    "text": "イエスまた譬をもて答へて言ひ給ふ"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 2,
    "text": "『天國は己が子のために婚筵を設くる王のごとし。"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 3,
    "text": "婚筵に招きおきたる人々を迎へんとて僕どもを遺ししに、來るを肯はず。"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 4,
    "text": "復ほかの僕どもを遣すとて言ふ「招きたる人々に告げよ、視よ、晝餐は既に備りたり。我が牛も肥えたる畜も屠られて、凡ての物 備りたれば、婚筵に來れと」"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 5,
    "text": "然るに人々 顧みずして、或 者は己が畑に、或 者は己が商賣に往けり。"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 6,
    "text": "また他の者は僕を執へて、辱しめかつ殺したれば、"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 7,
    "text": "王 怒りて軍勢を遣し、かの兇行者を滅して其の町を燒きたり。"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 8,
    "text": "かくて僕どもに言ふ「婚筵は既に備りたれど、招きたる者どもは相應しからず。"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 9,
    "text": "されば汝ら街に往きて、遇ふほどの者を婚筵に招け」"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 10,
    "text": "僕ども途に出でて、善きも惡しきも遇ふほどの者をみな集めたれば、婚禮の席は客にて滿てり。"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 11,
    "text": "王、客を見んとて入り來り、一人の禮服を著けぬ者あるを見て、"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 12,
    "text": "之に言ふ「友よ、如何なれば禮服を著けずして此處に入りたるか」かれ默しゐたり。"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 13,
    "text": "ここに王、侍者らに言ふ「その手 足を縛りて外の暗黒に投げいだせ、其處にて哀哭・切齒することあらん」"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 14,
    "text": "それ招かるる者は多かれど、選ばるる者は少し』"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 15,
    "text": "ここにパリサイ人ら出でて、如何にしてかイエスを言の羂に係けんと相 議り、"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 16,
    "text": "その弟子らをヘロデ黨の者どもと共に遺して言はしむ『師よ、我らは知る、なんじは眞にして、眞をもて神の道を教へ、かつ誰をも憚りたまふ事なし、人の外貌を見 給はぬ故なり。"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 17,
    "text": "されば我らに告げたまへ、貢をカイザルに納むるは可きか、惡しきか、如何に思ひたまふ』"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 18,
    "text": "イエスその邪曲なるを知りて言ひたまふ『僞善者よ、なんぞ我を試むるか。"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 19,
    "text": "貢の金を我に見せよ』彼らデナリ一つを持ち來る。"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 20,
    "text": "イエス言ひ給ふ『これは誰の像、たれの號なるか』"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 21,
    "text": "彼ら言ふ『カイザルのなり』ここに彼らに言ひ給ふ『さらばカイザルの物はカイザルに、神の物は神に納めよ』"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 22,
    "text": "彼ら之を聞きて怪しみ、イエスを離れて去り往けり。"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 23,
    "text": "復活なしといふサドカイ人ら、その日みもとに來り問ひて言ふ"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 24,
    "text": "『師よ、モーセは「人もし子なくして死なば、其の兄弟かれの妻を娶りて、兄弟のために世嗣を擧ぐべし」と云へり。"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 25,
    "text": "我らの中に七人の兄弟ありしが、兄めとりて死に、世嗣なくして其の妻を弟に遺したり。"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 26,
    "text": "その二その三より、その七まで皆かくの如く爲し、"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 27,
    "text": "最後にその女も死にたり。"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 28,
    "text": "されば復活の時、その女は七人のうち誰の妻たるべきか、彼ら皆これを妻としたればなり』"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 29,
    "text": "イエス答へて言ひ給ふ『なんぢら聖書をも神の能力をも知らぬ故に誤れり。"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 30,
    "text": "それ人よみがへりの時は、娶らず嫁がず、天に在る御使たちの如し。"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 31,
    "text": "死人の復活に就きては、神なんぢらに告げて、"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 32,
    "text": "「我はアブラハムの神、イサクの神、ヤコブの神なり」と言ひ給へることを未だ讀まぬか。神は死にたる者の神にあらず、生ける者の神なり』"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 33,
    "text": "群衆これを聞きて其の教に驚けり。"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 34,
    "text": "パリサイ人ら、イエスのサドカイ人らを默さしめ給ひしことを聞きて相 集り、"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 35,
    "text": "その中なる一人の教法師、イエスを試むる爲に問ふ"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 36,
    "text": "『師よ、律法のうち孰の誡命が大なる』"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 37,
    "text": "イエス言ひ給ふ『「なんぢ心を盡し、精神を盡し、思を盡して主なる汝の神を愛すべし」"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 38,
    "text": "これは大にして第一の誡命なり。"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 39,
    "text": "第二もまた之にひとし「おのれの如くなんぢの隣を愛すべし」"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 40,
    "text": "律法 全體と預言者とは此の二つの誡命に據るなり』"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 41,
    "text": "パリサイ人らの集りたる時、イエス彼らに問ひて言ひ給ふ"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 42,
    "text": "『なんぢらはキリストに就きて如何に思ふか、誰の子なるか』かれら言ふ『ダビデの子なり』"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 43,
    "text": "イエス言ひ給ふ『さらばダビデ御靈に感じて何 故かれを主と稱ふるか。曰く"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 44,
    "text": "「主わが主に言ひ給ふ、われ汝の敵を汝の足の下に置くまでは、我が右に坐せよ」"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 45,
    "text": "斯くダビデ彼を主と稱ふれば、爭でその子ならんや』"
  },
  {
    "bookId": 40,
    "chapterId": 22,
    "verseId": 46,
    "text": "誰も一言だに答ふること能はず、その日より敢へて復イエスに問ふ者なかりき。"
  }
]
