[
  {
    "bookId": 19,
    "chapterId": 130,
    "verseId": 1,
    "text": "ああヱホバよわれふかき淵より汝をよべり"
  },
  {
    "bookId": 19,
    "chapterId": 130,
    "verseId": 2,
    "text": "主よねがはくはわが聲をきき汝のみみをわが懇求のこゑにかたぶけたまへ"
  },
  {
    "bookId": 19,
    "chapterId": 130,
    "verseId": 3,
    "text": "ヤハよ主よなんぢ若もろもろの不義に目をとめたまはば誰たれかよく立ことをえんや"
  },
  {
    "bookId": 19,
    "chapterId": 130,
    "verseId": 4,
    "text": "されどなんぢに赦あれば人におそれかしこまれ給ふべし"
  },
  {
    "bookId": 19,
    "chapterId": 130,
    "verseId": 5,
    "text": "我ヱホバを俟望む わが霊魂はまちのぞむ われはその聖言によりて望をいだく"
  },
  {
    "bookId": 19,
    "chapterId": 130,
    "verseId": 6,
    "text": "わがたましひは衛士があしたを待にまさり 誠にゑじが旦をまつにまさりて主をまてり"
  },
  {
    "bookId": 19,
    "chapterId": 130,
    "verseId": 7,
    "text": "イスラエルよヱホバによりて望をいだけ そはヱホバにあはれみあり またゆたかなる救贖あり"
  },
  {
    "bookId": 19,
    "chapterId": 130,
    "verseId": 8,
    "text": "ヱホバはイスラエルをそのもろもろの邪曲よりあがなひたまはん"
  }
]
