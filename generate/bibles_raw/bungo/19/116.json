[
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 1,
    "text": "われヱホバを愛しむ そはわが聲とわが願望とをききたまへばなり"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 2,
    "text": "ヱホバみみを我にかたぶけたまひしが故に われ世にあらんかぎりヱホバを呼まつらむ"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 3,
    "text": "死の繩われをまとひ陰府のくるしみ我にのぞめり われは患難とうれへとにあへり"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 4,
    "text": "その時われヱホバの名をよべり ヱホバよ願くはわが霊魂をすくひたまへと"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 5,
    "text": "ヱホバは恩惠ゆたかにして公義ましませり われらの神はあはれみ深し"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 6,
    "text": "ヱホバは愚かなるものを護りたまふ われ卑くせられしがヱホバ我をすくひたまへり"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 7,
    "text": "わが霊魂よなんぢの平安にかへれ ヱホバは豊かになんぢを待ひたまへばなり"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 8,
    "text": "汝はわがたましひを死より わが目をなみだより わが足を顛蹶よりたすけいだしたまひき"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 9,
    "text": "われは活るものの國にてヱホバの前にあゆまん"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 10,
    "text": "われ大になやめりといひつつもなほ信じたり"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 11,
    "text": "われ惶てしときに云らく すべての人はいつはりなりと"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 12,
    "text": "我いかにしてその賜へるもろもろの恩惠をヱホバにむくいんや"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 13,
    "text": "われ救のさかづきをとりてヱホバの名をよびまつらむ"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 14,
    "text": "我すべての民のまへにてヱホバにわが誓をつくのはん"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 15,
    "text": "ヱホバの聖徒の死はそのみまへにて貴とし"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 16,
    "text": "ヱホバよ誠にわれはなんぢの僕なり われはなんぢの婢女の子にして汝のしもべなり なんぢわが縲絏をときたまへり"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 17,
    "text": "われ感謝をそなへものとして汝にささげん われヱホバの名をよばん"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 18,
    "text": "我すべての民のまへにてヱホバにわがちかひを償はん"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 19,
    "text": "ヱルサレムよ汝のなかにてヱホバのいへの大庭のなかにて此をつくのふべし ヱホバを讃まつれ"
  }
]
