[
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 1,
    "text": "おのが道をなほくしてヱホバの律法をあゆむ者はさいはひなり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 2,
    "text": "ヱホバのもろもろの證詞をまもり 心をつくしてヱホバを尋求むるものは福ひなり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 3,
    "text": "かかる人は不義をおこなはずしてヱホバの道をあゆむなり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 4,
    "text": "ヱホバよなんぢ訓諭をわれらに命じてねんごろに守らせたまふ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 5,
    "text": "なんぢわが道をかたくたててその律法をまもらせたまはんことを"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 6,
    "text": "われ汝のもろもろの誡命にこころをとむるときは恥ることあらじ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 7,
    "text": "われ汝のただしき審判をまなばば 直き心をもてなんぢに感謝せん"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 8,
    "text": "われは律法をまもらん われを棄はてたまふなかれ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 9,
    "text": "わかき人はなにによりてかその道をきよめん 聖言にしたがひて愼むのほかぞなき"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 10,
    "text": "われ心をつくして汝をたづねもとめたり 願くはなんぢの誡命より迷ひいださしめ給ふなかれ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 11,
    "text": "われ汝にむかひて罪ををかすまじき爲になんぢの言をわが心のうちに蔵へたり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 12,
    "text": "讃べきかなヱホバよねがはくは律法をわれに敎へたまへ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 13,
    "text": "われわが口唇をもてなんぢの口よりいでしもろもろの審判をのべつたへたり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 14,
    "text": "我もろもろの財貨をよろこぶごとくに汝のあかしの道をよろこべり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 15,
    "text": "我なんぢの訓諭をおもひ汝のみちに心をとめん"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 16,
    "text": "われは律法をよろこび聖言をわするることなからん"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 17,
    "text": "ねがはくは汝のしもべを豊にあしらひて存へしめたまへ さらばわれ聖言をまもらん"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 18,
    "text": "なんぢわが眼をひらき なんぢの法のうちなる奇しきことを我にみせたまへ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 19,
    "text": "われは世にある旅客なり 我になんぢの誡命をかくしたまふなかれ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 20,
    "text": "斷るときなくなんぢの審判をしたふが故にわが霊魂はくだくるなり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 21,
    "text": "汝はたかぶる者をせめたまへり なんぢの誡命よりまよひづる者はのろはる"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 22,
    "text": "我なんぢの證詞をまもりたり 我より謗とあなどりとを取去たまへ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 23,
    "text": "又もろもろの侯は坐して相語りわれをそこなはんとせり 然はあれど汝のしもべは律法をふかく思へり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 24,
    "text": "汝のもろもろの證詞はわれをよろこばせわれをさとす者なり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 25,
    "text": "わが霊魂は塵につきぬ なんぢの言にしたがひて我をいかしたまへ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 26,
    "text": "我わがふめる道をあらはししかば汝こたへを我になしたまへり なんぢの律法をわれに敎へたまへ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 27,
    "text": "なんぢの訓諭のみちを我にわきまへしめたまへ われ汝のくすしき事跡をふかく思はん"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 28,
    "text": "わがたましひ痛めるによりてとけゆく ねがはくは聖言にしたがひて我にちからを予へたまへ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 29,
    "text": "願くはいつはりの道をわれより遠ざけ なんぢの法をもて我をめぐみたまへ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 30,
    "text": "われは眞實のみちをえらび 恒になんぢのもろもろの審判をわが前におけり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 31,
    "text": "我なんぢの證詞をしたひて離れず ヱホバよねがはくは我をはづかしめ給ふなかれ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 32,
    "text": "われ汝のいましめの道をはしらん その時なんぢわが心をひろく爲たまふべし"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 33,
    "text": "ヱホバよ願くはなんぢの律法のみちを我にをしへたまへ われ終にいたるまで之をまもらん"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 34,
    "text": "われに智慧をあたへ給へ さらば我なんぢの法をまもり心をつくして之にしたがはん"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 35,
    "text": "われに汝のいましめの道をふましめたまへ われその道をたのしめばなり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 36,
    "text": "わが心をなんぢの證詞にかたぶかしめて 貪利にかたぶかしめ給ふなかれ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 37,
    "text": "わが眼をほかにむけて虚しきことを見ざらしめ 我をなんぢの途にて活し給へ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 38,
    "text": "ひたすらに汝をおそるる汝のしもべに 聖言をかたくしたまへ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 39,
    "text": "わがおそるる謗をのぞきたまへ そはなんぢの審判はきはめて善し"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 40,
    "text": "我なんぢの訓諭をしたへり 願くはなんぢの義をもて我をいかしたまへ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 41,
    "text": "ヱホバよ聖言にしたがひてなんぢの憐憫なんぢの拯救を我にのぞませたまへ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 42,
    "text": "さらば我われを謗るものに答ふることをえん われ聖言によりたのめばなり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 43,
    "text": "又わが口より眞理のことばをことごとく除き給ふなかれ われなんぢの審判をのぞみたればなり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 44,
    "text": "われたえずいや永久になんぢの法をまもらん"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 45,
    "text": "われなんぢの訓諭をもとめたるにより障なくしてあゆまん"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 46,
    "text": "われまた王たちの前になんぢの證詞をかたりて恥ることあらじ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 47,
    "text": "我わが愛するなんぢの誡命をもて己をたのしましめん"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 48,
    "text": "われ手をわがあいする汝のいましめに擧げ なんぢの律法をふかく思はん"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 49,
    "text": "ねがはくは汝のしもべに宣ひたる聖言をおもひいだしたまへ 汝われに之をのぞましめ給へり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 50,
    "text": "なんぢの聖言はわれを活ししがゆゑに 今もなほわが艱難のときの安慰なり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 51,
    "text": "高ぶる者おほいに我をあざわらへり されど我なんぢの法をはなれざりき"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 52,
    "text": "ヱホバよわれ汝がふるき往昔よりの審判をおもひいだして自から慰めたり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 53,
    "text": "なんぢの法をすつる惡者のゆゑによりて 我はげしき怒をおこしたり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 54,
    "text": "なんぢの律法はわが旅の家にてわが歌となれり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 55,
    "text": "ヱホバよわれ夜間になんぢの名をおもひいだして なんぢの法をまもれり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 56,
    "text": "われ汝のさとしを守りしによりてこの事をえたるなり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 57,
    "text": "ヱホバはわがうくべき有なり われ汝のもろもろの言をまもらんといへり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 58,
    "text": "われ心をつくして汝のめぐみを請求めたり ねがはくは聖言にしたがひて我をあはれみたまへ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 59,
    "text": "我わがすべての途をおもひ 足をかへしてなんぢの證詞にむけたり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 60,
    "text": "我なんぢの誡命をまもるに速けくしてたゆたはざりき"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 61,
    "text": "惡きものの繩われに纏ひたれども 我なんぢの法をわすれざりき"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 62,
    "text": "我なんぢのただしき審判のゆゑに 夜半におきてなんぢに感謝せん"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 63,
    "text": "われは汝をおそるる者 またなんぢの訓諭をまもるものの侶なり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 64,
    "text": "ヱホバよ汝のあはれみは地にみちたり 願くはなんぢの律法をわれにをしへたまへ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 65,
    "text": "ヱホバよなんぢ聖言にしたがひ惠をもてその僕をあしらひたまへり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 66,
    "text": "われ汝のいましめを信ず ねがはくはわれに聡明と智識とををしへたまへ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 67,
    "text": "われ苦しまざる前にはまよひいでぬ されど今はわれ聖言をまもる"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 68,
    "text": "なんぢは善にして善をおこなひたまふ ねがはくは汝のおきてを我にをしへたまへ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 69,
    "text": "高ぶるもの虚偽をくはだてて我にさからへり われ心をつくしてなんぢの訓諭をまもらん"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 70,
    "text": "かれらの心はこえふとりて脂のごとし されど我はなんぢの法をたのしむ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 71,
    "text": "困苦にあひたりしは我によきことなり 此によりて我なんぢの律法をまなびえたり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 72,
    "text": "なんぢの口の法はわがためには千々のこがね白銀にもまされり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 73,
    "text": "なんぢの手はわれを造りわれを形づくれり ねがはくは智慧をあたへて我になんぢの誡命をまなばしめたまへ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 74,
    "text": "なんぢを畏るるものは我をみて喜ばん われ聖言によりて望をいたきたればなり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 75,
    "text": "ヱホバよ我はなんぢの審判のただしく又なんぢが眞實をもて我をくるしめたまひしを知る"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 76,
    "text": "ねがはくは汝のしもべに宣ひたる聖言にしたがひて 汝の仁慈をわが安慰となしたまへ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 77,
    "text": "なんぢの憐憫をわれに臨ませたまへ さらばわれ生ん なんぢの法はわが樂しめるところなり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 78,
    "text": "高ぶるものに恥をかうぷらせたまへ かれらは虚偽をもて我をくつがへしたればなり されど我なんぢの訓諭をふかくおもはん"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 79,
    "text": "汝をおそるる者となんぢの證詞をしるものとを我にかへらしめたまへ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 80,
    "text": "わがこころを全くして汝のおきてを守らしめたまへ さらばわれ恥をかうぶらじ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 81,
    "text": "わが霊魂はなんぢの救をしたひてたえいるばかりなり 然どわれなほ聖言によりて望をいだく"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 82,
    "text": "なんぢ何のとき我をなぐさむるやといひつつ 我みことばを慕ふによりて眼おとろふ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 83,
    "text": "我は煙のなかの革嚢のごとくなりぬれども 尚なんぢの律法をわすれず"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 84,
    "text": "汝のしもべの日は幾何ありや 汝いづれのとき我をせむるものに審判をおこなひたまふや"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 85,
    "text": "たかぶる者われを害はんとて阱をほれり かれらはなんぢの法にしたがはず"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 86,
    "text": "なんぢの誡命はみな眞實なり かれらは虚偽をもて我をせむ ねがはくは我をたすけたまへ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 87,
    "text": "かれらは地にてほとんど我をほろぼせり されど我はなんぢの訓諭をすてざりき"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 88,
    "text": "願くはなんぢの仁慈にしたがひて我をいかしたまへ 然ばわれ御口よりいづる證詞をまもらん"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 89,
    "text": "ヱホバよみことばは天にてとこしえに定まり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 90,
    "text": "なんぢの眞實はよろづ世におよぶ なんぢ地をかたく立たまへば地はつねにあり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 91,
    "text": "これらのものはなんぢの命令にしたがひ 恒にありて今日にいたる 萬のものは皆なんぢの僕なればなり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 92,
    "text": "なんぢの法わがたのしみとならざりしならば我はつひに患難のうちに滅びたるならん"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 93,
    "text": "われ恒になんぢの訓諭をわすれじ 汝これをもて我をいかしたまへばなり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 94,
    "text": "我はなんぢの有なりねがはくは我をすくひたまへ われ汝のさとしを求めたり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 95,
    "text": "惡きものは我をほろぼさんとして窺ひぬ われは唯なんぢのもろもろの證詞をおもはん"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 96,
    "text": "我もろもろの純全に限あるをみたり されど汝のいましめはいと廣し"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 97,
    "text": "われなんぢの法をいつくしむこといかばかりぞや われ終日これを深くおもふ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 98,
    "text": "なんぢの誡命はつねに我とともにありて 我をわが仇にまさりて慧からしむ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 99,
    "text": "我はなんぢの證詞をふかくおもふが故に わがすべての師にまさりて智慧おほし"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 100,
    "text": "我はなんぢの訓諭をまもるがゆゑに 老たる者にまさりて事をわきまふるなり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 101,
    "text": "われ聖言をまもらんために わが足をとどめてもろもろのあしき途にゆかしめず"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 102,
    "text": "なんぢ我ををしへたまひしによりて 我なんぢの審判をはなれざりき"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 103,
    "text": "みことばの滋味はわが腭にあまきこといかばかりぞや 蜜のわが口に甘きにまされり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 104,
    "text": "我なんぢの訓諭によりて智慧をえたり このゆゑに虚偽のすべての途をにくむ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 105,
    "text": "なんぢの聖言はわがあしの燈火わが路のひかりなり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 106,
    "text": "われなんぢのただしき審判をまもらんことをちかひ且かたくせり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 107,
    "text": "われ甚いたく苦しめり ヱホバよねがはくは聖言にしたがひて我をいかしたまヘ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 108,
    "text": "ヱホバよねがはくは誠意よりするわが口の献物をうけて なんぢの審判ををしへたまへ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 109,
    "text": "わが霊魂はつねに危険ををかす されど我なんぢの法をわすれず"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 110,
    "text": "あしき者わがために羂をまうけたり されどわれ汝のさとしより迷ひいでざりき"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 111,
    "text": "われ汝のもろもろの證詞をとこしへにわが嗣業とせり これらの證詞はわが心をよろこばしむ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 112,
    "text": "われ汝のおきてを終までとこしへに守らんとて之にこころを傾けたり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 113,
    "text": "われ二心のものをにくみ汝のおきてを愛しむ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 114,
    "text": "なんぢはわが匿るべき所わが盾なり われ聖言によりて望をいだく"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 115,
    "text": "惡きをなすものよ我をはなれされ われわが神のいましめを守らん"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 116,
    "text": "聖言にしたがひ我をささへて生存しめたまへ わが望につきて恥なからしめたまへ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 117,
    "text": "われを支へたまへ さらばわれ安けかるべし われ恒になんぢの律法にこころをそそがん"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 118,
    "text": "すべて律法よりまよひいづるものを汝かろしめたまへり かれらの欺詐はむなしければなり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 119,
    "text": "なんぢは地のすべての惡きものを渣滓のごとく除きさりたまふ この故にわれ汝のあかしを愛す"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 120,
    "text": "わが肉體なんぢを懼るるによりてふるふ 我はなんぢの審判をおそる"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 121,
    "text": "われは審判と公義とをおこなふ 我をすてて虐ぐるものに委ねたまふなかれ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 122,
    "text": "汝のしもべの中保となりて福祉をえしめたまへ 高ぶるものの我をしへたぐるを容したまふなかれ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 123,
    "text": "わが眼はなんぢの救となんぢのただしき聖言とをしたふによりておとろふ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 124,
    "text": "ねがはくはなんぢの憐憫にしたがひてなんぢの僕をあしらひ 我になんぢの律法ををしへたまへ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 125,
    "text": "我はなんぢの僕なり われに智慧をあたへてなんぢの證詞をしらしめたまへ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 126,
    "text": "彼等はなんぢの法をすてたり 今はヱホバのはたらきたまふべき時なり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 127,
    "text": "この故にわれ金よりもまじりなき金よりもまさりて汝のいましめを愛す"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 128,
    "text": "この故にもろもろのことに係るなんぢの一切のさとしを正しとおもふ 我すべてのいつはりの途をにくむ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 129,
    "text": "汝のあかしは妙なり かかるが故にわが霊魂これをまもる"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 130,
    "text": "聖言うちひらくれば光をはなちて 愚かなるものをさとからしむ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 131,
    "text": "我なんぢの誡命をしたふが故に わが口をひろくあけて喘ぎもとめたり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 132,
    "text": "ねがはくは聖名を愛するものに恒になしたまふごとく身をかへして我をあはれみたまへ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 133,
    "text": "聖言をもてわが歩履をととのへ もろもろの邪曲をわれに主たらしめたまふなかれ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 134,
    "text": "われを人のしへたげより贖ひたまへ さらばわれ訓諭をまもらん"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 135,
    "text": "ねがはくは聖顔をなんぢの僕のうへにてらし 汝のおきてを我にをしへ給へ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 136,
    "text": "人なんぢの法をまもらざるによりて わが眼のなみだ河のごとくに流る"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 137,
    "text": "ヱホバよなんぢは義しくなんぢの審判はなほし"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 138,
    "text": "汝ただしきと此上なき眞實とをもて その證詞を命じ給へり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 139,
    "text": "わが敵なんぢの聖言をわすれたるをもて わが熱心われをほろぼせり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 140,
    "text": "なんぢの聖言はいときよし 此故になんぢの僕はこれを愛す"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 141,
    "text": "われは微なるものにて人にあなどらるれども汝のさとしを忘れず"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 142,
    "text": "なんぢの義はとこしへの義なり汝ののりは眞理なり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 143,
    "text": "われ患難と憂とにかかれども 汝のいましめはわが喜樂なり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 144,
    "text": "なんぢの證詞はとこしへに義し ねがはくはわれに智慧をたまへ 我ながらふることを得ん"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 145,
    "text": "われ心をつくしてよばはれり ヱホバよ我にこたへたまへ 我なんぢの律法をまもらん"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 146,
    "text": "われ汝をよばはれり ねがはくはわれを救ひ給へ 我なんぢの證詞をまもらん"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 147,
    "text": "われ詰朝おきいでて呼はれり われ聖言によりて望をいだけり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 148,
    "text": "夜の更のきたらぬに先だち わが眼はさめて汝のみことばを深くおもふ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 149,
    "text": "ねがはくはなんぢの仁慈にしたがひてわが聲をききたまへ ヱホバよなんぢの審判にしたがひて我をいかしたまへ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 150,
    "text": "惡をおひもとむるものは我にちかづけり 彼等はなんぢの法にとほくはなる"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 151,
    "text": "ヱホバよ汝はわれに近くましませり なんぢのすべての誡命はまことなり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 152,
    "text": "われ早くよりなんぢの證詞によりて汝がこれを永遠にたてたまへることを知れり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 153,
    "text": "ねがはくはわが患難をみて我をすくひたまへ 我なんぢの法をわすれざればなり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 154,
    "text": "ねがはくはわが訟をあげつらひて我をあがなひ 聖言にしたがひて我をいかしたまへ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 155,
    "text": "すくひは惡きものより遠くはなる かれらはなんぢの律法をもとめざればなり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 156,
    "text": "ヱホバよなんぢの憐憫はおほいなり 願くはなんぢの審判にしたがひて我をいかしたまへ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 157,
    "text": "我をせむる者われに敵するものおほし 我なんぢの證詞をはなるることなかりき"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 158,
    "text": "虚偽をおこなふもの汝のみことばを守らざるにより 我かれらを見てうれへたり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 159,
    "text": "ねがはくはわが汝のさとしを愛すること幾何なるをかへりみたまへ ヱホバよなんぢの仁慈にしたがひて我をいかしたまへ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 160,
    "text": "なんぢのみことばの總計はまことなり 汝のただしき審判はとこしへにいたるまで皆たゆることなし"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 161,
    "text": "もろもろの侯はゆゑなくして我をせむ 然どわが心はただ汝のみことばを畏る"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 162,
    "text": "われ人のおほいなる掠物をえたるごとくに 汝のみことばをよろこぶ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 163,
    "text": "われ虚偽をにくみ之をいみきらへども 汝ののりを愛す"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 164,
    "text": "われ汝のただしき審判のゆゑをもて 一日に七次なんぢを讃稱ふ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 165,
    "text": "なんぢの法をあいするものには大なる平安あり かれらには躓礙をあたふる者なし"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 166,
    "text": "ヱホバよ我なんぢの救をのぞみ汝のいましめをおこなへり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 167,
    "text": "わが霊魂はなんぢの證詞をまもれり 我はいたく之をあいす"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 168,
    "text": "われなんぢの訓諭となんぢの證詞とをまもりぬ わがすべての道はみまへにあればなり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 169,
    "text": "ヱホバよ願くはわがよぶ聲をみまへにちかづけ 聖言にしたがひて我にちゑをあたへたまへ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 170,
    "text": "わが願をみまへにいたらせ 聖言にしたがひて我をたすけたまへ"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 171,
    "text": "わがくちびるは讃美をいだすべし 汝われに律法ををしへ給へばなり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 172,
    "text": "わが舌はみことばを謳ふべし なんぢの一切のいましめは義なればなり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 173,
    "text": "なんぢの手をつねにわが助となしたまへ われなんぢの訓諭をえらび用ゐたればなり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 174,
    "text": "ヱホバよ我なんぢの救をしたへり なんぢの法はわがたのしみなり"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 175,
    "text": "願くはわが霊魂をながらへしめたまへ さらば汝をほめたたへん 汝のさばきの我をたすけんことを"
  },
  {
    "bookId": 19,
    "chapterId": 119,
    "verseId": 176,
    "text": "われは亡はれたる羊のごとく迷ひいでぬ なんぢの僕をたづねたまへ われ汝のいましめを忘れざればなり"
  }
]
