[
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 1,
    "text": "ヱホバに感謝せよヱホバは恩惠ふかくその憐憫とこしへに絶ることなし"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 2,
    "text": "イスラエルは率いふべし その憐憫はとこしへにたゆることなしと"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 3,
    "text": "アロンの家はいざ言ふべし そのあはれみは永遠にたゆることなしと"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 4,
    "text": "ヱホバを畏るるものは率いふべし その憐憫はとこしへにたゆることなしと"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 5,
    "text": "われ患難のなかよりヱホバをよべば ヱホバこたへて我をひろき處におきたまへり"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 6,
    "text": "ヱホバわが方にいませばわれにおそれなし 人われに何をなしえんや"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 7,
    "text": "ヱホバはわれを助くるものとともに我がかたに坐す この故にわれを憎むものにつきての願望をわれ見ることをえん"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 8,
    "text": "ヱホバに依賴むは人にたよるよりも勝りてよし"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 9,
    "text": "ヱホバによりたのむはもろもろの侯にたよるよりも勝りてよし"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 10,
    "text": "もろもろの國はわれを圍めり われヱホバの名によりて彼等をほろぼさん"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 11,
    "text": "かれらは我をかこめり我をかこめりヱホバの名によりて彼等をほろぼさん"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 12,
    "text": "かれらは蜂のごとく我をかこめり かれらは荊の火のごとく消たり われはヱホバの名によりてかれらを滅さん"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 13,
    "text": "汝われを倒さんとしていたく剌つれど ヱホバわれを助けたまへり"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 14,
    "text": "ヱホバはわが力わが歌にしてわが救となりたまへり"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 15,
    "text": "歓喜とすくひとの聲はただしきものの幕屋にあり ヱホバのみぎの手はいさましき動作をなしたまふ"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 16,
    "text": "ヱホバのみぎの手はたかくあがりヱホバの右の手はいさましき動作をなしたまふ"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 17,
    "text": "われは死ることなからん 存へてヤハの事跡をいひあらはさん"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 18,
    "text": "ヤハはいたく我をこらしたまひしかど死には付したまはざりき"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 19,
    "text": "わがために義の門をひらけ 我そのうちにいりてヤハに感謝せん"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 20,
    "text": "こはヱホバの門なりただしきものはその内にいるべし"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 21,
    "text": "われ汝に感謝せん なんぢ我にこたへてわが救となりたまへばなり"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 22,
    "text": "工師のすてたる石はすみの首石となれり"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 23,
    "text": "これヱホバの成たまへる事にしてわれらの目にあやしとする所なり"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 24,
    "text": "これヱホバの設けたまへる日なり われらはこの日によろこびたのしまん"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 25,
    "text": "ヱホバよねがはくはわれらを今すくひたまへ ヱホバよねがはくは我儕をいま榮えしめたまヘ"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 26,
    "text": "ヱホバの名によりて來るものは福ひなり われらヱホバの家よりなんぢらを祝せり"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 27,
    "text": "ヱホバは神なり われらに光をあたへたまへり 繩をもて祭壇の角にいけにへをつなげ"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 28,
    "text": "なんぢはわが神なり我なんぢに感謝せん なんぢはわが神なり我なんぢを崇めまつらん"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 29,
    "text": "ヱホバにかんしやせよ ヱホバは恩惠ふかくその憐憫とこしへに絶ることなし"
  }
]
