[
  {
    "bookId": 19,
    "chapterId": 124,
    "verseId": 1,
    "text": "今イスラエルはいふべし ヱホバもしわれらの方にいまさず"
  },
  {
    "bookId": 19,
    "chapterId": 124,
    "verseId": 2,
    "text": "人々われらにさからひて起りたつとき ヱホバもし我儕のかたに在さざりしならんには"
  },
  {
    "bookId": 19,
    "chapterId": 124,
    "verseId": 3,
    "text": "かれらの怒のわれらにむかひておこりし時 われらを生るままにて呑しならん"
  },
  {
    "bookId": 19,
    "chapterId": 124,
    "verseId": 4,
    "text": "また水はわれらをおほひ 流はわれらの霊魂をうちこえ"
  },
  {
    "bookId": 19,
    "chapterId": 124,
    "verseId": 5,
    "text": "高ぶる水はわれらの霊魂をうちこえしならん"
  },
  {
    "bookId": 19,
    "chapterId": 124,
    "verseId": 6,
    "text": "ヱホバはほむべきかな我儕をかれらの歯にわたして噛くらはせたまはざりき"
  },
  {
    "bookId": 19,
    "chapterId": 124,
    "verseId": 7,
    "text": "我儕のたましひは捕鳥者のわなをのがるる鳥のごとくにのがれたり 羅はやぶれてわれらはのがれたり"
  },
  {
    "bookId": 19,
    "chapterId": 124,
    "verseId": 8,
    "text": "われらの助は天地をつくりたまへるヱホバの名にあり"
  }
]
