[
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 1,
    "text": "今イスラエルはいふべし彼等はしばしば我をわかきときより惱めたり"
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 2,
    "text": "かれらはしばしば我をわかきときより惱めたり されどわれに勝ことを得ざりき"
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 3,
    "text": "耕すものはわが背をたがへしてその畎をながくせり"
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 4,
    "text": "ヱホバは義し あしきものの繩をたちたまへり"
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 5,
    "text": "シオンをにくむ者はみな恥をおびてしりぞかせらるべし"
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 6,
    "text": "かれらは長たざるさきにかるる屋上の草のごとし"
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 7,
    "text": "これを刈るものはその手にみたず 之をつかぬるものはその束ふところに盈ざるなり"
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 8,
    "text": "かたはらを過るものはヱホバの惠なんぢの上にあれといはず われらヱホバの名によりてなんぢらを祝すといはず"
  }
]
