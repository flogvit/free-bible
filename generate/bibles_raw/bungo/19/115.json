[
  {
    "bookId": 19,
    "chapterId": 115,
    "verseId": 1,
    "text": "ヱホバよ榮光をわれらに歸するなかれ われらに歸するなかれ なんぢのあはれみと汝のまこととの故によりてただ名にのみ歸したまへ"
  },
  {
    "bookId": 19,
    "chapterId": 115,
    "verseId": 2,
    "text": "もろもろの國人はいかなればいふ 今かれらの神はいづくにありやと"
  },
  {
    "bookId": 19,
    "chapterId": 115,
    "verseId": 3,
    "text": "然どわれらの神は天にいます 神はみこころのままにすべての事をおこなひ給へり"
  },
  {
    "bookId": 19,
    "chapterId": 115,
    "verseId": 4,
    "text": "かれらの偶像はしろかねと金にして人の手のわざなり"
  },
  {
    "bookId": 19,
    "chapterId": 115,
    "verseId": 5,
    "text": "その偶像は口あれどいはず目あれどみず"
  },
  {
    "bookId": 19,
    "chapterId": 115,
    "verseId": 6,
    "text": "耳あれどきかず鼻あれどかがず"
  },
  {
    "bookId": 19,
    "chapterId": 115,
    "verseId": 7,
    "text": "手あれどとらず脚あれどあゆまず喉より聲をいだすことなし"
  },
  {
    "bookId": 19,
    "chapterId": 115,
    "verseId": 8,
    "text": "此をつくる者とこれに依賴むものとは皆これにひとしからん"
  },
  {
    "bookId": 19,
    "chapterId": 115,
    "verseId": 9,
    "text": "イスラエルよなんぢヱホバに依賴め ヱホバはかれらの助かれらの盾なり"
  },
  {
    "bookId": 19,
    "chapterId": 115,
    "verseId": 10,
    "text": "アロンの家よなんぢらヱホバによりたのめ ヱホバはかれらの助かれらの盾なり"
  },
  {
    "bookId": 19,
    "chapterId": 115,
    "verseId": 11,
    "text": "ヱホバを畏るるものよヱホバに依賴め ヱホバはかれらの助かれらの盾なり"
  },
  {
    "bookId": 19,
    "chapterId": 115,
    "verseId": 12,
    "text": "ヱホバは我儕をみこころに記たまへり われらを惠みイスラエルの家をめぐみアロンのいへをめぐみ"
  },
  {
    "bookId": 19,
    "chapterId": 115,
    "verseId": 13,
    "text": "また小なるも大なるもヱホバをおそるる者をめぐみたまはん"
  },
  {
    "bookId": 19,
    "chapterId": 115,
    "verseId": 14,
    "text": "願くはヱホバなんぢらを増加へ なんぢらとなんぢらの子孫とをましくはへ給はんことを"
  },
  {
    "bookId": 19,
    "chapterId": 115,
    "verseId": 15,
    "text": "なんぢらは天地をつくりたまへるヱホバに惠まるる者なり"
  },
  {
    "bookId": 19,
    "chapterId": 115,
    "verseId": 16,
    "text": "天はヱホバの天なり されど地は人の子にあたへたまへり"
  },
  {
    "bookId": 19,
    "chapterId": 115,
    "verseId": 17,
    "text": "死人も幽寂ところに下れるものもヤハを讃稱ふることなし"
  },
  {
    "bookId": 19,
    "chapterId": 115,
    "verseId": 18,
    "text": "然どわれらは今より永遠にいたるまでヱホバを讃まつらむ 汝等ヱホバをほめたたへよ"
  }
]
