[
  {
    "bookId": 19,
    "chapterId": 114,
    "verseId": 1,
    "text": "イスラエルの民エジプトをいで ヤコブのいへ異言の民をはなれしとき"
  },
  {
    "bookId": 19,
    "chapterId": 114,
    "verseId": 2,
    "text": "ユダはヱホバの聖所となりイスラエルはヱホバの所領となれり"
  },
  {
    "bookId": 19,
    "chapterId": 114,
    "verseId": 3,
    "text": "海はこれを見てにげヨルダンは後にしりぞき"
  },
  {
    "bookId": 19,
    "chapterId": 114,
    "verseId": 4,
    "text": "山は牡羊のごとくをどり小山はこひつじのごとく躍れり"
  },
  {
    "bookId": 19,
    "chapterId": 114,
    "verseId": 5,
    "text": "海よなんぢ何とてにぐるやヨルダンよなんぢ何とて後にしりぞくや"
  },
  {
    "bookId": 19,
    "chapterId": 114,
    "verseId": 6,
    "text": "山よなにとて牡羊のごとくをどるや小山よなにとて小羊のごとく躍るや"
  },
  {
    "bookId": 19,
    "chapterId": 114,
    "verseId": 7,
    "text": "地よ主のみまへヤコブの神の前にをののけ"
  },
  {
    "bookId": 19,
    "chapterId": 114,
    "verseId": 8,
    "text": "主はいはを池にかはらせ石をいづみに變らせたまへり"
  }
]
