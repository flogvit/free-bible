[
  {
    "bookId": 19,
    "chapterId": 120,
    "verseId": 1,
    "text": "われ困苦にあひてヱホバをよびしかば我にこたへたまへり"
  },
  {
    "bookId": 19,
    "chapterId": 120,
    "verseId": 2,
    "text": "ヱホバよねがはくは虚偽のくちびる欺詐の舌よりわが霊魂をたすけいだしたまへ"
  },
  {
    "bookId": 19,
    "chapterId": 120,
    "verseId": 3,
    "text": "あざむきの舌よなんぢに何をあたへられ 何をくはへらるべきか"
  },
  {
    "bookId": 19,
    "chapterId": 120,
    "verseId": 4,
    "text": "ますらをの利き箭と金萑花のあつき炭となり"
  },
  {
    "bookId": 19,
    "chapterId": 120,
    "verseId": 5,
    "text": "わざはひなるかな我はメセクにやどりケダルの幕屋のかたはらに住めり"
  },
  {
    "bookId": 19,
    "chapterId": 120,
    "verseId": 6,
    "text": "わがたましひは平安をにくむものと偕にすめり"
  },
  {
    "bookId": 19,
    "chapterId": 120,
    "verseId": 7,
    "text": "われは平安をねがふ されど我ものいふときにかれら戰爭をこのむ"
  }
]
