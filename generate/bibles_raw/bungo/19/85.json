[
  {
    "bookId": 19,
    "chapterId": 85,
    "verseId": 1,
    "text": "ヱホバよなんぢは御國にめぐみをそそぎたまへり なんぢヤコブの俘囚をかへしたまひき"
  },
  {
    "bookId": 19,
    "chapterId": 85,
    "verseId": 2,
    "text": "なんぢおのが民の不義をゆるしそのもろもろの罪をおほひたまひき セラ"
  },
  {
    "bookId": 19,
    "chapterId": 85,
    "verseId": 3,
    "text": "汝すべての怒をすてその烈しきいきどほりを遠けたまへり"
  },
  {
    "bookId": 19,
    "chapterId": 85,
    "verseId": 4,
    "text": "われらのすくひの神よかへりきたり我儕にむかひて忿怒をやめたまへ"
  },
  {
    "bookId": 19,
    "chapterId": 85,
    "verseId": 5,
    "text": "なんぢ永遠にわれらをいかり萬世にみいかりをひきのべたまふや"
  },
  {
    "bookId": 19,
    "chapterId": 85,
    "verseId": 6,
    "text": "汝によりてなんぢの民の喜悦をえんが爲に我儕を活したまはざるか"
  },
  {
    "bookId": 19,
    "chapterId": 85,
    "verseId": 7,
    "text": "ヱホバよなんぢの憐憫をわれらにしめし汝のすくひを我儕にあたへたまへ"
  },
  {
    "bookId": 19,
    "chapterId": 85,
    "verseId": 8,
    "text": "わが神ヱホバのいたりたまふ事をきかん ヱホバはその民その聖徒に平和をかたりたまへばなり さればかれらは愚かなる行爲にふたたび歸るなかれ"
  },
  {
    "bookId": 19,
    "chapterId": 85,
    "verseId": 9,
    "text": "實にそのすくひは神をおそるる者にちかし かくて榮光はわれらの國にとどまらん"
  },
  {
    "bookId": 19,
    "chapterId": 85,
    "verseId": 10,
    "text": "あはれみと眞實とともにあひ義と平和とたがひに接吻せり"
  },
  {
    "bookId": 19,
    "chapterId": 85,
    "verseId": 11,
    "text": "まことは地よりはえ義は天よりみおろせり"
  },
  {
    "bookId": 19,
    "chapterId": 85,
    "verseId": 12,
    "text": "ヱホバ善物をあたへたまへばわれらの國は物產をいださん"
  },
  {
    "bookId": 19,
    "chapterId": 85,
    "verseId": 13,
    "text": "義はヱホバのまへにゆきヱホバのあゆみたまふ跡をわれに踏しめん"
  }
]
