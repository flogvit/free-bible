[
  {
    "bookId": 19,
    "chapterId": 135,
    "verseId": 1,
    "text": "なんぢらヱホバを讃稱へよ ヱホバの名をほめたたへよ ヱホバの僕等ほめたたへよ"
  },
  {
    "bookId": 19,
    "chapterId": 135,
    "verseId": 2,
    "text": "ヱホバの家われらの神のいへの大庭にたつものよ讃稱へよ"
  },
  {
    "bookId": 19,
    "chapterId": 135,
    "verseId": 3,
    "text": "ヱホバは惠ふかし なんぢらヱホバをほめたたへよ その聖名はうるはし讃うたへ"
  },
  {
    "bookId": 19,
    "chapterId": 135,
    "verseId": 4,
    "text": "そはヤハおのがためにヤコブをえらみ イスラエルをえらみてその珍寳となしたまへり"
  },
  {
    "bookId": 19,
    "chapterId": 135,
    "verseId": 5,
    "text": "われヱホバの大なるとわれらの主のもろもろの神にまされるとをしれり"
  },
  {
    "bookId": 19,
    "chapterId": 135,
    "verseId": 6,
    "text": "ヱホバその聖旨にかなふことを天にも地にも海にも淵にもみなことごとく行ひ給ふなり"
  },
  {
    "bookId": 19,
    "chapterId": 135,
    "verseId": 7,
    "text": "ヱホバは地のはてより霧をのぼらせ 雨のために電光をつくりその庫より風をいだしたまふ"
  },
  {
    "bookId": 19,
    "chapterId": 135,
    "verseId": 8,
    "text": "ヱホバは人より畜類にいたるまでエジプトの首出をうちたまへり"
  },
  {
    "bookId": 19,
    "chapterId": 135,
    "verseId": 9,
    "text": "エジプトよヱホバはなんぢの中にしるしと奇しき事跡とをおくりて パロとその僕とに臨ませ給へり"
  },
  {
    "bookId": 19,
    "chapterId": 135,
    "verseId": 10,
    "text": "ヱホバはおほくの國々をうち 又いきほひある王等をころし給へり"
  },
  {
    "bookId": 19,
    "chapterId": 135,
    "verseId": 11,
    "text": "アモリ人のわうシホン、バシヤンの王オグならびにカナンの國々なり"
  },
  {
    "bookId": 19,
    "chapterId": 135,
    "verseId": 12,
    "text": "かれらの地をゆづりとしその民イスフルの嗣業としてあたへ給へり"
  },
  {
    "bookId": 19,
    "chapterId": 135,
    "verseId": 13,
    "text": "ヱホバよなんぢの名はとこしへに絶ることなし ヱホバよなんぢの記念はよろづ世におよばん"
  },
  {
    "bookId": 19,
    "chapterId": 135,
    "verseId": 14,
    "text": "ヱホバはその民のために審判をなしその僕等にかかはれる聖意をかへたまふ可ればなり"
  },
  {
    "bookId": 19,
    "chapterId": 135,
    "verseId": 15,
    "text": "もろもろのくにの偶像はしろかねと金にして人の手のわざなり"
  },
  {
    "bookId": 19,
    "chapterId": 135,
    "verseId": 16,
    "text": "そのぐうざうは口あれどいはず目あれど見ず"
  },
  {
    "bookId": 19,
    "chapterId": 135,
    "verseId": 17,
    "text": "耳あれどきかず またその口に氣息あることなし"
  },
  {
    "bookId": 19,
    "chapterId": 135,
    "verseId": 18,
    "text": "これを造るものと之によりたのむものとは皆これにひとしからん"
  },
  {
    "bookId": 19,
    "chapterId": 135,
    "verseId": 19,
    "text": "イスラエルの家よヱホバをほめまつれ アロンのいへよヱホバをほめまつれ"
  },
  {
    "bookId": 19,
    "chapterId": 135,
    "verseId": 20,
    "text": "レビの家よヱホバをほめまつれ ヱホバを畏るるものよヱホバをほめまつれ"
  },
  {
    "bookId": 19,
    "chapterId": 135,
    "verseId": 21,
    "text": "ヱルサレムにすみたまふヱホバはシオンにて讃まつるべきかな ヱホバをほめたたへよ"
  }
]
