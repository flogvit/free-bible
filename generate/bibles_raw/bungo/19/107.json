[
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 1,
    "text": "ヱホバに感謝せよ ヱホバは惠ふかくましましてその憐憫かぎりなし"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 2,
    "text": "ヱホバの救贖をかうぶる者はみな然いふべきなり"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 3,
    "text": "ヱホバは敵の手よりかれらを贖ひもろもろの地よ東西北南よりとりあつめたまへり"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 4,
    "text": "かれら野にてあれはてたる路にさまよひその住ふべき邑にあはざりき"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 5,
    "text": "かれら饑また渇きそのうちの霊魂おとろへたり"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 6,
    "text": "斯てその困苦のうちにてヱホバをよばはりたればヱホバこれを患難よりたすけいだし"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 7,
    "text": "住ふべき邑にゆかしめんとて直き路にみちびきたまへり"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 8,
    "text": "願くはすべての人はヱホバの惠により人の子になしたまへる奇しき事跡によりてヱホバを讃稱へんことを"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 9,
    "text": "ヱホバは渇きしたふ霊魂をたらはせ饑たるたましひを嘉物にてあかしめ給へばなり"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 10,
    "text": "くらきと死の蔭とに居るもの患難とくろがねとに縛しめらるるもの"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 11,
    "text": "神の言にそむき至高者のをしへを蔑しめければ"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 12,
    "text": "勤勞をもてその心をひくうしたまへり かれら仆れたれど助くるものもなかりき"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 13,
    "text": "斯てその困苦のうちにてヱホバをよばはりたればヱホバこれを患難よりすくひ"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 14,
    "text": "くらきと死のかげより彼等をみちびき出してその械をこぼちたまへり"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 15,
    "text": "願くはすべての人はヱホバの惠により人の子になしたまへる奇しき事跡によりてヱホバを讃稱へんことを"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 16,
    "text": "そはあかがねの門をこぼち くろがねの關木をたちきりたまへり"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 17,
    "text": "愚かなる者はおのが愆の道により己がよこしまによりて惱めり"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 18,
    "text": "かれらの霊魂はすべての食物をきらひて死の門にちかづく"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 19,
    "text": "かくてその困苦のうちにてヱホバをよばふ ヱホバこれを患難よりすくひたまふ"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 20,
    "text": "その聖言をつかはして之をいやし之をその滅亡よりたすけいだしたまふ"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 21,
    "text": "願くはすべての人ヱホバのめぐみにより人の子になしたまへる奇しき事跡によりてヱホバをほめたたへんことを"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 22,
    "text": "かれらは感謝のそなへものをささげ喜びうたひてその事跡をいひあらはすべし"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 23,
    "text": "舟にて海にうかび大洋にて事をいとなむ者は"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 24,
    "text": "ヱホバのみわざを見また淵にてその奇しき事跡をみる"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 25,
    "text": "ヱホバ命じたまへばあらき風おこりてその浪をあぐ"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 26,
    "text": "かれら天にのぼりまた淵にくだり患難によりてその霊魂とけさり"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 27,
    "text": "左た右たにかたぶき酔たる者のごとく踉蹌てなす所をしらず"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 28,
    "text": "かくてその困苦のうちにてヱホバをよばふ ヱホバこれを患難よりたづさへいで"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 29,
    "text": "狂風をしづめて浪をおだやかになし給へり"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 30,
    "text": "かれらはおのが靜かなるをよろこぶ 斯てヱホバはかれらをその望むところの湊にみちびきたまふ"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 31,
    "text": "願くはすべての人ヱホバの惠により人の子になしたまへる奇しき事跡によりてヱホバをほめたたへんことを"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 32,
    "text": "かれら民の會にてこれをあがめ長老の座にてこれを讃稱ふべし"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 33,
    "text": "ヱホバは河を野にかはらせ泉をかわける地に變らせ"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 34,
    "text": "また豊かなる地にすめる民の惡によりてそこを鹵の地にかはらせ給ふ"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 35,
    "text": "野を池にかはらせ乾ける地をいづみにかはらせ"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 36,
    "text": "ここに餓たるものを住はせたまふ されば彼らは己がすまひの邑をたて"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 37,
    "text": "畠にたねをまき葡萄園をまうけてそのむすべる實をえたり"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 38,
    "text": "ヱホバはかれらの甚くふえひろごれるまでに惠をあたへ その牲畜のへることをも許したまはず"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 39,
    "text": "されどまた虐待くるしみ悲哀によりて減ゆき且うなたれたり"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 40,
    "text": "ヱホバもろもろの君に侮辱をそそぎ道なき荒地にさまよはせたまふ"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 41,
    "text": "然はあれど貧しきものを患難のうちより擧てその家族をひつじの群のごとくならしめたまふ"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 42,
    "text": "直きものは之をみて喜びもろもろの不義はその口をふさがん"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 43,
    "text": "すべて慧者はこれらのことに心をよせヱホバの憐憫をさとるべし"
  }
]
