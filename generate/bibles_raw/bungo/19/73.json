[
  {
    "bookId": 19,
    "chapterId": 73,
    "verseId": 1,
    "text": "神はイスラエルにむかひ心のきよきものに對ひてまことに惠あり"
  },
  {
    "bookId": 19,
    "chapterId": 73,
    "verseId": 2,
    "text": "然はあれどわれはわが足つまづくばかりわが歩すべるばかりにてありき"
  },
  {
    "bookId": 19,
    "chapterId": 73,
    "verseId": 3,
    "text": "こはわれ惡きものの榮ゆるを見てその誇れる者をねたみしによる"
  },
  {
    "bookId": 19,
    "chapterId": 73,
    "verseId": 4,
    "text": "かれらは死るに苦しみなくそのちからは反てかたし"
  },
  {
    "bookId": 19,
    "chapterId": 73,
    "verseId": 5,
    "text": "かれらは人のごとく憂にをらず人のごとく患難にあふことなし"
  },
  {
    "bookId": 19,
    "chapterId": 73,
    "verseId": 6,
    "text": "このゆゑに傲慢は妝飾のごとくその頸をめぐり強暴はころものごとく彼等をおほへり"
  },
  {
    "bookId": 19,
    "chapterId": 73,
    "verseId": 7,
    "text": "かれら肥ふとりてその目とびいで心の欲にまさりて物をうるなり"
  },
  {
    "bookId": 19,
    "chapterId": 73,
    "verseId": 8,
    "text": "また嘲笑をなし惡をもて暴虐のことばをいだし高ぶりてものいふ"
  },
  {
    "bookId": 19,
    "chapterId": 73,
    "verseId": 9,
    "text": "その口を天におきその舌を地にあまねく往しむ"
  },
  {
    "bookId": 19,
    "chapterId": 73,
    "verseId": 10,
    "text": "このゆゑにかれの民はここにかへり水のみちたる杯をしぼりいだして"
  },
  {
    "bookId": 19,
    "chapterId": 73,
    "verseId": 11,
    "text": "いへらく神いかで知たまはんや至上者に知識あらんやと"
  },
  {
    "bookId": 19,
    "chapterId": 73,
    "verseId": 12,
    "text": "視よかれらは惡きものなるに常にやすらかにしてその富ましくははれり"
  },
  {
    "bookId": 19,
    "chapterId": 73,
    "verseId": 13,
    "text": "誠に我はいたづらに心をきよめ罪ををかさずして手をあらひたり"
  },
  {
    "bookId": 19,
    "chapterId": 73,
    "verseId": 14,
    "text": "そはわれ終日なやみにあひ朝ごとに責をうけしなり"
  },
  {
    "bookId": 19,
    "chapterId": 73,
    "verseId": 15,
    "text": "われもし斯ることを述んといひしならば我なんぢが子輩の代をあやまらせしならん"
  },
  {
    "bookId": 19,
    "chapterId": 73,
    "verseId": 16,
    "text": "われこれらの道理をしらんとして思ひめぐらししにわが眼いたく痛たり"
  },
  {
    "bookId": 19,
    "chapterId": 73,
    "verseId": 17,
    "text": "われ神の聖所にゆきてかれらの結局をふかく思へるまでは然りき"
  },
  {
    "bookId": 19,
    "chapterId": 73,
    "verseId": 18,
    "text": "誠になんぢはかれらを滑かなるところにおきかれらを滅亡におとしいれ給ふ"
  },
  {
    "bookId": 19,
    "chapterId": 73,
    "verseId": 19,
    "text": "かれらは瞬間にやぶれたるかな彼等は恐怖をもてことごとく滅びたり"
  },
  {
    "bookId": 19,
    "chapterId": 73,
    "verseId": 20,
    "text": "主よなんぢ目をさましてかれらが像をかろしめたまはんときは夢みし人の目さめたるがごとし"
  },
  {
    "bookId": 19,
    "chapterId": 73,
    "verseId": 21,
    "text": "わが心はうれへ わが腎はさされたり"
  },
  {
    "bookId": 19,
    "chapterId": 73,
    "verseId": 22,
    "text": "われおろかにして知覺なし聖前にありて獣にひとしかりき"
  },
  {
    "bookId": 19,
    "chapterId": 73,
    "verseId": 23,
    "text": "されど我つねになんぢとともにあり汝わが右手をたもちたまへり"
  },
  {
    "bookId": 19,
    "chapterId": 73,
    "verseId": 24,
    "text": "なんぢその訓諭をもて我をみちびき後またわれをうけて榮光のうちに入たまはん"
  },
  {
    "bookId": 19,
    "chapterId": 73,
    "verseId": 25,
    "text": "汝のほかに我たれをか天にもたん地にはなんぢの他にわが慕ふものなし"
  },
  {
    "bookId": 19,
    "chapterId": 73,
    "verseId": 26,
    "text": "わが身とわが心とはおとろふ されど神はわがこころの磐わがとこしへの嗣業なり"
  },
  {
    "bookId": 19,
    "chapterId": 73,
    "verseId": 27,
    "text": "視よなんぢに遠きものは滅びん 汝をはなれて姦淫をおこなふ者はみななんぢ之をほろぼしたまひたり"
  },
  {
    "bookId": 19,
    "chapterId": 73,
    "verseId": 28,
    "text": "神にちかづき奉るは我によきことなり われは主ヱホバを避所としてそのもろもろの事跡をのべつたへん"
  }
]
