[
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 1,
    "text": "なんぢ岩間の山羊が子を產む時をしるや また麀鹿の產に臨むを見しや"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 2,
    "text": "なんぢ是等の在胎の月を數へうるや また是等が產む時を知るや"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 3,
    "text": "これらは身を鞠めて子を產みその痛苦を出す"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 4,
    "text": "またその子は強くなりて野に育ち 出ゆきて再たびその親にかへらず"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 5,
    "text": "誰が野驢馬を放ちて自由にせしや 誰が野驢馬の繋繩を解しや"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 6,
    "text": "われ野をその家となし 荒野をその住所となせり"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 7,
    "text": "是は邑の喧閙を賤しめ 馭者の號呼を聽いれず"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 8,
    "text": "山を走まはりて草を食ひ 各種の靑き物を尋ぬ"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 9,
    "text": "兕肯て汝に事へ なんぢの飼草槽の傍にとどまらんや"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 10,
    "text": "なんぢ兕に綱附て阡陌をあるかせ得んや 是あに汝にしたがひて谷に馬鈀を牽んや"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 11,
    "text": "その力おほいなればとて汝これに恃まんや またなんぢの工事をこれに任せんや"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 12,
    "text": "なんぢこれにたよりて己が穀物を運びかへらせ之を打禾塲にあつめしめんや"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 13,
    "text": "駝鳥は歡然にその翼を皷ふ 然どもその羽と毛とはあに鶴にしかんや"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 14,
    "text": "是はその卵を土の中に棄おき これを砂の中にて暖たまらしめ"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 15,
    "text": "足にてその潰さるべきと 野の獸のこれを踐むべきとを思はず"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 16,
    "text": "これはその子に情なくして宛然おのれの子ならざるが如くし その劬勞の空しくなるも繋念ところ無し"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 17,
    "text": "是は神これに智慧を授けず穎悟を與へざるが故なり"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 18,
    "text": "その身をおこして走るにおいては馬をもその騎手をも嘲けるべし"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 19,
    "text": "なんぢ馬に力を與へしや その頸に勇ましき鬣を粧ひしや"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 20,
    "text": "なんぢ之を蝗蟲のごとく飛しむるや その嘶なく聲の響は畏るべし"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 21,
    "text": "谷を踋爬て力に誇り 自ら進みて兵士に向ふ"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 22,
    "text": "懼るることを笑ひて驚ろくところ無く 劍にむかふとも退ぞかず"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 23,
    "text": "矢筒その上に鳴り 鎗に矛あひきらめく"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 24,
    "text": "猛りつ狂ひつ地を一呑にし 喇叭の聲鳴わたるも立どまる事なし"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 25,
    "text": "喇叭の鳴ごとにハーハーと言ひ遠方より戰鬪を嗅つけ 將帥の大聲および吶喊聲を聞しる"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 26,
    "text": "鷹の飛かけり その羽翼を舒て南に向ふは豈なんぢの智慧によるならんや"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 27,
    "text": "鷲の翔のぼり 高き處に巣を營なむは豈なんぢの命令に依んや"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 28,
    "text": "これは岩の上に住所を構へ 岩の尖所または峻險き所に居り"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 29,
    "text": "其處よりして攫むべき物をうかがふ その目のおよぶところ遠し"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 30,
    "text": "その子等もまた血を吸ふ 凡そ殺されし者のあるところには是そこに在り"
  }
]
