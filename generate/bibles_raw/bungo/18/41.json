[
  {
    "bookId": 18,
    "chapterId": 41,
    "verseId": 1,
    "text": "なんぢ鈎をもて鱷を釣いだすことを得んや その舌を糸にひきかくることを得んや"
  },
  {
    "bookId": 18,
    "chapterId": 41,
    "verseId": 2,
    "text": "なんぢ葦の繩をその鼻に通し また鈎をその齶に衝とほし得んや"
  },
  {
    "bookId": 18,
    "chapterId": 41,
    "verseId": 3,
    "text": "是あに頻になんぢに願ふことをせんや 柔かになんぢに言談んや"
  },
  {
    "bookId": 18,
    "chapterId": 41,
    "verseId": 4,
    "text": "あに汝と契約を爲んや なんぢこれを執て永く僕と爲しおくを得んや"
  },
  {
    "bookId": 18,
    "chapterId": 41,
    "verseId": 5,
    "text": "なんぢ鳥と戲むるる如くこれとたはむれ また汝の婦人等のために之を繋ぎおくを得んや"
  },
  {
    "bookId": 18,
    "chapterId": 41,
    "verseId": 6,
    "text": "また漁夫の社會これを商貨と爲して商賣人の中間に分たんや"
  },
  {
    "bookId": 18,
    "chapterId": 41,
    "verseId": 7,
    "text": "なんぢ漁叉をもてその皮に滿し 魚矛をもてその頭を衝とほし得んや"
  },
  {
    "bookId": 18,
    "chapterId": 41,
    "verseId": 8,
    "text": "手をこれに下し見よ 然ばその戰鬪をおぼえて再びこれを爲ざるべし"
  },
  {
    "bookId": 18,
    "chapterId": 41,
    "verseId": 9,
    "text": "視よその望は虚し 之を見てすら倒るるに非ずや"
  },
  {
    "bookId": 18,
    "chapterId": 41,
    "verseId": 10,
    "text": "何人も之に激する勇氣あるなし 然ば誰かわが前に立うる者あらんや"
  },
  {
    "bookId": 18,
    "chapterId": 41,
    "verseId": 11,
    "text": "誰か先に我に與へしところありて我をして之に酬いしめんとする者あらん 普天の下にある者はことごとく我有なり"
  },
  {
    "bookId": 18,
    "chapterId": 41,
    "verseId": 12,
    "text": "我また彼者の肢體とその著るしき力とその美はしき身の構造とを言では措じ"
  },
  {
    "bookId": 18,
    "chapterId": 41,
    "verseId": 13,
    "text": "誰かその外甲を剥ん 誰かその雙齶の間に入ん"
  },
  {
    "bookId": 18,
    "chapterId": 41,
    "verseId": 14,
    "text": "誰かその面の戸を開きえんや その周圍の齒は畏るべし"
  },
  {
    "bookId": 18,
    "chapterId": 41,
    "verseId": 15,
    "text": "その並列る鱗甲は之が誇るところ その相闔たる樣は堅く封じたるがごとく"
  },
  {
    "bookId": 18,
    "chapterId": 41,
    "verseId": 16,
    "text": "此と彼とあひ接きて風もその中間にいるべからず"
  },
  {
    "bookId": 18,
    "chapterId": 41,
    "verseId": 17,
    "text": "一々あひ連なり堅く膠て離すことを得ず"
  },
  {
    "bookId": 18,
    "chapterId": 41,
    "verseId": 18,
    "text": "嚔すれば即はち光發す その目は曙光の眼瞼(を開く)に似たり"
  },
  {
    "bookId": 18,
    "chapterId": 41,
    "verseId": 19,
    "text": "その口よりは炬火いで火花發し"
  },
  {
    "bookId": 18,
    "chapterId": 41,
    "verseId": 20,
    "text": "その鼻の孔よりは煙いできたりて宛然葦を焚く釜のごとし"
  },
  {
    "bookId": 18,
    "chapterId": 41,
    "verseId": 21,
    "text": "その氣息は炭火を爇し 火燄その口より出づ"
  },
  {
    "bookId": 18,
    "chapterId": 41,
    "verseId": 22,
    "text": "力氣その頸に宿る 懼るる者その前に彷徨まよふ"
  },
  {
    "bookId": 18,
    "chapterId": 41,
    "verseId": 23,
    "text": "その肉の片は密に相連なり 堅く身に着て動かす可らず"
  },
  {
    "bookId": 18,
    "chapterId": 41,
    "verseId": 24,
    "text": "その心の堅硬こと石のごとく その堅硬こと下磨のごとし"
  },
  {
    "bookId": 18,
    "chapterId": 41,
    "verseId": 25,
    "text": "その身を興す時は勇士も戰慄き 恐怖によりて狼狽まどふ"
  },
  {
    "bookId": 18,
    "chapterId": 41,
    "verseId": 26,
    "text": "劍をもて之を撃とも利ず 鎗も矢も漁叉も用ふるところ無し"
  },
  {
    "bookId": 18,
    "chapterId": 41,
    "verseId": 27,
    "text": "是は鐡を見ること稿のごとくし銅を見ること朽木のごとくす"
  },
  {
    "bookId": 18,
    "chapterId": 41,
    "verseId": 28,
    "text": "弓箭もこれを逃しむること能はず 投石機の石も稿屑と見做る"
  },
  {
    "bookId": 18,
    "chapterId": 41,
    "verseId": 29,
    "text": "棒も是には稿屑と見ゆ 鎗の閃めくを是は笑ふ"
  },
  {
    "bookId": 18,
    "chapterId": 41,
    "verseId": 30,
    "text": "その下腹には瓦礫の碎片を連ね 泥の上に麥打車を引く"
  },
  {
    "bookId": 18,
    "chapterId": 41,
    "verseId": 31,
    "text": "淵をして鼎のごとく沸かへらしめ 海をして香油の釜のごとくならしめ"
  },
  {
    "bookId": 18,
    "chapterId": 41,
    "verseId": 32,
    "text": "己が後に光る道を遺せば淵は白髮をいただけるかと疑がはる"
  },
  {
    "bookId": 18,
    "chapterId": 41,
    "verseId": 33,
    "text": "地の上には是と並ぶ者なし 是は恐怖なき身に造られたり"
  },
  {
    "bookId": 18,
    "chapterId": 41,
    "verseId": 34,
    "text": "是は一切の高大なる者を輕視ず 誠に諸の誇り高ぶる者の王たるなり"
  }
]
