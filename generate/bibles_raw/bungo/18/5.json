[
  {
    "bookId": 18,
    "chapterId": 5,
    "verseId": 1,
    "text": "請ふなんぢ龥びて看よ 誰か汝に應ふる者ありや 聖者の中にて誰に汝むかはんとするや"
  },
  {
    "bookId": 18,
    "chapterId": 5,
    "verseId": 2,
    "text": "夫愚なる者は憤恨のために身を殺し 癡き者は嫉媢のために己を死しむ"
  },
  {
    "bookId": 18,
    "chapterId": 5,
    "verseId": 3,
    "text": "我みづから愚なる者のその根を張るを見たりしがすみやかにその家を詛へり"
  },
  {
    "bookId": 18,
    "chapterId": 5,
    "verseId": 4,
    "text": "その子等は助援を獲ることなく 門にて惱まさる 之を救ふ者なし"
  },
  {
    "bookId": 18,
    "chapterId": 5,
    "verseId": 5,
    "text": "その穡とれる物は饑たる人これを食ひ 荊棘の籬の中にありてもなほ之を奪ひいだし 羂をその所有物にむかひて口を張る"
  },
  {
    "bookId": 18,
    "chapterId": 5,
    "verseId": 6,
    "text": "災禍は塵より起らず 艱難は土より出ず"
  },
  {
    "bookId": 18,
    "chapterId": 5,
    "verseId": 7,
    "text": "人の生れて艱難をうくるは火の子の上に飛がごとし"
  },
  {
    "bookId": 18,
    "chapterId": 5,
    "verseId": 8,
    "text": "もし我ならんには我は必らず神に告求め 我事を神に任せん"
  },
  {
    "bookId": 18,
    "chapterId": 5,
    "verseId": 9,
    "text": "神は大にして測りがたき事を行ひたまふ 其不思議なる事を爲たまふこと數しれず"
  },
  {
    "bookId": 18,
    "chapterId": 5,
    "verseId": 10,
    "text": "雨を地の上に降し 水を野に遣り"
  },
  {
    "bookId": 18,
    "chapterId": 5,
    "verseId": 11,
    "text": "卑き者を高く擧げ 憂ふる者を引興して幸福ならしめたまふ"
  },
  {
    "bookId": 18,
    "chapterId": 5,
    "verseId": 12,
    "text": "神は狡しき者の謀計を敗り 之をして何事をもその手に成就ること能はざらしめ"
  },
  {
    "bookId": 18,
    "chapterId": 5,
    "verseId": 13,
    "text": "慧き者をその自分の詭計によりて執へ 邪なる者の謀計をして敗れしむ"
  },
  {
    "bookId": 18,
    "chapterId": 5,
    "verseId": 14,
    "text": "彼らは晝も暗黑に遇ひ 卓午にも夜の如くに摸り惑はん"
  },
  {
    "bookId": 18,
    "chapterId": 5,
    "verseId": 15,
    "text": "神は惱める者を救ひてかれらが口の劍を免かれしめ 強き者の手を免かれしめたまふ"
  },
  {
    "bookId": 18,
    "chapterId": 5,
    "verseId": 16,
    "text": "是をもて弱き者望あり 惡き者口を閉づ"
  },
  {
    "bookId": 18,
    "chapterId": 5,
    "verseId": 17,
    "text": "神の懲したまふ人は幸福なり 然ば汝全能者の儆責を輕んずる勿れ"
  },
  {
    "bookId": 18,
    "chapterId": 5,
    "verseId": 18,
    "text": "神は傷け又裹み 撃ていため又その手をもて善醫したまふ"
  },
  {
    "bookId": 18,
    "chapterId": 5,
    "verseId": 19,
    "text": "彼はなんぢを六の艱難の中にて救ひたまふ 七の中にても災禍なんぢにのぞまじ"
  },
  {
    "bookId": 18,
    "chapterId": 5,
    "verseId": 20,
    "text": "饑饉の時にはなんぢを救ひて死を免れしめ 戰爭の時には劍の手を免れしめたまふ"
  },
  {
    "bookId": 18,
    "chapterId": 5,
    "verseId": 21,
    "text": "汝は舌にて鞭たるる時にも隱るることを得 壞滅の來る時にも懼るること有じ"
  },
  {
    "bookId": 18,
    "chapterId": 5,
    "verseId": 22,
    "text": "汝は壞滅と饑饉を笑ひ地の獸をも懼るること無るべし"
  },
  {
    "bookId": 18,
    "chapterId": 5,
    "verseId": 23,
    "text": "田野の石なんぢと相結び野の獸なんぢと和がん"
  },
  {
    "bookId": 18,
    "chapterId": 5,
    "verseId": 24,
    "text": "汝はおのが幕屋の安然なるを知ん 汝の住處を見まはるに缺たる者なからん"
  },
  {
    "bookId": 18,
    "chapterId": 5,
    "verseId": 25,
    "text": "汝また汝の子等の多くなり 汝の裔の地の草の如くになるを知ん"
  },
  {
    "bookId": 18,
    "chapterId": 5,
    "verseId": 26,
    "text": "汝は遐齡におよびて墓にいらん 宛然麥束を時にいたりて運びあぐるごとくなるべし"
  },
  {
    "bookId": 18,
    "chapterId": 5,
    "verseId": 27,
    "text": "視よ我らが尋ね明めし所かくのごとし 汝これを聽て自ら知れよ"
  }
]
