[
  {
    "bookId": 18,
    "chapterId": 25,
    "verseId": 1,
    "text": "時にシユヒ人ビルダデこたへて曰く"
  },
  {
    "bookId": 18,
    "chapterId": 25,
    "verseId": 2,
    "text": "神は大權を握りたまふ者 畏るべき者にましまし 高き處に平和を施したまふ"
  },
  {
    "bookId": 18,
    "chapterId": 25,
    "verseId": 3,
    "text": "その軍旅數ふることを得んや 其光明なに物をか照さざらん"
  },
  {
    "bookId": 18,
    "chapterId": 25,
    "verseId": 4,
    "text": "然ば誰か神の前に正義かるべき 婦人の產し者いかでか清かるべき"
  },
  {
    "bookId": 18,
    "chapterId": 25,
    "verseId": 5,
    "text": "視よ月も輝かず 星も其目には清明ならず"
  },
  {
    "bookId": 18,
    "chapterId": 25,
    "verseId": 6,
    "text": "いはんや蛆のごとき人 蟲のごとき人の子をや"
  }
