[
  {
    "bookId": 18,
    "chapterId": 12,
    "verseId": 1,
    "text": "ヨブこたへて言ふ"
  },
  {
    "bookId": 18,
    "chapterId": 12,
    "verseId": 2,
    "text": "なんぢら而已まことに人なり 智慧は汝らと共に死ん"
  },
  {
    "bookId": 18,
    "chapterId": 12,
    "verseId": 3,
    "text": "我もなんぢらと同じく心あり 我はなんぢらの下に立ず 誰か汝らの言し如き事を知ざらんや"
  },
  {
    "bookId": 18,
    "chapterId": 12,
    "verseId": 4,
    "text": "我は神に龥はりて聽るる者なるに今その友に嘲けらるる者となれり 嗚呼正しくかつ完たき人あざけらる"
  },
  {
    "bookId": 18,
    "chapterId": 12,
    "verseId": 5,
    "text": "安逸なる者は思ふ 輕侮は不幸なる者に附そひ足のよろめく者を俟と"
  },
  {
    "bookId": 18,
    "chapterId": 12,
    "verseId": 6,
    "text": "掠奪ふ者の天幕は繁榮え 神を怒らせ自己の手に神を携ふる者は安泰なり"
  },
  {
    "bookId": 18,
    "chapterId": 12,
    "verseId": 7,
    "text": "今請ふ獸に問へ然ば汝に敎へん 天空の鳥に問へ然ばなんぢに語らん"
  },
  {
    "bookId": 18,
    "chapterId": 12,
    "verseId": 8,
    "text": "地に言へ然ばなんぢに敎へん 海の魚もまた汝に述べし"
  },
  {
    "bookId": 18,
    "chapterId": 12,
    "verseId": 9,
    "text": "誰かこの一切の者に依てヱホバの手のこれを作りしなるを知ざらんや"
  },
  {
    "bookId": 18,
    "chapterId": 12,
    "verseId": 10,
    "text": "一切の生物の生氣および一切の人の靈魂ともに彼の手の中にあり"
  },
  {
    "bookId": 18,
    "chapterId": 12,
    "verseId": 11,
    "text": "耳は説話を辨へざらんや その状あたかも口の食物を味ふがごとし"
  },
  {
    "bookId": 18,
    "chapterId": 12,
    "verseId": 12,
    "text": "老たる者の中には智慧あり 壽長者の中には穎悟あり"
  },
  {
    "bookId": 18,
    "chapterId": 12,
    "verseId": 13,
    "text": "智慧と權能は神に在り 智謀と穎悟も彼に屬す"
  },
  {
    "bookId": 18,
    "chapterId": 12,
    "verseId": 14,
    "text": "視よ彼毀てば再び建ること能はず 彼人を閉こむれば開き出すことを得ず"
  },
  {
    "bookId": 18,
    "chapterId": 12,
    "verseId": 15,
    "text": "視よ彼水を止むれば則ち涸れ 水を出せば則ち地を滅ぼす"
  },
  {
    "bookId": 18,
    "chapterId": 12,
    "verseId": 16,
    "text": "權能と穎悟は彼に在り 惑はさるる者も惑はす者も共に彼に屬す"
  },
  {
    "bookId": 18,
    "chapterId": 12,
    "verseId": 17,
    "text": "彼は議士を裸體にして擄へゆき 審判人をして愚なる者とならしめ"
  },
  {
    "bookId": 18,
    "chapterId": 12,
    "verseId": 18,
    "text": "王等の權威を解て反て之が腰に繩をかけ"
  },
  {
    "bookId": 18,
    "chapterId": 12,
    "verseId": 19,
    "text": "祭司等を裸體にして擄へゆき 權力ある者を滅ぼし"
  },
  {
    "bookId": 18,
    "chapterId": 12,
    "verseId": 20,
    "text": "言爽なる者の言語を取除き 老たる者の了知を奪ひ"
  },
  {
    "bookId": 18,
    "chapterId": 12,
    "verseId": 21,
    "text": "侯伯たる者等に恥辱を蒙らせ 強き者の帶を解き"
  },
  {
    "bookId": 18,
    "chapterId": 12,
    "verseId": 22,
    "text": "暗中より隱れたる事等を顯し 死の蔭を光明に出し"
  },
  {
    "bookId": 18,
    "chapterId": 12,
    "verseId": 23,
    "text": "國々を大にしまた之を滅ぼし 國々を廣くしまた之を舊に歸し"
  },
  {
    "bookId": 18,
    "chapterId": 12,
    "verseId": 24,
    "text": "地の民の長たる者等の了知を奪ひ これを路なき荒野に吟行はしむ"
  },
  {
    "bookId": 18,
    "chapterId": 12,
    "verseId": 25,
    "text": "彼らは光明なき暗にたどる 彼また彼らを醉る人のごとくによろめかしむ"
  }
]
