[
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 1,
    "text": "ヨブこたへて言けるは"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 2,
    "text": "我まことに其事の然るを知り 人いかでか神の前に義かるべけん"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 3,
    "text": "よし人は神と辨爭はんとするとも千の一も答ふること能はざるべし"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 4,
    "text": "神は心慧く力強くましますなり 誰か神に逆ひてその身安からんや"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 5,
    "text": "彼山を移したまふに山しらず 彼震怒をもて之を飜倒したまふ"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 6,
    "text": "彼地を震ひてその所を離れしめたまへばその柱ゆるぐ"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 7,
    "text": "日に命じたまへば日いでず 又星辰を封じたまふ"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 8,
    "text": "唯かれ獨天を張り海の濤を覆たまふ"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 9,
    "text": "また北斗參宿昴宿および南方の密室を造りたまふ"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 10,
    "text": "大なる事を行ひたまふこと測られず奇しき業を爲たまふこと數しれず"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 11,
    "text": "視よ彼わが前を過たまふ 然るに我これを見ず彼すすみゆき賜ふ然るに我之を曉ず"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 12,
    "text": "彼奪ひ去賜ふ 誰か能之を沮まん 誰か之に汝何を爲やと言ことを得爲ん"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 13,
    "text": "神其震怒を息賜はず ラハブを助る者等之が下に屈む"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 14,
    "text": "然ば我爭か彼に回答を爲ことを得ん 爭われ言を選びて彼と論ふ事をえんや"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 15,
    "text": "假令われ義かるとも彼に回答をせじ 彼は我を審判く者なれば我彼に哀き求ん"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 16,
    "text": "假令我彼を呼て彼われに答たまふともわが言を聽いれ賜ひしとは我信ぜざるなり"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 17,
    "text": "彼は大風をもて我を撃碎き 故なくして我に衆多の傷を負せ"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 18,
    "text": "我に息をつかさしめず 苦き事をもて我身に充せ賜ふ"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 19,
    "text": "強き者の力量を言んか 視よ此にあり 審判の事ならんか 誰か我を喚出すことを得爲ん"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 20,
    "text": "假令われ義かるとも我口われを惡しと爲ん 假令われ完全かるとも尚われを罪ありとせん"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 21,
    "text": "我は全し 然ども我はわが心を知ず 我生命を賤む"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 22,
    "text": "皆同一なり 故に我は言ふ神は完全者と惡者とを等しく滅したまふと"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 23,
    "text": "災禍の俄然に人を誅す如き事あれば彼は辜なき者の苦痛を笑ひ見たまふ"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 24,
    "text": "世は惡き者の手に交されてあり 彼またその裁判人の面を蔽ひたまふ 若彼ならずば是誰の行爲なるや"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 25,
    "text": "わが日は驛使よりも迅く 徒に過さりて福祉を見ず"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 26,
    "text": "其はしること葦舟のごとく 物を攫まんとて飛かける鷲のごとし"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 27,
    "text": "たとひ我わが愁を忘れ面色を改めて笑ひをらんと思ふとも"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 28,
    "text": "尚この諸の苦痛のために戰慄くなり 我思ふに汝われを釋し放ちたまはざらん"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 29,
    "text": "我は罪ありとせらるるなれば何ぞ徒然に勞すべけんや"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 30,
    "text": "われ雪水をもて身を洗ひ 灰汁をもて手を潔むるとも"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 31,
    "text": "汝われを汚はしき穴の中に陷いれたまはん 而して我衣も我を厭ふにいたらん"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 32,
    "text": "神は我のごとく人にあらざれば我かれに答ふべからず 我ら二箇して共に裁判に臨むべからず"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 33,
    "text": "また我らの間には我ら二箇の上に手を置べき仲保あらず"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 34,
    "text": "願くは彼その杖を我より取はなし その震怒をもて我を懼れしめたまはざれ"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 35,
    "text": "然らば我 言語て彼を畏れざらん 其は我みづから斯る者と思はざればなり"
  }
]
