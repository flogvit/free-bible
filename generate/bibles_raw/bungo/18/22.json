[
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 1,
    "text": "是においてテマン人エリパズこたへて曰く"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 2,
    "text": "人神を益する事をえんや 智人も唯みづから益する而已なるぞかし"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 3,
    "text": "なんぢ義かるとも全能者に何の歡喜かあらん なんぢ行爲を全たふするとも彼に何の利益かあらん"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 4,
    "text": "彼汝の畏懼の故によりて汝を責め汝を鞫きたまはんや"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 5,
    "text": "なんぢの惡大なるにあらずや 汝の罪はきはまり無し"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 6,
    "text": "即はち汝は故なくその兄弟の物を抑へて質となし 裸なる者の衣服を剥て取り"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 7,
    "text": "渇く者に水を與へて飮しめず 饑る者に食物を施こさず"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 8,
    "text": "力ある者土地を得 貴き者その中に住む"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 9,
    "text": "なんぢは寡婦に手を空しうして去しむ 孤子の腕は折る"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 10,
    "text": "是をもて網羅なんぢを環り 畏懼にはかに汝を擾す"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 11,
    "text": "なんぢ黑暗を見ずや 洪水のなんぢを覆ふを見ずや"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 12,
    "text": "神は天の高に在すならずや 星辰の巓ああ如何に高きぞや"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 13,
    "text": "是によりて汝は言ふ 神なにをか知しめさん 豈よく黑雲の中より審判するを得たまはんや"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 14,
    "text": "濃雲かれを蔽へば彼は見たまふ所なし 唯天の蒼穹を歩みたまふ"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 15,
    "text": "なんぢ古昔の世の道を行なはんとするや 是あしき人の踐たりし者ならずや"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 16,
    "text": "彼等は時いまだ至らざるに打絶れ その根基は大水に押流されたり"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 17,
    "text": "彼ら神に言けらく我儕を離れたまへ 全能者われらのために何を爲ことを得んと"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 18,
    "text": "しかるに彼は却つて佳物を彼らの家に盈したまへり 但し惡人の計畫は我に與する所にあらず"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 19,
    "text": "義しき者は之を見て喜び 無辜者は彼らを笑ふ"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 20,
    "text": "曰く我らの仇は誠に滅ぼされ 其盈餘れる物は火にて焚つくさる"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 21,
    "text": "請ふ汝神と和らぎて平安を得よ 然らば福祿なんぢに來らん"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 22,
    "text": "請ふかれの口より敎晦を受け その言語をなんぢの心に藏めよ"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 23,
    "text": "なんぢもし全能者に歸向り且なんぢの家より惡を除き去ば 汝の身再び興されん"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 24,
    "text": "なんぢの寳を土の上に置き オフルの黄金を谿河の石の中に置け"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 25,
    "text": "然れば全能者なんぢの寳となり汝のために白銀となりたまふべし"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 26,
    "text": "而してなんぢは又全能者を喜び且神にむかひて面をあげん"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 27,
    "text": "なんぢ彼に祈らば彼なんぢに聽たまはん 而して汝その誓願をつくのひ果さん"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 28,
    "text": "なんぢ事を爲んと定めなばその事なんぢに成ん 汝の道には光照ん"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 29,
    "text": "其卑く降る時は汝いふ昇る哉と 彼は謙遜者を拯ひたまふべし"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 30,
    "text": "かれは罪なきに非ざる者をも拯ひたまはん 汝の手の潔淨によりて斯る者も拯はるべし"
  }
]
