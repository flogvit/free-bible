[
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 1,
    "text": "ヨブまた語をつぎて曰く"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 2,
    "text": "嗚呼過にし年月のごとくならまほし 神の我を護りたまへる日のごとくならまほし"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 3,
    "text": "かの時には彼の燈火わが首の上に輝やき彼の光明によりて我黑暗を歩めり"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 4,
    "text": "わが壯なりし日のごとくならまほし 彼時には神の恩惠わが幕屋の上にありき"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 5,
    "text": "かの時には全能者なほ我とともに在し わが子女われの周圍にありき"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 6,
    "text": "乳ながれてわが足跡を洗ひ 我が傍なる磐油を灌ぎいだせり"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 7,
    "text": "かの時には我いでて邑の門に上りゆき わが座を街衢に設けたり"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 8,
    "text": "少き者は我を見て隱れ 老たる者は起あがりて立ち"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 9,
    "text": "牧伯たる者も言談ずしてその口に手を當て"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 10,
    "text": "貴き者も聲ををさめてその舌を上顎に貼たりき"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 11,
    "text": "我事を耳に聞る者は我を幸福なりと呼び 我を目に見たる者はわがために證據をなしぬ"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 12,
    "text": "是は我助力を求むる貧しき者を拯ひ 孤子および助くる人なき者を拯ひたればなり"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 13,
    "text": "亡びんとせし者われを祝せり 我また寡婦の心をして喜び歌はしめたり"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 14,
    "text": "われ正義を衣また正義の衣る所となれり 我が公義は袍のごとく冠冕のごとし"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 15,
    "text": "われは盲目の目となり跛者の足となり"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 16,
    "text": "貧き者の父となり知ざる者の訴訟の由を究め"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 17,
    "text": "惡き者の牙を折り その齒の間より獲物を取いだせり"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 18,
    "text": "我すなはち言けらく 我はわが巣に死ん 我が日は砂の如く多からん"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 19,
    "text": "わが根は水の邊に蔓り 露わが枝に終夜おかん"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 20,
    "text": "わが榮光はわが身に新なるべくわが弓はわが手に何時も強からんと"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 21,
    "text": "人々われに聽き默して我が敎を俟ち"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 22,
    "text": "わが言し後は彼等言を出さず 我説ところは彼等に甘露のごとく"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 23,
    "text": "かれらは我を望み待つこと雨のごとく 口を開きて仰ぐこと春の雨のごとくなりき"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 24,
    "text": "われ彼等にむかひて笑ふとも彼等は敢て眞實とおもはず我面の光を彼等は除くことをせざりき"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 25,
    "text": "われは彼等のために道を擇び その首として座を占め 軍中の王のごとくして居り また哀哭者を慰さむる人のごとくなりき"
  }
]
