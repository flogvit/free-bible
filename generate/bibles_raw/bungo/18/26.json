[
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 1,
    "text": "ヨブこたへて曰く"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 2,
    "text": "なんぢ能力なき者を如何に助けしや 氣力なきものを如何に救ひしや"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 3,
    "text": "智慧なき者を如何に誨へしや 穎悟の道を如何に多く示ししや"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 4,
    "text": "なんぢ誰にむかひて言語を出ししや なんぢより出しは誰が靈なるや"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 5,
    "text": "陰靈水またその中に居る者の下に慄ふ"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 6,
    "text": "かれの御前には陰府も顯露なり 滅亡の坑も蔽ひ匿す所なし"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 7,
    "text": "彼は北の天を虚空に張り 地を物なき所に懸けたまふ"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 8,
    "text": "水を濃雲の中に包みたまふてその下の雲裂ず"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 9,
    "text": "御寳座の面を隱して雲をその上に展べ"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 10,
    "text": "水の面に界を設けて光と暗とに限を立たまふ"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 11,
    "text": "かれ叱咤たまへば天の柱震ひかつ怖る"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 12,
    "text": "その權能をもて海を靜め その智慧をもてラハブを撃碎き"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 13,
    "text": "その氣嘘をもて天を輝かせ 其手をもて逃る蛇を衝とほしたまふ"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 14,
    "text": "視よ是等はただその御工作の端なるのみ 我らが聞ところの者は如何にも微細なる耳語ならずや 然どその權能の雷轟に至りては誰かこれを曉らんや"
  }
]
