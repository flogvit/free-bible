[
  {
    "bookId": 18,
    "chapterId": 33,
    "verseId": 1,
    "text": "然ばヨブよ請ふ我が言ふ事を聽け わが一切の言語に耳を傾むけよ"
  },
  {
    "bookId": 18,
    "chapterId": 33,
    "verseId": 2,
    "text": "視よ我口を啓き 舌を口の中に動かす"
  },
  {
    "bookId": 18,
    "chapterId": 33,
    "verseId": 3,
    "text": "わが言ふ所は正義き心より出づ わが唇あきらかにその知識を陳ん"
  },
  {
    "bookId": 18,
    "chapterId": 33,
    "verseId": 4,
    "text": "神の靈われを造り 全能者の氣息われを活しむ"
  },
  {
    "bookId": 18,
    "chapterId": 33,
    "verseId": 5,
    "text": "汝もし能せば我に答へよ わが前に言をいひつらねて立て"
  },
  {
    "bookId": 18,
    "chapterId": 33,
    "verseId": 6,
    "text": "我も汝とおなじく神の者なり 我もまた土より取てつくられしなり"
  },
  {
    "bookId": 18,
    "chapterId": 33,
    "verseId": 7,
    "text": "わが威嚴はなんぢを懼れしめず わが勢はなんぢを壓せず"
  },
  {
    "bookId": 18,
    "chapterId": 33,
    "verseId": 8,
    "text": "汝わが聽くところにて言談り 我なんぢの言語の聲を聞けり云く"
  },
  {
    "bookId": 18,
    "chapterId": 33,
    "verseId": 9,
    "text": "われは潔淨くして愆なし 我は辜なく惡き事わが身にあらず"
  },
  {
    "bookId": 18,
    "chapterId": 33,
    "verseId": 10,
    "text": "視よ彼われを攻る釁隙を尋ね われを己の敵と算へ"
  },
  {
    "bookId": 18,
    "chapterId": 33,
    "verseId": 11,
    "text": "わが脚を桎に夾めわが一切の擧動に目を着たまふと"
  },
  {
    "bookId": 18,
    "chapterId": 33,
    "verseId": 12,
    "text": "視よ我なんぢに答へん なんぢ此事において正義からず 神は人よりも大なる者にいませり"
  },
  {
    "bookId": 18,
    "chapterId": 33,
    "verseId": 13,
    "text": "彼その凡て行なふところの理由を示したまはずとて汝かれにむかひて辯爭そふは何ぞや"
  },
  {
    "bookId": 18,
    "chapterId": 33,
    "verseId": 14,
    "text": "まことに神は一度二度と告示したまふなれど人これを曉らざるなり"
  },
  {
    "bookId": 18,
    "chapterId": 33,
    "verseId": 15,
    "text": "人熟睡する時または床に睡る時に夢あるひは夜の間の異象の中にて"
  },
  {
    "bookId": 18,
    "chapterId": 33,
    "verseId": 16,
    "text": "かれ人の耳をひらき その敎ふるところを印して堅うし"
  },
  {
    "bookId": 18,
    "chapterId": 33,
    "verseId": 17,
    "text": "斯して人にその惡き業を離れしめ 傲慢を人の中より除き"
  },
  {
    "bookId": 18,
    "chapterId": 33,
    "verseId": 18,
    "text": "人の魂靈を護りて墓に至らしめず 人の生命を護りて劍にほろびざらしめたまふ"
  },
  {
    "bookId": 18,
    "chapterId": 33,
    "verseId": 19,
    "text": "人床にありて疼痛に攻られ その骨の中に絶ず戰鬪のあるあり"
  },
  {
    "bookId": 18,
    "chapterId": 33,
    "verseId": 20,
    "text": "その氣食物を厭ひ その魂靈うまき物をも嫌ふ"
  },
  {
    "bookId": 18,
    "chapterId": 33,
    "verseId": 21,
    "text": "その肉は痩おちて見えず その骨は見えざりし者までも顯露になり"
  },
  {
    "bookId": 18,
    "chapterId": 33,
    "verseId": 22,
    "text": "その魂靈は墓に近より その生命は滅ぼす者に近づく"
  },
  {
    "bookId": 18,
    "chapterId": 33,
    "verseId": 23,
    "text": "しかる時にもし彼とともに一箇の使者あり 千の中の一箇にして中保となり 正しき道を人に示さば"
  },
  {
    "bookId": 18,
    "chapterId": 33,
    "verseId": 24,
    "text": "神かれを憫れみて言給はん彼を救ひて墓にくだること無らしめよ 我すでに收贖の物を得たりと"
  },
  {
    "bookId": 18,
    "chapterId": 33,
    "verseId": 25,
    "text": "その肉は小兒の肉よりも瑞々しくなり その若き時の形状に歸らん"
  },
  {
    "bookId": 18,
    "chapterId": 33,
    "verseId": 26,
    "text": "かれ若し神に祷らば神かれを顧りみ 彼をしてその御面を喜こび見ることを得せしめたまはん 神は人の正義に報をなしたまふべし"
  },
  {
    "bookId": 18,
    "chapterId": 33,
    "verseId": 27,
    "text": "かれ人の前に歌ひて言ふ 我は罪を犯し正しきを抂たり 然ど報を蒙らず"
  },
  {
    "bookId": 18,
    "chapterId": 33,
    "verseId": 28,
    "text": "神わが魂靈を贖ひて墓に下らしめず わが生命光明を見ん"
  },
  {
    "bookId": 18,
    "chapterId": 33,
    "verseId": 29,
    "text": "そもそも神は是等のもろもろの事をしばしば人におこなひ"
  },
  {
    "bookId": 18,
    "chapterId": 33,
    "verseId": 30,
    "text": "その魂靈を墓より牽かへし生命の光明をもて彼を照したまふ"
  },
  {
    "bookId": 18,
    "chapterId": 33,
    "verseId": 31,
    "text": "ヨブよ耳を傾むけて我に聽け 請ふ默せよ 我かたらん"
  },
  {
    "bookId": 18,
    "chapterId": 33,
    "verseId": 32,
    "text": "なんぢもし言ふべきことあらば我にこたへよ 請ふ語れ 我なんぢを義とせんと慾すればなり"
  },
  {
    "bookId": 18,
    "chapterId": 33,
    "verseId": 33,
    "text": "もし無ば我に聽け 請ふ默せよ 我なんぢに智慧を敎へん"
  }
]
