[
  {
    "bookId": 18,
    "chapterId": 23,
    "verseId": 1,
    "text": "ヨブこたへて曰く"
  },
  {
    "bookId": 18,
    "chapterId": 23,
    "verseId": 2,
    "text": "我は今日にても尚つぶやきて服せず わが禍災はわが嘆息よりも重し"
  },
  {
    "bookId": 18,
    "chapterId": 23,
    "verseId": 3,
    "text": "ねがはくは神をたづねて何處にか遇まつるを知り其御座に參いたらんことを"
  },
  {
    "bookId": 18,
    "chapterId": 23,
    "verseId": 4,
    "text": "我この愁訴をその御前に陳べ口を極めて辨論はん"
  },
  {
    "bookId": 18,
    "chapterId": 23,
    "verseId": 5,
    "text": "我その我に答へたまふ言を知り また其われに言たまふ所を了らん"
  },
  {
    "bookId": 18,
    "chapterId": 23,
    "verseId": 6,
    "text": "かれ大なる能をもて我と爭ひたまはんや 然らじ反つて我を眷みたまふべし"
  },
  {
    "bookId": 18,
    "chapterId": 23,
    "verseId": 7,
    "text": "彼處にては正義人かれと辨爭ふことを得 斯せば我を鞫く者の手を永く免かるべし"
  },
  {
    "bookId": 18,
    "chapterId": 23,
    "verseId": 8,
    "text": "しかるに我東に往くも彼いまさず 西に往くも亦見たてまつらず"
  },
  {
    "bookId": 18,
    "chapterId": 23,
    "verseId": 9,
    "text": "北に工作きたまへども遇まつらず 南に隱れ居たまへば望むべからず"
  },
  {
    "bookId": 18,
    "chapterId": 23,
    "verseId": 10,
    "text": "わが平生の道は彼知たまふ 彼われを試みたまはば我は金のごとくして出きたらん"
  },
  {
    "bookId": 18,
    "chapterId": 23,
    "verseId": 11,
    "text": "わが足は彼の歩履に堅く隨がへり 我はかれの道を守りて離れざりき"
  },
  {
    "bookId": 18,
    "chapterId": 23,
    "verseId": 12,
    "text": "我はかれの唇の命令に違はず 我が法よりも彼の口の言語を重ぜり"
  },
  {
    "bookId": 18,
    "chapterId": 23,
    "verseId": 13,
    "text": "かれは一に居る者にまします 誰か能かれをして意を變しめん 彼はその心に慾する所をかならず爲たまふ"
  },
  {
    "bookId": 18,
    "chapterId": 23,
    "verseId": 14,
    "text": "然ば我に向ひて定めし事を必らず成就たまはん 是のごとき事を多く彼は爲たまふなり"
  },
  {
    "bookId": 18,
    "chapterId": 23,
    "verseId": 15,
    "text": "是故に我かれの前に慄ふ 我考ふれば彼を懼る"
  },
  {
    "bookId": 18,
    "chapterId": 23,
    "verseId": 16,
    "text": "神わが心を弱くならしめ 全能者われをして懼れしめたまふ"
  },
  {
    "bookId": 18,
    "chapterId": 23,
    "verseId": 17,
    "text": "かく我は暗の來らぬ先わが面を黑暗の覆ふ前に打絶れざりき"
  }
]
