[
  {
    "bookId": 18,
    "chapterId": 11,
    "verseId": 1,
    "text": "是においてナアマ人ゾパル答へて言けるは"
  },
  {
    "bookId": 18,
    "chapterId": 11,
    "verseId": 2,
    "text": "言語多からば豈答へざるを得んや 口おほき人あに義とせられんや"
  },
  {
    "bookId": 18,
    "chapterId": 11,
    "verseId": 3,
    "text": "汝も空しき言あに人をして口を閉しめんや 汝嘲らば人なんぢをして羞しめざらんや"
  },
  {
    "bookId": 18,
    "chapterId": 11,
    "verseId": 4,
    "text": "汝は言ふ 我敎は正し 我は汝の目の前に潔しと"
  },
  {
    "bookId": 18,
    "chapterId": 11,
    "verseId": 5,
    "text": "願くは神言を出し 汝にむかひて口を開き"
  },
  {
    "bookId": 18,
    "chapterId": 11,
    "verseId": 6,
    "text": "智慧の秘密をなんぢに示してその知識の相倍するを顯したまはんことを 汝しれ神はなんぢの罪よりも輕くなんぢを處置したまふなり"
  },
  {
    "bookId": 18,
    "chapterId": 11,
    "verseId": 7,
    "text": "なんぢ神の深事を窮むるを得んや 全能者を全く窮むることを得んや"
  },
  {
    "bookId": 18,
    "chapterId": 11,
    "verseId": 8,
    "text": "その高きことは天のごとし 汝なにを爲し得んや 其深きことは陰府のごとし 汝なにを知えんや"
  },
  {
    "bookId": 18,
    "chapterId": 11,
    "verseId": 9,
    "text": "その量は地よりも長く海よりも濶し"
  },
  {
    "bookId": 18,
    "chapterId": 11,
    "verseId": 10,
    "text": "彼もし行めぐりて人を執へて召集めたまふ時は誰か能くこれを阻まんや"
  },
  {
    "bookId": 18,
    "chapterId": 11,
    "verseId": 11,
    "text": "彼は僞る人を善く知りたまふ 又惡事は顧みること無して見知たまふなり"
  },
  {
    "bookId": 18,
    "chapterId": 11,
    "verseId": 12,
    "text": "虚しき人は悟性なし その生るるよりして野驢馬の駒のごとし"
  },
  {
    "bookId": 18,
    "chapterId": 11,
    "verseId": 13,
    "text": "汝もし彼にむかひて汝の心を定め 汝の手を舒べ"
  },
  {
    "bookId": 18,
    "chapterId": 11,
    "verseId": 14,
    "text": "手に罪のあらんには之を遠く去れ 惡をなんぢの幕屋に留むる勿れ"
  },
  {
    "bookId": 18,
    "chapterId": 11,
    "verseId": 15,
    "text": "然すれば汝 面を擧て玷なかるべく堅く 立て懼るる事なかるべし"
  },
  {
    "bookId": 18,
    "chapterId": 11,
    "verseId": 16,
    "text": "すなはち汝憂愁を忘れん 汝のこれを憶ゆることは流れ去し水のごとくならん"
  },
  {
    "bookId": 18,
    "chapterId": 11,
    "verseId": 17,
    "text": "なんぢの生存らふる日は眞晝よりも輝かん 假令暗き事あるとも是は平旦のごとくならん"
  },
  {
    "bookId": 18,
    "chapterId": 11,
    "verseId": 18,
    "text": "なんぢは望あるに因て安んじ 汝の周圍を見めぐりて安然に寐るにいたらん"
  },
  {
    "bookId": 18,
    "chapterId": 11,
    "verseId": 19,
    "text": "なんぢは何にも懼れさせらるること無して偃やまん 必ず衆多の者なんぢを悦こばせんと務むべし"
  },
  {
    "bookId": 18,
    "chapterId": 11,
    "verseId": 20,
    "text": "然ど惡き者は目曚み逃遁處を失なはん 其望は氣の斷ると等しかるべし"
  }
]
