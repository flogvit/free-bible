[
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 1,
    "text": "斯て後ヨブ口を啓きて自己の日を詛へり"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 2,
    "text": "ヨブすなはち言詞を出して云く"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 3,
    "text": "我が生れし日亡びうせよ 男子胎にやどれりと言し夜も亦然あれ"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 4,
    "text": "その日は暗くなれ 神上よりこれを顧みたまはざれ 光これを照す勿れ"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 5,
    "text": "暗闇および死蔭これを取もどせ 雲これが上をおほえ 日を暗くする者これを懼しめよ"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 6,
    "text": "その夜は黑暗の執ふる所となれ 年の日の中に加はらざれ 月の數に入ざれ"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 7,
    "text": "その夜は孕むこと有ざれ 歡喜の聲その中に興らざれ"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 8,
    "text": "日を詛ふ者レビヤタンを激發すに巧なる者これを詛へ"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 9,
    "text": "その夜の晨星は暗かれ その夜には光明を望むも得ざらしめ 又東雲の眼蓋を見ざらしめよ"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 10,
    "text": "是は我母の胎の戸を闔ずまた我目に憂を見ること無らしめざりしによる"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 11,
    "text": "何とて我は胎より死て出ざりしや 何とて胎より出し時に氣息たえざりしや"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 12,
    "text": "如何なれば膝ありてわれを接しや 如何なれば乳房ありてわれを養ひしや"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 13,
    "text": "否らずば今は我偃て安んじかつ眠らん 然ばこの身やすらひをり"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 14,
    "text": "かの荒墟を自己のために築きたりし世の君等臣等と偕にあり"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 15,
    "text": "かの黄金を有ち白銀を家に充したりし牧伯等と偕にあらん"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 16,
    "text": "又人しれず墮る胎兒のごとくにして世に出ず また光を見ざる赤子のごとくならん"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 17,
    "text": "彼處にては惡き者 虐遇を息め倦憊たる者安息を得"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 18,
    "text": "彼處にては俘囚人みな共に安然に居りて驅使者の聲を聞ず"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 19,
    "text": "小き者も大なる者も同じく彼處にあり僕も主の手を離る"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 20,
    "text": "如何なれば艱難にをる者に光を賜ひ 心苦しむ者に生命をたまひしや"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 21,
    "text": "斯る者は死を望むなれどもきたらず これをもとむるは藏れたる寳を掘るよりも甚だし"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 22,
    "text": "もし墳墓を尋ねて獲ば大に喜こび樂しむなり"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 23,
    "text": "その道かくれ神に取籠られをる人に如何なれば光明を賜ふや"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 24,
    "text": "わが歎息はわが食物に代り我呻吟は水の流れそそぐに似たり"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 25,
    "text": "我が戰慄き懼れし者我に臨み我が怖懼れたる者この身に及べり"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 26,
    "text": "我は安然ならず穩ならず安息を得ず唯艱難のみきたる"
  }
]
