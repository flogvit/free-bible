[
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 1,
    "text": "ヨブまた語を繼ぎていはく"
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 2,
    "text": "われに義しき審判を施したまはざる神 わが心魂をなやまし給ふ全能者此神は活く"
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 3,
    "text": "（わが生命なほ全くわれの衷にあり 神の氣息なほわが鼻にあり）"
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 4,
    "text": "わが口は惡を言ず わが舌は謊言を語らじ"
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 5,
    "text": "我決めて汝等を是とせじ 我に死るまで我が罪なきを言ことを息じ"
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 6,
    "text": "われ堅くわが正義を持ちて之を棄じ 我は今まで一日も心に責られし事なし"
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 7,
    "text": "我に敵する者は惡き者と成り我を攻る者は義からざる者と成るべし"
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 8,
    "text": "邪曲なる者もし神に絶れその魂神を脱とらるるに於ては何の望かあらん"
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 9,
    "text": "かれ艱難に罹る時に神その呼號を聽いれたまはんや"
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 10,
    "text": "かれ全能者を喜こばんや 常に神を龥んや"
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 11,
    "text": "われ神の御手を汝等に敎へん 全能者の道を汝等に隱さじ"
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 12,
    "text": "視よ汝等もみな自らこれを觀たり 然るに何ぞ斯愚蒙をきはむるや"
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 13,
    "text": "惡き人の神に得る分 強暴の人の全能者より受る業は是なり"
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 14,
    "text": "その子等蕃れば劍に殺さる その子孫は食物に飽ず"
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 15,
    "text": "その遺れる者は疫病に斃れて埋められ その妻等は哀哭をなさず"
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 16,
    "text": "かれ銀を積こと塵のごとく衣服を備ふること土のごとくなるとも"
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 17,
    "text": "その備ふる者は義き人これを着ん またその銀は無辜者これを分ち取ん"
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 18,
    "text": "その建る家は蟲の巣のごとく また番人の造る茅家のごとし"
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 19,
    "text": "彼は富る身にて寢臥し重ねて興ること無し また目を開けば即ちその身きえ亡す"
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 20,
    "text": "懼ろしき事大水のごとく彼に追及き 夜の暴風かれを奪ひ去る"
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 21,
    "text": "東風かれを颺げて去り 彼をその處より吹はらふ"
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 22,
    "text": "神かれを射て恤まず 彼その手より逃れんともがく"
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 23,
    "text": "人かれに對ひて手を鳴し 嘲りわらひてその處をいでゆかしむ"
  }
]
