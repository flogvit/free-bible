[
  {
    "bookId": 18,
    "chapterId": 14,
    "verseId": 1,
    "text": "婦の產む人はその日少なくして艱難多し"
  },
  {
    "bookId": 18,
    "chapterId": 14,
    "verseId": 2,
    "text": "その來ること花のごとくにして散り 其馳ること影のごとくにして止まらず"
  },
  {
    "bookId": 18,
    "chapterId": 14,
    "verseId": 3,
    "text": "なんぢ是のごとき者に汝の目を啓きたまふや 汝われを汝の前にひきて審判したまふや"
  },
  {
    "bookId": 18,
    "chapterId": 14,
    "verseId": 4,
    "text": "誰か清き物を汚れたる物の中より出し得る者あらん 一人も無し"
  },
  {
    "bookId": 18,
    "chapterId": 14,
    "verseId": 5,
    "text": "その日旣に定まり その月の數なんぢに由り 汝これが區域を立て越ざらしめたまふなれば"
  },
  {
    "bookId": 18,
    "chapterId": 14,
    "verseId": 6,
    "text": "是に目を離して安息を得させ 之をして傭人のその日を樂しむがごとくならしめたまへ"
  },
  {
    "bookId": 18,
    "chapterId": 14,
    "verseId": 7,
    "text": "それ木には望あり 假令砍るるとも復芽を出してその枝絶ず"
  },
  {
    "bookId": 18,
    "chapterId": 14,
    "verseId": 8,
    "text": "たとひ其根地の中に老い 幹土に枯るとも"
  },
  {
    "bookId": 18,
    "chapterId": 14,
    "verseId": 9,
    "text": "水の潤霑にあへば即ち芽をふき枝を出して若樹に異ならず"
  },
  {
    "bookId": 18,
    "chapterId": 14,
    "verseId": 10,
    "text": "然ど人は死れば消うす 人氣絶なば安に在んや"
  },
  {
    "bookId": 18,
    "chapterId": 14,
    "verseId": 11,
    "text": "水は海に竭き河は涸てかわく"
  },
  {
    "bookId": 18,
    "chapterId": 14,
    "verseId": 12,
    "text": "是のごとく人も寢臥てまた興ず 天の盡るまで目覺ず睡眠を醒さざるなり"
  },
  {
    "bookId": 18,
    "chapterId": 14,
    "verseId": 13,
    "text": "願はくは汝われを陰府に藏し 汝の震怒の息むまで我を掩ひ 我ために期を定め而して我を念ひたまへ"
  },
  {
    "bookId": 18,
    "chapterId": 14,
    "verseId": 14,
    "text": "人もし死ばまた生んや 我はわが征戰の諸日の間望みをりて我が變更の來るを待ん"
  },
  {
    "bookId": 18,
    "chapterId": 14,
    "verseId": 15,
    "text": "なんぢ我を呼たまはん 而して我こたへん 汝かならず汝の手の作を顧みたまはん"
  },
  {
    "bookId": 18,
    "chapterId": 14,
    "verseId": 16,
    "text": "今なんぢは我に歩履を數へたまふ 我罪を汝うかがひたまはざらんや"
  },
  {
    "bookId": 18,
    "chapterId": 14,
    "verseId": 17,
    "text": "わが愆は凡て嚢の中に封じてあり汝わが罪を縫こめたまふ"
  },
  {
    "bookId": 18,
    "chapterId": 14,
    "verseId": 18,
    "text": "それ山も倒れて終に崩れ巖石も移りてその處を離る"
  },
  {
    "bookId": 18,
    "chapterId": 14,
    "verseId": 19,
    "text": "水は石を鑿ち 浪は地の塵を押流す 汝は人の望を斷たまふ"
  },
  {
    "bookId": 18,
    "chapterId": 14,
    "verseId": 20,
    "text": "なんぢは彼を永く攻なやまして去ゆかしめ 彼の面容の變らせて逐やりたまふ"
  },
  {
    "bookId": 18,
    "chapterId": 14,
    "verseId": 21,
    "text": "その子尊貴なるも彼は之を知ず 卑賤なるもまた之を曉らざるなり"
  },
  {
    "bookId": 18,
    "chapterId": 14,
    "verseId": 22,
    "text": "只己みづからその肉に痛苦を覺え己みづからその心に哀く而已"
  }
]
