[
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 1,
    "text": "シユヒ人ビルダデこたへて曰く"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 2,
    "text": "汝等いつまで言語を獵求むることをするや 汝ら先曉るべし 然る後われら辨論はん"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 3,
    "text": "われら何ぞ獸畜とおもはるべけんや 何ぞ汝らの目に汚穢たる者と見らるべけんや"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 4,
    "text": "なんぢ怒りて身を裂く者よ 汝のためとて地あに棄られんや 磐あに其處より移されんや"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 5,
    "text": "惡き者の光明は滅され 其火の焔は照じ"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 6,
    "text": "その天幕の内なる光明は暗くなり其が上の燈火は滅さるべし"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 7,
    "text": "またその強き歩履は狹まり 其計るところは自分を陷いる"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 8,
    "text": "すなはち其足に逐れて網に到り また陷阱の上を歩むに"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 9,
    "text": "索はその踵に纒り 羂これを執ふ"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 10,
    "text": "索かれを執ふるために地に隱しあり 羂かれを陷しいるるために路に設けあり"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 11,
    "text": "怖ろしき事四方において彼を懼れしめ 其足にしたがひて彼をおふ"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 12,
    "text": "その力は餓ゑ 其傍には災禍そなはり"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 13,
    "text": "その膚の肢は蝕壞らる 即ち死の初子これが肢を蝕壞るなり"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 14,
    "text": "やがて彼はその恃める天幕より曳離されて懼怖の王の許に驅やられん"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 15,
    "text": "彼に屬せざる者かれの天幕に住み 硫礦かれの家の上に降ん"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 16,
    "text": "下にてはその根枯れ 上にてはその枝砍る"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 17,
    "text": "彼の跡は地に絶え 彼の名は街衢に傳はらじ"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 18,
    "text": "彼は光明の中より黑暗に逐やられ 世の中より驅出されん"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 19,
    "text": "彼はその民の中に子も無く孫も有じ また彼の住所には一人も遺る者なからん"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 20,
    "text": "之が日を見るにおいて後に來る者は駭ろき 先に出し者は怖おそれん"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 21,
    "text": "かならず惡き人の住所は是のごとく 神を知ざる者の所は是のごとくなるべし"
  }
]
