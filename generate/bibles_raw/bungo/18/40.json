[
  {
    "bookId": 18,
    "chapterId": 40,
    "verseId": 1,
    "text": "ヱホバまたヨブに對へて言たまはく"
  },
  {
    "bookId": 18,
    "chapterId": 40,
    "verseId": 2,
    "text": "非難する者ヱホバと爭はんとするや 神と論ずる者これに答ふべし"
  },
  {
    "bookId": 18,
    "chapterId": 40,
    "verseId": 3,
    "text": "ヨブ是においてヱホバに答へて曰く"
  },
  {
    "bookId": 18,
    "chapterId": 40,
    "verseId": 4,
    "text": "嗚呼われは賤しき者なり 何となんぢに答へまつらんや 唯手をわが口に當んのみ"
  },
  {
    "bookId": 18,
    "chapterId": 40,
    "verseId": 5,
    "text": "われ已に一度言たり 復いはじ 已に再度せり 重ねて述じ"
  },
  {
    "bookId": 18,
    "chapterId": 40,
    "verseId": 6,
    "text": "是に於てヱホバまた大風の中よりヨブに應へて言たまはく"
  },
  {
    "bookId": 18,
    "chapterId": 40,
    "verseId": 7,
    "text": "なんぢ腰ひきからげて丈夫のごとくせよ 我なんぢに問ん なんぢ我にこたへよ"
  },
  {
    "bookId": 18,
    "chapterId": 40,
    "verseId": 8,
    "text": "なんぢ我審判を廢んとするや 我を非として自身を是とせんとするや"
  },
  {
    "bookId": 18,
    "chapterId": 40,
    "verseId": 9,
    "text": "なんぢ神のごとき腕ありや 神のごとき聲をもて轟きわたらんや"
  },
  {
    "bookId": 18,
    "chapterId": 40,
    "verseId": 10,
    "text": "さればなんぢ威光と尊貴とをもて自ら飾り 榮光と華美とをもて身に纒へ"
  },
  {
    "bookId": 18,
    "chapterId": 40,
    "verseId": 11,
    "text": "なんぢの溢るる震怒を洩し 高ぶる者を視とめて之をことごとく卑くせよ"
  },
  {
    "bookId": 18,
    "chapterId": 40,
    "verseId": 12,
    "text": "すなはち高ぶる者を見てこれを盡く鞠ませ また惡人を立所に踐つけ"
  },
  {
    "bookId": 18,
    "chapterId": 40,
    "verseId": 13,
    "text": "これを塵の中に埋め これが面を隱れたる處に閉こめよ"
  },
  {
    "bookId": 18,
    "chapterId": 40,
    "verseId": 14,
    "text": "さらば我もなんぢを讚てなんぢの右の手なんぢを救ひ得ると爲ん"
  },
  {
    "bookId": 18,
    "chapterId": 40,
    "verseId": 15,
    "text": "今なんぢ我がなんぢとともに造りたりし河馬を視よ 是は牛のごとく草を食ふ"
  },
  {
    "bookId": 18,
    "chapterId": 40,
    "verseId": 16,
    "text": "觀よその力は腰にあり その勢力は腹の筋にあり"
  },
  {
    "bookId": 18,
    "chapterId": 40,
    "verseId": 17,
    "text": "その尾の搖く樣は香柏のごとく その腿の筋は彼此に盤互ふ"
  },
  {
    "bookId": 18,
    "chapterId": 40,
    "verseId": 18,
    "text": "その骨は銅の管ごとくその肋骨は鐡の棒のごとし"
  },
  {
    "bookId": 18,
    "chapterId": 40,
    "verseId": 19,
    "text": "これは神の工の第一なる者にして之を造りし者これに劍を賦けたり"
  },
  {
    "bookId": 18,
    "chapterId": 40,
    "verseId": 20,
    "text": "山もこれがために食物を產出し もろもろの野獸そこに遊ぶ"
  },
  {
    "bookId": 18,
    "chapterId": 40,
    "verseId": 21,
    "text": "これは蓮の樹の下に臥し 葦蘆の中または沼の裏に隱れをる"
  },
  {
    "bookId": 18,
    "chapterId": 40,
    "verseId": 22,
    "text": "蓮の樹その蔭をもてこれを覆ひ また河の柳これを環りかこむ"
  },
  {
    "bookId": 18,
    "chapterId": 40,
    "verseId": 23,
    "text": "たとひ河荒くなるとも驚ろかず ヨルダンその口に注ぎかかるも惶てず"
  },
  {
    "bookId": 18,
    "chapterId": 40,
    "verseId": 24,
    "text": "その目の前にて誰か之を執ふるを得ん 誰か羂をその鼻に貫ぬくを得ん"
  }
]
