[
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 1,
    "text": "白銀掘いだす坑あり 煉るところの黄金は出處あり"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 2,
    "text": "鐡は土より取り 銅は石より鎔して獲るなり"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 3,
    "text": "人すなはち黑暗を破り極より極まで尋ね窮めて黑暗および死蔭の石を求む"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 4,
    "text": "その穴を穿つこと深くして上に住む人と遠く相離れ その上を歩む者まつたく之を覺えず 是のごとく身を縋下げ 遙に人と隔りて空に懸る"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 5,
    "text": "地その上は食物を出し 其下は火に覆へさるるがごとく覆へる"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 6,
    "text": "その石の中には碧の玉のある處あり 黄金の沙またその内にあり"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 7,
    "text": "その逕は鷙鳥もこれを知ず 鷹の目もこれを看ず"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 8,
    "text": "鷙き獸も未だこれを踐ず 猛き獅子も未だこれを通らず"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 9,
    "text": "人堅き磐に手を加へまた山を根より倒し"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 10,
    "text": "岩に河を掘り各種の貴き物を目に見とめ"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 11,
    "text": "水路を塞ぎて漏ざらしめ隱れたる寳物を光明に取いだすなり"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 12,
    "text": "然ながら智慧は何處よりか覓め得ん 明哲の在る所は何處ぞや"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 13,
    "text": "人その價を知ず人のすめる地に獲べからず"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 14,
    "text": "淵は言ふ我の内に在ずと 海は言ふ我と偕ならずと"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 15,
    "text": "精金も之に換るに足ず 銀も秤りてその價となすを得ず"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 16,
    "text": "オフルの金にてもその價を量るべからず 貴き靑玉も碧玉もまた然り"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 17,
    "text": "黄金も玻璃もこれに並ぶ能はず 精金の器皿も之に換るに足ず"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 18,
    "text": "珊瑚も水晶も論にたらず 智慧を得るは眞珠を得るに勝る"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 19,
    "text": "エテオビアより出る黄玉もこれに並ぶあたはず 純金をもてするともその價を量るべからず"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 20,
    "text": "然ば智慧は何處より來るや 明哲の在る所は何處ぞや"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 21,
    "text": "是は一切の生物の目に隱れ 天空の鳥にも見えず"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 22,
    "text": "滅亡も死も言ふ 我等はその風聲を耳に聞し而已"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 23,
    "text": "神その道を曉り給ふ 彼その所を知りたまふ"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 24,
    "text": "そは彼は地の極までも觀そなはし天が下を看きはめたまへばなり"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 25,
    "text": "風にその重量を與へ 水を度りてその量を定めたまひし時"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 26,
    "text": "雨のために法を立て 雷霆の光のために途を設けたまひし時"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 27,
    "text": "智慧を見て之を顯はし之を立て試みたまへり"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 28,
    "text": "また人に言たまはく視よ主を畏るるは是智慧なり 惡を離るるは明哲なり"
  }
]
