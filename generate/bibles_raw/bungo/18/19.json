[
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 1,
    "text": "ヨブこたへて曰く"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 2,
    "text": "汝ら我心をなやまし 言語をもて我を打くだくこと何時までぞや"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 3,
    "text": "なんぢら已に十次も我を辱しめ我を惡く待ひてなほ愧るところ無し"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 4,
    "text": "假令われ眞に過ちたらんもその過は我の身に止れり"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 5,
    "text": "なんぢら眞に我に向ひて誇り我身に羞べき行爲ありと證するならば"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 6,
    "text": "神われを虐げその網羅をもて我を包みたまへりと知るべし"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 7,
    "text": "我虐げらるると叫べども答なく 呼はり求むれども審理なし"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 8,
    "text": "彼わが路の周圍に垣を結めぐらして逾る能はざらしめ 我が行く途に黑暗を蒙むらしめ"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 9,
    "text": "わが光榮を褫ぎ我冠冕を首より奪ひ"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 10,
    "text": "四方より我を毀ちて失しめ 我望を樹のごとくに根より拔き"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 11,
    "text": "我にむかひて震怒を燃し 我を敵の一人と見たまへり"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 12,
    "text": "その軍旅ひとしく進み途を高くして我に攻寄せ わが天幕の周圍に陣を張り"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 13,
    "text": "彼わが兄弟等をして遠くわれを離れしめたまへり 我を知る人々は全く我に疎くなりぬ"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 14,
    "text": "わが親戚は往來を休め わが朋友はわれを忘れ"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 15,
    "text": "わが家に寄寓る者およびわが婢等は我を見て外人のごとくす 我かれらの前にては異國人のごとし"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 16,
    "text": "われわが僕を喚どもこたへず 我口をもて彼に請はざるを得ざるなり"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 17,
    "text": "わが氣息はわが妻に厭はれ わが臭氣はわが同胎の子等に嫌はる"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 18,
    "text": "童子等さへも我を侮どり 我起あがれば即ち我を嘲ける"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 19,
    "text": "わが親しき友われを惡みわが愛したる人々ひるがへりてわが敵となれり"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 20,
    "text": "わが骨はわが皮と肉とに貼り 我は僅に齒の皮を全うして逃れしのみ"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 21,
    "text": "わが友よ汝等われを恤れめ 我を恤れめ 神の手われを撃り"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 22,
    "text": "汝らなにとて神のごとくして我を攻め わが肉に饜ことなきや"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 23,
    "text": "望むらくは我言の書留られんことを 望むらくは我言書に記されんことを"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 24,
    "text": "望むらくは鐡の筆と鉛とをもて之を永く磐石に鐫つけおかんことを"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 25,
    "text": "われ知る我を贖ふ者は活く 後の日に彼かならず地の上に立ん"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 26,
    "text": "わがこの皮この身の朽はてん後 われ肉を離れて神を見ん"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 27,
    "text": "我みづから彼を見たてまつらん 我目かれを見んに識らぬ者のごとくならじ 我が心これを望みて焦る"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 28,
    "text": "なんぢら若われら如何に彼を攻んかと言ひ また事の根われに在りと言ば"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 29,
    "text": "劍を懼れよ 忿怒は劍の罰をきたらす 斯なんぢら遂に審判のあるを知ん"
  }
]
