[
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 1,
    "text": "之がためにわが心わななき その處を動き離る"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 2,
    "text": "神の聲の響およびその口より出る轟聲を善く聽け"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 3,
    "text": "これを天が下に放ち またその電光を地の極にまで至らせたまふ"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 4,
    "text": "その後聲ありて打響き 彼威光の聲を放ちて鳴わたりたまふ その御聲聞えしむるに當りては電光を押へおきたまはず"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 5,
    "text": "神奇しくも御聲を放ちて鳴わたり 我儕の知ざる大なる事を行ひたまふ"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 6,
    "text": "かれ雪にむかひて地に降れと命じたまふ 雨すなはちその權能の大雨にも亦しかり"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 7,
    "text": "斯かれ一切の人の手を封じたまふ 是すべての人にその御工作を知しめんがためなり"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 8,
    "text": "また獸は穴にいりてその洞に居る"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 9,
    "text": "南方の密室より暴風きたり 北より寒氣きたる"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 10,
    "text": "神の氣吹によりて氷いできたり 水の寛狹くせらる"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 11,
    "text": "かれ水をもて雲に搭載せまた電光の雲を遠く散したまふ"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 12,
    "text": "是は神の導引によりて週る 是は彼の命ずるところを盡く世界の表面に爲んがためなり"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 13,
    "text": "その之を來らせたまふは或は懲罰のため あるひはその地のため 或は恩惠のためなり"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 14,
    "text": "ヨブよ是を聽け 立ちて神の奇妙き工作を考がへよ"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 15,
    "text": "神いかに是等に命を傳へその雲の光明をして輝やかせたまふか汝これを知るや"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 16,
    "text": "なんぢ雲の平衡知識の全たき者の奇妙き工作を知るや"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 17,
    "text": "南風によりて地の穩かになる時なんぢの衣服は熱くなるなり"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 18,
    "text": "なんぢ彼とともに彼の堅くして鑄たる鏡のごとくなる蒼穹を張ることを能せんや"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 19,
    "text": "われらが彼に言ふべき事を我らに敎へよ 我らは暗昧して言詞を列ぬること能はざるなり"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 20,
    "text": "われ語ることありと彼に告ぐべけんや 人あに滅ぼさるることを望まんや"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 21,
    "text": "人いまは雲霄に輝やく光明を見ること能はず 然れど風きたりて之を吹清む"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 22,
    "text": "北より黄金いできたる 神には畏るべき威光あり"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 23,
    "text": "全能者はわれら測りきはむることを得ず 彼は能おほいなる者にいまし審判をも公義をも抂たまはざるなり"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 24,
    "text": "この故に人々かれを畏る 彼はみづから心に有智とする者をかへりみたまはざるなり"
  }
]
