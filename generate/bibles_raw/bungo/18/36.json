[
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 1,
    "text": "エリフまた言詞を繼て曰く"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 2,
    "text": "暫らく我に容せ我なんぢに示すこと有ん 尚神のために言ふべき事あればなり"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 3,
    "text": "われ廣くわが知識を取り我の造化主に正義を歸せんとす"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 4,
    "text": "わが言語は眞實に虚僞ならず 知識の完全き者なんぢの前にあり"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 5,
    "text": "視よ神は權能ある者にましませども何をも藐視めたまはず その了知の能力は大なり"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 6,
    "text": "惡しき者を生し存ず 艱難者のために審判を行ひたまふ"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 7,
    "text": "義しき者に目を離さず 位にある王等とともに永遠に坐せしめて之を貴くしたまふ"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 8,
    "text": "もし彼ら鏈索に繋がれ 艱難の繩にかかる時は"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 9,
    "text": "彼らの所行と愆尤とを示してその驕れるを知せ"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 10,
    "text": "彼らの耳を開きて敎を容れしめ かつ惡を離れて歸れよと彼らに命じたまふ"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 11,
    "text": "もし彼ら聽したがひて之に事へなば繁昌てその日を送り 樂しくその年を渉らん"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 12,
    "text": "若かれら聽したがはずば刀劍にて亡び 知識を得ずして死なん"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 13,
    "text": "しかれども心の邪曲なる者等は忿怒を蓄はへ 神に縛しめらるるとも祈ることを爲ず"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 14,
    "text": "かれらは年わかくして死亡せ 男娼とその生命をひとしうせん"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 15,
    "text": "神は艱難者を艱難によりて救ひ 之が耳を虐遇によりて開きたまふ"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 16,
    "text": "然ば神また汝を狹きところより出して狹からぬ廣き所に移したまふあらん 而して汝の席に陳ぬる物は凡て肥たる物ならん"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 17,
    "text": "今は惡人の鞫罰なんぢの身に充り 審判と公義となんぢを執ふ"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 18,
    "text": "なんぢ忿怒に誘はれて嘲笑に陷いらざるやう愼しめよ 收贖の大なるが爲に自ら誤るなかれ"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 19,
    "text": "なんぢの號叫なんぢを艱難の中より出さんや 如何に力を盡すとも所益あらじ"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 20,
    "text": "世の人のその處より絶る其夜を慕ふなかれ"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 21,
    "text": "愼しみて惡に傾むくなかれ 汝は艱難よりも寧ろ之を取んとせり"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 22,
    "text": "それ神はその權能をもて大なる事を爲したまふ 誰か能く彼のごとくに敎晦を埀んや"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 23,
    "text": "たれか彼のためにその道を定めし者あらんや 誰かなんぢは惡き事をなせりと言ふことを得ん"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 24,
    "text": "なんぢ神の御所爲を讚歎ふることを忘れざれ これ世の人の歌ひ崇むる所なり"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 25,
    "text": "人みな之を仰ぎ觀る 遠き方より人これを視たてまつるなり"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 26,
    "text": "神は大なる者にいまして我儕かれを知たてまつらず その御年の數は計り知るべからず"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 27,
    "text": "かれ水を細にして引あげたまへば霧の中に滴り出て雨となるに"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 28,
    "text": "雲これを降せて人々の上に沛然に灌ぐなり"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 29,
    "text": "たれか能く雲の舒展る所以 またその幕屋の響く所以を了知んや"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 30,
    "text": "視よ彼その光明を自己の周圍に繞らし また海の底をも蔽ひたまひ"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 31,
    "text": "これらをもて民を鞫き また是等をもて食物を豐饒に賜ひ"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 32,
    "text": "電光をもてその兩手を包み その電光に命じて敵を撃しめたまふ"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 33,
    "text": "その鳴聲かれを顯はし 家畜すらも彼の來ますを知らすなり"
  }
]
