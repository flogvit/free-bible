[
  {
    "bookId": 18,
    "chapterId": 17,
    "verseId": 1,
    "text": "わが氣息は已にくさり 我日すでに盡なんとし墳墓われを待つ"
  },
  {
    "bookId": 18,
    "chapterId": 17,
    "verseId": 2,
    "text": "まことに嘲弄者等わが傍に在り 我目は彼らの辨爭ふを常に見ざるを得ず"
  },
  {
    "bookId": 18,
    "chapterId": 17,
    "verseId": 3,
    "text": "願くは質を賜ふて汝みづから我の保證となりたまへ 誰か他にわが手をうつ者あらんや"
  },
  {
    "bookId": 18,
    "chapterId": 17,
    "verseId": 4,
    "text": "汝彼らの心を閉て悟るところ無らしめたまへり 必ず彼らをして愈らしめたまはじ"
  },
  {
    "bookId": 18,
    "chapterId": 17,
    "verseId": 5,
    "text": "朋友を交付して掠奪に遭しむる者は其子等の目潰るべし"
  },
  {
    "bookId": 18,
    "chapterId": 17,
    "verseId": 6,
    "text": "彼われを世の民の笑柄とならしめたまふ 我は面に唾せらるべき者となれり"
  },
  {
    "bookId": 18,
    "chapterId": 17,
    "verseId": 7,
    "text": "かつまた我目は憂愁によりて昏み 肢體は凡て影のごとし"
  },
  {
    "bookId": 18,
    "chapterId": 17,
    "verseId": 8,
    "text": "義しき者は之に驚き 無辜者は邪曲なる者を見て憤ほる"
  },
  {
    "bookId": 18,
    "chapterId": 17,
    "verseId": 9,
    "text": "然ながら義しき者はその道を堅く持ち 手の潔淨き者はますます力を得るなり"
  },
  {
    "bookId": 18,
    "chapterId": 17,
    "verseId": 10,
    "text": "請ふ汝ら皆ふたたび來れ 我は汝らの中に一人も智き者あるを見ざるなり"
  },
  {
    "bookId": 18,
    "chapterId": 17,
    "verseId": 11,
    "text": "わが日は已に過ぎ わが計る所わが心に冀ふ所は已に敗れたり"
  },
  {
    "bookId": 18,
    "chapterId": 17,
    "verseId": 12,
    "text": "彼ら夜を晝に變ふ 黑暗の前に光明ちかづく"
  },
  {
    "bookId": 18,
    "chapterId": 17,
    "verseId": 13,
    "text": "我もし俟つところ有ば是わが家たるべき陰府なるのみ 我は黑暗にわが牀を展ぶ"
  },
  {
    "bookId": 18,
    "chapterId": 17,
    "verseId": 14,
    "text": "われ朽腐に向ひては汝はわが父なりと言ひ 蛆に向ひては汝は我母わが姉妹なりと言ふ"
  },
  {
    "bookId": 18,
    "chapterId": 17,
    "verseId": 15,
    "text": "然ばわが望はいづくにかある 我望は誰かこれを見る者あらん"
  },
  {
    "bookId": 18,
    "chapterId": 17,
    "verseId": 16,
    "text": "是は下りて陰府の關に到らん 之と齊しく我身は塵の中に臥靜まるべし"
  }
]
