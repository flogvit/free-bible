[
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 1,
    "text": "視よわが目これを盡く觀 わが耳これを聞て通逹れり"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 2,
    "text": "汝らが知るところは我もこれを知る 我は汝らに劣らず"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 3,
    "text": "然りと雖ども我は全能者に物言ん 我は神と論ぜんことをのぞむ"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 4,
    "text": "汝らは只謊言を造り設くる者 汝らは皆無用の醫師なり"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 5,
    "text": "願くは汝ら全く默せよ 然するは汝らの智慧なるべし"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 6,
    "text": "請ふわが論ずる所を聽き 我が唇にて辨爭ふ所を善く聽け"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 7,
    "text": "神のために汝ら惡き事を言や 又かれのために虚僞を述るや"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 8,
    "text": "汝ら神の爲に偏るや またかれのために爭はんとするや"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 9,
    "text": "神もし汝らを鑒察たまはば豈善らんや 汝等人を欺むくごとくに彼を欺むき得んや"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 10,
    "text": "汝等もし密に私しするあらば彼かならず汝らを責ん"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 11,
    "text": "その威光なんぢらを懼れしめざらんや 彼を懼るる畏懼なんぢらに臨まざらんや"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 12,
    "text": "なんぢらの諭言は灰に譬ふべし なんぢらの城は土の城となる"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 13,
    "text": "默して我にかかはらざれ 我言語んとす 何事にもあれ我に來らば來れ"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 14,
    "text": "我なんぞ我肉をわが齒の間に置き わが生命をわが手に置かんや"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 15,
    "text": "彼われを殺すとも我は彼に依賴まん 唯われは吾道を彼の前に明かにせんとす"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 16,
    "text": "彼また終に我救拯とならん 邪曲なる者は彼の前にいたること能はざればなり"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 17,
    "text": "なんぢら聽よ 我言を聽け我が述る所をなんぢらの耳に入しめよ"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 18,
    "text": "視よ我すでに吾事を言竝べたり 必ず義しとせられんと自ら知る"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 19,
    "text": "誰か能われと辨論ふ者あらん 若あらば我は口を緘て死ん"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 20,
    "text": "惟われに二の事を爲たまはざれ 然ば我なんぢの面をさけて隱れじ"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 21,
    "text": "なんぢの手を我より離したまへ 汝の威嚴をもて我を懼れしめたまはざれ"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 22,
    "text": "而して汝われを召たまへ 我こたへん 又われにも言はしめて汝われに答へたまへ"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 23,
    "text": "我の愆われの罪いくばくなるや 我の背反と罪とを我に知しめたまへ"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 24,
    "text": "何とて御顏を隱し我をもて汝の敵となしたまふや"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 25,
    "text": "なんぢは吹廻さるる木の葉を威し 干あがりたる籾殼を追たまふや"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 26,
    "text": "汝は我につきて苦き事等を書しるし 我をして我が幼稚時の罪を身に負しめ"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 27,
    "text": "わが足を足械にはめ 我すべての道を伺ひ 我足の周圍に限界をつけたまふ"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 28,
    "text": "我は腐れたる者のごとくに朽ゆき 蠹に食るる衣服に等し"
  }
]
