[
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 1,
    "text": "時にシユヒ人ビルダデ答へて曰く"
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 2,
    "text": "何時まで汝かかる事を言や 何時まで汝の口の言語を大風のごとくにするや"
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 3,
    "text": "神あに審判を曲たまはんや 全能者あに公義を曲たまはんや"
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 4,
    "text": "汝の子等かれに罪を獲たるにや之をその愆の手に付したまへり"
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 5,
    "text": "汝もし神に求め 全能者に祈り"
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 6,
    "text": "清くかつ正しうしてあらば必ず今汝を顧み汝の義き家を榮えしめたまはん"
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 7,
    "text": "然らば汝の始は微小くあるとも汝の終は甚だ大ならん"
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 8,
    "text": "請ふ汝過にし代の人に問へ 彼らの父祖の尋究めしところの事を學べ"
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 9,
    "text": "(我らは昨日より有しのみにて何をも知ず 我らが世にある日は影のごとし)"
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 10,
    "text": "彼等なんぢを敎へ汝を諭し 言をその心より出さざらんや"
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 11,
    "text": "葦あに泥なくして長んや 萩あに水なくしてそだたんや"
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 12,
    "text": "是はその靑くして未だ刈ざる時にも他の一切の草よりは早く槁る"
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 13,
    "text": "神を忘るる者の道は凡て是のごとく 悖る者の望は空しくなる"
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 14,
    "text": "その恃む所は絶れ その倚ところは蜘蛛網のごとし"
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 15,
    "text": "その家に倚かからんとすれば家立ず 之に堅くとりすがるも保たじ"
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 16,
    "text": "彼日の前に靑緑を呈はし その枝を園に蔓延らせ"
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 17,
    "text": "その根を石堆に盤みて石の屋を眺むれども"
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 18,
    "text": "若その處より取のぞかれなばその處これを認めずして我は汝を見たる事なしと言ん"
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 19,
    "text": "視よその道の喜樂是のごとし 而してまた他の者地より生いでん"
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 20,
    "text": "それ神は完全人を棄たまはず また惡き者の手を執りたまはず"
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 21,
    "text": "遂に哂笑をもて汝の口に充し歡喜を汝の唇に置たまはん"
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 22,
    "text": "汝を惡む者は羞恥を着せられ 惡き者の住所は無なるべし"
  }
]
