[
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 1,
    "text": "ナアマ人ゾパルこたへて曰く"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 2,
    "text": "これに因てわれ答をなすの思念を起し心しきりに之がために急る"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 3,
    "text": "我を辱しむる警語を我聞ざるを得ず 然しながらわが了知の性われをして答ふることを得せしむ"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 4,
    "text": "なんぢ知ずや古昔より地に人の置れしより以來"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 5,
    "text": "惡き人の勝誇は暫時にして邪曲なる者の歡樂は時の間のみ"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 6,
    "text": "その高天に逹しその首雲に及ぶとも"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 7,
    "text": "終には己の糞のごとくに永く亡絶べし 彼を見識る者は言ん彼は何處にありやと"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 8,
    "text": "彼は夢の如く過さりて復見るべからず 夜の幻のごとく追はらはれん"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 9,
    "text": "彼を見たる目かさねてかれを見ることあらず 彼の住たる處も再びかれを見ること無らん"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 10,
    "text": "その子等は貧しき者に寛待を求めん 彼もまたその取し貨財を手づから償さん"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 11,
    "text": "その骨に少壯氣勢充り 然れどもその氣勢もまた塵の中に彼とおなじく臥ん"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 12,
    "text": "かれ惡を口に甘しとして舌の底に藏め"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 13,
    "text": "愛みて捨ず 之を口の中に含みをる"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 14,
    "text": "然どその食物膓の中にて變り 腹の内にて蝮の毒とならん"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 15,
    "text": "かれ貨財を呑たれども復之を吐いださん 神これを彼の腹より推いだしたまふべし"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 16,
    "text": "かれは蝮の毒を吸ひ 虺の舌に殺されん"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 17,
    "text": "かれは蜂蜜と牛酪の湧て流るる河川を視ざらん"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 18,
    "text": "その勞苦て獲たる物は之を償して自ら食はず 又それを求めたる所有よりは快樂を得じ"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 19,
    "text": "是は彼貧しき者を虐遇げて之を棄たればなり 假令家を奪ひとるとも之を改め作ることを得ざらん"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 20,
    "text": "かれはその腹に飽ことを知ざるが故に自己の深く喜ぶ物をも保つこと能はじ"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 21,
    "text": "かれが遺して食はざる物とては一も無し 是によりてその福祉は永く保たじ"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 22,
    "text": "その繁榮の眞盛において彼は艱難に迫られ 乏しき者すべて手をこれが上に置ん"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 23,
    "text": "かれ腹を充さんとすれば神烈しき震怒をその上に下し その食する時にこれをその上に降したまふ"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 24,
    "text": "かれ鐡の器を避れば銅の弓これを射透す"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 25,
    "text": "是に於て之をその身より拔ば閃く鏃その膽より出きたりて畏懼これに臨む"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 26,
    "text": "各種の黑暗これが寳物ををほろぼすために蓄へらる 又人の吹おこせしに非る火かれを焚き その天幕に遺りをる者をも焚ん"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 27,
    "text": "天かれの罪を顯はし 地興りて彼を攻ん"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 28,
    "text": "その家の儲蓄は亡て神の震怒の日に流れ去ん"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 29,
    "text": "是すなはち惡き人が神より受る分 神のこれに定めたまへる數なり"
  }
]
