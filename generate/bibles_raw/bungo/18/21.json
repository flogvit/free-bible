[
  {
    "bookId": 18,
    "chapterId": 21,
    "verseId": 1,
    "text": "ヨブこたへて曰く"
  },
  {
    "bookId": 18,
    "chapterId": 21,
    "verseId": 2,
    "text": "請ふ汝等わが言を謹んで聽き 之をもて汝らの慰藉に代よ"
  },
  {
    "bookId": 18,
    "chapterId": 21,
    "verseId": 3,
    "text": "先われに容して言しめよ 我が言る後なんぢ嘲るも可し"
  },
  {
    "bookId": 18,
    "chapterId": 21,
    "verseId": 4,
    "text": "わが怨言は世の人の上につきて起れる者ならんや 我なんぞ氣をいらだつ可らざらんや"
  },
  {
    "bookId": 18,
    "chapterId": 21,
    "verseId": 5,
    "text": "なんぢら我を視て驚き手を口にあてよ"
  },
  {
    "bookId": 18,
    "chapterId": 21,
    "verseId": 6,
    "text": "われ思ひまはせば畏しくなりて身體しきりに戰慄く"
  },
  {
    "bookId": 18,
    "chapterId": 21,
    "verseId": 7,
    "text": "惡き人何とて生ながらへ 老かつ勢力強くなるや"
  },
  {
    "bookId": 18,
    "chapterId": 21,
    "verseId": 8,
    "text": "その子等はその周圍にありてその前に堅く立ち その子孫もその目の前に堅く立べし"
  },
  {
    "bookId": 18,
    "chapterId": 21,
    "verseId": 9,
    "text": "またその家は平安にして畏懼なく 神の杖その上に臨まじ"
  },
  {
    "bookId": 18,
    "chapterId": 21,
    "verseId": 10,
    "text": "その牡牛は種を與へて過らず その牝牛は子を產てそこなふ事なし"
  },
  {
    "bookId": 18,
    "chapterId": 21,
    "verseId": 11,
    "text": "彼等はその少き者等を外に出すこと群のごとし その子等は舞をどる"
  },
  {
    "bookId": 18,
    "chapterId": 21,
    "verseId": 12,
    "text": "彼等は鼓と琴とをもて歌ひ 笛の音に由て樂み"
  },
  {
    "bookId": 18,
    "chapterId": 21,
    "verseId": 13,
    "text": "その日を幸福に暮し まばたくまに陰府にくだる"
  },
  {
    "bookId": 18,
    "chapterId": 21,
    "verseId": 14,
    "text": "然はあれども彼等は神に言らく我らを離れ賜へ 我らは汝の道をしることを好まず"
  },
  {
    "bookId": 18,
    "chapterId": 21,
    "verseId": 15,
    "text": "全能者は何者なれば我らこれに事ふべき 我儕これに祈るとも何の益を得んやと"
  },
  {
    "bookId": 18,
    "chapterId": 21,
    "verseId": 16,
    "text": "視よ彼らの福祿は彼らの力に由にあらざるなり 惡人の希圖は我の與する所にあらず"
  },
  {
    "bookId": 18,
    "chapterId": 21,
    "verseId": 17,
    "text": "惡人のその燈火を滅るる事幾度ありしか その滅亡のこれに臨む事 神の怒りて之に艱苦を蒙らせたまふ事幾度有しか"
  },
  {
    "bookId": 18,
    "chapterId": 21,
    "verseId": 18,
    "text": "かれら風の前の藁の如く 暴風に吹さらるる籾殼の如くなること幾度有しか"
  },
  {
    "bookId": 18,
    "chapterId": 21,
    "verseId": 19,
    "text": "神かれの愆を積たくはへてその子孫に報いたまふか 之を彼自己の身に報い知しむるに如ず"
  },
  {
    "bookId": 18,
    "chapterId": 21,
    "verseId": 20,
    "text": "かれをして自らその滅亡を目に視させ かつ全能者の震怒を飮しめよ"
  },
  {
    "bookId": 18,
    "chapterId": 21,
    "verseId": 21,
    "text": "その月の數すでに盡るに於ては何ぞその後の家に關はる所あらん"
  },
  {
    "bookId": 18,
    "chapterId": 21,
    "verseId": 22,
    "text": "神は天にある者等をさへ審判たまふなれば誰か能これに知識を敎へんや"
  },
  {
    "bookId": 18,
    "chapterId": 21,
    "verseId": 23,
    "text": "或人は繁榮を極め全く平穩にかつ安康にして死に"
  },
  {
    "bookId": 18,
    "chapterId": 21,
    "verseId": 24,
    "text": "その器に乳充ち その骨の髓は潤ほへり"
  },
  {
    "bookId": 18,
    "chapterId": 21,
    "verseId": 25,
    "text": "また或人は心を苦しめて死し 終に福祉をあぢはふる事なし"
  },
  {
    "bookId": 18,
    "chapterId": 21,
    "verseId": 26,
    "text": "是等は倶に齊しく塵に臥して蛆におほはる"
  },
  {
    "bookId": 18,
    "chapterId": 21,
    "verseId": 27,
    "text": "我まことに汝らの思念を知り 汝らが我を攻撃んとするの計略を知る"
  },
  {
    "bookId": 18,
    "chapterId": 21,
    "verseId": 28,
    "text": "なんぢらは言ふ王侯の家は何に在る 惡人の住所は何にあると"
  },
  {
    "bookId": 18,
    "chapterId": 21,
    "verseId": 29,
    "text": "汝らは路往く人々に詢ざりしや 彼等の證據を曉らざるや"
  },
  {
    "bookId": 18,
    "chapterId": 21,
    "verseId": 30,
    "text": "すなはち滅亡の日に惡人遺され 烈しき怒の日に惡人たづさへ出さる"
  },
  {
    "bookId": 18,
    "chapterId": 21,
    "verseId": 31,
    "text": "誰か能かれに打向ひて彼の行爲を指示さんや 誰か能彼の爲たる所を彼に報ゆることを爲ん"
  },
  {
    "bookId": 18,
    "chapterId": 21,
    "verseId": 32,
    "text": "彼は舁れて墓に到り 塚の上にて守護ることを爲す"
  },
  {
    "bookId": 18,
    "chapterId": 21,
    "verseId": 33,
    "text": "谷の土塊も彼には快し 一切の人その後に從ふ 其前に行る者も數へがたし"
  },
  {
    "bookId": 18,
    "chapterId": 21,
    "verseId": 34,
    "text": "旣に是の如くなるに汝等なんぞ徒に我を慰さめんとするや 汝らの答ふる所はただ虚僞のみ"
  }
]
