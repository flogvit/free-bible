[
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 1,
    "text": "我はかれの震怒の笞によりて艱難に遭たる人なり"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 2,
    "text": "かれは我をひきて黑暗をあゆませ光明にゆかしめたまはず"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 3,
    "text": "まことに屢々その手をむけて終日われを攻なやまし"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 4,
    "text": "わが肉と肌膚をおとろへしめ わが骨を摧き"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 5,
    "text": "われにむかひて患苦と艱難を築きこれをもて我を圍み"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 6,
    "text": "われをして長久に死し者のごとく暗き處に住しめ"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 7,
    "text": "我をかこみて出ること能はざらしめわが鏈索を重くしたまへり"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 8,
    "text": "我さけびて助をもとめしとき彼わが祈禱をふせぎ"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 9,
    "text": "斫たる石をもてわが道を塞ぎわが途をまげたまへり"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 10,
    "text": "その我に對することは伏て伺がふ熊のごとく潜みかくるる獅子のごとし"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 11,
    "text": "われに路を離れしめ 我をひきさきて獨くるしましめ"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 12,
    "text": "弓を張りてわれを矢先の的となし"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 13,
    "text": "矢筒の矢をもてわが腰を射ぬきたまへり"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 14,
    "text": "われはわがすべての民のあざけりとなり 終日うたひそしらる"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 15,
    "text": "かれ我をして苦き物に飽しめ茵蔯を飮しめ"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 16,
    "text": "小石をもてわが齒を摧き灰をもて我を蒙ひたまへり"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 17,
    "text": "なんぢわが靈魂をして平和を遠くはなれしめたまへば我は福祉をわすれたり"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 18,
    "text": "是において我みづから言り わが氣力うせゆきぬ ヱホバより何を望むべきところ無しと"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 19,
    "text": "ねがはくは我が艱難と苦楚茵蔯と膽汁とを心に記たまへ"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 20,
    "text": "わがたましひは今なほ是らの事を想ひてわが衷に鬱ぐ"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 21,
    "text": "われこの事を心におもひ起せり この故に望をいだくなり"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 22,
    "text": "われらの尚ほろびざるはヱホバの仁愛によりその憐憫の盡ざるに因る"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 23,
    "text": "これは朝ごとに新なり なんぢの誠實はおほいなるかな"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 24,
    "text": "わが靈魂は言ふ ヱホバはわが分なり このゆゑに我彼を待ち望まん"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 25,
    "text": "ヱホバはおのれを待ち望む者とおのれを尋ねもとむる人に恩惠をほどこしたまふ"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 26,
    "text": "ヱホバの救拯をのぞみて靜にこれを待は善し"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 27,
    "text": "人わかき時に軛を負は善し"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 28,
    "text": "ヱホバこれを負せたまふなれば獨坐して默すべし"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 29,
    "text": "口を塵につけよ あるひは望あらん"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 30,
    "text": "おのれを撃つ者に頬をむけ 充足れるまでに恥辱をうけよ"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 31,
    "text": "そは主は永久に棄ることを爲たまはざるべければなり"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 32,
    "text": "かれは患難を與へ給ふといへどもその慈悲おほいなればまた憐憫を加へたまふなり"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 33,
    "text": "心より世の人をなやましかつ苦しめ給ふにはあらざるなり"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 34,
    "text": "世のもろもろの俘囚人を脚の下にふみにじり"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 35,
    "text": "至高者の面の前にて人の理を抂げ"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 36,
    "text": "人の詞訟を屈むることは主のよろこび給はざるところなり"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 37,
    "text": "主の命じたまふにあらずば誰か事を述んにその事即ち成んや"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 38,
    "text": "禍も福もともに至高者の口より出るにあらずや"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 39,
    "text": "活る人なんぞ怨言べけんや 人おのれの罪の罰せらるるをつぶやくべけんや"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 40,
    "text": "我等みづからの行をしらべかつ省みてヱホバに歸るべし"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 41,
    "text": "我ら天にいます神にむかひて手とともに心をも擧べし"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 42,
    "text": "われらは罪ををかし我らは叛きたり なんぢこれを赦したまはざりき"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 43,
    "text": "なんぢ震怒をもてみづから蔽ひ 我らを追攻め殺してあはれまず"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 44,
    "text": "雲をもてみづから蔽ひ 祈禱をして通ぜざらしめ"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 45,
    "text": "もろもろの民の中にわれらを塵埃となしたまへり"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 46,
    "text": "敵は皆われらにむかひて口を張れり"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 47,
    "text": "恐懼と陷阱また暴行と滅亡我らに來れり"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 48,
    "text": "わが民の女の滅亡によりてわが眼には涙の河ながる"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 49,
    "text": "わが目は斷ず涙をそそぎて止ず"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 50,
    "text": "天よりヱホバの臨み見て顧みたまふ時にまで至らん"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 51,
    "text": "わが邑の一切の女等の故によりてわが眼はわが心をいたましむ"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 52,
    "text": "故なくして我に敵する者ども鳥を追ごとくにいたく我をおひ"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 53,
    "text": "わが生命を坑の中にほろぼし わが上に石を投かけ"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 54,
    "text": "また水わが頭の上に溢る 我みづから言り滅びうせぬと"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 55,
    "text": "ヱホバよ われ深き坑の底より汝の名を呼り"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 56,
    "text": "なんぢ我が聲を聽たまへり わが哀歎と祈求に耳をおほひたまふなかれ"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 57,
    "text": "わが汝を龥たりし時なんぢは近よりたまひて恐るるなかれと宣へり"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 58,
    "text": "主よなんぢはわが靈魂の訴を助け伸べ わが生命を贖ひ給へり"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 59,
    "text": "ヱホバよ なんぢは我がかうむりたる不義を見たまへり 願はくは我に正しき審判を與へたまへ"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 60,
    "text": "なんぢは彼らが我を怨み われを害せんとはかるを凡て見たまへり"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 61,
    "text": "ヱホバよなんぢは彼らが我を詈り 我を害せんとはかるを凡て聞たまへり"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 62,
    "text": "かの立て我に逆らふ者等の言語およびその終日われを攻んとて運らす謀計もまた汝これを聞たまへり"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 63,
    "text": "ねがはくは彼らの起居をかんがみたまへ 我はかれらに歌ひそしらる"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 64,
    "text": "ヱホバよ なんぢは彼らが手に爲すところに循がひて報をなし"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 65,
    "text": "かれらをして心くらからしめたまはん なんぢの呪詛かれらに歸せよ"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 66,
    "text": "なんぢは震怒をもてかれらを追ひ ヱホバの天の下よりかれらをほろぼし絶たまはん"
  }
]
