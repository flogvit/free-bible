[
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 1,
    "text": "ヱホバよ我らにありし所の事をおもひたまへ 我らの恥辱をかへりみ觀たまへ"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 2,
    "text": "われらの產業は外國人に歸し われらの家屋は他國人の有となれり"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 3,
    "text": "われらは孤子となりて父あらず われらの母は寡婦にひとし"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 4,
    "text": "われらは金を出して自己の水を飮み おのれの薪を得るにも價をはらふ"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 5,
    "text": "われらを追ふ者われらの頸に迫る 我らは疲れて休むことを得ず"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 6,
    "text": "食物を得て饑を凌がんとてエジプト人およびアッスリヤ人に手を與へたり"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 7,
    "text": "われらの父は罪ををかして已に世にあらず 我らその罪を負ふなり"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 8,
    "text": "奴僕等われらを制するに誰ありて我らを之が手よりすくひ出すものなし"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 9,
    "text": "荒野の刀兵の故によりて我ら死を冒して食物を得"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 10,
    "text": "饑饉の烈しき熱氣によりてわれらの皮膚は爐のごとく熱し"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 11,
    "text": "シオンにて婦人等をかされユダの邑々にて處女等けがさる"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 12,
    "text": "侯伯たる者も敵の手にて吊され 老たる者の面も尊とばれず"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 13,
    "text": "少き者は石磨を擔はせられ 童子は薪を負ふてよろめき"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 14,
    "text": "長老は門にあつまることを止め 少き者はその音樂を廢せり"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 15,
    "text": "我らが心の快樂はすでに罷み われらの跳舞はかはりて悲哀となり"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 16,
    "text": "われらの冠冕は首より落たり われら罪ををかしたれば禍なるかな"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 17,
    "text": "これが爲に我らの心うれへ これらのために我らが目くらくなれり"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 18,
    "text": "シオンの山は荒はて 山犬はその上を歩くなり"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 19,
    "text": "ヱホバよなんぢは永遠に在す なんぢの御位は世々かぎりなし"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 20,
    "text": "何とて我らを永く忘れ われらを斯ひさしく棄おきたまふや"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 21,
    "text": "ヱホバよねがはくは我らをして汝に歸らしめたまへ われら歸るべし 我らの日を新にして昔日の日のごとくならしめたまへ"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 22,
    "text": "さりとも汝まつたく我らを棄てたまひしや 痛くわれらを怒りゐたまふや"
  }
]
