[
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 1,
    "text": "イスラエルの子孫がモーセとアロンに導かれ其軍旅にしたがひてエジプトの國より出きたりて經たる旅路は左のごとし"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 2,
    "text": "モーセ、ヱホバの命に依りその旅路にしたがひてこれが發程を記せりその發程によればその旅路は左のごとくなり"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 3,
    "text": "彼らは正月の十五日にラメセスより出立り即ぢ逾越の翌日にイスラエルの子孫は一切のエジプト人の目の前にて高らかなる手によりて出たり"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 4,
    "text": "時にエジプト人はヱホバに撃ころされし其長子を葬りて居りヱホバはまた彼らの神々にも罰をかうむらせたまへり"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 5,
    "text": "イスラエルの子孫ラメセスより出立てスコテに營を張り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 6,
    "text": "スコテより出立て曠野の極端なるエタムに營を張り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 7,
    "text": "エタムより出立てバアルゼポンの前なるピハヒロテに轉りゆきてミグドルに營を張り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 8,
    "text": "ピハヒロテの前より出立ち海の中を通りて曠野にいりエタムの曠野に三日路ほど入てメラに營を張り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 9,
    "text": "メラより出立てヱリムに至れりエリムには泉十二棕櫚七十本あり乃ち此に營を張り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 10,
    "text": "かくてエリムより出たちて紅海の邊に營を張り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 11,
    "text": "紅海より出たちてシンの曠野に營を張り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 12,
    "text": "シンの曠野より出たちてドフカに營を張り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 13,
    "text": "ドフカより出たちてアルシに營を張り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 14,
    "text": "アルシより出たちてレピデムに營を張り此には民の飮む水あらざりき"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 15,
    "text": "かくてレピデムより出たちてシナイの曠野に營を張り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 16,
    "text": "シナイの曠野より出たちてキブロテハッタワに營を張り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 17,
    "text": "キブロテハッタワより出たちてハゼロテに營を張り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 18,
    "text": "ハゼロテより出たちてリテマに營を張り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 19,
    "text": "リテマより出たちてリンモンバレツに營を張り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 20,
    "text": "リンモンパレツより出たちてリブナに營を張り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 21,
    "text": "リブナより出たちてリッサに營を張り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 22,
    "text": "リッサより出たちてケヘラタに營を張り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 23,
    "text": "ケヘラタより出たちてシヤペル山に營を張り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 24,
    "text": "シヤペル山より出たちてハラダに營を張り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 25,
    "text": "ハラダより出たちてマケロテに營を張り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 26,
    "text": "マケロテより出たちてタハテに營を張り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 27,
    "text": "タハテより出たちてテラに營を張り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 28,
    "text": "テラより出たちてミテカに營を張り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 29,
    "text": "ミテカより出たちてハシモナに營を張り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 30,
    "text": "ハシモナより出たちてモセラに營を張り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 31,
    "text": "モセラより出たちてベネヤカンに營を張り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 32,
    "text": "ベネヤカンより出たちてホルハギデガデに營を張り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 33,
    "text": "ホルハギデガデより出たちてヨテバタに營を張り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 34,
    "text": "ヨテバタより出たちてアブロナに營を張り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 35,
    "text": "アブロナより出たちてエジオングベルに營を張り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 36,
    "text": "エジオングベルより出たちてカデシのチンの曠野に營を張り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 37,
    "text": "カデシより出たちてエドムの國の界なるホル山に營を張り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 38,
    "text": "イスラエルの子孫がエジプトの國を出てより四十年の五月の朔日に祭司アロンはヱホバの命によりてホル山に登て其處に死り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 39,
    "text": "アロンはホル山に死たる時は百二十三歳なりき"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 40,
    "text": "カナンの地の南に住るカナン人アラデ王といふ者イスラエルの子孫の來るを聞り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 41,
    "text": "かくてホル山より出たちてザルモナに營を張り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 42,
    "text": "ザルモナより出立てプノンに營を張り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 43,
    "text": "プノンより出たちてオボテに營を張り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 44,
    "text": "オボテより出たちてモアブの界なるイヱアバリムに營を張り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 45,
    "text": "イヰムより出たちてデボンガドに營を張り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 46,
    "text": "デボンガドより出たちてアルモンデブラタイムに營を張り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 47,
    "text": "アルモンデブラタイムより出たちてネボの前なるアバリムの山々に營を張り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 48,
    "text": "アバリムの山々より出たちてヱリコに對するヨルダンの邊なるモアブの平野に營を張り"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 49,
    "text": "すなはちモアブの平野においてヨルダンの邊に營を張りベテヱシモテよりアベルシッテムにいたる"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 50,
    "text": "ヱリコに對するヨルダンの邊なるモアブの平野においてヱホバ、モーセに告て言たまはく"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 51,
    "text": "イスラエルの子孫に告てこれに言へ汝らヨルダンを濟りてカナンの地に入る時は"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 52,
    "text": "その地に住る民をことごとく汝らの前より逐はらひその石の像をことごとく毀ちその鋳たる像を毀ちその崇邱をことごとく毀ちつくすべし"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 53,
    "text": "汝らその地の民を逐はらひて其處に住べし其は我その地を汝らの產業として汝らに與へたればなり"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 54,
    "text": "汝らの族にしたがひ鬮をもてその地を分ちて產業となし人多きには多くの產業を與へ人少きには少しの產業を與ふべし各人の分はその鬮にあたれる處にあるべきなり汝らその先祖の支派にしたがひて之を獲べし"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 55,
    "text": "然ど汝らもしその地に住る民を汝らの前より逐はらはずば汝らが存しおくところの者汝らの目に莿となり汝の脇に棘となり汝らの住む國において汝らを惱さん"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 56,
    "text": "且また我は彼らに爲んと思ひし事を汝らに爲ん"
  }
]
