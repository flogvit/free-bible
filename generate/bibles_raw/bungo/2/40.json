[
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 1,
    "text": "茲にヱホバ、モーセに告て言たまひけるは"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 2,
    "text": "正月の元日に汝集會の天幕の幕屋を建べし"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 3,
    "text": "而して汝その中に律法の櫃を置ゑ幕をもてその櫃を障蔽し"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 4,
    "text": "又案を携へいり陳設の物を陳設け且燈臺を携へいりてその燈盞を置うべし"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 5,
    "text": "汝また金の香壇を律法の櫃の前に置ゑ幔子を幕屋の門に掛け"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 6,
    "text": "燔祭の壇を集會の天幕の幕屋の門の前に置ゑ"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 7,
    "text": "洗盤を集會の天幕とその壇の間に置ゑて之に水をいれ"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 8,
    "text": "庭の周圍に藩籬をたて庭の門に幔子を垂れ"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 9,
    "text": "而して灌膏をとりて幕屋とその中の一切の物に灌ぎて其とその諸の器具を聖別べし是聖物とならん"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 10,
    "text": "汝また燔祭の壇とその一切の器具に膏をそそぎてその壇を聖別べし壇は至聖物とならん"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 11,
    "text": "又洗盤とその臺に膏をそそぎて之を聖別め"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 12,
    "text": "アロンとその子等を集會の幕屋の門につれきたりて水をもて彼等を洗ひ"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 13,
    "text": "アロンに聖衣を着せ彼に膏をそそぎてこれを聖別め彼をして祭司の職を我になさしむべし"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 14,
    "text": "又かれの子等をつれきたりて之に明衣を着せ"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 15,
    "text": "その父になせるごとくに之に膏を灌ぎて祭司の職を我になさしむべし彼等の膏そそがれて祭司たることは代々變らざるべきなり"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 16,
    "text": "モーセかく行へり即ちヱホバの己に命じたまひし如くに爲たり"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 17,
    "text": "第二年の正月にいたりてその月の元日に幕屋建ぬ"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 18,
    "text": "乃ちモーセ幕屋を建てその座を置ゑその板をたてその横木をさしこみその柱を立て"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 19,
    "text": "幕屋の上に天幕を張り天幕の蓋をその上にほどこせりヱホバのモーセに命じ給ひし如し"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 20,
    "text": "而してかれ律法をとりて櫃に蔵め杠を櫃につけ贖罪所を櫃の上に置ゑ"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 21,
    "text": "櫃を幕屋に携へいり障蔽の幕を垂て律法の櫃を隱せりヱホバのモーセに命じたまひしごとし"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 22,
    "text": "彼また集會の幕屋において幕屋の北の方にてかの幕の外に案を置ゑ"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 23,
    "text": "供前のパンをその上にヱホバの前に陳設たりヱホバのモーセに命じたまひし如し"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 24,
    "text": "又集會の幕屋において幕屋の南の方に燈臺をおきて案にむかはしめ"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 25,
    "text": "燈盞をヱホバの前にかかげたりヱホバのモーセに命じたまひしごとし"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 26,
    "text": "又集會の幕屋においてかの幕の前に金の壇を居ゑ"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 27,
    "text": "その上に馨しき香を焚りヱホバのモーセに命じたまひしごとし"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 28,
    "text": "又幕屋の門に幔子を垂れ"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 29,
    "text": "集會の天幕の幕屋の門に燔祭の壇を置ゑその上に燔祭と素祭をささげたりヱホバのモーセに命じたまひし如し"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 30,
    "text": "又集會の天幕とその壇の間に洗盤をおき其に水をいれて洗ふことの爲にす"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 31,
    "text": "モーセ、アロンおよびその子等其につきて手足を洗ふ"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 32,
    "text": "即ち集會の幕屋に入る時または壇に近づく時に洗ふことをせりヱホバのモーセに命じたましごとし"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 33,
    "text": "また幕屋と壇の周圍の庭に藩籬をたて庭の門に幔子を垂ぬ是モーセその工事を竣たり"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 34,
    "text": "斯て雲集會の天幕を蓋てヱホバの榮光幕屋に充たり"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 35,
    "text": "モーセは集會の幕屋にいることを得ざりき是雲その上に止り且ヱホバの榮光幕屋に盈たればなり"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 36,
    "text": "雲幕屋の上より昇る時にはイスラエルの子孫途に進めり其途々凡て然り"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 37,
    "text": "然ど雲の昇らざる時にはその昇る日まで途に進むことをせざりき"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 38,
    "text": "即ち晝は幕屋の上にヱホバの雲あり夜はその中に火ありイスラエルの家の者皆これを見るその途々すべて然り"
  }
]
