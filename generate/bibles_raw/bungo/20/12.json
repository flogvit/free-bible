[
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 1,
    "text": "訓誨を愛する者は知識を愛す 懲戒を惡むものは畜のごとし"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 2,
    "text": "善人はヱホバの恩寵をうけ 惡き謀略を設くる人はヱホバに罰せらる"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 3,
    "text": "人は惡をもて堅く立ことあたはず 義人の根は動くことなし"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 4,
    "text": "賢き婦はその夫の冠弁なり 辱をきたらする婦は夫をしてその骨に腐あるが如くならしむ"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 5,
    "text": "義者のおもひは直し 惡者の計るところは虚偽なり"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 6,
    "text": "惡者の言は人の血を流さんとて伺ふ されど直者の口は人を救ふなり"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 7,
    "text": "惡者はたふされて無ものとならん されど義者の家は立べし"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 8,
    "text": "人はその聰明にしたがひて譽られ 心の悖れる者は藐めらる"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 9,
    "text": "卑賤してしもべある者は自らたかぶりて食に乏き者に愈る"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 10,
    "text": "義者はその畜の生命を顧みる されど惡者は殘忍をもてその憐憫とす"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 11,
    "text": "おのれの田地を耕すものは食にあく 放蕩なる人にしたがふ者は智慧なし"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 12,
    "text": "惡者はあしき人の獲たる物をうらやみ 義者の根は芽をいだす"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 13,
    "text": "惡者はくちびるの愆によりて罟に陷る されど義者は患難の中よりまぬかれいでん"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 14,
    "text": "人はその口の徳によりて福祉に飽ん 人の手の行爲はその人の身にかへるべし"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 15,
    "text": "愚なる者はみづからその道を見て正しとす されど智慧ある者はすすめを容る"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 16,
    "text": "愚なる者はただちに怒をあらはし 智きものは恥をつつむ"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 17,
    "text": "眞實をいふものは正義を述べ いつはりの證人は虚偽をいふ"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 18,
    "text": "妄りに言をいだし劍をもて刺がごとくする者あり されど智慧ある者の舌は人をいやす"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 19,
    "text": "眞理をいふ口唇は何時までも存つ されど虚偽をいふ舌はただ瞬息のあひだのみなり"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 20,
    "text": "惡事をはかる者の心には欺詐あり 和平を謀る者には歓喜あり"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 21,
    "text": "義者には何の禍害も來らず 惡者はわざはひをもて充さる"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 22,
    "text": "いつはりの口唇はヱホバに憎まれ 眞實をおこなふ者は彼に悦ばる"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 23,
    "text": "賢人は知識をかくす されど愚なる者のこころは愚なる事を述ぶ"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 24,
    "text": "勤めはたらく者の手は人ををさむるにいたり惰者は人に服ふるにいたる"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 25,
    "text": "うれひ人の心にあれば之を屈ます されど善言はこれを樂します"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 26,
    "text": "義者はその友に道を示す されど惡者は自ら途にまよふ"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 27,
    "text": "惰者はおのれの猟獲たる物をも燔ず 勉めはたらくことは人の貴とき寳なり"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 28,
    "text": "義しき道には生命ありその道すぢには死なし"
  }
]
