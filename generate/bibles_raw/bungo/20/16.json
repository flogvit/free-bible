[
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 1,
    "text": "心に謀るところは人にあり 舌の答はヱホバより出づ"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 2,
    "text": "人の途はおのれの目にことごとく潔しと見ゆ 惟ヱホバ霊魂をはかりたまふ"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 3,
    "text": "なんぢの作爲をヱホバに託せよ さらば汝の謀るところ必ず成るべし"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 4,
    "text": "ヱホバはすべての物をおのおのその用のために造り 惡人をも惡き日のために造りたまへり"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 5,
    "text": "すべて心たかぶる者はヱホバに惡まれ 手に手をあはするとも罪をまぬかれじ"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 6,
    "text": "憐憫と眞實とによりて愆は贖はる ヱホバを畏るることによりて人惡を離る"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 7,
    "text": "ヱホバもし人の途を喜ばば その人の敵をも之と和がしむべし"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 8,
    "text": "義によりて得たるところの僅少なる物は不義によりて得たる多の資財にまさる"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 9,
    "text": "人は心におのれの途を考へはかる されどその歩履を導くものはヱホバなり"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 10,
    "text": "王のくちびるには神のさばきあり 審判するときその口あやまる可らず"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 11,
    "text": "公平の權衡と天秤とはヱホバのものなり 嚢にある法馬もことごとく彼の造りしものなり"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 12,
    "text": "惡をおこなふことは王の憎むところなり 是その位は公義によりて堅く立ばなり"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 13,
    "text": "義しき口唇は王によろこばる 彼等は正直をいふものを愛す"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 14,
    "text": "王の怒は死の使者のごとし 智慧ある人はこれをなだむ"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 15,
    "text": "王の面の光には生命あり その恩寵は春雨の雲のごとし"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 16,
    "text": "智慧を得るは金をうるよりも更に善らずや 聰明をうるは銀を得るよりも望まし"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 17,
    "text": "惡を離るるは直き人の路なり おのれの道を守るは霊魂を守るなり"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 18,
    "text": "驕傲は滅亡にさきだち誇る心は傾跌にさきだつ"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 19,
    "text": "卑き者に交りて謙だるは驕ぶる者と偕にありて贓物をわかつに愈る"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 20,
    "text": "愼みて御言をおこなふ者は益をうべし ヱホバに倚賴むものは福なり"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 21,
    "text": "心に智慧あれば哲者と稱へらる くちびる甘ければ人の知識をます"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 22,
    "text": "明哲はこれを持つものに生命の泉となる 愚なる者をいましむる者はおのれの痴是なり"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 23,
    "text": "智慧ある者の心はおのれの口ををしへ 又おのれの口唇に知識をます"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 24,
    "text": "こころよき言は蜂蜜のごとくにして 霊魂に甘く骨に良薬となる"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 25,
    "text": "人の自から見て正しとする途にして その終はつひに死にいたる途となるものあり"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 26,
    "text": "勞をるものは飮食のために骨をる 是その口おのれに迫ればなり"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 27,
    "text": "邪曲なる人は惡を掘る その口唇には烈しき火のごときものあり"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 28,
    "text": "いつはる者はあらそひを起し つけぐちする者は朋友を離れしむ"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 29,
    "text": "強暴人はその鄰をいざなひ 之を善らざる途にみちびく"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 30,
    "text": "その目を閉て惡を謀り その口唇を蹙めて惡事を成遂ぐ"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 31,
    "text": "白髮は榮の冠弁なり 義しき途にてこれを見ん"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 32,
    "text": "怒を遅くする者は勇士に愈り おのれの心を治むる者は城を攻取る者に愈る"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 33,
    "text": "人は籤をひく されど事をさだむるは全くヱホバにあり"
  }
]
