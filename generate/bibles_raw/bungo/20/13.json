[
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 1,
    "text": "智慧ある子は父の敎訓をきき 戯謔者は懲治をきかず"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 2,
    "text": "人はその口の徳によりて福祉をくらひ悖逆者の霊魂は強暴をくらふ"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 3,
    "text": "その口を守る者はその生命を守る その口唇を大きくひらく者には滅亡きたる"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 4,
    "text": "惰る者はこころに慕へども得ることなし 勤めはたらく者の心は豊饒なり"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 5,
    "text": "義者は虚偽の言をにくみ 惡者ははぢをかうむらせ面を赤くせしむ"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 6,
    "text": "義は道を直くあゆむ者をまもり 惡は罪人を倒す"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 7,
    "text": "自ら富めりといひあらはして些少の所有もなき者あり 自ら貧しと稱へて資財おほき者あり"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 8,
    "text": "人の資財はその生命を贖ふものとなるあり 然ど貧者は威嚇をきくことあらず"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 9,
    "text": "義者の光は輝き惡者の燈火はけさる"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 10,
    "text": "驕傲はただ爭端を生ず 勸告をきく者は智慧あり"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 11,
    "text": "詭計をもて得たる資財は減る されど手をもて聚めたくはふる者はこれを増すことを得"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 12,
    "text": "望を得ること遅きときは心を疾しめ 願ふ所旣にとぐるときは生命の樹を得たるがごとし"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 13,
    "text": "御言をかろんずる者は亡され 誡命をおそるる者は報賞を得"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 14,
    "text": "智慧ある人の敎訓はいのちの泉なり 能く人をして死の罟を脱れしむ"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 15,
    "text": "善にして哲きものは恩を蒙る されど悖逆者の途は艱難なり"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 16,
    "text": "凡そ賢者は知識に由りて事をおこなひ 愚なる者はおのれの痴を顯す"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 17,
    "text": "惡き使者は災禍に陷る されど忠信なる使者は良薬の如し"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 18,
    "text": "貧乏と恥辱とは敎訓をすつる者にきたる されど譴責を守る者は尊まる"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 19,
    "text": "望を得れば心に甘し 愚なる者は惡を棄つることを嫌ふ"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 20,
    "text": "智慧ある者と偕にあゆむものは智慧をえ 愚なる者の友となる者はあしくなる"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 21,
    "text": "わざはひは罪人を追ひ 義者は善報をうく"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 22,
    "text": "善人はその產業を子孫に遺す されど罪人の資財は義者のために蓄へらる"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 23,
    "text": "貧しき者の新田にはおほくの糧あり されど不義によりて亡る者あり"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 24,
    "text": "鞭をくはへざる者はその子を憎むなり 子を愛する者はしきりに之をいましむ"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 25,
    "text": "義しき者は食をえて飽く されど惡者の腹は空し"
  }
]
