[
  {
    "bookId": 20,
    "chapterId": 24,
    "verseId": 1,
    "text": "なんぢ惡き人を羨むことなかれ 又これと偕に居らんことを願ふなかれ"
  },
  {
    "bookId": 20,
    "chapterId": 24,
    "verseId": 2,
    "text": "そはその心に暴虐をはかり その口唇に人を害ふことをいへばなり"
  },
  {
    "bookId": 20,
    "chapterId": 24,
    "verseId": 3,
    "text": "家は智慧によりて建られ 明哲によりて堅くせられ"
  },
  {
    "bookId": 20,
    "chapterId": 24,
    "verseId": 4,
    "text": "また室は知識によりて各種の貴く美しき寳にて充されん"
  },
  {
    "bookId": 20,
    "chapterId": 24,
    "verseId": 5,
    "text": "智慧ある者は強し 知識ある人は力をます"
  },
  {
    "bookId": 20,
    "chapterId": 24,
    "verseId": 6,
    "text": "汝よき謀計をもて戰闘をなせ 勝利は議者の多きによる"
  },
  {
    "bookId": 20,
    "chapterId": 24,
    "verseId": 7,
    "text": "智慧は高くして愚なる者の及ぶところにあらず 愚なる者は門にて口を啓くことをえず"
  },
  {
    "bookId": 20,
    "chapterId": 24,
    "verseId": 8,
    "text": "惡をなさんと謀る者を邪曲なる者と稱ふ"
  },
  {
    "bookId": 20,
    "chapterId": 24,
    "verseId": 9,
    "text": "愚なる者の謀るところは罪なり 嘲笑者は人に憎まる"
  },
  {
    "bookId": 20,
    "chapterId": 24,
    "verseId": 10,
    "text": "汝もし患難の日に氣を挫かば汝の力は弱し"
  },
  {
    "bookId": 20,
    "chapterId": 24,
    "verseId": 11,
    "text": "なんぢ死地に曳れゆく者を拯へ 滅亡によろめきゆく者をすくはざる勿れ"
  },
  {
    "bookId": 20,
    "chapterId": 24,
    "verseId": 12,
    "text": "汝われら之を知らずといふとも心をはかる者これを暁らざらんや 汝の霊魂をまもる者これを知ざらんや 彼はおのおのの行爲によりて人に報ゆべし"
  },
  {
    "bookId": 20,
    "chapterId": 24,
    "verseId": 13,
    "text": "わが子よ蜜を食へ 是は美ものなり また蜂のすの滴瀝を食へ 是はなんぢの口に甘し"
  },
  {
    "bookId": 20,
    "chapterId": 24,
    "verseId": 14,
    "text": "智慧の汝の霊魂におけるも是の如しと知れ これを得ばかならず報いありて汝の望すたれじ"
  },
  {
    "bookId": 20,
    "chapterId": 24,
    "verseId": 15,
    "text": "惡者よ義者の家を窺ふことなかれ その安居所を攻ること勿れ"
  },
  {
    "bookId": 20,
    "chapterId": 24,
    "verseId": 16,
    "text": "そは義者は七次たふるるともまた起く されど惡者は禍災によりて亡ぶ"
  },
  {
    "bookId": 20,
    "chapterId": 24,
    "verseId": 17,
    "text": "汝の仇たふるるとき樂しむこと勿れ 彼の亡ぶるときこころに喜ぶことなかれ"
  },
  {
    "bookId": 20,
    "chapterId": 24,
    "verseId": 18,
    "text": "恐くはヱホバこれを見て惡しとし その震怒を彼より離れしめたまはん"
  },
  {
    "bookId": 20,
    "chapterId": 24,
    "verseId": 19,
    "text": "なんぢ惡者を怒ることなかれ 邪曲なる者を羨むなかれ"
  },
  {
    "bookId": 20,
    "chapterId": 24,
    "verseId": 20,
    "text": "それ惡者には後の善賚なし 邪曲なる者の燈火は滅されん"
  },
  {
    "bookId": 20,
    "chapterId": 24,
    "verseId": 21,
    "text": "わが子よヱホバと王とを畏れよ 叛逆者に交ること勿れ"
  },
  {
    "bookId": 20,
    "chapterId": 24,
    "verseId": 22,
    "text": "斯るものらの災禍は速におこる この兩者の滅亡はたれか知えんや"
  },
  {
    "bookId": 20,
    "chapterId": 24,
    "verseId": 23,
    "text": "是等もまた智慧ある者の箴言なり 偏り鞫するは善らず"
  },
  {
    "bookId": 20,
    "chapterId": 24,
    "verseId": 24,
    "text": "罪人に告て汝は義しといふものをは衆人これを詛ひ諸民これを惡まん"
  },
  {
    "bookId": 20,
    "chapterId": 24,
    "verseId": 25,
    "text": "これを譴る者は恩をえん また福祉これにきたるべし"
  },
  {
    "bookId": 20,
    "chapterId": 24,
    "verseId": 26,
    "text": "ほどよき應答をなす者は口唇に接吻するなり"
  },
  {
    "bookId": 20,
    "chapterId": 24,
    "verseId": 27,
    "text": "外にて汝の工をととのへ田圃にてこれを自己のためにそなへ 然るのち汝の家を建よ"
  },
  {
    "bookId": 20,
    "chapterId": 24,
    "verseId": 28,
    "text": "故なく汝の鄰に敵して證することなかれ 汝なんぞ口唇をもて欺くべけんや"
  },
  {
    "bookId": 20,
    "chapterId": 24,
    "verseId": 29,
    "text": "彼の我に爲しし如く我も亦かれになすべし われ人の爲ししところに循ひてこれに報いんといふこと勿れ"
  },
  {
    "bookId": 20,
    "chapterId": 24,
    "verseId": 30,
    "text": "われ曾て惰人の田圃と智慧なき人の葡萄園とをすぎて見しに"
  },
  {
    "bookId": 20,
    "chapterId": 24,
    "verseId": 31,
    "text": "荊棘あまねく生え薊その地面を掩ひ その石垣くづれゐたり"
  },
  {
    "bookId": 20,
    "chapterId": 24,
    "verseId": 32,
    "text": "我これをみて心をとどめ これを觀て敎をえたり"
  },
  {
    "bookId": 20,
    "chapterId": 24,
    "verseId": 33,
    "text": "しばらく臥し 暫らく睡り 手を叉きて又しばらく休む"
  },
  {
    "bookId": 20,
    "chapterId": 24,
    "verseId": 34,
    "text": "さらば汝の貧窮は盗人のごとく汝の缺乏は兵士の如くきたるべし"
  }
]
