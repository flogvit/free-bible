[
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 1,
    "text": "智慧は呼はらざるか 聰明は聲を出さざるか"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 2,
    "text": "彼は路のほとりの高處また街衢のなかに立ち"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 3,
    "text": "邑のもろもろの門 邑の口および門々の入口にて呼はりいふ"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 4,
    "text": "人々よわれ汝をよび 我が聲をもて人の子等をよぶ"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 5,
    "text": "拙き者よなんぢら聰明に明かなれ 愚なる者よ汝ら明かなる心を得よ"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 6,
    "text": "汝きけ われ善事をかたらん わが口唇をひらきて正事をいださん"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 7,
    "text": "我が口は眞實を述べ わが口唇はあしき事を憎むなり"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 8,
    "text": "わが口の言はみな義し そのうちに虚偽と奸邪とあることなし"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 9,
    "text": "是みな智者の明かにするところ 知識をうる者の正とするところなり"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 10,
    "text": "なんぢら銀をうくるよりは我が敎をうけよ 精金よりもむしろ知識をえよ"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 11,
    "text": "それ智慧は眞珠に愈れり 凡の寳も之に比ぶるに足らず"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 12,
    "text": "われ智慧は聰明をすみかとし 知識と謹愼にいたる"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 13,
    "text": "ヱホバを畏るるとは惡を憎むことなり 我は傲慢と驕奢 惡道と虚偽の口とを憎む"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 14,
    "text": "謀略と聰明は我にあり 我は了知なり 我は能力あり"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 15,
    "text": "我に由て王者は政をなし 君たる者は義しき律をたて"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 16,
    "text": "我によりて主たる者および牧伯たちなど凡て地の審判人は世ををさむ"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 17,
    "text": "われを愛する者は我これを愛す 我を切に求むるものは我に遇ん"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 18,
    "text": "富と榮とは我にあり 貴き寳と公義とも亦然り"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 19,
    "text": "わが果は金よりも精金よりも愈り わが利は精銀よりもよし"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 20,
    "text": "我は義しき道にあゆみ 公平なる路徑のなかを行む"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 21,
    "text": "これ我を愛する者に貨財をえさせ 又その庫を充しめん爲なり"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 22,
    "text": "ヱホバいにしへ其御わざをなしそめたまへる前に その道の始として我をつくりたまひき"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 23,
    "text": "永遠より元始より地の有ざりし前より我は立られ"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 24,
    "text": "いまだ海洋あらず いまだ大なるみづの泉あらざりしとき我すでに生れ"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 25,
    "text": "山いまださだめられず 陵いまだ有ざりし前に我すでに生れたり"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 26,
    "text": "即ち神いまだ地をも野をも地の塵の根元をも造り給はざりし時なり"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 27,
    "text": "かれ天をつくり海の面に穹蒼を張たまひしとき我かしこに在りき"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 28,
    "text": "彼うへに雲氣をかたく定め 淵の泉をつよくならしめ"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 29,
    "text": "海にその限界をたて 水をしてその岸を踰えざらしめ また地の基を定めたまへるとき"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 30,
    "text": "我はその傍にありて創造者となり 日々に欣び恒にその前に樂み"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 31,
    "text": "その地にて樂み又世の人を喜べり"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 32,
    "text": "されば小子等よ いま我にきけ わが道をまもる者は福ひなり"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 33,
    "text": "敎をききて智慧をえよ 之を棄ることなかれ"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 34,
    "text": "凡そ我にきき 日々わが門の傍にまち わが戸口の柱のわきにたつ人は福ひなり"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 35,
    "text": "そは我を得る者は生命をえ ヱホバより恩寵を獲ればなり"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 36,
    "text": "我を失ふものは自己の生命を害ふ すべて我を惡むものは死を愛するなり"
  }
]
