[
  {
    "bookId": 20,
    "chapterId": 6,
    "verseId": 1,
    "text": "我子よ汝もし朋友のために保證をなし 他人のために汝の手を拍ば"
  },
  {
    "bookId": 20,
    "chapterId": 6,
    "verseId": 2,
    "text": "汝その口の言によりてわなにかかり その口の言によりてとらへらるるなり"
  },
  {
    "bookId": 20,
    "chapterId": 6,
    "verseId": 3,
    "text": "我子よ汝友の手に陷りしならば斯して自ら救へ すなはち往て自ら謙だり只管なんぢの友に求め"
  },
  {
    "bookId": 20,
    "chapterId": 6,
    "verseId": 4,
    "text": "汝の目をして睡らしむることなく 汝の眼瞼をして閉しむること勿れ"
  },
  {
    "bookId": 20,
    "chapterId": 6,
    "verseId": 5,
    "text": "かりうどの手より鹿ののがるるごとく 鳥とる者の手より鳥ののがるる如くして みづからを救へ"
  },
  {
    "bookId": 20,
    "chapterId": 6,
    "verseId": 6,
    "text": "惰者よ蟻にゆき其爲すところを觀て智慧をえよ"
  },
  {
    "bookId": 20,
    "chapterId": 6,
    "verseId": 7,
    "text": "蟻は首領なく有司なく君主なけれども"
  },
  {
    "bookId": 20,
    "chapterId": 6,
    "verseId": 8,
    "text": "夏のうちに食をそなへ 収穫のときに糧を斂む"
  },
  {
    "bookId": 20,
    "chapterId": 6,
    "verseId": 9,
    "text": "惰者よ汝いづれの時まで臥息むや いづれの時まで睡りて起ざるや"
  },
  {
    "bookId": 20,
    "chapterId": 6,
    "verseId": 10,
    "text": "しばらく臥ししばらく睡り 手を叉きてまた片時やすむ"
  },
  {
    "bookId": 20,
    "chapterId": 6,
    "verseId": 11,
    "text": "さらば汝の貧窮は盗人の如くきたり汝の缺乏は兵士の如くきたるべし"
  },
  {
    "bookId": 20,
    "chapterId": 6,
    "verseId": 12,
    "text": "邪曲なる人あしき人は虚偽の言をもて事を行ふ"
  },
  {
    "bookId": 20,
    "chapterId": 6,
    "verseId": 13,
    "text": "彼は眼をもて眴せし 脚をもてしらせ 指をもて示す"
  },
  {
    "bookId": 20,
    "chapterId": 6,
    "verseId": 14,
    "text": "その心に虚偽をたもち 常に惡をはかり 爭端を起す"
  },
  {
    "bookId": 20,
    "chapterId": 6,
    "verseId": 15,
    "text": "この故にその禍害にはかに來り 援助なくして立刻に敗らるべし"
  },
  {
    "bookId": 20,
    "chapterId": 6,
    "verseId": 16,
    "text": "ヱホバの憎みたまふもの六あり 否その心に嫌ひたまふもの七あり"
  },
  {
    "bookId": 20,
    "chapterId": 6,
    "verseId": 17,
    "text": "即ち驕る目いつはりをいふ舌 つみなき人の血を流す手"
  },
  {
    "bookId": 20,
    "chapterId": 6,
    "verseId": 18,
    "text": "惡き謀計をめぐらす心 すみやかに惡に趨る足"
  },
  {
    "bookId": 20,
    "chapterId": 6,
    "verseId": 19,
    "text": "詐僞をのぶる證人 および兄弟のうちに爭端をおこす者なり"
  },
  {
    "bookId": 20,
    "chapterId": 6,
    "verseId": 20,
    "text": "我子よ汝の父の誡命を守り 汝の母の法を棄る勿れ"
  },
  {
    "bookId": 20,
    "chapterId": 6,
    "verseId": 21,
    "text": "常にこれを汝の心にむす び之をなんぢの頸に佩よ"
  },
  {
    "bookId": 20,
    "chapterId": 6,
    "verseId": 22,
    "text": "これは汝のゆくとき汝をみちびき 汝の寝るとき汝をまもり 汝の寤るとき汝とかたらん"
  },
  {
    "bookId": 20,
    "chapterId": 6,
    "verseId": 23,
    "text": "それ誡命は燈火なり 法は光なり 敎訓の懲治は生命の道なり"
  },
  {
    "bookId": 20,
    "chapterId": 6,
    "verseId": 24,
    "text": "これは汝をまもりて惡き婦よりまぬかれしめ 汝をたもちて淫婦の舌の諂媚にまどはされざらしめん"
  },
  {
    "bookId": 20,
    "chapterId": 6,
    "verseId": 25,
    "text": "その艶美を心に戀ふことなかれ その眼瞼に捕へらるること勿れ"
  },
  {
    "bookId": 20,
    "chapterId": 6,
    "verseId": 26,
    "text": "それ娼妓のために人はただ僅に一撮の糧をのこすのみにいたる 又淫婦は人の尊き生命を求むるなり"
  },
  {
    "bookId": 20,
    "chapterId": 6,
    "verseId": 27,
    "text": "人は火を懐に抱きてその衣を焚れざらんや"
  },
  {
    "bookId": 20,
    "chapterId": 6,
    "verseId": 28,
    "text": "人は熱火を踏て其足を焚れざらんや"
  },
  {
    "bookId": 20,
    "chapterId": 6,
    "verseId": 29,
    "text": "その隣の妻と姦淫をおこなふ者もかくあるべし 凡て之に捫る者は罪なしとせられず"
  },
  {
    "bookId": 20,
    "chapterId": 6,
    "verseId": 30,
    "text": "竊む者もし饑しときに其饑を充さん爲にぬすめるならば人これを藐ぜじ"
  },
  {
    "bookId": 20,
    "chapterId": 6,
    "verseId": 31,
    "text": "もし捕へられなばその七倍を償ひ其家の所有をことごとく出さざるべからず"
  },
  {
    "bookId": 20,
    "chapterId": 6,
    "verseId": 32,
    "text": "婦と姦淫をおこなふ者は智慧なきなり 之を行ふ者はおのれの霊魂を亡し"
  },
  {
    "bookId": 20,
    "chapterId": 6,
    "verseId": 33,
    "text": "傷と陵辱とをうけて其恥を雪ぐこと能はず"
  },
  {
    "bookId": 20,
    "chapterId": 6,
    "verseId": 34,
    "text": "妒忌その夫をして忿怒をもやさしむればその怨を報ゆるときかならず寛さじ"
  },
  {
    "bookId": 20,
    "chapterId": 6,
    "verseId": 35,
    "text": "いかなる贖物をも顧みず 衆多の饋物をなすともやはらがざるべし"
  }
]
