[
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 1,
    "text": "惡者は逐ふ者なけれども逃げ 義者は獅子のごとくに勇まし"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 2,
    "text": "國の罪によりて侯伯多くなり 智くして知識ある人によりて國は長く保つ"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 3,
    "text": "弱者を虐ぐる貧人は糧をのこさざる暴しき雨のごとし"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 4,
    "text": "律法を棄るものは惡者をほめ 律法を守る者はこれに敵す"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 5,
    "text": "惡人は義きことを覺らず ヱホバを求むる者は凡の事をさとる"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 6,
    "text": "義しくあゆむ貧者は曲れる路をあゆむ富者に愈る"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 7,
    "text": "律法を守る者は智子なり 放蕩なる者に交るものは父を辱かしむ"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 8,
    "text": "利息と高利とをもてその財產を増すものは貧人をめぐむ者のために之をたくはふるなり"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 9,
    "text": "耳をそむけて律法を聞ざる者はその祈すらも憎まる"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 10,
    "text": "義者を惡き道に惑す者はみづから自己の阱に陷らん されど質直なる者は福祉をつぐべし"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 11,
    "text": "富者はおのれの目に自らを智慧ある者となす されど聰明ある貧者は彼をはかり知る"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 12,
    "text": "義者の喜ぶときは大なる榮あり 惡者の起るときは民身を匿す"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 13,
    "text": "その罪を隱すものは榮ゆることなし 然ど認らはして之を離るる者は憐憫をうけん"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 14,
    "text": "恒に畏るる人は幸福なり その心を剛愎にする者は災禍に陷るべし"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 15,
    "text": "貧しき民を治むるあしき侯伯は吼る獅子あるひは饑たる熊のごとし"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 16,
    "text": "智からざる君はおほく暴虐をおこなふ 不義の利を惡む者は遐齢をうべし"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 17,
    "text": "人を殺してその血を心に負ふ者は墓に奔るなり 人これを阻むること勿れ"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 18,
    "text": "義く行む者は救をえ 曲れる路に行む者は直に跌れん"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 19,
    "text": "おのれの田地を耕す者は糧にあき 放蕩なる者に從ふものは貧乏に飽く"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 20,
    "text": "忠信なる人は多くの幸福をえ 速かに富を得んとする者は罪を免れず"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 21,
    "text": "人を偏視るはよからず 人はただ一片のパンのために愆を犯すなり"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 22,
    "text": "惡目をもつ者は財をえんとて急がはしく 却て貧窮のおのれに來るを知らず"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 23,
    "text": "人を譴むる者は舌をもて諂ふ者よりも大なる感謝をうく"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 24,
    "text": "父母の物を竊みて罪ならずといふ者は滅す者の友なり"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 25,
    "text": "心に貧る者は爭端を起し ヱホバに倚賴むものは豊饒になるべし"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 26,
    "text": "おのれの心を恃む者は愚なり 智慧をもて行む者は救をえん"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 27,
    "text": "貧者に賙すものは乏しからず その目を掩ふ者は詛を受ること多し"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 28,
    "text": "惡者の起るときは人匿れ その滅るときは義者ます"
  }
]
