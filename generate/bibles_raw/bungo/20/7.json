[
  {
    "bookId": 20,
    "chapterId": 7,
    "verseId": 1,
    "text": "我子よわが言をまもり我が誡命を汝の心にたくはへよ"
  },
  {
    "bookId": 20,
    "chapterId": 7,
    "verseId": 2,
    "text": "我が誡命をまもりで生命をえよ 我法を守ること汝の眸子を守るが如くせよ"
  },
  {
    "bookId": 20,
    "chapterId": 7,
    "verseId": 3,
    "text": "これを汝の指にむすび これを汝の心の碑に銘せ"
  },
  {
    "bookId": 20,
    "chapterId": 7,
    "verseId": 4,
    "text": "なんぢ智慧にむかひて汝はわが姉妹なりといひ 明理にむかひて汝はわが友なりといへ"
  },
  {
    "bookId": 20,
    "chapterId": 7,
    "verseId": 5,
    "text": "さらば汝をまもりて淫婦にまよはざらしめ 言をもて媚る娼妓にとほざからしめん"
  },
  {
    "bookId": 20,
    "chapterId": 7,
    "verseId": 6,
    "text": "われ我室の牖により檑子よりのぞきて"
  },
  {
    "bookId": 20,
    "chapterId": 7,
    "verseId": 7,
    "text": "拙き者のうち幼弱者のうちに一人の智慧なき者あるを觀たり"
  },
  {
    "bookId": 20,
    "chapterId": 7,
    "verseId": 8,
    "text": "彼衢をすぎ婦の門にちかづき其家の路にゆき"
  },
  {
    "bookId": 20,
    "chapterId": 7,
    "verseId": 9,
    "text": "黄昏に半宵に夜半に黑暗の中にあるけり"
  },
  {
    "bookId": 20,
    "chapterId": 7,
    "verseId": 10,
    "text": "時に娼妓の衣を着たる狡らなる婦かれにあふ"
  },
  {
    "bookId": 20,
    "chapterId": 7,
    "verseId": 11,
    "text": "この婦は譁しくしてつつしみなく 其足は家に止らず"
  },
  {
    "bookId": 20,
    "chapterId": 7,
    "verseId": 12,
    "text": "あるときは衢にあり 或時はひろばにあり すみずみにたちて人をうかがふ"
  },
  {
    "bookId": 20,
    "chapterId": 7,
    "verseId": 13,
    "text": "この婦かれをひきて接吻し恥しらぬ面をもていひけるは"
  },
  {
    "bookId": 20,
    "chapterId": 7,
    "verseId": 14,
    "text": "われ酬恩祭を献げ今日すでにわが誓願を償せり"
  },
  {
    "bookId": 20,
    "chapterId": 7,
    "verseId": 15,
    "text": "これによりて我なんぢを迎へんとていで 汝の面をたづねて汝に逢へり"
  },
  {
    "bookId": 20,
    "chapterId": 7,
    "verseId": 16,
    "text": "わが榻には美しき褥およびエジプトの文枲をしき"
  },
  {
    "bookId": 20,
    "chapterId": 7,
    "verseId": 17,
    "text": "沒藥蘆薈桂皮をもて我が榻にそそげり"
  },
  {
    "bookId": 20,
    "chapterId": 7,
    "verseId": 18,
    "text": "來れわれら詰朝まで情をつくし愛をかよはして相なぐさめん"
  },
  {
    "bookId": 20,
    "chapterId": 7,
    "verseId": 19,
    "text": "そは夫は家にあらず遠く旅立して"
  },
  {
    "bookId": 20,
    "chapterId": 7,
    "verseId": 20,
    "text": "手に金嚢をとれり 望月ならでは家に歸らじと"
  },
  {
    "bookId": 20,
    "chapterId": 7,
    "verseId": 21,
    "text": "多の婉言をもて惑し口唇の諂媚をもて誘へば"
  },
  {
    "bookId": 20,
    "chapterId": 7,
    "verseId": 22,
    "text": "わかき人ただちにこれに隨へり あだかも牛の宰地にゆくが如く 愚なる者の桎梏をかけらるる爲にゆくが如し"
  },
  {
    "bookId": 20,
    "chapterId": 7,
    "verseId": 23,
    "text": "遂には矢その肝を刺さん 鳥の速かに羅にいりてその生命を喪ふに至るを知ざるがごとし"
  },
  {
    "bookId": 20,
    "chapterId": 7,
    "verseId": 24,
    "text": "小子等よいま我にきけ 我が口の言に耳を傾けよ"
  },
  {
    "bookId": 20,
    "chapterId": 7,
    "verseId": 25,
    "text": "なんぢの心を淫婦の道にかたむくること勿れ またこれが徑に迷ふこと勿れ"
  },
  {
    "bookId": 20,
    "chapterId": 7,
    "verseId": 26,
    "text": "そは彼は多の人を傷つけて仆せり 彼に殺されたる者ぞ多かる"
  },
  {
    "bookId": 20,
    "chapterId": 7,
    "verseId": 27,
    "text": "その家は陰府の途にして死の室に下りゆく"
  }
]
