[
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 1,
    "text": "智慧ある婦はその家をたて 愚なる婦はおのれの手をもて之を毀つ"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 2,
    "text": "直くあゆむ者はヱホバを畏れ 曲りてあゆむ者はこれを侮る"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 3,
    "text": "愚なる者の口にはその傲のために鞭笞あり 智者の口唇はおのれを守る"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 4,
    "text": "牛なければ飼蒭倉むなし牛の力によりて生產る物おほし"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 5,
    "text": "忠信の證人はいつはらず 虚偽のあかしびとは謊言を吐く"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 6,
    "text": "嘲笑者は智慧を求むれどもえず 哲者は知識を得ること容易し"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 7,
    "text": "汝おろかなる者の前を離れされ つひに知識の彼にあるを見ざるべし"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 8,
    "text": "賢者の智慧はおのれの道を暁るにあり 愚なる者の痴は欺くにあり"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 9,
    "text": "おろろかなる者は罪をかろんず されど義者の中には恩惠あり"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 10,
    "text": "心の苦みは心みづから知る其よろこびには他人あづからず"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 11,
    "text": "惡者の家は亡され 正直き者の幕屋はさかゆ"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 12,
    "text": "人のみづから見て正しとする途にしてその終はつひに死にいたる途となるものあり"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 13,
    "text": "笑ふ時にも心に悲あり 歓樂の終に憂あり"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 14,
    "text": "心の悖れる者はおのれの途に飽かん 善人もまた自己に飽かん"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 15,
    "text": "拙者はすべての言を信ず 賢者はその行を愼む"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 16,
    "text": "智慧ある者は怖れて惡をはなれ 愚なる者はたかぶりて怖れず"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 17,
    "text": "怒り易き者は愚なることを行ひ 惡き謀計を設くる者は惡まる"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 18,
    "text": "拙者は愚なる事を得て所有となし 賢者は知識をもて冠弁となす"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 19,
    "text": "惡者は善者の前に俯伏し 罪ある者は義者の門に俯伏す"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 20,
    "text": "貧者はその鄰にさへも惡まる されど富者を愛する者はおほし"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 21,
    "text": "その鄰を藐むる者は罪あり 困苦者を憐むものは幸福あり"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 22,
    "text": "惡を謀る者は自己をあやまるにあらずや 善を謀る者には憐憫と眞實とあり"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 23,
    "text": "すべての勤勞には利益あり されど口唇のことばは貧乏をきたらするのみなり"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 24,
    "text": "智慧ある者の財寳はその冠弁となる 愚なる者のおろかはただ痴なり"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 25,
    "text": "眞實の證人は人のいのちを救ふ 謊言を吐く者は偽人なり"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 26,
    "text": "ヱホバを畏るることは堅き依賴なり その兒輩は逃避場をうべし"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 27,
    "text": "ヱホバを畏るることは生命の泉なり 人を死の罟より脱れしむ"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 28,
    "text": "王の榮は民の多きにあり 牧伯の衰敗は民を失ふにあり"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 29,
    "text": "怒を遅くする者は大なる知識あり 氣の短き者は愚なることを顯す"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 30,
    "text": "心の安穩なるは身のいのちなり 娼嫉は骨の腐なり"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 31,
    "text": "貧者を虐ぐる者はその造主を侮るなり 彼をうやまふ者は貧者をあはれむ"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 32,
    "text": "惡者はその惡のうちにて亡され義者はその死ぬる時にも望あり"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 33,
    "text": "智慧は哲者の心にとどまり 愚なる者の衷にある事はあらはる"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 34,
    "text": "義は國を高くし罪は民を辱しむ"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 35,
    "text": "さとき僕は王の恩を蒙ぶり 辱をきたらす者はその震怒にあふ"
  }
]
