[
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 1,
    "text": "レムエル王のことば即ちその母の彼に敎へし箴言なり"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 2,
    "text": "わが子よ何を言んか わが胎の子よ何をいはんか 我が願ひて得たる子よ何をいはんか"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 3,
    "text": "なんぢの力を女につひやすなかれ 王を滅すものに汝の途をまかする勿れ"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 4,
    "text": "レムエルよ酒を飮は王の爲べき事に非ず 王の爲べき事にあらず 醇醪を求むるは牧伯の爲すべき事にあらず"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 5,
    "text": "恐くは酒を飮て律法をわすれ 且すべて惱まさるる者の審判を枉げん"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 6,
    "text": "醇醪を亡びんとする者にあたへ 酒を心の傷める者にあたへよ"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 7,
    "text": "かれ飮てその貧窮をわすれ 復その苦楚を憶はざるべし"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 8,
    "text": "なんぢ瘖者のため又すべての孤者の訟のために口をひらけ"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 9,
    "text": "なんぢ口をひらきて義しき審判をなし貧者と窮乏者の訟を糺せ"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 10,
    "text": "誰か賢き女を見出すことを得ん その價は眞珠よりも貴とし"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 11,
    "text": "その夫の心は彼を恃み その產業は乏しくならじ"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 12,
    "text": "彼が存命ふる間はその夫に善事をなして惡き事をなさず"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 13,
    "text": "彼は羊の毛と麻とを求め喜びて手から操き"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 14,
    "text": "商賈の舟のごとく遠き國よりその糧を運び"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 15,
    "text": "夜のあけぬ先に起てその家人に糧をあたへ その婢女に日用の分をあたふ"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 16,
    "text": "田畝をはかりて之を買ひ その手の操作をもて葡萄園を植ゑ"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 17,
    "text": "力をもて腰に帶し その手を強くす"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 18,
    "text": "彼はその利潤の益あるを知る その燈火は終夜きえず"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 19,
    "text": "かれ手を紡線車にのべ その指に紡錘をとり"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 20,
    "text": "手を貧者にのべ 手を困苦者に舒ぶ"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 21,
    "text": "彼は家人の爲に雪をおそれず 蓋その家人みな蕃紅の衣をきればなり"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 22,
    "text": "彼はおのれの爲に美しき褥子をつくり 細布と紫とをもてその衣とせり"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 23,
    "text": "その夫はその地の長老とともに邑の門に坐するによりて人に知るるなり"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 24,
    "text": "彼は細布の衣を製りてこれをうり 帶をつくりて商賈にあたふ"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 25,
    "text": "彼は筋力と尊貴とを衣とし且のちの日を笑ふ"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 26,
    "text": "彼は口を啓きて智慧をのぶ 仁愛の敎誨その舌にあり"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 27,
    "text": "かれはその家の事を鑒み 怠惰の糧を食はず"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 28,
    "text": "その衆子は起て彼を祝す その夫も彼を讃ていふ"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 29,
    "text": "賢く事をなす女子は多けれども 汝はすべての女子に愈れり"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 30,
    "text": "艶麗はいつはりなり 美色は呼吸のごとし 惟ヱホバを畏るる女は譽られん"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 31,
    "text": "その手の操作の果をこれにあたへ その行爲によりてこれを邑の門にほめよ"
  }
]
