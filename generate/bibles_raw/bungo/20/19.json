[
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 1,
    "text": "ただしく歩むまづしき者は くちびるの悖れる愚なる者に愈る"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 2,
    "text": "心に思慮なければ善らず 足にて急ぐものは道にまよふ"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 3,
    "text": "人はおのれの痴によりて道につまづき 反て心にヱホバを怨む"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 4,
    "text": "資財はおほくの友をあつむ されど貧者はその友に疎まる"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 5,
    "text": "虚偽の證人は罰をまぬかれず 謊言をはくものは避るることをえず"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 6,
    "text": "君に媚る者はおほし 凡そ人は贈物を與ふる者の友となるなり"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 7,
    "text": "貧者はその兄弟すらも皆これをにくむ 况てその友これに遠ざからざらんや 言をはなちてこれを呼とも去てかへらざるなり"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 8,
    "text": "智慧を得る者はおのれの霊魂を愛す 聰明をたもつ者は善福を得ん"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 9,
    "text": "虚偽の證人は罰をまぬかれず 謊言をはく者はほろぶべし"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 10,
    "text": "愚なる者の驕奢に居るは適当からず 况て僕にして上に在る者を治むることをや"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 11,
    "text": "聰明は人に怒をしのばしむ 過失を宥すは人の榮譽なり"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 12,
    "text": "王の怒は獅の吼るが如く その恩典は草の上におく露のごとし"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 13,
    "text": "愚なる子はその父の災禍なり 妻の相爭そふは雨漏のたえぬにひとし"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 14,
    "text": "家と資財とは先祖より承嗣ぐもの 賢き妻はヱホバより賜ふものなり"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 15,
    "text": "懶惰は人を酣寐せしむ 懈怠人は饑べし"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 16,
    "text": "誡命を守るものは自己の霊魂を守るなり その道をかろむるものは死ぬべし"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 17,
    "text": "貧者をあはれむ者はヱホバに貸すなり その施濟はヱホバ償ひたまはん"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 18,
    "text": "望ある間に汝の子を打て これを殺すこころを起すなかれ"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 19,
    "text": "怒ることの烈しき者は罰をうく 汝もしこれを救ふともしばしば然せざるを得じ"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 20,
    "text": "なんぢ勸をきき訓をうけよ 然ばなんぢの終に智慧あらん"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 21,
    "text": "人の心には多くの計畫あり されど惟ヱホバの旨のみ立べし"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 22,
    "text": "人のよろこびは施濟をするにあり 貧者は謊人に愈る"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 23,
    "text": "ヱホバを畏るることは人をして生命にいたらしめ かつ恒に飽足りて災禍に遇ざらしむ"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 24,
    "text": "惰者はその手を盤にいるるも之をその口に擧ることをだにせず"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 25,
    "text": "嘲笑者を打て さらば拙者も愼まん 哲者を譴めよ さらばかれ知識を得ん"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 26,
    "text": "父を煩はし母を逐ふは羞赧をきたらし凌辱をまねく子なり"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 27,
    "text": "わが子よ哲言を離れしむる敎を聽くことを息めよ"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 28,
    "text": "惡き證人は審判を嘲り 惡者の口は惡を呑む"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 29,
    "text": "審判は嘲笑者のために備へられ 鞭は愚なる者の背のために備へらる"
  }
]
