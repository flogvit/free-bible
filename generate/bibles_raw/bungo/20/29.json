[
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 1,
    "text": "しばしば責られてもなほ強項なる者は救はるることなくして猝然に滅されん"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 2,
    "text": "義者ませば民よろこび 惡きもの權を掌らば民かなしむ"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 3,
    "text": "智慧を愛する人はその父を悦ばせ 妓婦に交る者はその財產を費す"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 4,
    "text": "王は公義をもて國を堅うす されど租税を征取る者はこれを滅す"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 5,
    "text": "その鄰に諂ふ者はかれの脚の前に羅を張る"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 6,
    "text": "惡人の罪の中には罟あり 然ど義者は歓び樂しむ"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 7,
    "text": "義きものは貧きものの訟をかへりみる 然ど惡人は之を知ることを願はず"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 8,
    "text": "嘲笑人は城邑を擾し 智慧ある者は怒をしづむ"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 9,
    "text": "智慧ある人おろかなる人と爭へば或は怒り或は笑ひて休むことなし"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 10,
    "text": "血をながす人は直き人を惡む されど義き者はその生命を救はんことを求む"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 11,
    "text": "愚なる者はその怒をことごとく露はし 智慧ある者は之を心に蔵む"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 12,
    "text": "君王もし虚偽の言を聽かばその臣みな惡し"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 13,
    "text": "貧者と苛酷者と偕に世にをる ヱホバは彼等の目に光をあたへ給ふ"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 14,
    "text": "眞實をもて弱者を審判する王はその位つねに堅く立つべし"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 15,
    "text": "鞭と譴責とは智慧をあたふ 任意になしおかれたる子はその母を辱しむ"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 16,
    "text": "惡きもの多ければ罪も亦おほし 義者は彼等の傾覆をみん"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 17,
    "text": "なんぢの子を懲せ さらば彼なんぢを安からしめ 又なんぢの心に喜樂を與へん"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 18,
    "text": "默示なければ民は放肆にす 律法を守るものは福ひなり"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 19,
    "text": "僕は言をもて譴むるとも改めず 彼は知れども從はざればなり"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 20,
    "text": "なんぢ言を謹まざる人を見しや 彼よりは却て愚なる者に望あり"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 21,
    "text": "僕をその幼なき時より柔かに育てなば終には子の如くならしめん"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 22,
    "text": "怒る人は爭端を起し憤る人は罪おほし"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 23,
    "text": "人の傲慢はおのれを卑くし 心に謙だる者は榮譽を得"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 24,
    "text": "盗人に黨する者はおのれの霊魂を惡むなり 彼は誓を聽けども説述べず"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 25,
    "text": "人を畏るれば罟におちいる ヱホバをたのむ者は護られん"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 26,
    "text": "君の慈悲を求むる者はおほし 然れど人の事を定むるはヱホバによる"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 27,
    "text": "不義をなす人は義者の惡むところ 義くあゆむ人は惡者の惡むところなり"
  }
]
