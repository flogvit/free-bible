[
  {
    "bookId": 20,
    "chapterId": 5,
    "verseId": 1,
    "text": "我が子よわが智慧をきけ 汝の耳をわが聰明に傾け"
  },
  {
    "bookId": 20,
    "chapterId": 5,
    "verseId": 2,
    "text": "しかしてなんぢ謹愼を守り汝の口唇に知識を保つべし"
  },
  {
    "bookId": 20,
    "chapterId": 5,
    "verseId": 3,
    "text": "娼妓の口唇は蜜を滴らし 其口は脂よりも滑なり"
  },
  {
    "bookId": 20,
    "chapterId": 5,
    "verseId": 4,
    "text": "されど其終は茵蔯の如くに苦く兩刃の劍の如くに利し"
  },
  {
    "bookId": 20,
    "chapterId": 5,
    "verseId": 5,
    "text": "その足は死に下り その歩は陰府に趣く"
  },
  {
    "bookId": 20,
    "chapterId": 5,
    "verseId": 6,
    "text": "彼は生命の途に入らず 其徑はさだかならねども自ら之を知ざるなり"
  },
  {
    "bookId": 20,
    "chapterId": 5,
    "verseId": 7,
    "text": "小子等よいま我にきけ 我が口の言を棄つる勿れ"
  },
  {
    "bookId": 20,
    "chapterId": 5,
    "verseId": 8,
    "text": "汝の途を彼より遠く離れしめよ 其家の門に近づくことなかれ"
  },
  {
    "bookId": 20,
    "chapterId": 5,
    "verseId": 9,
    "text": "恐くは汝の榮を他人にわたし 汝の年を憐憫なき者にわたすにいたらん"
  },
  {
    "bookId": 20,
    "chapterId": 5,
    "verseId": 10,
    "text": "恐くは他人なんぢの資財によりて盈され 汝の勞苦は他人の家にあらん"
  },
  {
    "bookId": 20,
    "chapterId": 5,
    "verseId": 11,
    "text": "終にいたりて汝の身なんぢの體亡ぶる時なんぢ泣悲みていはん"
  },
  {
    "bookId": 20,
    "chapterId": 5,
    "verseId": 12,
    "text": "われ敎をいとひ 心に譴責をかろんじ"
  },
  {
    "bookId": 20,
    "chapterId": 5,
    "verseId": 13,
    "text": "我が師の聲をきかず 我を敎ふる者に耳を傾けず"
  },
  {
    "bookId": 20,
    "chapterId": 5,
    "verseId": 14,
    "text": "あつまりの中會衆のうちにてほとんど諸の惡に陷れりと"
  },
  {
    "bookId": 20,
    "chapterId": 5,
    "verseId": 15,
    "text": "汝おのれの水溜より水を飮み おのれの泉より流るる水をのめ"
  },
  {
    "bookId": 20,
    "chapterId": 5,
    "verseId": 16,
    "text": "汝の流をほかに溢れしめ 汝の河の水を衢に流れしむべけんや"
  },
  {
    "bookId": 20,
    "chapterId": 5,
    "verseId": 17,
    "text": "これを自己に歸せしめ 他人をして汝と偕にこに與らしむること勿れ"
  },
  {
    "bookId": 20,
    "chapterId": 5,
    "verseId": 18,
    "text": "汝の泉に福祉を受しめ 汝の少き時の妻を樂しめ"
  },
  {
    "bookId": 20,
    "chapterId": 5,
    "verseId": 19,
    "text": "彼は愛しき麀のごとく美しき鹿の如し その乳房をもて常にたれりとし その愛をもて常によろこべ"
  },
  {
    "bookId": 20,
    "chapterId": 5,
    "verseId": 20,
    "text": "我子よ何なればあそびめをたのしみ 淫婦の胸を懐くや"
  },
  {
    "bookId": 20,
    "chapterId": 5,
    "verseId": 21,
    "text": "それ人の途はヱホバの目の前にあり 彼はすべて其行爲を量りたまふ"
  },
  {
    "bookId": 20,
    "chapterId": 5,
    "verseId": 22,
    "text": "惡者はおのれの愆にとらへられ その罪の繩に繋る"
  },
  {
    "bookId": 20,
    "chapterId": 5,
    "verseId": 23,
    "text": "彼は訓誨なきによりて死 その多くの愚なることに由りて亡ぶべし"
  }
]
