[
  {
    "bookId": 20,
    "chapterId": 25,
    "verseId": 1,
    "text": "此等もまたソロモンの箴言なり ユダの王ヒゼキヤに屬せる人々これを輯めたり"
  },
  {
    "bookId": 20,
    "chapterId": 25,
    "verseId": 2,
    "text": "事を隱すは神の榮譽なり 事を窮むるは王の榮譽なり"
  },
  {
    "bookId": 20,
    "chapterId": 25,
    "verseId": 3,
    "text": "天の高さと地の深さと 王たる者の心とは測るべからず"
  },
  {
    "bookId": 20,
    "chapterId": 25,
    "verseId": 4,
    "text": "銀より渣滓を除け さらば銀工の用ふべき器いでん"
  },
  {
    "bookId": 20,
    "chapterId": 25,
    "verseId": 5,
    "text": "王の前より惡者をのぞけ 然ばその位義によりて堅く立ん"
  },
  {
    "bookId": 20,
    "chapterId": 25,
    "verseId": 6,
    "text": "王の前に自ら高ぶることなかれ 貴人の場に立つことなかれ"
  },
  {
    "bookId": 20,
    "chapterId": 25,
    "verseId": 7,
    "text": "なんぢが目に見る王の前にて下にさげらるるよりは ここに上れといはるること愈れり"
  },
  {
    "bookId": 20,
    "chapterId": 25,
    "verseId": 8,
    "text": "汝かろがろしく出でて爭ふことなかれ 恐くは終にいたりて汝の鄰に辱しめられん その時なんぢ如何になさんとするか"
  },
  {
    "bookId": 20,
    "chapterId": 25,
    "verseId": 9,
    "text": "なんぢ鄰と爭ふことあらば只これと爭へ 人の密事を洩すなかれ"
  },
  {
    "bookId": 20,
    "chapterId": 25,
    "verseId": 10,
    "text": "恐くは聞者なんぢを卑しめん 汝そしられて止ざらん"
  },
  {
    "bookId": 20,
    "chapterId": 25,
    "verseId": 11,
    "text": "機にかなひて語る言は銀の彫刻物に金の林檎を嵌たるが如し"
  },
  {
    "bookId": 20,
    "chapterId": 25,
    "verseId": 12,
    "text": "智慧をもて譴むる者の之をきく者の耳におけることは 金の耳環と精金の飾のごとし"
  },
  {
    "bookId": 20,
    "chapterId": 25,
    "verseId": 13,
    "text": "忠信なる使者は之を遣す者におけること穡收の日に冷かなる雪あるがごとし 能その主の心を喜ばしむ"
  },
  {
    "bookId": 20,
    "chapterId": 25,
    "verseId": 14,
    "text": "おくりものすと偽りて誇る人は雨なき雲風の如し"
  },
  {
    "bookId": 20,
    "chapterId": 25,
    "verseId": 15,
    "text": "怒を緩くすれば君も言を容る 柔かなる舌は骨を折く"
  },
  {
    "bookId": 20,
    "chapterId": 25,
    "verseId": 16,
    "text": "なんぢ蜜を得るか 惟これを足る程に食へ 恐くは食ひ過して之を吐出さん"
  },
  {
    "bookId": 20,
    "chapterId": 25,
    "verseId": 17,
    "text": "なんぢの足を鄰の家にしげくするなかれ 恐くは彼なんぢを厭ひ惡まん"
  },
  {
    "bookId": 20,
    "chapterId": 25,
    "verseId": 18,
    "text": "その鄰に敵して虚偽の證をたつる人は斧刃または利き箭のごとし"
  },
  {
    "bookId": 20,
    "chapterId": 25,
    "verseId": 19,
    "text": "艱難に遇ふとき忠實ならぬ者を賴むは惡しき歯または跛たる足を恃むがごとし"
  },
  {
    "bookId": 20,
    "chapterId": 25,
    "verseId": 20,
    "text": "心の傷める人の前に歌をうたふは寒き日に衣をぬぐが如く 曹達のうへに酢を注ぐが如し"
  },
  {
    "bookId": 20,
    "chapterId": 25,
    "verseId": 21,
    "text": "なんぢの仇もし饑ゑなば之に糧をくらはせ もし渇かば之に水を飮ませよ"
  },
  {
    "bookId": 20,
    "chapterId": 25,
    "verseId": 22,
    "text": "なんぢ斯するは火をこれが首に積むなり ヱホバなんぢに報いたまふべし"
  },
  {
    "bookId": 20,
    "chapterId": 25,
    "verseId": 23,
    "text": "北風は雨をおこし かげごとをいふ舌は人の顔をいからす"
  },
  {
    "bookId": 20,
    "chapterId": 25,
    "verseId": 24,
    "text": "爭ふ婦と偕に室に居らんより屋蓋の隅にをるは宜し"
  },
  {
    "bookId": 20,
    "chapterId": 25,
    "verseId": 25,
    "text": "遠き國よりきたる好き消息は渇きたる人における冷かなる水のごとし"
  },
  {
    "bookId": 20,
    "chapterId": 25,
    "verseId": 26,
    "text": "義者の惡者の前に服するは井の濁れるがごとく泉の汚れたるがごとし"
  },
  {
    "bookId": 20,
    "chapterId": 25,
    "verseId": 27,
    "text": "蜜をおほく食ふは善らず 人おのれの榮譽をもとむるは榮譽にあらず"
  },
  {
    "bookId": 20,
    "chapterId": 25,
    "verseId": 28,
    "text": "おのれの心を制へざる人は石垣なき壞れたる城のごとし"
  }
]
