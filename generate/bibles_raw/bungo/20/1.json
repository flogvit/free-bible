[
  {
    "bookId": 20,
    "chapterId": 1,
    "verseId": 1,
    "text": "¶ ダビデの子イスラエルの王ソロモンの箴言"
  },
  {
    "bookId": 20,
    "chapterId": 1,
    "verseId": 2,
    "text": "こは人に智慧と訓誨とをしらしめ哲言を暁らせ"
  },
  {
    "bookId": 20,
    "chapterId": 1,
    "verseId": 3,
    "text": "さとき訓と公義と公平と正直とをえしめ"
  },
  {
    "bookId": 20,
    "chapterId": 1,
    "verseId": 4,
    "text": "拙者にさとりを與へ少者に知識と謹愼とを得させん爲なり"
  },
  {
    "bookId": 20,
    "chapterId": 1,
    "verseId": 5,
    "text": "智慧ある者は之を聞て學にすすみ 哲者は智略をうべし"
  },
  {
    "bookId": 20,
    "chapterId": 1,
    "verseId": 6,
    "text": "人これによりて箴言と譬喩と智慧ある者の言とその隠語とを悟らん"
  },
  {
    "bookId": 20,
    "chapterId": 1,
    "verseId": 7,
    "text": "ヱホバを畏るるは知識の本なり 愚なる者は智慧と訓誨とを軽んず"
  },
  {
    "bookId": 20,
    "chapterId": 1,
    "verseId": 8,
    "text": "我が子よ汝の父の敎をきけ 汝の母の法を棄ることなかれ"
  },
  {
    "bookId": 20,
    "chapterId": 1,
    "verseId": 9,
    "text": "これ汝の首の美しき冠となり 汝の項の妝飾とならん"
  },
  {
    "bookId": 20,
    "chapterId": 1,
    "verseId": 10,
    "text": "わが子よ惡者なんぢ誘ふとも從ふことなかれ"
  },
  {
    "bookId": 20,
    "chapterId": 1,
    "verseId": 11,
    "text": "彼等なんぢにむかひて請ふ われらと偕にきたれ 我儕まちぶせして人の血を流し 無辜ものを故なきに伏てねらひ"
  },
  {
    "bookId": 20,
    "chapterId": 1,
    "verseId": 12,
    "text": "陰府のごとく彼等を活たるままにて呑み 壯健なる者を墳に下る者のごとくになさん"
  },
  {
    "bookId": 20,
    "chapterId": 1,
    "verseId": 13,
    "text": "われら各樣のたふとき財貨をえ 奪ひ取たる物をもて我儕の家に盈さん"
  },
  {
    "bookId": 20,
    "chapterId": 1,
    "verseId": 14,
    "text": "汝われらと偕に籤をひけ 我儕とともに一の金嚢を持べしと云とも"
  },
  {
    "bookId": 20,
    "chapterId": 1,
    "verseId": 15,
    "text": "我が子よ彼等とともに途を歩むことなかれ 汝の足を禁めてその路にゆくこと勿れ"
  },
  {
    "bookId": 20,
    "chapterId": 1,
    "verseId": 16,
    "text": "そは彼らの足は惡に趨り 血を流さんとて急げばなり"
  },
  {
    "bookId": 20,
    "chapterId": 1,
    "verseId": 17,
    "text": "(すべて鳥の目の前にて羅を張は徒勞なり)"
  },
  {
    "bookId": 20,
    "chapterId": 1,
    "verseId": 18,
    "text": "彼等はおのれの血のために埋伏し おのれの命をふしてねらふ"
  },
  {
    "bookId": 20,
    "chapterId": 1,
    "verseId": 19,
    "text": "凡て利を貧る者の途はかくの如し 是その持主をして生命をうしなはしむるなり"
  },
  {
    "bookId": 20,
    "chapterId": 1,
    "verseId": 20,
    "text": "智慧外に呼はり衢に其聲をあげ"
  },
  {
    "bookId": 20,
    "chapterId": 1,
    "verseId": 21,
    "text": "熱閙しき所にさけび 城市の門の口邑の中にその言をのべていふ"
  },
  {
    "bookId": 20,
    "chapterId": 1,
    "verseId": 22,
    "text": "なんぢら拙者のつたなきを愛し 嘲笑者のあざけりを樂しみ 愚なる者の知識を惡むは幾時までぞや"
  },
  {
    "bookId": 20,
    "chapterId": 1,
    "verseId": 23,
    "text": "わが督斥にしたがひて心を改めよ 視よわれ我が霊を汝らにそそぎ 我が言をなんぢらに示さん"
  },
  {
    "bookId": 20,
    "chapterId": 1,
    "verseId": 24,
    "text": "われ呼たれども汝らこたへず 手を伸たれども顧る者なく"
  },
  {
    "bookId": 20,
    "chapterId": 1,
    "verseId": 25,
    "text": "かへつて我がすべての勸告をすて我が督斥を受ざりしに由り"
  },
  {
    "bookId": 20,
    "chapterId": 1,
    "verseId": 26,
    "text": "われ汝らが禍災にあふとき之を笑ひ 汝らの恐懼きたらんとき嘲るべし"
  },
  {
    "bookId": 20,
    "chapterId": 1,
    "verseId": 27,
    "text": "これは汝らのおそれ颶風の如くきたり 汝らのほろび颺風の如くきたり 艱難とかなしみと汝らにきたらん時なり"
  },
  {
    "bookId": 20,
    "chapterId": 1,
    "verseId": 28,
    "text": "そのとき彼等われを呼ばん 然れどわれ應へじ 只管に我を求めん されど我に遇じ"
  },
  {
    "bookId": 20,
    "chapterId": 1,
    "verseId": 29,
    "text": "かれら知識を憎み又ヱホバを畏るることを悦ばず"
  },
  {
    "bookId": 20,
    "chapterId": 1,
    "verseId": 30,
    "text": "わが勸に從はず凡て我督斥をいやしめたるによりて"
  },
  {
    "bookId": 20,
    "chapterId": 1,
    "verseId": 31,
    "text": "己の途の果を食ひおのれの策略に飽べし"
  },
  {
    "bookId": 20,
    "chapterId": 1,
    "verseId": 32,
    "text": "拙者の違逆はおのれを殺し 愚なる者の幸福はおのれを滅さん"
  },
  {
    "bookId": 20,
    "chapterId": 1,
    "verseId": 33,
    "text": "されど我に聞ものは平穩に住ひかつ禍害にあふ恐怖なくして安然ならん"
  }
]
