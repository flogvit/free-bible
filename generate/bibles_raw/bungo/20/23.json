[
  {
    "bookId": 20,
    "chapterId": 23,
    "verseId": 1,
    "text": "なんぢ侯たる者とともに坐して食ふときは 愼みて汝の前にある者の誰なるかを思へ"
  },
  {
    "bookId": 20,
    "chapterId": 23,
    "verseId": 2,
    "text": "汝もし食を嗜む者ならば汝の喉に刀をあてよ"
  },
  {
    "bookId": 20,
    "chapterId": 23,
    "verseId": 3,
    "text": "その珍饈を貧り食ふこと勿れ これ迷惑の食物なればなり"
  },
  {
    "bookId": 20,
    "chapterId": 23,
    "verseId": 4,
    "text": "富を得んと思煩らふこと勿れ 自己の明哲を恃むこと勿れ"
  },
  {
    "bookId": 20,
    "chapterId": 23,
    "verseId": 5,
    "text": "なんぢ虚しきに歸すべき者に目をとむるか 富はかならず自ら翅を生じて鷲のごとく天に飛さらん"
  },
  {
    "bookId": 20,
    "chapterId": 23,
    "verseId": 6,
    "text": "惡目をする者の糧をくらふことなく その珍饈をむさぼりねがふことなかれ"
  },
  {
    "bookId": 20,
    "chapterId": 23,
    "verseId": 7,
    "text": "そはその心に思ふごとくその人となりも亦しかればなり 彼なんぢに食へ飮めといふこといへどもその心は汝に眞實ならず"
  },
  {
    "bookId": 20,
    "chapterId": 23,
    "verseId": 8,
    "text": "汝つひにその食へる物を吐出すにいたり 且その出しし懇懃の言もむなしくならん"
  },
  {
    "bookId": 20,
    "chapterId": 23,
    "verseId": 9,
    "text": "愚なる者の耳に語ること勿れ 彼なんぢが言の示す明哲を藐めん"
  },
  {
    "bookId": 20,
    "chapterId": 23,
    "verseId": 10,
    "text": "古き地界を移すことなかれ 孤子の畑を侵すことなかれ"
  },
  {
    "bookId": 20,
    "chapterId": 23,
    "verseId": 11,
    "text": "そはかれが贖者は強し 必ず汝に對らひて之が訴をのべん"
  },
  {
    "bookId": 20,
    "chapterId": 23,
    "verseId": 12,
    "text": "汝の心を敎に用ゐ 汝の耳を知識の言に傾けよ"
  },
  {
    "bookId": 20,
    "chapterId": 23,
    "verseId": 13,
    "text": "子を懲すことを爲ざるなかれ 鞭をもて彼を打とも死ることあらじ"
  },
  {
    "bookId": 20,
    "chapterId": 23,
    "verseId": 14,
    "text": "もし鞭をもて彼をうたばその霊魂を陰府より救ふことをえん"
  },
  {
    "bookId": 20,
    "chapterId": 23,
    "verseId": 15,
    "text": "わが子よもし汝のこころ智からば我が心もまた歓び"
  },
  {
    "bookId": 20,
    "chapterId": 23,
    "verseId": 16,
    "text": "もし汝の口唇ただしき事をいはば我が腎腸も喜ぶべし"
  },
  {
    "bookId": 20,
    "chapterId": 23,
    "verseId": 17,
    "text": "なんぢ心に罪人をうらやむ勿れ ただ終日ヱホバを畏れよ"
  },
  {
    "bookId": 20,
    "chapterId": 23,
    "verseId": 18,
    "text": "そは必ず應報ありて汝の望は廢らざればなり"
  },
  {
    "bookId": 20,
    "chapterId": 23,
    "verseId": 19,
    "text": "わが子よ 汝ききて智慧をえ かつ汝の心を道にかたぶけよ"
  },
  {
    "bookId": 20,
    "chapterId": 23,
    "verseId": 20,
    "text": "酒にふけり肉をたしむものと交ること勿れ"
  },
  {
    "bookId": 20,
    "chapterId": 23,
    "verseId": 21,
    "text": "それ酒にふける者と肉を嗜む者とは貧しくなり 睡眠を貧る者は敞れたる衣をきるにいたらん"
  },
  {
    "bookId": 20,
    "chapterId": 23,
    "verseId": 22,
    "text": "汝を生る父にきけ 汝の老たる母を軽んずる勿れ"
  },
  {
    "bookId": 20,
    "chapterId": 23,
    "verseId": 23,
    "text": "眞理を買へ これを售るなかれ 智慧と誡命と知識とまた然あれ"
  },
  {
    "bookId": 20,
    "chapterId": 23,
    "verseId": 24,
    "text": "義き者の父は大によろこび 智慧ある子を生る者はこれがために樂しまん"
  },
  {
    "bookId": 20,
    "chapterId": 23,
    "verseId": 25,
    "text": "汝の父母を樂しませ 汝を生る者を喜ばせよ"
  },
  {
    "bookId": 20,
    "chapterId": 23,
    "verseId": 26,
    "text": "わが子よ汝の心を我にあたへ 汝の目にわが途を樂しめ"
  },
  {
    "bookId": 20,
    "chapterId": 23,
    "verseId": 27,
    "text": "それ妓婦は深き坑のごとく 淫婦は狭き井のごとし"
  },
  {
    "bookId": 20,
    "chapterId": 23,
    "verseId": 28,
    "text": "彼は盗賊のごとく人を窺ひ かつ世の人の中に悖れる者を増なり"
  },
  {
    "bookId": 20,
    "chapterId": 23,
    "verseId": 29,
    "text": "禍害ある者は誰ぞ 憂愁ある者は誰ぞ 爭端をなす者は誰ぞ 煩慮ある者は誰ぞ 故なくして傷をうくる者は誰ぞ 赤目ある者は誰ぞ"
  },
  {
    "bookId": 20,
    "chapterId": 23,
    "verseId": 30,
    "text": "是すなはち酒に夜をふかすもの 往て混和せたる酒を味ふる者なり"
  },
  {
    "bookId": 20,
    "chapterId": 23,
    "verseId": 31,
    "text": "酒はあかく盃の中に泡だち滑かにくだる 汝これを見るなかれ"
  },
  {
    "bookId": 20,
    "chapterId": 23,
    "verseId": 32,
    "text": "是は終に蛇のごとく噬み蝮の如く刺すべし"
  },
  {
    "bookId": 20,
    "chapterId": 23,
    "verseId": 33,
    "text": "また汝の目は怪しきものを見 なんぢの心は諕言をいはん"
  },
  {
    "bookId": 20,
    "chapterId": 23,
    "verseId": 34,
    "text": "汝は海のなかに偃すもののごとく帆桅の上に偃すもののごとし"
  },
  {
    "bookId": 20,
    "chapterId": 23,
    "verseId": 35,
    "text": "汝いはん人われを撃ども我いたまず 我を拷けども我おぼえず 我さめなばまた酒を求めんと"
  }
]
