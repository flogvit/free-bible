[
  {
    "bookId": 20,
    "chapterId": 27,
    "verseId": 1,
    "text": "なんぢ明日のことを誇るなかれ そは一日の生ずるところの如何なるを知ざればなり"
  },
  {
    "bookId": 20,
    "chapterId": 27,
    "verseId": 2,
    "text": "汝おのれの口をもて自ら讃むることなく人をして己を讃めしめよ 自己の口唇をもてせず 他人をして己をほめしめよ"
  },
  {
    "bookId": 20,
    "chapterId": 27,
    "verseId": 3,
    "text": "石は重く沙は軽からず 然ど愚なる者の怒はこの二よりも重し"
  },
  {
    "bookId": 20,
    "chapterId": 27,
    "verseId": 4,
    "text": "忿怒は猛く憤恨は烈し されど嫉妬の前には誰か立ことをを得ん"
  },
  {
    "bookId": 20,
    "chapterId": 27,
    "verseId": 5,
    "text": "明白に譴むるに秘に愛するに愈る"
  },
  {
    "bookId": 20,
    "chapterId": 27,
    "verseId": 6,
    "text": "愛する者の傷つくるは眞實よりし 敵の接吻するは偽詐よりするなり"
  },
  {
    "bookId": 20,
    "chapterId": 27,
    "verseId": 7,
    "text": "飽るものは蜂の蜜をも踐つく されど饑たる者には苦き物さへもすべて甘し"
  },
  {
    "bookId": 20,
    "chapterId": 27,
    "verseId": 8,
    "text": "その家を離れてさまよふ人は その巣を離れてさまよふ鳥のごとし"
  },
  {
    "bookId": 20,
    "chapterId": 27,
    "verseId": 9,
    "text": "膏と香とは人の心をよろこばすなり 心よりして勸言を與ふる友の美しきもまた斯のごとし"
  },
  {
    "bookId": 20,
    "chapterId": 27,
    "verseId": 10,
    "text": "なんぢの友と汝の父の友とを棄るなかれ なんぢ患難にあふ日に兄弟の家にいることなかれ 親しき隣は疏き兄弟に愈れり"
  },
  {
    "bookId": 20,
    "chapterId": 27,
    "verseId": 11,
    "text": "わが子よ智慧を得てわが心を悦ばせよ 然ば我をそしる者に我こたふることを得ん"
  },
  {
    "bookId": 20,
    "chapterId": 27,
    "verseId": 12,
    "text": "賢者は禍害を見てみづから避け 拙者はすすみて罰をうく"
  },
  {
    "bookId": 20,
    "chapterId": 27,
    "verseId": 13,
    "text": "人の保證をなす者よりは先その衣をとれ 他人の保證をなす者をば固くとらへよ"
  },
  {
    "bookId": 20,
    "chapterId": 27,
    "verseId": 14,
    "text": "晨はやく起て大聲にその鄰を祝すれば却て呪詛と見なされん"
  },
  {
    "bookId": 20,
    "chapterId": 27,
    "verseId": 15,
    "text": "相爭ふ婦は雨ふる日に絶ずある雨漏のごとし"
  },
  {
    "bookId": 20,
    "chapterId": 27,
    "verseId": 16,
    "text": "これを制ふるものは風をおさふるがごとく 右の手に膏をつかむがごとし"
  },
  {
    "bookId": 20,
    "chapterId": 27,
    "verseId": 17,
    "text": "鐵は鐵をとぐ 斯のごとくその友の面を研なり"
  },
  {
    "bookId": 20,
    "chapterId": 27,
    "verseId": 18,
    "text": "無花果の樹をまもる者はその果をくらふ 主を貴ぶものは譽を得"
  },
  {
    "bookId": 20,
    "chapterId": 27,
    "verseId": 19,
    "text": "水に照せば面と面と相肖るがごとく 人の心は人の心に似たり"
  },
  {
    "bookId": 20,
    "chapterId": 27,
    "verseId": 20,
    "text": "陰府と沈淪とは飽ことなく 人の目もまた飽ことなし"
  },
  {
    "bookId": 20,
    "chapterId": 27,
    "verseId": 21,
    "text": "坩堝によりて銀をためし鑢によりて金をためし その讃らるる所によりて人をためす"
  },
  {
    "bookId": 20,
    "chapterId": 27,
    "verseId": 22,
    "text": "なんぢ愚なる者を臼にいれ杵をもて麥と偕にこれを搗ともその愚は去らざるなり"
  },
  {
    "bookId": 20,
    "chapterId": 27,
    "verseId": 23,
    "text": "なんぢの羊の情况をよく知り なんぢの群に心を留めよ"
  },
  {
    "bookId": 20,
    "chapterId": 27,
    "verseId": 24,
    "text": "富は永く保つものにあらず いかで位は世々にたもたん"
  },
  {
    "bookId": 20,
    "chapterId": 27,
    "verseId": 25,
    "text": "艸枯れ苗いで山の蔬菜あつめらる"
  },
  {
    "bookId": 20,
    "chapterId": 27,
    "verseId": 26,
    "text": "羔羊はなんぢの衣服を出し 牝羊は田圃を買ふ價となり"
  },
  {
    "bookId": 20,
    "chapterId": 27,
    "verseId": 27,
    "text": "牝羊の乳はおほくして汝となんぢの家人の糧となり汝の女をやしなふにたる"
  }
]
