[
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 1,
    "text": "智慧はその家を建て その七の柱を砍成し"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 2,
    "text": "その畜を宰り その酒を混和せ その筵をそなへ"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 3,
    "text": "その婢女をつかはして邑の高處に呼はりいはしむ"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 4,
    "text": "拙者よここに來れと また智慧なき者にいふ"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 5,
    "text": "汝等きたりて我が糧を食ひ わがまぜあはせたる酒をのみ"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 6,
    "text": "拙劣をすてて生命をえ 聰明のみちを行め"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 7,
    "text": "嘲笑者をいましむる者は恥を己にえ 惡人を責むる者は疵を己にえん"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 8,
    "text": "嘲笑者を責むることなかれ 恐くは彼なんぢを惡まん 智慧ある者をせめよ 彼なんぢを愛せん"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 9,
    "text": "智慧ある者に授けよ 彼はますます智慧をえん 義者を敎へよ 彼は知識に進まん"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 10,
    "text": "ヱホバを畏るることは智慧の根本なり 聖者を知るは聰明なり"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 11,
    "text": "我により汝の日は多くせられ 汝のいのちの年は増べし"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 12,
    "text": "汝もし智慧あらば自己のために智慧あるなり 汝もし嘲らば汝ひとり之を負ん"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 13,
    "text": "愚なる婦は嘩しく且つたなくして何事をも知らず"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 14,
    "text": "その家の門に坐し邑のたかき處にある座にすわり"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 15,
    "text": "道をますぐに過る往來の人を招きていふ"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 16,
    "text": "拙者よここに來れと また智慧なき人にむかひては之にいふ"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 17,
    "text": "竊みたる水は甘く密かに食ふ糧は美味ありと"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 18,
    "text": "彼處にある者は死し者その客は陰府のふかき處にあることを是等の人は知らざるなり"
  }
]
