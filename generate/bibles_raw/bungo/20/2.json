[
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 1,
    "text": "我が子よ汝もし我が言をうけ 我が誡命を汝のこころに蔵め"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 2,
    "text": "斯て汝の耳を智慧に傾け汝の心をさとりにむけ"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 3,
    "text": "もし知識を呼求め聰明をえんと汝の聲をあげ"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 4,
    "text": "銀の如くこれを探り 秘れたる寳の如くこれを尋ねば"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 5,
    "text": "汝ヱホバを畏るることを暁り 神を知ることを得べし"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 6,
    "text": "そはヱホバは智慧をあたへ 知識と聰明とその口より出づればなり"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 7,
    "text": "かれは義人のために聰明をたくはへ 直く行む者の盾となる"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 8,
    "text": "そは公平の途をたもち その聖徒の途すぢを守りたまへばなり"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 9,
    "text": "斯て汝はつひに公義と公平と正直と一切の善道を暁らん"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 10,
    "text": "すなはち智慧なんぢの心にいり 知識なんぢの霊魂に樂しからん"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 11,
    "text": "謹愼なんぢを守り 聰明なんぢをたもちて"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 12,
    "text": "惡き途よりすくひ虚偽をかたる者より救はん"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 13,
    "text": "彼等は直き途をはなれて幽暗き路に行み"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 14,
    "text": "惡を行ふを樂しみ 惡者のいつはりを悦び"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 15,
    "text": "その途はまがり その行爲は邪曲なり"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 16,
    "text": "聰明はまた汝を妓女より救ひ 言をもて諂ふ婦より救はん"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 17,
    "text": "彼はわかき時の侶をすて その神に契約せしことを忘るるなり"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 18,
    "text": "その家は死に下り その途は陰府に赴く"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 19,
    "text": "凡てかれにゆく者は歸らず また生命の途に達らざるなり"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 20,
    "text": "聰明汝をたもちてよき途に行ませ 義人の途を守らしめん"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 21,
    "text": "そは義人は地にながらへをり 完全者は地に止らん"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 22,
    "text": "されど惡者は地より亡され悖逆者は地より抜さらるべし"
  }
]
