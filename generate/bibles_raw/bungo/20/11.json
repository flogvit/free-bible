[
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 1,
    "text": "いつはりの權衝はヱホバに惡まれ 義しき法馬は彼に欣ばる"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 2,
    "text": "驕傲きたれば辱も亦きたる謙だる者には智慧あり"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 3,
    "text": "直者の端荘は己を導き悖逆者の邪曲は己を亡す"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 4,
    "text": "寳は震怒の日に益なし されど正義は救ふて死をまぬかれしむ"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 5,
    "text": "完全者はその正義によりてその途を直くせられ 惡者はその惡によりて跌るべし"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 6,
    "text": "直者はその正義によりて救はれ 悖逆者は自己の惡によりて執へらる"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 7,
    "text": "惡人は死るときにその望たえ 不義なる者の望もまた絶べし"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 8,
    "text": "義者は艱難より救はれ 惡者はこれに代る"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 9,
    "text": "邪曲なる者は口をもてその鄰を亡す されど義しき者はその知識によりて救はる"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 10,
    "text": "義しきもの幸福を受ればその城邑に歓喜あり 惡きもの亡さるれば歓喜の聲おこる"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 11,
    "text": "城邑は直者の祝ふに倚て高く擧られ 惡者の口によりて亡さる"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 12,
    "text": "その鄰を侮る者は智慧なし 聰明人はその口を噤む"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 13,
    "text": "往て人の是非をいふ者は密事を洩し 心の忠信なる者は事を隱す"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 14,
    "text": "はかりごとなければ民たふれ 議士多ければ平安なり"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 15,
    "text": "他人のために保證をなす者は苦難をうけ 保證を嫌ふ者は平安なり"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 16,
    "text": "柔順なる婦は榮譽をえ 強き男子は資財を得"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 17,
    "text": "慈悲ある者は己の霊魂に益をくはへ 殘忍者はおのれの身を擾はす"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 18,
    "text": "惡者の獲る報はむなしく 義を播くものの得る報賞は確し"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 19,
    "text": "堅く義をたもつ者は生命にいたり 惡を追もとむる者はおのれの死をまねく"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 20,
    "text": "心の戻れる者はヱホバに憎まれ 直く道を歩む者は彼に悦ばる"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 21,
    "text": "手に手をあはするとも惡人は罪をまぬかれず 義人の苗裔は救を得"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 22,
    "text": "美しき婦のつつしみなきは金の環の豕の鼻にあるが如し"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 23,
    "text": "義人のねがふところは凡て福祉にいたり 惡人ののぞむところは震怒にいたる"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 24,
    "text": "ほどこし散して反りて増ものあり 與ふべきを吝みてかへりて貧しきにいたる者あり"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 25,
    "text": "施與を好むものは肥え 人を潤ほす者はまた利潤をうく"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 26,
    "text": "穀物を蔵めて糶ざる者は民に詛はる 然れど售る者の首には祝福あり"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 27,
    "text": "善をもとむる者は恩惠をえん 惡をもとむる者には惡き事きたらん"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 28,
    "text": "おのれの富を恃むものは仆れん されど義者は樹の靑葉のごとくさかえん"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 29,
    "text": "おのれの家をくるしむるものは風をえて所有とせん 愚なる者は心の智きものの僕とならん"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 30,
    "text": "義人の果は生命の樹なり 智慧ある者は人を捕ふ"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 31,
    "text": "みよ義人すらも世にありて報をうくべし况て惡人と罪人とをや"
  }
]
