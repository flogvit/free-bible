[
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 1,
    "text": "榮譽の愚なる者に適はざるは夏の時に雪ふり 穡收の時に雨ふるがごとし"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 2,
    "text": "故なき詛は雀の翔り燕の飛ぶが如くにきたるものにあらず"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 3,
    "text": "馬の爲には策あり 驢馬の爲には銜あり 愚なる者の背のために杖あり"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 4,
    "text": "愚なる者の痴にしたがひて答ふること勿れ 恐くはおのれも是と同じからん"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 5,
    "text": "愚なる者の痴にしたがひて之に答へよ 恐くは彼おのれの目に自らを智者と見ん"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 6,
    "text": "愚なる者に托して事を言おくる者はおのれの足をきり身に害をうく"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 7,
    "text": "跛者の足は用なし 愚なる者の口の箴もかくのごとし"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 8,
    "text": "榮譽を愚なる者に與ふるは石を投石索に繋ぐが如し"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 9,
    "text": "愚なる者の口にたもつ箴言は酔へるものの刺ある杖を手にて擧ぐるがごとし"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 10,
    "text": "愚なる者を傭ひ流浪者を傭ふ者は すべての人を傷くる射手の如し"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 11,
    "text": "狗のかへり來りてその吐たる物を食ふがごとく 愚なる者は重ねてその痴なる事をおこなふ"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 12,
    "text": "汝おのれの目に自らを智慧ある者とする人を見るか 彼よりも却て愚なる人に望あり"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 13,
    "text": "惰者は途に獅あり 衢に獅ありといふ"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 14,
    "text": "戸の蝶鉸によりて轉るごとく惰者はその牀に輾轉す"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 15,
    "text": "惰者はその手を盤にいるるも之をその口に擧ることを厭ふ"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 16,
    "text": "惰者はおのれの目に自らを善く答ふる七人の者よりも智慧ありとなす"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 17,
    "text": "路をよぎり自己に關りなき爭擾にたづさはる者は狗の耳をとらふる者のごとし"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 18,
    "text": "旣にその鄰を欺くことをなして我はただ戯れしのみといふ者は 火箭または鎗または死を擲つ狂人のごとし"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 20,
    "text": "薪なければ火はきえ 人の是非をいふ者なければ爭端はやむ"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 21,
    "text": "煨火に炭をつぎ火に薪をくぶるがごとく爭論を好む人は爭論を起す"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 22,
    "text": "人の是非をいふものの言はたはぶれのごとしと雖もかへつて腹の奧に入る"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 23,
    "text": "温かき口唇をもちて惡き心あるは銀の滓をきせたる瓦片のごとし"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 24,
    "text": "恨むる者は口唇をもて自ら飾れども 心の衷には虚偽をいだく"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 25,
    "text": "彼その聲を和らかにするとも之を信ずるなかれ その心に七の憎むべき者あればなり"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 26,
    "text": "たとひ虚偽をもてその恨をかくすとも その惡は會集の中に顯はる"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 27,
    "text": "坑を掘るものは自ら之に陷らん 石を轉ばしあぐる者の上にはその石まろびかへらん"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 28,
    "text": "虚偽の舌はおのれの害す者を憎み 諂ふ口は滅亡をきたらす"
  }
]
