[
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 1,
    "text": "柔和なる答は憤恨をとどめ厲しき言は怒を激す"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 2,
    "text": "智慧ある者の舌は知識を善きものとおもはしめ 愚なる者の口はおろかをはく"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 3,
    "text": "ヱホバの目は何處にもありて惡人と善人とを鑒みる"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 4,
    "text": "温柔き舌は生命の樹なり 悖れる舌は霊魂を傷ましむ"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 5,
    "text": "愚なる者はその父の訓をかろんず 誡命をまもる者は賢者なり"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 6,
    "text": "義者の家には多くの資財あり 惡者の利潤には擾累あり"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 7,
    "text": "智者のくちびるは知識をひろむ 愚なる者の心は定りなし"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 8,
    "text": "惡者の祭物はヱホバに憎まれ 直き人の祈は彼に悦ばる"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 9,
    "text": "惡者の道はヱホバに憎まれ 正義をもとむる者は彼に愛せらる"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 10,
    "text": "道をはなるる者には嚴しき懲治あり 譴責を惡む者は死ぬべし"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 11,
    "text": "陰府と沉淪とはヱホバの目の前にあり 况て人の心をや"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 12,
    "text": "嘲笑者は誡めらるることを好まず また智慧ある者に近づかず"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 13,
    "text": "心に喜樂あれば顔色よろこばし 心に憂苦あれば氣ふさぐ"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 14,
    "text": "哲者のこころは知識をたづね 愚なる者の口は愚をくらふ"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 15,
    "text": "艱難者の日はことごとく惡く 心の懽べる者は恒に酒宴にあり"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 16,
    "text": "すこしの物を有てヱホバを畏るるは多の寳をもちて擾煩あるに愈る"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 17,
    "text": "蔬菜をくらひて互に愛するは肥たる牛を食ひて互に恨むるに愈る"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 18,
    "text": "憤ほり易きものは爭端をおこし 怒をおそくする者は爭端をとどむ"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 19,
    "text": "惰者の道は棘の籬に似たり 直者の途は平坦なり"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 20,
    "text": "智慧ある子は父をよろこばせ 愚なる人はその母をかろんず"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 21,
    "text": "無知なる者は愚なる事をよろこび 哲者はその途を直くす"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 22,
    "text": "相議ることあらざれば謀計やぶる 議者おほければ謀計かならず成る"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 23,
    "text": "人はその口の答によりて喜樂をう 言語を出して時に適ふはいかに善らずや"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 24,
    "text": "智人の途は生命の路にして上へ昇りゆく これ下にあるところの陰府を離れんが爲なり"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 25,
    "text": "ヱホバはたかぶる者の家をほろぼし 寡婦の地界をさだめたまふ"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 26,
    "text": "あしき謀計はヱホバに憎まれ 温柔き言は潔白し"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 27,
    "text": "不義の利をむさぼる者はその家をわづらはせ 賄賂をにくむ者は活ながらふべし"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 28,
    "text": "義者の心は答ふべきことを考へ 惡者の口は惡を吐く"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 29,
    "text": "ヱホバは惡者に遠ざかり 義者の祈祷をききたまふ"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 30,
    "text": "目の光は心をよろこばせ 好音信は骨をうるほす"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 31,
    "text": "生命の誡命をきくところの耳は智慧ある者の中間に駐まる"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 32,
    "text": "敎をすつる者は自己の生命をかろんずるなり 懲治をきく者は聰明を得"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 33,
    "text": "ヱホバを畏るることは智慧の訓なり 謙遜は尊貴に先だつ"
  }
]
