[
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 1,
    "text": "自己を人と異にする者はおのれの欲するところのみを求めてすべての善き考察にもとる"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 2,
    "text": "愚なる者は明哲を喜ばず 惟おのれの心意を顯すことを喜ぶ"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 3,
    "text": "惡者きたれば藐視したがひてきたり 恥きたれば凌辱もともに來る"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 4,
    "text": "人の口の言は深水の如し 湧てながるる川 智慧の泉なり"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 5,
    "text": "惡者を偏視るは善らず 審判をなして義者を惡しとするも亦善らず"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 6,
    "text": "愚なる者の口唇はあらそひを起し その口は打るることを招く"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 7,
    "text": "愚なる者の口はおのれの敗壞となり その口唇はおのれの霊魂の罟となる"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 8,
    "text": "人の是非をいふものの言はたはぶれのごとしといへども反つて腹の奧にいる"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 9,
    "text": "その行爲をおこたる者は滅すものの兄弟なり"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 10,
    "text": "ヱホバの名はかたき櫓のごとし 義者は之に走りいりて救を得"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 11,
    "text": "富者の資財はその堅き城なり これを高き石垣の如くに思ふ"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 12,
    "text": "人の心のたかぶりは滅亡に先だち 謙遜はたふとまるる事にさきだつ"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 13,
    "text": "いまだ事をきかざるさきに應ふる者は愚にして辱をかうぶる"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 14,
    "text": "人の心は尚其疾を忍ぶべし されど心の傷める時は誰かこれに耐んや"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 15,
    "text": "哲者の心は知識をえ 智慧ある者の耳は知識を求む"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 16,
    "text": "人の贈物はその人のために道をひらき かつ貴きものの前にこれを導く"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 17,
    "text": "先に訴訟の理由をのぶるものは正義に似たれども その鄰人きたり詰問ひてその事を明かにす"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 18,
    "text": "籤は爭端をとどめ且つよきものの間にへだてとなる"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 19,
    "text": "怒れる兄弟はかたき城にもまさりて説き伏せがたし 兄弟のあらそひは櫓の貫木のごとし"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 20,
    "text": "人は口の徳によりて腹をあかし その口唇の徳によりて自ら飽べし"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 21,
    "text": "死生は舌の權能にあり これを愛する者はその果を食はん"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 22,
    "text": "妻を得るものは美物を得るなり 且ヱホバより恩寵をあたへらる"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 23,
    "text": "貧者は哀なる言をもて乞ひ 富人は厲しき答をなす"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 24,
    "text": "多の友をまうくる人は遂にその身を亡す 但し兄弟よりもたのもしき知己もまたあり"
  }
]
