[
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 1,
    "text": "睦じうして一塊の乾けるパンあるは あらそひありて宰れる畜の盈たる家に愈る"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 2,
    "text": "かしこき僕は恥をきたらする子ををさめ 且その子の兄弟の中にありて產業を分ち取る"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 3,
    "text": "銀を試むる者は坩堝 金を試むる者は鑢 人の心を試むる者はヱホバなり"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 4,
    "text": "惡を行ふものは虚偽のくちびるにきき 虚偽をいふ者はあしき舌に耳を傾ぶく"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 5,
    "text": "貧人を嘲るものはその造主をあなどるなり 人の災禍を喜ぶものは罪をまぬかれず"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 6,
    "text": "孫は老人の冠弁なり 父は子の榮なり"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 7,
    "text": "勝れたる事をいふは愚なる人に適はず 况て虚偽をいふ口唇は君たる者に適はんや"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 8,
    "text": "贈物はこれを受る者の目には貴き珠のごとし その向ふところにて凡て幸福を買ふ"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 9,
    "text": "愛を追求むる者は人の過失をおほふ 人の事を言ひふるる者は朋友をあひ離れしむ"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 10,
    "text": "一句の誡命の智人に徹るは百囘扑つことの愚なる人に徹るよりも深し"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 11,
    "text": "叛きもとる者はただ惡きことのみをもとむ 比故に彼にむかひて殘忍なる使者遣はさる"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 12,
    "text": "愚なる者の愚妄をなすにあはんよりは寧ろ子をとられたる牝熊にあへ"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 13,
    "text": "惡をもて善に報ゆる者は惡その家を離れじ"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 14,
    "text": "爭端の起源は堤より水をもらすに似たり この故にあらそひの起らざる先にこれを止むべし"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 15,
    "text": "惡者を義とし義者を惡しとするこの二の者はヱホバに憎まる"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 16,
    "text": "愚なる者はすでに心なし何ぞ智慧をかはんとて手にその價の金をもつや"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 17,
    "text": "朋友はいづれの時にも愛す 兄弟は危難の時のために生る"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 18,
    "text": "智慧なき人は手を拍てその友の前にて保證をなす"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 19,
    "text": "爭端をこのむ者は罪を好み その門を高くする者は敗壞を求む"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 20,
    "text": "邪曲なる心ある者はさいはひを得ず その舌をみだりにする者はわざはひに陷る"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 21,
    "text": "愚なる者を產むものは自己の憂を生じ 愚なる者の父は喜樂を得ず"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 22,
    "text": "心のたのしみは良薬なり 霊魂のうれひは骨を枯す"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 23,
    "text": "惡者は人の懐より賄賂をうけて審判の道をまぐ"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 24,
    "text": "智慧は哲者の面のまへにあり されど愚なる者は目を地の極にそそぐ"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 25,
    "text": "愚なる子は其父の憂となり 亦これを生る母の煩勞となる"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 26,
    "text": "義者を罰するは善らず 貴き者をその義きがために扑は善らず"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 27,
    "text": "言を寡くする者は知識あり 心の靜なる者は哲人なり"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 28,
    "text": "愚なる者も默するときは智慧ある者と思はれ その口唇を閉るときは哲者とおもはるべし"
  }
]
