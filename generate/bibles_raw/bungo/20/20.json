[
  {
    "bookId": 20,
    "chapterId": 20,
    "verseId": 1,
    "text": "酒は人をして嘲らせ 濃酒は人をして騒がしむ 之に迷はさるる者は無智なり"
  },
  {
    "bookId": 20,
    "chapterId": 20,
    "verseId": 2,
    "text": "王の震怒は獅の吼るがごとし 彼を怒らする者は自己のいのちを害ふ"
  },
  {
    "bookId": 20,
    "chapterId": 20,
    "verseId": 3,
    "text": "穩かに居りて爭はざるは人の榮譽なりすべて愚なる者は怒り爭ふ"
  },
  {
    "bookId": 20,
    "chapterId": 20,
    "verseId": 4,
    "text": "惰者は寒ければとて耕さず この故に収穫のときにおよびて求るとも得るところなし"
  },
  {
    "bookId": 20,
    "chapterId": 20,
    "verseId": 5,
    "text": "人の心にある謀計は深き井の水のごとし 然れど哲人はこれを汲出す"
  },
  {
    "bookId": 20,
    "chapterId": 20,
    "verseId": 6,
    "text": "凡そ人は各自おのれの善を誇る されど誰か忠信なる者に遇しぞ"
  },
  {
    "bookId": 20,
    "chapterId": 20,
    "verseId": 7,
    "text": "身を正しくして歩履む義人はその後の子孫に福祉あるべし"
  },
  {
    "bookId": 20,
    "chapterId": 20,
    "verseId": 8,
    "text": "審判の位に坐する王はその目をもてすべての惡を散す"
  },
  {
    "bookId": 20,
    "chapterId": 20,
    "verseId": 9,
    "text": "たれか我わが心をきよめ わが罪を潔められたりといひ得るや"
  },
  {
    "bookId": 20,
    "chapterId": 20,
    "verseId": 10,
    "text": "二種の權衡二種の斗量は等しくヱホバに憎まる"
  },
  {
    "bookId": 20,
    "chapterId": 20,
    "verseId": 11,
    "text": "幼子といへどもその動作によりておのれの根性の清きか或は正しきかをあらはす"
  },
  {
    "bookId": 20,
    "chapterId": 20,
    "verseId": 12,
    "text": "聽くところの耳と視るところの眼とはともにヱホバの造り給へるものなり"
  },
  {
    "bookId": 20,
    "chapterId": 20,
    "verseId": 13,
    "text": "なんぢ睡眠を愛すること勿れ 恐くは貧窮にいたらん 汝の眼をひらけ 然らば糧に飽べし"
  },
  {
    "bookId": 20,
    "chapterId": 20,
    "verseId": 14,
    "text": "買者はいふ惡し惡しと 然れど去りて後はみづから誇る"
  },
  {
    "bookId": 20,
    "chapterId": 20,
    "verseId": 15,
    "text": "金もあり眞珠も多くあれど貴き器は知識のくちびるなり"
  },
  {
    "bookId": 20,
    "chapterId": 20,
    "verseId": 16,
    "text": "人の保證をなす者よりは先その衣をとれ 他人の保證をなす者をばかたくとらへよ"
  },
  {
    "bookId": 20,
    "chapterId": 20,
    "verseId": 17,
    "text": "欺きとりし糧は人に甜し されど後にはその口に沙を充されん"
  },
  {
    "bookId": 20,
    "chapterId": 20,
    "verseId": 18,
    "text": "謀計は相議るによりて成る 戰はんとせば先よく議るべし"
  },
  {
    "bookId": 20,
    "chapterId": 20,
    "verseId": 19,
    "text": "あるきめぐりて人の是非をいふ者は密事をもらす 口唇をひらきてあるくものと交ること勿れ"
  },
  {
    "bookId": 20,
    "chapterId": 20,
    "verseId": 20,
    "text": "おのれの父母を罵るものはその燈火くらやみの中に消ゆべし"
  },
  {
    "bookId": 20,
    "chapterId": 20,
    "verseId": 21,
    "text": "初に俄に得たる產業はその終さいはひならず"
  },
  {
    "bookId": 20,
    "chapterId": 20,
    "verseId": 22,
    "text": "われ惡に報いんと言ふこと勿れ ヱホバを待て 彼なんぢを救はん"
  },
  {
    "bookId": 20,
    "chapterId": 20,
    "verseId": 23,
    "text": "二種の法馬はヱホバに憎まる 虚偽の權衡は善らず"
  },
  {
    "bookId": 20,
    "chapterId": 20,
    "verseId": 24,
    "text": "人の歩履はヱホバによる 人いかで自らその道を明かにせんや"
  },
  {
    "bookId": 20,
    "chapterId": 20,
    "verseId": 25,
    "text": "漫に誓願をたつることは其人の罟となる誓願をたててのちに考ふることも亦然り"
  },
  {
    "bookId": 20,
    "chapterId": 20,
    "verseId": 26,
    "text": "賢き王は箕をもて簸るごとく惡人を散し 車輪をもて碾すごとく之を罰す"
  },
  {
    "bookId": 20,
    "chapterId": 20,
    "verseId": 27,
    "text": "人の霊魂はヱホバの燈火にして人の心の奧を窺ふ"
  },
  {
    "bookId": 20,
    "chapterId": 20,
    "verseId": 28,
    "text": "王は仁慈と眞實をもて自らたもつ その位もまた恩惠のおこなひによりて堅くなる"
  },
  {
    "bookId": 20,
    "chapterId": 20,
    "verseId": 29,
    "text": "少者の榮はその力 おいたる者の美しきは白髮なり"
  },
  {
    "bookId": 20,
    "chapterId": 20,
    "verseId": 30,
    "text": "傷つくまでに打たば惡きところきよまり 打てる鞭は腹の底までもとほる"
  }
]
