[
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 1,
    "text": "王の心はヱホバの手の中にありて恰かも水の流れのごとし 彼その聖旨のままに之を導きたまふ"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 2,
    "text": "人の道はおのれの目に正しとみゆ されどヱホバは人の心をはかりたまふ"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 3,
    "text": "正義と公平を行ふは犠牲よりも愈りてヱホバに悦ばる"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 4,
    "text": "高ぶる目と驕る心とは惡人の光にしてただ罪のみ"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 5,
    "text": "勤めはたらく者の圖るところは遂にその身を豊裕ならしめ 凡てさわがしく急ぐ者は貧乏をいたす"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 6,
    "text": "虚偽の舌をもて財を得るは吹はらはるる雲烟のごとし 之を求むる者は死を求むるなり"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 7,
    "text": "惡者の殘虐は自己を亡す これ義しきを行ふことを好まざればなり"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 8,
    "text": "罪人の道は曲り 潔者の行爲は直し"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 9,
    "text": "相爭ふ婦と偕に室に居らんよりは屋蓋の隅にをるはよし"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 10,
    "text": "惡者の霊魂は惡をねがふ その鄰も彼にあはれみ見られず"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 11,
    "text": "あざけるもの罰をうくれば拙者は智慧を得 ちゑあるもの敎をうくれば知識を得"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 12,
    "text": "義しき神は惡者の家をみとめて惡者を滅亡に投いれたまふ"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 13,
    "text": "耳を掩ひて貧者の呼ぶ聲をきかざる者は おのれ自ら呼ぶときもまた聽れざるべし"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 14,
    "text": "潜なる饋物は忿恨をなだめ 懐中の賄賂は烈しき瞋恚をやはらぐ"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 15,
    "text": "公義を行ふことは義者の喜樂にして 惡を行ふものの敗壞なり"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 16,
    "text": "さとりの道を離るる人は死し者の集會の中にをらん"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 17,
    "text": "宴樂を好むものは貧人となり 酒と膏とを好むものは富をいたさじ"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 18,
    "text": "惡者は義者のあがなひとなり 悖れる者は直き者に代る"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 19,
    "text": "爭ひ怒る婦と偕にをらんよりは荒野に居るはよし"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 20,
    "text": "智慧ある者の家には貴き寳と膏とあり 愚なる人は之を呑つくす"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 21,
    "text": "正義と憐憫と追求むる者は生命と正義と尊貴とを得べし"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 22,
    "text": "智慧ある者は強者の城にのぼりて その堅く賴むところを倒す"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 23,
    "text": "口と舌とを守る者はその霊魂を守りて患難に遇せじ"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 24,
    "text": "高ぶり驕る者を嘲笑者となづく これ驕奢を逞しくして行ふものなり"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 25,
    "text": "惰者の情慾はおのれの身を殺す 是はその手を肯て働かせざればなり"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 26,
    "text": "人は終日しきりに慾を圖る されど義者は與へて吝まず"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 27,
    "text": "惡者の献物は憎まる 况て惡き事のために献ぐる者をや"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 28,
    "text": "虚偽の證人は滅さる 然れど聽く人は恒にいふべし"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 29,
    "text": "惡人はその面を厚くし 義者はその道を謹む"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 30,
    "text": "ヱホバにむかひては智慧も明哲も謀略もなすところなし"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 31,
    "text": "戰闘の日のために馬を備ふ されど勝利はヱホバによる"
  }
]
