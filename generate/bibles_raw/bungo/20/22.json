[
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 1,
    "text": "嘉名は大なる富にまさり恩寵は銀また金よりも佳し"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 2,
    "text": "富者と貧者と偕に世にをる 凡て之を造りし者はヱホバなり"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 3,
    "text": "賢者は災禍を見てみづから避け 拙者はすすみて罰をうく"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 4,
    "text": "謙遜とヱホバを畏るる事との報は富と尊貴と生命となり"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 5,
    "text": "悖れる者の途には荊棘と罟とあり 霊魂を守る者は遠くこれを離れん"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 6,
    "text": "子をその道に從ひて敎へよ 然ばその老たる時も之を離れじ"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 7,
    "text": "富者は貧者を治め借者は貸人の僕となる"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 8,
    "text": "惡を播くものは禍害を穡り その怒の杖は廢るべし"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 9,
    "text": "人を見て惠む者はまた惠まる 此はその糧を貧者に與ふればなり"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 10,
    "text": "嘲笑者を逐へば爭論も亦さり 且闘諍も恥辱もやむ"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 11,
    "text": "心の潔きを愛する者はその口唇に憐憫をもてり 王その友とならん"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 12,
    "text": "ヱホバの目は知識ある者を守る 彼は悖れる者の言を敗りたまふ"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 13,
    "text": "惰者はいふ獅そとにあり われ衢にて殺されんと"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 14,
    "text": "妓婦の口は深き坑なり ヱホバに憎まるる者これに陷らん"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 15,
    "text": "痴なること子の心の中に繋がる 懲治の鞭これを逐いだす"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 16,
    "text": "貧者を虐げて自らを富さんとする者と富者に與ふる者とは遂にかならず貧しくなる"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 17,
    "text": "汝の耳を傾ぶけて智慧ある者の言をきき且なんぢの心をわが知識に用ゐよ"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 18,
    "text": "之を汝の腹にたもちて 盡くなんぢの口唇にそなはらしめば樂しかるべし"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 19,
    "text": "汝をしてヱホバに倚賴ましめんが爲にわれ今日これを汝に敎ふ"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 20,
    "text": "われ勸言と知識とをふくみたる勝れし言を汝の爲に録ししにあらずや"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 21,
    "text": "これ汝をして眞の言の確實なることを暁らしめ 且なんぢを遣しし者に眞の言を持歸らしめん爲なり"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 22,
    "text": "弱き者を弱きがために掠むることなかれ 艱難者を門にて壓つくること勿れ"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 23,
    "text": "そはヱホバその訴を糺し且かれらを害ふものの生命をそこなはん"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 24,
    "text": "怒る者と交ること勿れ 憤ほる人とともに往ことなかれ"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 25,
    "text": "恐くは汝その道に效ひてみづから罟に陷らん"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 26,
    "text": "なんぢ人と手をうつ者となることなかれ 人の負債の保證をなすこと勿れ"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 27,
    "text": "汝もし償ふべきものあらずば人なんぢの下なる臥牀までも奪ひ取ん 是豈よからんや"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 28,
    "text": "なんぢの先祖がたてし古き地界を移すこと勿れ"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 29,
    "text": "汝その業に巧なる人を見るか 斯る人は王の前に立ん かならず賤者の前にたたじ"
  }
]
