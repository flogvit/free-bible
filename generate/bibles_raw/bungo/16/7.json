  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 42,
    "text": "ハリムの子孫一千十七人"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 43,
    "text": "レビ人はホデワの子等ヱシユアとカデミエルの子孫七十四人"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 44,
    "text": "謳歌者はアサフの子孫百四十八人"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 45,
    "text": "門を守る者はシヤルムの子孫アテルの子孫タルモンの子孫アツクブの子孫ハテタの子孫シヨバイの子孫百三十八人"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 46,
    "text": "ネテニ人はジハの子孫ハスパの子孫タバオテの子孫"
  },
  {
    "bookId": 16,
