[
  {
    "bookId": 16,
    "chapterId": 10,
    "verseId": 1,
    "text": "印を捺る者はハカリヤの子テルシヤタ、ネヘミヤおよびゼデキヤ"
  },
  {
    "bookId": 16,
    "chapterId": 10,
    "verseId": 2,
    "text": "セラヤ、アザリヤ、ヱレミヤ"
  },
  {
    "bookId": 16,
    "chapterId": 10,
    "verseId": 3,
    "text": "パシユル、アマリヤ、マルキヤ、"
  },
  {
    "bookId": 16,
    "chapterId": 10,
    "verseId": 4,
    "text": "ハツトシ、シバニヤ、マルク"
  },
  {
    "bookId": 16,
    "chapterId": 10,
    "verseId": 5,
    "text": "ハリム、メレモテ、オバデヤ"
  },
  {
    "bookId": 16,
    "chapterId": 10,
    "verseId": 6,
    "text": "ダニエル、ギンネトン、バルク"
  },
  {
    "bookId": 16,
    "chapterId": 10,
    "verseId": 7,
    "text": "メシユラム、アビヤ、ミヤミン"
  },
  {
    "bookId": 16,
    "chapterId": 10,
    "verseId": 8,
    "text": "マアジア、ビルガ、シマヤ是等は祭司なり"
  },
  {
    "bookId": 16,
    "chapterId": 10,
    "verseId": 9,
    "text": "レビ人は即ちアザニヤの子ヱシユア 、ヘナダデの子ビンヌイ、カデミエル"
  },
  {
    "bookId": 16,
    "chapterId": 10,
    "verseId": 10,
    "text": "ならびに其兄弟シバ二ヤ、ホデヤ、ケリタ、ペラヤ、ハナン"
  },
  {
    "bookId": 16,
    "chapterId": 10,
    "verseId": 11,
    "text": "ミカ、レホブ、ハシヤビヤ"
  },
  {
    "bookId": 16,
    "chapterId": 10,
    "verseId": 12,
    "text": "ザツクル、セレビヤ、シバ二ヤ"
  },
  {
    "bookId": 16,
    "chapterId": 10,
    "verseId": 13,
    "text": "ホデヤ、バニ、ベニヌ"
  },
  {
    "bookId": 16,
    "chapterId": 10,
    "verseId": 14,
    "text": "民の長たる者はパロシ、パハテモアブ、エラム、ザツト、バニ"
  },
  {
    "bookId": 16,
    "chapterId": 10,
    "verseId": 15,
    "text": "ブンニ、アズカデ、ベバイ"
  },
  {
    "bookId": 16,
    "chapterId": 10,
    "verseId": 16,
    "text": "アドニヤ、ビグワイ、アデン"
  },
  {
    "bookId": 16,
    "chapterId": 10,
    "verseId": 17,
    "text": "アテル、ヒゼキヤ、アズル"
  },
  {
    "bookId": 16,
    "chapterId": 10,
    "verseId": 18,
    "text": "ホデヤ、ハシユム、ベザイ"
  },
  {
    "bookId": 16,
    "chapterId": 10,
    "verseId": 19,
    "text": "ハリフ、アナトテ、ノバイ"
  },
  {
    "bookId": 16,
    "chapterId": 10,
    "verseId": 20,
    "text": "マグピアシ、メシユラム、ヘジル"
  },
  {
    "bookId": 16,
    "chapterId": 10,
    "verseId": 21,
    "text": "メシザベル、ザドク、ヤドア"
  },
  {
    "bookId": 16,
    "chapterId": 10,
    "verseId": 22,
    "text": "ペラテヤ、ハナン、アナニヤ"
  },
  {
    "bookId": 16,
    "chapterId": 10,
    "verseId": 23,
    "text": "ホセア、ハナニヤ、ハシユブ"
  },
  {
    "bookId": 16,
    "chapterId": 10,
    "verseId": 24,
    "text": "ハロヘシ、ピルハ、シヨベク"
  },
  {
    "bookId": 16,
    "chapterId": 10,
    "verseId": 25,
    "text": "レホム、ハシヤブナ、マアセヤ"
  },
  {
    "bookId": 16,
    "chapterId": 10,
    "verseId": 26,
    "text": "アヒヤ、ハナン、アナン"
  },
  {
    "bookId": 16,
    "chapterId": 10,
    "verseId": 27,
    "text": "マルク、ハリム、バアナ"
  },
  {
    "bookId": 16,
    "chapterId": 10,
    "verseId": 28,
    "text": "その餘の民祭司レビ人門をまもる者謳歌者ネテニ人ならびに都て國々の民等と離れて神の律法に附る者およびその妻その男子女子など凡そ事を知り辨まふる者は"
  },
  {
    "bookId": 16,
    "chapterId": 10,
    "verseId": 29,
    "text": "皆その兄弟たる貴き人々に附したがひ呪詛に加はり誓を立て云く我ら神の僕モーセによりて傳はりし神の律法に歩み我らの主ヱホバの一切の誡命およびその例規と法度を守り行はん"
  },
  {
    "bookId": 16,
    "chapterId": 10,
    "verseId": 30,
    "text": "我らは此地の民等に我らの女子を與へじ亦われらの男子のために彼らの女子を娶らじ"
  },
  {
    "bookId": 16,
    "chapterId": 10,
    "verseId": 31,
    "text": "比地の民等たとひ貨物あるひは食物を安息日に携へ來りて賣んとするとも安息日または聖日には我儕これを取じ又七年ごとに耕作を廢め一切の負債を免さんと"
  },
  {
    "bookId": 16,
    "chapterId": 10,
    "verseId": 32,
    "text": "我らまた自ら例を設けて年々にシケルの三分の一を出して我らの神の室の用となし"
  },
  {
    "bookId": 16,
    "chapterId": 10,
    "verseId": 33,
    "text": "供物のパン常素祭常燔祭のため安息日月朔および節會の祭物のため聖物のためイスラエルの贖をなす罪祭および我らの神の家の諸の工のために之を用ゐることを定む"
  },
  {
    "bookId": 16,
    "chapterId": 10,
    "verseId": 34,
    "text": "また我ら祭司レビ人および民籤を掣き律法に記されたるごとく我らの神ヱホバの壇の上に焚べき薪木の禮物を年々定まれる時にわれらの宗家にしたがひて我らの神の室に納むる者を定め"
  },
  {
    "bookId": 16,
    "chapterId": 10,
    "verseId": 35,
    "text": "かつ誓ひて云ふ我らの產物の初および各種の樹の果の初を年々ヱホバの室に携へきたらん"
  },
  {
    "bookId": 16,
    "chapterId": 10,
    "verseId": 36,
    "text": "また我らの子等および我らの獣畜の首出および我らの牛羊の首出を律法に記されたるごとく我らの神の室に携へ來りて我らの神の室に事ふる祭司に交し"
  },
  {
    "bookId": 16,
    "chapterId": 10,
    "verseId": 37,
    "text": "我らの麥粉の初われらの擧祭の物各種の樹の果および洒油を祭司の許に携へ到りて我らの神の家の室に納め我らの產物の什一をレビ人に與へんレビ人は我らの一切の農作の邑においてその什一を受べき者なればなり"
  },
  {
    "bookId": 16,
    "chapterId": 10,
    "verseId": 38,
    "text": "レビ人什一を受る時にはアロンの子孫たる祭司一人そのレビ人と偕にあるべし而してまたレビ人はその什一の十分の一を我らの神の家に携へ上りて府庫の諸室に納むべし"
  },
  {
    "bookId": 16,
    "chapterId": 10,
    "verseId": 39,
    "text": "即ちイスラエルの子孫およびレビの子孫は穀物および酒油の擧祭を携さへいたり聖所の器皿および奉事をする祭司門を守る者謳歌者などが在るところの室に之を納むべし我らは我らの神の家を棄じ"
  }
]
