[
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 1,
    "text": "ベニヤミンの生る者は長子はベラ その次はアシベル その三はアハラ"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 2,
    "text": "その四はアハ その五はラパ"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 3,
    "text": "ベラの子等はアダル、ゲラ、アビウデ"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 4,
    "text": "アビシユア、ナアマン、アホア"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 5,
    "text": "ゲラ、シフパム、ヒラム"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 6,
    "text": "エホデの子等は左のごとし是等はゲバの民の宗家の長なり是はマナハテに移されたり"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 7,
    "text": "すなはちナアマンおよびアヒヤとともにゲラこれを移せるなりエホデの子等はすなはちウザとアヒウデ是なり"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 8,
    "text": "シヤハライムはその妻ホシムとバアラを去し後モアブの國においてまた子等を擧けたり"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 9,
    "text": "彼がその妻ホデシによりて擧けたる子等はヨバブ、ヂビア、メシヤ、マルカム"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 10,
    "text": "ヱウツ、シヤキヤおよびミルマ是その子等にして宗家の長なり"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 11,
    "text": "彼またホシムによりてアビトブとエルパアルを擧けたり"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 12,
    "text": "エルパアルの子等はエベル、ミシヤムおよびシヤメル彼はオノとロドとその郷里を建たる者なり"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 13,
    "text": "またベリア、シマあり是等はアヤロンの民の宗家の長たる者にしてガテの民を逐はらへり"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 14,
    "text": "またアヒオ、シヤシヤク、エレモテ"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 15,
    "text": "ゼバデヤ、アラデ、アデル"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 16,
    "text": "ミカエル、イシパ、ヨハ是等はベリアの子等なり"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 17,
    "text": "ゼバデヤ、メシユラム、ヘゼキ、ヘベル"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 18,
    "text": "イシメライ、ヱズリア、ヨバブ是等はエルパアルの子等なり"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 19,
    "text": "ヤキン、ジクリ、ザベデ"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 20,
    "text": "エリエナイ、チルタイ、エリエル"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 21,
    "text": "アダヤ、ベラヤ、シムラテ是等はシマの子等なり"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 22,
    "text": "イシパン、へベル、エリエル"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 23,
    "text": "アブドン、ジクリ、ハナン"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 24,
    "text": "ハナニヤ、エラム、アントテヤ"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 25,
    "text": "イペデヤ、ペヌエル是等はシヤシヤタの子等なり"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 26,
    "text": "シヤムセライ、シハリア、アタリヤ"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 27,
    "text": "ヤレシヤ、エリヤ、ジクリ是等はヱロハムの子等なり"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 28,
    "text": "是等は歴代の宗家の長にして首たるものなり是らはエルサレムに住たり"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 29,
    "text": "ギベオンの祖はギベオンに住りその妻の名はマアカといふ"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 30,
    "text": "その長子はアブドン、次はツル、キシ、バアル、ナダブ"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 31,
    "text": "ゲドル、アヒオ、ザケル"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 32,
    "text": "ミクロテはシメアを生り是等も又その兄弟等とともにヱルサレムに住てこれに對ひ居り"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 33,
    "text": "ネル、キシを生み キシ、サウルを生みサウルはヨナタン、マルキシユア、アビナダプ、エシバアルを生り"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 34,
    "text": "ヨナタンの子はメリバアル、メリバアル、ミカを生り"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 35,
    "text": "ミカの子等はピトン、メレク、ダレア、アハズ"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 36,
    "text": "アハズはヱホアダを生み ヱホアダはアレメテ、アズマウテおよびジムリを生み ジムリはモザを生み"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 37,
    "text": "モザはビネアを生り その子はラパ その子はニレアサ その子はアゼル"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 38,
    "text": "アゼルには六人の子あり其名は左のごとしアズリカム、ボケル、イシマエル、シヤリヤ、オバデヤ、ハナン是みなアゼルの子なり"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 39,
    "text": "その兄弟エセクの子等の長子はウラムその次はヱウンその三はエリペレテ"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 40,
    "text": "ウラムの子等は大勇士にして善く弓を射る者なりき彼は孫子多くして百五十人もありき是みなベニヤミンの子孫なり"
  }
]
