[
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 1,
    "text": "¶ アダム、セツ、エノス"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 2,
    "text": "ケナン、マハラレル、ヤレド"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 3,
    "text": "エノク、メトセラ、ラメク"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 4,
    "text": "ノア、セム、ハム、ヤペテ"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 5,
    "text": "ヤベテの子等はゴメル、マゴグ、マデア、ヤワン、トバル、メセク、テラス"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 6,
    "text": "ゴメルの子等はアシケナズ、リパテ、トガルマ"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 7,
    "text": "ヤワンの子等はエリシヤ、タルシシ、キツテム、ドダニム"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 8,
    "text": "ハムの子等はクシ、ミツライム、プテ、カナン"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 9,
    "text": "クシの子等はセバ、ハビラ、サブタ、ラアマ、サブテカ、ラアマの子等はセバとデダン"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 10,
    "text": "クシ、ニムロデを生り彼はじめて世の權力ある者となれり"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 11,
    "text": "ミツライムはルデ族アナミ族レハビ族ナフト族"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 12,
    "text": "パテロス族カスル族カフトリ族を生りカスル族よりペリシテ族出たり"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 13,
    "text": "カナンその冢子シドンおよびヘテを生み"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 14,
    "text": "またヱブス族アモリ族ギルガシ族"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 15,
    "text": "ヒビ族アルキ族セニ族"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 16,
    "text": "アルワデ族ゼマリ族ハマテ族を生り"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 17,
    "text": "セムの子等はエラム、アシユル、アルバクサデ、ルデ、アラム、ウズ、ホル、ゲテル、メセク"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 18,
    "text": "アルバクサデ、シラを生みシラ、エベルを生り"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 19,
    "text": "エベルに二人の子生れたりその一人の名をベレグ(分)と曰ふ其は彼の代に地の人散り分れたればなりその弟の名をヨクタンと曰ふ"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 20,
    "text": "ヨクタンはアルモダデ、シヤレフ、ハザルマウテ、ヱラ"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 21,
    "text": "ハドラム、ウザル、デクラ"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 22,
    "text": "エバル、アビマエル、シバ"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 23,
    "text": "オフル、ハビラおよびヨハブを生り是等はみなヨクタンの子なり"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 24,
    "text": "セム、アルバクサデ、シラ"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 25,
    "text": "エベル、ベレグ、リウ"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 26,
    "text": "セルグ、ナホル、テラ"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 27,
    "text": "アブラム是すなはちアブラハムなり"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 28,
    "text": "アブラハムの子等はイサクおよびイシマエル"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 29,
    "text": "彼らの子孫は左のごとしイシマエルの冢子はネバヨテ次はケダル、アデビエル、ミブサム"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 30,
    "text": "ミシマ、ドマ、マツサ、ハダデ、テマ"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 31,
    "text": "ヱトル、ネフシ、ケデマ、イシマエルの子孫は是の如し"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 32,
    "text": "アブラハムの妾ケトラの生る子は左のごとし彼ジムラン、ヨクシヤン、メダン、ミデアン、イシバク、シユワを生りヨクシヤンの子等はシバおよびデダン"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 33,
    "text": "ミデアンの子等はエバ、エペル、ヘノク、アビダ、エルダア是等はみなケトラの生る子なり"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 34,
    "text": "アブラハム、イサクを生りイザクの子等はヱサウとイスラエル"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 35,
    "text": "エサウの子等はエリバズ、リウエル、ヱウシ、ヤラム、コラ"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 36,
    "text": "エリバズの子等はテマン、オマル、ゼビ、ガタム、ケナズ、テムナ、アマレク"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 37,
    "text": "リウエルの子等はナハテ、ゼラ、シヤンマ、ミツザ"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 38,
    "text": "セイの子等はロタン、シヨバル、ヂベオン、アナ、デシヨン、エゼル、デシヤン"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 39,
    "text": "ロタンの子等はホリとホマム、ロタンの妹はテムナ"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 40,
    "text": "シヨバルの子等はアルヤン、マナハテ、エバル、シピ、オナム、ヂベオンの子等はアヤとアナ"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 41,
    "text": "アナの子等はデシヨン、デシヨンの子等はハムラム、エシバン、イテラン、ケラン、"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 42,
    "text": "エゼルの子等はビルハン、ザワン、ヤカン、デシヤンの子等はウズおよびアラン"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 43,
    "text": "イスラエルの子孫を治むる王いまだ有ざる前にエドムの地を治めたる王等は左のごとしベオルの子ベラその都城の名はデナバといふ"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 44,
    "text": "ベラ薨てボズラのゼラの子ヨバブこれに代りて王となり"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 45,
    "text": "ヨバブ薨てテマン人の地のホシヤムこれにかはりて王となり"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 46,
    "text": "ホシヤム薨てベダデの子ハダデこれにかはりて王となれり彼モアブの野にてミデアン人を撃りその都城の名はアビテといふ"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 47,
    "text": "ハダデ薨てマスレカのサムラこれに代りて王となり"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 48,
    "text": "サムラ薨て河の旁なるレホボテのサウルこれに代りて王となり"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 49,
    "text": "サウル薨てアクボルの子バアルハナンこれに代りて王となり"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 50,
    "text": "バアルハナン薨てハダデこれにかはりて王となれりその都城の名はパイといふその妻はマテレデの女子にして名をメヘタベルといへりマテレデはメザハブの女なり"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 51,
    "text": "ハダデも薨たり／エドムの諸侯は左のごとし、テムナ侯アルヤ侯ヱテテ侯"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 52,
    "text": "アホリバマ侯エラ侯ピノン侯"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 53,
    "text": "ケナズ侯テマン侯ミブザル侯"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 54,
    "text": "マグデエル侯イラム侯エドムの諸侯は是のごとし"
  }
]
