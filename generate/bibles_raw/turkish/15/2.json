  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 57,
    "text": "Şefatyaoğulları, Hattiloğulları, Pokeret-Hassevayimoğulları, Amioğulları."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 58,
    "text": "Tapınak görevlileriyle Süleymanın kullarının soyundan olanlar: 392."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 59,
    "text": "Tel-Melah, Tel-Harşa, Keruv, Addan ve İmmerden dönen, ancak hangi aileden olduklarını ve soylarının İsrailden geldiğini kanıtlayamayanlar şunlardır:"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 60,
    "text": "Delayaoğulları, Toviyaoğulları, Nekodaoğulları: 652."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 61,
    "text": "Kâhinlerin soyundan: Hovayaoğulları, Hakkosoğulları ve Gilatlı Barzillayın kızlarından biriyle evlenip kayınbabasının adını alan Barzillayın oğulları."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 62,
    "text": "Bunlar soy kütüklerini aradılar. Ama yazılı bir kayıt bulamayınca, kâhinlik görevi ellerinden alındı."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 63,
    "text": "Vali, Urim ile Tummimi kullanan bir kâhin çıkıncaya dek en kutsal yiyeceklerden yememelerini buyurdu."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 64,
    "text": "Bütün halk toplam 42 360 kişiydi."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 65,
    "text": "Ayrıca 7 337 erkek ve kadın köle, kadınlı erkekli 200 ezgici, 736 at, 245 katır, 435 deve, 6 720 eşek vardı."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 68,
    "text": "Bazı aile başları Yeruşalimdeki RAB Tanrının Tapınağına varınca, tapınağın bulunduğu yerde yeniden kurulması için gönülden armağanlar verdiler."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 69,
    "text": "Her biri gücü oranında hazineye bu iş için toplam 61 000 darik altın, 5 000 mina gümüş, 100 kâhin mintanı bağışladı."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 70,
    "text": "Kâhinler, Levililer, halktan bazı kişiler -ezgiciler, tapınak görevlileri ve kapı nöbetçileri- kendi kentlerine yerleştiler. Böylece bütün İsrailliler kentlerinde yaşamaya başladılar."
  }
]
