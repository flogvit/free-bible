[
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 1,
    "text": "Musayla Harun önderliğinde birlikler halinde Mısırdan çıkan İsrailliler sırasıyla aşağıdaki yolculukları yaptılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 2,
    "text": "Musa RABbin buyruğu uyarınca sırasıyla yapılan yolculukları kayda geçirdi. Yapılan yolculuklar şunlardır:"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 3,
    "text": "İsrailliler Fısıh kurbanının ertesi günü -birinci ayın on beşinci günü- Mısırlıların gözü önünde zafer havası içinde Ramsesten yola çıktılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 4,
    "text": "O sırada Mısırlılar RABbin yok ettiği ilk doğan çocuklarını gömüyorlardı; RAB onların ilahlarını yargılamıştı."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 5,
    "text": "İsrailliler Ramsesten yola çıkıp Sukkotta konakladılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 6,
    "text": "Sukkottan ayrılıp çöl kenarındaki Etamda konakladılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 7,
    "text": "Etamdan ayrılıp Baal-Sefonun doğusundaki Pi-Hahirota döndüler, Migdol yakınlarında konakladılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 8,
    "text": "Pi-Hahirottan ayrılıp denizden çöle geçtiler. Etam Çölünde üç gün yürüdükten sonra Marada konakladılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 9,
    "text": "Maradan ayrılıp on iki su kaynağı ve yetmiş hurma ağacı olan Elime giderek orada konakladılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 10,
    "text": "Elimden ayrılıp Kızıldeniz kıyısında konakladılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 11,
    "text": "Kızıldenizden ayrılıp Sin Çölünde konakladılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 12,
    "text": "Sin Çölünden ayrılıp Dofkada konakladılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 13,
    "text": "Dofkadan ayrılıp Aluşta konakladılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 14,
    "text": "Aluştan ayrılıp Refidimde konakladılar. Orada halk için içecek su yoktu."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 15,
    "text": "Refidimden ayrılıp Sina Çölünde konakladılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 16,
    "text": "Sina Çölünden ayrılıp Kivrot-Hattaavada konakladılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 17,
    "text": "Kivrot-Hattaavadan ayrılıp Haserotta konakladılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 18,
    "text": "Haserottan ayrılıp Ritmada konakladılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 19,
    "text": "Ritmadan ayrılıp Rimmon-Pereste konakladılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 20,
    "text": "Rimmon-Peresten ayrılıp Livnada konakladılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 21,
    "text": "Livnadan ayrılıp Rissada konakladılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 22,
    "text": "Rissadan ayrılıp Kehelatada konakladılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 23,
    "text": "Kehelatadan ayrılıp Şefer Dağında konakladılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 24,
    "text": "Şefer Dağından ayrılıp Haradada konakladılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 25,
    "text": "Haradadan ayrılıp Makhelotta konakladılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 26,
    "text": "Makhelottan ayrılıp Tahatta konakladılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 27,
    "text": "Tahattan ayrılıp Terahta konakladılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 28,
    "text": "Terahtan ayrılıp Mitkada konakladılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 29,
    "text": "Mitkadan ayrılıp Haşmonada konakladılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 30,
    "text": "Haşmonadan ayrılıp Moserotta konakladılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 31,
    "text": "Moserottan ayrılıp Bene-Yaakanda konakladılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 32,
    "text": "Bene-Yaakandan ayrılıp Hor-Hagidgatta konakladılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 33,
    "text": "Hor-Hagidgattan ayrılıp Yotvatada konakladılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 34,
    "text": "Yotvatadan ayrılıp Avronada konakladılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 35,
    "text": "Avronadan ayrılıp Esyon-Geverde konakladılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 36,
    "text": "Esyon-Geverden ayrılıp Zin Çölünde -Kadeşte- konakladılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 37,
    "text": "Kadeşten ayrılıp Edom sınırındaki Hor Dağında konakladılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 38,
    "text": "Kâhin Harun RABbin buyruğu uyarınca Hor Dağına çıktı. İsraillilerin Mısırdan çıkışlarının kırkıncı yılı, beşinci ayın birinci günü orada öldü."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 39,
    "text": "Hor Dağında öldüğünde Harun 123 yaşındaydı."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 40,
    "text": "Kenan ülkesinin Negev bölgesinde yaşayan Kenanlı Arat Kralı İsraillilerin geldiğini duydu."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 41,
    "text": "İsrailliler Hor Dağından ayrılıp Salmonada konakladılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 42,
    "text": "Salmonadan ayrılıp Punonda konakladılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 43,
    "text": "Punondan ayrılıp Ovotta konakladılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 44,
    "text": "Ovottan ayrılıp Moav sınırındaki İye-Haavarimde konakladılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 45,
    "text": "İyimden ayrılıp Divon-Gadda konakladılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 46,
    "text": "Divon-Gaddan ayrılıp Almon-Divlataymada konakladılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 47,
    "text": "Almon-Divlataymadan ayrılıp Nevo yakınlarındaki Haavarim dağlık bölgesinde konakladılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 48,
    "text": "Haavarim dağlık bölgesinden ayrılıp Şeria Irmağı yanında, Eriha karşısındaki Moav ovalarında konakladılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 49,
    "text": "Şeria Irmağı boyunca Beythayeşimottan Avel-Haşşittime kadar Moav ovalarında konakladılar."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 50,
    "text": "Orada, Şeria Irmağı yanında Eriha karşısındaki Moav ovalarında RAB Musaya şöyle dedi:"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 51,
    "text": "\"İsraillilere de ki, 'Şeria Irmağından Kenan ülkesine geçince,"
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 52,
    "text": "ülkede yaşayan bütün halkı kovacaksınız. Oyma ve dökme putlarını yok edecek, tapınma yerlerini yıkacaksınız."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 53,
    "text": "Ülkeyi yurt edinecek, oraya yerleşeceksiniz; çünkü mülk edinesiniz diye orayı size verdim."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 54,
    "text": "Ülkeyi boylarınız arasında kurayla paylaşacaksınız. Büyük boya büyük pay, küçük boya küçük pay vereceksiniz. Kurada kime ne çıkarsa, orası onun olacak. Dağıtımı atalarınızın oymaklarına göre yapacaksınız."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 55,
    "text": "\" 'Ama ülkede yaşayanları kovmazsanız, orada bıraktığınız halk gözlerinizde kanca, böğürlerinizde diken olacak. Yaşayacağınız ülkede size sıkıntı verecekler."
  },
  {
    "bookId": 4,
    "chapterId": 33,
    "verseId": 56,
    "text": "Ben de onlara yapmayı tasarladığımı size yapacağım.' \""
  }
]
