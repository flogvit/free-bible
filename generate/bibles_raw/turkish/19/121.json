[
  {
    "bookId": 19,
    "chapterId": 121,
    "verseId": 1,
    "text": "Gözlerimi dağlara kaldırıyorum,Nereden yardım gelecek?"
  },
  {
    "bookId": 19,
    "chapterId": 121,
    "verseId": 2,
    "text": "Yeri göğü yaratanRABden gelecek yardım."
  },
  {
    "bookId": 19,
    "chapterId": 121,
    "verseId": 3,
    "text": "O ayaklarının kaymasına izin vermez,Seni koruyan uyuklamaz."
  },
  {
    "bookId": 19,
    "chapterId": 121,
    "verseId": 4,
    "text": "İsrailin koruyucusu ne uyur ne uyuklar."
  },
  {
    "bookId": 19,
    "chapterId": 121,
    "verseId": 5,
    "text": "Senin koruyucun RABdir,O sağ yanında sana gölgedir."
  },
  {
    "bookId": 19,
    "chapterId": 121,
    "verseId": 6,
    "text": "Gündüz güneş,Gece ay sana zarar vermez."
  },
  {
    "bookId": 19,
    "chapterId": 121,
    "verseId": 7,
    "text": "RAB her kötülükten seni korur,Esirger canını."
  },
  {
    "bookId": 19,
    "chapterId": 121,
    "verseId": 8,
    "text": "Şimdiden sonsuza dekRAB koruyacak gidişini, gelişini."
  }
]
