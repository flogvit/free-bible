[
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 1,
    "text": "Gençliğimden beri bana sık sık saldırdılar;Şimdi söylesin İsrail:"
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 2,
    "text": "\"Gençliğimden beri bana sık sık saldırdılar,Ama yenemediler beni."
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 3,
    "text": "Çiftçiler saban sürdüler sırtımda,Upuzun iz bıraktılar.\""
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 4,
    "text": "Ama RAB adildir,Kesti kötülerin bağlarını."
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 5,
    "text": "Siyondan nefret eden herkesUtanç içinde geri çekilsin."
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 6,
    "text": "Damlardaki ota,Büyümeden kuruyan ota dönsünler."
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 7,
    "text": "Orakçı avucunu,Demetçi kucağını dolduramaz onunla."
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 8,
    "text": "Yoldan geçenler de,\"RAB sizi kutsasın,RAB'bin adıyla sizi kutsarız\" demezler."
  }
]
