[
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 1,
    "text": "Şükredin RABbe, çünkü O iyidir,"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 2,
    "text": "Şükredin tanrılar Tanrısına,"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 3,
    "text": "Şükredin rabler Rabbine,"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 4,
    "text": "Büyük harikalar yapan tek varlığa,"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 5,
    "text": "Gökleri bilgece yaratana,"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 6,
    "text": "Yeri sular üzerine yayana,"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 7,
    "text": "Büyük ışıklar yaratana,"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 8,
    "text": "Gündüze egemen olsun diye güneşi,"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 9,
    "text": "Geceye egemen olsun diye ayı ve yıldızları yaratana,"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 10,
    "text": "Mısırda ilk doğanları öldürene,"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 11,
    "text": "Güçlü eli, kudretli koluyla"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 13,
    "text": "Kızıldenizi ikiye bölene,"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 14,
    "text": "İsraili ortasından geçirene,"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 15,
    "text": "Firavunla ordusunu Kızıldenize dökene,"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 16,
    "text": "Kendi halkını çölde yürütene,"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 17,
    "text": "Büyük kralları vurana,"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 18,
    "text": "Güçlü kralları öldürene,"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 19,
    "text": "Amorlu kral Sihonu,"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 20,
    "text": "Başan Kralı Ogu öldürene,"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 21,
    "text": "Topraklarını mülk olarak,"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 23,
    "text": "Düşkün günlerimizde bizi anımsayana,"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 24,
    "text": "Düşmanlarımızdan bizi kurtarana,"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 25,
    "text": "Bütün canlılara yiyecek verene,"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 26,
    "text": "Şükredin Göklerin Tanrısı'na,"
  }
]
