[
  {
    "bookId": 19,
    "chapterId": 122,
    "verseId": 1,
    "text": "Bana: \"RABbin evine gidelim\" dendikçeSevinirim."
  },
  {
    "bookId": 19,
    "chapterId": 122,
    "verseId": 2,
    "text": "Ayaklarımız senin kapılarında,Ey Yeruşalim!"
  },
  {
    "bookId": 19,
    "chapterId": 122,
    "verseId": 3,
    "text": "Bitişik nizamda kurulmuş bir kenttirYeruşalim!"
  },
  {
    "bookId": 19,
    "chapterId": 122,
    "verseId": 4,
    "text": "Oymaklar çıkar oraya, RABbin oymakları,İsraile verilen öğüt uyarınca,RABbin adına şükretmek için."
  },
  {
    "bookId": 19,
    "chapterId": 122,
    "verseId": 5,
    "text": "Çünkü orada yargı tahtları,Davut soyunun tahtları kurulmuştur."
  },
  {
    "bookId": 19,
    "chapterId": 122,
    "verseId": 6,
    "text": "Esenlik dileyin Yeruşalime:\"Huzur bulsun seni sevenler!"
  },
  {
    "bookId": 19,
    "chapterId": 122,
    "verseId": 7,
    "text": "Surlarına esenlik,Saraylarına huzur egemen olsun!\""
  },
  {
    "bookId": 19,
    "chapterId": 122,
    "verseId": 8,
    "text": "Kardeşlerim, dostlarım için,\"Esenlik olsun sana!\" derim."
  },
  {
    "bookId": 19,
    "chapterId": 122,
    "verseId": 9,
    "text": "Tanrımız RAB'bin evi içinİyilik dilerim sana."
  }
]
