    "text": "Ezgiciler: Asafoğulları: 148"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 45,
    "text": "Tapınak kapı nöbetçileri: Şallumoğulları, Ateroğulları, Talmonoğulları, Akkuvoğulları, Hatitaoğulları, Şovayoğulları: 138"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 46,
    "text": "Tapınak görevlileri: Sihaoğulları, Hasufaoğulları, Tabbaotoğulları,"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 47,
    "text": "Kerosoğulları, Siaoğulları, Padonoğulları,"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 48,
    "text": "Levanaoğulları, Hagavaoğulları, Şalmayoğulları,"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 49,
    "text": "Hananoğulları, Giddeloğulları, Gaharoğulları,"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 50,
    "text": "Reayaoğulları, Resinoğulları, Nekodaoğulları,"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 51,
    "text": "Gazzamoğulları, Uzzaoğulları, Paseahoğulları,"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 52,
    "text": "Besayoğulları, Meunimoğulları, Nefişesimoğulları,"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 53,
    "text": "Bakbukoğulları, Hakufaoğulları, Harhuroğulları,"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 54,
    "text": "Baslitoğulları, Mehidaoğulları, Harşaoğulları,"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 55,
    "text": "Barkosoğulları, Siseraoğulları, Temahoğulları,"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 56,
    "text": "Nesiahoğulları, Hatifaoğulları."
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 57,
    "text": "Süleymanın kullarının soyu: Sotayoğulları, Soferetoğulları, Peridaoğulları,"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 58,
    "text": "Yalaoğulları, Darkonoğulları, Giddeloğulları,"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 59,
    "text": "Şefatyaoğulları, Hattiloğulları, Pokeret-Hassevayimoğulları, Amonoğulları."
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 60,
    "text": "Tapınak görevlileriyle Süleymanın kullarının soyundan olanlar: 392"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 61,
    "text": "Tel-Melah, Tel-Harşa, Keruv, Addon ve İmmerden dönen, ancak hangi aileden olduklarını ve soylarının İsrailden geldiğini kanıtlayamayanlar şunlardır:"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 62,
    "text": "Delayaoğulları, Toviyaoğulları, Nekodaoğulları: 642"
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 63,
    "text": "Kâhinlerin soyundan: Hovayaoğulları, Hakkosoğulları ve Gilatlı Barzillayın kızlarından biriyle evlenip kayınbabasının adını alan Barzillayın oğulları."
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 64,
    "text": "Bunlar soy kütüklerini aradılar. Ama yazılı bir kayıt bulamayınca, kâhinlik görevi ellerinden alındı."
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 65,
    "text": "Vali, Urim ile Tummimi kullanan bir kâhin çıkıncaya dek en kutsal yiyeceklerden yememelerini buyurdu."
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 66,
    "text": "Bütün halk toplam 42 360 kişiydi."
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 67,
    "text": "Ayrıca 7 337 erkek ve kadın köle, kadınlı erkekli 245 ezgici, 736 at, 245 katır, 435 deve, 6 720 eşek vardı."
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 70,
    "text": "Bazı aile başları onarım işi için bağışta bulundu: Vali hazineye 1 000 darik altın, 50 çanak, 530 kâhin mintanı bağışladı."
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 71,
    "text": "Bazı aile başları da iş için hazineye 20 000 darikfı altın, 2 200 mina gümüş verdiler."
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 72,
    "text": "Halkın geri kalanı ise, toplam 20 000 darikfı altın, 2 000 mina gümüş ve 67 kâhin mintanı verdi."
  },
  {
    "bookId": 16,
    "chapterId": 7,
    "verseId": 73,
    "text": "Kâhinler, Levililer, tapınak görevlileri ve kapı nöbetçileri, ezgiciler, sıradan insanlar ve bütün İsrailliler kentlerine yerleştiler."
  }
]
