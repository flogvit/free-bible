[
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 1,
    "text": "וַיַּעַן אִיֹּוב וַיֹּאמַר׃"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 2,
    "text": "מֶה־עָזַרְתָּ לְלֹא־כֹחַ הֹושַׁעְתָּ זְרֹועַ לֹא־עֹז׃"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 3,
    "text": "מַה־יָּעַצְתָּ לְלֹא חָכְמָה וְתוּשִׁיָּה לָרֹב הֹודָעְתָּ׃"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 4,
    "text": "אֶת־מִי הִגַּדְתָּ מִלִּין וְנִשְׁמַת־מִי יָצְאָה מִמֶּךָּ׃"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 5,
    "text": "הָרְפָאִים יְחֹולָלוּ מִתַּחַת מַיִם וְשֹׁכְנֵיהֶם׃"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 6,
    "text": "עָרֹום שְׁאֹול נֶגְדֹּו וְאֵין כְּסוּת לָאֲבַדֹּון׃"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 7,
    "text": "נֹטֶה צָפֹון עַל־תֹּהוּ תֹּלֶה אֶרֶץ עַל־בְּלִי־מָה׃"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 8,
    "text": "צֹרֵר־מַיִם בְּעָבָיו וְלֹא־נִבְקַע עָנָן תַּחְתָּם׃"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 9,
    "text": "מְאַחֵז פְּנֵי־כִסֵּה פַּרְשֵׁז עָלָיו עֲנָנֹו׃"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 10,
    "text": "חֹק־חָג עַל־פְּנֵי־מָיִם עַד־תַּכְלִית אֹור עִם־חֹשֶׁךְ׃"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 11,
    "text": "עַמּוּדֵי שָׁמַיִם יְרֹופָפוּ וְיִתְמְהוּ מִגַּעֲרָתֹו׃"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 12,
    "text": "בְּכֹחֹו רָגַע הַיָּם [וּבִתוּבְנָתֹו כ] (וּבִתְבוּנָתֹו ק) מָחַץ רָהַב׃"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 13,
    "text": "בְּרוּחֹו שָׁמַיִם שִׁפְרָה חֹלֲלָה  יָדֹו נָחָשׁ בָּרִיחַ׃"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 14,
    "text": "הֶן־אֵלֶּה ׀ קְצֹות [דַּרְכֹּו כ] (דְּרָכָיו ק) וּמַה־שֵּׁמֶץ דָּבָר נִשְׁמַע־בֹּו וְרַעַם [גְּבוּרָתֹו כ] (גְּבוּרֹותָיו  ק) מִי יִתְבֹּונָן׃    ס"
  }
]
