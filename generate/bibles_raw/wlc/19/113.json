[
  {
    "bookId": 19,
    "chapterId": 113,
    "verseId": 1,
    "text": "הַלְלוּ יָהּ ׀ הַלְלוּ עַבְדֵי יְהוָה הַלְלוּ אֶת־שֵׁם יְהוָה׃"
  },
  {
    "bookId": 19,
    "chapterId": 113,
    "verseId": 2,
    "text": "יְהִי שֵׁם יְהוָה מְבֹרָךְ מֵעַתָּה וְעַד־עֹולָם׃"
  },
  {
    "bookId": 19,
    "chapterId": 113,
    "verseId": 3,
    "text": "מִמִּזְרַח־שֶׁמֶשׁ עַד־מְבֹואֹו מְהֻלָּל שֵׁם יְהוָה׃"
  },
  {
    "bookId": 19,
    "chapterId": 113,
    "verseId": 4,
    "text": "רָם עַל־כָּל־גֹּויִם ׀ יְהוָה עַל הַשָּׁמַיִם כְּבֹודֹו׃"
  },
  {
    "bookId": 19,
    "chapterId": 113,
    "verseId": 5,
    "text": "מִי כַּיהוָה אֱלֹהֵינוּ הַמַּגְבִּיהִי לָשָׁבֶת׃"
  },
  {
    "bookId": 19,
    "chapterId": 113,
    "verseId": 6,
    "text": "הַמַּשְׁפִּילִי לִרְאֹות בַּשָּׁמַיִם וּבָאָרֶץ׃"
  },
  {
    "bookId": 19,
    "chapterId": 113,
    "verseId": 7,
    "text": "מְקִימִי מֵעָפָר דָּל מֵאַשְׁפֹּת יָרִים אֶבְיֹון׃"
  },
  {
    "bookId": 19,
    "chapterId": 113,
    "verseId": 8,
    "text": "לְהֹושִׁיבִי עִם־נְדִיבִים עִם נְדִיבֵי עַמֹּו׃"
  },
  {
    "bookId": 19,
    "chapterId": 113,
    "verseId": 9,
    "text": "מֹושִׁיבִי ׀ עֲקֶרֶת הַבַּיִת אֵם־הַבָּנִים שְׂמֵחָה הַלְלוּ־יָהּ׃"
  }
]
