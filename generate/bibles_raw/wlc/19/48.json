[
  {
    "bookId": 19,
    "chapterId": 48,
    "verseId": 1,
    "text": "שִׁיר מִזְמֹור לִבְנֵי־קֹרַח׃"
  },
  {
    "bookId": 19,
    "chapterId": 48,
    "verseId": 2,
    "text": "גָּדֹול יְהוָה וּמְהֻלָּל מְאֹד בְּעִיר אֱלֹהֵינוּ הַר־קָדְשֹׁו׃"
  },
  {
    "bookId": 19,
    "chapterId": 48,
    "verseId": 3,
    "text": "יְפֵה נֹוף מְשֹׂושׂ כָּל־הָאָרֶץ הַר־צִיֹּון יַרְכְּתֵי צָפֹון קִרְיַת מֶלֶךְ רָב׃"
  },
  {
    "bookId": 19,
    "chapterId": 48,
    "verseId": 4,
    "text": "אֱלֹהִים בְּאַרְמְנֹותֶיהָ נֹודַע לְמִשְׂגָּב׃"
  },
  {
    "bookId": 19,
    "chapterId": 48,
    "verseId": 5,
    "text": "כִּי־הִנֵּה הַמְּלָכִים נֹועֲדוּ עָבְרוּ יַחְדָּו׃"
  },
  {
    "bookId": 19,
    "chapterId": 48,
    "verseId": 6,
    "text": "הֵמָּה רָאוּ כֵּן תָּמָהוּ נִבְהֲלוּ נֶחְפָּזוּ׃"
  },
  {
    "bookId": 19,
    "chapterId": 48,
    "verseId": 7,
    "text": "רְעָדָה אֲחָזָתַם שָׁם חִיל כַּיֹּולֵדָה׃"
  },
  {
    "bookId": 19,
    "chapterId": 48,
    "verseId": 8,
    "text": "בְּרוּחַ קָדִים תְּשַׁבֵּר אֳנִיֹּות תַּרְשִׁישׁ׃"
  },
  {
    "bookId": 19,
    "chapterId": 48,
    "verseId": 9,
    "text": "כַּאֲשֶׁר שָׁמַעְנוּ ׀ כֵּן רָאִינוּ בְּעִיר־יְהוָה צְבָאֹות בְּעִיר אֱלֹהֵינוּ אֱלֹהִים יְכֹונְנֶהָ עַד־עֹולָם סֶלָה׃"
  },
  {
    "bookId": 19,
    "chapterId": 48,
    "verseId": 10,
    "text": "דִּמִּינוּ אֱלֹהִים חַסְדֶּךָ בְּקֶרֶב הֵיכָלֶךָ׃"
  },
  {
    "bookId": 19,
    "chapterId": 48,
    "verseId": 11,
    "text": "כְּשִׁמְךָ אֱלֹהִים כֵּן תְּהִלָּתְךָ עַל־קַצְוֵי־אֶרֶץ צֶדֶק מָלְאָה יְמִינֶךָ׃"
  },
  {
    "bookId": 19,
    "chapterId": 48,
    "verseId": 12,
    "text": "יִשְׂמַח ׀ הַר־צִיֹּון תָּגֵלְנָה בְּנֹות יְהוּדָה לְמַעַן מִשְׁפָּטֶיךָ׃"
  },
  {
    "bookId": 19,
    "chapterId": 48,
    "verseId": 13,
    "text": "סֹבּוּ צִיֹּון וְהַקִּיפוּהָ סִפְרוּ מִגְדָּלֶיהָ׃"
  },
  {
    "bookId": 19,
    "chapterId": 48,
    "verseId": 14,
    "text": "שִׁיתוּ לִבְּכֶם ׀ לְחֵילָה פַּסְּגוּ אַרְמְנֹותֶיהָ לְמַעַן תְּסַפְּרוּ לְדֹור אַחֲרֹון׃"
  },
  {
    "bookId": 19,
    "chapterId": 48,
    "verseId": 15,
    "text": "כִּי זֶה ׀ אֱלֹהִים אֱלֹהֵינוּ עֹולָם וָעֶד הוּא יְנַהֲגֵנוּ עַל־מוּת׃"
  }
]
