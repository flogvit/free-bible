[
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 1,
    "text": "שִׁיר מִזְמֹור לְאָסָף׃"
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 2,
    "text": "אֱלֹהִים אַל־דֳּמִי־לָךְ אַל־תֶּחֱרַשׁ וְאַל־תִּשְׁקֹט אֵל׃"
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 3,
    "text": "כִּי־הִנֵּה אֹויְבֶיךָ יֶהֱמָיוּן וּמְשַׂנְאֶיךָ נָשְׂאוּ רֹאשׁ׃"
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 4,
    "text": "עַל־עַמְּךָ יַעֲרִימוּ סֹוד וְיִתְיָעֲצוּ עַל־צְפוּנֶיךָ׃"
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 5,
    "text": "אָמְרוּ לְכוּ וְנַכְחִידֵם מִגֹּוי וְלֹא־יִזָּכֵר שֵׁם־יִשְׂרָאֵל עֹוד׃"
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 6,
    "text": "כִּי נֹועֲצוּ לֵב יַחְדָּו עָלֶיךָ בְּרִית יִכְרֹתוּ׃"
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 7,
    "text": "אָהֳלֵי אֱדֹום וְיִשְׁמְעֵאלִים מֹואָב וְהַגְרִים׃"
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 8,
    "text": "גְּבָל וְעַמֹּון וַעֲמָלֵק פְּלֶשֶׁת עִם־יֹשְׁבֵי צֹור׃"
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 9,
    "text": "גַּם־אַשּׁוּר נִלְוָה עִמָּם הָיוּ זְרֹועַ לִבְנֵי־לֹוט סֶלָה׃"
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 10,
    "text": "עֲשֵׂה־לָהֶם כְּמִדְיָן כְּסִיסְרָא כְיָבִין בְּנַחַל קִישֹׁון׃"
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 11,
    "text": "נִשְׁמְדוּ בְעֵין־דֹּאר הָיוּ דֹּמֶן לָאֲדָמָה׃"
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 12,
    "text": "שִׁיתֵמֹו נְדִיבֵמֹו כְּעֹרֵב וְכִזְאֵב וּכְזֶבַח וּכְצַלְמֻנָּע כָּל־נְסִיכֵמֹו׃"
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 13,
    "text": "אֲשֶׁר אָמְרוּ נִירֲשָׁה לָּנוּ אֵת נְאֹות אֱלֹהִים׃"
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 14,
    "text": "אֱ‍לֹהַי שִׁיתֵמֹו כַגַּלְגַּל כְּקַשׁ לִפְנֵי־רוּחַ׃"
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 15,
    "text": "כְּאֵשׁ תִּבְעַר־יָעַר וּכְלֶהָבָה תְּלַהֵט הָרִים׃"
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 16,
    "text": "כֵּן תִּרְדְּפֵם בְּסַעֲרֶךָ וּבְסוּפָתְךָ תְבַהֲלֵם׃"
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 17,
    "text": "מַלֵּא פְנֵיהֶם קָלֹון וִיבַקְשׁוּ שִׁמְךָ יְהוָה׃"
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 18,
    "text": "יֵבֹשׁוּ וְיִבָּהֲלוּ עֲדֵי־עַד וְיַחְפְּרוּ וְיֹאבֵדוּ׃"
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 19,
    "text": "וְיֵדְעוּ כִּי־אַתָּה שִׁמְךָ יְהוָה לְבַדֶּךָ עֶלְיֹון עַל־כָּל־הָאָרֶץ׃"
  }
]
