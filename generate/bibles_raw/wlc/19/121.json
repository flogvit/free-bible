[
  {
    "bookId": 19,
    "chapterId": 121,
    "verseId": 1,
    "text": "שִׁיר לַמַּעֲלֹות אֶשָּׂא עֵינַי אֶל־הֶהָרִים מֵאַיִן יָבֹא עֶזְרִי׃"
  },
  {
    "bookId": 19,
    "chapterId": 121,
    "verseId": 2,
    "text": "עֶזְרִי מֵעִם יְהוָה עֹשֵׂה שָׁמַיִם וָאָרֶץ׃"
  },
  {
    "bookId": 19,
    "chapterId": 121,
    "verseId": 3,
    "text": "אַל־יִתֵּן לַמֹּוט רַגְלֶךָ אַל־יָנוּם שֹׁמְרֶךָ׃"
  },
  {
    "bookId": 19,
    "chapterId": 121,
    "verseId": 4,
    "text": "הִנֵּה לֹא־יָנוּם וְלֹא יִישָׁן ומֵר יִשְׂרָאֵל׃"
  },
  {
    "bookId": 19,
    "chapterId": 121,
    "verseId": 5,
    "text": "יְהוָה שֹׁמְרֶךָ יְהוָה צִלְּךָ עַל־יַד יְמִינֶךָ׃"
  },
  {
    "bookId": 19,
    "chapterId": 121,
    "verseId": 6,
    "text": "יֹומָם הַשֶּׁמֶשׁ לֹא־יַכֶּכָּה וְיָרֵחַ בַּלָּיְלָה׃"
  },
  {
    "bookId": 19,
    "chapterId": 121,
    "verseId": 7,
    "text": "יְהוָה יִשְׁמָרְךָ מִכָּל־רָע יִשְׁמֹר אֶת־נַפְשֶׁךָ׃"
  },
  {
    "bookId": 19,
    "chapterId": 121,
    "verseId": 8,
    "text": "יְהוָה יִשְׁמָר־צֵאתְךָ וּבֹואֶךָ מֵעַתָּה וְעַד־עֹולָם׃"
  }
]
