[
  {
    "bookId": 19,
    "chapterId": 122,
    "verseId": 1,
    "text": "שִׁיר הַמַּעֲלֹות לְדָוִד מַחְתִּי בְּאֹמְרִים לִי בֵּית יְהוָה נֵלֵךְ׃"
  },
  {
    "bookId": 19,
    "chapterId": 122,
    "verseId": 2,
    "text": "עֹמְדֹות הָיוּ רַגְלֵינוּ בִּשְׁעָרַיִךְ יְרוּשָׁלִָם׃"
  },
  {
    "bookId": 19,
    "chapterId": 122,
    "verseId": 3,
    "text": "יְרוּשָׁלִַם הַבְּנוּיָה כְּעִיר שֶׁחֻבְּרָה־לָּהּ יַחְדָּו׃"
  },
  {
    "bookId": 19,
    "chapterId": 122,
    "verseId": 4,
    "text": "שֶׁשָּׁם עָלוּ שְׁבָטִים שִׁבְטֵי־יָהּ עֵדוּת לְיִשְׂרָאֵל לְהֹדֹות לְשֵׁם יְהוָה׃"
  },
  {
    "bookId": 19,
    "chapterId": 122,
    "verseId": 5,
    "text": "כִּי שָׁמָּה ׀ יָשְׁבוּ כִסְאֹות לְמִשְׁפָּט כִּסְאֹות לְבֵית דָּוִיד׃"
  },
  {
    "bookId": 19,
    "chapterId": 122,
    "verseId": 6,
    "text": "אֲלוּ שְׁלֹום יְרוּשָׁלִָם יִשְׁלָיוּ אֹהֲבָיִךְ׃"
  },
  {
    "bookId": 19,
    "chapterId": 122,
    "verseId": 7,
    "text": "יְהִי־שָׁלֹום בְּחֵילֵךְ לְוָה בְּאַרְמְנֹותָיִךְ׃"
  },
  {
    "bookId": 19,
    "chapterId": 122,
    "verseId": 8,
    "text": "לְמַעַן אַחַי וְרֵעָי אֲדַבְּרָה־נָּא שָׁלֹום בָּךְ׃"
  },
  {
    "bookId": 19,
    "chapterId": 122,
    "verseId": 9,
    "text": "לְמַעַן בֵּית־יְהוָה אֱלֹהֵינוּ אֲבַקְשָׁה טֹוב לָךְ׃"
  }
]
