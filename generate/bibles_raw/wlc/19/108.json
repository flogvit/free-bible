[
  {
    "bookId": 19,
    "chapterId": 108,
    "verseId": 1,
    "text": "שִׁיר מִזְמֹור לְדָוִד׃"
  },
  {
    "bookId": 19,
    "chapterId": 108,
    "verseId": 2,
    "text": "נָכֹון לִבִּי אֱלֹהִים אָשִׁירָה וַאֲזַמְּרָה אַף־כְּבֹודִי׃"
  },
  {
    "bookId": 19,
    "chapterId": 108,
    "verseId": 3,
    "text": "עוּרָה הַנֵּבֶל וְכִנֹּור אָעִירָה שָּׁחַר׃"
  },
  {
    "bookId": 19,
    "chapterId": 108,
    "verseId": 4,
    "text": "אֹודְךָ בָעַמִּים ׀ יְהוָה וַאֲזַמֶּרְךָ בַּל־אֻמִּים׃"
  },
  {
    "bookId": 19,
    "chapterId": 108,
    "verseId": 5,
    "text": "כִּי־גָדֹול מֵעַל־שָׁמַיִם חַסְדֶּךָ וְעַד־שְׁחָקִים אֲמִתֶּךָ׃"
  },
  {
    "bookId": 19,
    "chapterId": 108,
    "verseId": 6,
    "text": "רוּמָה עַל־שָׁמַיִם אֱלֹהִים וְעַל כָּל־הָאָרֶץ כְּבֹודֶךָ׃"
  },
  {
    "bookId": 19,
    "chapterId": 108,
    "verseId": 7,
    "text": "לְמַעַן יֵחָלְצוּן יְדִידֶיךָ הֹושִׁיעָה יְמִינְךָ וַעֲנֵנִי׃"
  },
  {
    "bookId": 19,
    "chapterId": 108,
    "verseId": 8,
    "text": "אֱלֹהִים ׀ דִּבֶּר בְּקָדְשֹׁו אֶעְלֹזָה אֲחַלְּקָה שְׁכֶם וְעֵמֶק סֻכֹּות אֲמַדֵּד׃"
  },
  {
    "bookId": 19,
    "chapterId": 108,
    "verseId": 9,
    "text": "לִי גִלְעָד ׀ לִי מְנַשֶּׁה וְאֶפְרַיִם מָעֹוז רֹאשִׁי יְהוּדָה מְחֹקְקִי׃"
  },
  {
    "bookId": 19,
    "chapterId": 108,
    "verseId": 10,
    "text": "מֹואָב ׀ סִיר רַחְצִי עַל־אֱדֹום אַשְׁלִיךְ נַעֲלִי עֲלֵי־פְלֶשֶׁת אֶתְרֹועָע׃"
  },
  {
    "bookId": 19,
    "chapterId": 108,
    "verseId": 11,
    "text": "מִי יֹבִלֵנִי עִיר מִבְצָר מִי נָחַנִי עַד־אֱדֹום׃"
  },
  {
    "bookId": 19,
    "chapterId": 108,
    "verseId": 12,
    "text": "הֲלֹא־אֱלֹהִים זְנַחְתָּנוּ וְלֹא־תֵצֵא אֱלֹהִים בְּצִבְאֹתֵינוּ׃"
  },
  {
    "bookId": 19,
    "chapterId": 108,
    "verseId": 13,
    "text": "הָבָה־לָּנוּ עֶזְרָת מִצָּר וְשָׁוְא תְּשׁוּעַת אָדָם׃"
  },
  {
    "bookId": 19,
    "chapterId": 108,
    "verseId": 14,
    "text": "בֵּאלֹהִים נַעֲשֶׂה־חָיִל וְהוּא יָבוּס צָרֵינוּ׃"
  }
]
