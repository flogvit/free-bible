[
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 1,
    "text": "אָהַבְתִּי כִּי־יִשְׁמַע ׀ יְהוָה אֶת־קֹולִי תַּחֲנוּנָי׃"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 2,
    "text": "כִּי־הִטָּה אָזְנֹו לִי וּבְיָמַי אֶקְרָא׃"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 3,
    "text": "אֲפָפוּנִי ׀ חֶבְלֵי־מָוֶת וּמְצָרֵי שְׁאֹול מְצָאוּנִי צָרָה וְיָגֹון אֶמְצָא׃"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 4,
    "text": "וּבְשֵׁם־יְהוָה אֶקְרָא אָנָּה יְהוָה מַלְּטָה נַפְשִׁי׃"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 5,
    "text": "חַנּוּן יְהֹוָה וְצַדִּיק וֵאלֹהֵינוּ מְרַחֵם׃"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 6,
    "text": "שֹׁמֵר פְּתָאיִם יְהֹוָה דַּלֹּותִי וְלִי יְהֹושִׁיעַ׃"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 7,
    "text": "שׁוּבִי נַפְשִׁי לִמְנוּחָיְכִי כִּי־יְהוָה גָּמַל עָלָיְכִי׃"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 8,
    "text": "כִּי חִלַּצְתָּ נַפְשִׁי מִמָּוֶת אֶת־עֵינִי מִן־דִּמְעָה אֶת־רַגְלִי מִדֶּחִי׃"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 9,
    "text": "אֶתְהַלֵּךְ לִפְנֵי יְהוָה בְּאַרְצֹות הַחַיִּים׃"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 10,
    "text": "הֶאֱמַנְתִּי כִּי אֲדַבֵּר אֲנִי עָנִיתִי מְאֹד׃"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 11,
    "text": "אֲנִי אָמַרְתִּי בְחָפְזִי כָּל־הָאָדָם כֹּזֵב׃"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 12,
    "text": "מָה־אָשִׁיב לַיהוָה כָּל־תַּגְמוּלֹוהִי עָלָי׃"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 13,
    "text": "כֹּוס־יְשׁוּעֹות אֶשָּׂא וּבְשֵׁם יְהוָה אֶקְרָא׃"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 14,
    "text": "נְדָרַי לַיהוָה אֲשַׁלֵּם נֶגְדָה־נָּא לְכָל־עַמֹּו׃"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 15,
    "text": "יָקָר בְּעֵינֵי יְהוָה הַמָּוְתָה לַחֲסִידָיו׃"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 16,
    "text": "אָנָּה יְהוָה כִּי־אֲנִי עַבְדֶּךָ אֲ‍נִי־עַבְדְּךָ בֶּן־אֲמָתֶךָ פִּתַּחְתָּ לְמֹוסֵרָי׃"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 17,
    "text": "לְךָ־אֶזְבַּח זֶבַח תֹּודָה וּבְשֵׁם יְהוָה אֶקְרָא׃"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 18,
    "text": "נְדָרַי לַיהוָה אֲשַׁלֵּם נֶגְדָה־נָּא לְכָל־עַמֹּו׃"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 19,
    "text": "בְּחַצְרֹות ׀ בֵּית יְהוָה בְּתֹוכֵכִי יְרוּשָׁלִָם הַלְלוּ־יָהּ׃"
  }
]
