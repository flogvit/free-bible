[
  {
    "bookId": 19,
    "chapterId": 76,
    "verseId": 1,
    "text": "לַמְנַצֵּחַ בִּנְגִינֹת מִזְמֹור לְאָסָף שִׁיר׃"
  },
  {
    "bookId": 19,
    "chapterId": 76,
    "verseId": 2,
    "text": "נֹודָע בִּיהוּדָה אֱלֹהִים בְּיִשְׂרָאֵל גָּדֹול שְׁמֹו׃"
  },
  {
    "bookId": 19,
    "chapterId": 76,
    "verseId": 3,
    "text": "וַיְהִי בְשָׁלֵם סֻכֹּו וּמְעֹונָתֹו בְצִיֹּון׃"
  },
  {
    "bookId": 19,
    "chapterId": 76,
    "verseId": 4,
    "text": "מָּה שִׁבַּר רִשְׁפֵי־קָשֶׁת מָגֵן וְחֶרֶב וּמִלְחָמָה סֶלָה׃"
  },
  {
    "bookId": 19,
    "chapterId": 76,
    "verseId": 5,
    "text": "נָאֹור אַתָּה אַדִּיר מֵהַרְרֵי־טָרֶף׃"
  },
  {
    "bookId": 19,
    "chapterId": 76,
    "verseId": 6,
    "text": "אֶשְׁתֹּולְלוּ ׀ אַבִּירֵי לֵב נָמוּ שְׁנָתָם וְלֹא־מָצְאוּ כָל־אַנְשֵׁי־חַיִל יְדֵיהֶם׃"
  },
  {
    "bookId": 19,
    "chapterId": 76,
    "verseId": 7,
    "text": "מִגַּעֲרָתְךָ אֱלֹהֵי יַעֲקֹב נִרְדָּם וְרֶכֶב וָסוּס׃"
  },
  {
    "bookId": 19,
    "chapterId": 76,
    "verseId": 8,
    "text": "אַתָּה ׀ נֹורָא אַתָּה וּמִי־יַעֲמֹד לְפָנֶיךָ מֵאָז אַפֶּךָ׃"
  },
  {
    "bookId": 19,
    "chapterId": 76,
    "verseId": 9,
    "text": "מִשָּׁמַיִם הִשְׁמַעְתָּ דִּין אֶרֶץ יָרְאָה וְשָׁקָטָה׃"
  },
  {
    "bookId": 19,
    "chapterId": 76,
    "verseId": 10,
    "text": "בְּקוּם־לַמִּשְׁפָּט אֱלֹהִים לְהֹושִׁיעַ כָּל־עַנְוֵי־אֶרֶץ סֶלָה׃"
  },
  {
    "bookId": 19,
    "chapterId": 76,
    "verseId": 11,
    "text": "כִּי־חֲמַת אָדָם תֹּודֶךָּ שְׁאֵרִית חֵמֹת תַּחְגֹּר׃"
  },
  {
    "bookId": 19,
    "chapterId": 76,
    "verseId": 12,
    "text": "נִדֲרוּ וְשַׁלְּמוּ לַיהוָה אֱ‍לֹהֵיכֶם כָּל־סְבִיבָיו יֹובִילוּ י לַמֹּורָא׃"
  },
  {
    "bookId": 19,
    "chapterId": 76,
    "verseId": 13,
    "text": "יִבְצֹר רוּחַ נְגִידִים נֹורָא לְמַלְכֵי־אָרֶץ׃"
  }
]
