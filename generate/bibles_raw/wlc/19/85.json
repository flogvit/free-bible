[
  {
    "bookId": 19,
    "chapterId": 85,
    "verseId": 1,
    "text": "לַמְנַצֵּחַ ׀ לִבְנֵי־קֹרַח מִזְמֹור׃"
  },
  {
    "bookId": 19,
    "chapterId": 85,
    "verseId": 2,
    "text": "רָצִיתָ יְהוָה אַרְצֶךָ בְתָּ [שְׁבוּת כ] (שְׁבִית ק) יַעֲקֹב׃"
  },
  {
    "bookId": 19,
    "chapterId": 85,
    "verseId": 3,
    "text": "נָשָׂאתָ עֲוֹן עַמֶּךָ כִּסִּיתָ כָל־חַטָּאתָם סֶלָה׃"
  },
  {
    "bookId": 19,
    "chapterId": 85,
    "verseId": 4,
    "text": "אָסַפְתָּ כָל־עֶבְרָתֶךָ הֱשִׁיבֹותָ מֵחֲרֹון אַפֶּךָ׃"
  },
  {
    "bookId": 19,
    "chapterId": 85,
    "verseId": 5,
    "text": "וּבֵנוּ אֱלֹהֵי יִשְׁעֵנוּ וְהָפֵר כַּעַסְךָ עִמָּנוּ׃"
  },
  {
    "bookId": 19,
    "chapterId": 85,
    "verseId": 6,
    "text": "הַלְעֹולָם תֶּאֱנַף־בָּנוּ תִּמְשֹׁךְ אַפְּךָ לְדֹר וָדֹר׃"
  },
  {
    "bookId": 19,
    "chapterId": 85,
    "verseId": 7,
    "text": "הֲלֹא־אַתָּה תָּשׁוּב תְּחַיֵּנוּ וְעַמְּךָ יִשְׂמְחוּ־בָךְ׃"
  },
  {
    "bookId": 19,
    "chapterId": 85,
    "verseId": 8,
    "text": "הַרְאֵנוּ יְהוָה חַסְדֶּךָ וְיֶשְׁעֲךָ תִּתֶּן־לָנוּ׃"
  },
  {
    "bookId": 19,
    "chapterId": 85,
    "verseId": 9,
    "text": "אֶשְׁמְעָה מַה־יְדַבֵּר הָאֵל ׀ יְהוָה כִּי ׀ יְדַבֵּר שָׁלֹום אֶל־עַמֹּו וְאֶל־חֲסִידָיו וְאַל־יָשׁוּבוּ לְכִסְלָה׃"
  },
  {
    "bookId": 19,
    "chapterId": 85,
    "verseId": 10,
    "text": "אַךְ ׀ קָרֹוב לִירֵאָיו יִשְׁעֹו לִשְׁכֹּן כָּבֹוד בְּאַרְצֵנוּ׃"
  },
  {
    "bookId": 19,
    "chapterId": 85,
    "verseId": 11,
    "text": "חֶסֶד־וֶאֱמֶת נִפְגָּשׁוּ צֶדֶק וְשָׁלֹום נָשָׁקוּ׃"
  },
  {
    "bookId": 19,
    "chapterId": 85,
    "verseId": 12,
    "text": "אֱמֶת מֵאֶרֶץ תִּצְמָח וְצֶדֶק מִשָּׁמַיִם נִשְׁקָף׃"
  },
  {
    "bookId": 19,
    "chapterId": 85,
    "verseId": 13,
    "text": "גַּם־יְהוָה יִתֵּן הַטֹּוב וְאַרְצֵנוּ תִּתֵּן יְבוּלָהּ׃"
  },
  {
    "bookId": 19,
    "chapterId": 85,
    "verseId": 14,
    "text": "צֶדֶק לְפָנָיו יְהַלֵּךְ וְיָשֵׂם לְדֶרֶךְ פְּעָמָיו׃"
  }
]
