  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 59,
    "text": "Waɗannan mutanen ne suka zo daga garuruwan Tel-Mela, Tel-Harsha, Kerub, Addan da Immer, amma ba su iya nuna ainihin tushensu daga Isra’ila ba."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 60,
    "text": "’Yan zuriyar Delahiya, Tobiya, da Nekoda 652."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 61,
    "text": "Daga cikin firistoci kuma, zuriyar Hobahiya, Hakkoz da Barzillai (wanda ya auri diyar Barzillai mutumin Gileyad da ake kuma kira da wannan suna)."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 62,
    "text": "Waɗannan sun nemi sunayen iyalansu a cikin littafin da ake rubuta sunayen amma ba su ga sunayensu ba, saboda haka sai aka hana su zama firistoci domin an ɗauka su marasa tsabta ne."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 63,
    "text": "Gwamna ya umarce su cewa kada su ci wani abinci mai tsarki sai firist ya yi shawara ta wurin Urim da Tummim tukuna."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 64,
    "text": "Yawan jama’ar duka ya kai mutum 42,360,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 65,
    "text": "ban da bayinsu maza da mata 7,337; suna kuma da mawaƙa maza da mata 200."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 66,
    "text": "Suna da dawakai guda 736, alfadarai 245,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 67,
    "text": "raƙuma 435, da jakuna 6,720."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 68,
    "text": "¶ Sa’ad da suka isa haikalin Ubangiji a Urushalima, sai waɗansu shugabannin iyalai suka yi bayarwar yardar rai ta gudummawarsu domin sāke gina gidan Allah a wurin da yake."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 69,
    "text": "Bisa ga ƙarfinsu suka bayar da darik 61,000 na zinariya, da maina 5,000 na azurfa, da rigunan firistoci guda 100."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 70,
    "text": "¶ Firistoci, da Lawiyawa, da mawaƙa, da masu tsaron ƙofofi, da masu aiki a haikali, tare da waɗansu mutane, da dukan sauran Isra’ilawa suka zauna a garuruwansu."
  }
