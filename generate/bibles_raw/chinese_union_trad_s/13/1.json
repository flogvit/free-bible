[
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 1,
    "text": "¶ 亞當{H121}生塞特{H8352}；塞特{H8352}生以挪士{H583}；"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 2,
    "text": "以挪士{H583}生該南{H7018}；該南{H7018}生瑪勒列{H4111}；瑪勒列{H4111}生雅列{H3382}；"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 3,
    "text": "雅列{H3382}生以諾{H2585}；以諾{H2585}生瑪土撒拉{H4968}；瑪土撒拉{H4968}生拉麥{H3929}；"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 4,
    "text": "拉麥{H3929}生挪亞{H5146}；挪亞{H5146}生閃{H8035}、含{H2526}、雅弗{H3315}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 5,
    "text": "雅弗{H3315}的兒子{H1121}是歌篾{H1586}、瑪各{H4031}、瑪代{H4074}、雅完{H3120}、土巴{H8422}、米設{H4902}、提拉{H8494}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 6,
    "text": "歌篾{H1586}的兒子{H1121}是亞實基拿{H813}、低法{H7384}(創十章三節作利法)、陀迦瑪{H8425}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 7,
    "text": "雅完{H3120}的兒子{H1121}是以利沙{H473}、他施{H8659}、基提{H3794}、多單{H1721}(有作羅單的)。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 8,
    "text": "含{H2526}的兒子{H1121}是古實{H3568}、麥西{H4714}、弗{H6316}、迦南{H3667}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 9,
    "text": "古實{H3568}的兒子{H1121}是西巴{H5434}、哈腓拉{H2341}、撒弗他{H5454}、拉瑪{H7484}、撒弗提迦{H5455}。拉瑪{H7484}的兒子{H1121}是示巴{H7614}、底但{H1719}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 10,
    "text": "古實{H3568}生{H3205}寧錄{H5248}；他為{H2490}世上{H776}英雄之首{H1368}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 11,
    "text": "麥西{H4714}生{H3205}路低人{H3866}、亞拿米人{H6047}、利哈比人{H3853}、拿弗土希人{H5320}、"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 12,
    "text": "帕斯魯細人{H6625}、迦斯路希人{H3695}、迦斐託人{H3732}；從迦斐託出來{H3318}的有非利士人{H6430}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 13,
    "text": "迦南{H3667}生{H3205}長子{H1060}西頓{H6721}，又生赫{H2845}"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 14,
    "text": "和耶布斯人{H2983}、亞摩利人{H567}、革迦撒人{H1622}、"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 15,
    "text": "希未人{H2340}、亞基人{H6208}、西尼人{H5513}、"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 16,
    "text": "亞瓦底人{H721}、洗瑪利人{H6786}，並哈馬人{H2577}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 17,
    "text": "閃{H8035}的兒子{H1121}是以攔{H5867}、亞述{H804}、亞法撒{H775}、路德{H3865}、亞蘭{H758}、烏斯{H5780}、戶勒{H2343}、基帖{H1666}、米設{H4902}(創十23作瑪施)。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 18,
    "text": "亞法撒{H775}生{H3205}沙拉{H7974}；沙拉{H7974}生{H3205}希伯{H5677}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 19,
    "text": "希伯{H5677}生了{H3205}兩個{H8147}兒子{H1121}：一個{H259}名叫{H8034}法勒{H6389}(就是分的意思)，因為那時{H3117}人就分{H6385}地{H776}居住；法勒的兄弟{H251}名叫{H8034}約坍{H3355}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 20,
    "text": "約坍{H3355}生{H3205}亞摩答{H486}、沙列{H8026}、哈薩瑪非{H2700}、耶拉{H3392}、"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 21,
    "text": "哈多蘭{H1913}、烏薩{H187}、德拉{H1853}、"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 22,
    "text": "以巴錄{H5858}、亞比瑪利{H39}、示巴{H7614}、"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 23,
    "text": "阿斐{H211}、哈腓拉{H2341}、約巴{H3103}。這都是約坍{H3355}的兒子{H1121}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 24,
    "text": "閃{H8035}生亞法撒{H775}；亞法撒生沙拉{H7974}；"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 25,
    "text": "沙拉生希伯{H5677}；希伯生法勒{H6389}；法勒生拉吳{H7466}；"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 26,
    "text": "拉吳生西鹿{H8286}；西鹿生拿鶴{H5152}；拿鶴生他拉{H8646}；"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 27,
    "text": "他拉生亞伯蘭{H87}，亞伯蘭就是亞伯拉罕{H85}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 28,
    "text": "亞伯拉罕{H85}的兒子{H1121}是以撒{H3327}、以實瑪利{H3458}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 29,
    "text": "以實瑪利的兒子記在下面：以實瑪利{H3458}的長子{H1060}是尼拜約{H5032}，其次是基達{H6938}、押德別{H110}、米比衫{H4017}、"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 30,
    "text": "米施瑪{H4927}、度瑪{H1746}、瑪撒{H4854}、哈達{H2301}、提瑪{H8485}、"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 31,
    "text": "伊突{H3195}、拿非施{H5305}、基底瑪{H6929}。這都是以實瑪利{H3458}的兒子{H1121}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 32,
    "text": "亞伯拉罕{H85}的妾{H6370}基土拉{H6989}所生的{H3205}兒子{H1121}，就是心蘭{H2175}、約珊{H3370}、米但{H4091}、米甸{H4080}、伊施巴{H3435}、書亞{H7744}。約珊{H3370}的兒子{H1121}是示巴{H7614}、底但{H1719}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 33,
    "text": "米甸{H4080}的兒子{H1121}是以法{H5891}、以弗{H6081}、哈諾{H2585}、亞比大{H28}、以勒大{H420}。這都是基土拉{H6989}的子孫{H1121}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 34,
    "text": "亞伯拉罕{H85}生{H3205}以撒{H3327}；以撒{H3327}的兒子{H1121}是以掃{H6215}和以色列{H3478}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 35,
    "text": "以掃{H6215}的兒子{H1121}是以利法{H464}、流珥{H7467}、耶烏施{H3266}、雅蘭{H3281}、可拉{H7141}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 36,
    "text": "以利法{H464}的兒子{H1121}是提幔{H8487}、阿抹{H201}、洗玻{H6825}、迦坦{H1609}、基納斯{H7073}、亭納{H8555}、亞瑪力{H6002}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 37,
    "text": "流珥{H7467}的兒子{H1121}是拿哈{H5184}、謝拉{H2226}、沙瑪{H8048}、米撒{H4199}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 38,
    "text": "西珥{H8165}的兒子{H1121}是羅坍{H3877}、朔巴{H7732}、祭便{H6649}、亞拿{H6034}、底順{H1787}、以察{H687}、底珊{H1789}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 39,
    "text": "羅坍{H3877}的兒子{H1121}是何利{H2753}、荷幔{H1950}；羅坍{H3877}的妹子{H269}是亭納{H8555}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 40,
    "text": "朔巴{H7732}的兒子{H1121}是亞勒文{H5935}、瑪拿轄{H4506}、以巴錄{H5858}、示非{H8195}、阿南{H208}。祭便{H6649}的兒子{H1121}是亞雅{H345}、亞拿{H6034}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 41,
    "text": "亞拿{H6034}的兒子{H1121}是底順{H1787}。底順{H1787}的兒子{H1121}是哈默蘭{H2566}、伊是班{H790}、益蘭{H3506}、基蘭{H3763}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 42,
    "text": "以察{H687}的兒子{H1121}是辟罕{H1092}、撒番{H2190}、亞干{H3292}。底珊{H1789}的兒子{H1121}是烏斯{H5780}、亞蘭{H765}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 43,
    "text": "以色列{H3478}人{H1121}未有君王{H4428}治理{H4427}之先，在以東{H123}地{H776}作王{H4428}的記在下面：有比珥{H1160}的兒子{H1121}比拉{H1106}，他的京城{H5892}名叫{H8034}亭哈巴{H1838}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 44,
    "text": "比拉{H1106}死了{H4191}，波斯拉人{H1224}謝拉{H2226}的兒子{H1121}約巴{H3103}接續他作王{H4427}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 45,
    "text": "約巴{H3103}死了{H4191}，提幔{H8489}地{H776}的人戶珊{H2367}接續他作王{H4427}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 46,
    "text": "戶珊{H2367}死了{H4191}，比達{H911}的兒子{H1121}哈達{H1908}接續他作王{H4427}。這哈達就是在摩押{H4124}地{H7704}殺敗{H5221}米甸人{H4080}的，他的京城{H5892}名叫{H8034}亞未得{H5762}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 47,
    "text": "哈達{H1908}死了{H4191}，瑪士利加人{H4957}桑拉{H8072}接續他作王{H4427}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 48,
    "text": "桑拉{H8072}死了{H4191}，大河{H5104}邊的利河伯人{H7344}掃羅{H7586}接續他作王{H4427}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 49,
    "text": "掃羅{H7586}死了{H4191}，亞革波{H5907}的兒子{H1121}巴勒哈南{H1177}接續他作王{H4427}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 50,
    "text": "巴勒哈南{H1177}死了{H4191}，哈達{H1908}接續他作王{H4427}。他的京城{H5892}名叫{H8034}巴伊{H6464}，他的妻子{H802}名叫{H8034}米希他別{H4105}，是米薩合{H4314}的孫女{H1323}，瑪特列{H4308}的女兒{H1323}。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 51,
    "text": "哈達{H1908}死了{H4191}，以東人{H123}的族長{H441}有亭納{H8555}族長{H441}、亞勒瓦{H5933}族長{H441}、耶帖{H3509}族長{H441}、"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 52,
    "text": "亞何利巴瑪{H173}族長{H441}、以拉{H425}族長{H441}、比嫩{H6373}族長{H441}、"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 53,
    "text": "基納斯{H7073}族長{H441}、提幔{H8487}族長{H441}、米比薩{H4014}族長{H441}、"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 54,
    "text": "瑪基疊{H4025}族長{H441}、以蘭{H5902}族長{H441}。這都是以東人{H123}的族長{H441}。"
  }
]
