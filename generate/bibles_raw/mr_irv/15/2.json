[
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 1,
    "text": "¶ बाबेलचा राजा नबुखद्नेस्सराने बाबेलास नेलेले यरूशलेम आणि यहूदा प्रांतातील बंद कैदी मुक्त होऊन आपापल्या नगरात परतले."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 2,
    "text": "जरुब्बाबेलाबरोबर आलेले ते हे येशूवा, नहेम्या, सराया, रएलाया, मर्दखय, बिलशान, मिस्पार, बिग्वई, रहूम व बाना. इस्राएली लोकांची यादी येणे प्रमाणे."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 3,
    "text": "¶ परोशाचे वंशज दोन हजार एकशे बाहत्तर."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 4,
    "text": "शफाट्याचे वंशज तीनशे बहात्तर."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 5,
    "text": "आरहाचे वंशज सातशे पंचाहत्तर."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 6,
    "text": "येशूवा व यवाब यांच्या वंशजातील पहथ-मवाबाचे वंशज दोन हजार आठशे बारा."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 7,
    "text": "¶ एलामाचे वंशज एक हजार दोनशे चौपन्न."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 8,
    "text": "जत्तूचे वंशज नऊशें पंचेचाळीस."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 9,
    "text": "जक्काईचे वंशज सातशे साठ."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 10,
    "text": "बानीचे वंशज सहाशे बेचाळीस."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 11,
    "text": "¶ बेबाईचे वंशज सहाशे तेवीस."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 12,
    "text": "अजगादाचे वंशज एक हजार दोनशे बावीस."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 13,
    "text": "अदोनीकामाचे वंशज सहाशे सहासष्ट."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 14,
    "text": "बिग्वईचे वंशज दोन हजार छपन्न."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 15,
    "text": "¶ आदीनाचे वंशज चारशे चौपन्न."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 16,
    "text": "हिज्कीयाच्या घराण्यातील आटेराचे वंशज अठ्याण्णव."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 17,
    "text": "बेसाईचे वंशज तीनशे तेवीस."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 18,
    "text": "योराचे वंशज एकशे बारा."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 19,
    "text": "¶ हाशूमाचे वंशज दोनशे तेवीस."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 20,
    "text": "गिबाराचे वंशज पंचाण्णव."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 21,
    "text": "बेथलहेमातील लोक एकशे तेवीस."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 22,
    "text": "नटोफातील लोक छपन्न."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 23,
    "text": "¶ अनाथोथतील लोक एकशे अठ्ठावीस."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 24,
    "text": "अजमावेथातील लोक बेचाळीस"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 25,
    "text": "किर्याथ-आरीम, कफीरा आणि बैरोथ येथील लोक सातशे त्रेचाळीस."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 26,
    "text": "रामा व गिबा मधील लोक सहाशे एकवीस."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 27,
    "text": "¶ मिखमासातील लोक एकशे बावीस."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 28,
    "text": "बेथेल आणि आय येथील लोक दोनशे तेवीस."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 29,
    "text": "नबोतील लोक बावन्न."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 30,
    "text": "मग्वीशाचे लोक एकशे छपन्न."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 31,
    "text": "दुसऱ्या एलामाचे लोक एक हजार दोनशे चौपन्न."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 32,
    "text": "हारीम येथील लोक तीनशे वीस."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 33,
    "text": "लोद, हादीद आणि ओनो येथील लोक सातशे पंचवीस."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 34,
    "text": "¶ यरीहोतील लोक तीनशे पंचेचाळीस."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 35,
    "text": "सनाहाचे लोक तीन हजार सहाशे तीस."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 36,
    "text": "¶ याजक येशूवाच्या घराण्यातील यदयाचे वंशज नऊशें त्र्याहत्तर."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 37,
    "text": "इम्मेराचे वंशज एक हजार बावन्न."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 38,
    "text": "पशूहराचे वंशज एक हजार दोनशे सत्तेचाळीस."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 39,
    "text": "हारीमाचे वंशज एक हजार सतरा."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 40,
    "text": "¶ लेवी, होदव्याच्या घराण्यातील येशूवा व कदमीएल यांचे वंशज चौऱ्याहत्तर."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 41,
    "text": "मंदिरातील गायक आसाफचे वंशज एकशे अठ्ठावीस."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 42,
    "text": "मंदिराच्या द्वारपालांचे वंशज, शल्लूम, आटेर, तल्मोन, अक्कूवा, हतीता आणि शोबाई यांचे वंशज एकूण एकशे एकोणचाळीस."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 43,
    "text": "¶ मंदिरातील नेमून दिलेली सेवा, सीहा, हसूफा, तब्बाबोथ यांचे वंशज."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 44,
    "text": "केरोस, सीहा, पादोन."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 45,
    "text": "लबाना, हगबा, अकूबा,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 46,
    "text": "हागाब, शम्लाई, हानान."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 47,
    "text": "¶ गिद्देल, गहर, राया,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 48,
    "text": "रसीन, नकोदा, गज्जाम,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 49,
    "text": "उज्जा, पासेह, बेसाई,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 50,
    "text": "अस्ना, मऊनीम, नफसीम."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 51,
    "text": "¶ बकबुक हकूफ, हरहुर,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 52,
    "text": "बस्लूथ, महीद, हर्षा,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 53,
    "text": "बार्कोस, सीसरा, तामह,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 54,
    "text": "नसीहा, हतीफा."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 55,
    "text": "शलमोनाच्या सेवाकांचे वंशज, सोताई, हसोफरत, परुदा,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 56,
    "text": "जाला, दार्कोन, गिद्देल,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 57,
    "text": "शफाट्या, हत्तील, पोखेरेथ-हस्सबाईम, आमी"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 58,
    "text": "मंदिरातील चाकर आणि शलमोनच्या सेवकांचे नेमून दिलेले काम करणारे वंशज एकूण तीनशे ब्याण्णव होते."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 59,
    "text": "तेल-मेलह, तेल-हर्षा, करुब, अद्दान, इम्मेर या ठिकाणांहून काहीजण यरूशलेमेला आले होते पण आपण इस्राएलाच्या वंशातलेच पूर्वज आहोत हे ते सिद्ध करू शकले नाहीत."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 60,
    "text": "दलाया, तोबीया आणि नकोदाचे वंशज सहाशे बावन्न."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 61,
    "text": "आणि याजकांचे वंशज: हबया, हक्कोस, बर्जिल्ल्य (ज्याने बर्जिल्ल्य गिलादी याच्या मुलींपैकी एक मुलगी पत्नी करून घेतली होती आणि त्यास त्याचे नाव पडले होते.)"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 62,
    "text": "आपल्या घराण्याची वंशावळ त्यांनी नोंदपुस्तकात शोधून पाहिली पण त्यांना ती सापडली नाही म्हणून त्यांनी त्यांचे याजकपण अशुद्ध केले."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 63,
    "text": "याकरीता अधिपतीने त्यांना सांगितले की, उरीम व थुम्मीम घातलेला याजक मंजूर होईपर्यंत त्यांनी पवित्र अर्पण खाऊ नये."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 64,
    "text": "¶ सर्व समुदाय एकंदर बेचाळीस हजार तीनशे साठ इतका होता."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 65,
    "text": "त्यामध्ये त्यांच्या सात हजार तीनशे सदतीस दासदासी यांचा आणि मंदिरातील दोनशे गायकांचा यांचा समावेश नाही."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 66,
    "text": "¶ त्यांचे घोडे सातशे छत्तीस, खेचरे दोनशे पंचेचाळीस."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 67,
    "text": "त्यांचे उंट चारशे पस्तीस. त्यांची गाढवे सहा हजार सातशे वीस होती."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 68,
    "text": "हे सर्वजण यरूशलेमेत परमेश्वराच्या मंदिराजवळ आले. मग अनेक घराण्याच्या प्रमुखांनी मंदिराच्या बांधकामासाठी खुशीने भेटी दिल्या."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 69,
    "text": "या वास्तूच्या कामासाठी त्यांनी आपल्या शक्तीप्रमाणे दिलेली दाने ती अशी: सोने एकसष्ट हजार दारिक, चांदी पाच हजार माने, आणि याजकांचे झगे शंभर."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 70,
    "text": "¶ याप्रकारे याजक, लेवी आणि इतर काही लोक, गायक, द्वारपाल आणि ज्यांना मंदिरातील सेवा नेमून दिली होती ते आपापल्या नगरांत राहिले. इस्राएलातील सर्व लोक आपापल्या नगरांत वस्ती करून राहिले."
  }
]
