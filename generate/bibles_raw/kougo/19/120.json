[
  {
    "bookId": 19,
    "chapterId": 120,
    "verseId": 1,
    "text": "わたしが悩みのうちに、主に呼ばわると、 主はわたしに答えられる。"
  },
  {
    "bookId": 19,
    "chapterId": 120,
    "verseId": 2,
    "text": "「主よ、偽りのくちびるから、 欺きの舌から、わたしを助け出してください」。"
  },
  {
    "bookId": 19,
    "chapterId": 120,
    "verseId": 3,
    "text": "欺きの舌よ、おまえに何が与えられ、 何が加えられるであろうか。"
  },
  {
    "bookId": 19,
    "chapterId": 120,
    "verseId": 4,
    "text": "ますらおの鋭い矢と、 えにしだの熱い炭とである。"
  },
  {
    "bookId": 19,
    "chapterId": 120,
    "verseId": 5,
    "text": "わざわいなるかな、わたしはメセクにやどり、 ケダルの天幕のなかに住んでいる。"
  },
  {
    "bookId": 19,
    "chapterId": 120,
    "verseId": 6,
    "text": "わたしは久しく平安を憎む者のなかに住んでいた。"
  },
  {
    "bookId": 19,
    "chapterId": 120,
    "verseId": 7,
    "text": "わたしは平安を願う、 しかし、わたしが物言うとき、彼らは戦いを好む。"
  }
]
