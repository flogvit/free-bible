[
  {
    "bookId": 19,
    "chapterId": 114,
    "verseId": 1,
    "text": "イスラエルがエジプトをいで、 ヤコブの家が異言の民を離れたとき、"
  },
  {
    "bookId": 19,
    "chapterId": 114,
    "verseId": 2,
    "text": "ユダは主の聖所となり、 イスラエルは主の所領となった。"
  },
  {
    "bookId": 19,
    "chapterId": 114,
    "verseId": 3,
    "text": "海はこれを見て逃げ、 ヨルダンはうしろに退き、"
  },
  {
    "bookId": 19,
    "chapterId": 114,
    "verseId": 4,
    "text": "山は雄羊のように踊り、 小山は小羊のように踊った。"
  },
  {
    "bookId": 19,
    "chapterId": 114,
    "verseId": 5,
    "text": "海よ、おまえはどうして逃げるのか、 ヨルダンよ、おまえはどうしてうしろに退くのか。"
  },
  {
    "bookId": 19,
    "chapterId": 114,
    "verseId": 6,
    "text": "山よ、おまえたちはどうして雄羊のように踊るのか、 小山よ、おまえたちはどうして小羊のように踊るのか。"
  },
  {
    "bookId": 19,
    "chapterId": 114,
    "verseId": 7,
    "text": "地よ、主のみ前におののけ、 ヤコブの神のみ前におののけ。"
  },
  {
    "bookId": 19,
    "chapterId": 114,
    "verseId": 8,
    "text": "主は岩を池に変らせ、 石を泉に変らせられた。"
  }
]
