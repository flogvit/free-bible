[
  {
    "bookId": 19,
    "chapterId": 113,
    "verseId": 1,
    "text": "主をほめたたえよ。 主のしもべたちよ、ほめたたえよ。 主のみ名をほめたたえよ。"
  },
  {
    "bookId": 19,
    "chapterId": 113,
    "verseId": 2,
    "text": "今より、とこしえに至るまで主のみ名はほむべきかな。"
  },
  {
    "bookId": 19,
    "chapterId": 113,
    "verseId": 3,
    "text": "日のいずるところから日の入るところまで、 主のみ名はほめたたえられる。"
  },
  {
    "bookId": 19,
    "chapterId": 113,
    "verseId": 4,
    "text": "主はもろもろの国民の上に高くいらせられ、 その栄光は天よりも高い。"
  },
  {
    "bookId": 19,
    "chapterId": 113,
    "verseId": 5,
    "text": "われらの神、主にくらぶべき者はだれか。 主は高き所に座し、"
  },
  {
    "bookId": 19,
    "chapterId": 113,
    "verseId": 6,
    "text": "遠く天と地とを見おろされる。"
  },
  {
    "bookId": 19,
    "chapterId": 113,
    "verseId": 7,
    "text": "主は貧しい者をちりからあげ、 乏しい者をあくたからあげて、"
  },
  {
    "bookId": 19,
    "chapterId": 113,
    "verseId": 8,
    "text": "もろもろの君たちと共にすわらせ、 その民の君たちと共にすわらせられる。"
  },
  {
    "bookId": 19,
    "chapterId": 113,
    "verseId": 9,
    "text": "また子を産まぬ女に家庭を与え、 多くの子供たちの喜ばしい母とされる。 主をほめたたえよ。"
  }
]
