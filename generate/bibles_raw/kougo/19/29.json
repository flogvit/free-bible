[
  {
    "bookId": 19,
    "chapterId": 29,
    "verseId": 1,
    "text": "神の子らよ、主に帰せよ、 栄光と力とを主に帰せよ。"
  },
  {
    "bookId": 19,
    "chapterId": 29,
    "verseId": 2,
    "text": "み名の栄光を主に帰せよ、 聖なる装いをもって主を拝め。"
  },
  {
    "bookId": 19,
    "chapterId": 29,
    "verseId": 3,
    "text": "主のみ声は水の上にあり、 栄光の神は雷をとどろかせ、 主は大水の上におられる。"
  },
  {
    "bookId": 19,
    "chapterId": 29,
    "verseId": 4,
    "text": "主のみ声は力があり、 主のみ声は威厳がある。"
  },
  {
    "bookId": 19,
    "chapterId": 29,
    "verseId": 5,
    "text": "主のみ声は香柏を折り砕き、 主はレバノンの香柏を折り砕かれる。"
  },
  {
    "bookId": 19,
    "chapterId": 29,
    "verseId": 6,
    "text": "主はレバノンを子牛のように踊らせ、 シリオンを若い野牛のように踊らされる。"
  },
  {
    "bookId": 19,
    "chapterId": 29,
    "verseId": 7,
    "text": "主のみ声は炎をひらめかす。"
  },
  {
    "bookId": 19,
    "chapterId": 29,
    "verseId": 8,
    "text": "主のみ声は荒野を震わせ、 主はカデシの荒野を震わされる。"
  },
  {
    "bookId": 19,
    "chapterId": 29,
    "verseId": 9,
    "text": "主のみ声はかしの木を巻きあげ、また林を裸にする。 その宮で、すべてのものは呼ばわって言う、 「栄光」と。"
  },
  {
    "bookId": 19,
    "chapterId": 29,
    "verseId": 10,
    "text": "主は洪水の上に座し、 主はみくらに座して、とこしえに王であらせられる。"
  },
  {
    "bookId": 19,
    "chapterId": 29,
    "verseId": 11,
    "text": "主はその民に力を与え、 平安をもってその民を祝福されるであろう。"
  }
]
