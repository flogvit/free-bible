[
  {
    "bookId": 19,
    "chapterId": 121,
    "verseId": 1,
    "text": "わたしは山にむかって目をあげる。 わが助けは、どこから来るであろうか。"
  },
  {
    "bookId": 19,
    "chapterId": 121,
    "verseId": 2,
    "text": "わが助けは、天と地を造られた主から来る。"
  },
  {
    "bookId": 19,
    "chapterId": 121,
    "verseId": 3,
    "text": "主はあなたの足の動かされるのをゆるされない。 あなたを守る者はまどろむことがない。"
  },
  {
    "bookId": 19,
    "chapterId": 121,
    "verseId": 4,
    "text": "見よ、イスラエルを守る者は まどろむこともなく、眠ることもない。"
  },
  {
    "bookId": 19,
    "chapterId": 121,
    "verseId": 5,
    "text": "主はあなたを守る者、 主はあなたの右の手をおおう陰である。"
  },
  {
    "bookId": 19,
    "chapterId": 121,
    "verseId": 6,
    "text": "昼は太陽があなたを撃つことなく、 夜は月があなたを撃つことはない。"
  },
  {
    "bookId": 19,
    "chapterId": 121,
    "verseId": 7,
    "text": "主はあなたを守って、すべての災を免れさせ、 またあなたの命を守られる。"
  },
  {
    "bookId": 19,
    "chapterId": 121,
    "verseId": 8,
    "text": "主は今からとこしえに至るまで、 あなたの出ると入るとを守られるであろう。"
  }
]
