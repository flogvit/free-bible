[
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 1,
    "text": "アダムの系図は次のとおりである。神が人を創造された時、神をかたどって造り、"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 2,
    "text": "彼らを男と女とに創造された。彼らが創造された時、神は彼らを祝福して、その名をアダムと名づけられた。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 3,
    "text": "アダムは百三十歳になって、自分にかたどり、自分のかたちのような男の子を生み、その名をセツと名づけた。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 4,
    "text": "アダムがセツを生んで後、生きた年は八百年であって、ほかに男子と女子を生んだ。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 5,
    "text": "アダムの生きた年は合わせて九百三十歳であった。そして彼は死んだ。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 6,
    "text": "セツは百五歳になって、エノスを生んだ。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 7,
    "text": "セツはエノスを生んだ後、八百七年生きて、男子と女子を生んだ。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 8,
    "text": "セツの年は合わせて九百十二歳であった。そして彼は死んだ。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 9,
    "text": "エノスは九十歳になって、カイナンを生んだ。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 10,
    "text": "エノスはカイナンを生んだ後、八百十五年生きて、男子と女子を生んだ。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 11,
    "text": "エノスの年は合わせて九百五歳であった。そして彼は死んだ。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 12,
    "text": "カイナンは七十歳になって、マハラレルを生んだ。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 13,
    "text": "カイナンはマハラレルを生んだ後、八百四十年生きて、男子と女子を生んだ。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 14,
    "text": "カイナンの年は合わせて九百十歳であった。そして彼は死んだ。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 15,
    "text": "マハラレルは六十五歳になって、ヤレドを生んだ。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 16,
    "text": "マハラレルはヤレドを生んだ後、八百三十年生きて、男子と女子を生んだ。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 17,
    "text": "マハラレルの年は合わせて八百九十五歳であった。そして彼は死んだ。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 18,
    "text": "ヤレドは百六十二歳になって、エノクを生んだ。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 19,
    "text": "ヤレドはエノクを生んだ後、八百年生きて、男子と女子を生んだ。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 20,
    "text": "ヤレドの年は合わせて九百六十二歳であった。そして彼は死んだ。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 21,
    "text": "エノクは六十五歳になって、メトセラを生んだ。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 22,
    "text": "エノクはメトセラを生んだ後、三百年、神とともに歩み、男子と女子を生んだ。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 23,
    "text": "エノクの年は合わせて三百六十五歳であった。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 24,
    "text": "エノクは神とともに歩み、神が彼を取られたので、いなくなった。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 25,
    "text": "メトセラは百八十七歳になって、レメクを生んだ。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 26,
    "text": "メトセラはレメクを生んだ後、七百八十二年生きて、男子と女子を生んだ。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 27,
    "text": "メトセラの年は合わせて九百六十九歳であった。そして彼は死んだ。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 28,
    "text": "レメクは百八十二歳になって、男の子を生み、"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 29,
    "text": "「この子こそ、主が地をのろわれたため、骨折り働くわれわれを慰めるもの」と言って、その名をノアと名づけた。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 30,
    "text": "レメクはノアを生んだ後、五百九十五年生きて、男子と女子を生んだ。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 31,
    "text": "レメクの年は合わせて七百七十七歳であった。そして彼は死んだ。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 32,
    "text": "ノアは五百歳になって、セム、ハム、ヤペテを生んだ。"
  }
]
