[
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 1,
    "text": "柔かい答は憤りをとどめ、 激しい言葉は怒りをひきおこす。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 2,
    "text": "知恵ある者の舌は知識をわかち与え、 愚かな者の口は愚かを吐き出す。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 3,
    "text": "主の目はどこにでもあって、 悪人と善人とを見張っている。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 4,
    "text": "優しい舌は命の木である、 乱暴な言葉は魂を傷つける。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 5,
    "text": "愚かな者は父の教訓を軽んじる、 戒めを守る者は賢い者である。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 6,
    "text": "正しい者の家には多くの宝がある、 悪しき者の所得には煩いがある。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 7,
    "text": "知恵ある者のくちびるは知識をひろめる、 愚かな者の心はそうでない。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 8,
    "text": "悪しき者の供え物は主に憎まれ、 正しい者の祈は彼に喜ばれる。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 9,
    "text": "悪しき者の道は主に憎まれ、 正義を求める者は彼に愛せられる。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 10,
    "text": "道を捨てる者には、きびしい懲しめがあり、 戒めを憎む者は死に至る。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 11,
    "text": "陰府と滅びとは主の目の前にあり、 人の心はなおさらである。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 12,
    "text": "あざける者は戒められることを好まない、 また知恵ある者に近づかない。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 13,
    "text": "心に楽しみがあれば顔色も喜ばしい、 心に憂いがあれば気はふさぐ。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 14,
    "text": "さとき者の心は知識をたずね、 愚かな者の口は愚かさを食物とする。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 15,
    "text": "悩んでいる者の日々はことごとくつらく、 心の楽しい人は常に宴会をもつ。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 16,
    "text": "少しの物を所有して主を恐れるのは、 多くの宝をもって苦労するのにまさる。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 17,
    "text": "野菜を食べて互に愛するのは、 肥えた牛を食べて互に憎むのにまさる。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 18,
    "text": "憤りやすい者は争いをおこし、 怒りをおそくする者は争いをとどめる。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 19,
    "text": "なまけ者の道には、いばらがはえしげり、 正しい者の道は平らかである。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 20,
    "text": "知恵ある子は父を喜ばせる、 愚かな人はその母を軽んじる。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 21,
    "text": "無知な者は愚かなことを喜び、 さとき者はまっすぐに歩む。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 22,
    "text": "相はかることがなければ、計画は破れる、 はかる者が多ければ、それは必ず成る。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 23,
    "text": "人は口から出る好ましい答によって喜びを得る、 時にかなった言葉は、いかにも良いものだ。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 24,
    "text": "知恵ある人の道は上って命に至る、 こうしてその人は下にある陰府を離れる。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 25,
    "text": "主は高ぶる者の家を滅ぼし、 やもめの地境を定められる。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 26,
    "text": "悪人の計りごとは主に憎まれ、 潔白な人の言葉は彼に喜ばれる。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 27,
    "text": "不正な利をむさぼる者はその家を煩らわせる、 まいないを憎む者は生きながらえる。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 28,
    "text": "正しい者の心は答えるべきことを考える、 悪しき者の口は悪を吐き出す。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 29,
    "text": "主は悪しき者に遠ざかり、正しい者の祈を聞かれる。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 30,
    "text": "目の光は心を喜ばせ、 よい知らせは骨を潤す。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 31,
    "text": "ためになる戒めを聞く耳をもつ者は、 知恵ある者の中にとどまる。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 32,
    "text": "教訓を捨てる者はおのれの命を軽んじ、 戒めを重んじる者は悟りを得る。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 33,
    "text": "主を恐れることは知恵の教訓である、 謙遜は、栄誉に先だつ。"
  }
]
