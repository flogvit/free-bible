[
  {
    "bookId": 18,
    "chapterId": 25,
    "verseId": 1,
    "text": "そこでシュヒびとビルダデは答えて言った、"
  },
  {
    "bookId": 18,
    "chapterId": 25,
    "verseId": 2,
    "text": "「大権と恐れとは神と共にある。 彼は高き所で平和を施される。"
  },
  {
    "bookId": 18,
    "chapterId": 25,
    "verseId": 3,
    "text": "その軍勢は数えることができるか。 何物かその光に浴さないものがあるか。"
  },
  {
    "bookId": 18,
    "chapterId": 25,
    "verseId": 4,
    "text": "それで人はどうして神の前に正しくありえようか。 女から生れた者がどうして清くありえようか。"
  },
  {
    "bookId": 18,
    "chapterId": 25,
    "verseId": 5,
    "text": "見よ、月さえも輝かず、 星も彼の目には清くない。"
  },
  {
    "bookId": 18,
    "chapterId": 25,
    "verseId": 6,
    "text": "うじのような人、 虫のような人の子はなおさらである」。"
  }
]
