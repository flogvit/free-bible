[
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 1,
    "text": "ベニヤミンの生んだ者は長子はベラ、その次はアシベル、第三はアハラ、"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 2,
    "text": "第四はノハ、第五はラパ。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 3,
    "text": "ベラの子らはアダル、ゲラ、アビウデ、"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 4,
    "text": "アビシュア、ナアマン、アホア、"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 5,
    "text": "ゲラ、シフパム、ヒラム。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 6,
    "text": "エホデの子らは次のとおりである。（これらはゲバの住民の氏族の長であって、マナハテに捕え移されたものである。）"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 7,
    "text": "すなわちナアマン、アヒヤ、ゲラすなわちヘグラム。ゲラはウザとアヒフデの父であった。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 8,
    "text": "シャハライムは妻ホシムとバアラを離別してのち、モアブの国で子らをもうけた。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 9,
    "text": "彼が妻ホデシによってもうけた子らはヨバブ、ヂビア、メシャ、マルカム、"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 10,
    "text": "エウヅ、シャキヤ、ミルマ。これらはその子らであって氏族の長である。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 11,
    "text": "彼はまたホシムによってアビトブとエルパアルをもうけた。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 12,
    "text": "エルパアルの子らはエベル、ミシャムおよびセメド。彼はオノとロドとその村々を建てた者である。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 13,
    "text": "またベリアとシマがあった。（これはアヤロンの住民の氏族の長であって、ガテの住民を追い払ったものである。）"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 14,
    "text": "またアヒオ、シャシャク、エレモテ。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 15,
    "text": "ゼバデヤ、アラデ、アデル、"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 16,
    "text": "ミカエル、イシパおよびヨハはベリアの子らであった。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 17,
    "text": "ゼバデヤ、メシュラム、ヘゼキ、ヘベル、"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 18,
    "text": "イシメライ、エズリアおよびヨバブはエルパアルの子らであった。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 19,
    "text": "ヤキン、ジクリ、ザベデ、"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 20,
    "text": "エリエナイ、チルタイ、エリエル、"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 21,
    "text": "アダヤ、ベラヤおよびシムラテはシマの子らであった。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 22,
    "text": "イシパン、ヘベル、エリエル、"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 23,
    "text": "アブドン、ジクリ、ハナン、"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 24,
    "text": "ハナニヤ、エラム、アントテヤ、"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 25,
    "text": "イペデヤおよびペヌエルはシャシャクの子らであった。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 26,
    "text": "シャムセライ、シハリア、アタリヤ、"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 27,
    "text": "ヤレシャ、エリヤおよびジクリはエロハムの子らであった。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 28,
    "text": "これらは歴代の氏族の長であり、またかしらであって、エルサレムに住んだ。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 29,
    "text": "ギベオンの父エイエルはギベオンに住み、その妻の名はマアカといった。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 30,
    "text": "その長子はアブドンで、次はツル、キシ、バアル、ナダブ、"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 31,
    "text": "ゲドル、アヒオ、ザケル、"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 32,
    "text": "およびミクロテ。ミクロテはシメアを生んだ。これらもまた兄弟たちと向かいあってエルサレムに住んだ。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 33,
    "text": "ネルはキシを生み、キシはサウルを生み、サウルはヨナタン、マルキシュア、アビナダブ、エシバアルを生んだ。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 34,
    "text": "ヨナタンの子はメリバアルで、メリバアルはミカエルを生んだ。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 35,
    "text": "ミカの子らはピトン、メレク、タレア、アハズである。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 36,
    "text": "アハズはエホアダを生み、エホアダはアレメテ、アズマウテ、ジムリを生み、ジムリはモザを生み、"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 37,
    "text": "モザはビネアを生んだ。ビネアの子はラパ、ラパの子はエレアサ、エレアサの子はアゼルである。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 38,
    "text": "アゼルには六人の子があり、その名はアズリカム、ボケル、イシマエル、シャリヤ、オバデヤ、ハナンで、皆アゼルの子である。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 39,
    "text": "その兄弟エセクの子らは、長子はウラム、次はエウシ、第三はエリペレテである。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 40,
    "text": "ウラムの子らは大勇士で、よく弓を射る者であった。彼は多くの子と孫をもち、百五十人もあった。これらは皆ベニヤミンの子孫である。"
  }
]
