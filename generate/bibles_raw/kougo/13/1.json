[
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 1,
    "text": "¶ アダム、セツ、エノス、"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 2,
    "text": "ケナン、マハラレル、ヤレド、"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 3,
    "text": "エノク、メトセラ、ラメク、"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 4,
    "text": "ノア、セム、ハム、ヤペテ。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 5,
    "text": "ヤペテの子らはゴメル、マゴグ、マダイ、ヤワン、トバル、メセク、テラス。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 6,
    "text": "ゴメルの子らはアシケナズ、デパテ、トガルマ。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 7,
    "text": "ヤワンの子らはエリシャ、タルシシ、キッテム、ロダニム。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 8,
    "text": "ハムの子らはクシ、エジプト、プテ、カナン。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 9,
    "text": "クシの子らはセバ、ハビラ、サブタ、ラアマ、サブテカ。ラアマの子らはシバとデダン。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 10,
    "text": "クシはニムロデを生んだ。ニムロデは初めて世の権力ある者となった。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 11,
    "text": "エジプトはルデびと、アナムびと、レハブびと、ナフトびと、"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 12,
    "text": "パテロスびと、カスルびと、カフトルびとを生んだ。カフトルびとからペリシテびとが出た。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 13,
    "text": "カナンは長子シドンとヘテを生んだ。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 14,
    "text": "またエブスびと、アモリびと、ギルガシびと、"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 15,
    "text": "ヒビびと、アルキびと、セニびと、"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 16,
    "text": "アルワデびと、ゼマリびと、ハマテびとを生んだ。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 17,
    "text": "セムの子らはエラム、アシュル、アルパクサデ、ルデ、アラム、ウズ、ホル、ゲテル、メセクである。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 18,
    "text": "アルパクサデはシラを生み、シラはエベルを生んだ。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 19,
    "text": "エベルにふたりの子が生れた。ひとりの名はペレグ――彼の代に地の民が散り分れたからである――その弟の名はヨクタンといった。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 20,
    "text": "ヨクタンはアルモダデ、シャレフ、ハザル・マウテ、エラ、"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 21,
    "text": "ハドラム、ウザル、デクラ、"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 22,
    "text": "エバル、アビマエル、シバ、"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 23,
    "text": "オフル、ハビラ、ヨバブを生んだ。これらはみなヨクタンの子である。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 24,
    "text": "セム、アルパクサデ、シラ、"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 25,
    "text": "エベル、ペレグ、リウ、"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 26,
    "text": "セルグ、ナホル、テラ、"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 27,
    "text": "アブラムすなわちアブラハムである。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 28,
    "text": "アブラハムの子らはイサクとイシマエルである。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 29,
    "text": "彼らの子孫は次のとおりである。イシマエルの長子はネバヨテ、次はケダル、アデビエル、ミブサム、"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 30,
    "text": "ミシマ、ドマ、マッサ、ハダデ、テマ、"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 31,
    "text": "エトル、ネフシ、ケデマ。これらはイシマエルの子孫である。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 32,
    "text": "アブラハムのそばめケトラの子孫は次のとおりである。彼女はジムラン、ヨクシャン、メダン、ミデアン、イシバク、シュワを産んだ。ヨクシャンの子らはシバとデダンである。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 33,
    "text": "ミデアンの子らはエパ、エペル、ヘノク、アビダ、エルダア。これらはみなケトラの子孫である。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 34,
    "text": "アブラハムはイサクを生んだ。イサクの子らはエサウとイスラエル。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 35,
    "text": "エサウの子らはエリパズ、リウエル、エウシ、ヤラム、コラ。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 36,
    "text": "エリパズの子らはテマン、オマル、ゼピ、ガタム、ケナズ、テムナ、アマレク。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 37,
    "text": "リウエルの子らはナハテ、ゼラ、シャンマ、ミッザ。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 38,
    "text": "セイルの子らはロタン、ショバル、ヂベオン、アナ、デション、エゼル、デシャン。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 39,
    "text": "ロタンの子らはホリとホマム。ロタンの妹はテムナ。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 40,
    "text": "ショバルの子らはアルヤン、マナハテ、エバル、シピ、オナム。ヂベオンの子らはアヤとアナ。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 41,
    "text": "アナの子はデション。デションの子らはハムラン、エシバン、イテラン、ケラン。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 42,
    "text": "エゼルの子らはビルハン、ザワン、ヤカン。デシャンの子らはウズとアラン。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 43,
    "text": "イスラエルの人々を治める王がまだなかった時、エドムの地を治めた王たちは次のとおりである。ベオルの子ベラ。その都の名はデナバといった。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 44,
    "text": "ベラが死んで、ボズラのゼラの子ヨバブが代って王となった。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 45,
    "text": "ヨバブが死んで、テマンびとの地のホシャムが代って王となった。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 46,
    "text": "ホシャムが死んで、ベダテの子ハダデが代って王となった。彼はモアブの野でミデアンを撃った。彼の都の名はアビテといった。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 47,
    "text": "ハダデが死んで、マスレカのサムラが代って王となった。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 48,
    "text": "サムラが死んで、ユフラテ川のほとりのレホボテのサウルが代って王となった。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 49,
    "text": "サウルが死んで、アクボルの子バアル・ハナンが代って王となった。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 50,
    "text": "バアル・ハナンが死んで、ハダデが代って王となった。彼の都の名はパイといった。彼の妻はマテレデの娘であって、名をメヘタベルといった。マテレデはメザハブの娘である。"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 51,
    "text": "ハダデも死んだ。 エドムの族長は、テムナ侯、アルヤ侯、エテテ侯、"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 52,
    "text": "アホリバマ侯、エラ侯、ピノン侯、"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 53,
    "text": "ケナズ侯、テマン侯、ミブザル侯、"
  },
  {
    "bookId": 13,
    "chapterId": 1,
    "verseId": 54,
    "text": "マグデエル侯、イラム侯。これらはエドムの族長である。"
  }
]
