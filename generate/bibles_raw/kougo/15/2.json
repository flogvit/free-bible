[
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 1,
    "text": "バビロンの王ネブカデネザルに捕えられて、バビロンに移された者のうち、捕囚をゆるされてエルサレムおよびユダに上って、おのおの自分の町に帰ったこの州の人々は次のとおりである。"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 2,
    "text": "彼らはゼルバベル、エシュア、ネヘミヤ、セラヤ、レエラヤ、モルデカイ、ビルシャン、ミスパル、ビグワイ、レホム、バアナと共に帰ってきた。 そのイスラエルの民の人数は次のとおりである。"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 3,
    "text": "パロシの子孫は二千百七十二人、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 4,
    "text": "シパテヤの子孫は三百七十二人、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 5,
    "text": "アラの子孫は七百七十五人、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 6,
    "text": "パハテ・モアブの子孫すなわちエシュアとヨアブの子孫は二千八百十二人、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 7,
    "text": "エラムの子孫は一千二百五十四人、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 8,
    "text": "ザットの子孫は九百四十五人、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 9,
    "text": "ザッカイの子孫は七百六十人、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 10,
    "text": "バニの子孫は六百四十二人、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 11,
    "text": "ベバイの子孫は六百二十三人、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 12,
    "text": "アズガデの子孫は一千二百二十二人、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 13,
    "text": "アドニカムの子孫は六百六十六人、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 14,
    "text": "ビグワイの子孫は二千五十六人、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 15,
    "text": "アデンの子孫は四百五十四人、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 16,
    "text": "アテルの子孫すなわちヒゼキヤの子孫は九十八人、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 17,
    "text": "ベザイの子孫は三百二十三人、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 18,
    "text": "ヨラの子孫は百十二人、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
