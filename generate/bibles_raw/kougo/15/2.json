  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 25,
    "text": "キリアテ・ヤリム、ケピラおよびベエロテの子孫は七百四十三人、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 26,
    "text": "ラマおよびゲバの子孫は六百二十一人、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 27,
    "text": "ミクマシの人々は百二十二人、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 28,
    "text": "ベテルおよびアイの人々は二百二十三人、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 29,
    "text": "ネボの子孫は五十二人、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 30,
    "text": "マグビシの子孫は百五十六人、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 31,
    "text": "他のエラムの子孫は一千二百五十四人、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 32,
    "text": "ハリムの子孫は三百二十人、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 33,
    "text": "ロド、ハデデおよびオノの子孫は七百二十五人、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 34,
    "text": "エリコの子孫は三百四十五人、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 35,
    "text": "セナアの子孫は三千六百三十人。"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 36,
    "text": "祭司は、エシュアの家のエダヤの子孫九百七十三人、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 37,
    "text": "インメルの子孫一千五十二人、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 38,
    "text": "パシュルの子孫一千二百四十七人、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 39,
    "text": "ハリムの子孫一千十七人。"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 40,
    "text": "レビびとは、ホダヤの子孫すなわちエシュアとカデミエルの子孫七十四人。"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 41,
    "text": "歌うたう者は、アサフの子孫百二十八人。"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 42,
    "text": "門衛の子孫は、シャルムの子孫、アテルの子孫、タルモンの子孫、アックブの子孫、ハテタの子孫、ショバイの子孫合わせて百三十九人。"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 43,
    "text": "宮に仕えるしもべたちは、ヂハの子孫、ハスパの子孫、タバオテの子孫、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 44,
    "text": "ケロスの子孫、シアハの子孫、パドンの子孫、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 45,
    "text": "レバナの子孫、ハガバの子孫、アックブの子孫、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 46,
    "text": "ハガブの子孫、シャルマイの子孫、ハナンの子孫、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 47,
    "text": "ギデルの子孫、ガハルの子孫、レアヤの子孫、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 48,
    "text": "レヂンの子孫、ネコダの子孫、ガザムの子孫、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 49,
    "text": "ウザの子孫、パセアの子孫、ベサイの子孫、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 50,
    "text": "アスナの子孫、メウニムの子孫、ネフシムの子孫、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 51,
    "text": "バクブクの子孫、ハクパの子孫、ハルホルの子孫、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 52,
    "text": "バヅリテの子孫、メヒダの子孫、ハルシャの子孫、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 53,
    "text": "バルコスの子孫、シセラの子孫、テマの子孫、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 54,
    "text": "ネヂアの子孫、ハテパの子孫である。"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 55,
    "text": "ソロモンのしもべたちの子孫は、ソタイの子孫、ハッソペレテの子孫、ペリダの子孫、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 56,
    "text": "ヤアラの子孫、ダルコンの子孫、ギデルの子孫、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 57,
    "text": "シパテヤの子孫、ハッテルの子孫、ポケレテ・ハッゼバイムの子孫、アミの子孫。"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 58,
    "text": "宮に仕えるしもべたちとソロモンのしもべたちの子孫とは合わせて三百九十二人。"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 59,
    "text": "次にあげる人々はテル・メラ、テル・ハレサ、ケルブ、アダンおよびインメルから上って来た者であったが、彼らはその氏族とその血統とを示して、そのイスラエルの者であることを明らかにすることができなかった。"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 60,
    "text": "すなわちデラヤの子孫、トビヤの子孫、ネコダの子孫で合わせて六百五十二人。"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 61,
    "text": "祭司の子孫のうちにはハバヤの子孫、ハッコヅの子孫、バルジライの子孫があった。バルジライはギレアデびとバルジライの娘たちのうちから妻をめとったので、その名で呼ばれることになった。"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 62,
    "text": "これらの者は系譜に載った者たちのうちに自分の名を尋ねたが見いだされなかったので、汚れた者として、祭司の職から除かれた。"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 63,
    "text": "総督は彼らに告げて、ウリムとトンミムを身につける祭司の興るまでは、いと聖なる物を食べてはならないと言った。"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 64,
    "text": "会衆は合わせて四万二千三百六十人であった。"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 65,
    "text": "このほかに、しもべおよびはしため合わせて七千三百三十七人、また歌うたう男女二百人あった。"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 66,
    "text": "その馬は七百三十六頭、その騾馬は二百四十五頭、"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 67,
    "text": "そのらくだは四百三十五頭、そのろばは六千七百二十頭あった。"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 68,
    "text": "氏族の長数人はエルサレムにある主の宮の所にきた時、神の宮をもとの所に建てるために真心よりの供え物をささげた。"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 69,
    "text": "すなわち、その力に従って工事のために倉に納めたものは、金六万一千ダリク、銀五千ミナ、祭司の衣服百かさねであった。"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 70,
    "text": "祭司、レビびと、および民のある者はエルサレムおよびその近郊に住み、歌うたう者、門衛および宮に仕えるしもべたちはその町々に住み、一般のイスラエルびとは自分たちの町々に住んだ。"
  }
]
