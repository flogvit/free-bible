[
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 1,
    "text": "耶和華曉諭摩西說："
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 2,
    "text": "你吩咐以色列人說：「你們到了迦南地，（就是歸你們為業的迦南四境之地；）"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 3,
    "text": "南角要從尋的曠野，貼著以東的邊界；南界要從鹽海東頭起，"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 4,
    "text": "繞到亞克拉濱坡的南邊，接連到尋，直通到加低斯‧巴尼亞的南邊，又通到哈薩‧亞達，接連到押們，"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 5,
    "text": "從押們轉到埃及小河，直通到海為止。"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 6,
    "text": "「西邊要以大海為界；這就是你們的西界。"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 7,
    "text": "「北界要從大海起，畫到何珥山，"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 8,
    "text": "從何珥山劃到哈馬口，通到西達達，"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 9,
    "text": "又通到西斐崙，直到哈薩‧以難。這要作你們的北界。"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 10,
    "text": "「你們要從哈薩‧以難劃到示番為東界。"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 11,
    "text": "這界要從示番下到亞延東邊的利比拉，又要達到基尼烈湖的東邊。"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 12,
    "text": "這界要下到約旦河，通到鹽海為止。這四圍的邊界以內，要作你們的地。」"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 13,
    "text": "摩西吩咐以色列人說：「這地就是　耶和華吩咐你們按籤給九個半支派承受為業的；"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 14,
    "text": "因為呂便支派和迦得支派按著父家受了產業，瑪拿西半個支派也受了產業。"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 15,
    "text": "這兩個半支派已經在靠近耶利哥、約旦河東、向日出之地受了產業。」"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 16,
    "text": "耶和華曉諭摩西說："
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 17,
    "text": "「要給你們分地為業之人的名字是祭司以利亞撒和嫩的兒子約書亞。"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 18,
    "text": "又要從每支派中選一個首領幫助他們。"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 19,
    "text": "這些人的名字：猶大支派有耶孚尼的兒子迦勒。"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 20,
    "text": "西緬支派有亞米忽的兒子示母利。"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 21,
    "text": "便雅憫支派有基斯倫的兒子以利達。"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 22,
    "text": "但支派的首領是約利的兒子布基。"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 23,
    "text": "約瑟的子孫瑪拿西支派的首領是以弗的兒子漢聶。"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 24,
    "text": "以法蓮支派的首領是拾弗但的兒子基母利。"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 25,
    "text": "西布倫支派的首領是帕納的兒子以利撒番。"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 26,
    "text": "以薩迦支派的首領是阿散的兒子帕鐵。"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 27,
    "text": "亞設支派的首領是示羅米的兒子亞希忽。"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 28,
    "text": "拿弗他利支派的首領是亞米忽的兒子比大黑。」"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 29,
    "text": "這些人就是　耶和華所吩咐、在迦南地把產業分給以色列人的。"
  }
]
