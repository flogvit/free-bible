[
  {
    "bookId": 19,
    "chapterId": 33,
    "verseId": 1,
    "text": "義人哪，你們應當靠　耶和華歡樂；正直人的讚美是合宜的。"
  },
  {
    "bookId": 19,
    "chapterId": 33,
    "verseId": 2,
    "text": "你們應當彈琴歌頌　耶和華，用瑟並十弦的樂器歌頌他。"
  },
  {
    "bookId": 19,
    "chapterId": 33,
    "verseId": 3,
    "text": "應當向他唱新歌，彈得巧妙，聲音洪亮。"
  },
  {
    "bookId": 19,
    "chapterId": 33,
    "verseId": 4,
    "text": "因為　耶和華的言語正確；凡他所作的盡都誠實。"
  },
  {
    "bookId": 19,
    "chapterId": 33,
    "verseId": 5,
    "text": "他喜愛仁義公平；遍地滿了　耶和華的慈愛。"
  },
  {
    "bookId": 19,
    "chapterId": 33,
    "verseId": 6,
    "text": "諸天藉　耶和華的話而造；萬象藉他口中的氣而成。"
  },
  {
    "bookId": 19,
    "chapterId": 33,
    "verseId": 7,
    "text": "他聚集海水如壘，收藏深洋在庫房。"
  },
  {
    "bookId": 19,
    "chapterId": 33,
    "verseId": 8,
    "text": "願全地都敬畏　耶和華！願世上的居民都懼怕他！"
  },
  {
    "bookId": 19,
    "chapterId": 33,
    "verseId": 9,
    "text": "因為他說有，就有，命立，就立。"
  },
  {
    "bookId": 19,
    "chapterId": 33,
    "verseId": 10,
    "text": "耶和華使異教之民的籌算歸於無有，使眾民的計謀無有功效。"
  },
  {
    "bookId": 19,
    "chapterId": 33,
    "verseId": 11,
    "text": "耶和華的籌算永遠立定；他心中的思念萬代常存。"
  },
  {
    "bookId": 19,
    "chapterId": 33,
    "verseId": 12,
    "text": "以　耶和華為　上帝的，那國是有福的！他所揀選為自己產業的，那民是有福的！"
  },
  {
    "bookId": 19,
    "chapterId": 33,
    "verseId": 13,
    "text": "耶和華從天上觀看；他看見一切的世人。"
  },
  {
    "bookId": 19,
    "chapterId": 33,
    "verseId": 14,
    "text": "從他的居所往外察看地上一切的居民─"
  },
  {
    "bookId": 19,
    "chapterId": 33,
    "verseId": 15,
    "text": "他是那造成他們眾人心的，留意他們一切作為的。"
  },
  {
    "bookId": 19,
    "chapterId": 33,
    "verseId": 16,
    "text": "沒有君王因兵多存留；勇士並不因力大得救。"
  },
  {
    "bookId": 19,
    "chapterId": 33,
    "verseId": 17,
    "text": "靠馬穩妥是枉然的；牠也不能因力大救人。"
  },
  {
    "bookId": 19,
    "chapterId": 33,
    "verseId": 18,
    "text": "看哪，　耶和華的眼目看顧敬畏他的人和仰望他慈愛的人，"
  },
  {
    "bookId": 19,
    "chapterId": 33,
    "verseId": 19,
    "text": "要救他們的命脫離死亡，並使他們在饑荒中存活。"
  },
  {
    "bookId": 19,
    "chapterId": 33,
    "verseId": 20,
    "text": "我們的心向來等候　耶和華；他是我們的幫助，我們的盾牌。"
  },
  {
    "bookId": 19,
    "chapterId": 33,
    "verseId": 21,
    "text": "我們的心必靠他歡喜，因為我們向來倚靠他的聖名。"
  },
  {
    "bookId": 19,
    "chapterId": 33,
    "verseId": 22,
    "text": "耶和華啊，求你照著我們所仰望你的，向我們施行慈愛！"
  }
]
