[
  {
    "bookId": 19,
    "chapterId": 20,
    "verseId": 1,
    "text": "（大衛的詩，交與伶長。）願　耶和華在你遭難的日子聽允你；願名為雅各　上帝的保護你。"
  },
  {
    "bookId": 19,
    "chapterId": 20,
    "verseId": 2,
    "text": "願他從聖所救助你，從錫安堅固你，"
  },
  {
    "bookId": 19,
    "chapterId": 20,
    "verseId": 3,
    "text": "記念你的一切供獻，悅納你的燔祭，細拉。"
  },
  {
    "bookId": 19,
    "chapterId": 20,
    "verseId": 4,
    "text": "將你心所願的賜給你，成就你的一切籌算。"
  },
  {
    "bookId": 19,
    "chapterId": 20,
    "verseId": 5,
    "text": "我們要因你的救恩歡樂，要奉我們　上帝的名豎立旌旗。願　耶和華成就你一切所求的！"
  },
  {
    "bookId": 19,
    "chapterId": 20,
    "verseId": 6,
    "text": "現在我知道　耶和華救護他的受膏者，必從他的聖天上聽允他，用右手的能力救護他。"
  },
  {
    "bookId": 19,
    "chapterId": 20,
    "verseId": 7,
    "text": "有人靠車，有人靠馬，但我們要記念　耶和華─我們　上帝的名。"
  },
  {
    "bookId": 19,
    "chapterId": 20,
    "verseId": 8,
    "text": "他們都屈身仆倒，我們卻起來，立得正直。"
  },
  {
    "bookId": 19,
    "chapterId": 20,
    "verseId": 9,
    "text": "求　耶和華施行拯救；我們呼求的時候，願王聽允我們。"
  }
]
