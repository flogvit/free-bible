[
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 1,
    "text": "你們要稱謝　耶和華啊，因他本為善；他的慈愛永遠長存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 2,
    "text": "你們要稱謝眾神之　上帝啊，因他的慈愛永遠長存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 3,
    "text": "你們要稱謝眾主之　主啊，因他的慈愛永遠長存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 4,
    "text": "稱謝那獨行大奇事的，因他的慈愛永遠長存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 5,
    "text": "稱謝那用智慧創造諸天的，因他的慈愛永遠長存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 6,
    "text": "稱謝那鋪地在水以上的，因他的慈愛永遠長存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 7,
    "text": "稱謝那造成大光的，因他的慈愛永遠長存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 8,
    "text": "他造日頭管白晝，因他的慈愛永遠長存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 9,
    "text": "他造月亮星宿管黑夜，因他的慈愛永遠長存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 10,
    "text": "稱謝那擊殺埃及人之長子的，因他的慈愛永遠長存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 11,
    "text": "他領以色列人從他們中間出來，因他的慈愛永遠長存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 12,
    "text": "他施展大能的手和伸出來的膀臂，因他的慈愛永遠長存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 13,
    "text": "稱謝那分裂紅海的，因他的慈愛永遠長存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 14,
    "text": "他領以色列從其中經過，因他的慈愛永遠長存；"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 15,
    "text": "卻把法老和他的軍兵推翻在紅海裏，因他的慈愛永遠長存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 16,
    "text": "稱謝那引導自己的民行走曠野的，因他的慈愛永遠長存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 17,
    "text": "稱謝那擊殺大君王的，因他的慈愛永遠長存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 18,
    "text": "他殺戮有名的君王，因他的慈愛永遠長存；"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 19,
    "text": "就是殺戮亞摩利王西宏，因他的慈愛永遠長存；"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 20,
    "text": "又殺巴珊王噩，因他的慈愛永遠長存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 21,
    "text": "他將他們的地賜他的百姓為業，因他的慈愛永遠長存；"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 22,
    "text": "就是賜他的僕人以色列為業，因他的慈愛永遠長存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 23,
    "text": "他顧念我們在卑微的地步，因他的慈愛永遠長存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 24,
    "text": "他救拔我們脫離敵人，因他的慈愛永遠長存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 25,
    "text": "他賜糧食給凡有血氣的，因他的慈愛永遠長存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 26,
    "text": "你們要稱謝天上的　上帝啊，因他的慈愛永遠長存。"
  }
]
