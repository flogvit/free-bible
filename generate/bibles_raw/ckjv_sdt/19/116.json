[
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 1,
    "text": "我愛　耶和華，因為他聽了我的聲音和我的懇求。"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 2,
    "text": "他既向我側耳，我一生要求告他。"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 3,
    "text": "死亡的愁苦纏繞我，地獄的痛苦抓住我，我遭遇患難愁苦。"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 4,
    "text": "那時，我便求告　耶和華的名，說：　耶和華啊，求你救我的元魂！"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 5,
    "text": "耶和華有恩惠，有公義；我們的　上帝以憐憫為懷。"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 6,
    "text": "耶和華保護愚人；我落到卑微的地步，他救了我。"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 7,
    "text": "我的心哪！你要仍歸安樂，因為　耶和華用厚恩待你。"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 8,
    "text": "主啊，你救我的命免了死亡，救我的眼免了流淚，救我的腳免了跌倒。"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 9,
    "text": "我要在　耶和華面前行活人之路。"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 10,
    "text": "我因信，所以如此說話；我受了極大的困苦。"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 11,
    "text": "我曾急促地說：人都是說謊的！"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 12,
    "text": "我拿甚麼報答　耶和華向我所賜的一切厚恩？"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 13,
    "text": "我要舉起救恩的杯，稱揚　耶和華的名。"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 14,
    "text": "我要在他眾民面前向　耶和華還我的願。"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 15,
    "text": "在　耶和華眼中，看聖民之死極為寶貴。"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 16,
    "text": "耶和華啊，我真是你的僕人；我是你的僕人，是你婢女的兒子。你已經解開我的綁索。"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 17,
    "text": "我要以感謝為祭獻給你，又要求告　耶和華的名。"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 18,
    "text": "我要在他眾民面前，向　耶和華還我的願；"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 19,
    "text": "在　耶和華殿的院內，在耶路撒冷當中啊！你們要讚美　耶和華！"
  }
]
