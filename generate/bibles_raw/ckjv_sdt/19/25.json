[
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 1,
    "text": "（大衛的詩。）　耶和華啊，我的心仰望你。"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 2,
    "text": "我的　上帝啊，我素來倚靠你；求你不要叫我羞愧，不要叫我的仇敵向我誇勝。"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 3,
    "text": "凡等候你的必不羞愧；唯有那無故行奸詐的必要羞愧。"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 4,
    "text": "耶和華啊，求你將你的道指示我，將你的路教訓我！"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 5,
    "text": "求你以你的真理引導我，教訓我，因為你是救我的　上帝。我終日等候你。"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 6,
    "text": "耶和華啊，求你記念你的憐憫和慈愛，因為這是亙古以來所常有的。"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 7,
    "text": "求你不要記念我幼年的罪愆和我的過犯；　耶和華啊，求你因你的恩惠，按你的慈愛記念我。"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 8,
    "text": "耶和華是良善正直的，所以他必指教罪人走正路。"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 9,
    "text": "他必按公平引領謙卑人，將他的道教訓他們。"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 10,
    "text": "凡遵守他的約和他法度的人，　耶和華都以慈愛誠實待他。"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 11,
    "text": "耶和華啊，求你因你的名赦免我的罪，因為我的罪重大。"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 12,
    "text": "誰敬畏　耶和華，　耶和華必指教他當選擇的道路。"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 13,
    "text": "他必安然居住；他的後裔必承受地土。"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 14,
    "text": "耶和華的奧秘與敬畏他的人同在；他必將自己的約指示他們。"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 15,
    "text": "我的眼目時常仰望　耶和華，因為他必將我的腳從網裏拉出來。"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 16,
    "text": "求你轉向我，憐恤我，因為我是孤獨困苦。"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 17,
    "text": "我心裏的愁苦甚多，求你救我脫離我的禍患啊。"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 18,
    "text": "求你看顧我的困苦，我的艱難，饒恕我一切的罪。"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 19,
    "text": "求你察看我的仇敵，因為他們人多，並且痛痛地恨我。"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 20,
    "text": "求你保護我的性命，搭救我，使我不致羞愧，因為我投靠你啊。"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 21,
    "text": "願純全、正直保守我，因為我等候你。"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 22,
    "text": "上帝啊，求你救贖以色列脫離他一切的愁苦。"
  }
]
