[
  {
    "bookId": 19,
    "chapterId": 41,
    "verseId": 1,
    "text": "（大衛的詩，交與伶長。）眷顧貧窮的有福了！他遭難的日子，　耶和華必搭救他。"
  },
  {
    "bookId": 19,
    "chapterId": 41,
    "verseId": 2,
    "text": "耶和華必保全他，使他存活；他必在地上享福。你也不把他交給仇敵，遂其所願。"
  },
  {
    "bookId": 19,
    "chapterId": 41,
    "verseId": 3,
    "text": "他病重在榻，　耶和華必堅固他；他在病中，你必給他鋪床。"
  },
  {
    "bookId": 19,
    "chapterId": 41,
    "verseId": 4,
    "text": "我曾說：　耶和華啊，求你憐恤我，醫治我！因為我得罪了你。"
  },
  {
    "bookId": 19,
    "chapterId": 41,
    "verseId": 5,
    "text": "我的仇敵用惡言議論我說：他幾時死，他的名才滅亡呢？"
  },
  {
    "bookId": 19,
    "chapterId": 41,
    "verseId": 6,
    "text": "他來看我就說假話；他心存奸惡，走到外邊才說出來。"
  },
  {
    "bookId": 19,
    "chapterId": 41,
    "verseId": 7,
    "text": "一切恨我的，都交頭接耳地議論我；他們設計要害我。"
  },
  {
    "bookId": 19,
    "chapterId": 41,
    "verseId": 8,
    "text": "他們說：有怪病貼在他身上；他已躺臥，必不能再起來。"
  },
  {
    "bookId": 19,
    "chapterId": 41,
    "verseId": 9,
    "text": "連我知己的朋友，我所倚靠、吃過我飯的也用腳踢我。"
  },
  {
    "bookId": 19,
    "chapterId": 41,
    "verseId": 10,
    "text": "至於你─　耶和華啊，求你憐恤我，使我起來，好報復他們！"
  },
  {
    "bookId": 19,
    "chapterId": 41,
    "verseId": 11,
    "text": "因我的仇敵不得向我誇勝，我從此便知道你喜愛我。"
  },
  {
    "bookId": 19,
    "chapterId": 41,
    "verseId": 12,
    "text": "至於我，你因我純正就扶持我，使我永遠站在你的面前。"
  },
  {
    "bookId": 19,
    "chapterId": 41,
    "verseId": 13,
    "text": "耶和華─以色列的　上帝是應當稱頌的，從恆古直到永遠。阿們。阿們。"
  }
]
