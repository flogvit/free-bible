[
  {
    "bookId": 19,
    "chapterId": 130,
    "verseId": 1,
    "text": "（上行之詩。）　耶和華啊，我從深處向你求告！"
  },
  {
    "bookId": 19,
    "chapterId": 130,
    "verseId": 2,
    "text": "主啊，求你聽我的聲音！願你側耳聽我懇求的聲音！"
  },
  {
    "bookId": 19,
    "chapterId": 130,
    "verseId": 3,
    "text": "主─　耶和華啊，你若究察罪孽，誰能站得住呢？"
  },
  {
    "bookId": 19,
    "chapterId": 130,
    "verseId": 4,
    "text": "但在你有饒恕之恩，要叫人敬畏你。"
  },
  {
    "bookId": 19,
    "chapterId": 130,
    "verseId": 5,
    "text": "我等候　耶和華，我的心等候；我也仰望他的話。"
  },
  {
    "bookId": 19,
    "chapterId": 130,
    "verseId": 6,
    "text": "我的心等候　主，甚於守夜的，等候天亮；我說，甚於守夜的，等候天亮。"
  },
  {
    "bookId": 19,
    "chapterId": 130,
    "verseId": 7,
    "text": "以色列啊，你當仰望　耶和華！因　耶和華有慈愛，有豐盛的救恩。"
  },
  {
    "bookId": 19,
    "chapterId": 130,
    "verseId": 8,
    "text": "他必救贖以色列脫離一切的罪孽。"
  }
]
