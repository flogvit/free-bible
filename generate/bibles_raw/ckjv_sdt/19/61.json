[
  {
    "bookId": 19,
    "chapterId": 61,
    "verseId": 1,
    "text": "（大衛的詩，交與伶長。用絲弦的樂器。）　上帝啊，求你聽我的呼求，側耳聽我的禱告！"
  },
  {
    "bookId": 19,
    "chapterId": 61,
    "verseId": 2,
    "text": "我心裏發昏的時候，我要從地極求告你。求你領我到那比我更高的磐石！"
  },
  {
    "bookId": 19,
    "chapterId": 61,
    "verseId": 3,
    "text": "因為你作過我的避難所，作過我的堅固臺，脫離仇敵。"
  },
  {
    "bookId": 19,
    "chapterId": 61,
    "verseId": 4,
    "text": "我要永遠住在你的帳幕裏！我要投靠在你翅膀下的隱密處！細拉。"
  },
  {
    "bookId": 19,
    "chapterId": 61,
    "verseId": 5,
    "text": "上帝啊，你原是聽了我所許的願；你將產業賜給敬畏你名的人。"
  },
  {
    "bookId": 19,
    "chapterId": 61,
    "verseId": 6,
    "text": "你要加添王的壽數；他的年歲必存到世世代代。"
  },
  {
    "bookId": 19,
    "chapterId": 61,
    "verseId": 7,
    "text": "他必永遠坐在　上帝面前；願你預備慈愛和誠實保佑他啊！"
  },
  {
    "bookId": 19,
    "chapterId": 61,
    "verseId": 8,
    "text": "這樣，我要歌頌你的名，直到永遠，好天天還我所許的願。"
  }
]
