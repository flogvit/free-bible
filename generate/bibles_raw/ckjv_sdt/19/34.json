[
  {
    "bookId": 19,
    "chapterId": 34,
    "verseId": 1,
    "text": "（大衛在亞比米勒面前改變了尋常的舉動，被他趕出離開，就作這詩。）我要時時稱頌　耶和華；讚美他的話必常在我口中。"
  },
  {
    "bookId": 19,
    "chapterId": 34,
    "verseId": 2,
    "text": "我的心必因　耶和華誇耀；謙卑人聽見就要喜樂。"
  },
  {
    "bookId": 19,
    "chapterId": 34,
    "verseId": 3,
    "text": "你們和我同尊　耶和華為大吧，我們要一同高舉他的名。"
  },
  {
    "bookId": 19,
    "chapterId": 34,
    "verseId": 4,
    "text": "我曾尋求　耶和華，他就聽允我，救我脫離了一切的恐懼。"
  },
  {
    "bookId": 19,
    "chapterId": 34,
    "verseId": 5,
    "text": "凡仰望他的，便有光榮；他們的臉必不蒙羞。"
  },
  {
    "bookId": 19,
    "chapterId": 34,
    "verseId": 6,
    "text": "我這困苦人呼求，　耶和華便垂聽，救我脫離一切患難。"
  },
  {
    "bookId": 19,
    "chapterId": 34,
    "verseId": 7,
    "text": "耶和華的天使在敬畏他的人四圍安營，搭救他們。"
  },
  {
    "bookId": 19,
    "chapterId": 34,
    "verseId": 8,
    "text": "你們來嘗，便見　耶和華是美善了；投靠他的人有福了。"
  },
  {
    "bookId": 19,
    "chapterId": 34,
    "verseId": 9,
    "text": "耶和華的聖民哪，你們當敬畏他，因敬畏他的一無所缺。"
  },
  {
    "bookId": 19,
    "chapterId": 34,
    "verseId": 10,
    "text": "少壯獅子還缺食忍餓，但尋求　耶和華的甚麼好處都不缺。"
  },
  {
    "bookId": 19,
    "chapterId": 34,
    "verseId": 11,
    "text": "眾弟子啊，你們當來聽我的話！我要將敬畏　耶和華的道教訓你們。"
  },
  {
    "bookId": 19,
    "chapterId": 34,
    "verseId": 12,
    "text": "有何人喜好存活，愛慕長壽，得享美福，"
  },
  {
    "bookId": 19,
    "chapterId": 34,
    "verseId": 13,
    "text": "就要禁止舌頭不出惡言，嘴唇不說詭詐的話。"
  },
  {
    "bookId": 19,
    "chapterId": 34,
    "verseId": 14,
    "text": "要離惡行善，尋求和睦，一心追趕。"
  },
  {
    "bookId": 19,
    "chapterId": 34,
    "verseId": 15,
    "text": "耶和華的眼目看顧義人；他的耳朵聽他們的呼求。"
  },
  {
    "bookId": 19,
    "chapterId": 34,
    "verseId": 16,
    "text": "耶和華向行惡的人變臉，要從世上除滅他們的名號。"
  },
  {
    "bookId": 19,
    "chapterId": 34,
    "verseId": 17,
    "text": "義人呼求，　耶和華聽見了，便救他們脫離一切患難。"
  },
  {
    "bookId": 19,
    "chapterId": 34,
    "verseId": 18,
    "text": "耶和華靠近傷心的人，拯救靈性痛悔的人。"
  },
  {
    "bookId": 19,
    "chapterId": 34,
    "verseId": 19,
    "text": "義人多有苦難，但　耶和華救他脫離這一切，"
  },
  {
    "bookId": 19,
    "chapterId": 34,
    "verseId": 20,
    "text": "又保全他一身的骨頭，連一根也不折斷。"
  },
  {
    "bookId": 19,
    "chapterId": 34,
    "verseId": 21,
    "text": "惡必害死惡人；恨惡義人的，必遭冷落。"
  },
  {
    "bookId": 19,
    "chapterId": 34,
    "verseId": 22,
    "text": "耶和華救贖他僕人的元魂；凡投靠他的，必不致孤獨。"
  }
]
