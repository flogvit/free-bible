[
  {
    "bookId": 19,
    "chapterId": 121,
    "verseId": 1,
    "text": "（上行之詩。）我要向山舉目；我的幫助從何而來？"
  },
  {
    "bookId": 19,
    "chapterId": 121,
    "verseId": 2,
    "text": "我的幫助從造天地的　耶和華而來。"
  },
  {
    "bookId": 19,
    "chapterId": 121,
    "verseId": 3,
    "text": "他必不叫你的腳搖動；保護你的必不打盹！"
  },
  {
    "bookId": 19,
    "chapterId": 121,
    "verseId": 4,
    "text": "看哪，保護以色列的，也不打盹也不睡覺。"
  },
  {
    "bookId": 19,
    "chapterId": 121,
    "verseId": 5,
    "text": "保護你的是　耶和華；　耶和華在你右邊蔭庇你。"
  },
  {
    "bookId": 19,
    "chapterId": 121,
    "verseId": 6,
    "text": "白日，太陽必不傷你；夜間，月亮必不害你。"
  },
  {
    "bookId": 19,
    "chapterId": 121,
    "verseId": 7,
    "text": "耶和華要保護你，免受一切的災害；他要保護你的性命。"
  },
  {
    "bookId": 19,
    "chapterId": 121,
    "verseId": 8,
    "text": "你出你入，　耶和華要保護你，從今時直到永遠。"
  }
]
