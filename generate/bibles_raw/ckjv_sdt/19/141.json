[
  {
    "bookId": 19,
    "chapterId": 141,
    "verseId": 1,
    "text": "（大衛的詩。）　耶和華啊，我曾求告你，求你快快臨到我這裏！我求告你的時候，願你留心聽我的聲音！"
  },
  {
    "bookId": 19,
    "chapterId": 141,
    "verseId": 2,
    "text": "願我的禱告如香陳列在你面前！願我舉手祈求，如獻晚祭！"
  },
  {
    "bookId": 19,
    "chapterId": 141,
    "verseId": 3,
    "text": "耶和華啊，求你監察我的口，把守我的嘴！"
  },
  {
    "bookId": 19,
    "chapterId": 141,
    "verseId": 4,
    "text": "求你不叫我的心偏向邪惡，以致我和作孽的人同行惡事；也不叫我吃他們的美食。"
  },
  {
    "bookId": 19,
    "chapterId": 141,
    "verseId": 5,
    "text": "任憑義人擊打我，這算為仁慈；任憑他責備我，這算為極美的膏油，必不破我的頭。正在他們遭災的時候，我仍要祈禱。"
  },
  {
    "bookId": 19,
    "chapterId": 141,
    "verseId": 6,
    "text": "他們的審判官被扔在巖下；眾人要聽我的話，因為這話甘甜。"
  },
  {
    "bookId": 19,
    "chapterId": 141,
    "verseId": 7,
    "text": "我們的骨頭散在墓旁，好像人在地上砍劈的木頭。"
  },
  {
    "bookId": 19,
    "chapterId": 141,
    "verseId": 8,
    "text": "主─　耶和華啊，我的眼目仰望你；我投靠你，求你不要將我撇得孤苦！"
  },
  {
    "bookId": 19,
    "chapterId": 141,
    "verseId": 9,
    "text": "求你保護我脫離惡人為我設的網羅和作孽之人的圈套！"
  },
  {
    "bookId": 19,
    "chapterId": 141,
    "verseId": 10,
    "text": "願惡人落在自己的網裏，我卻得以逃脫。"
  }
]
