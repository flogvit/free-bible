[
  {
    "bookId": 19,
    "chapterId": 98,
    "verseId": 1,
    "text": "（一篇詩。）你們向　耶和華唱新歌吧！因為他行過奇妙的事；他的右手和聖臂使他得勝。"
  },
  {
    "bookId": 19,
    "chapterId": 98,
    "verseId": 2,
    "text": "耶和華傳揚了他的救恩；在異教之民眼前顯出公義。"
  },
  {
    "bookId": 19,
    "chapterId": 98,
    "verseId": 3,
    "text": "記念他向以色列家所發的慈愛，所憑的信實。地的四極都看見我們　上帝的救恩。"
  },
  {
    "bookId": 19,
    "chapterId": 98,
    "verseId": 4,
    "text": "全地都要向　耶和華歡樂；要發起大聲，歡喜歌頌！"
  },
  {
    "bookId": 19,
    "chapterId": 98,
    "verseId": 5,
    "text": "要用琴歌頌　耶和華，用琴和詩歌的聲音歌頌他！"
  },
  {
    "bookId": 19,
    "chapterId": 98,
    "verseId": 6,
    "text": "用號和角聲，在大　君王　耶和華面前歡呼！"
  },
  {
    "bookId": 19,
    "chapterId": 98,
    "verseId": 7,
    "text": "願海和其中所充滿的澎湃；世界和住在其間的也要發聲。"
  },
  {
    "bookId": 19,
    "chapterId": 98,
    "verseId": 8,
    "text": "願大水拍手；願諸山一同歡呼"
  },
  {
    "bookId": 19,
    "chapterId": 98,
    "verseId": 9,
    "text": "在　耶和華面前；因為他來要審判遍地。他要按公義審判世界，按公正審判眾民。"
  }
]
