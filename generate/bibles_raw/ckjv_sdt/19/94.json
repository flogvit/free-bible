[
  {
    "bookId": 19,
    "chapterId": 94,
    "verseId": 1,
    "text": "耶和華啊，你是伸冤的　上帝；伸冤的　上帝啊，求你顯明自己！"
  },
  {
    "bookId": 19,
    "chapterId": 94,
    "verseId": 2,
    "text": "審判世界的主啊，求你挺身而立，使驕傲人受應得的報應！"
  },
  {
    "bookId": 19,
    "chapterId": 94,
    "verseId": 3,
    "text": "耶和華啊，惡人誇勝要到幾時呢？要到幾時呢？"
  },
  {
    "bookId": 19,
    "chapterId": 94,
    "verseId": 4,
    "text": "他們說難明的話到幾時呢？一切作孽的人都自己誇張，要到幾時呢？"
  },
  {
    "bookId": 19,
    "chapterId": 94,
    "verseId": 5,
    "text": "耶和華啊，他們打碎你的百姓，苦害你的產業。"
  },
  {
    "bookId": 19,
    "chapterId": 94,
    "verseId": 6,
    "text": "他們殺死寡婦和客旅，又殺害無父的人。"
  },
  {
    "bookId": 19,
    "chapterId": 94,
    "verseId": 7,
    "text": "他們說：　耶和華必不看見；雅各的　上帝必不思念。"
  },
  {
    "bookId": 19,
    "chapterId": 94,
    "verseId": 8,
    "text": "你們民間的畜類人當明白；你們愚頑人到幾時才有智慧呢？"
  },
  {
    "bookId": 19,
    "chapterId": 94,
    "verseId": 9,
    "text": "造耳朵的，難道自己不聽見嗎？造眼睛的，難道自己不看見嗎？"
  },
  {
    "bookId": 19,
    "chapterId": 94,
    "verseId": 10,
    "text": "管教異教之民的，難道自己不懲治人嗎？指教人得知識的，難道自己沒有知識嗎？"
  },
  {
    "bookId": 19,
    "chapterId": 94,
    "verseId": 11,
    "text": "耶和華知道人的意念是虛妄的。"
  },
  {
    "bookId": 19,
    "chapterId": 94,
    "verseId": 12,
    "text": "耶和華啊，你所管教、用律法所教訓的人是有福的！"
  },
  {
    "bookId": 19,
    "chapterId": 94,
    "verseId": 13,
    "text": "你使他在遭難的日子得享平安；唯有惡人陷在所挖的坑中。"
  },
  {
    "bookId": 19,
    "chapterId": 94,
    "verseId": 14,
    "text": "因為　耶和華必不丟棄他的百姓，也不離棄他的產業。"
  },
  {
    "bookId": 19,
    "chapterId": 94,
    "verseId": 15,
    "text": "審判要轉向公義；心裏正直的，必都隨從。"
  },
  {
    "bookId": 19,
    "chapterId": 94,
    "verseId": 16,
    "text": "誰肯為我起來攻擊作惡的？誰肯為我站起抵擋作孽的？"
  },
  {
    "bookId": 19,
    "chapterId": 94,
    "verseId": 17,
    "text": "若不是　耶和華幫助我，我就住在寂靜之中了。"
  },
  {
    "bookId": 19,
    "chapterId": 94,
    "verseId": 18,
    "text": "我正說我失了腳，　耶和華啊，那時你的慈愛扶助我。"
  },
  {
    "bookId": 19,
    "chapterId": 94,
    "verseId": 19,
    "text": "我心裏多憂多疑，你安慰我，就使我心歡樂。"
  },
  {
    "bookId": 19,
    "chapterId": 94,
    "verseId": 20,
    "text": "那藉著律例架弄殘害、在位上行奸惡的，豈能與你相交嗎？"
  },
  {
    "bookId": 19,
    "chapterId": 94,
    "verseId": 21,
    "text": "他們大家聚集攻擊義人，要流無辜的人的血。"
  },
  {
    "bookId": 19,
    "chapterId": 94,
    "verseId": 22,
    "text": "但　耶和華向來作了我的保障；我的　上帝作了我投靠的磐石。"
  },
  {
    "bookId": 19,
    "chapterId": 94,
    "verseId": 23,
    "text": "他叫他們的罪孽歸到他們身上。他們正在行惡之中，他要剪除他們；　耶和華─我們的　上帝要把他們剪除。"
  }
]
