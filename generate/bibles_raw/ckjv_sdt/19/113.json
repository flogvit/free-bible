[
  {
    "bookId": 19,
    "chapterId": 113,
    "verseId": 1,
    "text": "你們要讚美　耶和華！　耶和華的僕人哪，你們要讚美，讚美　耶和華的名！"
  },
  {
    "bookId": 19,
    "chapterId": 113,
    "verseId": 2,
    "text": "耶和華的名是應當稱頌的，從今時直到永遠！"
  },
  {
    "bookId": 19,
    "chapterId": 113,
    "verseId": 3,
    "text": "從日出之地到日落之處，　耶和華的名是應當讚美的！"
  },
  {
    "bookId": 19,
    "chapterId": 113,
    "verseId": 4,
    "text": "耶和華超乎列國之上，他的榮耀高過諸天。"
  },
  {
    "bookId": 19,
    "chapterId": 113,
    "verseId": 5,
    "text": "誰像　耶和華─我們的　上帝，住在高處，"
  },
  {
    "bookId": 19,
    "chapterId": 113,
    "verseId": 6,
    "text": "自己謙卑，觀看天上地下的事！"
  },
  {
    "bookId": 19,
    "chapterId": 113,
    "verseId": 7,
    "text": "他從灰塵裏抬舉貧寒人，從糞堆中提拔窮乏人，"
  },
  {
    "bookId": 19,
    "chapterId": 113,
    "verseId": 8,
    "text": "使他們與王子同坐，就是與本國的王子同坐。"
  },
  {
    "bookId": 19,
    "chapterId": 113,
    "verseId": 9,
    "text": "他使不能生育的婦人安居家中，為多子的樂母。你們要讚美　耶和華！"
  }
]
