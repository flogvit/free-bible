[
  {
    "bookId": 19,
    "chapterId": 47,
    "verseId": 1,
    "text": "（為可拉後裔而作的詩，交與伶長。）眾民哪，你們都要拍掌！要用誇勝的聲音向　上帝呼喊！"
  },
  {
    "bookId": 19,
    "chapterId": 47,
    "verseId": 2,
    "text": "因為　耶和華至高者是可畏的；他是治理全地的大　君王。"
  },
  {
    "bookId": 19,
    "chapterId": 47,
    "verseId": 3,
    "text": "他叫眾民服在我們以下，又叫列邦服在我們腳下。"
  },
  {
    "bookId": 19,
    "chapterId": 47,
    "verseId": 4,
    "text": "他為我們選擇產業，就是他所愛之雅各的榮耀。細拉。"
  },
  {
    "bookId": 19,
    "chapterId": 47,
    "verseId": 5,
    "text": "上帝上升，有喊聲相送；　耶和華上升，有角聲相送。"
  },
  {
    "bookId": 19,
    "chapterId": 47,
    "verseId": 6,
    "text": "你們要向　上帝歌頌，歌頌！向我們　王歌頌，歌頌！"
  },
  {
    "bookId": 19,
    "chapterId": 47,
    "verseId": 7,
    "text": "因為　上帝是全地的　王；你們要用悟性歌頌。"
  },
  {
    "bookId": 19,
    "chapterId": 47,
    "verseId": 8,
    "text": "上帝作王治理異教的民；　上帝坐在他的聖寶座上。"
  },
  {
    "bookId": 19,
    "chapterId": 47,
    "verseId": 9,
    "text": "眾民的君王聚集，就是亞伯拉罕之　上帝的民！因為世界的盾牌是屬　上帝的；他為至高。"
  }
]
