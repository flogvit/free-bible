[
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 1,
    "text": "你們要稱謝　耶和華啊，因他本為善；他的慈愛永遠長存！"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 2,
    "text": "願以色列說：他的慈愛永遠長存！"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 3,
    "text": "願亞倫的家說：他的慈愛永遠長存！"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 4,
    "text": "願敬畏　耶和華的說：他的慈愛永遠長存！"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 5,
    "text": "我在急難中求告　耶和華，　耶和華就應允我，把我安置在寬闊之地。"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 6,
    "text": "耶和華在我旁邊；我必不懼怕！人能把我怎麼樣呢？"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 7,
    "text": "在那幫助我的人中，有　耶和華幫助我，所以我要看見那些恨我的人遭報。"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 8,
    "text": "投靠　耶和華，強似倚賴人；"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 9,
    "text": "投靠　耶和華，強似倚賴王子。"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 10,
    "text": "列國圍繞我，我靠　耶和華的名必剿滅他們。"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 11,
    "text": "他們環繞我，圍困我，我靠　耶和華的名必剿滅他們。"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 12,
    "text": "他們如同蜂子圍繞我，好像燒荊棘的火，必被熄滅；我靠　耶和華的名，必剿滅他們。"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 13,
    "text": "你推我，要叫我跌倒，但　耶和華幫助了我。"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 14,
    "text": "耶和華是我的力量，是我的詩歌；他也成了我的拯救。"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 15,
    "text": "在義人的帳棚裏，有歡呼拯救的聲音；　耶和華的右手勇敢行事。"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 16,
    "text": "耶和華的右手高舉；　耶和華的右手勇敢行事。"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 17,
    "text": "我必不致死，仍要存活，並要傳揚　耶和華的作為。"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 18,
    "text": "耶和華雖嚴嚴地懲治我，卻未曾將我交於死亡。"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 19,
    "text": "給我敞開義門；我要進去讚美　耶和華！"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 20,
    "text": "這是　耶和華的門；義人要進去！"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 21,
    "text": "我要讚美你，因為你已經聽允我，又成了我的拯救。"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 22,
    "text": "匠人所拒的石頭成為房角的頭塊石頭。"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 23,
    "text": "這是　耶和華所作的，在我們眼中看為希奇。"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 24,
    "text": "這是　耶和華所定的日子，我們在其中要高興歡喜！"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 25,
    "text": "耶和華啊，求你拯救！　耶和華啊，求你使我亨通！"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 26,
    "text": "奉　耶和華名來的是應當稱頌的！我們從　耶和華的殿中為你們祝福！"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 27,
    "text": "上帝就是那　照亮我們的　耶和華；理當用繩索把祭牲捆住，牽到壇角那裏。"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 28,
    "text": "你是我的　上帝，我要稱讚你！你是我的　上帝，我要尊崇你！"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 29,
    "text": "你們要稱謝　耶和華啊，因他本為善；他的慈愛永遠長存！"
  }
]
