[
  {
    "bookId": 19,
    "chapterId": 13,
    "verseId": 1,
    "text": "（大衛的詩，交與伶長。）　耶和華啊，你忘記我要到幾時呢？要到永遠嗎？你掩面不顧我要到幾時呢？"
  },
  {
    "bookId": 19,
    "chapterId": 13,
    "verseId": 2,
    "text": "我心裏籌算，終日愁苦，要到幾時呢？我的仇敵升高壓制我，要到幾時呢？"
  },
  {
    "bookId": 19,
    "chapterId": 13,
    "verseId": 3,
    "text": "耶和華─我的　上帝啊，求你看顧我，聽允我；使我眼目光明，免得我沉睡至死；"
  },
  {
    "bookId": 19,
    "chapterId": 13,
    "verseId": 4,
    "text": "免得我的仇敵說：我勝了他；免得擾害我的在我搖動的時候喜樂。"
  },
  {
    "bookId": 19,
    "chapterId": 13,
    "verseId": 5,
    "text": "但我倚靠你的慈愛；我的心因你的救恩快樂。"
  },
  {
    "bookId": 19,
    "chapterId": 13,
    "verseId": 6,
    "text": "我要向　耶和華歌唱，因他用厚恩待我。"
  }
]
