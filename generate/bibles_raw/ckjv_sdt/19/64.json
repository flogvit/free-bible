[
  {
    "bookId": 19,
    "chapterId": 64,
    "verseId": 1,
    "text": "（大衛的詩，交與伶長。）　上帝啊，我禱告的時候，求你聽我的聲音！求你保護我的性命，不受仇敵的驚恐！"
  },
  {
    "bookId": 19,
    "chapterId": 64,
    "verseId": 2,
    "text": "求你把我隱藏，使我脫離作惡之人的暗謀和作孽之人的擾亂。"
  },
  {
    "bookId": 19,
    "chapterId": 64,
    "verseId": 3,
    "text": "他們磨舌如刀，發出苦毒的言語，好像彎弓而射的箭，"
  },
  {
    "bookId": 19,
    "chapterId": 64,
    "verseId": 4,
    "text": "要在暗地射完全人；他們忽然射他，並不懼怕。"
  },
  {
    "bookId": 19,
    "chapterId": 64,
    "verseId": 5,
    "text": "他們彼此勉勵設下惡計；他們商量暗設網羅，說：誰能看見？"
  },
  {
    "bookId": 19,
    "chapterId": 64,
    "verseId": 6,
    "text": "他們圖謀奸惡，極力圖謀；他們各人的意念和心思都是深的。"
  },
  {
    "bookId": 19,
    "chapterId": 64,
    "verseId": 7,
    "text": "但　上帝要射他們；他們忽然被箭射傷。"
  },
  {
    "bookId": 19,
    "chapterId": 64,
    "verseId": 8,
    "text": "他們必然跌倒，被自己的舌頭所害；凡看見他們的必都逃跑。"
  },
  {
    "bookId": 19,
    "chapterId": 64,
    "verseId": 9,
    "text": "眾人都要害怕，要傳揚　上帝的工作，並且明白他的作為。"
  },
  {
    "bookId": 19,
    "chapterId": 64,
    "verseId": 10,
    "text": "義人必因　耶和華歡喜，並要投靠他；凡心裏正直的人都要誇口。"
  }
]
