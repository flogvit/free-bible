[
  {
    "bookId": 19,
    "chapterId": 114,
    "verseId": 1,
    "text": "以色列出了埃及，雅各家離開說異言之民；"
  },
  {
    "bookId": 19,
    "chapterId": 114,
    "verseId": 2,
    "text": "那時，猶大為他的聖所，以色列為他所治理的國度。"
  },
  {
    "bookId": 19,
    "chapterId": 114,
    "verseId": 3,
    "text": "滄海看見就奔逃；約旦河也倒流。"
  },
  {
    "bookId": 19,
    "chapterId": 114,
    "verseId": 4,
    "text": "大山踴躍，如公綿羊；小山跳舞，如綿羊羔。"
  },
  {
    "bookId": 19,
    "chapterId": 114,
    "verseId": 5,
    "text": "滄海啊，你為何奔逃？約旦哪，你為何倒流？"
  },
  {
    "bookId": 19,
    "chapterId": 114,
    "verseId": 6,
    "text": "大山哪，你為何踴躍，如公綿羊？小山哪，你為何跳舞，如綿羊羔？"
  },
  {
    "bookId": 19,
    "chapterId": 114,
    "verseId": 7,
    "text": "大地啊，你因見　主的面，就是雅各　上帝的面，便要震動。"
  },
  {
    "bookId": 19,
    "chapterId": 114,
    "verseId": 8,
    "text": "他叫磐石變為水池，叫堅石變為泉源。"
  }
]
