[
  {
    "bookId": 19,
    "chapterId": 149,
    "verseId": 1,
    "text": "你們要讚美　耶和華！向　耶和華唱新歌，在聖民的會中讚美他！"
  },
  {
    "bookId": 19,
    "chapterId": 149,
    "verseId": 2,
    "text": "願以色列因造他的主歡喜！願錫安的民因他們的　王快樂！"
  },
  {
    "bookId": 19,
    "chapterId": 149,
    "verseId": 3,
    "text": "願他們跳舞讚美他的名，擊鼓彈琴歌頌他！"
  },
  {
    "bookId": 19,
    "chapterId": 149,
    "verseId": 4,
    "text": "因為　耶和華喜愛他的百姓；他要用救恩當作謙卑人的妝飾。"
  },
  {
    "bookId": 19,
    "chapterId": 149,
    "verseId": 5,
    "text": "願聖民因所得的榮耀高興！願他們在床上大聲歌唱！"
  },
  {
    "bookId": 19,
    "chapterId": 149,
    "verseId": 6,
    "text": "願他們口中稱讚　上帝為高，手裏有兩刃的刀，"
  },
  {
    "bookId": 19,
    "chapterId": 149,
    "verseId": 7,
    "text": "為要報復異教的民，刑罰眾民；"
  },
  {
    "bookId": 19,
    "chapterId": 149,
    "verseId": 8,
    "text": "要用鏈子捆他們的君王，用鐵鐐鎖他們的大臣；"
  },
  {
    "bookId": 19,
    "chapterId": 149,
    "verseId": 9,
    "text": "要在他們身上施行所記錄的審判。他的聖民都有這榮耀。你們要讚美　耶和華！"
  }
]
