[
  {
    "bookId": 19,
    "chapterId": 93,
    "verseId": 1,
    "text": "耶和華作王！他以威嚴為衣穿上；　耶和華以能力為衣，以能力束腰，世界就堅定，不得動搖。"
  },
  {
    "bookId": 19,
    "chapterId": 93,
    "verseId": 2,
    "text": "你的寶座從太初立定；你從恆古就有。"
  },
  {
    "bookId": 19,
    "chapterId": 93,
    "verseId": 3,
    "text": "耶和華啊，大水揚起，大水發聲，波浪澎湃。"
  },
  {
    "bookId": 19,
    "chapterId": 93,
    "verseId": 4,
    "text": "耶和華在高處大有能力，勝過多水的響聲，洋海的大浪。"
  },
  {
    "bookId": 19,
    "chapterId": 93,
    "verseId": 5,
    "text": "耶和華啊，你的法度最的確；你的殿永稱為聖，是合宜的。"
  }
]
