[
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 1,
    "text": "（上行之詩。）以色列當說：從我幼年以來，敵人屢次苦害我，"
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 2,
    "text": "從我幼年以來，敵人屢次苦害我，卻沒有勝了我。"
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 3,
    "text": "如同扶犁的在我背上扶犁而耕，耕的犁溝甚長。"
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 4,
    "text": "耶和華是公義的；他砍斷了惡人的繩索。"
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 5,
    "text": "願恨惡錫安的都慚愧退後。"
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 6,
    "text": "願他們像房頂上的草，未長成而枯乾，"
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 7,
    "text": "收割的不夠一把，捆禾的也不滿懷。"
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 8,
    "text": "過路的也不說：願　耶和華所賜的福歸與你們！我們奉　耶和華的名給你們祝福！"
  }
]
