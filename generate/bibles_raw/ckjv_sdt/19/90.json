[
  {
    "bookId": 19,
    "chapterId": 90,
    "verseId": 1,
    "text": "（　上帝的人摩西的祈禱）　主啊，你世世代代作我們的居所。"
  },
  {
    "bookId": 19,
    "chapterId": 90,
    "verseId": 2,
    "text": "諸山未曾生出，地與世界你未曾造成，從恆古到永遠，你是　上帝。"
  },
  {
    "bookId": 19,
    "chapterId": 90,
    "verseId": 3,
    "text": "你使人滅亡，說：你們世人要歸回。"
  },
  {
    "bookId": 19,
    "chapterId": 90,
    "verseId": 4,
    "text": "在你看來，千年如已過的昨日，又如夜間的一更。"
  },
  {
    "bookId": 19,
    "chapterId": 90,
    "verseId": 5,
    "text": "你叫他們如水沖去；他們如睡一覺。早晨，他們如生長的草，"
  },
  {
    "bookId": 19,
    "chapterId": 90,
    "verseId": 6,
    "text": "早晨發芽生長，晚上割下枯乾。"
  },
  {
    "bookId": 19,
    "chapterId": 90,
    "verseId": 7,
    "text": "我們因你的怒氣而消滅，因你的忿怒而驚惶。"
  },
  {
    "bookId": 19,
    "chapterId": 90,
    "verseId": 8,
    "text": "你將我們的罪孽擺在你面前，將我們的隱惡擺在你面光之中。"
  },
  {
    "bookId": 19,
    "chapterId": 90,
    "verseId": 9,
    "text": "我們經過的日子都在你震怒之下；我們度盡的年歲好像一聲歎息。"
  },
  {
    "bookId": 19,
    "chapterId": 90,
    "verseId": 10,
    "text": "我們一生的年日是七十歲，若是強壯可到八十歲；但其中所矜誇的不過是勞苦愁煩，轉眼成空，我們便如飛而去。"
  },
  {
    "bookId": 19,
    "chapterId": 90,
    "verseId": 11,
    "text": "誰曉得你怒氣的權勢？誰按著你該受的敬畏曉得你的忿怒呢？"
  },
  {
    "bookId": 19,
    "chapterId": 90,
    "verseId": 12,
    "text": "求你指教我們怎樣數算自己的日子，好叫我們留心領受智慧。"
  },
  {
    "bookId": 19,
    "chapterId": 90,
    "verseId": 13,
    "text": "耶和華啊，我們要等到幾時呢？求你轉回，為你的僕人後悔。"
  },
  {
    "bookId": 19,
    "chapterId": 90,
    "verseId": 14,
    "text": "求你使我們早早飽得你的慈愛，好叫我們一生一世歡喜快樂啊！"
  },
  {
    "bookId": 19,
    "chapterId": 90,
    "verseId": 15,
    "text": "求你照著你使我們受苦的日子，和我們遭難的年歲，叫我們喜樂。"
  },
  {
    "bookId": 19,
    "chapterId": 90,
    "verseId": 16,
    "text": "願你的作為向你僕人顯現；願你的榮耀向他們子孫顯明。"
  },
  {
    "bookId": 19,
    "chapterId": 90,
    "verseId": 17,
    "text": "願　耶和華─我們　上帝的榮美歸於我們身上。願你堅立我們手所作的工；我們手所作的工，願你堅立。"
  }
]
