[
  {
    "bookId": 19,
    "chapterId": 108,
    "verseId": 1,
    "text": "（大衛的詩歌。）　上帝啊，我心堅定；我帶著榮耀要唱詩歌頌！"
  },
  {
    "bookId": 19,
    "chapterId": 108,
    "verseId": 2,
    "text": "琴瑟啊，你們當醒起！我自己要極早醒起！"
  },
  {
    "bookId": 19,
    "chapterId": 108,
    "verseId": 3,
    "text": "耶和華啊，我要在列國中稱讚你！我要在列邦中歌頌你。"
  },
  {
    "bookId": 19,
    "chapterId": 108,
    "verseId": 4,
    "text": "因為，你的慈愛大過諸天；你的誠實達到高雲。"
  },
  {
    "bookId": 19,
    "chapterId": 108,
    "verseId": 5,
    "text": "上帝啊，願你崇高過於諸天！願你的榮耀高過全地！"
  },
  {
    "bookId": 19,
    "chapterId": 108,
    "verseId": 6,
    "text": "求你應允我，用右手拯救我，好叫你所親愛的人得救。"
  },
  {
    "bookId": 19,
    "chapterId": 108,
    "verseId": 7,
    "text": "上帝已經指著他的聖潔說，我要歡樂；我要分開示劍，丈量疏割谷。"
  },
  {
    "bookId": 19,
    "chapterId": 108,
    "verseId": 8,
    "text": "基列是我的；瑪拿西也是我的；以法蓮是我頭上的力量；猶大是我的設立律法者；"
  },
  {
    "bookId": 19,
    "chapterId": 108,
    "verseId": 9,
    "text": "摩押是我的沐浴盆；我要向以東拋鞋；我必向非利士誇勝。"
  },
  {
    "bookId": 19,
    "chapterId": 108,
    "verseId": 10,
    "text": "誰能領我進堅固城？誰能引我到以東地？"
  },
  {
    "bookId": 19,
    "chapterId": 108,
    "verseId": 11,
    "text": "上帝啊，你不是丟棄了我們嗎？　上帝啊，你不和我們的軍兵同去嗎？"
  },
  {
    "bookId": 19,
    "chapterId": 108,
    "verseId": 12,
    "text": "求你幫助我們脫離苦難，因為人的幫助是枉然的。"
  },
  {
    "bookId": 19,
    "chapterId": 108,
    "verseId": 13,
    "text": "我們倚靠　上帝才得勇敢行事，因為踐踏我們敵人的就是他。"
  }
]
