[
  {
    "bookId": 19,
    "chapterId": 144,
    "verseId": 1,
    "text": "（大衛的詩。）　耶和華─我的力量是應當稱頌的！他教導我的手爭戰，教導我的指頭打仗。"
  },
  {
    "bookId": 19,
    "chapterId": 144,
    "verseId": 2,
    "text": "他是我慈愛的主，我的山寨，我的高臺，我的救主，我的盾牌，是我所投靠的；他使我的百姓服在我以下。"
  },
  {
    "bookId": 19,
    "chapterId": 144,
    "verseId": 3,
    "text": "耶和華啊，人算甚麼，你竟認識他！世人算甚麼，你竟顧念他！"
  },
  {
    "bookId": 19,
    "chapterId": 144,
    "verseId": 4,
    "text": "人好像空氣；他的年日如同影兒快快過去。"
  },
  {
    "bookId": 19,
    "chapterId": 144,
    "verseId": 5,
    "text": "耶和華啊，求你使諸天下垂，親自降臨，摸山，山就冒煙。"
  },
  {
    "bookId": 19,
    "chapterId": 144,
    "verseId": 6,
    "text": "求你發出閃電，使他們四散，射出你的箭，使他們滅絕。"
  },
  {
    "bookId": 19,
    "chapterId": 144,
    "verseId": 7,
    "text": "求你從上伸手救拔我，救我出離大水，救我脫離外邦人的手。"
  },
  {
    "bookId": 19,
    "chapterId": 144,
    "verseId": 8,
    "text": "他們的口說空話；他們的右手起假誓。"
  },
  {
    "bookId": 19,
    "chapterId": 144,
    "verseId": 9,
    "text": "上帝啊，我要向你唱新歌，用瑟並十弦的樂器向你歌頌。"
  },
  {
    "bookId": 19,
    "chapterId": 144,
    "verseId": 10,
    "text": "你是那拯救君王的；你是那救僕人大衛脫離害命之刀的。"
  },
  {
    "bookId": 19,
    "chapterId": 144,
    "verseId": 11,
    "text": "求你救拔我，救我脫離外邦人的手。他們的口說空話；他們的右手起假誓。"
  },
  {
    "bookId": 19,
    "chapterId": 144,
    "verseId": 12,
    "text": "我們的兒子從幼年好像樹栽子長大；我們的女兒如同殿角石，是按建宮的樣式鑿成的。"
  },
  {
    "bookId": 19,
    "chapterId": 144,
    "verseId": 13,
    "text": "我們的倉盈滿，能出各樣的糧食；我們的羊在街道孳生千萬。"
  },
  {
    "bookId": 19,
    "chapterId": 144,
    "verseId": 14,
    "text": "我們的牛工作有力，沒有人闖進來搶奪，也沒有人出去爭戰；我們的街道上也沒有爭鬧的聲音。"
  },
  {
    "bookId": 19,
    "chapterId": 144,
    "verseId": 15,
    "text": "遇見這光景的百姓便為有福！有　耶和華為他們的　上帝，這百姓便為有福！"
  }
]
