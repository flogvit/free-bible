[
  {
    "bookId": 19,
    "chapterId": 125,
    "verseId": 1,
    "text": "（上行之詩。）倚靠　耶和華的人好像錫安山，不致除去，反得永存。"
  },
  {
    "bookId": 19,
    "chapterId": 125,
    "verseId": 2,
    "text": "眾山怎樣圍繞耶路撒冷，　耶和華也照樣圍繞他的百姓，從今時直到永遠。"
  },
  {
    "bookId": 19,
    "chapterId": 125,
    "verseId": 3,
    "text": "惡人的杖不常落在義人的分上，免得義人伸手作惡。"
  },
  {
    "bookId": 19,
    "chapterId": 125,
    "verseId": 4,
    "text": "耶和華啊，求你善待那些為善和心裏正直的人。"
  },
  {
    "bookId": 19,
    "chapterId": 125,
    "verseId": 5,
    "text": "至於那偏行彎曲道路的人，　耶和華必使他和作惡的人一同出去受刑。願平安歸於以色列！"
  }
]
