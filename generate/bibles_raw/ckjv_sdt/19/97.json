[
  {
    "bookId": 19,
    "chapterId": 97,
    "verseId": 1,
    "text": "耶和華作王！願地快樂！願眾海島歡喜！"
  },
  {
    "bookId": 19,
    "chapterId": 97,
    "verseId": 2,
    "text": "密雲和幽暗在他的四圍；公義和公平是他寶座的所在。"
  },
  {
    "bookId": 19,
    "chapterId": 97,
    "verseId": 3,
    "text": "有烈火在他前頭行，燒滅他四圍的敵人。"
  },
  {
    "bookId": 19,
    "chapterId": 97,
    "verseId": 4,
    "text": "他的閃電光照世界，大地看見便震動。"
  },
  {
    "bookId": 19,
    "chapterId": 97,
    "verseId": 5,
    "text": "諸山見　耶和華的面，就是全地之　主的面，便消化如蠟。"
  },
  {
    "bookId": 19,
    "chapterId": 97,
    "verseId": 6,
    "text": "諸天表明他的公義；眾民看見他的榮耀。"
  },
  {
    "bookId": 19,
    "chapterId": 97,
    "verseId": 7,
    "text": "願一切事奉雕刻的眾像、靠虛無之偶像自誇的，盡都抱愧；眾神哪，你們都當敬拜他。"
  },
  {
    "bookId": 19,
    "chapterId": 97,
    "verseId": 8,
    "text": "耶和華啊，錫安聽見你的判斷就歡喜；猶大的眾女也都快樂。"
  },
  {
    "bookId": 19,
    "chapterId": 97,
    "verseId": 9,
    "text": "因為你─　耶和華高過全地；你被尊崇，遠超眾神之上。"
  },
  {
    "bookId": 19,
    "chapterId": 97,
    "verseId": 10,
    "text": "你們愛　耶和華的，都當恨惡罪惡；他保護聖民的性命，搭救他們脫離惡人的手。"
  },
  {
    "bookId": 19,
    "chapterId": 97,
    "verseId": 11,
    "text": "散布亮光是為義人；預備喜樂是為正直人。"
  },
  {
    "bookId": 19,
    "chapterId": 97,
    "verseId": 12,
    "text": "你們義人當靠　耶和華歡喜，稱謝他可記念的聖名。"
  }
]
