[
  {
    "bookId": 19,
    "chapterId": 128,
    "verseId": 1,
    "text": "（上行之詩。）凡敬畏　耶和華、遵行他道的人便為有福！"
  },
  {
    "bookId": 19,
    "chapterId": 128,
    "verseId": 2,
    "text": "你要吃你手勞碌得來的；你要享福，事情順利。"
  },
  {
    "bookId": 19,
    "chapterId": 128,
    "verseId": 3,
    "text": "你妻子在你室的旁邊，好像多結果子的葡萄樹；你兒女圍繞你的桌子，好像橄欖栽子。"
  },
  {
    "bookId": 19,
    "chapterId": 128,
    "verseId": 4,
    "text": "看哪，敬畏　耶和華的人必要這樣蒙福！"
  },
  {
    "bookId": 19,
    "chapterId": 128,
    "verseId": 5,
    "text": "願　耶和華從錫安賜福給你！願你一生一世看見耶路撒冷的好處！"
  },
  {
    "bookId": 19,
    "chapterId": 128,
    "verseId": 6,
    "text": "願你看見你兒女的兒女！願平安歸於以色列！"
  }
]
