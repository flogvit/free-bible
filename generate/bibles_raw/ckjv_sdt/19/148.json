[
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 1,
    "text": "你們要讚美　耶和華。從諸天讚美　耶和華！在高處讚美他。"
  },
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 2,
    "text": "他的眾天使都要讚美他！他的諸軍都要讚美他！"
  },
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 3,
    "text": "日頭月亮，你們要讚美他！放光的星宿，你們都要讚美他！"
  },
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 4,
    "text": "諸天上的諸天，並諸天上的水，你們都要讚美他！"
  },
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 5,
    "text": "願這些都讚美　耶和華的名！因他一吩咐便都創造而成。"
  },
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 6,
    "text": "他將這些立定，直到永永遠遠；他定了命，不能廢去。"
  },
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 7,
    "text": "龍與一切在深處的，你們要從地上讚美　耶和華；"
  },
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 8,
    "text": "火與冰雹，雪和霧氣，成就他命的狂風，"
  },
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 9,
    "text": "大山和小山，結果的樹木和一切香柏樹，"
  },
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 10,
    "text": "野獸和一切牲畜，昆蟲和飛鳥，"
  },
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 11,
    "text": "世上的君王和眾民，首領和世上一切審判官，"
  },
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 12,
    "text": "少年人和處女，老年人和孩童，都當讚美　耶和華！"
  },
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 13,
    "text": "願這些都讚美　耶和華的名！因為獨有他的名為美；他的榮耀在天地之上。"
  },
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 14,
    "text": "他將他百姓的角高舉，他使一切聖民以色列人，就是與他相近的百姓，都讚美他！你們要讚美　耶和華！"
  }
]
