[
  {
    "bookId": 19,
    "chapterId": 132,
    "verseId": 1,
    "text": "（上行之詩。）　耶和華啊，求你記念大衛所受的一切苦難！"
  },
  {
    "bookId": 19,
    "chapterId": 132,
    "verseId": 2,
    "text": "他怎樣向　耶和華起誓，向雅各的大能者　上帝許願，"
  },
  {
    "bookId": 19,
    "chapterId": 132,
    "verseId": 3,
    "text": "說：我必不進我的帳幕，也不上我的床榻；"
  },
  {
    "bookId": 19,
    "chapterId": 132,
    "verseId": 4,
    "text": "我不容我的眼睛睡覺，也不容我的眼皮打盹；"
  },
  {
    "bookId": 19,
    "chapterId": 132,
    "verseId": 5,
    "text": "直等我為　耶和華尋得所在，為雅各的大能者　上帝尋得居所。"
  },
  {
    "bookId": 19,
    "chapterId": 132,
    "verseId": 6,
    "text": "我們聽說約櫃在以法他，我們在樹林就尋見了。"
  },
  {
    "bookId": 19,
    "chapterId": 132,
    "verseId": 7,
    "text": "我們要進他的帳幕，在他腳凳前敬拜。"
  },
  {
    "bookId": 19,
    "chapterId": 132,
    "verseId": 8,
    "text": "耶和華啊，求你興起；和你有能力的約櫃同入你的安息。"
  },
  {
    "bookId": 19,
    "chapterId": 132,
    "verseId": 9,
    "text": "願你的祭司披上公義！願你的聖民歡呼！"
  },
  {
    "bookId": 19,
    "chapterId": 132,
    "verseId": 10,
    "text": "求你因你僕人大衛的緣故，不要轉臉不顧你的受膏者！"
  },
  {
    "bookId": 19,
    "chapterId": 132,
    "verseId": 11,
    "text": "耶和華向大衛、憑誠實起了誓，必不反覆，說：我要使你所生的坐在你的寶座上。"
  },
  {
    "bookId": 19,
    "chapterId": 132,
    "verseId": 12,
    "text": "你的眾子若守我的約和我所教訓他們的法度，他們的子孫必永遠坐在你的寶座上。"
  },
  {
    "bookId": 19,
    "chapterId": 132,
    "verseId": 13,
    "text": "因為　耶和華揀選了錫安，願意當作自己的居所，"
  },
  {
    "bookId": 19,
    "chapterId": 132,
    "verseId": 14,
    "text": "說：這是我永遠安息之所；我要住在這裏，因為是我所願意的。"
  },
  {
    "bookId": 19,
    "chapterId": 132,
    "verseId": 15,
    "text": "我要使其中的糧食豐滿，使其中的窮人飽足。"
  },
  {
    "bookId": 19,
    "chapterId": 132,
    "verseId": 16,
    "text": "我要使祭司披上救恩，聖民大聲歡呼！"
  },
  {
    "bookId": 19,
    "chapterId": 132,
    "verseId": 17,
    "text": "我要叫大衛的角在那裏發芽；我為我的受膏者設下明燈。"
  },
  {
    "bookId": 19,
    "chapterId": 132,
    "verseId": 18,
    "text": "我要使他的仇敵披上羞恥；但他的冠冕要在頭上發光。"
  }
]
