[
  {
    "bookId": 19,
    "chapterId": 100,
    "verseId": 1,
    "text": "（稱謝詩。）普天下當向　耶和華歡呼！"
  },
  {
    "bookId": 19,
    "chapterId": 100,
    "verseId": 2,
    "text": "你們當樂意事奉　耶和華，當來向他歌唱！"
  },
  {
    "bookId": 19,
    "chapterId": 100,
    "verseId": 3,
    "text": "你們當曉得　耶和華是　上帝！我們是他造的，不是我們自造的；我們是他的民，也是他草場的羊。"
  },
  {
    "bookId": 19,
    "chapterId": 100,
    "verseId": 4,
    "text": "當稱謝進入他的門；當讚美進入他的院。當感謝他，稱頌他的名！"
  },
  {
    "bookId": 19,
    "chapterId": 100,
    "verseId": 5,
    "text": "因為　耶和華本為善。他的慈愛存到永遠；他的信實直到萬代。"
  }
]
