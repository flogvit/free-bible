[
  {
    "bookId": 19,
    "chapterId": 12,
    "verseId": 1,
    "text": "（大衛的詩，交與伶長。調用第八。）　耶和華啊，求你幫助，因虔誠人斷絕了；世人中間的忠信人沒有了。"
  },
  {
    "bookId": 19,
    "chapterId": 12,
    "verseId": 2,
    "text": "人人向鄰舍說空話；他們說話，是嘴唇油滑，心口不一。"
  },
  {
    "bookId": 19,
    "chapterId": 12,
    "verseId": 3,
    "text": "凡油滑的嘴唇和狂傲的舌頭，　耶和華必要剪除。"
  },
  {
    "bookId": 19,
    "chapterId": 12,
    "verseId": 4,
    "text": "他們曾說：我們必能以舌頭得勝；我們的嘴唇是我們自己的，誰能作我們的主呢？"
  },
  {
    "bookId": 19,
    "chapterId": 12,
    "verseId": 5,
    "text": "耶和華說：因為困苦人受欺壓和貧窮人的歎息，我現在要起來，把他安置在他所切慕的穩妥之地。"
  },
  {
    "bookId": 19,
    "chapterId": 12,
    "verseId": 6,
    "text": "耶和華的言語是純淨的言語，如同銀子在泥爐中煉過七次。"
  },
  {
    "bookId": 19,
    "chapterId": 12,
    "verseId": 7,
    "text": "耶和華啊，你必保全它們，自這世代起你必保守它們，直到永遠。"
  },
  {
    "bookId": 19,
    "chapterId": 12,
    "verseId": 8,
    "text": "下流人在世人中升高，就有惡人到處行走。"
  }
]
