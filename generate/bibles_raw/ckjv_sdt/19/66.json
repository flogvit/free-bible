[
  {
    "bookId": 19,
    "chapterId": 66,
    "verseId": 1,
    "text": "（一篇詩歌，交與伶長。）全地都當向　上帝歡呼！"
  },
  {
    "bookId": 19,
    "chapterId": 66,
    "verseId": 2,
    "text": "歌頌他名的榮耀！用讚美的言語顯出他的榮耀！"
  },
  {
    "bookId": 19,
    "chapterId": 66,
    "verseId": 3,
    "text": "當對　上帝說：你的作為何等可畏！因你的大能，仇敵要投降你。"
  },
  {
    "bookId": 19,
    "chapterId": 66,
    "verseId": 4,
    "text": "全地要敬拜你，歌頌你，要歌頌你的名。細拉。"
  },
  {
    "bookId": 19,
    "chapterId": 66,
    "verseId": 5,
    "text": "你們來看　上帝所行的，他向世人所作之事是可畏的。"
  },
  {
    "bookId": 19,
    "chapterId": 66,
    "verseId": 6,
    "text": "他將海變成乾地，眾民步行過河；我們在那裏因他歡喜。"
  },
  {
    "bookId": 19,
    "chapterId": 66,
    "verseId": 7,
    "text": "他用權能掌管，直到永遠；他的眼睛鑒察列國。叛逆的人不可自高。細拉。"
  },
  {
    "bookId": 19,
    "chapterId": 66,
    "verseId": 8,
    "text": "眾民哪，你們當稱頌我們的　上帝，使人得聽讚美他的聲音。"
  },
  {
    "bookId": 19,
    "chapterId": 66,
    "verseId": 9,
    "text": "他使我們的性命存活，也不叫我們的腳搖動。"
  },
  {
    "bookId": 19,
    "chapterId": 66,
    "verseId": 10,
    "text": "上帝啊，你曾試驗我們，試煉我們，如試煉銀子一樣。"
  },
  {
    "bookId": 19,
    "chapterId": 66,
    "verseId": 11,
    "text": "你使我們進入網羅，把苦難放在我們的身上。"
  },
  {
    "bookId": 19,
    "chapterId": 66,
    "verseId": 12,
    "text": "你使人坐車輾過我們的頭；我們經過水火，你卻使我們到豐富之地。"
  },
  {
    "bookId": 19,
    "chapterId": 66,
    "verseId": 13,
    "text": "我要用燔祭進你的殿，向你還我的願，"
  },
  {
    "bookId": 19,
    "chapterId": 66,
    "verseId": 14,
    "text": "就是在急難時我嘴唇所發的、口中所許的。"
  },
  {
    "bookId": 19,
    "chapterId": 66,
    "verseId": 15,
    "text": "我要把肥畜獻作燔祭，將公綿羊的香祭獻給你；我要把公牛和山羊獻上。細拉。"
  },
  {
    "bookId": 19,
    "chapterId": 66,
    "verseId": 16,
    "text": "凡敬畏　上帝的人，你們都來聽！我要述說他為我所行的事。"
  },
  {
    "bookId": 19,
    "chapterId": 66,
    "verseId": 17,
    "text": "我曾用口求告他；我的舌頭也稱他為高。"
  },
  {
    "bookId": 19,
    "chapterId": 66,
    "verseId": 18,
    "text": "我若心裏注重罪孽，　主必不聽。"
  },
  {
    "bookId": 19,
    "chapterId": 66,
    "verseId": 19,
    "text": "但　上帝實在聽見了；他側耳聽了我禱告的聲音。"
  },
  {
    "bookId": 19,
    "chapterId": 66,
    "verseId": 20,
    "text": "上帝是應當稱頌的！他並沒有推卻我的禱告，也沒有叫他的慈愛離開我。"
  }
]
