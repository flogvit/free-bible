[
  {
    "bookId": 19,
    "chapterId": 8,
    "verseId": 1,
    "text": "（大衛的詩，交與伶長。用迦特樂器。）　耶和華─我們的　主啊，你的名在全地何其美！你將你的榮耀安於諸天。"
  },
  {
    "bookId": 19,
    "chapterId": 8,
    "verseId": 2,
    "text": "你因敵人的緣故，從嬰孩和吃奶的口中，建立了能力，使仇敵和報仇的閉口無言。"
  },
  {
    "bookId": 19,
    "chapterId": 8,
    "verseId": 3,
    "text": "我觀看你指頭所造的諸天，並你所陳設的月亮星宿，"
  },
  {
    "bookId": 19,
    "chapterId": 8,
    "verseId": 4,
    "text": "便說：人算甚麼，你竟顧念他？世人算甚麼，你竟眷顧他？"
  },
  {
    "bookId": 19,
    "chapterId": 8,
    "verseId": 5,
    "text": "你叫他比天使微小一點，並賜他榮耀尊貴為冠冕。"
  },
  {
    "bookId": 19,
    "chapterId": 8,
    "verseId": 6,
    "text": "你派他管理你手所造的，使萬物都服在他的腳下。"
  },
  {
    "bookId": 19,
    "chapterId": 8,
    "verseId": 7,
    "text": "就是一切的牛羊、田野的獸、"
  },
  {
    "bookId": 19,
    "chapterId": 8,
    "verseId": 8,
    "text": "空中的鳥、海裏的魚，凡經行海道的。"
  },
  {
    "bookId": 19,
    "chapterId": 8,
    "verseId": 9,
    "text": "耶和華─我們的　主啊，你的名在全地何其美！"
  }
]
