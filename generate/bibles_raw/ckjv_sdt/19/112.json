[
  {
    "bookId": 19,
    "chapterId": 112,
    "verseId": 1,
    "text": "你們要讚美　耶和華！敬畏　耶和華，甚喜愛他命令的，這人便為有福！"
  },
  {
    "bookId": 19,
    "chapterId": 112,
    "verseId": 2,
    "text": "他的後裔在世必強盛；正直人的後代必要蒙福。"
  },
  {
    "bookId": 19,
    "chapterId": 112,
    "verseId": 3,
    "text": "他家中有貨物，有錢財；他的公義存到永遠。"
  },
  {
    "bookId": 19,
    "chapterId": 112,
    "verseId": 4,
    "text": "正直人在黑暗中，有光向他顯現；他有恩惠，滿懷憐憫和公義。"
  },
  {
    "bookId": 19,
    "chapterId": 112,
    "verseId": 5,
    "text": "善人施恩與人、借貸與人，他以見識引導他的事務。"
  },
  {
    "bookId": 19,
    "chapterId": 112,
    "verseId": 6,
    "text": "他必永不動搖；義人被記念，直到永遠。"
  },
  {
    "bookId": 19,
    "chapterId": 112,
    "verseId": 7,
    "text": "他必不怕凶惡的信息；他心堅定，倚靠　耶和華。"
  },
  {
    "bookId": 19,
    "chapterId": 112,
    "verseId": 8,
    "text": "他心確定，總不懼怕，直到他看見他的敵人遭報。"
  },
  {
    "bookId": 19,
    "chapterId": 112,
    "verseId": 9,
    "text": "他施捨錢財，賙濟貧窮；他的仁義存到永遠。他的角必被高舉，大有榮耀。"
  },
  {
    "bookId": 19,
    "chapterId": 112,
    "verseId": 10,
    "text": "惡人看見便惱恨，必咬牙而消化；惡人的心願要歸滅絕。"
  }
]
