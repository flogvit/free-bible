[
  {
    "bookId": 19,
    "chapterId": 45,
    "verseId": 1,
    "text": "（可拉後裔的訓誨詩，又是愛慕歌，交與伶長。調用百合花。）我心裏湧出美辭；我論到我為王作的事，我的舌頭是快手筆。"
  },
  {
    "bookId": 19,
    "chapterId": 45,
    "verseId": 2,
    "text": "你比世人更美；在你嘴裏滿有恩典；所以　上帝賜福給你，直到永遠。"
  },
  {
    "bookId": 19,
    "chapterId": 45,
    "verseId": 3,
    "text": "至大的大能者啊，願你腰間佩刀，大有榮耀和威嚴！"
  },
  {
    "bookId": 19,
    "chapterId": 45,
    "verseId": 4,
    "text": "為真理、謙卑、公義赫然坐車前往，無不得勝；你的右手必顯明可畏的事。"
  },
  {
    "bookId": 19,
    "chapterId": 45,
    "verseId": 5,
    "text": "你的箭鋒快，射中王敵之心；眾民仆倒在你以下。"
  },
  {
    "bookId": 19,
    "chapterId": 45,
    "verseId": 6,
    "text": "上帝啊，你的寶座是永永遠遠的；你的囯權是正的。"
  },
  {
    "bookId": 19,
    "chapterId": 45,
    "verseId": 7,
    "text": "你喜愛公義，恨惡罪惡；所以　上帝─就是你的　上帝─用喜樂油膏你，勝過膏你的同伴。"
  },
  {
    "bookId": 19,
    "chapterId": 45,
    "verseId": 8,
    "text": "你的衣服都有沒藥、蘆薈、肉桂的香氣，象牙宮中的一切都使你歡喜。"
  },
  {
    "bookId": 19,
    "chapterId": 45,
    "verseId": 9,
    "text": "有君王的女兒在你尊貴婦女之中；王后佩戴俄斐金飾站在你右邊。"
  },
  {
    "bookId": 19,
    "chapterId": 45,
    "verseId": 10,
    "text": "女子啊，你要聽，要想，要側耳而聽！不要記念你的民和你的父家，"
  },
  {
    "bookId": 19,
    "chapterId": 45,
    "verseId": 11,
    "text": "王就大大羨慕你的美貌；因為他是你的主，你當敬拜他。"
  },
  {
    "bookId": 19,
    "chapterId": 45,
    "verseId": 12,
    "text": "女子推羅必來送禮；民中的富足人也必向你求恩。"
  },
  {
    "bookId": 19,
    "chapterId": 45,
    "verseId": 13,
    "text": "王女在宮裏極其榮華；她的衣服是用金線繡的。"
  },
  {
    "bookId": 19,
    "chapterId": 45,
    "verseId": 14,
    "text": "她要穿錦繡的衣服，被引到王前；隨從她的陪伴處女也要被帶到你面前。"
  },
  {
    "bookId": 19,
    "chapterId": 45,
    "verseId": 15,
    "text": "她們要歡喜快樂被引導；她們要進入王宮。"
  },
  {
    "bookId": 19,
    "chapterId": 45,
    "verseId": 16,
    "text": "你的子孫要接續你的列祖；你要立他們在全地作王。"
  },
  {
    "bookId": 19,
    "chapterId": 45,
    "verseId": 17,
    "text": "我必叫你的名被萬代記念，所以眾民要永永遠遠稱讚你。"
  }
]
