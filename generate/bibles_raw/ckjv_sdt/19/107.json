[
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 1,
    "text": "你們要稱謝　耶和華啊，因他本為善；他的慈愛永遠長存！"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 2,
    "text": "願　耶和華的贖民說這話，就是他從敵人手中所救贖的，"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 3,
    "text": "從各地，從東從西，從南從北，所招聚來的。"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 4,
    "text": "他們在曠野荒地漂流，尋不見可住的城邑，"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 5,
    "text": "又飢又渴，心裏發昏。"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 6,
    "text": "於是，他們在苦難中哀求　耶和華；他從他們的禍患中搭救他們，"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 7,
    "text": "又領他們行走直路，使他們往可居住的城邑。"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 8,
    "text": "但願人因　耶和華的慈愛和他向人所行的奇事都稱讚他！"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 9,
    "text": "因他使心裏渴慕的人得以知足，使心裏飢餓的人得飽美物。"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 10,
    "text": "那些坐在黑暗中、死蔭裏的人被困苦和鐵鏈捆鎖，"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 11,
    "text": "是因他們違背　上帝的話語，藐視至　高者的旨意。"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 12,
    "text": "所以，他用勞苦治服他們的心；他們仆倒，無人扶助。"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 13,
    "text": "於是，他們在苦難中哀求　耶和華；他從他們的禍患中拯救他們。"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 14,
    "text": "他從黑暗中和死蔭裏領他們出來，折斷他們的綁索。"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 15,
    "text": "但願人因　耶和華的慈愛和他向人所行的奇事都稱讚他！"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 16,
    "text": "因為他打破了銅門，砍斷了鐵閂。"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 17,
    "text": "愚妄人因自己的過犯和自己的罪孽便受苦楚。"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 18,
    "text": "他們心裏厭惡各樣的食物，就臨近死門。"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 19,
    "text": "於是，他們在苦難中哀求　耶和華；他從他們的禍患中拯救他們。"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 20,
    "text": "他發命醫治他們，救他們脫離死亡。"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 21,
    "text": "但願人因　耶和華的慈愛和他向人所行的奇事都稱讚他！"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 22,
    "text": "願他們以感謝為祭獻給他，歡呼述說他的作為！"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 23,
    "text": "在海上坐船，在大水中經理事務的，"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 24,
    "text": "他們看見　耶和華的作為，並他在深水中的奇事。"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 25,
    "text": "因他一吩咐，狂風就起來，海中的波浪也揚起。"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 26,
    "text": "他們上到天空，下到海底；他們的心因患難便消化。"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 27,
    "text": "他們搖搖幌幌，東倒西歪，好像醉酒的人；他們的智慧無法可施。"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 28,
    "text": "於是，他們在苦難中哀求　耶和華，他從他們的禍患中領出他們來。"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 29,
    "text": "他使狂風止息，波浪就平靜。"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 30,
    "text": "風息浪靜，他們便歡喜；他就引他們到所願去的海口。"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 31,
    "text": "但願人因　耶和華的慈愛和他向人所行的奇事都稱讚他！"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 32,
    "text": "願他們在民的會中尊崇他，在長老的位上讚美他！"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 33,
    "text": "他使江河變為曠野，叫水泉變為乾旱之地，"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 34,
    "text": "使肥地變為荒地；這都因其間居民的罪惡。"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 35,
    "text": "他使曠野變為水潭，叫旱地變為水泉。"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 36,
    "text": "他使飢餓的人住在那裏，好建造可住的城邑，"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 37,
    "text": "又種田地，栽葡萄園，得享所出的土產。"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 38,
    "text": "他又賜福給他們，叫他們生養眾多，也不叫他們的牲畜減少。"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 39,
    "text": "他們又因暴虐、患難、愁苦，就減少且卑下。"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 40,
    "text": "他使君王蒙羞被辱，使他們在曠野無路之地漂流。"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 41,
    "text": "他卻將窮乏人安置在高處，脫離苦難，使他的家屬多如羊群。"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 42,
    "text": "義人看見就歡喜；罪孽之輩必塞口無言。"
  },
  {
    "bookId": 19,
    "chapterId": 107,
    "verseId": 43,
    "text": "凡有智慧的，必在這些事上留心，也必明白　耶和華的慈愛。"
  }
]
