[
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 1,
    "text": "亞當後代的家譜記在下面。當　上帝創造人的日子，是照著　上帝的樣式造的；"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 2,
    "text": "他創造男女，並且賜福給他們。又在他們被造的日子，稱他們為「亞當」。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 3,
    "text": "亞當活到一百三十歲，生了一個兒子，形像樣式和自己相似，就給他起名叫塞特。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 4,
    "text": "亞當生下塞特之後，又在世八百年；並且他生兒養女；"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 5,
    "text": "亞當共活了九百三十歲就死了。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 6,
    "text": "塞特活到一百零五歲，生了以挪士；"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 7,
    "text": "塞特生以挪士之後，又活了八百零七年，並且生兒養女；"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 8,
    "text": "塞特共活了九百一十二歲就死了。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 9,
    "text": "以挪士活到九十歲，生了該南；"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 10,
    "text": "以挪士生該南之後，又活了八百一十五年，並且生兒養女；"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 11,
    "text": "以挪士共活了九百零五歲就死了。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 12,
    "text": "該南活到七十歲，生了瑪勒列。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 13,
    "text": "該南生瑪勒列之後，又活了八百四十年，並且生兒養女。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 14,
    "text": "該南共活了九百一十歲就死了。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 15,
    "text": "瑪勒列活到六十五歲，生了雅列。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 16,
    "text": "瑪勒列生雅列之後，又活了八百三十年，並且生兒養女。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 17,
    "text": "瑪勒列共活了八百九十五歲就死了。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 18,
    "text": "雅列活到一百六十二歲，生了以諾。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 19,
    "text": "雅列生以諾之後，又活了八百年，並且生兒養女。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 20,
    "text": "雅列共活了九百六十二歲就死了。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 21,
    "text": "以諾活到六十五歲，生了瑪土撒拉。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 22,
    "text": "以諾生瑪土撒拉之後，與　上帝同行三百年，並且生兒養女。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 23,
    "text": "以諾共活了三百六十五歲。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 24,
    "text": "以諾與　上帝同行，　上帝將他取去，他就不在世了。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 25,
    "text": "瑪土撒拉活到一百八十七歲，生了拉麥。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 26,
    "text": "瑪土撒拉生拉麥之後，又活了七百八十二年，並且生兒養女。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 27,
    "text": "瑪土撒拉共活了九百六十九歲就死了。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 28,
    "text": "拉麥活到一百八十二歲，生了一個兒子，"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 29,
    "text": "給他起名叫挪亞，說：「這個兒子必為我們的操作和手中的勞苦安慰我們；這操作勞苦是因為　耶和華咒詛地。」"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 30,
    "text": "拉麥生挪亞之後，又活了五百九十五年，並且生兒養女。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 31,
    "text": "拉麥共活了七百七十七歲就死了。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 32,
    "text": "挪亞五百歲生了閃、含、雅弗。"
  }
]
