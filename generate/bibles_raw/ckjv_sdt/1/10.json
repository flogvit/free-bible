[
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 1,
    "text": "挪亞的兒子閃、含、雅弗的後代記在下面。洪水以後，他們都生了兒子。"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 2,
    "text": "雅弗的兒子是歌篾、瑪各、瑪代、雅完、土巴、米設、提拉。"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 3,
    "text": "歌篾的兒子是亞實基拿、利法、陀迦瑪。"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 4,
    "text": "雅完的兒子是以利沙、他施、基提、多單。"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 5,
    "text": "這些人的後裔將外邦人的地土、海島分開居住；各隨各的方言、宗族立國。"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 6,
    "text": "含的兒子是古實、麥西、弗、迦南。"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 7,
    "text": "古實的兒子是西巴、哈腓拉、撒弗他、拉瑪、撒弗提迦。拉瑪的兒子是示巴、底但。"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 8,
    "text": "古實又生寧錄，他在世上成了勇士。"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 9,
    "text": "他在　耶和華面前是個英勇的獵戶，所以俗語說：「像寧錄在　耶和華面前是個英勇的獵戶。」"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 10,
    "text": "他囯的起頭是巴別、以力、亞甲、甲尼，都在示拿地。"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 11,
    "text": "他從那地出來往亞述去，建造尼尼微、利河伯、迦拉，"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 12,
    "text": "和尼尼微、迦拉中間的利鮮，這就是那大城。"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 13,
    "text": "麥西生路低人、亞拿米人、利哈比人、拿弗土希人、"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 14,
    "text": "帕斯魯細人、迦斯路希人、從迦斯路希人出來的非利士人、迦斐託人。"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 15,
    "text": "迦南生長子西頓，又生赫"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 16,
    "text": "和耶布斯人、亞摩利人、革迦撒人、"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 17,
    "text": "希未人、亞基人、西尼人、"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 18,
    "text": "亞瓦底人、洗瑪利人、哈馬人，後來迦南的諸族分散了。"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 19,
    "text": "迦南的境界是從西頓向基拉耳的路上，直到迦薩，又向所多瑪、蛾摩拉、押瑪、洗扁的路上，直到拉沙。"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 20,
    "text": "這就是含的後裔，各隨他們的宗族、方言，所住的地土、邦國。"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 21,
    "text": "長兄雅弗的兄弟閃，是希伯子孫之祖，他也生了孩子。"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 22,
    "text": "閃的兒子是以攔、亞述、亞法撒、路德、亞蘭。"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 23,
    "text": "亞蘭的兒子是烏斯、戶勒、基帖、瑪施。"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 24,
    "text": "亞法撒生沙拉；沙拉生希伯。"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 25,
    "text": "希伯生了兩個兒子，一個名叫法勒，在他那時地已被分開；法勒的兄弟名叫約坍。"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 26,
    "text": "約坍生亞摩答、沙列、哈薩瑪非、耶拉、"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 27,
    "text": "哈多蘭、烏薩、德拉、"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 28,
    "text": "俄巴路、亞比瑪利、示巴、"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 29,
    "text": "阿斐、哈腓拉、約巴，這都是約坍的兒子。"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 30,
    "text": "他們所住的地方是從米沙直到西發東邊的山。"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 31,
    "text": "這就是閃的子孫，各隨他們的宗族、方言，所住的地土、邦國。"
  },
  {
    "bookId": 1,
    "chapterId": 10,
    "verseId": 32,
    "text": "這些都是挪亞三個兒子的宗族，各隨他們的支派立國。洪水以後，他們在地上分為邦國。"
  }
]
