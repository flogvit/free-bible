[
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 1,
    "text": "耶和華曉諭摩西說："
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 2,
    "text": "「長大痲瘋得潔淨的日子，其例乃是這樣：要帶他去見祭司；"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 3,
    "text": "祭司要出到營外察看，若見他的大痲瘋痊癒了，"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 4,
    "text": "就要吩咐人為那求潔淨的拿兩隻潔淨的活鳥和香柏木、朱紅色線，並牛膝草來。"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 5,
    "text": "祭司要吩咐用瓦器盛活水，把一隻鳥宰在上面。"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 6,
    "text": "至於那隻活鳥，祭司要把牠和香柏木、朱紅色線並牛膝草一同蘸於宰在活水上的鳥血中，"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 7,
    "text": "用以在那長大痲瘋求潔淨的人身上灑七次，就宣告他為潔淨，又把活鳥放在田野裏。"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 8,
    "text": "求潔淨的人當洗衣服，剃去毛髮，用水洗澡，就潔淨了；然後可以進營，只是要在自己的帳棚外居住七天。"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 9,
    "text": "第七天，再把頭上所有的頭髮與鬍鬚、眉毛，並全身的毛，都剃了；又要洗衣服，用水洗身，就潔淨了。"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 10,
    "text": "「第八天，他要取兩隻沒有殘疾的公綿羊羔和一隻沒有殘疾、一歲的母綿羊羔，又要把調油的細麵伊法的十分之三為素祭，並油一羅革，一同取來。"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 11,
    "text": "行潔淨之禮的祭司要將那求潔淨的人和這些東西安置在會幕門口、　耶和華面前。"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 12,
    "text": "祭司要取一隻公綿羊羔獻為贖愆祭，和那一羅革油一同搖一搖，在　耶和華面前作搖祭；"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 13,
    "text": "把這綿羊羔宰於聖地，就是宰贖罪祭牲和燔祭牲之地；贖愆祭要歸祭司，與贖罪祭一樣；是至聖的；"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 14,
    "text": "祭司要取些贖愆祭牲的血，抹在求潔淨人的右耳垂上和右手的大拇指上，並右腳的大拇指上。"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 15,
    "text": "祭司要從那一羅革油中取些倒在自己的左手掌裏，"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 16,
    "text": "把右手的一個指頭蘸在左手的油裏，在　耶和華面前用指頭彈七次。"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 17,
    "text": "將手裏所剩的油抹在那求潔淨人的右耳垂上和右手的大拇指上，並右腳的大拇指上，就是抹在贖愆祭牲的血上。"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 18,
    "text": "祭司手裏所剩的油要抹在那求潔淨人的頭上，在　耶和華面前為他贖罪。"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 19,
    "text": "祭司要獻贖罪祭，為那本不潔淨、求潔淨的人贖罪；然後要宰燔祭牲，"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 20,
    "text": "把燔祭和素祭獻在壇上，為他贖罪，他就潔淨了。"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 21,
    "text": "「他若貧窮不能預備夠數，就要取一隻綿羊羔作贖愆祭，可以搖一搖，為他贖罪；也要把調油的細麵伊法的十分之一為素祭，和油一羅革一同取來；"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 22,
    "text": "又照他的能力取兩隻斑鳩或是兩隻雛鴿，一隻作贖罪祭，一隻作燔祭。"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 23,
    "text": "第八天，要為潔淨，把這些帶到會幕門口、　耶和華面前，交給祭司。"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 24,
    "text": "祭司要把贖愆祭的綿羊羔和那一羅革油一同搖一搖，在　耶和華面前作搖祭。"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 25,
    "text": "要宰了贖愆祭的綿羊羔，取些贖愆祭牲的血，抹在那求潔淨人的右耳垂上和右手的大拇指上，並右腳的大拇指上。"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 26,
    "text": "祭司要把些油倒在自己的左手掌裏，"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 27,
    "text": "把左手裏的油，在　耶和華面前，用右手的一個指頭彈七次，"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 28,
    "text": "又把手裏的油抹些在那求潔淨人的右耳垂上和右手的大拇指上，並右腳的大拇指上，就是抹贖愆祭之血的原處。"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 29,
    "text": "祭司手裏所剩的油要抹在那求潔淨人的頭上，在　耶和華面前為他贖罪。"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 30,
    "text": "那人又要照他的力量獻上一隻斑鳩或是一隻雛鴿，"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 31,
    "text": "就是他所能辦的，一隻為贖罪祭，一隻為燔祭，與素祭一同獻上；祭司要在　耶和華面前為他贖罪。"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 32,
    "text": "這是那有大痲瘋災病的人、不能將關乎得潔淨之物預備夠數的條例。」"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 33,
    "text": "耶和華曉諭摩西、亞倫說："
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 34,
    "text": "「你們到了我賜給你們為業的迦南地，我若使你們所得為業之地的房屋中有大痲瘋的災病，"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 35,
    "text": "房主就要去告訴祭司說：『據我看，房屋中似乎有災病。』"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 36,
    "text": "祭司還沒有進去察看災病以前，就要吩咐人把房子騰空，免得房子裏所有的都成了不潔淨；然後祭司要進去察看房子。"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 37,
    "text": "他要察看那災病，若見災病在房子的牆上有發綠或發紅的凹斑紋，現象窪於牆，"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 38,
    "text": "祭司就要出到房門外，把房子封鎖七天。"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 39,
    "text": "第七天，祭司要再去察看，見災病若在房子的牆上發散，"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 40,
    "text": "就要吩咐人把那有災病的石頭挖出來，扔在城外不潔淨之處；"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 41,
    "text": "也要叫人刮房內的四圍，所刮掉的灰泥要倒在城外不潔淨之處；"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 42,
    "text": "又要用別的石頭代替那挖出來的石頭，要另用灰泥墁房子。"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 43,
    "text": "「他挖出石頭，刮了房子，墁了以後，災病若在房子裏又發現，"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 44,
    "text": "祭司就要進去察看，見災病若在房子裏發散，這就是房內蠶食的大痲瘋，是不潔淨。"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 45,
    "text": "他就要拆毀房子，把石頭、木頭、灰泥都搬到城外不潔淨之處。"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 46,
    "text": "並且在房子封鎖的時候，進去的人必不潔淨到晚上；"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 47,
    "text": "在房子裏躺著的必洗衣服；在房子裏吃飯的也必洗衣服。"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 48,
    "text": "「房子墁了以後，祭司若進去察看，見災病在房內沒有發散，就要宣告房子為潔淨，因為災病已經消除。"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 49,
    "text": "要為潔淨房子取兩隻鳥和香柏木、朱紅色線並牛膝草，"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 50,
    "text": "用瓦器盛活水，把一隻鳥宰在上面，"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 51,
    "text": "把香柏木、牛膝草、朱紅色線，並那活鳥，都蘸在被宰的鳥血中與活水中，用以灑房子七次。"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 52,
    "text": "要用鳥血、活水、活鳥、香柏木、牛膝草，並朱紅色線，潔淨那房子。"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 53,
    "text": "但要把活鳥放在城外田野裏。這樣為房子贖罪，房子就潔淨了。」"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 54,
    "text": "這是為各類大痲瘋的災病和頭疥，"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 55,
    "text": "並衣服與房子的大痲瘋，"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 56,
    "text": "以及癤子、癬、火斑所立的條例，"
  },
  {
    "bookId": 3,
    "chapterId": 14,
    "verseId": 57,
    "text": "指明何時為潔淨，何時為不潔淨。這是大痲瘋的條例。"
  }
]
