[
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 1,
    "text": "惡人雖無人追趕也逃跑；義人卻膽壯像獅子。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 2,
    "text": "邦國因有罪過，君王就多更換；因有聰明知識的人，國必長存。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 3,
    "text": "窮人欺壓貧民，好像暴雨沖沒糧食。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 4,
    "text": "違棄律法的，誇獎惡人；遵守律法的，卻與惡人相爭。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 5,
    "text": "壞人不明白公義；唯有尋求　耶和華的明白一切。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 6,
    "text": "行為正直的窮乏人勝過行事乖僻的富足人。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 7,
    "text": "謹守律法的，是智慧之子；與放縱之人作伴的，卻羞辱其父。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 8,
    "text": "人以放債與不義之財加增財物，是給那憐憫窮人者積蓄的。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 9,
    "text": "轉耳不聽律法的，他的祈禱也為可憎。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 10,
    "text": "誘惑義人行惡道的，必掉在自己的坑裏；唯有正直人必承受福分。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 11,
    "text": "富足人自以為有智慧，但聰明的貧窮人能將他查透。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 12,
    "text": "義人歡喜，有大榮耀；惡人興起，人就躲藏。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 13,
    "text": "遮掩自己罪過的，必不亨通；承認離棄罪過的，必蒙憐恤。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 14,
    "text": "常存敬畏的，便為有福；心存剛硬的，必陷在禍患裏。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 15,
    "text": "暴虐的君王轄制貧民，好像吼叫的獅子、覓食的熊。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 16,
    "text": "無知的君多行暴虐；以貪財為可恨的，必年長日久。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 17,
    "text": "行強暴流人血之罪的，必往坑裏逃跑，誰也不可攔阻他。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 18,
    "text": "行動正直的，必蒙拯救；行事彎曲的，立時跌倒。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 19,
    "text": "耕種自己田地的，必得飽食；追隨虛浮的，足受窮乏。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 20,
    "text": "誠實人必多得福；想要急速發財的，不免受罰。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 21,
    "text": "看人的情面乃為不好；人因一塊餅枉法也為不好。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 22,
    "text": "人有惡眼想要急速發財，卻不知窮乏必臨到他身。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 23,
    "text": "責備人的，後來蒙人喜悅，多於那用舌頭諂媚人的。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 24,
    "text": "偷竊父母的，說：這不是罪；此人就是與行毀壞的同類。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 25,
    "text": "心中驕傲的，挑起爭端；倚靠　耶和華的，必得豐裕。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 26,
    "text": "心中自是的，便是愚昧人；憑智慧行事的，必蒙拯救。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 27,
    "text": "賙濟貧窮的，不致缺乏；佯為不見的，必多受咒詛。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 28,
    "text": "惡人興起，人就躲藏；惡人敗亡，義人增多。"
  }
]
