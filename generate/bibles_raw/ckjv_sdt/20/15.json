[
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 1,
    "text": "回答柔和，使怒消退；言語暴戾，觸動怒氣。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 2,
    "text": "智慧人的舌善用知識；愚昧人的口吐出愚昧。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 3,
    "text": "耶和華的眼目無處不在；惡人善人，他都鑒察。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 4,
    "text": "溫良的舌是生命樹；乖謬的嘴是靈裏的破口。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 5,
    "text": "愚妄人藐視父親的訓誨；領受責備的，為有見識。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 6,
    "text": "義人家中多有財寶；惡人得利反受擾害。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 7,
    "text": "智慧人的嘴播揚知識；愚昧人的心並不如此。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 8,
    "text": "惡人獻祭，為　耶和華所憎惡；正直人祈禱，為他所喜悅。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 9,
    "text": "惡人的道路，為　耶和華所憎惡；追求公義的，為他所喜愛。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 10,
    "text": "捨棄正路的，必受嚴刑；恨惡責備的，必致死亡。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 11,
    "text": "地獄和滅亡，尚在　耶和華眼前，何況世人的心呢。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 12,
    "text": "褻慢人不愛責備他的；他也不就近智慧人。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 13,
    "text": "心中喜樂，面帶笑容；心裏憂愁，靈被損傷。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 14,
    "text": "聰明人心求知識；愚昧人口吃愚昧。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 15,
    "text": "困苦人的日子都是愁苦；心中歡暢的，常享豐筵。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 16,
    "text": "少有財寶，敬畏　耶和華，強如多有財寶，煩亂不安。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 17,
    "text": "吃素菜，彼此相愛，強如吃肥牛，彼此相恨。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 18,
    "text": "暴怒的人挑啟爭端；忍怒的人止息紛爭。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 19,
    "text": "懶惰人的道像荊棘的籬笆；義人的路是平坦的大道。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 20,
    "text": "智慧子使父親喜樂；愚昧人藐視母親。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 21,
    "text": "無知的人以愚妄為樂；聰明的人按正直而行。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 22,
    "text": "不先商議，所謀無效；謀士眾多，所謀乃成。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 23,
    "text": "口善應對，自覺喜樂；話合其時，何等美好！"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 24,
    "text": "生命的道在智慧人上頭，使他遠離在下的地獄。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 25,
    "text": "耶和華必拆毀驕傲人的家，卻要立定寡婦的地界。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 26,
    "text": "惡人的思念為　耶和華所憎惡；純潔人的言語乃為良言。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 27,
    "text": "貪戀財利的，擾害己家；恨惡賄賂的，必得存活。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 28,
    "text": "義人的心，思量如何回答；惡人的口吐出惡言。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 29,
    "text": "耶和華遠離惡人，卻聽義人的禱告。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 30,
    "text": "眼有光，使心喜樂；好信息，使骨滋潤。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 31,
    "text": "聽從生命責備的，必常在智慧人中。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 32,
    "text": "不受訓誨的，輕看自己的生命；聽從責備的，卻得智慧。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 33,
    "text": "敬畏　耶和華是智慧的訓誨；尊榮以前，必有謙卑。"
  }
]
