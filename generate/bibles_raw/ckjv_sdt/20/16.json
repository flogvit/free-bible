[
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 1,
    "text": "心中的謀算在人裏頭，舌頭的應對由於　耶和華。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 2,
    "text": "人一切所行的，在自己眼中看為清潔；唯有　耶和華衡量心靈。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 3,
    "text": "你所作的，要交託　耶和華，你所謀的，就必成立。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 4,
    "text": "耶和華所造的，各為己用；就是惡人也為禍患的日子所造。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 5,
    "text": "凡心裏驕傲的，為　耶和華所憎惡；雖然連手，他必不免受罰。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 6,
    "text": "因憐憫誠實，罪孽得贖；敬畏　耶和華的，遠離惡事。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 7,
    "text": "人所行的，若蒙　耶和華喜悅，　耶和華也使他的仇敵與他和好。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 8,
    "text": "少有財利，行事公義，強如多有財利，行事不正。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 9,
    "text": "人心籌算自己的道路；唯　耶和華指引他的腳步。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 10,
    "text": "王的嘴中有神語；審判之時，他的口不致差錯。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 11,
    "text": "公道的天平和秤都屬　耶和華；囊中一切法碼都為他所定。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 12,
    "text": "作惡，為王所憎惡，因國位是靠公義堅立。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 13,
    "text": "公義的嘴為王所喜悅；說正確話的，為王所喜愛。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 14,
    "text": "王的震怒如殺人的使者；但智慧人能止息王怒。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 15,
    "text": "王的臉光使人有生命；王的恩典好像春雲時雨。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 16,
    "text": "得智慧勝過得金子！選聰明強如選銀子！"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 17,
    "text": "正直人的道是遠離惡事；謹守己路的，是保全性命。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 18,
    "text": "驕傲在敗壞以先；狂傲的心靈在跌倒之前。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 19,
    "text": "靈裏謙卑與低微人來往，強如將擄物與驕傲人同分。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 20,
    "text": "辦事精明的，必得好處；倚靠　耶和華的，便為有福。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 21,
    "text": "心中有智慧，必稱為通達人；嘴中的甜言，加增人的學問。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 22,
    "text": "人有智慧就有生命的泉源；愚昧人的訓誨卻是愚昧。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 23,
    "text": "智慧人的心教訓他的口，又使他的嘴增長學問。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 24,
    "text": "良言如同蜂房，使心覺甘甜，使骨得醫治。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 25,
    "text": "有一條路，人以為正，至終成為死亡之路。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 26,
    "text": "勞力人的胃口使他勞力，因為他的口腹催逼他。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 27,
    "text": "不敬虔的人圖謀奸惡，嘴上彷彿有燒焦的火。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 28,
    "text": "乖僻人播散紛爭；傳舌的，離間密友。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 29,
    "text": "強暴人誘惑鄰舍，領他走不善之道。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 30,
    "text": "眼目緊合的，圖謀乖僻；移動嘴唇的，成就邪惡。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 31,
    "text": "白髮是榮耀的冠冕，在公義的道上必能得著。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 32,
    "text": "不輕易發怒的，勝過勇士；治服己靈的，強如取城。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 33,
    "text": "籤放在懷裏，定事由　耶和華。"
  }
]
