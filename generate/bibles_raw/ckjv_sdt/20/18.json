[
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 1,
    "text": "與眾寡合的，獨自尋求心願，並以一切智慧尋找和干與事。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 2,
    "text": "愚昧人不喜愛明哲，只喜愛顯露心意。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 3,
    "text": "惡人來，藐視隨來；羞恥到，辱罵同到。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 4,
    "text": "人口中的言語如同深水；智慧的泉源好像湧流的河水。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 5,
    "text": "瞻徇惡人的情面，顛倒義人的案件，都為不善。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 6,
    "text": "愚昧人張嘴啟爭端，開口招鞭打。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 7,
    "text": "愚昧人的口自取敗壞；他的嘴是他生命的網羅。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 8,
    "text": "傳舌人的言語如同損傷，深入人的心腹。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 9,
    "text": "作工懈怠的，與浪費人為兄弟。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 10,
    "text": "耶和華的名是堅固臺；義人奔入便得安穩。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 11,
    "text": "富足人的財物是他的堅城，在他心想，猶如高牆。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 12,
    "text": "敗壞之先，人心驕傲；尊榮以前，必有謙卑。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 13,
    "text": "未曾聽完先回答的，便是他的愚昧和羞辱。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 14,
    "text": "人有疾病，心能忍耐；心靈受傷，誰能承當呢？"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 15,
    "text": "聰明人的心得知識；智慧人的耳求知識。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 16,
    "text": "人的禮物為他開路，引他到高位的人面前。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 17,
    "text": "先訴情由的，似乎有理；但鄰舍來到，就察出實情。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 18,
    "text": "擲籤能止息爭競，也能解散強勝的人。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 19,
    "text": "兄弟結怨，勸他和好，比取堅固城還難；這樣的爭競如同堅寨的門閂。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 20,
    "text": "人口中所結的果子，必充滿肚腹；他嘴所出的，必使他飽足。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 21,
    "text": "生死在舌頭的權下，喜愛它的，必吃它所結的果子。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 22,
    "text": "得著賢妻的，是得著好處，也是蒙了　耶和華的恩惠。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 23,
    "text": "貧窮人說哀求的話；富足人用威嚇的話回答。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 24,
    "text": "人有朋友，必須顯為友善；但有一朋友比兄弟更親密。"
  }
]
