[
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 1,
    "text": "智慧建造房屋，鑿成七根柱子；"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 2,
    "text": "她宰了牲畜；調好旨酒；又擺了筵席。"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 3,
    "text": "她打發使女出去；自己在城中至高處呼叫，"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 4,
    "text": "說：誰是愚蒙人，可以轉到這裏來！又對那無知的人說："
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 5,
    "text": "你們來，吃我的餅，喝我調和的酒。"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 6,
    "text": "要捨棄愚蒙，就得存活，並要走聰明的道。"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 7,
    "text": "指斥褻慢人的，必受辱罵；責備惡人的，必被玷污。"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 8,
    "text": "不要責備褻慢人，恐怕他恨你；要責備智慧人，他必愛你。"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 9,
    "text": "指示智慧人，他就越發有智慧；教導義人，他就增長學問。"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 10,
    "text": "敬畏　耶和華是智慧的開端；認識至聖者便是聰明。"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 11,
    "text": "你藉著我，日子必增多，年歲也必加添。"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 12,
    "text": "你若有智慧，是與自己有益；你若褻慢，就必獨自擔當。"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 13,
    "text": "愚昧的婦人喧嚷；她是愚蒙，一無所知。"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 14,
    "text": "她坐在自己的家門口，坐在城中高處的座位上，"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 15,
    "text": "呼叫過路的，就是直行其道的人，"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 16,
    "text": "說：誰是愚蒙人，可以轉到這裏來！又對那無知的人說："
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 17,
    "text": "偷來的水是甜的，暗吃的餅是好的。"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 18,
    "text": "人卻不知有陰魂在她那裏，她的客在地獄的深處。"
  }
]
