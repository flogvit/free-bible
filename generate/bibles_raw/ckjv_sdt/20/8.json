[
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 1,
    "text": "智慧豈不呼叫？聰明豈不發聲？"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 2,
    "text": "她站在高處的頂上，在十字路口旁邊站立。"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 3,
    "text": "在城門旁，在城門口，在城門洞，大聲說："
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 4,
    "text": "眾人哪，我呼叫你們，我向世人發聲。"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 5,
    "text": "說：愚蒙人哪，你們要會悟智慧；愚昧人哪，你們當心裏明白。"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 6,
    "text": "你們當聽，因我要說極美的話；我張嘴要論正確的事。"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 7,
    "text": "我的口要發出真理；我的嘴憎惡邪惡。"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 8,
    "text": "我口中的言語都是公義，並無邪僻乖謬。"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 9,
    "text": "有聰明的，以為明顯，得知識的，以為正確。"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 10,
    "text": "你們當受我的教訓，不受白銀；寧得知識，勝過黃金。"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 11,
    "text": "因為智慧比紅寶石更美；一切可喜愛的都不足與比較。"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 12,
    "text": "我─智慧以靈明為居所，又尋得知識和謀略。"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 13,
    "text": "敬畏　耶和華在乎恨惡邪惡；那驕傲、狂妄，並惡道，以及乖謬的口，都為我所恨惡。"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 14,
    "text": "我有謀略和真智慧；我乃聰慧，我有能力。"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 15,
    "text": "帝王藉我坐國位；君王藉我定公平。"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 16,
    "text": "王子和首領，世上一切的審判官，都是藉我掌權。"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 17,
    "text": "愛我的，我也愛他；早早尋求我的，必尋得見。"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 18,
    "text": "豐富尊榮在我；恆久的財並公義也在我。"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 19,
    "text": "我的果實勝過黃金，強如精金；我的出產超乎高銀。"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 20,
    "text": "我在公義的道上走，在公平的路中行，"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 21,
    "text": "使愛我的，承受貨財；我又要充滿他們的府庫。"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 22,
    "text": "在　耶和華道路的起頭，在太初創造萬物之先，就得了我。"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 23,
    "text": "從恆古，從太初，未有世界以前，我已被立。"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 24,
    "text": "沒有深淵，沒有大水的泉源，我已生出。"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 25,
    "text": "大山未曾奠定，小山未有之先，我已生出。"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 26,
    "text": "耶和華還沒有創造大地和田野，並世上的土質，我已生出。"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 27,
    "text": "他預備諸天，我在那裏；他在淵面的周圍，劃出圓圈；"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 28,
    "text": "上使穹蒼堅硬，下使淵源穩固，"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 29,
    "text": "為滄海定出界限，使水不越過他的命令，立定大地的根基。"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 30,
    "text": "那時，我在他那裏，他養育我，日日為他所喜愛，常常在他面前歡喜，"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 31,
    "text": "歡喜在他為人預備可住之地，也喜悅住在世人之間。"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 32,
    "text": "眾子啊，現在要聽從我，因為謹守我道的，便為有福。"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 33,
    "text": "要聽教訓就得智慧，不可不從。"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 34,
    "text": "聽從我、日日在我門口仰望、在我門框旁邊等候的，那人便為有福。"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 35,
    "text": "因為尋得我的，就尋得生命，也必蒙　耶和華的恩惠。"
  },
  {
    "bookId": 20,
    "chapterId": 8,
    "verseId": 36,
    "text": "得罪我的，卻害了自己的性命；恨惡我的，都喜愛死亡。"
  }
]
