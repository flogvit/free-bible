[
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 1,
    "text": "智慧子聽父親的教訓；褻慢人不聽責備。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 2,
    "text": "人因口所結的果子，必吃美物；犯法的人必吃強暴。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 3,
    "text": "謹守口的，得保生命；大張嘴的，必致敗亡。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 4,
    "text": "懶惰人羨慕，卻無所得；殷勤人必得豐裕。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 5,
    "text": "義人恨惡謊言；惡人有臭名，且致慚愧。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 6,
    "text": "行為正直的，有公義保守；犯罪的，被邪惡傾覆。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 7,
    "text": "有使自己富足的，卻一無所有；有使自己窮乏的，卻廣有財物。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 8,
    "text": "人的資財是他生命的贖價；窮乏人卻不聽責備。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 9,
    "text": "義人的光歡喜；惡人的燈必熄滅。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 10,
    "text": "只因驕傲，便啟爭競；聽勸言的，卻有智慧。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 11,
    "text": "不勞而得之財必然消耗；勤勞積蓄的，必見加增。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 12,
    "text": "所盼望的遲延未得，令人心憂；所願意的臨到，卻是生命樹。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 13,
    "text": "藐視訓言的，必致滅亡；敬畏誡命的，必得善報。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 14,
    "text": "智慧人的法則是生命的泉源，可以使人離開死亡的網羅。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 15,
    "text": "美好的聰明使人蒙恩；犯法之人的道路卻是難行。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 16,
    "text": "凡通達人都憑知識處事；愚昧人張揚自己的愚昧。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 17,
    "text": "奸惡的使者必遭害；忠信的使臣乃醫人的良藥。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 18,
    "text": "不受訓誨的，必致貧受辱；領受責備的，必得尊榮。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 19,
    "text": "所願的成就，心覺甘甜；遠離惡事，為愚昧人所憎惡。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 20,
    "text": "與智慧人同行的，必得智慧；和愚昧人作伴的，必致滅亡。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 21,
    "text": "禍患追趕罪人；義人必得善報。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 22,
    "text": "善人給子孫遺留產業；罪人為義人積存資財。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 23,
    "text": "窮人耕種多得糧食，但因無公義，有消滅的。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 24,
    "text": "不忍用杖打兒子的，是恨惡他；疼愛兒子的，趁早管教。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 25,
    "text": "義人吃得飽足；惡人肚腹缺糧。"
  }
]
