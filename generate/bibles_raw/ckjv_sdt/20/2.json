[
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 1,
    "text": "我兒，你若領受我的言語，存記我的命令，"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 2,
    "text": "側耳聽智慧，專心求聰明，"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 3,
    "text": "呼求明哲，揚聲求聰明，"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 4,
    "text": "尋找她，如尋找銀子，搜求她，如搜求隱藏的珍寶，"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 5,
    "text": "你就明白敬畏　耶和華，得以認識　上帝。"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 6,
    "text": "因為，　耶和華賜人智慧；知識和聰明都由他口而出。"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 7,
    "text": "他給義人存留真智慧；他乃行事正直之人的盾牌。"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 8,
    "text": "他要保守公平人的路，護庇他聖民的道。"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 9,
    "text": "你也必明白仁義、公平、公正、一切的善道。"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 10,
    "text": "智慧必入你心；你的魂要以知識為美。"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 11,
    "text": "謀略必護衛你；聰明必保守你，"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 12,
    "text": "要救你脫離惡人的道，脫離說乖謬話的人。"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 13,
    "text": "那等人捨棄正直的路，行走黑暗的道，"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 14,
    "text": "歡喜作惡，喜愛惡人的乖僻，"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 15,
    "text": "在他們的道中彎曲，在他們的路上偏僻。"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 16,
    "text": "智慧要救你脫離外女，就是那油嘴滑舌的外人。"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 17,
    "text": "她離棄幼年的引導，忘了　上帝的盟約。"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 18,
    "text": "她的家陷入死地；她的路偏向死人。"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 19,
    "text": "凡到她那裏去的，不得轉回，也得不著生命的路。"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 20,
    "text": "智慧必使你行善人的道，守義人的路。"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 21,
    "text": "正直人必在世上居住；完全人必在地上存留。"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 22,
    "text": "唯有惡人必然剪除；犯法的，必然拔出。"
  }
]
