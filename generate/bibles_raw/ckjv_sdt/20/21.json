[
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 1,
    "text": "王的心在　耶和華手中，好像隴溝的水隨意流轉。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 2,
    "text": "人所行的，在自己眼中都看為正；唯有　耶和華衡量人心。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 3,
    "text": "行仁義公平比獻祭更蒙　耶和華悅納。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 4,
    "text": "眼高心傲，並惡人耕地，皆為罪惡。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 5,
    "text": "殷勤籌劃的，足致豐裕；行事急躁的，都必缺乏。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 6,
    "text": "以撒謊之舌求財，乃取死之人反覆的妄行。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 7,
    "text": "惡人所搶奪的必將自己掃除；因他們不肯按公平行事。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 8,
    "text": "人的道路乖僻怪異；至於純潔的人，他所作的乃是正確。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 9,
    "text": "寧可住在房頂的角上，不在寬闊的房屋與爭吵的婦人同住。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 10,
    "text": "惡人的心樂人受禍；他眼並不喜悅鄰舍。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 11,
    "text": "褻慢的人受刑罰，愚蒙的人就得智慧；智慧人受訓誨，便得知識。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 12,
    "text": "義人智慧地思想惡人的家，知道　上帝因為惡人的邪惡而傾倒他們。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 13,
    "text": "塞耳不聽窮人呼求的，他將來呼求也不蒙聽允。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 14,
    "text": "暗中送的禮物挽回怒氣；懷中搋的餽贈止息暴怒。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 15,
    "text": "秉公行義使義人喜樂；敗壞必臨到作孽之人。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 16,
    "text": "迷離通達道路的，必住在陰魂的會中。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 17,
    "text": "愛宴樂的，必致窮乏；好酒，愛膏油的，必不富足。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 18,
    "text": "惡人必作義人的贖價，犯法的人代替正直人。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 19,
    "text": "寧可住在曠野，不與爭吵使氣的婦人同住。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 20,
    "text": "智慧人家中積蓄寶物膏油；愚昧人隨得來隨花盡。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 21,
    "text": "追求公義仁慈的，就尋得生命、公義，和尊榮。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 22,
    "text": "智慧人爬上勇士的城牆，傾覆他所倚靠的堅壘。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 23,
    "text": "謹守口與舌的，就保守自己免受災難。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 24,
    "text": "心驕氣傲的人名叫褻慢，都是行事傲怒。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 25,
    "text": "懶惰人的心願將他殺害，因為他手不肯作工。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 26,
    "text": "有終日貪得無饜的；義人施捨而不吝惜。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 27,
    "text": "惡人的祭物是可憎的；何況他存惡意來獻呢？"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 28,
    "text": "作假見證的必滅亡；唯有聽真情而言的，其言長存。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 29,
    "text": "惡人硬著臉面；至於正直人，他卻指引他的道。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 30,
    "text": "沒有智慧、聰明、謀略能以敵擋　耶和華"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 31,
    "text": "馬是為打仗之日預備的；安穩乃在乎　耶和華。"
  }
]
