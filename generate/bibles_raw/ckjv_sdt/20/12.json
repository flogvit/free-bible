[
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 1,
    "text": "喜愛訓誨的，就是喜愛知識；恨惡責備的，卻是畜類。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 2,
    "text": "善人必蒙　耶和華的恩惠；設惡計的人，他必定他的罪。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 3,
    "text": "人靠惡行不能堅立；義人的根必不動搖。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 4,
    "text": "才德的婦人是丈夫的冠冕；貽羞的婦人如同朽爛在她丈夫的骨中。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 5,
    "text": "義人的思念是公平；惡人的計謀是詭詐。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 6,
    "text": "惡人的言論是埋伏流人的血；正直人的口必拯救人。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 7,
    "text": "惡人傾覆，歸於無有；義人的家必站得住。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 8,
    "text": "人必按自己的智慧被稱讚；心中乖謬的，必被藐視。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 9,
    "text": "被人輕賤，卻有僕人，強如自尊，缺少食物。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 10,
    "text": "義人顧惜他牲畜的命；惡人的憐憫也是殘忍。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 11,
    "text": "耕種自己田地的，必得飽食；追隨虛浮人的，卻是無知。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 12,
    "text": "惡人想得壞人的網羅；義人的根得以結果。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 13,
    "text": "惡人嘴中的過錯是自己的網羅；但義人必脫離患難。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 14,
    "text": "人因口所結的果子，必飽得美福；人手所作的，必為自己的回報。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 15,
    "text": "愚妄人所行的，在自己眼中看為正確；唯肯聽人勸教的，是有智慧。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 16,
    "text": "愚妄人的惱怒當下顯露；通達人能忍辱藏羞。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 17,
    "text": "說出真話的，顯明公義；作假見證的，顯出詭詐。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 18,
    "text": "有人說話如刀刺人；智慧人的舌頭卻為醫人的良藥。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 19,
    "text": "嘴吐真言，永遠堅立；舌說謊話，只存片時。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 20,
    "text": "圖謀惡事的，心存詭詐；勸人和睦的，便得喜樂。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 21,
    "text": "義人不遭災害；惡人滿受禍患。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 22,
    "text": "說謊言的嘴為　耶和華所憎惡；行事誠實的，為他所喜悅。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 23,
    "text": "通達人隱藏知識；愚昧人的心彰顯愚昧。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 24,
    "text": "殷勤人的手必掌權；懶惰的人必服苦。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 25,
    "text": "人心憂慮，屈而不伸；一句良言，使心歡樂。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 26,
    "text": "義人比他的鄰舍美好；惡人的道卻誘惑他們。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 27,
    "text": "懶惰人不烤他打獵所得的；殷勤人的財物卻甚寶貴。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 28,
    "text": "在公義的道上有生命；其路之中並無死亡。"
  }
]
