[
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 1,
    "text": "智慧婦人建立家室；愚妄婦人親手拆毀。"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 2,
    "text": "行動正直的，敬畏　耶和華；行事乖僻的，卻藐視他。"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 3,
    "text": "在愚妄人口中的，是驕傲的杖；智慧人的嘴必保守自己。"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 4,
    "text": "家裏無牛，槽頭乾淨；土產加多乃憑牛力。"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 5,
    "text": "誠實見證人不說謊話；假見證人吐出謊言。"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 6,
    "text": "褻慢人尋智慧，卻尋不著；聰明人易得知識。"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 7,
    "text": "你既不見愚昧人嘴中有知識，就當從他面前遠離。"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 8,
    "text": "通達人的智慧在乎明白己道；愚昧人的愚妄乃是自欺。"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 9,
    "text": "愚妄人犯罪，以為戲耍；義人互相喜悅。"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 10,
    "text": "心中的苦楚，自己知道；心裏的喜樂，外人無干。"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 11,
    "text": "奸惡人的房屋必傾倒；正直人的帳棚必興盛。"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 12,
    "text": "有一條路，人以為正，至終成為死亡之路。"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 13,
    "text": "人在喜笑中，心也憂愁；快樂至極就生愁苦。"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 14,
    "text": "心中背道的，必滿有自己的道路；善人必從自己得以知足。"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 15,
    "text": "愚蒙人是話都信；通達人步步謹慎。"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 16,
    "text": "智慧人懼怕，就遠離惡事；愚妄人卻狂傲自恃。"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 17,
    "text": "輕易發怒的，行事愚妄；設立惡計的，被人恨惡。"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 18,
    "text": "愚蒙人得愚昧為產業；通達人得知識為冠冕。"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 19,
    "text": "壞人屈身在善人面前；惡人俯伏在義人門口。"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 20,
    "text": "貧窮人連鄰舍也恨他；富足人朋友最多。"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 21,
    "text": "藐視鄰舍的，這人有罪；憐憫貧窮的，這人有福。"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 22,
    "text": "謀惡的，豈非走入迷途嗎？謀善的，必得慈愛和誠實。"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 23,
    "text": "諸般勤勞都有益處；嘴上多言徒致窮乏。"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 24,
    "text": "智慧人的財為自己的冠冕；愚妄人的愚昧乃是愚昧。"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 25,
    "text": "作真見證的，救人性命；作詭詐見證的，吐出謊言。"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 26,
    "text": "敬畏　耶和華的，大有倚靠；他的兒女也有避難所。"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 27,
    "text": "敬畏　耶和華就是生命的泉源，可以使人離開死亡的網羅。"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 28,
    "text": "帝王榮耀在乎民多；君王衰敗在乎民少。"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 29,
    "text": "不輕易發怒的，大有聰明；靈性暴躁的，大顯愚妄。"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 30,
    "text": "心中靈明是肉體的生命；嫉妒是骨中的朽爛。"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 31,
    "text": "欺壓貧寒的，是辱沒他的　造物主；尊敬他的，憐憫窮乏人。"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 32,
    "text": "惡人在所行的惡上必被逐去；義人臨死卻有盼望。"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 33,
    "text": "智慧存在聰明人心中；愚昧人心裏所存的，顯而易見。"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 34,
    "text": "公義使邦國高舉；罪惡是人民的羞辱。"
  },
  {
    "bookId": 20,
    "chapterId": 14,
    "verseId": 35,
    "text": "智慧的臣子蒙王恩惠；貽羞的僕人遭其震怒。"
  }
]
