[
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 1,
    "text": "美名勝過大財；恩寵強如金銀。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 2,
    "text": "富戶窮人在世相遇，都為　耶和華所造。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 3,
    "text": "通達人見禍藏躲；愚蒙人前往受害。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 4,
    "text": "敬畏　耶和華心存謙卑，就得富有、尊榮、生命為賞賜。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 5,
    "text": "乖僻人的路上有荊棘和網羅；保守自己生命的，必要遠離。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 6,
    "text": "教養孩童，使他走當行的道，就是到老他也不偏離。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 7,
    "text": "富戶管轄窮人；欠債的是債主的僕人。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 8,
    "text": "撒罪孽的，必收虛空；他逞怒的杖也必廢掉。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 9,
    "text": "眼目慈善的，就必蒙福，因他將食物分給窮人。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 10,
    "text": "趕出褻慢人，爭端就消除；紛爭和羞辱也必止息。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 11,
    "text": "喜愛清心的人因他嘴上的恩言，王必與他為友。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 12,
    "text": "耶和華的眼目眷顧聰明人，卻傾敗犯法的人的言語。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 13,
    "text": "懶惰人說：外頭有獅子；我在街上就必被殺。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 14,
    "text": "外女的口為深坑；　耶和華所憎惡的，必陷在其中。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 15,
    "text": "愚蒙迷住孩童的心，用管教的杖可以遠遠趕除。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 16,
    "text": "欺壓貧窮為要利己的，並送禮與富戶的，都必缺乏。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 17,
    "text": "你須側耳聽受智慧人的言語，留心領會我的知識。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 18,
    "text": "你若心中存記，嘴上咬定，這便為美。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 19,
    "text": "我今日以此特特指教你，為要使你倚靠　耶和華。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 20,
    "text": "謀略和知識的美事，我豈沒有寫給你，"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 21,
    "text": "要使你知道真言的實理，你好將真言回覆那打發你來的人嗎？"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 22,
    "text": "貧窮人，你不可因他貧窮就搶奪他的物，也不可在城門口欺壓困苦人；"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 23,
    "text": "因　耶和華必為他辨屈；搶奪他的，　耶和華必奪取那人的命。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 24,
    "text": "好生氣的人，不可與他結交；暴怒的人，你不可與他來往；"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 25,
    "text": "恐怕你效法他的行為，自己就陷在網羅裏。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 26,
    "text": "不要與人擊掌，不要為欠債的作保。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 27,
    "text": "你若沒有甚麼償還，何必使人奪去你睡臥的床呢？"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 28,
    "text": "你先祖所立的地界，你不可挪移。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 29,
    "text": "你看見辦事殷勤的人嗎？他必站在君王面前，必不站在下賤人面前。"
  }
]
