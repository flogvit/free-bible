[
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 1,
    "text": "人屢次受責備，仍然硬著頸項；他必頃刻敗壞，無法可治。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 2,
    "text": "義人掌權，民就喜樂；惡人管治，民就歎息。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 3,
    "text": "愛慕智慧的，使父親喜樂；與娼妓結交的，卻浪費錢財。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 4,
    "text": "王藉公平，使國堅定；索要賄賂，使國傾敗。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 5,
    "text": "諂媚鄰舍的，就是設網羅絆他的腳。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 6,
    "text": "惡人犯罪，自陷網羅；唯獨義人歡呼喜樂。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 7,
    "text": "義人知道查明窮人的案；然而惡人不願理會，就不得而知。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 8,
    "text": "褻慢人使城陷入網羅；唯智慧人轉消忿怒。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 9,
    "text": "智慧人若與愚妄人相爭，或怒或笑，總不能使他止息。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 10,
    "text": "好流人血的，恨惡正直人，索取義人的性命。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 11,
    "text": "愚妄人心意全吐；智慧人隱藏意念。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 12,
    "text": "首領若聽謊言，他一切僕人都是奸惡。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 13,
    "text": "貧窮人、行詭詐的人在世相遇；他們的眼目都蒙　耶和華光照。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 14,
    "text": "君王憑誠實判斷窮人；他的國位必永遠堅立。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 15,
    "text": "杖打和責備能加增智慧；放縱的孩子使母親羞愧。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 16,
    "text": "惡人加多，過犯也加多，義人必看見他們跌倒。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 17,
    "text": "管教你的兒子，他就使你得安息，也必使你心裏喜樂。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 18,
    "text": "沒有異象，民就滅亡；唯遵守律法的，便為有福。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 19,
    "text": "只用言語，僕人不肯受管教；他雖然明白，也不回答。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 20,
    "text": "你見言語急躁的人嗎？愚昧人比他更有盼望。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 21,
    "text": "人將僕人從小嬌養，這僕人終久必成了他的兒子。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 22,
    "text": "好氣的人挑啟爭端；暴怒的人多多犯罪。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 23,
    "text": "人的高傲必使他卑下；靈裏謙遜的，尊榮卻必扶持他。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 24,
    "text": "人與盜賊分贓，是恨惡自己的性命；他聽見咒罵的聲音，卻不顯露。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 25,
    "text": "懼怕人的，陷入網羅；唯有倚靠　耶和華的，必得安穩。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 26,
    "text": "求王恩的人多；定人事乃在　耶和華。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 27,
    "text": "為非作歹的，被義人憎嫌；行事正直的，被惡人憎惡。"
  }
]
