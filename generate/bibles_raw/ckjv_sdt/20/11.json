[
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 1,
    "text": "詭詐的天平為　耶和華所憎惡；公平的法碼為他所喜悅。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 2,
    "text": "驕傲來，羞恥也來；謙遜人卻有智慧。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 3,
    "text": "正直人的純正必引導自己；犯法的人的乖僻必毀滅自己。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 4,
    "text": "發怒的日子資財無益；唯有公義能救人脫離死亡。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 5,
    "text": "完全人的義必指引他的路；但惡人必因自己的惡跌倒。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 6,
    "text": "正直人的義必拯救自己；犯法的人必陷在自己的罪孽中。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 7,
    "text": "惡人一死，他的指望必滅絕；不義的人的盼望也必滅沒。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 8,
    "text": "義人得脫離患難，有惡人來代替他。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 9,
    "text": "假善的人用口敗壞鄰舍；義人卻因知識得救。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 10,
    "text": "義人享福，合城喜樂；惡人滅亡，人都歡呼。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 11,
    "text": "城因正直人祝福便高舉，卻因邪惡人的口就傾覆。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 12,
    "text": "毫無智慧的，藐視鄰舍；明哲人卻靜默不言。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 13,
    "text": "往來傳舌的，洩漏密事；靈裏誠實的，遮隱事情。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 14,
    "text": "無智謀，民就敗落；謀士多，人便安居。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 15,
    "text": "為外人作保的，必受虧損；恨惡擊掌的，卻得安穩。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 16,
    "text": "恩德的婦女得尊榮；強壯的男子得資財。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 17,
    "text": "仁慈的人善待自己；殘忍的人擾害己身。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 18,
    "text": "惡人經營，得虛浮的成果；撒義種的，得實在的果效。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 19,
    "text": "恆心為義的，必得生命；追求邪惡的，必致死亡。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 20,
    "text": "心中乖僻的，為　耶和華所憎惡；行事正直的，為他所喜悅。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 21,
    "text": "惡人雖然連手，必不免受罰；義人的後裔必得拯救。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 22,
    "text": "婦女美貌而無見識，如同金器帶在豬鼻上。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 23,
    "text": "義人的心願盡得好處；惡人的指望致干忿怒。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 24,
    "text": "有施散的，卻更增添；有吝惜過度的，反致窮乏。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 25,
    "text": "好施捨的，必得豐裕；滋潤人的，必得滋潤。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 26,
    "text": "屯穀不賣的，民必咒詛他；情願出賣的，人必為他祝福。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 27,
    "text": "懇切求善的，就求得恩惠；唯獨求惡的，惡必臨到他身。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 28,
    "text": "倚仗自己財物的，必跌倒；義人必發旺，如枝條。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 29,
    "text": "擾害己家的，必承受清風；愚昧人必作慧心人的僕人。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 30,
    "text": "義人所結的果子就是生命樹；贏得人的，是有智慧。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 31,
    "text": "看哪，義人在世尚且受報；惡人和罪人就更受報了。"
  }
]
