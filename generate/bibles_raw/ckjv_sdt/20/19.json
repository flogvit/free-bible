[
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 1,
    "text": "行為純正的貧窮人，勝過嘴裏乖謬的愚妄人。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 2,
    "text": "心無知識的，乃為不善；腳步急快的，難免犯罪。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 3,
    "text": "人的愚昧傾敗他的道；他的心也抱怨　耶和華。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 4,
    "text": "財物使朋友增多；但窮人鄰舍遠離。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 5,
    "text": "作假見證的，必不免受罰；吐出謊言的，終不能逃脫。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 6,
    "text": "作君王的，有多人求他的恩情；愛送禮的，人都為他的朋友。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 7,
    "text": "貧窮人，弟兄都恨他；何況他的朋友，豈不更遠離他？他用言語追隨，還是缺欠他們。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 8,
    "text": "得著智慧的，愛惜生命；保守聰明的，必得好處。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 9,
    "text": "作假見證的，不免受罰；吐出謊言的，也必滅亡。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 10,
    "text": "愚昧人宴樂度日是不合宜的；何況僕人管轄王子呢？"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 11,
    "text": "人有見識就不輕易發怒；寬恕人的過失便是自己的榮耀。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 12,
    "text": "王的忿怒好像獅子吼叫；他的恩典卻如草上的甘露。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 13,
    "text": "愚昧的兒子是父親的禍患；妻子的爭吵如雨連連滴漏。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 14,
    "text": "房屋錢財是祖宗所遺留的；唯有賢慧的妻是　耶和華所賜的。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 15,
    "text": "懶惰使人沉睡；懈怠的人必受飢餓。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 16,
    "text": "謹守誡命的，保全生命；輕忽己路的，必致死亡。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 17,
    "text": "憐憫貧窮的，就是借給　耶和華；他的善行，　耶和華必償還。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 18,
    "text": "趁有盼望管教你的兒子，你的心不可因他哭喊就寬容。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 19,
    "text": "暴怒的人必受刑罰；你若救他，必須再救。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 20,
    "text": "你要聽勸教，受訓誨，使你終久有智慧。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 21,
    "text": "人心多有計謀；唯有　耶和華的籌算才能立定。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 22,
    "text": "施行仁慈的，令人愛慕；窮人強如說謊言的。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 23,
    "text": "敬畏　耶和華的，得著生命；他必恆久知足，不遭禍患。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 24,
    "text": "懶惰人將手藏在懷裏，就是向口撤回，他也不肯。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 25,
    "text": "鞭打褻慢人，愚蒙人必受警戒；責備明哲人，他就明白知識。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 26,
    "text": "虐待父親、攆出母親的，是貽羞致辱之子。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 27,
    "text": "我兒，那使人偏離知識言語的教訓，你不可聽從。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 28,
    "text": "不敬虔的人作見證戲笑公平；惡人的口吞下罪孽。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 29,
    "text": "刑罰是為褻慢人預備的；鞭打是為愚昧人的背預備的。"
  }
]
