[
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 1,
    "text": "利慕伊勒王的言語，是他母親教訓他的預言。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 2,
    "text": "我的兒啊，我腹中生的兒啊，我許願得的兒啊！我當怎樣教訓你呢？"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 3,
    "text": "不要將你的精力給婦女；也不要有敗壞君王的行為。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 4,
    "text": "利慕伊勒啊，君王喝酒，君王喝酒不相宜；王子說濃酒在那裏也不相宜；"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 5,
    "text": "恐怕喝了就忘記律例，顛倒一切困苦人的是非。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 6,
    "text": "可以把濃酒給將亡的人喝，把清酒給苦心的人喝，"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 7,
    "text": "讓他喝了，就忘記他的貧窮，不再記念他的苦楚。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 8,
    "text": "你當為啞巴開口，為一切要被滅絕的伸冤。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 9,
    "text": "你當開口按公義判斷，為困苦和窮乏的辨屈。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 10,
    "text": "才德的婦人誰能得著呢？她的價值遠勝過紅寶石。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 11,
    "text": "她丈夫心裏倚靠她，必不缺少利益；"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 12,
    "text": "她一生使丈夫有益無損。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 13,
    "text": "她尋找羊羢和麻，甘心用手作工。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 14,
    "text": "她好像商船從遠方運糧來，"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 15,
    "text": "未到黎明她就起來，把食物分給家中的人，將當作的工分派婢女。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 16,
    "text": "她想得田地就買來；用手所得之利栽種葡萄園。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 17,
    "text": "她以能力束腰，使膀臂有力。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 18,
    "text": "她覺得所經營的有利；她的燭終夜不滅。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 19,
    "text": "她手拿捻線竿，手把紡線車。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 20,
    "text": "她張手賙濟困苦人，伸手幫補窮乏人。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 21,
    "text": "她不因下雪為家裏的人擔心，因為全家都穿著朱紅衣服。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 22,
    "text": "她為自己製作繡花鋪蓋；她的衣服是絲綢和紫色布作的。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 23,
    "text": "她丈夫在城門口與本地的長老同坐，為眾人所認識。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 24,
    "text": "她作細麻布衣裳出賣，又將腰帶賣與商家。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 25,
    "text": "能力和威儀是她的衣服；她想到日後的景況就喜笑。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 26,
    "text": "她開口就發智慧；她舌上有仁慈的法則。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 27,
    "text": "她觀察家務，並不吃閒飯。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 28,
    "text": "她的兒女起來稱她有福；她的丈夫也稱讚她，"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 29,
    "text": "說，才德的女子很多，唯獨妳超越她們。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 30,
    "text": "艷麗是虛假的，美容是虛浮的；唯敬畏　耶和華的婦女必得稱讚。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 31,
    "text": "願她享受操作所得的成果；願她自己所作的在城門口稱讚她。"
  }
]
