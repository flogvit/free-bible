[
  {
    "bookId": 14,
    "chapterId": 4,
    "verseId": 1,
    "text": "他又製造一座銅壇，長二十肘，寬二十肘，高十肘；"
  },
  {
    "bookId": 14,
    "chapterId": 4,
    "verseId": 2,
    "text": "又鑄一個銅海，樣式是圓的，高五肘，徑十肘，圍三十肘；"
  },
  {
    "bookId": 14,
    "chapterId": 4,
    "verseId": 3,
    "text": "海以下的周圍有牛的樣式，每肘十個，共有兩行，是鑄海的時候鑄上的；"
  },
  {
    "bookId": 14,
    "chapterId": 4,
    "verseId": 4,
    "text": "有十二隻銅牛馱海：三隻向北，三隻向西，三隻向南，三隻向東；海在牛上，牛尾向內；"
  },
  {
    "bookId": 14,
    "chapterId": 4,
    "verseId": 5,
    "text": "海厚一掌，邊如杯邊，又如百合花，可容三千罷特；"
  },
  {
    "bookId": 14,
    "chapterId": 4,
    "verseId": 6,
    "text": "又製造十個盆：五個放在右邊，五個放在左邊，獻燔祭所用之物都洗在其內；但海是為祭司沐浴的。"
  },
  {
    "bookId": 14,
    "chapterId": 4,
    "verseId": 7,
    "text": "他又照所定的樣式造十個金燭臺放在殿裏：五個在右邊，五個在左邊；"
  },
  {
    "bookId": 14,
    "chapterId": 4,
    "verseId": 8,
    "text": "又造十張桌子放在殿裏：五張在右邊，五張在左邊；又造一百個金盆；"
  },
  {
    "bookId": 14,
    "chapterId": 4,
    "verseId": 9,
    "text": "又建立祭司院和大院，並院門，用銅包裹門扇；"
  },
  {
    "bookId": 14,
    "chapterId": 4,
    "verseId": 10,
    "text": "將海安在朝東的右邊，與南邊相對。"
  },
  {
    "bookId": 14,
    "chapterId": 4,
    "verseId": 11,
    "text": "戶蘭又造了鍋、鏟、盆。這樣，他為所羅門王作完了　上帝殿的工。"
  },
  {
    "bookId": 14,
    "chapterId": 4,
    "verseId": 12,
    "text": "所造的就是：兩根柱子和柱上兩個如球的頂，並兩個蓋柱頂的網子，"
  },
  {
    "bookId": 14,
    "chapterId": 4,
    "verseId": 13,
    "text": "和四百石榴，安在兩個網子上，每網兩行蓋著兩個柱上如球的頂。"
  },
  {
    "bookId": 14,
    "chapterId": 4,
    "verseId": 14,
    "text": "盆座和其上的盆，"
  },
  {
    "bookId": 14,
    "chapterId": 4,
    "verseId": 15,
    "text": "海和海下的十二隻牛，"
  },
  {
    "bookId": 14,
    "chapterId": 4,
    "verseId": 16,
    "text": "鍋、鏟子、肉鍤子，與　耶和華殿裏的一切器皿，都是巧匠戶蘭用光亮的銅為所羅門王造成的，"
  },
  {
    "bookId": 14,
    "chapterId": 4,
    "verseId": 17,
    "text": "是在約旦平原疏割和撒利但中間藉膠泥鑄成的。"
  },
  {
    "bookId": 14,
    "chapterId": 4,
    "verseId": 18,
    "text": "所羅門製造的這一切甚多，銅的輕重無法可查。"
  },
  {
    "bookId": 14,
    "chapterId": 4,
    "verseId": 19,
    "text": "所羅門又造　上帝殿裏的金壇和陳設餅的桌子，"
  },
  {
    "bookId": 14,
    "chapterId": 4,
    "verseId": 20,
    "text": "並純金的燭臺和燈盞，可以照例燃在內殿前。"
  },
  {
    "bookId": 14,
    "chapterId": 4,
    "verseId": 21,
    "text": "花和燈盞，並蠟剪都是金的，且是純金的；"
  },
  {
    "bookId": 14,
    "chapterId": 4,
    "verseId": 22,
    "text": "又用純金製造鑷子、盤子、調羹、香爐；至於殿門和至聖之處的門扇，並殿的門扇，都是金子妝飾的。"
  }
]
