[
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 1,
    "text": "約伯回答說："
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 2,
    "text": "唯願我的煩惱稱一稱，將我的災害一起放在天平裏！"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 3,
    "text": "現今都比海沙更重，所以我的言語被吞滅。"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 4,
    "text": "因　全能者的箭射入我身；其毒，我的靈喝盡了；　上帝的驚嚇擺陣攻擊我。"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 5,
    "text": "野驢有草豈能叫喚？牛有料豈能吼叫？"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 6,
    "text": "物淡而無鹽豈可吃嗎？蛋青有甚麼滋味呢？"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 7,
    "text": "看為可厭的食物，我心不肯挨近。"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 8,
    "text": "唯願我得著所求的，願　上帝賜我所切望的！"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 9,
    "text": "就是願　上帝把我壓碎，伸手將我剪除！"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 10,
    "text": "我因沒有隱藏那　聖者的言語，就仍以此為安慰，在疼痛中還可忍受。"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 11,
    "text": "我有甚麼氣力使我盼望？我有甚麼結局使我延長年日？"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 12,
    "text": "我的氣力豈是石頭的氣力？我的肉身豈是銅的呢？"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 13,
    "text": "在我豈不是毫無幫助嗎？智慧豈不是從我心中趕出淨盡嗎？"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 14,
    "text": "那受苦的人，他的朋友當以憐恤待他；唯離棄、不敬畏　全能者的，不該待他如此。"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 15,
    "text": "我的弟兄詭詐，好像溪水，又像溪水隨流而去。"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 16,
    "text": "這河因結冰發黑，有雪藏在其中；"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 17,
    "text": "天氣漸暖就隨時消化，日頭炎熱便從原處乾涸。"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 18,
    "text": "他們的路偏離，到荒野之地死亡。"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 19,
    "text": "提瑪結伴的客旅瞻望；示巴同夥的人等候。"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 20,
    "text": "他們因失了盼望就抱愧，來到那裏便蒙羞。"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 21,
    "text": "現在你們正是這樣，看見我潦倒便懼怕。"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 22,
    "text": "我豈說：請你們供給我，從你們的財物中送禮物給我？"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 23,
    "text": "豈說：拯救我脫離敵人的手嗎？救贖我脫離強暴人的手嗎？"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 24,
    "text": "請你們教導我，我便不作聲；使我明白在何事上有錯。"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 25,
    "text": "正確的言語力量何其大！但你們責備是責備甚麼呢？"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 26,
    "text": "絕望人的講論既然如風，你們還想要駁正言語嗎？"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 27,
    "text": "你們想欺壓無父的，為朋友挖坑。"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 28,
    "text": "現在請你們看看我，我若說謊，你們必以為明顯。"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 29,
    "text": "請你們轉意，不要以此為罪孽；請再轉意，我在其中有理。"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 30,
    "text": "我的舌上豈有不義嗎？我的口裏豈不辨奸惡嗎？"
  }
]
