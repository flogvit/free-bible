[
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 1,
    "text": "因此我心也戰兢，從他的原處移動。"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 2,
    "text": "當側耳聽他所發之聲，並他口中所出的聲音。"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 3,
    "text": "他發響聲震遍普天之下，發電光閃到地的四極。"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 4,
    "text": "隨後人聽見有雷聲轟轟，大發威嚴，雷電接連不斷。"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 5,
    "text": "上帝發出奇妙的雷聲；他行大事，我們不能測透。"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 6,
    "text": "他對雪說：要降在地上；對細雨和暴雨也是這樣說。"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 7,
    "text": "他封住各人的手，叫所造的眾人都曉得他的作為。"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 8,
    "text": "百獸進入穴中，臥在其處。"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 9,
    "text": "旋風出於南方；寒冷出於北方。"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 10,
    "text": "上帝噓氣成冰；寬闊之水也都凝結。"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 11,
    "text": "他使密雲盛滿水氣，布散電光之雲；"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 12,
    "text": "這雲是藉他的指引游行旋轉，得以在全地面上行他一切所吩咐的，"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 13,
    "text": "或為責罰，或為潤地，或為施行慈愛。"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 14,
    "text": "約伯啊，你要留心聽，要站立思想　上帝奇妙的作為。"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 15,
    "text": "上帝何時安設這些，使他雲彩的光照耀，你知道嗎？"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 16,
    "text": "雲彩如何浮於空中，那知識全備者奇妙的作為，你知道嗎？"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 17,
    "text": "南風使地寂靜，你的衣服就如火熱，你知道嗎？"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 18,
    "text": "你豈能與　上帝同鋪穹蒼嗎？這穹蒼堅硬，如同鑄成的鏡子。"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 19,
    "text": "我們因黑暗不能陳說；請你指教我們該對他說甚麼話。"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 20,
    "text": "人豈可說：我願與他說話？若有人說話，他就必被吞滅。"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 21,
    "text": "現在有雲遮蔽，人不得見穹蒼的光亮；但風吹過，天又發晴。"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 22,
    "text": "睛天出於北方，在　上帝那裏有可怕的威嚴。"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 23,
    "text": "論到　全能者，我們不能測度；他大有能力，有公平和大義，必不苦待人。"
  },
  {
    "bookId": 18,
    "chapterId": 37,
    "verseId": 24,
    "text": "所以，人敬畏他；凡自以為心中有智慧的人，他都不顧念。"
  }
]
