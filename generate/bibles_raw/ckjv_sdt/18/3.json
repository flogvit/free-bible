[
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 1,
    "text": "此後，約伯開口咒詛自己的生日，"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 2,
    "text": "說："
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 3,
    "text": "願我生的那日和說懷了男胎的那夜都滅沒。"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 4,
    "text": "願那日變為黑暗；願　上帝不從上面尋找它；願亮光不照於其上。"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 5,
    "text": "願黑暗和死蔭索取那日；願密雲停在其上；願日蝕恐嚇它。"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 6,
    "text": "願那夜被幽暗奪取，不在年中的日子同樂，也不入月中的數目。"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 7,
    "text": "看哪，願那夜孤寂，其間也沒有歡樂的聲音。"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 8,
    "text": "願那咒詛日子的且能舉起他們的哀聲。"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 9,
    "text": "願那夜黎明的星宿變為黑暗，盼亮卻不亮，也不見天亮；"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 10,
    "text": "因沒有把懷我胎的門關閉，也沒有將患難對我的眼隱藏。"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 11,
    "text": "我為何不出母胎而死？為何不出母腹絕氣？"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 12,
    "text": "為何有膝接收我？為何有奶哺養我？"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 13,
    "text": "不然，我就早已躺臥安睡，"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 14,
    "text": "和地上為自己重造荒邱的君王、謀士，"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 15,
    "text": "或與有金子、將銀子裝滿了房屋的王子一同安息；"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 16,
    "text": "或像隱而未現、不到期而落的胎，歸於無有，如同未見光的嬰孩。"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 17,
    "text": "在那裏惡人止息攪擾；困乏人得享安息，"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 18,
    "text": "在那裏被囚的人同得安息；欺壓者的聲音，他們聽不見。"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 19,
    "text": "大小都在那裏；僕人脫離主人的轄制。"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 20,
    "text": "受患難的人為何有光賜給他呢？心中愁苦的人為何有生命賜給他呢？"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 21,
    "text": "他們切望死，卻不得死；求死，甚於求隱藏的珍寶。"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 22,
    "text": "他們尋見墳墓就快樂，極其歡喜。"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 23,
    "text": "人的道路既然遮隱，　上帝又把他四面圍困，為何有光賜給他呢？"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 24,
    "text": "我未曾吃飯就發出歎息；我唉哼的聲音湧出如水。"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 25,
    "text": "因我所甚恐懼的臨到我身，我所懼怕的迎我而來。"
  },
  {
    "bookId": 18,
    "chapterId": 3,
    "verseId": 26,
    "text": "我不得安穩，不得安息，也不得平靜，卻有患難來到。"
  }
]
