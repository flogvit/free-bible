[
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 1,
    "text": "提幔人以利法回答說："
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 2,
    "text": "智慧人既或有益於己，人還能使　上帝有益麼？"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 3,
    "text": "你為人公義，豈叫　全能者喜悅呢？你行為完全，豈能使他得利呢？"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 4,
    "text": "他豈因你敬畏他就責備你？他豈審判你嗎？"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 5,
    "text": "你的罪惡豈不是大嗎？你的罪孽豈不是沒有窮盡嗎？"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 6,
    "text": "因你無故強取你兄弟的物為當頭，剝去貧寒人的衣服。"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 7,
    "text": "困乏的人，你沒有給他水喝；飢餓的人，你沒有給他食物。"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 8,
    "text": "有能力的人就得地土；尊貴的人也住在其中。"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 9,
    "text": "你打發寡婦空手回去，折斷無父之人的膀臂。"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 10,
    "text": "因此，有網羅環繞你，有恐懼忽然使你驚惶；"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 11,
    "text": "或有黑暗蒙蔽你，並有洪水淹沒你。"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 12,
    "text": "上帝豈不是在高天嗎？你看星宿何其高呢！"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 13,
    "text": "你說：　上帝知道甚麼？他豈能穿透黑雲施行審判呢？"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 14,
    "text": "密雲將他遮蓋，使他不能看見；他周遊穹蒼。"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 15,
    "text": "你有留意上古的道嗎？這道是惡人所行的。"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 16,
    "text": "他們未到死期，就被砍下，根基毀壞，好像被江河沖去；"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 17,
    "text": "他們向　上帝說：離開我們吧！又說：全能者能為他們怎麼行呢？"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 18,
    "text": "哪知　上帝以美物充滿他們的房屋；但惡人所謀定的離我好遠。"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 19,
    "text": "義人看見他們的結局就歡喜；無辜的人嗤笑他們，"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 20,
    "text": "我們的貨財未被剪除，但是他們所剩的都被火燒滅。"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 21,
    "text": "你要認識　上帝，就得平安；福氣也必臨到你。"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 22,
    "text": "你當領受他口中的教訓，將他的言語存在心裏。"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 23,
    "text": "你若歸向　全能者，從你帳棚中遠除不義，就必得建立。"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 24,
    "text": "這樣你積蓄的金子就必如塵土，俄斐的黃金也必如溪河石頭；"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 25,
    "text": "全能者就必作保護你的，你也必得寶銀。"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 26,
    "text": "你就要以　全能者為喜樂，向　上帝仰起臉來。"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 27,
    "text": "你要禱告他，他就聽你；你也要還你的願。"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 28,
    "text": "你定意要作何事，必然給你成就；亮光也必照耀你的路。"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 29,
    "text": "人降卑的時候，你仍可說：必得高升；謙卑的人，他必然拯救。"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 30,
    "text": "無辜之島，　上帝且要搭救；他因你手中清潔，必蒙拯救。"
  }
]
