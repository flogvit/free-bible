[
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 1,
    "text": "約伯回答說："
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 2,
    "text": "我真知道是這樣；但人在　上帝面前怎能成為義呢？"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 3,
    "text": "若願意與他爭辯，千中之一也不能回答。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 4,
    "text": "他心裏有智慧，且大有能力。誰向　上帝剛硬而得亨通呢？"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 5,
    "text": "他發怒，把山翻倒挪移，山並不知覺。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 6,
    "text": "他使地震動，離其本位，地的柱子就搖撼。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 7,
    "text": "他吩咐日頭不出來，就不出來，又封閉眾星。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 8,
    "text": "他獨自鋪張諸天，踏在海浪之上。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 9,
    "text": "他造北斗、參星、昴星，並南方的密宮；"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 10,
    "text": "他行大事，不可測度，行奇事，不可勝數。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 11,
    "text": "他從我旁邊經過，我卻不看見；他在我面前行走，我倒不知覺。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 12,
    "text": "看哪，他取去，誰能阻擋？誰敢問他：你作甚麼？"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 13,
    "text": "若　上帝不收回他的怒氣，扶助驕傲人的必屈身在他以下。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 14,
    "text": "既是這樣，我怎敢回答他，怎敢選擇言語與他辯論呢？"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 15,
    "text": "我雖有義，也不回答他，只要向那審判我的懇求。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 16,
    "text": "我若呼求，他應允我；我仍不信他真聽我的聲音。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 17,
    "text": "他用暴風折斷我，無故地加增我的損傷。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 18,
    "text": "我就是喘一口氣，他都不容，倒使我滿心苦惱。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 19,
    "text": "若論力量，看哪，他真有能力！若論審判，誰為我定期，讓我辯白呢？"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 20,
    "text": "我若自義，自己的口要定我為有罪；我若說我完全，我口必顯我為彎曲。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 21,
    "text": "我雖完全，仍不知道自己的心；我輕賤我的性命。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 22,
    "text": "善惡無分，都是一樣；所以我說，完全人和惡人，他都滅絕。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 23,
    "text": "若忽然遭殺害之禍，他必戲笑無辜的人遇難。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 24,
    "text": "世界交在惡人手中；蒙蔽世界審判官的臉，若不是他，是誰呢？他在哪裏呢？"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 25,
    "text": "我的日子比跑信的更快，急速逃去，不見福樂。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 26,
    "text": "我的日子過去如快船，如急落抓食的鷹。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 27,
    "text": "我若說：我要忘記我的哀情，除去我的愁苦，安慰自己；"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 28,
    "text": "我因愁苦而懼怕，知道你必不以我為無辜。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 29,
    "text": "我若被定為惡人，我何必徒然勞苦呢？"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 30,
    "text": "我若用雪水洗身，使我的手未曾如此潔淨，"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 31,
    "text": "你還要扔我在阱裏，我的衣服都憎惡我。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 32,
    "text": "他本不像我是人，使我可以回答他，又使我們可以同聽審判。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 33,
    "text": "我們中間沒有聽訟的人可以向我們兩造按手。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 34,
    "text": "願他把杖離開我，不使驚惶威嚇我。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 35,
    "text": "我就說話，也不懼怕他，現在我卻不是那樣。"
  }
]
