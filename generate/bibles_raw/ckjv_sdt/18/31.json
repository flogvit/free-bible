[
  {
    "bookId": 18,
    "chapterId": 31,
    "verseId": 1,
    "text": "我與眼睛立約，怎能戀戀瞻望處女呢？"
  },
  {
    "bookId": 18,
    "chapterId": 31,
    "verseId": 2,
    "text": "從至上的　上帝那裏所得之分是甚麼呢？　全能者從高處的所得之業是甚麼呢？"
  },
  {
    "bookId": 18,
    "chapterId": 31,
    "verseId": 3,
    "text": "豈不是毀滅臨到惡人，災害臨到作孽的呢？"
  },
  {
    "bookId": 18,
    "chapterId": 31,
    "verseId": 4,
    "text": "上帝豈不是察看我的道路，數點我的腳步呢？"
  },
  {
    "bookId": 18,
    "chapterId": 31,
    "verseId": 5,
    "text": "我若與虛妄同行，腳若追隨詭詐；"
  },
  {
    "bookId": 18,
    "chapterId": 31,
    "verseId": 6,
    "text": "我若被公道的天平稱度，使　上帝可以知道我的純正；"
  },
  {
    "bookId": 18,
    "chapterId": 31,
    "verseId": 7,
    "text": "我的腳步若偏離正路，我的心若隨著我的眼目，若有玷污粘在我手上；"
  },
  {
    "bookId": 18,
    "chapterId": 31,
    "verseId": 8,
    "text": "就願我所種的有別人吃，我田所產的被拔出來。"
  },
  {
    "bookId": 18,
    "chapterId": 31,
    "verseId": 9,
    "text": "我的心若受婦人迷惑，或在鄰舍的門外蹲伏，"
  },
  {
    "bookId": 18,
    "chapterId": 31,
    "verseId": 10,
    "text": "就願我的妻子給別人推磨，別人伏在她身上。"
  },
  {
    "bookId": 18,
    "chapterId": 31,
    "verseId": 11,
    "text": "因為這是大罪，是審判官當罰的罪孽。"
  },
  {
    "bookId": 18,
    "chapterId": 31,
    "verseId": 12,
    "text": "這本是火焚燒，直到毀滅，必拔除我所有的家產。"
  },
  {
    "bookId": 18,
    "chapterId": 31,
    "verseId": 13,
    "text": "我的僕婢與我爭辯的時候，我若藐視不聽他們的情節；"
  },
  {
    "bookId": 18,
    "chapterId": 31,
    "verseId": 14,
    "text": "上帝興起，我怎樣行呢？他察問，我怎樣回答呢？"
  },
  {
    "bookId": 18,
    "chapterId": 31,
    "verseId": 15,
    "text": "造我在腹中的，不也是造他嗎？將他與我摶在腹中的豈不是一個嗎？"
  },
  {
    "bookId": 18,
    "chapterId": 31,
    "verseId": 16,
    "text": "我若不容貧寒人得其所願，或叫寡婦眼中失望，"
  },
  {
    "bookId": 18,
    "chapterId": 31,
    "verseId": 17,
    "text": "或獨自吃我一點食物，無父的沒有與我同吃；"
  },
  {
    "bookId": 18,
    "chapterId": 31,
    "verseId": 18,
    "text": "（從幼年時孤兒與我同長，好像父子一樣；我從出母腹就引領他。）"
  },
  {
    "bookId": 18,
    "chapterId": 31,
    "verseId": 19,
    "text": "我若見人因無衣死亡，或見窮乏人身無遮蓋；"
  },
  {
    "bookId": 18,
    "chapterId": 31,
    "verseId": 20,
    "text": "我若不使他因我羊的毛得暖，為我祝福；"
  },
  {
    "bookId": 18,
    "chapterId": 31,
    "verseId": 21,
    "text": "我若在城門口見有幫助我的，舉手攻擊無父的；"
  },
  {
    "bookId": 18,
    "chapterId": 31,
    "verseId": 22,
    "text": "情願我的肩頭從缺盆骨脫落，我的膀臂從羊矢骨折斷。"
  },
  {
    "bookId": 18,
    "chapterId": 31,
    "verseId": 23,
    "text": "因　上帝降的災禍使我恐懼；因他於高位，我不能承受。"
  },
  {
    "bookId": 18,
    "chapterId": 31,
    "verseId": 24,
    "text": "我若以黃金為盼望，對精金說：你是我的倚靠；"
  },
  {
    "bookId": 18,
    "chapterId": 31,
    "verseId": 25,
    "text": "我若因財物豐裕，因我手多得資財而歡喜；"
  },
  {
    "bookId": 18,
    "chapterId": 31,
    "verseId": 26,
    "text": "我若見太陽發光，明月行在空中，"
  },
  {
    "bookId": 18,
    "chapterId": 31,
    "verseId": 27,
    "text": "心就暗暗被引誘，口便親手；"
  },
  {
    "bookId": 18,
    "chapterId": 31,
    "verseId": 28,
    "text": "這也是審判官當罰的罪孽，又是我背棄在上的　上帝。"
  },
  {
    "bookId": 18,
    "chapterId": 31,
    "verseId": 29,
    "text": "我若見恨我的遭報就歡喜，見他遭災便高興；"
  },
  {
    "bookId": 18,
    "chapterId": 31,
    "verseId": 30,
    "text": "我沒有容口犯罪，咒詛他的生命；"
  },
  {
    "bookId": 18,
    "chapterId": 31,
    "verseId": 31,
    "text": "若我帳棚的人未嘗說：唯願我們從主人得食物啊！我們不得飽足。"
  },
  {
    "bookId": 18,
    "chapterId": 31,
    "verseId": 32,
    "text": "從來我沒有容客旅在街上住宿，卻開門迎接行路的人。"
  },
  {
    "bookId": 18,
    "chapterId": 31,
    "verseId": 33,
    "text": "我若像亞當遮掩我的過犯，將罪孽藏在懷中；"
  },
  {
    "bookId": 18,
    "chapterId": 31,
    "verseId": 34,
    "text": "我何曾懼怕大眾？宗族藐視，何曾使我驚恐，使我閉口無言，杜門不出？"
  },
  {
    "bookId": 18,
    "chapterId": 31,
    "verseId": 35,
    "text": "唯願有一個肯聽我！看哪，我願　全能者回答我，又願我的仇敵好寫成書。"
  },
  {
    "bookId": 18,
    "chapterId": 31,
    "verseId": 36,
    "text": "願那敵我者所寫的狀詞在我這裏！我必帶在肩上，又綁在頭上為冠冕。"
  },
  {
    "bookId": 18,
    "chapterId": 31,
    "verseId": 37,
    "text": "我必向他述說我腳步的數目，必如君王進到他面前。"
  },
  {
    "bookId": 18,
    "chapterId": 31,
    "verseId": 38,
    "text": "我的田地若向我喊冤，或是犁溝若向我吐苦；"
  },
  {
    "bookId": 18,
    "chapterId": 31,
    "verseId": 39,
    "text": "我若吃地的出產不給價值，或叫原主喪命；"
  },
  {
    "bookId": 18,
    "chapterId": 31,
    "verseId": 40,
    "text": "願這地長薊代替麥子，長惡草代替大麥。約伯的話說完了。"
  }
]
