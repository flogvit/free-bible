[
  {
    "bookId": 18,
    "chapterId": 23,
    "verseId": 1,
    "text": "約伯回答說："
  },
  {
    "bookId": 18,
    "chapterId": 23,
    "verseId": 2,
    "text": "如今我哀告；我的責打比我的唉哼還重。"
  },
  {
    "bookId": 18,
    "chapterId": 23,
    "verseId": 3,
    "text": "唯願我能知道在哪裏可以尋見　上帝！我好到他的臺前！"
  },
  {
    "bookId": 18,
    "chapterId": 23,
    "verseId": 4,
    "text": "我就在他面前將我的案件陳明，滿口辯白。"
  },
  {
    "bookId": 18,
    "chapterId": 23,
    "verseId": 5,
    "text": "我必知道他回答我的言語，明白他向我所說的話。"
  },
  {
    "bookId": 18,
    "chapterId": 23,
    "verseId": 6,
    "text": "他豈用大能與我爭辯嗎？必不這樣！他必加力予我。"
  },
  {
    "bookId": 18,
    "chapterId": 23,
    "verseId": 7,
    "text": "在他那裏義人可以與他辯論；這樣，我必永遠脫離那審判我的。"
  },
  {
    "bookId": 18,
    "chapterId": 23,
    "verseId": 8,
    "text": "只是看哪，我往前行，他不在那裏，往後退，也不能見他。"
  },
  {
    "bookId": 18,
    "chapterId": 23,
    "verseId": 9,
    "text": "他在左邊行事，我卻不能看見，在右邊隱藏，我也不能見他。"
  },
  {
    "bookId": 18,
    "chapterId": 23,
    "verseId": 10,
    "text": "然而他知道我所行的路；他試煉我之後，我必如精金。"
  },
  {
    "bookId": 18,
    "chapterId": 23,
    "verseId": 11,
    "text": "我腳追隨他的步履；我謹守他的道，並不偏離。"
  },
  {
    "bookId": 18,
    "chapterId": 23,
    "verseId": 12,
    "text": "他嘴唇的命令，我未曾背棄；我看重他口中的言語，過於我需用的飲食。"
  },
  {
    "bookId": 18,
    "chapterId": 23,
    "verseId": 13,
    "text": "只是他心志已定，誰能使他轉意呢？他心裏所願的，就行出來。"
  },
  {
    "bookId": 18,
    "chapterId": 23,
    "verseId": 14,
    "text": "他向我所定的，就必作成；這類的事他還有許多。"
  },
  {
    "bookId": 18,
    "chapterId": 23,
    "verseId": 15,
    "text": "所以我在他面前驚惶；我思念這事便懼怕他。"
  },
  {
    "bookId": 18,
    "chapterId": 23,
    "verseId": 16,
    "text": "上帝使我喪膽；　全能者使我驚惶。"
  },
  {
    "bookId": 18,
    "chapterId": 23,
    "verseId": 17,
    "text": "因為黑暗之中我不被剪除，也不是因為幽暗蒙蔽我的臉。"
  }
]
