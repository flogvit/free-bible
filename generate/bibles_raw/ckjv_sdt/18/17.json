[
  {
    "bookId": 18,
    "chapterId": 17,
    "verseId": 1,
    "text": "我的氣息衰敗，我的日子滅盡；墳墓為我預備好了。"
  },
  {
    "bookId": 18,
    "chapterId": 17,
    "verseId": 2,
    "text": "真有戲笑我的在我這裏，我眼常見他們惹動我。"
  },
  {
    "bookId": 18,
    "chapterId": 17,
    "verseId": 3,
    "text": "願主拿憑據給我，自己為我作保。誰肯與我擊掌呢？"
  },
  {
    "bookId": 18,
    "chapterId": 17,
    "verseId": 4,
    "text": "因你使他們心不明理，所以你必不高舉他們。"
  },
  {
    "bookId": 18,
    "chapterId": 17,
    "verseId": 5,
    "text": "向他的朋友說諂媚話的，連他兒女的眼睛也要失明。"
  },
  {
    "bookId": 18,
    "chapterId": 17,
    "verseId": 6,
    "text": "上帝使我作了民中的笑談；並且從前我就像鼓一樣。。"
  },
  {
    "bookId": 18,
    "chapterId": 17,
    "verseId": 7,
    "text": "我的眼睛因憂愁昏花；我的百體好像影兒。"
  },
  {
    "bookId": 18,
    "chapterId": 17,
    "verseId": 8,
    "text": "正直人因此必驚奇；無辜的人要興起攻擊假善之輩。"
  },
  {
    "bookId": 18,
    "chapterId": 17,
    "verseId": 9,
    "text": "然而，義人要持守所行的道；手潔的人要力上加力。"
  },
  {
    "bookId": 18,
    "chapterId": 17,
    "verseId": 10,
    "text": "至於你們眾人，可以再來辯論吧！因為你們中間，我找不著一個智慧人。"
  },
  {
    "bookId": 18,
    "chapterId": 17,
    "verseId": 11,
    "text": "我的日子已經過了；我的謀算、我心所想望的已經斷絕。"
  },
  {
    "bookId": 18,
    "chapterId": 17,
    "verseId": 12,
    "text": "他們將黑夜變為白晝，亮光因黑暗而短少。"
  },
  {
    "bookId": 18,
    "chapterId": 17,
    "verseId": 13,
    "text": "我若等候墳墓為我的房屋，若下榻在黑暗中，"
  },
  {
    "bookId": 18,
    "chapterId": 17,
    "verseId": 14,
    "text": "若對朽壞說：你是我的父；對蟲說：你是我的母親姊妹；"
  },
  {
    "bookId": 18,
    "chapterId": 17,
    "verseId": 15,
    "text": "這樣，我的盼望如今在哪裏呢？我所盼望的誰能看見呢？"
  },
  {
    "bookId": 18,
    "chapterId": 17,
    "verseId": 16,
    "text": "等到安息在塵土中，這指望必下到坑中的門閂那裏了。"
  }
]
