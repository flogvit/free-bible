[
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 1,
    "text": "書亞人比勒達回答說："
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 2,
    "text": "你們言語要到幾時窮盡呢？你可以注意究察，然後我們就說話。"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 3,
    "text": "我們為何算為畜生，在你眼中看作卑賤呢？"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 4,
    "text": "他在怒中將自己撕裂；難道大地為你見棄？磐石挪開原處嗎？"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 5,
    "text": "惡人的亮光必要熄滅；他的火花必不照耀。"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 6,
    "text": "他帳棚中的亮光要變為黑暗；他的燭與他也必熄滅。"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 7,
    "text": "他堅強的腳步必見狹窄；自己的計謀必將他絆倒。"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 8,
    "text": "因為他被自己的腳陷入網中，走在網羅上。"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 9,
    "text": "圈套必抓住他的腳跟；強盜必勝過他。"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 10,
    "text": "網羅為他設在土內；羈絆為他藏在路上。"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 11,
    "text": "四面的驚嚇要使他害怕，並且追趕他的腳跟。"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 12,
    "text": "他的力量必因飢餓衰敗；毀滅要在他旁邊等候。"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 13,
    "text": "他皮膚的力量要被吞吃；死亡的長子要吞吃他的力量。"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 14,
    "text": "他所倚靠的要從他帳棚拔出來，它必把他帶到驚嚇的王那裏。"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 15,
    "text": "既沒一樣屬他的，它就住在他的帳棚裏；硫磺必撒在他所住之處。"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 16,
    "text": "下邊，他的根本要枯乾；上邊，他的枝子要剪除。"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 17,
    "text": "他的記念在地上必然滅亡；他的名字在街上也不存留。"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 18,
    "text": "他必從光明中被攆到黑暗裏，必被趕出世界。"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 19,
    "text": "在本民中必無子無孫；在他的住處也無一人存留。"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 20,
    "text": "在他以後來的要驚奇他的日子，好像以前去的受了驚駭。"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 21,
    "text": "惡人的住處總是這樣；此乃不認識　上帝之人的地步。"
  }
]
