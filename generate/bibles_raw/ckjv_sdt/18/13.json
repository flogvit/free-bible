[
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 1,
    "text": "這一切，我眼都見過；我耳都聽過，而且明白。"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 2,
    "text": "你們所知道的，我也知道，並非不及你們。"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 3,
    "text": "我真要對　全能者說話；我願與　上帝理論。"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 4,
    "text": "你們是編造謊言的，都是無用的醫生。"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 5,
    "text": "唯願你們全然不作聲啊！這就算為你們的智慧。"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 6,
    "text": "請你們聽我的辯論，留心聽我嘴唇的分訴。"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 7,
    "text": "你們要為　上帝說邪惡的話嗎？為他說詭詐的言語嗎？"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 8,
    "text": "你們要為　上帝徇情嗎？要為他爭論嗎？"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 9,
    "text": "他查出你們來，這豈是好嗎？人譏笑人，你們也要照樣譏笑他嗎？"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 10,
    "text": "你們若暗中徇情，他必要責備你們。"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 11,
    "text": "他的尊榮豈不叫你們懼怕嗎？他的驚嚇豈不臨到你們嗎？"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 12,
    "text": "你們的名號像爐灰一樣；你們的身體如同淤泥的身體。"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 13,
    "text": "你們不要作聲，任憑我吧！讓我說話，無論如何我都承當。"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 14,
    "text": "我何必把我的肉掛在牙上，將我的命放在手中。"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 15,
    "text": "他雖殺我，我仍要信靠他，然而我在他面前還要辯明我所行的。"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 16,
    "text": "他又要作我的拯救；因為假善的人不得到他面前。"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 17,
    "text": "你們要細聽我的言語，使我所辯論的入你們的耳中。"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 18,
    "text": "看哪，如今我已陳明我的案，知道自己必被稱義。"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 19,
    "text": "有誰與我爭論，現今我若緘默不言，我便氣絕而亡。"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 20,
    "text": "唯有兩件不要向我施行，我就不躲開你："
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 21,
    "text": "就是把你的手縮回，遠離我身；又不使你的驚惶威嚇我。"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 22,
    "text": "這樣，你呼叫，我就回答；或是讓我說話，你回答我。"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 23,
    "text": "我的罪孽和罪過有多少呢？求你叫我知道我的過犯與罪愆。"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 24,
    "text": "你為何掩面、拿我當仇敵呢？"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 25,
    "text": "你要折斷被風吹來吹去的葉子嗎？要追趕枯乾的碎稭嗎？"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 26,
    "text": "你寫下苦楚之事攻擊我，又使我擔當幼年的罪孽。"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 27,
    "text": "也把我的腳上了木狗，並定睛察看我一切的道路，在我的腳跟上加上傷痕。"
  },
  {
    "bookId": 18,
    "chapterId": 13,
    "verseId": 28,
    "text": "我已經像滅絕的爛物，像蟲蛀的衣裳。"
  }
]
