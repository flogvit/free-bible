[
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 1,
    "text": "約伯又接著用比喻說："
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 2,
    "text": "我指著奪去我理的永生　上帝，使我心中愁苦的　全能者起誓："
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 3,
    "text": "我的氣息尚在我裏面；　上帝的靈仍在我的鼻孔內。"
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 4,
    "text": "我的嘴決不說邪惡之言；我的舌也不說詭詐之語。"
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 5,
    "text": "上帝斷不許我以你們為是；我至死必不除掉自己的純正！"
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 6,
    "text": "我持定我的義，必不放鬆；在世的日子，我心必不責備我。"
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 7,
    "text": "願我的仇敵如惡人一樣；願那起來攻擊我的，如不義之人一般。"
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 8,
    "text": "假善的人雖已得利，　上帝奪取其命的時候還有甚麼盼望呢？"
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 9,
    "text": "患難臨到他，　上帝豈能聽他的呼求？"
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 10,
    "text": "他豈以　全能者為樂？他豈隨時求告　上帝呢？"
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 11,
    "text": "上帝的作為，我要指教你們；　全能者所行的，我也不隱瞞。"
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 12,
    "text": "看哪，你們自己也都見過，為何全然變為虛妄呢？"
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 13,
    "text": "上帝為惡人所定的分，強暴人從　全能者所得的產業乃是這樣："
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 14,
    "text": "倘或他的兒女增多，還是被刀所殺；他的子孫必不得飽食。"
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 15,
    "text": "他所遺留的人必死而埋葬；他的寡婦也不哀哭。"
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 16,
    "text": "他雖積蓄銀子如塵沙，預備衣服如泥土；"
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 17,
    "text": "他只管預備，義人卻要穿上；他的銀子，無辜的人要分取。"
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 18,
    "text": "他建造房屋如蟲作窩，又如守望者所搭的棚。"
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 19,
    "text": "他雖富足躺臥，卻不得收殮，轉眼之間就不在了。"
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 20,
    "text": "驚恐如波濤將他追上；暴風在夜間將他颳去。"
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 21,
    "text": "東風把他飄去而離；又如狂風颳他離開本處。"
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 22,
    "text": "上帝要向他扔物，並不留情；他恨不得逃脫　上帝的手。"
  },
  {
    "bookId": 18,
    "chapterId": 27,
    "verseId": 23,
    "text": "人要向他拍掌，並要發叱聲，使他離開本處。"
  }
]
