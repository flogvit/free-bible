[
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 1,
    "text": "以利戶又接著說："
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 2,
    "text": "你再容我片時，我就指示你，因我還有話為　上帝說。"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 3,
    "text": "我要將所知道的從遠處引來，將公義歸給我的　造物主。"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 4,
    "text": "我的言語真不虛謊；有知識全備的與你同在。"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 5,
    "text": "看哪，　上帝有大能，並不藐視人；他的能力甚大，他的智慧甚廣。"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 6,
    "text": "他不保護惡人的性命，卻為困苦人伸冤。"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 7,
    "text": "他時常看顧義人，使他們和君王同坐寶座，永遠要被高舉。"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 8,
    "text": "他們若被鎖鏈捆住，被苦難的繩索纏住，"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 9,
    "text": "他就把他們的作為和他們所犯的過犯指示他們。"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 10,
    "text": "他也開通他們的耳朵得受教訓，吩咐他們離開罪孽轉回。"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 11,
    "text": "他們若聽從事奉他，就必度日亨通，歷年福樂；"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 12,
    "text": "若不聽從，就要被刀殺滅，無知無識而死。"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 13,
    "text": "惟心中假善的人積蓄怒氣；　上帝捆綁他們，他們竟不求救。"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 14,
    "text": "必在青年時死亡，與污穢人一樣喪命。"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 15,
    "text": "上帝藉著困苦救拔困苦人，趁他們受欺壓開通他們的耳朵。"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 16,
    "text": "上帝也必引你出離患難，進入寬闊不狹窄之地；擺在你席上的必滿有肥甘。"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 17,
    "text": "但你滿口有惡人批評的言語；判斷和刑罰抓住你。"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 18,
    "text": "既有忿怒，就當謹慎，免得他責打你，把你除掉時，贖價極大也就不能救你。"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 19,
    "text": "他豈重看你的資財？他不重看金子，也不重看一切的勢力。"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 20,
    "text": "不要切慕黑夜，就是眾民在本處被剪除的時候。"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 21,
    "text": "你要謹慎，不可重看罪孽，因你選擇罪孽過於選擇苦難。"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 22,
    "text": "看哪，　上帝行事有高大的能力；教訓人的有誰像他呢？"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 23,
    "text": "誰派定他的道路？誰能說：你所行的不義？"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 24,
    "text": "你不可忘記稱讚他所行的為大，就是人所看見的。"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 25,
    "text": "他所行的，眾人都看見；世人也從遠處觀看。"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 26,
    "text": "看哪，　上帝為大，我們不能全知；他的年數不能測度。"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 27,
    "text": "他使水滴化小；水滴澆下成雨如同霧一般；"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 28,
    "text": "雲彩將雨落下，沛然降與世人。"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 29,
    "text": "誰能明白雲彩如何鋪張，和　上帝帳幕的聲音呢？"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 30,
    "text": "看哪，他將亮光普照在自己的四圍；他又遮覆海底。"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 31,
    "text": "他用這些審判眾民，且賜豐富的糧食。"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 32,
    "text": "他以雲彩遮光，命光因雲彩來到中間而不得照耀。"
  },
  {
    "bookId": 18,
    "chapterId": 36,
    "verseId": 33,
    "text": "所發的雷聲顯明他的作為，又向牲畜指明要起暴風。"
  }
]
