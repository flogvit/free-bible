[
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 1,
    "text": "山巖間的野山羊幾時生產，你知道嗎？母鹿下犢之期，你能察定嗎？"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 2,
    "text": "牠們懷胎的月數，你能數算嗎？牠們幾時生產，你能曉得嗎？"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 3,
    "text": "牠們屈身，將子生下，就除掉疼痛。"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 4,
    "text": "這子漸漸肥壯，在荒野長大，去而不回。"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 5,
    "text": "誰放野驢出去自由？誰解開野驢的繩索？"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 6,
    "text": "我使曠野作牠的住處，使荒地當牠的居所。"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 7,
    "text": "牠嗤笑城內的群眾，不聽趕牲口的喝聲。"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 8,
    "text": "遍山是牠的草場；牠尋找各樣青綠之物。"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 9,
    "text": "獨角獸豈肯服事你？豈肯住在你的槽旁？"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 10,
    "text": "你豈能用套繩將獨角獸籠在犁溝之間？牠豈肯隨你耙山谷之地？"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 11,
    "text": "豈可因牠的力大就倚靠牠？豈可把你的工交給牠作嗎？"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 12,
    "text": "豈可信靠牠把你的糧食運到家，又收聚你禾場上的穀嗎？"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 13,
    "text": "豈是你把華美的翅膀給孔雀，把翅膀和翎毛給鴕鳥嗎？"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 14,
    "text": "因牠把蛋留在地上，在塵土中使得溫暖；"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 15,
    "text": "卻想不到被腳踹碎，或被野獸踐踏。"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 16,
    "text": "牠硬心待雛，似乎不是自己的；雖然徒受勞苦，也不為雛懼怕；"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 17,
    "text": "因為　上帝使牠沒有智慧，也未將悟性賜給牠。"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 18,
    "text": "牠幾時挺身高舉自己，就嗤笑馬和騎馬的人。"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 19,
    "text": "馬的大力是你所賜的嗎？牠頸項上挓的雷聲是你給牠披上的嗎？"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 20,
    "text": "是你叫牠跳躍像蚱蜢嗎？牠噴氣之威使人驚惶。"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 21,
    "text": "牠在谷中刨地，自喜其力；牠出去迎接佩帶兵器的人。"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 22,
    "text": "牠嗤笑可怕的事並不驚惶，也不因刀劍退回。"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 23,
    "text": "箭袋和發亮的槍，並盾牌在牠身上錚錚有聲。"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 24,
    "text": "牠發猛烈的怒氣將地吞下；也不相信這就是角聲。"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 25,
    "text": "角每發聲，牠說呵哈；牠從遠處聞著戰氣，又聽見軍長大發雷聲和兵丁吶喊。"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 26,
    "text": "鷹雀飛翔，展開翅膀一直向南，豈是藉你的智慧嗎？"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 27,
    "text": "大鷹上騰在高處搭窩，豈是聽你的吩咐嗎？"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 28,
    "text": "牠住在山巖，以山峰和堅固之所為家，"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 29,
    "text": "從那裏窺看食物，眼睛遠遠觀望。"
  },
  {
    "bookId": 18,
    "chapterId": 39,
    "verseId": 30,
    "text": "牠的雛也咂血；被殺的人在哪裏，牠也在那裏。"
  }
]
