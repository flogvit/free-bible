[
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 1,
    "text": "銀子有礦；煉金有方。"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 2,
    "text": "鐵從地裏挖出；銅從石中鎔化。"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 3,
    "text": "他為黑暗定界限，查究幽暗陰翳的石頭和死蔭，直到極處，"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 4,
    "text": "洪水從居住之處發出，過路的人也想不到眾水；它們乾涸，與人遠離。"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 5,
    "text": "至於地，能出糧食，地內好像被火翻起來。"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 6,
    "text": "地中的石頭有藍寶石，並有金沙。"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 7,
    "text": "有一條路鷙鳥不得知道；鷹眼也未見過。"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 8,
    "text": "幼年的獅子未曾行過；猛烈的獅子也未曾經過。"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 9,
    "text": "人伸手鑿開堅石，傾倒山根，"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 10,
    "text": "在磐石中鑿出水道，親眼看見各樣寶物。"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 11,
    "text": "他封閉水不得滴流，使隱藏的物顯露出來。"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 12,
    "text": "然而，智慧有何處可尋？聰明之處在哪裏呢？"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 13,
    "text": "智慧的價值無人能知，在活人之地也無處可尋。"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 14,
    "text": "深淵說：不在我內；滄海說：不在我中。"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 15,
    "text": "智慧非用黃金可得，也不能平白銀為它的價值。"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 16,
    "text": "俄斐金和貴重的紅瑪瑙，並藍寶石，不足與較量；"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 17,
    "text": "黃金和水晶不足與比較；精金的器皿不足與兌換。"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 18,
    "text": "珊瑚、珍珠都不足論；智慧的價值勝過紅寶石。"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 19,
    "text": "埃塞俄比亞的黃寶石不足與比較；純金也不足與較量。"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 20,
    "text": "智慧從何處來呢？聰明之處在哪裏呢？"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 21,
    "text": "是向一切有生命的眼目隱藏，向空中的飛鳥掩蔽。"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 22,
    "text": "滅沒和死亡說：我們風聞其名。"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 23,
    "text": "上帝明白智慧的道路，曉得智慧的所在。"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 24,
    "text": "因他鑒察直到地極，遍觀普天之下，"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 25,
    "text": "要為風定輕重，又度量諸水；"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 26,
    "text": "他為雨露定命令，為雷電定道路。"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 27,
    "text": "那時他看見智慧，而且述說；他堅定，並且查究。"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 28,
    "text": "他對人說：看哪，敬畏　主就是智慧；遠離惡便是聰明。"
  }
]
