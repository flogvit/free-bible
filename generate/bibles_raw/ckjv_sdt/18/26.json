[
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 1,
    "text": "約伯回答說："
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 2,
    "text": "無能的人蒙你何等的幫助？膀臂無力的人蒙你何等的拯救？"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 3,
    "text": "無智慧的人蒙你何等的指教？你向他多顯何等大的事？"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 4,
    "text": "你向誰發出言語來？誰的靈從你而出？"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 5,
    "text": "死物自諸水以下、並其中所住的造成。"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 6,
    "text": "在　上帝面前，地獄顯露，滅亡也不得遮掩。"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 7,
    "text": "上帝將北極鋪在空中，將大地懸在虛空；"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 8,
    "text": "將水包在密雲中，雲卻不破裂；"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 9,
    "text": "遮蔽他的寶座，將雲鋪在其上；"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 10,
    "text": "以界限環繞眾水，直到白晝黑夜的盡頭。"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 11,
    "text": "天的柱子因他的斥責震動驚奇。"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 12,
    "text": "他以能力分開洋海，他藉知識打傷驕傲人。"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 13,
    "text": "藉他的靈裝飾諸天；他的手造曲行的蛇。"
  },
  {
    "bookId": 18,
    "chapterId": 26,
    "verseId": 14,
    "text": "看哪，這不過是　上帝工作的些微；他的事我們所聽的是何等的少呢？他大能的雷聲誰能明透呢？"
  }
]
