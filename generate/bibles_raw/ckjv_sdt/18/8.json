[
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 1,
    "text": "書亞人比勒達回答說："
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 2,
    "text": "這些話你要說到幾時？口中的言語如狂風要到幾時呢？"
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 3,
    "text": "上帝豈能偏離公平？　全能者豈能偏離公義？"
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 4,
    "text": "或者你的兒女得罪了他；他就因他們的過犯棄絕他們。"
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 5,
    "text": "你若從早尋求　上帝，向　全能者懇求；"
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 6,
    "text": "你若純全正直，他必定為你醒來，使你公義的居所興旺。"
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 7,
    "text": "你起初雖然微小，終久必大大發增。"
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 8,
    "text": "請你考問前代，追念他們的列祖所查究的。"
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 9,
    "text": "（我們不過從昨日才有，一無所知，因為我們在世的日子好像影兒；）"
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 10,
    "text": "他們豈不指教你，告訴你，從心裏發出言語來呢？"
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 11,
    "text": "葦子沒有泥豈能發長？香蒲沒有水豈能生長？"
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 12,
    "text": "尚青的時候，還沒有割下，比百樣的草先枯槁。"
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 13,
    "text": "凡忘記　上帝的人，其所行的路也是這樣；假善之人的盼望要滅沒。"
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 14,
    "text": "他所盼望的必砍斷，他所倚靠的必為蜘蛛網。"
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 15,
    "text": "他要倚靠房屋，房屋卻站立不住；他要抓住房屋，房屋卻不能存留。"
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 16,
    "text": "他在日光之下發青，枝子長滿了園子；"
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 17,
    "text": "他的根盤繞石堆，扎入石地。"
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 18,
    "text": "他若從本地拔出他，那地就不認識他，說：我沒有見過你。"
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 19,
    "text": "看哪，這就是他道中之樂；以後必另有人從地而生。"
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 20,
    "text": "看哪，　上帝必不丟棄完全人，也不扶助邪惡人。"
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 21,
    "text": "他還要以喜笑充滿你的口，以歡呼充滿你的嘴。"
  },
  {
    "bookId": 18,
    "chapterId": 8,
    "verseId": 22,
    "text": "恨惡你的要披戴慚愧；惡人的居所必歸於無有。"
  }
]
