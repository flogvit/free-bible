[
  {
    "bookId": 18,
    "chapterId": 35,
    "verseId": 1,
    "text": "以利戶又說："
  },
  {
    "bookId": 18,
    "chapterId": 35,
    "verseId": 2,
    "text": "你說：「我的公義甚於　上帝的公義」，你以為有理麼？"
  },
  {
    "bookId": 18,
    "chapterId": 35,
    "verseId": 3,
    "text": "才說這與我有甚麼益處？我罪若被潔淨有甚麼好處呢？"
  },
  {
    "bookId": 18,
    "chapterId": 35,
    "verseId": 4,
    "text": "我要回答你和在你這裏的朋友。"
  },
  {
    "bookId": 18,
    "chapterId": 35,
    "verseId": 5,
    "text": "你要向諸天觀看，瞻望那高於你的雲彩。"
  },
  {
    "bookId": 18,
    "chapterId": 35,
    "verseId": 6,
    "text": "你若犯罪，能使　上帝受何害呢？你的過犯加增，能使　上帝受何損呢？"
  },
  {
    "bookId": 18,
    "chapterId": 35,
    "verseId": 7,
    "text": "你若是公義，還能加增他甚麼呢？他從你手裏還接受甚麼呢？"
  },
  {
    "bookId": 18,
    "chapterId": 35,
    "verseId": 8,
    "text": "你的過惡或能害你這類的人；你的公義或能叫世人得益處。"
  },
  {
    "bookId": 18,
    "chapterId": 35,
    "verseId": 9,
    "text": "人因多受欺壓就哀求；他們因受能者的膀臂便求救。"
  },
  {
    "bookId": 18,
    "chapterId": 35,
    "verseId": 10,
    "text": "卻無人說：造我的　上帝在哪裏─就是那使人夜間歌唱、"
  },
  {
    "bookId": 18,
    "chapterId": 35,
    "verseId": 11,
    "text": "教訓我們甚於地上的走獸、使我們有聰明勝於空中飛鳥的是哪一位？"
  },
  {
    "bookId": 18,
    "chapterId": 35,
    "verseId": 12,
    "text": "他們在那裏，因惡人的驕傲呼求，卻無人回答。"
  },
  {
    "bookId": 18,
    "chapterId": 35,
    "verseId": 13,
    "text": "虛妄的呼求，　上帝必不垂聽；　全能者也必不眷顧。"
  },
  {
    "bookId": 18,
    "chapterId": 35,
    "verseId": 14,
    "text": "雖然你說，你不得見他；你的案件仍在他面前，你信靠他吧。"
  },
  {
    "bookId": 18,
    "chapterId": 35,
    "verseId": 15,
    "text": "但如今因不是那樣，他在怒中討罪，也不甚理會極大的絕境，"
  },
  {
    "bookId": 18,
    "chapterId": 35,
    "verseId": 16,
    "text": "所以約伯開口說虛妄的話，多發無知識的言語。"
  }
]
