[
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 1,
    "text": "約伯回答說："
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 2,
    "text": "你們攪擾我的心，用言語壓碎我要到幾時呢？"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 3,
    "text": "你們這十次羞辱我；你們向我裝作生人也不以為恥。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 4,
    "text": "果真我有錯，這錯乃是在我。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 5,
    "text": "你們果然要向我誇大，以我的羞辱為證指責我，"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 6,
    "text": "就該知道是　上帝傾覆我，用網羅圍繞我。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 7,
    "text": "看哪，我因委曲呼叫，卻不蒙聽允；我大聲呼求，卻不得公斷。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 8,
    "text": "上帝用籬笆攔住我的道路，使我不得經過；他又使我的路徑黑暗。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 9,
    "text": "他剝去我的榮光，摘去我頭上的冠冕。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 10,
    "text": "他在四圍滅了我，我便去了；將我的盼望如樹被移去。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 11,
    "text": "他的忿怒向我發作，以我為敵人。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 12,
    "text": "他的軍旅一齊上來，修築戰路攻擊我，在我帳棚的四圍安營。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 13,
    "text": "他把我的弟兄隔在遠處，使我所認識的誠然與我生疏。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 14,
    "text": "我的親戚與我斷絕；我的密友都忘記我。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 15,
    "text": "在我家寄居的，和我的使女都以我為外人；我在他們眼中看為外邦人。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 16,
    "text": "我喚了我的僕人，他還是不回答我；我開口求他。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 17,
    "text": "我口的氣味，我妻子厭惡；就是向她求從我所生的孩子，她還是憎嫌。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 18,
    "text": "小孩子藐視我；我起來，他們就嘲笑我。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 19,
    "text": "我的密友都憎惡我；我平日所愛的人向我翻臉。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 20,
    "text": "我的皮肉緊貼骨頭；我只剩牙皮逃脫了。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 21,
    "text": "我朋友啊，可憐我！可憐我！因為　上帝的手攻擊我。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 22,
    "text": "你們為甚麼彷彿　上帝逼迫我，吃我的肉還以為不足呢？"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 23,
    "text": "唯願我的言語現在被寫上！唯願人都印錄在書上！"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 24,
    "text": "用鐵筆鐫刻，用鉛灌在磐石上，直存到永遠！"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 25,
    "text": "我知道我的救贖主活著，末了之日必站立在地上。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 26,
    "text": "我這身子皮肉雖被蟲所壞，我仍必在肉體之內得見　上帝。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 27,
    "text": "我的心腸在我裏面雖然消滅，我自己卻要見他，親眼要看他，並不像外人。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 28,
    "text": "你們卻要說：我們為何逼迫他呢？惹事的根乃在乎我；"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 29,
    "text": "你們就當懼怕刀劍；因為忿怒惹動刀劍的刑罰，使你們知道有審判。"
  }
]
