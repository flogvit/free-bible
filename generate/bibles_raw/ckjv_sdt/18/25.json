[
  {
    "bookId": 18,
    "chapterId": 25,
    "verseId": 1,
    "text": "書亞人比勒達回答說："
  },
  {
    "bookId": 18,
    "chapterId": 25,
    "verseId": 2,
    "text": "上帝有治理之權，且甚可畏；他在高處施行和平。"
  },
  {
    "bookId": 18,
    "chapterId": 25,
    "verseId": 3,
    "text": "他的諸軍豈能數算？他的光亮一發，誰不蒙照呢？"
  },
  {
    "bookId": 18,
    "chapterId": 25,
    "verseId": 4,
    "text": "這樣在　上帝面前，人怎能稱義？婦人所生的怎能潔淨？"
  },
  {
    "bookId": 18,
    "chapterId": 25,
    "verseId": 5,
    "text": "看哪，在　上帝眼前，月亮也無光亮，星宿也不純潔。"
  },
  {
    "bookId": 18,
    "chapterId": 25,
    "verseId": 6,
    "text": "何況如蟲的人，如蛆的世人呢！"
  }
]
