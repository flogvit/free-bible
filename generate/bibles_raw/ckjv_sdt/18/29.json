[
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 1,
    "text": "約伯又接著用比喻說："
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 2,
    "text": "唯願我的景況如從前的月份，如　上帝保守我的日子。"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 3,
    "text": "那時他的燭照在我頭上；我藉他的光行過黑暗。"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 4,
    "text": "我願如幼年的時候：那時我在帳棚中，　上帝待我有密友之情；"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 5,
    "text": "那時　全能者仍與我同在，那時我的兒女都環繞我；"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 6,
    "text": "那時我用奶油洗我的腳，磐石為我出油成河；"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 7,
    "text": "那時我出去經過城門，在街上設立自己座位！"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 8,
    "text": "少年人見我而迴避，老年人也起身站立；"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 9,
    "text": "王子都停止說話，用手摀口；"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 10,
    "text": "首領靜默無聲，舌頭貼住上膛。"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 11,
    "text": "耳朵聽我的，就稱我有福；眼睛看我的，都給我作證；"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 12,
    "text": "因我拯救哀求的困苦人、無人幫助的和無父的。"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 13,
    "text": "將要滅亡的祝福臨到我；我也使寡婦心中歡樂。"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 14,
    "text": "我以公義為衣服，以公平為外袍和冠冕。"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 15,
    "text": "我為瞎子的眼，瘸子的腳。"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 16,
    "text": "我為窮乏人的父；素不認識的人，我查明他的案件。"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 17,
    "text": "我打破惡人的腮頰，從他牙齒中奪了所搶的。"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 18,
    "text": "我便說：我必死在家中，必增添我的日子，多如塵沙。"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 19,
    "text": "我的根長到水邊；露水終夜霑在我的枝上。"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 20,
    "text": "我的榮耀在身上增新；我的弓在手中日強。"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 21,
    "text": "人聽見我而仰望，靜默等候我的指教。"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 22,
    "text": "我說話之後，他們就不再說；我的言語像雨露滴在他們身上。"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 23,
    "text": "他們仰望我如仰望雨，又張開口如切慕春雨。"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 24,
    "text": "我若向他們含笑，他們不敢相信；他們不使我臉上的光改變。"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 25,
    "text": "我為他們選擇道路，又坐首位；我如君王在軍隊中居住，又如弔喪的安慰傷心的人。"
  }
]
