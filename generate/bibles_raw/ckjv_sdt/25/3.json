[
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 1,
    "text": "我是因　耶和華忿怒的杖，遭遇困苦的人。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 2,
    "text": "他引導我，使我行在黑暗中，不行在光明裏。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 3,
    "text": "他真是終日再三反手攻擊我。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 4,
    "text": "他使我的皮肉衰老；他折斷我的骨頭。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 5,
    "text": "他築壘攻擊我，用苦膽和艱難圍困我。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 6,
    "text": "他使我住在幽暗之處，像死了許久的人一樣。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 7,
    "text": "他用籬笆圍住我，使我不能出去；他使我的銅鏈沉重。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 8,
    "text": "我哀號求救；他使我的禱告不得上達。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 9,
    "text": "他用鑿過的石頭擋住我的道；他使我的路彎曲。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 10,
    "text": "他向我如熊埋伏，如獅子在隱密處。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 11,
    "text": "他使我轉離正路，將我撕碎，使我淒涼。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 12,
    "text": "他張弓將我當作箭靶子。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 13,
    "text": "他把箭袋中的箭射入我的肺腑。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 14,
    "text": "我成了眾民的笑話；他們終日以我為歌曲。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 15,
    "text": "他用苦楚充滿我，使我喝茵蔯而醉。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 16,
    "text": "他又用沙石磣斷我的牙，用灰塵將我蒙蔽。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 17,
    "text": "你使我遠離平安，我忘記興盛。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 18,
    "text": "我就說：我的力量盼望都從　耶和華那裏滅絕了！"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 19,
    "text": "耶和華啊，求你記念我如茵蔯和苦膽的困苦窘迫。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 20,
    "text": "我心想念這些，就在裏面憂悶。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 21,
    "text": "我想起這事，心裏就有盼望。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 22,
    "text": "我們不致消滅，是出於　耶和華諸般的慈愛；是因他的憐憫不致斷絕。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 23,
    "text": "每早晨，這都是新的；你的誠實極其廣大！"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 24,
    "text": "我心裏說：　耶和華是我的分，因此，我要仰望他。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 25,
    "text": "凡等候　耶和華，心裏尋求他的，　耶和華必施恩給他。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 26,
    "text": "人仰望　耶和華，靜默等候他的救恩，這原是好的。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 27,
    "text": "人在幼年負軛，這原是好的。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 28,
    "text": "他當獨坐無言，因為這是　耶和華加在他身上的。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 29,
    "text": "他當口貼塵埃；或者有盼望。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 30,
    "text": "他當由人打他的腮頰，要滿受凌辱。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 31,
    "text": "因為　主必不永遠丟棄人。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 32,
    "text": "主雖使人憂愁，還要照他諸般的慈愛發憐憫。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 33,
    "text": "因他並不甘心使人受苦，使人憂愁。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 34,
    "text": "人將世上被囚的壓在腳下，"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 35,
    "text": "或在至　高者面前屈枉人，"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 36,
    "text": "或在人的訟事上顛倒是非，這都是　主看不上的。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 37,
    "text": "除非　主命定，誰能說成就成呢？"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 38,
    "text": "禍福不都出於至　高者的口嗎？"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 39,
    "text": "活人因自己的罪受罰，為何發怨言呢？"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 40,
    "text": "我們當深深考察自己的行為，再歸向　耶和華。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 41,
    "text": "我們當誠心向在諸天的　上帝舉手禱告。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 42,
    "text": "我們犯罪背逆；你並不赦免。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 43,
    "text": "你自被怒氣遮蔽，追趕我們；你施行殺戮，並不顧惜。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 44,
    "text": "你以密雲遮蔽自己，以致我們的禱告不得透入。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 45,
    "text": "你使我們在眾民中成為污穢和渣滓。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 46,
    "text": "我們一切仇敵都向我們大大張口。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 47,
    "text": "恐懼和網羅，殘害和毀滅，都臨近我們。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 48,
    "text": "因我民女子遭的毀滅，我就眼淚下流如河。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 49,
    "text": "我的眼多多流淚，總不止息，"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 50,
    "text": "直等　耶和華垂顧，從天觀看。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 51,
    "text": "因我本城的眾女，我的眼，使我的心傷痛。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 52,
    "text": "無故與我為仇的追逼我，像追雀鳥一樣。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 53,
    "text": "他們使我的命在深牢中斷絕，並將一塊石頭拋在我身上。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 54,
    "text": "眾水流過我頭，那時我說：我命斷絕了！"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 55,
    "text": "耶和華啊，我從深牢中求告你的名。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 56,
    "text": "你已經聽見我的聲音；求你不要掩耳不聽我的呼聲，我的求救。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 57,
    "text": "我求告你的日子，你臨近我，說：不要懼怕！"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 58,
    "text": "主啊，你伸明了我的冤；你救贖了我的命。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 59,
    "text": "耶和華啊，你見了我受的委屈；求你為我斷案。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 60,
    "text": "他們仇恨我，謀害我，你都看見了。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 61,
    "text": "耶和華啊，你聽見他們辱罵我的話，知道他們向我所設的計，"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 62,
    "text": "並那些起來攻擊我的人嘴唇所說的話，以及終日向我所設的計謀。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 63,
    "text": "求你觀看，他們坐下，起來，都以我為歌曲。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 64,
    "text": "耶和華啊，你要按著他們手所作的向他們施行報應。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 65,
    "text": "你要使他們心裏愁苦，使你的咒詛臨到他們。"
  },
  {
    "bookId": 25,
    "chapterId": 3,
    "verseId": 66,
    "text": "你要在怒中，從　耶和華諸天之下逼迫除滅他們。"
  }
]
