[
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 1,
    "text": "耶和華啊，求你記念我們所遭遇的事；察看我們所受的凌辱。"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 2,
    "text": "我們的產業轉歸外邦人，我們的房屋歸與外路人。"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 3,
    "text": "我們是孤兒，是無父的，我們的母親好像寡婦。"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 4,
    "text": "我們出錢才得喝我們的水；我們的柴是人賣給我們的。"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 5,
    "text": "逼迫直逼我們頸項；我們勞碌不得歇息。"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 6,
    "text": "我們將手交付埃及人和亞述人，為要得糧吃飽。"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 7,
    "text": "我們列祖犯罪，而今不在了；我們擔當他們的罪孽。"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 8,
    "text": "僕人轄制了我們；無人救我們脫離他們的手。"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 9,
    "text": "因為曠野的刀劍，我們冒著險才得糧食。"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 10,
    "text": "因可怕的飢餓，我們的皮膚就黑如爐。"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 11,
    "text": "敵人在錫安玷污婦人，在猶大的城邑玷污處女。"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 12,
    "text": "他們吊起首領的手；也不尊敬老人的面。"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 13,
    "text": "他們拿少年人作推磨，孩童背木柴，都跌倒了。"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 14,
    "text": "老年人從城門口斷絕，少年人不再作樂。"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 15,
    "text": "我們心中的快樂止息；我們跳舞變為悲哀。"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 16,
    "text": "冠冕從我們的頭上落下；我們犯罪了，我們有禍了！"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 17,
    "text": "我們因這事心裏發昏；因這些事，我們的眼睛昏花。"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 18,
    "text": "因為錫安山荒涼，狐狸行在其上。"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 19,
    "text": "耶和華啊，你存到永遠；你的寶座存到世世代代。"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 20,
    "text": "你為何永遠忘記我們，為何許久離棄我們？"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 21,
    "text": "耶和華啊，求你使我們向你回轉，我們便得回轉；求你復新我們的日子，像古時一樣。"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 22,
    "text": "你倒全然棄絕我們；你向我們大發烈怒。"
  }
]
