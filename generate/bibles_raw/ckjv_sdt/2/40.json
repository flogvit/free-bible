[
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 1,
    "text": "耶和華曉諭摩西說："
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 2,
    "text": "「正月初一日，你要立起帳幕，"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 3,
    "text": "把法櫃安放在裏面，用幔子將櫃遮掩。"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 4,
    "text": "把桌子搬進去，擺設上面的物。把燭臺搬進去，點其上的燈。"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 5,
    "text": "把燒香的金壇安在法櫃前，掛上帳幕的門簾。"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 6,
    "text": "把燔祭壇安在帳幕門前。"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 7,
    "text": "把洗濯盆安在會幕和壇的中間，在盆裏盛水。"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 8,
    "text": "又在四圍立院帷，把院子的門簾掛上。"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 9,
    "text": "用膏油把帳幕和其中所有的都抹上，使帳幕和一切器具成聖，就都成聖。"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 10,
    "text": "又要抹燔祭壇和一切器具，使壇成聖，就都成為至聖。"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 11,
    "text": "要抹洗濯盆和盆座，使盆成聖。"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 12,
    "text": "要使亞倫和他兒子到會幕門口來，用水洗身。"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 13,
    "text": "要給亞倫穿上聖衣，又膏他，使他成聖，可以給我供祭司的職分；"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 14,
    "text": "又要使他兒子來，給他們穿上內袍。"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 15,
    "text": "怎樣膏他們的父親，也要照樣膏他們，使他們給我供祭司的職分；因他們世世代代凡受膏的，必要永遠當祭司的職任。」"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 16,
    "text": "摩西這樣行，都是照　耶和華所吩咐他的。"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 17,
    "text": "第二年正月初一日，帳幕就立起來。"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 18,
    "text": "摩西立起帳幕，安上帶卯的座，立上板，穿上閂，立起柱子。"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 19,
    "text": "在帳幕以上搭罩棚，把罩棚的頂蓋蓋在其上，是照　耶和華所吩咐他的。"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 20,
    "text": "又把法版放在櫃裏，把槓穿在櫃的兩旁，把施恩座安在櫃上。"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 21,
    "text": "把櫃抬進帳幕，掛上遮掩櫃的幔子，把法櫃遮掩了，是照　耶和華所吩咐他的。"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 22,
    "text": "又把桌子安在會幕內，在帳幕北邊，在幔子外。"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 23,
    "text": "在桌子上將餅陳設在　耶和華面前，是照　耶和華所吩咐他的。"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 24,
    "text": "又把燭臺安在會幕內，在帳幕南邊，與桌子相對，"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 25,
    "text": "在　耶和華面前點燈，是照　耶和華所吩咐他的。"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 26,
    "text": "把金壇安在會幕內的幔子前，"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 27,
    "text": "在壇上燒了美香；是照　耶和華所吩咐摩西的。"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 28,
    "text": "又掛上帳幕的門簾。"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 29,
    "text": "在會幕的帳幕門前，安設燔祭壇，把燔祭和素祭獻在其上，是照　耶和華所吩咐他的。"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 30,
    "text": "把洗濯盆安在會幕和壇的中間，盆中盛水，以便洗濯。"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 31,
    "text": "摩西和亞倫並亞倫的兒子在這盆裏洗手洗腳。"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 32,
    "text": "他們進會幕或就近壇的時候，便都洗濯，是照　耶和華所吩咐他的。"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 33,
    "text": "在帳幕和壇的四圍立了院帷，把院子的門簾掛上。這樣，摩西就完了工。"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 34,
    "text": "當時，雲彩遮蓋會幕，　耶和華的榮光就充滿了帳幕。"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 35,
    "text": "摩西不能進會幕；因為雲彩停在其上，並且　耶和華的榮光充滿了帳幕。"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 36,
    "text": "每逢雲彩從帳幕收上去，以色列人就起程前往；"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 37,
    "text": "雲彩若不收上去，他們就不起程，直等到雲彩收上去。"
  },
  {
    "bookId": 2,
    "chapterId": 40,
    "verseId": 38,
    "text": "日間，　耶和華的雲彩是在帳幕以上；夜間，雲中有火，在以色列全家的眼前。在他們所行的路上都是這樣。"
  }
]
