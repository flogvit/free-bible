[
  {
    "bookId": 2,
    "chapterId": 21,
    "verseId": 1,
    "text": "「你在百姓面前所要立的典章是這樣："
  },
  {
    "bookId": 2,
    "chapterId": 21,
    "verseId": 2,
    "text": "你若買希伯來人作僕人，他必服事你六年；第七年他可以自由，白白的出去。"
  },
  {
    "bookId": 2,
    "chapterId": 21,
    "verseId": 3,
    "text": "他若孤身來就可以孤身去；他若有妻，他的妻就可以同他出去。"
  },
  {
    "bookId": 2,
    "chapterId": 21,
    "verseId": 4,
    "text": "他主人若給他妻子，妻子給他生了兒子或女兒，妻子和兒女要歸主人，他要獨自出去。"
  },
  {
    "bookId": 2,
    "chapterId": 21,
    "verseId": 5,
    "text": "倘或僕人明說：我愛我的主人和我的妻子兒女，不願意自由出去。』"
  },
  {
    "bookId": 2,
    "chapterId": 21,
    "verseId": 6,
    "text": "他的主人就要帶他到審判官那裏，又要帶他到門前，靠近門框，用錐子穿他的耳朵，他就永遠服事主人。"
  },
  {
    "bookId": 2,
    "chapterId": 21,
    "verseId": 7,
    "text": "「人若賣女兒作婢女，婢女不可像男僕那樣出去。"
  },
  {
    "bookId": 2,
    "chapterId": 21,
    "verseId": 8,
    "text": "主人選定她歸自己，若不喜歡她，就要許她贖身；主人既然用詭詐待她，就沒有權柄賣給外邦人。"
  },
  {
    "bookId": 2,
    "chapterId": 21,
    "verseId": 9,
    "text": "主人若選定她給自己的兒子，就當待她如同女兒。"
  },
  {
    "bookId": 2,
    "chapterId": 21,
    "verseId": 10,
    "text": "若另娶一個，那女子的吃食、衣服，並好合的事，仍不可減少。"
  },
  {
    "bookId": 2,
    "chapterId": 21,
    "verseId": 11,
    "text": "若不向她行這三樣，她就可以不用錢贖，白白的出去。」"
  },
  {
    "bookId": 2,
    "chapterId": 21,
    "verseId": 12,
    "text": "「打人以致打死的，必要把他治死。"
  },
  {
    "bookId": 2,
    "chapterId": 21,
    "verseId": 13,
    "text": "人若不是埋伏著殺人，乃是　上帝交在他手中，我就設下一個地方，他可以往那裏逃跑。"
  },
  {
    "bookId": 2,
    "chapterId": 21,
    "verseId": 14,
    "text": "人若任意用詭計殺了他的鄰舍，就是逃到我的壇那裏，也當捉去把他治死。"
  },
  {
    "bookId": 2,
    "chapterId": 21,
    "verseId": 15,
    "text": "「打父母的，必要把他治死。"
  },
  {
    "bookId": 2,
    "chapterId": 21,
    "verseId": 16,
    "text": "「拐帶人口，或是把人賣了，或是留在他手下，必要把他治死。"
  },
  {
    "bookId": 2,
    "chapterId": 21,
    "verseId": 17,
    "text": "「咒罵父母的，必要把他治死。"
  },
  {
    "bookId": 2,
    "chapterId": 21,
    "verseId": 18,
    "text": "「人若彼此相爭，這個用石頭或是拳頭打那個，尚且不至於死，不過躺臥在床，"
  },
  {
    "bookId": 2,
    "chapterId": 21,
    "verseId": 19,
    "text": "若再能起來扶杖而出，那打他的可算無罪；但要將他耽誤的工夫用錢賠補，並要將他全然醫好。"
  },
  {
    "bookId": 2,
    "chapterId": 21,
    "verseId": 20,
    "text": "「人若用棍子打僕人或婢女，立時死在他的手下，他必要受刑。"
  },
  {
    "bookId": 2,
    "chapterId": 21,
    "verseId": 21,
    "text": "然而，若過一兩天才死，就可以不受刑，因為是用錢買的。"
  },
  {
    "bookId": 2,
    "chapterId": 21,
    "verseId": 22,
    "text": "「人若彼此爭鬥，傷害有孕的婦人，甚至墜胎，隨後卻無別害，那傷害她的，總要按婦人的丈夫所要的，照審判官所斷的，受罰。"
  },
  {
    "bookId": 2,
    "chapterId": 21,
    "verseId": 23,
    "text": "若有別害，就要以命償命，"
  },
  {
    "bookId": 2,
    "chapterId": 21,
    "verseId": 24,
    "text": "以眼還眼，以牙還牙，以手還手，以腳還腳，"
  },
  {
    "bookId": 2,
    "chapterId": 21,
    "verseId": 25,
    "text": "以烙還烙，以傷還傷，以打還打。"
  },
  {
    "bookId": 2,
    "chapterId": 21,
    "verseId": 26,
    "text": "「人若打壞了他僕人或是婢女的一隻眼，就要因他的眼放他去得以自由。"
  },
  {
    "bookId": 2,
    "chapterId": 21,
    "verseId": 27,
    "text": "若打掉了他僕人或是婢女的一個牙，就要因他的牙放他去得以自由。」"
  },
  {
    "bookId": 2,
    "chapterId": 21,
    "verseId": 28,
    "text": "「牛若觸死男人或是女人，總要用石頭打死那牛，卻不可吃牠的肉；牛的主人可算無罪。"
  },
  {
    "bookId": 2,
    "chapterId": 21,
    "verseId": 29,
    "text": "倘若那牛素來是觸人的，有人報告了牛主，他竟不把牛拴著，以致把男人或是女人觸死，就要用石頭打死那牛，牛主也必治死。"
  },
  {
    "bookId": 2,
    "chapterId": 21,
    "verseId": 30,
    "text": "若罰他贖命的價銀，他必照所罰的贖他的命。"
  },
  {
    "bookId": 2,
    "chapterId": 21,
    "verseId": 31,
    "text": "牛無論觸了人的兒子或是女兒，必照這例辦理。"
  },
  {
    "bookId": 2,
    "chapterId": 21,
    "verseId": 32,
    "text": "牛若觸了僕人或是婢女，必將銀子三十舍客勒給他們的主人，也要用石頭把牛打死。"
  },
  {
    "bookId": 2,
    "chapterId": 21,
    "verseId": 33,
    "text": "「人若敞著井口，或挖井不遮蓋，有牛或驢掉在裏頭，"
  },
  {
    "bookId": 2,
    "chapterId": 21,
    "verseId": 34,
    "text": "井主要拿錢賠還本主人，死牲畜要歸自己。"
  },
  {
    "bookId": 2,
    "chapterId": 21,
    "verseId": 35,
    "text": "「這人的牛若傷了那人的牛，以至於死，他們要賣了活牛，平分價值，也要平分死牛。"
  },
  {
    "bookId": 2,
    "chapterId": 21,
    "verseId": 36,
    "text": "人若知道這牛素來是觸人的，主人竟不把牛拴著，他必要以牛還牛，死牛要歸自己。」"
  }
]
