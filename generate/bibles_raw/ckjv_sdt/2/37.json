[
  {
    "bookId": 2,
    "chapterId": 37,
    "verseId": 1,
    "text": "比撒列用皂莢木作櫃，長二肘半，寬一肘半，高一肘半。"
  },
  {
    "bookId": 2,
    "chapterId": 37,
    "verseId": 2,
    "text": "裏外包上純金，四圍鑲上金牙邊，"
  },
  {
    "bookId": 2,
    "chapterId": 37,
    "verseId": 3,
    "text": "又鑄四個金環，安在櫃的四腳上：這邊兩環，那邊兩環。"
  },
  {
    "bookId": 2,
    "chapterId": 37,
    "verseId": 4,
    "text": "用皂莢木作兩根槓，用金包裹。"
  },
  {
    "bookId": 2,
    "chapterId": 37,
    "verseId": 5,
    "text": "把槓穿在櫃旁的環內，以便抬櫃。"
  },
  {
    "bookId": 2,
    "chapterId": 37,
    "verseId": 6,
    "text": "用純金作施恩座，長二肘半，寬一肘半。"
  },
  {
    "bookId": 2,
    "chapterId": 37,
    "verseId": 7,
    "text": "用金子錘出兩個基路伯來，安在施恩座的兩頭，"
  },
  {
    "bookId": 2,
    "chapterId": 37,
    "verseId": 8,
    "text": "這頭作一個基路伯，那頭作一個基路伯，二基路伯接連一塊，在施恩座的兩頭。"
  },
  {
    "bookId": 2,
    "chapterId": 37,
    "verseId": 9,
    "text": "二基路伯高張翅膀，遮掩施恩座；基路伯是臉對臉，朝著施恩座。"
  },
  {
    "bookId": 2,
    "chapterId": 37,
    "verseId": 10,
    "text": "他用皂莢木作一張桌子，長二肘，寬一肘，高一肘半，"
  },
  {
    "bookId": 2,
    "chapterId": 37,
    "verseId": 11,
    "text": "又包上純金，四圍鑲上金牙邊。"
  },
  {
    "bookId": 2,
    "chapterId": 37,
    "verseId": 12,
    "text": "桌子的四圍各作一掌寬的橫梁，橫梁上鑲著金牙邊，"
  },
  {
    "bookId": 2,
    "chapterId": 37,
    "verseId": 13,
    "text": "又鑄了四個金環，安在桌子四腳的四角上。"
  },
  {
    "bookId": 2,
    "chapterId": 37,
    "verseId": 14,
    "text": "安環子的地方與橫梁相對，可以穿槓抬桌子。"
  },
  {
    "bookId": 2,
    "chapterId": 37,
    "verseId": 15,
    "text": "他用皂莢木作兩根槓，用金包裹，以便抬桌子；"
  },
  {
    "bookId": 2,
    "chapterId": 37,
    "verseId": 16,
    "text": "又用純金作桌子上的器皿，就是盤子、調羹、碗，並用以蒙蓋的物。"
  },
  {
    "bookId": 2,
    "chapterId": 37,
    "verseId": 17,
    "text": "他用純金作一個燭臺；這燭臺的座和榦，與碗、球、花，都是接連一塊錘出來的。"
  },
  {
    "bookId": 2,
    "chapterId": 37,
    "verseId": 18,
    "text": "燭臺兩旁杈出六個枝子：這旁三個，那旁三個。"
  },
  {
    "bookId": 2,
    "chapterId": 37,
    "verseId": 19,
    "text": "這旁每枝上有三個碗，形狀像杏花，有球有花；那旁每枝上也有三個碗，形狀像杏花，有球有花。從燭臺杈出來的六個枝子都是如此。"
  },
  {
    "bookId": 2,
    "chapterId": 37,
    "verseId": 20,
    "text": "燭臺上有四個碗，形狀像杏花，有球有花。"
  },
  {
    "bookId": 2,
    "chapterId": 37,
    "verseId": 21,
    "text": "並且每兩個枝子以下有球，與枝子接連一塊；它杈出的六個枝子都是如此。"
  },
  {
    "bookId": 2,
    "chapterId": 37,
    "verseId": 22,
    "text": "球和枝子是接連一塊，都是一塊純金錘出來的。"
  },
  {
    "bookId": 2,
    "chapterId": 37,
    "verseId": 23,
    "text": "他用純金作它七個燈盞，並它蠟剪和蠟花盤。"
  },
  {
    "bookId": 2,
    "chapterId": 37,
    "verseId": 24,
    "text": "他用純金一他連得作它，及其中一切的器具。"
  },
  {
    "bookId": 2,
    "chapterId": 37,
    "verseId": 25,
    "text": "他用皂莢木作香壇，是四方的，長一肘，寬一肘，高二肘，壇的四角與壇接連一塊；"
  },
  {
    "bookId": 2,
    "chapterId": 37,
    "verseId": 26,
    "text": "又用純金把壇的上面與壇的四面並壇的四角包裹，又在壇的四圍鑲上金牙邊。"
  },
  {
    "bookId": 2,
    "chapterId": 37,
    "verseId": 27,
    "text": "作兩個金環，安在牙子邊以下，在壇的兩旁、兩根橫撐上，作為穿槓的用處，以便抬壇。"
  },
  {
    "bookId": 2,
    "chapterId": 37,
    "verseId": 28,
    "text": "用皂莢木作槓，用金包裹。"
  },
  {
    "bookId": 2,
    "chapterId": 37,
    "verseId": 29,
    "text": "他又按作香之法作聖膏油和馨香料的淨香。"
  }
]
