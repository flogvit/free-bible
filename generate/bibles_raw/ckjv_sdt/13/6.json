[
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 1,
    "text": "利未的兒子是革順、哥轄、米拉利。"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 2,
    "text": "歌轄的兒子是暗蘭、以斯哈、希伯倫、烏薛。"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 3,
    "text": "暗蘭的兒子是亞倫、摩西，還有女兒米利暗。亞倫的兒子是拿答、亞比戶、以利亞撒、以她瑪。"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 4,
    "text": "以利亞撒生非尼哈；非尼哈生亞比書；"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 5,
    "text": "亞比書生布基；布基生烏西；"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 6,
    "text": "烏西生西拉希雅；西拉希雅生米拉約；"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 7,
    "text": "米拉約生亞瑪利雅；亞瑪利雅生亞希突；"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 8,
    "text": "亞希突生撒督；撒督生亞希瑪斯；"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 9,
    "text": "亞希瑪斯生亞撒利雅；亞撒利雅生約哈難；"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 10,
    "text": "約哈難生亞撒利雅（這亞撒利雅在所羅門於耶路撒冷所建造的殿中，供祭司的職分）；"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 11,
    "text": "亞撒利雅生亞瑪利雅；亞瑪利雅生亞希突；"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 12,
    "text": "亞希突生撒督；撒督生沙龍；"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 13,
    "text": "沙龍生希勒家；希勒家生亞撒利雅；"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 14,
    "text": "亞撒利雅生西萊雅；西萊雅生約薩答。"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 15,
    "text": "當　耶和華藉尼布甲尼撒的手擄掠猶大和耶路撒冷人的時候，這約薩答也被擄去。"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 16,
    "text": "利未的兒子是革順、哥轄、米拉利。"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 17,
    "text": "革順的兒子名叫立尼、示每。"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 18,
    "text": "哥轄的兒子是暗蘭、以斯哈、希伯倫、烏薛。"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 19,
    "text": "米拉利的兒子是抹利、母示。這是按著利未人宗族分的各家。"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 20,
    "text": "革順的兒子是立尼；立尼的兒子是雅哈；雅哈的兒子是薪瑪；"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 21,
    "text": "薪瑪的兒子是約亞；約亞的兒子是易多；易多的兒子是謝拉；謝拉的兒子是耶特賴。"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 22,
    "text": "哥轄的兒子是亞米拿達；亞米拿達的兒子是可拉；可拉的兒子是亞惜；"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 23,
    "text": "亞惜的兒子是以利加拿；以利加拿的兒子是以比雅撒；以比雅撒的兒子是亞惜；"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 24,
    "text": "亞惜的兒子是他哈；他哈的兒子是烏列；烏列的兒子是烏西雅；烏西雅的兒子是少羅。"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 25,
    "text": "以利加拿的兒子是亞瑪賽和亞希摩。"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 26,
    "text": "亞希摩的兒子是以利加拿；以利加拿的兒子是瑣菲；瑣菲的兒子是拿哈；"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 27,
    "text": "拿哈的兒子是以利押；以利押的兒子是耶羅罕；耶羅罕的兒子是以利加拿；"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 28,
    "text": "以利加拿的兒子是撒母耳。撒母耳的長子是約珥，次子是亞比亞。"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 29,
    "text": "米拉利的兒子是抹利；抹利的兒子是立尼；立尼的兒子是示每；示每的兒子是烏撒；"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 30,
    "text": "烏撒的兒子是示米亞；示米亞的兒子是哈基雅；哈基雅的兒子是亞帥雅。"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 31,
    "text": "約櫃安設之後，大衛派人在　耶和華殿中管理歌唱的事。"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 32,
    "text": "他們就在會幕前當歌唱的差，及至所羅門在耶路撒冷建造了　耶和華的殿，他們便按著班次供職。"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 33,
    "text": "供職的人和他們的子孫記在下面：哥轄的子孫中有歌唱的希幔。希幔是約珥的兒子；約珥是撒母耳的兒子；"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 34,
    "text": "撒母耳是以利加拿的兒子；以利加拿是耶羅罕的兒子；耶羅罕是以列的兒子；以列是陀亞的兒子；"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 35,
    "text": "陀亞是蘇弗的兒子；蘇弗是以利加拿的兒子；以利加拿是瑪哈的兒子；瑪哈是亞瑪賽的兒子；"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 36,
    "text": "亞瑪賽是以利加拿的兒子；以利加拿是約珥的兒子；約珥是亞撒利雅的兒子；亞撒利雅是西番雅的兒子；"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 37,
    "text": "西番雅是他哈的兒子；他哈是亞惜的兒子；亞惜是以比雅撒的兒子；以比雅撒是可拉的兒子；"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 38,
    "text": "可拉是以斯哈的兒子；以斯哈是哥轄的兒子；哥轄是利未的兒子；利未是以色列的兒子。"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 39,
    "text": "希幔的族兄亞薩是比利家的兒子，亞薩在希幔右邊供職。比利家是示米亞的兒子；"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 40,
    "text": "示米亞是米迦勒的兒子；米迦勒是巴西雅的兒子；巴西雅是瑪基雅的兒子；"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 41,
    "text": "瑪基雅是伊特尼的兒子；伊特尼是謝拉的兒子；謝拉是亞大雅的兒子；"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 42,
    "text": "亞大雅是以探的兒子；以探是薪瑪的兒子；薪瑪是示每的兒子；"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 43,
    "text": "示每是雅哈的兒子；雅哈是革順的兒子。革順是利未的兒子。"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 44,
    "text": "他們的族弟兄米拉利的子孫，在他們左邊供職的有以探。以探是基示的兒子；基示是亞伯底的兒子；亞伯底是瑪鹿的兒子；"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 45,
    "text": "瑪鹿是哈沙比雅的兒子；哈沙比雅是亞瑪謝的兒子；亞瑪謝是希勒家的兒子；"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 46,
    "text": "希勒家是暗西的兒子；暗西是巴尼的兒子；巴尼是沙麥的兒子；"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 47,
    "text": "沙麥是末力的兒子；末力是母示的兒子；母示是米拉利的兒子；米拉利是利未的兒子。"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 48,
    "text": "他們的族弟兄利未人也被派辦　上帝殿中的一切事。"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 49,
    "text": "亞倫和他的子孫在燔祭壇和香壇上獻祭奉香，又在至聖之處辦理一切的事，為以色列人贖罪，是照　上帝僕人摩西所吩咐的。"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 50,
    "text": "亞倫的兒子是以利亞撒；以利亞撒的兒子是非尼哈；非尼哈的兒子是亞比書；"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 51,
    "text": "亞比書的兒子是布基；布基的兒子是烏西；烏西的兒子是西拉希雅；"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 52,
    "text": "西拉希雅的兒子是米拉約；米拉約的兒子是亞瑪利雅；亞瑪利雅的兒子是亞希突；"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 53,
    "text": "亞希突的兒子是撒督；撒督的兒子是亞希瑪斯。"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 54,
    "text": "他們的住處遍滿哥轄族亞倫子孫境內的城壘；哥轄族亞倫的子孫擲籤得地。"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 55,
    "text": "在猶大地中得了希伯崙和四圍的郊野；"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 56,
    "text": "只是屬城的田地和村莊都為耶孚尼的兒子迦勒所得。"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 57,
    "text": "亞倫的子孫得了猶大的逃城，名叫希伯崙，又得了立拿與其郊野，雅提珥、以實提莫與其郊野；"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 58,
    "text": "希崙與其郊野，底璧與其郊野，"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 59,
    "text": "亞珊與其郊野，伯‧示麥與其郊野。"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 60,
    "text": "在便雅憫支派的地中，得了迦巴與其郊野，阿勒篾與其郊野，亞拿突與其郊野。他們諸家所得的城共十三座。"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 61,
    "text": "哥轄的子孫─就是哥轄族所餘下的人又按籤，在瑪拿西半支派的地中得了十座城。"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 62,
    "text": "革順的子孫>遍及宗族，在以薩迦支派的地中，亞設支派的地中，拿弗他利支派的地中，巴珊內瑪拿西支派的地中，得了十三座城。"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 63,
    "text": "米拉利的子孫通族按籤，在呂便支派的地中，迦得支派的地中，西布倫支派的地中，得了十二座城。"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 64,
    "text": "以色列人將這些城與其郊野給了利未人。"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 65,
    "text": "這以上錄名的城，在猶大、西緬、便雅憫三支派的地中，以色列人按籤給了他們。"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 66,
    "text": "哥轄子孫中其餘的家在以法蓮支派的地中也得了城邑。"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 67,
    "text": "在以法蓮山地得了逃城示劍與其郊野，又得了基色與其郊野，"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 68,
    "text": "約緬與其郊野，伯‧和崙與其郊野，"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 69,
    "text": "亞雅崙與其郊野，迦特‧臨門與其郊野。"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 70,
    "text": "哥轄子孫其餘的家在瑪拿西半支派的地中得了亞乃與其郊野，比連與其郊野。"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 71,
    "text": "革順族在瑪拿西半支派的地中得了巴珊的哥蘭與其郊野，亞斯她錄與其郊野；"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 72,
    "text": "又在以薩迦支派的地中得了基低斯與其郊野，大比拉與其郊野，"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 73,
    "text": "拉末與其郊野，亞年與其郊野；"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 74,
    "text": "在亞設支派的地中得了瑪沙與其郊野，押頓與其郊野，"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 75,
    "text": "戶割與其郊野，利合與其郊野；"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 76,
    "text": "在拿弗他利支派的地中得了加利利的基低斯與其郊野，哈們與其郊野，基列亭與其郊野。"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 77,
    "text": "還有米拉利族的人在西布倫支派的地中得了臨摩挪與其郊野，他泊與其郊野；"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 78,
    "text": "又在耶利哥的約旦河東，在呂便支派的地中得了曠野的比悉與其郊野，雅雜與其郊野，"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 79,
    "text": "基底莫與其郊野，米法押與其郊野；"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 80,
    "text": "又在迦得支派的地中得了拉末‧基列與其郊野，瑪哈念與其郊野，"
  },
  {
    "bookId": 13,
    "chapterId": 6,
    "verseId": 81,
    "text": "希實本與其郊野，雅謝與其郊野。"
  }
]
