[
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 1,
    "text": "便雅憫的長子比拉，次子亞實別，三子亞哈拉，"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 2,
    "text": "四子挪哈，五子拉法。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 3,
    "text": "比拉的兒子是亞大、基拉、亞比忽、"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 4,
    "text": "亞比書、乃幔、亞何亞、"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 5,
    "text": "基拉、示孚汛、戶蘭。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 6,
    "text": "以忽的兒子作迦巴居民的族長，被遷移到瑪拿轄；"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 7,
    "text": "乃幔、亞希亞、基拉也被遷移。基拉生烏撒、亞希忽。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 8,
    "text": "沙哈連休他二妻戶伸和巴拉之後，在摩押地生兒養女。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 9,
    "text": "他從他的妻賀得生了約巴、洗比雅、米沙、瑪拉干、"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 10,
    "text": "耶烏斯、沙迦、米瑪。他這些兒子都是族長。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 11,
    "text": "他的妻戶伸給他生的兒子有亞比突、以利巴力。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 12,
    "text": "以利巴力的兒子是希伯、米珊、沙麥。沙麥建立阿挪和羅德二城與其村莊。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 13,
    "text": "又有比利亞和示瑪是亞雅崙居民的族長，是驅逐迦特人的。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 14,
    "text": "亞希約、沙煞、耶利末、"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 15,
    "text": "西巴第雅、亞拉得、亞得、"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 16,
    "text": "米迦勒、伊施巴、約哈都是比利亞的兒子。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 17,
    "text": "西巴第雅、米書蘭、希西基、希伯、"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 18,
    "text": "伊施米萊、伊斯利亞、約巴都是以利巴力的兒子。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 19,
    "text": "雅金、細基利、撒底、"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 20,
    "text": "以利乃、洗勒太、以列、"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 21,
    "text": "亞大雅、比拉雅、申拉都是示每的兒子。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 22,
    "text": "伊施班、希伯、以列、"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 23,
    "text": "亞伯頓、細基利、哈難、"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 24,
    "text": "哈拿尼雅、以攔、安陀提雅、"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 25,
    "text": "伊弗底雅、毗努伊勒都是沙煞的兒子。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 26,
    "text": "珊示萊、示哈利、亞她利雅、"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 27,
    "text": "雅利西、以利亞、細基利都是耶羅罕的兒子。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 28,
    "text": "這些人都是按他們宗族作族長，為首領。這些人都住在耶路撒冷。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 29,
    "text": "在基遍住的有基遍的父親耶利。他的妻名叫瑪迦；"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 30,
    "text": "他長子是亞伯頓。他又生蘇珥、基士、巴力、拿答、"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 31,
    "text": "基多、亞希約、撒迦、米基羅。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 32,
    "text": "米基羅生示米暗。這些人和他們的弟兄在耶路撒冷對面居住。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 33,
    "text": "尼珥生基士；基士生掃羅；掃羅生約拿單、麥基‧舒亞、亞比拿達、伊施‧巴力。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 34,
    "text": "約拿單的兒子是米非‧波設、米非‧波設生米迦。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 35,
    "text": "米迦的兒子是毗敦、米勒、他利亞、亞哈斯；"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 36,
    "text": "亞哈斯生耶何阿達；耶何阿達生亞拉篾、亞斯瑪威、心利；心利生摩撒；"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 37,
    "text": "摩撒生比尼亞；比尼亞的兒子是拉法；拉法的兒子是以利亞薩；以利亞薩的兒子是亞悉。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 38,
    "text": "亞悉有六個兒子，他們的名字是亞斯利干、波基路、以實瑪利、示亞利雅、俄巴底雅、哈難。這都是亞悉的兒子。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 39,
    "text": "亞悉兄弟以設的長子是烏蘭，次子耶烏施，三子是以利法列。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 40,
    "text": "烏蘭的兒子都是大能的勇士，是弓箭手，他們有許多的子孫，共一百五十名，都是便雅憫人。"
  }
]
