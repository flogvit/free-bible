[
  {
    "bookId": 22,
    "chapterId": 8,
    "verseId": 1,
    "text": "Vajha lennél nékem én atyámfia, ki az én anyámnak emlõjét szopta,"
  },
  {
    "bookId": 22,
    "chapterId": 8,
    "verseId": 2,
    "text": "Elvinnélek, bevinnélek anyámnak házába,"
  },
  {
    "bookId": 22,
    "chapterId": 8,
    "verseId": 3,
    "text": "Az õ balkeze az én fejem alatt,"
  },
  {
    "bookId": 22,
    "chapterId": 8,
    "verseId": 4,
    "text": "Kényszerítlek titeket, Jeruzsálemnek leányai,"
  },
  {
    "bookId": 22,
    "chapterId": 8,
    "verseId": 5,
    "text": "Kicsoda ez a ki feljõ a pusztából,"
  },
  {
    "bookId": 22,
    "chapterId": 8,
    "verseId": 6,
    "text": "Tégy engem mintegy pecsétet a te szívedre,"
  },
  {
    "bookId": 22,
    "chapterId": 8,
    "verseId": 7,
    "text": "Sok vizek el nem olthatnák e szeretetet:"
  },
  {
    "bookId": 22,
    "chapterId": 8,
    "verseId": 8,
    "text": "Kicsiny húgunk van nékünk,"
  },
  {
    "bookId": 22,
    "chapterId": 8,
    "verseId": 9,
    "text": "Ha õ kõfal,"
  },
  {
    "bookId": 22,
    "chapterId": 8,
    "verseId": 10,
    "text": "[Mikor] én [olyan leszek, mint] a kõfal,"
  },
  {
    "bookId": 22,
    "chapterId": 8,
    "verseId": 11,
    "text": "Szõlõje volt Salamonnak Baálhamonban,"
  },
  {
    "bookId": 22,
    "chapterId": 8,
    "verseId": 12,
    "text": "Az én szõlõmre, mely én reám néz, nékem gondom lesz:"
  },
  {
    "bookId": 22,
    "chapterId": 8,
    "verseId": 13,
    "text": "Oh te, a ki lakol a kertekben!"
  },
  {
    "bookId": 22,
    "chapterId": 8,
    "verseId": 14,
    "text": "Fuss én szerelmesem,"
  }
]
