[
  {
    "bookId": 22,
    "chapterId": 2,
    "verseId": 1,
    "text": "Én Sáronnak rózsája [vagyok,] és a völgyek lilioma."
  },
  {
    "bookId": 22,
    "chapterId": 2,
    "verseId": 2,
    "text": "Mint a liliom a tövisek közt,"
  },
  {
    "bookId": 22,
    "chapterId": 2,
    "verseId": 3,
    "text": "Mint az almafa az erdõnek fái közt,"
  },
  {
    "bookId": 22,
    "chapterId": 2,
    "verseId": 4,
    "text": "Bevisz engem a borozó házba,"
  },
  {
    "bookId": 22,
    "chapterId": 2,
    "verseId": 5,
    "text": "Erõsítsetek engem szõlõvel,"
  },
  {
    "bookId": 22,
    "chapterId": 2,
    "verseId": 6,
    "text": "Az õ balkeze az én fejem alatt van,"
  },
  {
    "bookId": 22,
    "chapterId": 2,
    "verseId": 7,
    "text": "Kényszerítlek titeket, Jeruzsálemnek leányai,"
  },
  {
    "bookId": 22,
    "chapterId": 2,
    "verseId": 8,
    "text": "Az én szerelmesemnek szavát [hallom], ímé, õ jõ,"
  },
  {
    "bookId": 22,
    "chapterId": 2,
    "verseId": 9,
    "text": "Hasonlatos az én szerelmesem az õzhöz, vagy a szarvasoknak fiához."
  },
  {
    "bookId": 22,
    "chapterId": 2,
    "verseId": 10,
    "text": "Szóla az én szerelmesem nékem, és monda:"
  },
  {
    "bookId": 22,
    "chapterId": 2,
    "verseId": 11,
    "text": "Mert ímé a tél elmult,"
  },
  {
    "bookId": 22,
    "chapterId": 2,
    "verseId": 12,
    "text": "Virágok láttatnak a földön,"
  },
  {
    "bookId": 22,
    "chapterId": 2,
    "verseId": 13,
    "text": "A fügefa érleli elsõ gyümölcsét,"
  },
  {
    "bookId": 22,
    "chapterId": 2,
    "verseId": 14,
    "text": "Én galambom, a kõsziklának hasadékiban,"
  },
  {
    "bookId": 22,
    "chapterId": 2,
    "verseId": 15,
    "text": "Fogjátok meg nékünk a rókákat, a rókafiakat,"
  },
  {
    "bookId": 22,
    "chapterId": 2,
    "verseId": 16,
    "text": "Az én szerelmesem enyém, és én az övé,"
  },
  {
    "bookId": 22,
    "chapterId": 2,
    "verseId": 17,
    "text": "Míglen meghûsül a nap és az árnyékok elmúlnak:"
  }
]
