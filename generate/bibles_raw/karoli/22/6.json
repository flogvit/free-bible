[
  {
    "bookId": 22,
    "chapterId": 6,
    "verseId": 1,
    "text": "Szép vagy én mátkám, mint Tirsa [városa,]"
  },
  {
    "bookId": 22,
    "chapterId": 6,
    "verseId": 2,
    "text": "Fordítsd el a te szemeidet én tõlem,"
  },
  {
    "bookId": 22,
    "chapterId": 6,
    "verseId": 3,
    "text": "A te fogaid hasonlók a juhok nyájához,"
  },
  {
    "bookId": 22,
    "chapterId": 6,
    "verseId": 4,
    "text": "Mint a pomagránát darabja a te vakszemed,"
  },
  {
    "bookId": 22,
    "chapterId": 6,
    "verseId": 5,
    "text": "Hatvanan vannak a királynék,"
  },
  {
    "bookId": 22,
    "chapterId": 6,
    "verseId": 6,
    "text": "És az én galambom, az én tökéletesem,"
  },
  {
    "bookId": 22,
    "chapterId": 6,
    "verseId": 7,
    "text": "Kicsoda az, a ki úgy láttatik mintegy hajnal,"
  },
  {
    "bookId": 22,
    "chapterId": 6,
    "verseId": 8,
    "text": "A diófás kertekbe mentem vala alá,"
  },
  {
    "bookId": 22,
    "chapterId": 6,
    "verseId": 9,
    "text": "Nem tudtam, hogy az én elmém ültete engem"
  },
  {
    "bookId": 22,
    "chapterId": 6,
    "verseId": 10,
    "text": "Térj meg, oh Sulamit!"
  },
  {
    "bookId": 22,
    "chapterId": 6,
    "verseId": 11,
    "text": ""
  },
