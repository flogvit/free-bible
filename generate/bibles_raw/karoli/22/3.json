[
  {
    "bookId": 22,
    "chapterId": 3,
    "verseId": 1,
    "text": "Az én ágyasházamban éjjeleken keresém azt, a kit szeret az én lelkem,"
  },
  {
    "bookId": 22,
    "chapterId": 3,
    "verseId": 2,
    "text": "Immár felkelek és eljárom a várost,"
  },
  {
    "bookId": 22,
    "chapterId": 3,
    "verseId": 3,
    "text": "Megtalálának engem az õrizõk, a kik a várost kerülik. [Mondék nékik:]"
  },
  {
    "bookId": 22,
    "chapterId": 3,
    "verseId": 4,
    "text": "Alig mentem vala el azoktól,"
  },
  {
    "bookId": 22,
    "chapterId": 3,
    "verseId": 5,
    "text": "Kényszerítelek titeket, Jeruzsálemnek leányai,"
  },
  {
    "bookId": 22,
    "chapterId": 3,
    "verseId": 6,
    "text": "Kicsoda az, a ki feljõ a pusztából,"
  },
  {
    "bookId": 22,
    "chapterId": 3,
    "verseId": 7,
    "text": "Ímé, ez a Salamon gyaloghintaja,"
  },
  {
    "bookId": 22,
    "chapterId": 3,
    "verseId": 8,
    "text": "Mindnyájan fegyverfogók, hadakozásban bölcsek,"
  },
  {
    "bookId": 22,
    "chapterId": 3,
    "verseId": 9,
    "text": "Hálóágyat csinált magának Salamon király"
  },
  {
    "bookId": 22,
    "chapterId": 3,
    "verseId": 10,
    "text": "Oszlopait ezüstbõl csinálta,"
  },
  {
    "bookId": 22,
    "chapterId": 3,
    "verseId": 11,
    "text": "Jõjjetek ki, és nézzétek, Sionnak leányai,"
  }
]
