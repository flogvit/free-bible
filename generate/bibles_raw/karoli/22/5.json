[
  {
    "bookId": 22,
    "chapterId": 5,
    "verseId": 1,
    "text": "Bementem az én kertembe, én húgom, jegyesem,"
  },
  {
    "bookId": 22,
    "chapterId": 5,
    "verseId": 2,
    "text": "Én elaludtam, de lelkemben vigyázok vala,"
  },
  {
    "bookId": 22,
    "chapterId": 5,
    "verseId": 3,
    "text": "[Felelék én:] Levetettem ruhámat,"
  },
  {
    "bookId": 22,
    "chapterId": 5,
    "verseId": 4,
    "text": "Az én szerelmesem kezét benyujtá az [ajtónak] hasadékán,"
  },
  {
    "bookId": 22,
    "chapterId": 5,
    "verseId": 5,
    "text": "Felkelék én, hogy az én szerelmesemnek megnyissam,"
  },
  {
    "bookId": 22,
    "chapterId": 5,
    "verseId": 6,
    "text": "Megnyitám az én szerelmesemnek;"
  },
  {
    "bookId": 22,
    "chapterId": 5,
    "verseId": 7,
    "text": "Megtalálának engem az õrizõk, a kik a várost kerülik,"
  },
  {
    "bookId": 22,
    "chapterId": 5,
    "verseId": 8,
    "text": "Kényszerítelek titeket, Jeruzsálemnek leányai,"
  },
  {
    "bookId": 22,
    "chapterId": 5,
    "verseId": 9,
    "text": "Micsoda a te szerelmesed [egyéb] szerelmesek felett,"
  },
  {
    "bookId": 22,
    "chapterId": 5,
    "verseId": 10,
    "text": "Az én szerelmesem fejér és piros,"
  },
  {
    "bookId": 22,
    "chapterId": 5,
    "verseId": 11,
    "text": "Az õ feje, [mint a] választott drága megtisztított arany;"
  },
  {
    "bookId": 22,
    "chapterId": 5,
    "verseId": 12,
    "text": "Az õ szemei mint a vízfolyás mellett való galambok,"
  },
  {
    "bookId": 22,
    "chapterId": 5,
    "verseId": 13,
    "text": "Az õ orczája hasonlatos a drága füveknek táblájához,"
  },
  {
    "bookId": 22,
    "chapterId": 5,
    "verseId": 14,
    "text": "Az õ kezei aranyhengerek;"
  },
  {
    "bookId": 22,
    "chapterId": 5,
    "verseId": 15,
    "text": "Az õ szárai márványoszlopok;"
  },
  {
    "bookId": 22,
    "chapterId": 5,
    "verseId": 16,
    "text": "Az õ ínye édességek,"
  }
]
