[
  {
    "bookId": 22,
    "chapterId": 7,
    "verseId": 1,
    "text": "Oh mely szépek a te lépéseid a sarukban,"
  },
  {
    "bookId": 22,
    "chapterId": 7,
    "verseId": 2,
    "text": "A te köldököd, mint a kerekded csésze,"
  },
  {
    "bookId": 22,
    "chapterId": 7,
    "verseId": 3,
    "text": "A te két emlõd, [mint] két õzike,"
  },
  {
    "bookId": 22,
    "chapterId": 7,
    "verseId": 4,
    "text": "A te nyakad, mint az elefánttetembõl csinált torony;"
  },
  {
    "bookId": 22,
    "chapterId": 7,
    "verseId": 5,
    "text": "A te fejed hasonló rajtad a Kármelhez,"
  },
  {
    "bookId": 22,
    "chapterId": 7,
    "verseId": 6,
    "text": "Mely igen szép vagy és mely kedves,"
  },
  {
    "bookId": 22,
    "chapterId": 7,
    "verseId": 7,
    "text": "Ez a te termeted hasonló a pálmafához,"
  },
  {
    "bookId": 22,
    "chapterId": 7,
    "verseId": 8,
    "text": "Azt mondám: felhágok a pálmafára,"
  },
  {
    "bookId": 22,
    "chapterId": 7,
    "verseId": 9,
    "text": "És a te ínyed, mint a legjobb bor,"
  },
  {
    "bookId": 22,
    "chapterId": 7,
    "verseId": 10,
    "text": "Én az én szerelmesemé vagyok,"
  },
  {
    "bookId": 22,
    "chapterId": 7,
    "verseId": 11,
    "text": "No, én szerelmesem, menjünk ki a mezõre,"
  },
  {
    "bookId": 22,
    "chapterId": 7,
    "verseId": 12,
    "text": "Felkelvén menjünk a szõlõkbe,"
  },
  {
    "bookId": 22,
    "chapterId": 7,
    "verseId": 13,
    "text": "A mandragórák illatoznak,"
  }
]
