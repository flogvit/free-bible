[
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 1,
    "text": "Dávid pedig ezt az éneket mondotta az Úrnak azon a napon, mikor az Úr megszabadítá õt minden ellenségeinek kezébõl, és a Saul kezébõl."
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 2,
    "text": "És monda: Az Úr az én kõsziklám és kõváram, és szabadítóm nékem."
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 3,
    "text": "Az Isten az én erõsségem, õ benne bízom én."
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 4,
    "text": "Az Úrhoz kiáltok, a ki dícséretreméltó;"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 5,
    "text": "Mert halál hullámai vettek engem körül,"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 6,
    "text": "A pokol kötelei vettek körül,"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 7,
    "text": "Szükségemben az Urat hívtam,"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 8,
    "text": "Akkor rengett és remegett a föld,"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 9,
    "text": "Füst szállt fel orrából,"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 10,
    "text": "Lehajtá az eget és leszállt,"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 11,
    "text": "A Khérubon ment és röpült,"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 12,
    "text": "Sötétségbõl maga körül sátrakat emelt,"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 13,
    "text": "Az elõtte levõ fényességbõl"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 14,
    "text": "És dörgött az égbõl az Úr,"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 15,
    "text": "Ellövé nyilait és szétszórta azokat,"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 16,
    "text": "És meglátszottak a tenger örvényei,"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 17,
    "text": "Lenyúlt a magasságból és felvett engem,"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 18,
    "text": "Hatalmas ellenségimtõl megszabadított engem;"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 19,
    "text": "Reámtörtek nyomorúságom napján,"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 20,
    "text": "Tágas helyre vitt ki engem,"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 21,
    "text": "Az Úr megfizetett nékem igazságom szerint,"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 22,
    "text": "Mert megõriztem az Úrnak utait,"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 23,
    "text": "Mert ítéletei mind elõttem vannak,"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 24,
    "text": "Tökéletes voltam elõtte, s õrizkedtem rosszaságomtól."
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 25,
    "text": "Ezért megfizet nékem az Úr igazságom szerint,"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 26,
    "text": "Az irgalmashoz irgalmas vagy,"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 27,
    "text": "A tisztához tiszta vagy,"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 28,
    "text": "Segítesz a nyomorult népen,"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 29,
    "text": "Mert te vagy az én szövétnekem, Uram,"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 30,
    "text": "Mert veled harczi seregen is átfutok,"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 31,
    "text": "Az Istennek útja tökéletes;"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 32,
    "text": "Mert kicsoda volna Isten az Úron kivül?"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 33,
    "text": "Isten az én erõs kõváram,"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 34,
    "text": "Lábait olyanná teszi, mint a szarvasé,"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 35,
    "text": "Kezeimet harczra tanítja,"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 36,
    "text": "Idvességednek paizsát adtad nékem,"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 37,
    "text": "Lépéseimet kiszélesítetted alattam."
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 38,
    "text": "Üldözöm ellenségeimet és elpusztítom õket,"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 39,
    "text": "Megsemmisítem, eltiprom õket, hogy fel nem kelhetnek,"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 40,
    "text": "Mert te erõvel öveztél fel engem a harczra,"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 41,
    "text": "Megadtad, hogy ellenségeim hátat fordítottak nékem,"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 42,
    "text": "Felnéztek, de nem volt, ki megszabadítsa,"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 43,
    "text": "Szétmorzsolom õket, mint a föld porát,"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 44,
    "text": "Megmentettél népemnek pártoskodásaitól,"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 45,
    "text": "Idegen fiak hizelkednek nékem,"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 46,
    "text": "Idegen fiak elcsüggednek,"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 47,
    "text": "Él az Úr és áldott az én kõsziklám."
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 48,
    "text": "Isten az, ki bosszút áll értem,"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 49,
    "text": "Ki megment engem ellenségeimtõl,"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 50,
    "text": "Dícsérlek azért téged, Uram, a pogányok között,"
  },
  {
    "bookId": 10,
    "chapterId": 22,
    "verseId": 51,
    "text": "Nagy segítséget ad az õ királyának,"
  }
]
