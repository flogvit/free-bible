[
  {
    "bookId": 7,
    "chapterId": 5,
    "verseId": 1,
    "text": "Énekelt pedig Debora és Bárák, az Abinoám fia azon a napon, mondván:"
  },
  {
    "bookId": 7,
    "chapterId": 5,
    "verseId": 2,
    "text": "Hogy a vezérek vezettek Izráelben,"
  },
  {
    "bookId": 7,
    "chapterId": 5,
    "verseId": 3,
    "text": "Halljátok meg királyok, figyeljetek fejedelmek!"
  },
  {
    "bookId": 7,
    "chapterId": 5,
    "verseId": 4,
    "text": "Uram, mikor Szeirbõl kijövél, Mikor lépdelél Edom mezejérõl:"
  },
  {
    "bookId": 7,
    "chapterId": 5,
    "verseId": 5,
    "text": "A hegyek megrendültek az Úrnak orczája elõtt,"
  },
  {
    "bookId": 7,
    "chapterId": 5,
    "verseId": 6,
    "text": "Sámgárnak, az Anath fiának napjaiban,"
  },
  {
    "bookId": 7,
    "chapterId": 5,
    "verseId": 7,
    "text": "Megszüntek a kerítetlen helyek Izráelben, megszüntek végképen,"
  },
  {
    "bookId": 7,
    "chapterId": 5,
    "verseId": 8,
    "text": "Új isteneket ha választott [a nép,]"
  },
  {
    "bookId": 7,
    "chapterId": 5,
    "verseId": 9,
    "text": "Szívem azoké, kik parancsolnak Izráelben,"
  },
  {
    "bookId": 7,
    "chapterId": 5,
    "verseId": 10,
    "text": "Kik ültök fehér szamarakon,"
  },
  {
    "bookId": 7,
    "chapterId": 5,
    "verseId": 11,
    "text": "Az íjászok szavával a vízmerítõk között,"
  },
  {
    "bookId": 7,
    "chapterId": 5,
    "verseId": 12,
    "text": "Kelj fel, kelj fel Debora!"
  },
  {
    "bookId": 7,
    "chapterId": 5,
    "verseId": 13,
    "text": "Akkor lejött a hõsök maradéka;"
  },
  {
    "bookId": 7,
    "chapterId": 5,
    "verseId": 14,
    "text": "Efraimból, kiknek gyökere Amálekben,"
  },
  {
    "bookId": 7,
    "chapterId": 5,
    "verseId": 15,
    "text": "És Issakhár fejedelmei Deborával,"
  },
  {
    "bookId": 7,
    "chapterId": 5,
    "verseId": 16,
    "text": "Miért [maradtál] ülve a hodályban?"
  },
  {
    "bookId": 7,
    "chapterId": 5,
    "verseId": 17,
    "text": "Gileád a Jordánon túl pihen."
  },
  {
    "bookId": 7,
    "chapterId": 5,
    "verseId": 18,
    "text": "[De] Zebulon, az halálra elszánt lelkû nép,"
  },
  {
    "bookId": 7,
    "chapterId": 5,
    "verseId": 19,
    "text": "Királyok jöttek, harczoltanak;"
  },
  {
    "bookId": 7,
    "chapterId": 5,
    "verseId": 20,
    "text": "Az égbõl harczoltak,"
  },
  {
    "bookId": 7,
    "chapterId": 5,
    "verseId": 21,
    "text": "A Kison patakja seprette el õket;"
  },
  {
    "bookId": 7,
    "chapterId": 5,
    "verseId": 22,
    "text": "Akkor csattogtak a lovak körmei"
  },
  {
    "bookId": 7,
    "chapterId": 5,
    "verseId": 23,
    "text": "Átkozzátok Mérozt - mond az Úr követje, -"
  },
  {
    "bookId": 7,
    "chapterId": 5,
    "verseId": 24,
    "text": "De áldott legyen az asszonyok felett Jáhel,"
  },
  {
    "bookId": 7,
    "chapterId": 5,
    "verseId": 25,
    "text": "[Az] vizet kért, õ tejet adott,"
  },
  {
    "bookId": 7,
    "chapterId": 5,
    "verseId": 26,
    "text": "Balját a szegre,"
  },
  {
    "bookId": 7,
    "chapterId": 5,
    "verseId": 27,
    "text": "Lábainál leroskadt, elesett, feküdt,"
  },
  {
    "bookId": 7,
    "chapterId": 5,
    "verseId": 28,
    "text": "Kinézett az ablakon, és jajgatott"
  },
  {
    "bookId": 7,
    "chapterId": 5,
    "verseId": 29,
    "text": "Fejedelemasszonyinak legokosabbjai válaszolnak néki;"
  },
  {
    "bookId": 7,
    "chapterId": 5,
    "verseId": 30,
    "text": "\"Vajjon nem zsákmányra találtak-é, s mostan osztozkodnak?"
  },
  {
    "bookId": 7,
    "chapterId": 5,
    "verseId": 31,
    "text": "Így veszszenek el minden te ellenségid, Uram!"
  }
]
