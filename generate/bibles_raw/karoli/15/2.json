[
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 1,
    "text": "Ezek pedig a tartománynak fiai, kik feljöttek vala a rabság foglyai közül, a kiket Nabukodonozor, Babilónia királya, fogva vitetett Babilóniába, s most visszajövének Jeruzsálembe és Júdába, kiki az õ városába."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 2,
    "text": "Kik jövének Zorobábellel, Jésuával, Nehémiással, Serájával, Rélájával, Mordokhaival, Bilsánnal, Miszpárral, Bigvaival, Rehummal, Baanával. Izráel népe férfiainak száma [ez:]"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 3,
    "text": "Paros fiai kétezerszázhetvenkettõ;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 4,
    "text": "Sefátja fiai háromszázhetvenkettõ;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 5,
    "text": "Árah fiai hétszázhetvenöt;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 6,
    "text": "Pahath-Moáb fiai, Jésua [és] Joáb fiaitól, kétezernyolczszáztizenkettõ;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 7,
    "text": "Élám fiai ezerkétszázötvennégy;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 8,
    "text": "Zattu fiai kilenczszáznegyvenöt;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 9,
    "text": "Zakkai fiai hétszázhatvan;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 10,
    "text": "Báni fiai hatszáznegyvenkettõ;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 11,
    "text": "Bébai fiai hatszázhuszonhárom;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 12,
    "text": "Azgád fiai ezerkétszázhuszonkettõ;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 13,
    "text": "Adónikám fiai hatszázhatvanhat;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 14,
    "text": "Bigvai fiai kétezerötvenhat;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 15,
    "text": "Ádin fiai négyszázötvennégy;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 16,
    "text": "Áter fiai, Ezékiástól, kilenczvennyolcz;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 17,
    "text": "Bésai fiai háromszázhuszonhárom;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 18,
    "text": "Jórá fiai száztizenkettõ;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 19,
    "text": "Hásum fiai kétszázhuszonhárom;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 20,
    "text": "Gibbár fiai kilenczvenöt;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 21,
    "text": "Bethlehem fiai százhuszonhárom;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 22,
    "text": "Netófah férfiai ötvenhat;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 23,
    "text": "Anathóth férfiai százhuszonnyolcz;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 24,
    "text": "Azmáveth fiai negyvenkettõ;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 25,
    "text": "Kirjáth-Árim, Kefira és Beéróth fiai hétszáznegyvenhárom;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 26,
    "text": "Ráma és Géba fiai hatszázhuszonegy;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 27,
    "text": "Mikmás férfiai százhuszonkettõ;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 28,
    "text": "Béthel és Ái férfiai kétszázhuszonhárom;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 29,
    "text": "Nebó fiai ötvenkettõ;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 30,
    "text": "Magbis fiai százötvenhat;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 31,
    "text": "A másik Élám fiai ezerkétszázötvennégy;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 32,
    "text": "Hárim fiai háromszázhúsz;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 33,
    "text": "Lód, Hádid és Ónó fiai hétszázhuszonöt;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 34,
    "text": "Jérikó fiai háromszáznegyvenöt;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 35,
    "text": "Szenáa fiai háromezerhatszázharmincz;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 36,
    "text": "A papok: Jedája fiai, Jésua családjából, kilenczszázhetvenhárom;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 37,
    "text": "Immér fiai ezerötvenkettõ;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 38,
    "text": "Pashur fiai ezerkétszáznegyvenhét;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 39,
    "text": "Hárim fiai ezertizenhét;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 40,
    "text": "A Léviták: Jésuának és Kadmiélnek fiai, Hodávia fiaitól, hetvennégy."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 41,
    "text": "Az énekesek: Asáf fiai százhuszonnyolcz;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 42,
    "text": "A kapunállók fiai: Sallum fiai, Ater fiai, Talmón fiai, Akkub fiai, Hatita fiai, Sóbai fiai, összesen százharminczkilencz."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 43,
    "text": "A Léviták szolgái: Siha fiai, Hasufa fiai, Tabbaóth fiai;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 44,
    "text": "Kérósz fiai, Sziaha fiai, Pádón fiai,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 45,
    "text": "Lebána fiai, Hagába fiai, Akkub fiai,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 46,
    "text": "Hágáb fiai, Salmai fiai, Hanán fiai,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 47,
    "text": "Giddél fiai, Gahar fiai, Reája fiai,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 48,
    "text": "Resin fiai, Nekóda fiai, Gazzám fiai,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 49,
    "text": "Uzza fiai, Pászéah fiai, Bészai fiai,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 50,
    "text": "Aszna fiai, Meunim fiai, Nefiszim fiai."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 51,
    "text": "Bakbuk fiai, Hakufa fiai, Harhur fiai,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 52,
    "text": "Basluth fiai, Mehida fiai, Harsa fiai,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 53,
    "text": "Barkósz fiai, Sziszera fiai, Temah fiai,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 54,
    "text": "Nesiah fiai, Hatifa fiai;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 55,
    "text": "Salamon szolgáinak fiai: Szótai fiai, Haszszófereth fiai, Peruda fiai,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 56,
    "text": "Jaalá fiai, Darkón fiai, Giddél fiai,"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 57,
    "text": "Sefátia fiai, Hattil fiai, Pókhereth-Hássebaim fiai, Ámi fiai."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 58,
    "text": "Összesen a Léviták szolgái és a Salamon szolgáinak fiai háromszázkilenczvenkettõ."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 59,
    "text": "És ezek, a kik feljövének Tél-Melahból, Tél-Harsából, Kerub-Addán- Immérbõl, de nem mondhatták meg családjukat és eredetüket, hogy Izráel közül valók-é:"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 60,
    "text": "Delája fiai, Tóbiás fiai, Nekóda fiai hatszázötvenkettõ."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 61,
    "text": "És a papok fiai közül: Habája fiai, Hakkós fiai, Barzillai fiai, ki a Gileádbeli Barzillai leányai közül vett magának feleséget, és ezek nevérõl nevezteték;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 62,
    "text": "Ezek keresték írásukat, tudniillik a nemzetségök könyvét, de nem találák, miért is kirekesztetének a papságból;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 63,
    "text": "És megmondá nékik a király helytartója, hogy ne egyenek a szentséges áldozatból, mígnem pap ítél az Urimmal és Tummimmal."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 64,
    "text": "Mind az egész gyülekezet együtt negyvenkétezerháromszázhatvan."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 65,
    "text": "Szolgáikon és szolgálóikon kivül - ezek száma hétezerháromszázharminczhét - valának nékik énekes férfiaik és asszonyaik kétszázan."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 66,
    "text": "Lovaik hétszázharminczhat, öszvéreik kétszáznegyvenöt;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 67,
    "text": "Tevéik négyszázharminczöt, hatezerhétszázhúsz szamárral."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 68,
    "text": "A családfõk közül pedig, mikor megérkezének az Úr házához, mely Jeruzsálemben van, némelyek önkénytesen adakozának az Isten házára, hogy fölépítenék azt az õ helyén;"
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 69,
    "text": "Tehetségök szerint adának az építés költségére aranyban hatvanegyezer dárikot, s ezüstben ötezer mánét, és száz papi ruhát."
  },
  {
    "bookId": 15,
    "chapterId": 2,
    "verseId": 70,
    "text": "És lakozának mind a papok, mind a Léviták, mind a nép fiai, mind az énekesek, mind a kapunállók, mind a Léviták szolgái városaikban, s így az egész Izráel a maga városaiban vala."
  }
]
