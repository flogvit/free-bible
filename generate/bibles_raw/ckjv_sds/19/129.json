[
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 1,
    "text": "（上行之诗。）以色列当说：从我幼年以来，敌人屡次苦害我，"
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 2,
    "text": "从我幼年以来，敌人屡次苦害我，却没有胜了我。"
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 3,
    "text": "如同扶犁的在我背上扶犁而耕，耕的犁沟甚长。"
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 4,
    "text": "耶和华是公义的；他砍断了恶人的绳索。"
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 5,
    "text": "愿恨恶锡安的都惭愧退后。"
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 6,
    "text": "愿他们像房顶上的草，未长成而枯干，"
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 7,
    "text": "收割的不够一把，捆禾的也不满怀。"
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 8,
    "text": "过路的也不说：愿　耶和华所赐的福归与你们！我们奉　耶和华的名给你们祝福！"
  }
]
