[
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 1,
    "text": "（大卫的诗。）　耶和华啊，我的心仰望你。"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 2,
    "text": "我的　上帝啊，我素来倚靠你；求你不要叫我羞愧，不要叫我的仇敌向我夸胜。"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 3,
    "text": "凡等候你的必不羞愧；唯有那无故行奸诈的必要羞愧。"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 4,
    "text": "耶和华啊，求你将你的道指示我，将你的路教训我！"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 5,
    "text": "求你以你的真理引导我，教训我，因为你是救我的　上帝。我终日等候你。"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 6,
    "text": "耶和华啊，求你记念你的怜悯和慈爱，因为这是亘古以来所常有的。"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 7,
    "text": "求你不要记念我幼年的罪愆和我的过犯；　耶和华啊，求你因你的恩惠，按你的慈爱记念我。"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 8,
    "text": "耶和华是良善正直的，所以他必指教罪人走正路。"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 9,
    "text": "他必按公平引领谦卑人，将他的道教训他们。"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 10,
    "text": "凡遵守他的约和他法度的人，　耶和华都以慈爱诚实待他。"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 11,
    "text": "耶和华啊，求你因你的名赦免我的罪，因为我的罪重大。"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 12,
    "text": "谁敬畏　耶和华，　耶和华必指教他当选择的道路。"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 13,
    "text": "他必安然居住；他的后裔必承受地土。"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 14,
    "text": "耶和华的奥秘与敬畏他的人同在；他必将自己的约指示他们。"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 15,
    "text": "我的眼目时常仰望　耶和华，因为他必将我的脚从网里拉出来。"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 16,
    "text": "求你转向我，怜恤我，因为我是孤独困苦。"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 17,
    "text": "我心里的愁苦甚多，求你救我脱离我的祸患啊。"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 18,
    "text": "求你看顾我的困苦，我的艰难，饶恕我一切的罪。"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 19,
    "text": "求你察看我的仇敌，因为他们人多，并且痛痛地恨我。"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 20,
    "text": "求你保护我的性命，搭救我，使我不致羞愧，因为我投靠你啊。"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 21,
    "text": "愿纯全、正直保守我，因为我等候你。"
  },
  {
    "bookId": 19,
    "chapterId": 25,
    "verseId": 22,
    "text": "上帝啊，求你救赎以色列脱离他一切的愁苦。"
  }
]
