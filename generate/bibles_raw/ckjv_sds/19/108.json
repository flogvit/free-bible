[
  {
    "bookId": 19,
    "chapterId": 108,
    "verseId": 1,
    "text": "（大卫的诗歌。）　上帝啊，我心坚定；我带着荣耀要唱诗歌颂！"
  },
  {
    "bookId": 19,
    "chapterId": 108,
    "verseId": 2,
    "text": "琴瑟啊，你们当醒起！我自己要极早醒起！"
  },
  {
    "bookId": 19,
    "chapterId": 108,
    "verseId": 3,
    "text": "耶和华啊，我要在列国中称赞你！我要在列邦中歌颂你。"
  },
  {
    "bookId": 19,
    "chapterId": 108,
    "verseId": 4,
    "text": "因为，你的慈爱大过诸天；你的诚实达到高云。"
  },
  {
    "bookId": 19,
    "chapterId": 108,
    "verseId": 5,
    "text": "上帝啊，愿你崇高过于诸天！愿你的荣耀高过全地！"
  },
  {
    "bookId": 19,
    "chapterId": 108,
    "verseId": 6,
    "text": "求你应允我，用右手拯救我，好叫你所亲爱的人得救。"
  },
  {
    "bookId": 19,
    "chapterId": 108,
    "verseId": 7,
    "text": "上帝已经指着他的圣洁说，我要欢乐；我要分开示剑，丈量疏割谷。"
  },
  {
    "bookId": 19,
    "chapterId": 108,
    "verseId": 8,
    "text": "基列是我的；玛拿西也是我的；以法莲是我头上的力量；犹大是我的设立律法者；"
  },
  {
    "bookId": 19,
    "chapterId": 108,
    "verseId": 9,
    "text": "摩押是我的沐浴盆；我要向以东抛鞋；我必向非利士夸胜。"
  },
  {
    "bookId": 19,
    "chapterId": 108,
    "verseId": 10,
    "text": "谁能领我进坚固城？谁能引我到以东地？"
  },
  {
    "bookId": 19,
    "chapterId": 108,
    "verseId": 11,
    "text": "上帝啊，你不是丢弃了我们吗？　上帝啊，你不和我们的军兵同去吗？"
  },
  {
    "bookId": 19,
    "chapterId": 108,
    "verseId": 12,
    "text": "求你帮助我们脱离苦难，因为人的帮助是枉然的。"
  },
  {
    "bookId": 19,
    "chapterId": 108,
    "verseId": 13,
    "text": "我们倚靠　上帝才得勇敢行事，因为践踏我们敌人的就是他。"
  }
]
