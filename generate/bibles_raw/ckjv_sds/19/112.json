[
  {
    "bookId": 19,
    "chapterId": 112,
    "verseId": 1,
    "text": "你们要赞美　耶和华！敬畏　耶和华，甚喜爱他命令的，这人便为有福！"
  },
  {
    "bookId": 19,
    "chapterId": 112,
    "verseId": 2,
    "text": "他的后裔在世必强盛；正直人的后代必要蒙福。"
  },
  {
    "bookId": 19,
    "chapterId": 112,
    "verseId": 3,
    "text": "他家中有货物，有钱财；他的公义存到永远。"
  },
  {
    "bookId": 19,
    "chapterId": 112,
    "verseId": 4,
    "text": "正直人在黑暗中，有光向他显现；他有恩惠，满怀怜悯和公义。"
  },
  {
    "bookId": 19,
    "chapterId": 112,
    "verseId": 5,
    "text": "善人施恩与人、借贷与人，他以见识引导他的事务。"
  },
  {
    "bookId": 19,
    "chapterId": 112,
    "verseId": 6,
    "text": "他必永不动摇；义人被记念，直到永远。"
  },
  {
    "bookId": 19,
    "chapterId": 112,
    "verseId": 7,
    "text": "他必不怕凶恶的信息；他心坚定，倚靠　耶和华。"
  },
  {
    "bookId": 19,
    "chapterId": 112,
    "verseId": 8,
    "text": "他心确定，总不惧怕，直到他看见他的敌人遭报。"
  },
  {
    "bookId": 19,
    "chapterId": 112,
    "verseId": 9,
    "text": "他施舍钱财，赒济贫穷；他的仁义存到永远。他的角必被高举，大有荣耀。"
  },
  {
    "bookId": 19,
    "chapterId": 112,
    "verseId": 10,
    "text": "恶人看见便恼恨，必咬牙而消化；恶人的心愿要归灭绝。"
  }
]
