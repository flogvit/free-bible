[
  {
    "bookId": 19,
    "chapterId": 99,
    "verseId": 1,
    "text": "耶和华作王；众民当战抖！他坐在二基路伯中间，地当动摇。"
  },
  {
    "bookId": 19,
    "chapterId": 99,
    "verseId": 2,
    "text": "耶和华在锡安为大；他超乎众民之上。"
  },
  {
    "bookId": 19,
    "chapterId": 99,
    "verseId": 3,
    "text": "他们当称赞你大而可畏的名，这名本为圣。"
  },
  {
    "bookId": 19,
    "chapterId": 99,
    "verseId": 4,
    "text": "王有能力，喜爱公平，坚立公正，在雅各中施行公平和公义。"
  },
  {
    "bookId": 19,
    "chapterId": 99,
    "verseId": 5,
    "text": "你们当尊崇　耶和华―我们的　上帝，在他脚凳前敬拜。他本为圣！"
  },
  {
    "bookId": 19,
    "chapterId": 99,
    "verseId": 6,
    "text": "在他的祭司中有摩西和亚伦；在求告他名的人中有撒母耳。他们求告　耶和华，他就应允他们。"
  },
  {
    "bookId": 19,
    "chapterId": 99,
    "verseId": 7,
    "text": "他在云柱中对他们说话；他们遵守他的法度和他所赐给他们的律例。"
  },
  {
    "bookId": 19,
    "chapterId": 99,
    "verseId": 8,
    "text": "耶和华―我们的　上帝啊，你应允他们；你是饶恕他们的　上帝，却按他们所行的报应他们。"
  },
  {
    "bookId": 19,
    "chapterId": 99,
    "verseId": 9,
    "text": "你们要尊崇　耶和华―我们的　上帝，在他的圣山敬拜，因为　耶和华―我们的　上帝本为圣！"
  }
]
