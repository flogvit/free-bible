[
  {
    "bookId": 19,
    "chapterId": 29,
    "verseId": 1,
    "text": "（大卫的诗。）勇士啊，你们要将荣耀、能力归给　耶和华，归给　耶和华！"
  },
  {
    "bookId": 19,
    "chapterId": 29,
    "verseId": 2,
    "text": "要将　耶和华的名所当得的荣耀归给他，以圣洁为妆饰敬拜　耶和华。"
  },
  {
    "bookId": 19,
    "chapterId": 29,
    "verseId": 3,
    "text": "耶和华的声音发在水上；荣耀的　上帝打雷；　耶和华打雷在多水之上。"
  },
  {
    "bookId": 19,
    "chapterId": 29,
    "verseId": 4,
    "text": "耶和华的声音大有能力；　耶和华的声音满有威严。"
  },
  {
    "bookId": 19,
    "chapterId": 29,
    "verseId": 5,
    "text": "耶和华的声音震破香柏树；　耶和华震碎黎巴嫩的香柏树。"
  },
  {
    "bookId": 19,
    "chapterId": 29,
    "verseId": 6,
    "text": "他也使之跳跃如牛犊，使黎巴嫩和西连跳跃如少壮的独角兽。"
  },
  {
    "bookId": 19,
    "chapterId": 29,
    "verseId": 7,
    "text": "耶和华的声音使火焰分岔。"
  },
  {
    "bookId": 19,
    "chapterId": 29,
    "verseId": 8,
    "text": "耶和华的声音震动旷野；　耶和华震动加低斯的旷野。"
  },
  {
    "bookId": 19,
    "chapterId": 29,
    "verseId": 9,
    "text": "耶和华的声音惊动母鹿落胎，树木也脱落净光。凡在他殿中的，都称说他的荣耀。"
  },
  {
    "bookId": 19,
    "chapterId": 29,
    "verseId": 10,
    "text": "耶和华坐在洪水之上；　耶和华坐着为　王，直到永远。"
  },
  {
    "bookId": 19,
    "chapterId": 29,
    "verseId": 11,
    "text": "耶和华必赐力量给他的百姓；　耶和华必以平安赐福给他的百姓。"
  }
]
