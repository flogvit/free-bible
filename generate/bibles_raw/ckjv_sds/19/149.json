[
  {
    "bookId": 19,
    "chapterId": 149,
    "verseId": 1,
    "text": "你们要赞美　耶和华！向　耶和华唱新歌，在圣民的会中赞美他！"
  },
  {
    "bookId": 19,
    "chapterId": 149,
    "verseId": 2,
    "text": "愿以色列因造他的主欢喜！愿锡安的民因他们的　王快乐！"
  },
  {
    "bookId": 19,
    "chapterId": 149,
    "verseId": 3,
    "text": "愿他们跳舞赞美他的名，击鼓弹琴歌颂他！"
  },
  {
    "bookId": 19,
    "chapterId": 149,
    "verseId": 4,
    "text": "因为　耶和华喜爱他的百姓；他要用救恩当作谦卑人的妆饰。"
  },
  {
    "bookId": 19,
    "chapterId": 149,
    "verseId": 5,
    "text": "愿圣民因所得的荣耀高兴！愿他们在床上大声歌唱！"
  },
  {
    "bookId": 19,
    "chapterId": 149,
    "verseId": 6,
    "text": "愿他们口中称赞　上帝为高，手里有两刃的刀，"
  },
  {
    "bookId": 19,
    "chapterId": 149,
    "verseId": 7,
    "text": "为要报复异教的民，刑罚众民；"
  },
  {
    "bookId": 19,
    "chapterId": 149,
    "verseId": 8,
    "text": "要用链子捆他们的君王，用铁镣锁他们的大臣；"
  },
  {
    "bookId": 19,
    "chapterId": 149,
    "verseId": 9,
    "text": "要在他们身上施行所记录的审判。他的圣民都有这荣耀。你们要赞美　耶和华！"
  }
]
