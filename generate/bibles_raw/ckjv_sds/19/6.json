[
  {
    "bookId": 19,
    "chapterId": 6,
    "verseId": 1,
    "text": "（大卫的诗，交与伶长。用丝弦的乐器，调用第八。）　耶和华啊，求你不要在怒中责备我，也不要在烈怒中惩罚我。"
  },
  {
    "bookId": 19,
    "chapterId": 6,
    "verseId": 2,
    "text": "耶和华啊，求你可怜我，因为我软弱。　耶和华啊，求你医治我，因为我的骨头发战。"
  },
  {
    "bookId": 19,
    "chapterId": 6,
    "verseId": 3,
    "text": "我心也大大地惊惶；　耶和华啊，你却要到几时才救我呢？"
  },
  {
    "bookId": 19,
    "chapterId": 6,
    "verseId": 4,
    "text": "耶和华啊，求你转回搭救我；因你的怜悯拯救我。"
  },
  {
    "bookId": 19,
    "chapterId": 6,
    "verseId": 5,
    "text": "因为，在死地无人记念你，在坟墓有谁称谢你？"
  },
  {
    "bookId": 19,
    "chapterId": 6,
    "verseId": 6,
    "text": "我因唉哼而困乏；我终夜流泪，把床榻漂起，把褥子湿透。"
  },
  {
    "bookId": 19,
    "chapterId": 6,
    "verseId": 7,
    "text": "我因忧愁眼睛干瘪，又因我一切的敌人眼睛昏花。"
  },
  {
    "bookId": 19,
    "chapterId": 6,
    "verseId": 8,
    "text": "你们一切作孽的人，离开我吧！因为　耶和华听了我哀哭的声音。"
  },
  {
    "bookId": 19,
    "chapterId": 6,
    "verseId": 9,
    "text": "耶和华听了我的恳求；　耶和华必收纳我的祷告。"
  },
  {
    "bookId": 19,
    "chapterId": 6,
    "verseId": 10,
    "text": "我的一切仇敌都必羞愧，大大惊惶；他们必要退后，忽然羞愧。"
  }
]
