[
  {
    "bookId": 19,
    "chapterId": 97,
    "verseId": 1,
    "text": "耶和华作王！愿地快乐！愿众海岛欢喜！"
  },
  {
    "bookId": 19,
    "chapterId": 97,
    "verseId": 2,
    "text": "密云和幽暗在他的四围；公义和公平是他宝座的所在。"
  },
  {
    "bookId": 19,
    "chapterId": 97,
    "verseId": 3,
    "text": "有烈火在他前头行，烧灭他四围的敌人。"
  },
  {
    "bookId": 19,
    "chapterId": 97,
    "verseId": 4,
    "text": "他的闪电光照世界，大地看见便震动。"
  },
  {
    "bookId": 19,
    "chapterId": 97,
    "verseId": 5,
    "text": "诸山见　耶和华的面，就是全地之　主的面，便消化如蜡。"
  },
  {
    "bookId": 19,
    "chapterId": 97,
    "verseId": 6,
    "text": "诸天表明他的公义；众民看见他的荣耀。"
  },
  {
    "bookId": 19,
    "chapterId": 97,
    "verseId": 7,
    "text": "愿一切事奉雕刻的众像、靠虚无之偶像自夸的，尽都抱愧；众神哪，你们都当敬拜他。"
  },
  {
    "bookId": 19,
    "chapterId": 97,
    "verseId": 8,
    "text": "耶和华啊，锡安听见你的判断就欢喜；犹大的众女也都快乐。"
  },
  {
    "bookId": 19,
    "chapterId": 97,
    "verseId": 9,
    "text": "因为你―　耶和华高过全地；你被尊崇，远超众神之上。"
  },
  {
    "bookId": 19,
    "chapterId": 97,
    "verseId": 10,
    "text": "你们爱　耶和华的，都当恨恶罪恶；他保护圣民的性命，搭救他们脱离恶人的手。"
  },
  {
    "bookId": 19,
    "chapterId": 97,
    "verseId": 11,
    "text": "散布亮光是为义人；预备喜乐是为正直人。"
  },
  {
    "bookId": 19,
    "chapterId": 97,
    "verseId": 12,
    "text": "你们义人当靠　耶和华欢喜，称谢他可记念的圣名。"
  }
]
