[
  {
    "bookId": 19,
    "chapterId": 26,
    "verseId": 1,
    "text": "（大卫的诗。）　耶和华啊，求你判断我，因我向来行事纯全；我又倚靠　耶和华，并不摇动。"
  },
  {
    "bookId": 19,
    "chapterId": 26,
    "verseId": 2,
    "text": "耶和华啊，求你察看我，试验我，试炼我的肺腑心肠。"
  },
  {
    "bookId": 19,
    "chapterId": 26,
    "verseId": 3,
    "text": "因为你的慈爱常在我眼前，我也按你的真理而行。"
  },
  {
    "bookId": 19,
    "chapterId": 26,
    "verseId": 4,
    "text": "我没有和虚谎人同坐，也不与瞒哄人的同群。"
  },
  {
    "bookId": 19,
    "chapterId": 26,
    "verseId": 5,
    "text": "我恨恶恶人的会，必不与恶人同坐。"
  },
  {
    "bookId": 19,
    "chapterId": 26,
    "verseId": 6,
    "text": "耶和华啊，我要洗手表明无辜，才环绕你的祭坛；"
  },
  {
    "bookId": 19,
    "chapterId": 26,
    "verseId": 7,
    "text": "我好发称谢的声音，也要述说你一切奇妙的作为。"
  },
  {
    "bookId": 19,
    "chapterId": 26,
    "verseId": 8,
    "text": "耶和华啊，我喜爱你所住的殿和你显荣耀的居所。"
  },
  {
    "bookId": 19,
    "chapterId": 26,
    "verseId": 9,
    "text": "不要把我的元魂和罪人一同聚集；不要把我的性命和流人血的一同聚集。"
  },
  {
    "bookId": 19,
    "chapterId": 26,
    "verseId": 10,
    "text": "他们的手中有奸恶，右手满有贿赂。"
  },
  {
    "bookId": 19,
    "chapterId": 26,
    "verseId": 11,
    "text": "至于我，却要行事纯全；求你救赎我，怜恤我！"
  },
  {
    "bookId": 19,
    "chapterId": 26,
    "verseId": 12,
    "text": "我的脚站在平坦地方；在众会中我要称颂　耶和华！"
  }
]
