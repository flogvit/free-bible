[
  {
    "bookId": 19,
    "chapterId": 113,
    "verseId": 1,
    "text": "你们要赞美　耶和华！　耶和华的仆人哪，你们要赞美，赞美　耶和华的名！"
  },
  {
    "bookId": 19,
    "chapterId": 113,
    "verseId": 2,
    "text": "耶和华的名是应当称颂的，从今时直到永远！"
  },
  {
    "bookId": 19,
    "chapterId": 113,
    "verseId": 3,
    "text": "从日出之地到日落之处，　耶和华的名是应当赞美的！"
  },
  {
    "bookId": 19,
    "chapterId": 113,
    "verseId": 4,
    "text": "耶和华超乎列国之上，他的荣耀高过诸天。"
  },
  {
    "bookId": 19,
    "chapterId": 113,
    "verseId": 5,
    "text": "谁像　耶和华―我们的　上帝，住在高处，"
  },
  {
    "bookId": 19,
    "chapterId": 113,
    "verseId": 6,
    "text": "自己谦卑，观看天上地下的事！"
  },
  {
    "bookId": 19,
    "chapterId": 113,
    "verseId": 7,
    "text": "他从灰尘里抬举贫寒人，从粪堆中提拔穷乏人，"
  },
  {
    "bookId": 19,
    "chapterId": 113,
    "verseId": 8,
    "text": "使他们与王子同坐，就是与本国的王子同坐。"
  },
  {
    "bookId": 19,
    "chapterId": 113,
    "verseId": 9,
    "text": "他使不能生育的妇人安居家中，为多子的乐母。你们要赞美　耶和华！"
  }
]
