[
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 1,
    "text": "你们要称谢　耶和华啊，因他本为善；他的慈爱永远长存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 2,
    "text": "你们要称谢众神之　上帝啊，因他的慈爱永远长存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 3,
    "text": "你们要称谢众主之　主啊，因他的慈爱永远长存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 4,
    "text": "称谢那独行大奇事的，因他的慈爱永远长存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 5,
    "text": "称谢那用智慧创造诸天的，因他的慈爱永远长存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 6,
    "text": "称谢那铺地在水以上的，因他的慈爱永远长存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 7,
    "text": "称谢那造成大光的，因他的慈爱永远长存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 8,
    "text": "他造日头管白昼，因他的慈爱永远长存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 9,
    "text": "他造月亮星宿管黑夜，因他的慈爱永远长存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 10,
    "text": "称谢那击杀埃及人之长子的，因他的慈爱永远长存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 11,
    "text": "他领以色列人从他们中间出来，因他的慈爱永远长存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 12,
    "text": "他施展大能的手和伸出来的膀臂，因他的慈爱永远长存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 13,
    "text": "称谢那分裂红海的，因他的慈爱永远长存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 14,
    "text": "他领以色列从其中经过，因他的慈爱永远长存；"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 15,
    "text": "却把法老和他的军兵推翻在红海里，因他的慈爱永远长存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 16,
    "text": "称谢那引导自己的民行走旷野的，因他的慈爱永远长存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 17,
    "text": "称谢那击杀大君王的，因他的慈爱永远长存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 18,
    "text": "他杀戮有名的君王，因他的慈爱永远长存；"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 19,
    "text": "就是杀戮亚摩利王西宏，因他的慈爱永远长存；"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 20,
    "text": "又杀巴珊王噩，因他的慈爱永远长存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 21,
    "text": "他将他们的地赐他的百姓为业，因他的慈爱永远长存；"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 22,
    "text": "就是赐他的仆人以色列为业，因他的慈爱永远长存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 23,
    "text": "他顾念我们在卑微的地步，因他的慈爱永远长存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 24,
    "text": "他救拔我们脱离敌人，因他的慈爱永远长存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 25,
    "text": "他赐粮食给凡有血气的，因他的慈爱永远长存。"
  },
  {
    "bookId": 19,
    "chapterId": 136,
    "verseId": 26,
    "text": "你们要称谢天上的　上帝啊，因他的慈爱永远长存。"
  }
]
