[
  {
    "bookId": 19,
    "chapterId": 130,
    "verseId": 1,
    "text": "（上行之诗。）　耶和华啊，我从深处向你求告！"
  },
  {
    "bookId": 19,
    "chapterId": 130,
    "verseId": 2,
    "text": "主啊，求你听我的声音！愿你侧耳听我恳求的声音！"
  },
  {
    "bookId": 19,
    "chapterId": 130,
    "verseId": 3,
    "text": "主―　耶和华啊，你若究察罪孽，谁能站得住呢？"
  },
  {
    "bookId": 19,
    "chapterId": 130,
    "verseId": 4,
    "text": "但在你有饶恕之恩，要叫人敬畏你。"
  },
  {
    "bookId": 19,
    "chapterId": 130,
    "verseId": 5,
    "text": "我等候　耶和华，我的心等候；我也仰望他的话。"
  },
  {
    "bookId": 19,
    "chapterId": 130,
    "verseId": 6,
    "text": "我的心等候　主，甚于守夜的，等候天亮；我说，甚于守夜的，等候天亮。"
  },
  {
    "bookId": 19,
    "chapterId": 130,
    "verseId": 7,
    "text": "以色列啊，你当仰望　耶和华！因　耶和华有慈爱，有丰盛的救恩。"
  },
  {
    "bookId": 19,
    "chapterId": 130,
    "verseId": 8,
    "text": "他必救赎以色列脱离一切的罪孽。"
  }
]
