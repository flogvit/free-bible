[
  {
    "bookId": 19,
    "chapterId": 20,
    "verseId": 1,
    "text": "（大卫的诗，交与伶长。）愿　耶和华在你遭难的日子听允你；愿名为雅各　上帝的保护你。"
  },
  {
    "bookId": 19,
    "chapterId": 20,
    "verseId": 2,
    "text": "愿他从圣所救助你，从锡安坚固你，"
  },
  {
    "bookId": 19,
    "chapterId": 20,
    "verseId": 3,
    "text": "记念你的一切供献，悦纳你的燔祭，细拉。"
  },
  {
    "bookId": 19,
    "chapterId": 20,
    "verseId": 4,
    "text": "将你心所愿的赐给你，成就你的一切筹算。"
  },
  {
    "bookId": 19,
    "chapterId": 20,
    "verseId": 5,
    "text": "我们要因你的救恩欢乐，要奉我们　上帝的名竖立旌旗。愿　耶和华成就你一切所求的！"
  },
  {
    "bookId": 19,
    "chapterId": 20,
    "verseId": 6,
    "text": "现在我知道　耶和华救护他的受膏者，必从他的圣天上听允他，用右手的能力救护他。"
  },
  {
    "bookId": 19,
    "chapterId": 20,
    "verseId": 7,
    "text": "有人靠车，有人靠马，但我们要记念　耶和华―我们　上帝的名。"
  },
  {
    "bookId": 19,
    "chapterId": 20,
    "verseId": 8,
    "text": "他们都屈身仆倒，我们却起来，立得正直。"
  },
  {
    "bookId": 19,
    "chapterId": 20,
    "verseId": 9,
    "text": "求　耶和华施行拯救；我们呼求的时候，愿王听允我们。"
  }
]
