[
  {
    "bookId": 19,
    "chapterId": 64,
    "verseId": 1,
    "text": "（大卫的诗，交与伶长。）　上帝啊，我祷告的时候，求你听我的声音！求你保护我的性命，不受仇敌的惊恐！"
  },
  {
    "bookId": 19,
    "chapterId": 64,
    "verseId": 2,
    "text": "求你把我隐藏，使我脱离作恶之人的暗谋和作孽之人的扰乱。"
  },
  {
    "bookId": 19,
    "chapterId": 64,
    "verseId": 3,
    "text": "他们磨舌如刀，发出苦毒的言语，好像弯弓而射的箭，"
  },
  {
    "bookId": 19,
    "chapterId": 64,
    "verseId": 4,
    "text": "要在暗地射完全人；他们忽然射他，并不惧怕。"
  },
  {
    "bookId": 19,
    "chapterId": 64,
    "verseId": 5,
    "text": "他们彼此勉励设下恶计；他们商量暗设网罗，说：谁能看见？"
  },
  {
    "bookId": 19,
    "chapterId": 64,
    "verseId": 6,
    "text": "他们图谋奸恶，极力图谋；他们各人的意念和心思都是深的。"
  },
  {
    "bookId": 19,
    "chapterId": 64,
    "verseId": 7,
    "text": "但　上帝要射他们；他们忽然被箭射伤。"
  },
  {
    "bookId": 19,
    "chapterId": 64,
    "verseId": 8,
    "text": "他们必然跌倒，被自己的舌头所害；凡看见他们的必都逃跑。"
  },
  {
    "bookId": 19,
    "chapterId": 64,
    "verseId": 9,
    "text": "众人都要害怕，要传扬　上帝的工作，并且明白他的作为。"
  },
  {
    "bookId": 19,
    "chapterId": 64,
    "verseId": 10,
    "text": "义人必因　耶和华欢喜，并要投靠他；凡心里正直的人都要夸口。"
  }
]
