[
  {
    "bookId": 19,
    "chapterId": 13,
    "verseId": 1,
    "text": "（大卫的诗，交与伶长。）　耶和华啊，你忘记我要到几时呢？要到永远吗？你掩面不顾我要到几时呢？"
  },
  {
    "bookId": 19,
    "chapterId": 13,
    "verseId": 2,
    "text": "我心里筹算，终日愁苦，要到几时呢？我的仇敌升高压制我，要到几时呢？"
  },
  {
    "bookId": 19,
    "chapterId": 13,
    "verseId": 3,
    "text": "耶和华―我的　上帝啊，求你看顾我，听允我；使我眼目光明，免得我沉睡至死；"
  },
  {
    "bookId": 19,
    "chapterId": 13,
    "verseId": 4,
    "text": "免得我的仇敌说：我胜了他；免得扰害我的在我摇动的时候喜乐。"
  },
  {
    "bookId": 19,
    "chapterId": 13,
    "verseId": 5,
    "text": "但我倚靠你的慈爱；我的心因你的救恩快乐。"
  },
  {
    "bookId": 19,
    "chapterId": 13,
    "verseId": 6,
    "text": "我要向　耶和华歌唱，因他用厚恩待我。"
  }
]
