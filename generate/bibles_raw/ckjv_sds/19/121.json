[
  {
    "bookId": 19,
    "chapterId": 121,
    "verseId": 1,
    "text": "（上行之诗。）我要向山举目；我的帮助从何而来？"
  },
  {
    "bookId": 19,
    "chapterId": 121,
    "verseId": 2,
    "text": "我的帮助从造天地的　耶和华而来。"
  },
  {
    "bookId": 19,
    "chapterId": 121,
    "verseId": 3,
    "text": "他必不叫你的脚摇动；保护你的必不打盹！"
  },
  {
    "bookId": 19,
    "chapterId": 121,
    "verseId": 4,
    "text": "看哪，保护以色列的，也不打盹也不睡觉。"
  },
  {
    "bookId": 19,
    "chapterId": 121,
    "verseId": 5,
    "text": "保护你的是　耶和华；　耶和华在你右边荫庇你。"
  },
  {
    "bookId": 19,
    "chapterId": 121,
    "verseId": 6,
    "text": "白日，太阳必不伤你；夜间，月亮必不害你。"
  },
  {
    "bookId": 19,
    "chapterId": 121,
    "verseId": 7,
    "text": "耶和华要保护你，免受一切的灾害；他要保护你的性命。"
  },
  {
    "bookId": 19,
    "chapterId": 121,
    "verseId": 8,
    "text": "你出你入，　耶和华要保护你，从今时直到永远。"
  }
]
