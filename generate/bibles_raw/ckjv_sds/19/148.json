[
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 1,
    "text": "你们要赞美　耶和华。从诸天赞美　耶和华！在高处赞美他。"
  },
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 2,
    "text": "他的众天使都要赞美他！他的诸军都要赞美他！"
  },
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 3,
    "text": "日头月亮，你们要赞美他！放光的星宿，你们都要赞美他！"
  },
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 4,
    "text": "诸天上的诸天，并诸天上的水，你们都要赞美他！"
  },
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 5,
    "text": "愿这些都赞美　耶和华的名！因他一吩咐便都创造而成。"
  },
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 6,
    "text": "他将这些立定，直到永永远远；他定了命，不能废去。"
  },
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 7,
    "text": "龙与一切在深处的，你们要从地上赞美　耶和华；"
  },
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 8,
    "text": "火与冰雹，雪和雾气，成就他命的狂风，"
  },
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 9,
    "text": "大山和小山，结果的树木和一切香柏树，"
  },
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 10,
    "text": "野兽和一切牲畜，昆虫和飞鸟，"
  },
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 11,
    "text": "世上的君王和众民，首领和世上一切审判官，"
  },
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 12,
    "text": "少年人和处女，老年人和孩童，都当赞美　耶和华！"
  },
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 13,
    "text": "愿这些都赞美　耶和华的名！因为独有他的名为美；他的荣耀在天地之上。"
  },
  {
    "bookId": 19,
    "chapterId": 148,
    "verseId": 14,
    "text": "他将他百姓的角高举，他使一切圣民以色列人，就是与他相近的百姓，都赞美他！你们要赞美　耶和华！"
  }
]
