[
  {
    "bookId": 19,
    "chapterId": 150,
    "verseId": 1,
    "text": "你们要赞美　耶和华！在　上帝的圣所赞美他！在他显能力的穹苍赞美他！"
  },
  {
    "bookId": 19,
    "chapterId": 150,
    "verseId": 2,
    "text": "要因他大能的作为赞美他，按着他极美的大德赞美他！"
  },
  {
    "bookId": 19,
    "chapterId": 150,
    "verseId": 3,
    "text": "要用角声赞美他，鼓瑟弹琴赞美他！"
  },
  {
    "bookId": 19,
    "chapterId": 150,
    "verseId": 4,
    "text": "击鼓跳舞赞美他！用丝弦的乐器和风琴的声音赞美他！"
  },
  {
    "bookId": 19,
    "chapterId": 150,
    "verseId": 5,
    "text": "用大响的钹赞美他！用高声的钹赞美他！"
  },
  {
    "bookId": 19,
    "chapterId": 150,
    "verseId": 6,
    "text": "凡有气息的都要赞美　耶和华！你们要赞美　耶和华！"
  }
]
