[
  {
    "bookId": 19,
    "chapterId": 109,
    "verseId": 1,
    "text": "（大卫的诗，交与伶长。）我所赞美的　上帝啊，求你不要闭口不言。"
  },
  {
    "bookId": 19,
    "chapterId": 109,
    "verseId": 2,
    "text": "因为恶人的嘴和诡诈人的口已经张开攻击我；他们用撒谎的舌头对我说话。"
  },
  {
    "bookId": 19,
    "chapterId": 109,
    "verseId": 3,
    "text": "他们围绕我，说怨恨的话，又无故地攻打我。"
  },
  {
    "bookId": 19,
    "chapterId": 109,
    "verseId": 4,
    "text": "他们与我为敌以报我爱，但我专心祈祷。"
  },
  {
    "bookId": 19,
    "chapterId": 109,
    "verseId": 5,
    "text": "他们向我以恶报善，以恨报爱。"
  },
  {
    "bookId": 19,
    "chapterId": 109,
    "verseId": 6,
    "text": "愿你派一个恶人辖制他，并使撒但站在他右边！"
  },
  {
    "bookId": 19,
    "chapterId": 109,
    "verseId": 7,
    "text": "他受审判的时候，愿他出来担当罪名！愿他的祈祷反成为罪！"
  },
  {
    "bookId": 19,
    "chapterId": 109,
    "verseId": 8,
    "text": "愿他的年日短少！愿别人得他的职分！"
  },
  {
    "bookId": 19,
    "chapterId": 109,
    "verseId": 9,
    "text": "愿他的儿女没有父亲，他的妻子为寡妇。"
  },
  {
    "bookId": 19,
    "chapterId": 109,
    "verseId": 10,
    "text": "愿他的儿女漂流讨饭，从他们荒凉之处出来求食！"
  },
  {
    "bookId": 19,
    "chapterId": 109,
    "verseId": 11,
    "text": "愿强暴的债主牢笼他一切所有的！愿外人抢他劳碌得来的！"
  },
  {
    "bookId": 19,
    "chapterId": 109,
    "verseId": 12,
    "text": "愿无人向他延绵施恩；愿无人喜爱他无父的儿女。"
  },
  {
    "bookId": 19,
    "chapterId": 109,
    "verseId": 13,
    "text": "愿他的后人断绝，名字被涂抹，不传于下代！"
  },
  {
    "bookId": 19,
    "chapterId": 109,
    "verseId": 14,
    "text": "愿他祖宗的罪孽被　耶和华记念！愿他母亲的罪过不被涂抹！"
  },
  {
    "bookId": 19,
    "chapterId": 109,
    "verseId": 15,
    "text": "愿这些罪常在　耶和华面前，叫他使他们的名号断绝于世！"
  },
  {
    "bookId": 19,
    "chapterId": 109,
    "verseId": 16,
    "text": "因为他不想施恩，却逼迫困苦穷乏的和伤心的人，要把他们治死。"
  },
  {
    "bookId": 19,
    "chapterId": 109,
    "verseId": 17,
    "text": "他爱咒骂，咒骂就临到他；他不喜爱福乐，福乐就与他远离！"
  },
  {
    "bookId": 19,
    "chapterId": 109,
    "verseId": 18,
    "text": "他拿咒骂当衣服穿上；这咒骂就如水进他里面，像油入他的骨头。"
  },
  {
    "bookId": 19,
    "chapterId": 109,
    "verseId": 19,
    "text": "愿这咒骂当他遮身的衣服，当他常束的腰带！"
  },
  {
    "bookId": 19,
    "chapterId": 109,
    "verseId": 20,
    "text": "愿这作我对头和用恶言议论我的人从　耶和华那里所受的报应。"
  },
  {
    "bookId": 19,
    "chapterId": 109,
    "verseId": 21,
    "text": "主―　耶和华啊，求你为你的名恩待我；因你的慈爱美好，求你搭救我！"
  },
  {
    "bookId": 19,
    "chapterId": 109,
    "verseId": 22,
    "text": "因为我困苦穷乏，内心受伤。"
  },
  {
    "bookId": 19,
    "chapterId": 109,
    "verseId": 23,
    "text": "我如日影渐渐偏斜而去；我如蝗虫被抖出来。"
  },
  {
    "bookId": 19,
    "chapterId": 109,
    "verseId": 24,
    "text": "我因禁食，膝骨软弱；我身上的肉也渐渐瘦了。"
  },
  {
    "bookId": 19,
    "chapterId": 109,
    "verseId": 25,
    "text": "我受他们的羞辱，他们看见我便摇头。"
  },
  {
    "bookId": 19,
    "chapterId": 109,
    "verseId": 26,
    "text": "耶和华―我的　上帝啊，求你帮助我，照你的慈爱拯救我，"
  },
  {
    "bookId": 19,
    "chapterId": 109,
    "verseId": 27,
    "text": "使他们知道这是你的手，是你―　耶和华所行的事。"
  },
  {
    "bookId": 19,
    "chapterId": 109,
    "verseId": 28,
    "text": "任凭他们咒骂，唯愿你赐福；他们几时起来就必蒙羞，你的仆人却要欢喜。"
  },
  {
    "bookId": 19,
    "chapterId": 109,
    "verseId": 29,
    "text": "愿我的对头披戴羞辱！愿他们以自己的羞愧为外袍遮身！"
  },
  {
    "bookId": 19,
    "chapterId": 109,
    "verseId": 30,
    "text": "我要用口大大赞美　耶和华；我要在众人中间赞美他；"
  },
  {
    "bookId": 19,
    "chapterId": 109,
    "verseId": 31,
    "text": "因为他必站在穷乏人的右边，要救他脱离定他元魂有罪的人。"
  }
]
