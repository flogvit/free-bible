[
  {
    "bookId": 19,
    "chapterId": 19,
    "verseId": 1,
    "text": "（大卫的诗，交与伶长。）诸天述说　上帝的荣耀；穹苍传扬他的手工。"
  },
  {
    "bookId": 19,
    "chapterId": 19,
    "verseId": 2,
    "text": "这日到那日发出言语；这夜到那夜传出知识。"
  },
  {
    "bookId": 19,
    "chapterId": 19,
    "verseId": 3,
    "text": "没有任何口音言语，是听不见他们声音的。"
  },
  {
    "bookId": 19,
    "chapterId": 19,
    "verseId": 4,
    "text": "它们的量带通遍全地，它们的言语传到世界的尽头。　上帝在其间为太阳安设帐幕，"
  },
  {
    "bookId": 19,
    "chapterId": 19,
    "verseId": 5,
    "text": "太阳如同新郎出洞房，又如勇士欢然奔路。"
  },
  {
    "bookId": 19,
    "chapterId": 19,
    "verseId": 6,
    "text": "它从天这边出来，绕到天那边，没有一物被隐藏不得它的热气。"
  },
  {
    "bookId": 19,
    "chapterId": 19,
    "verseId": 7,
    "text": "耶和华的律法全备，能回转人心；　耶和华的法度确定，能使愚人有智慧。"
  },
  {
    "bookId": 19,
    "chapterId": 19,
    "verseId": 8,
    "text": "耶和华的律例正确，能快活人的心；　耶和华的命令纯洁，能明亮人的眼目。"
  },
  {
    "bookId": 19,
    "chapterId": 19,
    "verseId": 9,
    "text": "敬畏　耶和华的道是洁净的，存到永远；　耶和华的典章真实，全然公义―"
  },
  {
    "bookId": 19,
    "chapterId": 19,
    "verseId": 10,
    "text": "都比金子可羡慕，且比极多的精金可羡慕；比蜜甘甜，且比蜂房下滴的蜜甘甜。"
  },
  {
    "bookId": 19,
    "chapterId": 19,
    "verseId": 11,
    "text": "况且你的仆人因此受警戒，守着这些便有大赏。"
  },
  {
    "bookId": 19,
    "chapterId": 19,
    "verseId": 12,
    "text": "谁能明白自己的错谬呢？愿你除净我喑里所存的过错。"
  },
  {
    "bookId": 19,
    "chapterId": 19,
    "verseId": 13,
    "text": "求你拦阻你仆人不犯任意妄为的罪，不容这罪辖制我，我便正直，免犯大罪。"
  },
  {
    "bookId": 19,
    "chapterId": 19,
    "verseId": 14,
    "text": "耶和华―我的力量，我的救赎主啊，愿我口中的言语、心里的意念在你眼前蒙悦纳。"
  }
]
