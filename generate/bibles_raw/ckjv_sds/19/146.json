[
  {
    "bookId": 19,
    "chapterId": 146,
    "verseId": 1,
    "text": "你们要赞美　耶和华！我的心哪，你要赞美　耶和华！"
  },
  {
    "bookId": 19,
    "chapterId": 146,
    "verseId": 2,
    "text": "我一生要赞美　耶和华！我还活的时候要歌颂我的　上帝！"
  },
  {
    "bookId": 19,
    "chapterId": 146,
    "verseId": 3,
    "text": "你们不要倚靠君王，不要倚靠世人；他一点不能帮助。"
  },
  {
    "bookId": 19,
    "chapterId": 146,
    "verseId": 4,
    "text": "他的气一断，就归回尘土；他所打算的，当日就消灭了。"
  },
  {
    "bookId": 19,
    "chapterId": 146,
    "verseId": 5,
    "text": "以雅各的　上帝为帮助、仰望　耶和华―他　上帝的，这人便为有福！"
  },
  {
    "bookId": 19,
    "chapterId": 146,
    "verseId": 6,
    "text": "耶和华造天、地、海，和其中的万物；他守诚实，直到永远。"
  },
  {
    "bookId": 19,
    "chapterId": 146,
    "verseId": 7,
    "text": "他为受欺压的伸冤，赐食物与饥饿的。　耶和华释放被囚的；"
  },
  {
    "bookId": 19,
    "chapterId": 146,
    "verseId": 8,
    "text": "耶和华开了瞎子的眼睛；　耶和华扶起被压下的人。　耶和华喜爱义人。"
  },
  {
    "bookId": 19,
    "chapterId": 146,
    "verseId": 9,
    "text": "耶和华保护作客旅的，扶持无父的和寡妇，却使恶人的道路弯曲。"
  },
  {
    "bookId": 19,
    "chapterId": 146,
    "verseId": 10,
    "text": "耶和华要作王，直到永远！锡安哪，你的　上帝要作王，直到万代！你们要赞美　耶和华！"
  }
]
