[
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 1,
    "text": "你们要称谢　耶和华啊，因他本为善；他的慈爱永远长存！"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 2,
    "text": "愿以色列说：他的慈爱永远长存！"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 3,
    "text": "愿亚伦的家说：他的慈爱永远长存！"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 4,
    "text": "愿敬畏　耶和华的说：他的慈爱永远长存！"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 5,
    "text": "我在急难中求告　耶和华，　耶和华就应允我，把我安置在宽阔之地。"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 6,
    "text": "耶和华在我旁边；我必不惧怕！人能把我怎么样呢？"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 7,
    "text": "在那帮助我的人中，有　耶和华帮助我，所以我要看见那些恨我的人遭报。"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 8,
    "text": "投靠　耶和华，强似倚赖人；"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 9,
    "text": "投靠　耶和华，强似倚赖王子。"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 10,
    "text": "列国围绕我，我靠　耶和华的名必剿灭他们。"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 11,
    "text": "他们环绕我，围困我，我靠　耶和华的名必剿灭他们。"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 12,
    "text": "他们如同蜂子围绕我，好像烧荆棘的火，必被熄灭；我靠　耶和华的名，必剿灭他们。"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 13,
    "text": "你推我，要叫我跌倒，但　耶和华帮助了我。"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 14,
    "text": "耶和华是我的力量，是我的诗歌；他也成了我的拯救。"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 15,
    "text": "在义人的帐棚里，有欢呼拯救的声音；　耶和华的右手勇敢行事。"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 16,
    "text": "耶和华的右手高举；　耶和华的右手勇敢行事。"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 17,
    "text": "我必不致死，仍要存活，并要传扬　耶和华的作为。"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 18,
    "text": "耶和华虽严严地惩治我，却未曾将我交于死亡。"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 19,
    "text": "给我敞开义门；我要进去赞美　耶和华！"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 20,
    "text": "这是　耶和华的门；义人要进去！"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 21,
    "text": "我要赞美你，因为你已经听允我，又成了我的拯救。"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 22,
    "text": "匠人所拒的石头成为房角的头块石头。"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 23,
    "text": "这是　耶和华所作的，在我们眼中看为希奇。"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 24,
    "text": "这是　耶和华所定的日子，我们在其中要高兴欢喜！"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 25,
    "text": "耶和华啊，求你拯救！　耶和华啊，求你使我亨通！"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 26,
    "text": "奉　耶和华名来的是应当称颂的！我们从　耶和华的殿中为你们祝福！"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 27,
    "text": "上帝就是那　照亮我们的　耶和华；理当用绳索把祭牲捆住，牵到坛角那里。"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 28,
    "text": "你是我的　上帝，我要称赞你！你是我的　上帝，我要尊崇你！"
  },
  {
    "bookId": 19,
    "chapterId": 118,
    "verseId": 29,
    "text": "你们要称谢　耶和华啊，因他本为善；他的慈爱永远长存！"
  }
]
