[
  {
    "bookId": 19,
    "chapterId": 7,
    "verseId": 1,
    "text": "（大卫指着便雅悯人古实的话，向　耶和华唱的流离歌。）　耶和华―我的　上帝啊，我投靠你；求你救我脱离一切逼迫我的人，将我救拔出来；"
  },
  {
    "bookId": 19,
    "chapterId": 7,
    "verseId": 2,
    "text": "恐怕他们像狮子撕裂我，甚至撕碎，无人搭救。"
  },
  {
    "bookId": 19,
    "chapterId": 7,
    "verseId": 3,
    "text": "耶和华―我的　上帝啊，我若行了这事，若有罪孽在我手里，"
  },
  {
    "bookId": 19,
    "chapterId": 7,
    "verseId": 4,
    "text": "我若以恶报那与我交好的人―连那无故与我为敌的，我也救了他，"
  },
  {
    "bookId": 19,
    "chapterId": 7,
    "verseId": 5,
    "text": "就任凭仇敌逼迫我，直到追上，将我的性命踏在地下，使我的荣耀归于灰尘。细拉。"
  },
  {
    "bookId": 19,
    "chapterId": 7,
    "verseId": 6,
    "text": "耶和华啊，求你在怒中起来，挺身而立，抵挡我敌人的暴怒！求你为我醒起，你已经命定施行审判。"
  },
  {
    "bookId": 19,
    "chapterId": 7,
    "verseId": 7,
    "text": "愿众民的会环绕你！愿你为他们的缘故归于高位！"
  },
  {
    "bookId": 19,
    "chapterId": 7,
    "verseId": 8,
    "text": "耶和华向众民施行审判；　耶和华啊，求你按我的公义和我心中的纯正判断我。"
  },
  {
    "bookId": 19,
    "chapterId": 7,
    "verseId": 9,
    "text": "愿恶人的恶断绝！愿你坚立义人！因为公义的　上帝察验人的心肠肺腑。"
  },
  {
    "bookId": 19,
    "chapterId": 7,
    "verseId": 10,
    "text": "上帝是我的保障；他拯救心里正直的人。"
  },
  {
    "bookId": 19,
    "chapterId": 7,
    "verseId": 11,
    "text": "上帝判断义人又是天天向恶人发怒的　上帝。"
  },
  {
    "bookId": 19,
    "chapterId": 7,
    "verseId": 12,
    "text": "若有人不回头，他的刀必磨快，弓必上弦，预备妥当了。"
  },
  {
    "bookId": 19,
    "chapterId": 7,
    "verseId": 13,
    "text": "他也预备了杀人的器械；他设下他的箭攻击那逼迫人的。"
  },
  {
    "bookId": 19,
    "chapterId": 7,
    "verseId": 14,
    "text": "试看恶人因奸恶而劬劳，所怀的是毒害，所生的是虚假。"
  },
  {
    "bookId": 19,
    "chapterId": 7,
    "verseId": 15,
    "text": "他掘了坑，又挖深了，竟掉在自己所挖的阱里。"
  },
  {
    "bookId": 19,
    "chapterId": 7,
    "verseId": 16,
    "text": "他的毒害必临到他自己的头上；他的强暴必落到他自己的脑袋上。"
  },
  {
    "bookId": 19,
    "chapterId": 7,
    "verseId": 17,
    "text": "我要照着　耶和华的公义赞美他，歌颂　耶和华至高者的名。"
  }
]
