[
  {
    "bookId": 19,
    "chapterId": 100,
    "verseId": 1,
    "text": "（称谢诗。）普天下当向　耶和华欢呼！"
  },
  {
    "bookId": 19,
    "chapterId": 100,
    "verseId": 2,
    "text": "你们当乐意事奉　耶和华，当来向他歌唱！"
  },
  {
    "bookId": 19,
    "chapterId": 100,
    "verseId": 3,
    "text": "你们当晓得　耶和华是　上帝！我们是他造的，不是我们自造的；我们是他的民，也是他草场的羊。"
  },
  {
    "bookId": 19,
    "chapterId": 100,
    "verseId": 4,
    "text": "当称谢进入他的门；当赞美进入他的院。当感谢他，称颂他的名！"
  },
  {
    "bookId": 19,
    "chapterId": 100,
    "verseId": 5,
    "text": "因为　耶和华本为善。他的慈爱存到永远；他的信实直到万代。"
  }
]
