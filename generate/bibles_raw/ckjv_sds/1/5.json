[
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 1,
    "text": "亚当后代的家谱记在下面。当　上帝创造人的日子，是照着　上帝的样式造的；"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 2,
    "text": "他创造男女，并且赐福给他们。又在他们被造的日子，称他们为「亚当」。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 3,
    "text": "亚当活到一百三十岁，生了一个儿子，形像样式和自己相似，就给他起名叫塞特。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 4,
    "text": "亚当生下塞特之后，又在世八百年；并且他生儿养女；"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 5,
    "text": "亚当共活了九百三十岁就死了。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 6,
    "text": "塞特活到一百零五岁，生了以挪士；"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 7,
    "text": "塞特生以挪士之后，又活了八百零七年，并且生儿养女；"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 8,
    "text": "塞特共活了九百一十二岁就死了。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 9,
    "text": "以挪士活到九十岁，生了该南；"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 10,
    "text": "以挪士生该南之后，又活了八百一十五年，并且生儿养女；"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 11,
    "text": "以挪士共活了九百零五岁就死了。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 12,
    "text": "该南活到七十岁，生了玛勒列。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 13,
    "text": "该南生玛勒列之后，又活了八百四十年，并且生儿养女。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 14,
    "text": "该南共活了九百一十岁就死了。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 15,
    "text": "玛勒列活到六十五岁，生了雅列。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 16,
    "text": "玛勒列生雅列之后，又活了八百三十年，并且生儿养女。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 17,
    "text": "玛勒列共活了八百九十五岁就死了。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 18,
    "text": "雅列活到一百六十二岁，生了以诺。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 19,
    "text": "雅列生以诺之后，又活了八百年，并且生儿养女。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 20,
    "text": "雅列共活了九百六十二岁就死了。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 21,
    "text": "以诺活到六十五岁，生了玛土撒拉。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 22,
    "text": "以诺生玛土撒拉之后，与　上帝同行三百年，并且生儿养女。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 23,
    "text": "以诺共活了三百六十五岁。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 24,
    "text": "以诺与　上帝同行，　上帝将他取去，他就不在世了。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 25,
    "text": "玛土撒拉活到一百八十七岁，生了拉麦。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 26,
    "text": "玛土撒拉生拉麦之后，又活了七百八十二年，并且生儿养女。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 27,
    "text": "玛土撒拉共活了九百六十九岁就死了。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 28,
    "text": "拉麦活到一百八十二岁，生了一个儿子，"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 29,
    "text": "给他起名叫挪亚，说：「这个儿子必为我们的操作和手中的劳苦安慰我们；这操作劳苦是因为　耶和华咒诅地。」"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 30,
    "text": "拉麦生挪亚之后，又活了五百九十五年，并且生儿养女。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 31,
    "text": "拉麦共活了七百七十七岁就死了。"
  },
  {
    "bookId": 1,
    "chapterId": 5,
    "verseId": 32,
    "text": "挪亚五百岁生了闪、含、雅弗。"
  }
]
