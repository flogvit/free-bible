[
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 1,
    "text": "智慧建造房屋，凿成七根柱子；"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 2,
    "text": "她宰了牲畜；调好旨酒；又摆了筵席。"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 3,
    "text": "她打发使女出去；自己在城中至高处呼叫，"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 4,
    "text": "说：谁是愚蒙人，可以转到这里来！又对那无知的人说："
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 5,
    "text": "你们来，吃我的饼，喝我调和的酒。"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 6,
    "text": "要舍弃愚蒙，就得存活，并要走聪明的道。"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 7,
    "text": "指斥亵慢人的，必受辱骂；责备恶人的，必被玷污。"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 8,
    "text": "不要责备亵慢人，恐怕他恨你；要责备智慧人，他必爱你。"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 9,
    "text": "指示智慧人，他就越发有智慧；教导义人，他就增长学问。"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 10,
    "text": "敬畏　耶和华是智慧的开端；认识至圣者便是聪明。"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 11,
    "text": "你藉着我，日子必增多，年岁也必加添。"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 12,
    "text": "你若有智慧，是与自己有益；你若亵慢，就必独自担当。"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 13,
    "text": "愚昧的妇人喧嚷；她是愚蒙，一无所知。"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 14,
    "text": "她坐在自己的家门口，坐在城中高处的座位上，"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 15,
    "text": "呼叫过路的，就是直行其道的人，"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 16,
    "text": "说：谁是愚蒙人，可以转到这里来！又对那无知的人说："
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 17,
    "text": "偷来的水是甜的，暗吃的饼是好的。"
  },
  {
    "bookId": 20,
    "chapterId": 9,
    "verseId": 18,
    "text": "人却不知有阴魂在她那里，她的客在地狱的深处。"
  }
]
