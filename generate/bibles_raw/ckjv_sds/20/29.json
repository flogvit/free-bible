[
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 1,
    "text": "人屡次受责备，仍然硬着颈项；他必顷刻败坏，无法可治。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 2,
    "text": "义人掌权，民就喜乐；恶人管治，民就叹息。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 3,
    "text": "爱慕智慧的，使父亲喜乐；与娼妓结交的，却浪费钱财。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 4,
    "text": "王藉公平，使国坚定；索要贿赂，使国倾败。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 5,
    "text": "谄媚邻舍的，就是设网罗绊他的脚。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 6,
    "text": "恶人犯罪，自陷网罗；唯独义人欢呼喜乐。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 7,
    "text": "义人知道查明穷人的案；然而恶人不愿理会，就不得而知。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 8,
    "text": "亵慢人使城陷入网罗；唯智慧人转消忿怒。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 9,
    "text": "智慧人若与愚妄人相争，或怒或笑，总不能使他止息。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 10,
    "text": "好流人血的，恨恶正直人，索取义人的性命。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 11,
    "text": "愚妄人心意全吐；智慧人隐藏意念。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 12,
    "text": "首领若听谎言，他一切仆人都是奸恶。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 13,
    "text": "贫穷人、行诡诈的人在世相遇；他们的眼目都蒙　耶和华光照。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 14,
    "text": "君王凭诚实判断穷人；他的国位必永远坚立。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 15,
    "text": "杖打和责备能加增智慧；放纵的孩子使母亲羞愧。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 16,
    "text": "恶人加多，过犯也加多，义人必看见他们跌倒。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 17,
    "text": "管教你的儿子，他就使你得安息，也必使你心里喜乐。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 18,
    "text": "没有异象，民就灭亡；唯遵守律法的，便为有福。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 19,
    "text": "只用言语，仆人不肯受管教；他虽然明白，也不回答。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 20,
    "text": "你见言语急躁的人吗？愚昧人比他更有盼望。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 21,
    "text": "人将仆人从小娇养，这仆人终久必成了他的儿子。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 22,
    "text": "好气的人挑启争端；暴怒的人多多犯罪。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 23,
    "text": "人的高傲必使他卑下；灵里谦逊的，尊荣却必扶持他。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 24,
    "text": "人与盗贼分赃，是恨恶自己的性命；他听见咒骂的声音，却不显露。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 25,
    "text": "惧怕人的，陷入网罗；唯有倚靠　耶和华的，必得安稳。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 26,
    "text": "求王恩的人多；定人事乃在　耶和华。"
  },
  {
    "bookId": 20,
    "chapterId": 29,
    "verseId": 27,
    "text": "为非作歹的，被义人憎嫌；行事正直的，被恶人憎恶。"
  }
]
