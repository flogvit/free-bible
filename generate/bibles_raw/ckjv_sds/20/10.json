[
  {
    "bookId": 20,
    "chapterId": 10,
    "verseId": 1,
    "text": "所罗门的箴言：智慧之子使父亲欢乐；愚昧之子叫母亲担忧。"
  },
  {
    "bookId": 20,
    "chapterId": 10,
    "verseId": 2,
    "text": "罪恶之财毫无益处；唯有公义能救人脱离死亡。"
  },
  {
    "bookId": 20,
    "chapterId": 10,
    "verseId": 3,
    "text": "耶和华不使义人受饥饿；恶人的货财，他必推开。"
  },
  {
    "bookId": 20,
    "chapterId": 10,
    "verseId": 4,
    "text": "手懒的，要受贫穷；手勤的，却要富足。"
  },
  {
    "bookId": 20,
    "chapterId": 10,
    "verseId": 5,
    "text": "夏天聚敛的，是智慧之子；收割时沉睡的，是贻羞之子。"
  },
  {
    "bookId": 20,
    "chapterId": 10,
    "verseId": 6,
    "text": "福祉临到义人的头；强暴蒙蔽恶人的口。"
  },
  {
    "bookId": 20,
    "chapterId": 10,
    "verseId": 7,
    "text": "义人的记念被称赞；恶人的名字必朽烂。"
  },
  {
    "bookId": 20,
    "chapterId": 10,
    "verseId": 8,
    "text": "心中智慧的，必受命令；口里愚妄的，必致倾倒。"
  },
  {
    "bookId": 20,
    "chapterId": 10,
    "verseId": 9,
    "text": "行正直路的，步步安稳；走弯曲道的，必致败露。"
  },
  {
    "bookId": 20,
    "chapterId": 10,
    "verseId": 10,
    "text": "以眼传神的，使人忧患；口里愚妄的，必致倾倒。"
  },
  {
    "bookId": 20,
    "chapterId": 10,
    "verseId": 11,
    "text": "义人的口是生命的泉源；强暴蒙蔽恶人的口。"
  },
  {
    "bookId": 20,
    "chapterId": 10,
    "verseId": 12,
    "text": "恨能挑启争端；爱能遮掩一切罪过。"
  },
  {
    "bookId": 20,
    "chapterId": 10,
    "verseId": 13,
    "text": "明哲人嘴里有智慧；无知人背上受刑杖。"
  },
  {
    "bookId": 20,
    "chapterId": 10,
    "verseId": 14,
    "text": "智慧人积存知识；愚妄人的口速致败坏。"
  },
  {
    "bookId": 20,
    "chapterId": 10,
    "verseId": 15,
    "text": "富户的财物是他的坚城；穷人的贫乏是他的败坏。"
  },
  {
    "bookId": 20,
    "chapterId": 10,
    "verseId": 16,
    "text": "义人的勤劳致生；恶人的果子致罪。"
  },
  {
    "bookId": 20,
    "chapterId": 10,
    "verseId": 17,
    "text": "谨守训诲的，乃在生命的道上；不受责备的，便失迷了路。"
  },
  {
    "bookId": 20,
    "chapterId": 10,
    "verseId": 18,
    "text": "隐藏怨恨的，有说谎的嘴；口出谗谤的，是愚妄的人。"
  },
  {
    "bookId": 20,
    "chapterId": 10,
    "verseId": 19,
    "text": "多言多语难免有过；禁止嘴唇是有智慧。"
  },
  {
    "bookId": 20,
    "chapterId": 10,
    "verseId": 20,
    "text": "义人的舌乃似高银；恶人的心所值无几。"
  },
  {
    "bookId": 20,
    "chapterId": 10,
    "verseId": 21,
    "text": "义人的嘴教养多人；愚昧人因无知而死亡。"
  },
  {
    "bookId": 20,
    "chapterId": 10,
    "verseId": 22,
    "text": "耶和华所赐的福使人富足，并不加上忧虑。"
  },
  {
    "bookId": 20,
    "chapterId": 10,
    "verseId": 23,
    "text": "愚妄人以行恶为戏耍；明哲人却以智慧为乐。"
  },
  {
    "bookId": 20,
    "chapterId": 10,
    "verseId": 24,
    "text": "恶人所怕的，必临到他；义人所愿的，必蒙应允。"
  },
  {
    "bookId": 20,
    "chapterId": 10,
    "verseId": 25,
    "text": "旋风一过，恶人归于无有；义人的根基却是永久。"
  },
  {
    "bookId": 20,
    "chapterId": 10,
    "verseId": 26,
    "text": "懒惰人叫差他的人如醋倒牙，如烟薰目。"
  },
  {
    "bookId": 20,
    "chapterId": 10,
    "verseId": 27,
    "text": "敬畏　耶和华使人日子加多；但恶人的年岁必被减少。"
  },
  {
    "bookId": 20,
    "chapterId": 10,
    "verseId": 28,
    "text": "义人的盼望必得喜乐；恶人的指望必致灭没。"
  },
  {
    "bookId": 20,
    "chapterId": 10,
    "verseId": 29,
    "text": "耶和华的道是正直人的力量；唯作孽人必遭遇败坏。"
  },
  {
    "bookId": 20,
    "chapterId": 10,
    "verseId": 30,
    "text": "义人永不挪移；恶人不得住在地上。"
  },
  {
    "bookId": 20,
    "chapterId": 10,
    "verseId": 31,
    "text": "义人的口滋生智慧；乖谬的舌必被割断。"
  },
  {
    "bookId": 20,
    "chapterId": 10,
    "verseId": 32,
    "text": "义人的嘴知道如何能令人喜悦；恶人的口说乖谬的话。"
  }
]
