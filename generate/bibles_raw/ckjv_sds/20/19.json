[
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 1,
    "text": "行为纯正的贫穷人，胜过嘴里乖谬的愚妄人。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 2,
    "text": "心无知识的，乃为不善；脚步急快的，难免犯罪。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 3,
    "text": "人的愚昧倾败他的道；他的心也抱怨　耶和华。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 4,
    "text": "财物使朋友增多；但穷人邻舍远离。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 5,
    "text": "作假见证的，必不免受罚；吐出谎言的，终不能逃脱。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 6,
    "text": "作君王的，有多人求他的恩情；爱送礼的，人都为他的朋友。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 7,
    "text": "贫穷人，弟兄都恨他；何况他的朋友，岂不更远离他？他用言语追随，还是缺欠他们。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 8,
    "text": "得着智慧的，爱惜生命；保守聪明的，必得好处。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 9,
    "text": "作假见证的，不免受罚；吐出谎言的，也必灭亡。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 10,
    "text": "愚昧人宴乐度日是不合宜的；何况仆人管辖王子呢？"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 11,
    "text": "人有见识就不轻易发怒；宽恕人的过失便是自己的荣耀。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 12,
    "text": "王的忿怒好像狮子吼叫；他的恩典却如草上的甘露。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 13,
    "text": "愚昧的儿子是父亲的祸患；妻子的争吵如雨连连滴漏。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 14,
    "text": "房屋钱财是祖宗所遗留的；唯有贤慧的妻是　耶和华所赐的。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 15,
    "text": "懒惰使人沉睡；懈怠的人必受饥饿。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 16,
    "text": "谨守诫命的，保全生命；轻忽己路的，必致死亡。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 17,
    "text": "怜悯贫穷的，就是借给　耶和华；他的善行，　耶和华必偿还。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 18,
    "text": "趁有盼望管教你的儿子，你的心不可因他哭喊就宽容。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 19,
    "text": "暴怒的人必受刑罚；你若救他，必须再救。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 20,
    "text": "你要听劝教，受训诲，使你终久有智慧。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 21,
    "text": "人心多有计谋；唯有　耶和华的筹算才能立定。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 22,
    "text": "施行仁慈的，令人爱慕；穷人强如说谎言的。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 23,
    "text": "敬畏　耶和华的，得着生命；他必恒久知足，不遭祸患。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 24,
    "text": "懒惰人将手藏在怀里，就是向口撤回，他也不肯。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 25,
    "text": "鞭打亵慢人，愚蒙人必受警戒；责备明哲人，他就明白知识。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 26,
    "text": "虐待父亲、撵出母亲的，是贻羞致辱之子。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 27,
    "text": "我儿，那使人偏离知识言语的教训，你不可听从。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 28,
    "text": "不敬虔的人作见证戏笑公平；恶人的口吞下罪孽。"
  },
  {
    "bookId": 20,
    "chapterId": 19,
    "verseId": 29,
    "text": "刑罚是为亵慢人预备的；鞭打是为愚昧人的背预备的。"
  }
]
