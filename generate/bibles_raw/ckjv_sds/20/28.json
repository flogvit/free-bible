[
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 1,
    "text": "恶人虽无人追赶也逃跑；义人却胆壮像狮子。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 2,
    "text": "邦国因有罪过，君王就多更换；因有聪明知识的人，国必长存。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 3,
    "text": "穷人欺压贫民，好像暴雨冲没粮食。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 4,
    "text": "违弃律法的，夸奖恶人；遵守律法的，却与恶人相争。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 5,
    "text": "坏人不明白公义；唯有寻求　耶和华的明白一切。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 6,
    "text": "行为正直的穷乏人胜过行事乖僻的富足人。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 7,
    "text": "谨守律法的，是智慧之子；与放纵之人作伴的，却羞辱其父。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 8,
    "text": "人以放债与不义之财加增财物，是给那怜悯穷人者积蓄的。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 9,
    "text": "转耳不听律法的，他的祈祷也为可憎。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 10,
    "text": "诱惑义人行恶道的，必掉在自己的坑里；唯有正直人必承受福分。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 11,
    "text": "富足人自以为有智慧，但聪明的贫穷人能将他查透。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 12,
    "text": "义人欢喜，有大荣耀；恶人兴起，人就躲藏。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 13,
    "text": "遮掩自己罪过的，必不亨通；承认离弃罪过的，必蒙怜恤。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 14,
    "text": "常存敬畏的，便为有福；心存刚硬的，必陷在祸患里。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 15,
    "text": "暴虐的君王辖制贫民，好像吼叫的狮子、觅食的熊。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 16,
    "text": "无知的君多行暴虐；以贪财为可恨的，必年长日久。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 17,
    "text": "行强暴流人血之罪的，必往坑里逃跑，谁也不可拦阻他。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 18,
    "text": "行动正直的，必蒙拯救；行事弯曲的，立时跌倒。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 19,
    "text": "耕种自己田地的，必得饱食；追随虚浮的，足受穷乏。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 20,
    "text": "诚实人必多得福；想要急速发财的，不免受罚。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 21,
    "text": "看人的情面乃为不好；人因一块饼枉法也为不好。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 22,
    "text": "人有恶眼想要急速发财，却不知穷乏必临到他身。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 23,
    "text": "责备人的，后来蒙人喜悦，多于那用舌头谄媚人的。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 24,
    "text": "偷窃父母的，说：这不是罪；此人就是与行毁坏的同类。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 25,
    "text": "心中骄傲的，挑起争端；倚靠　耶和华的，必得丰裕。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 26,
    "text": "心中自是的，便是愚昧人；凭智慧行事的，必蒙拯救。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 27,
    "text": "赒济贫穷的，不致缺乏；佯为不见的，必多受咒诅。"
  },
  {
    "bookId": 20,
    "chapterId": 28,
    "verseId": 28,
    "text": "恶人兴起，人就躲藏；恶人败亡，义人增多。"
  }
]
