[
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 1,
    "text": "智慧子听父亲的教训；亵慢人不听责备。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 2,
    "text": "人因口所结的果子，必吃美物；犯法的人必吃强暴。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 3,
    "text": "谨守口的，得保生命；大张嘴的，必致败亡。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 4,
    "text": "懒惰人羡慕，却无所得；殷勤人必得丰裕。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 5,
    "text": "义人恨恶谎言；恶人有臭名，且致惭愧。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 6,
    "text": "行为正直的，有公义保守；犯罪的，被邪恶倾覆。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 7,
    "text": "有使自己富足的，却一无所有；有使自己穷乏的，却广有财物。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 8,
    "text": "人的资财是他生命的赎价；穷乏人却不听责备。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 9,
    "text": "义人的光欢喜；恶人的灯必熄灭。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 10,
    "text": "只因骄傲，便启争竞；听劝言的，却有智慧。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 11,
    "text": "不劳而得之财必然消耗；勤劳积蓄的，必见加增。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 12,
    "text": "所盼望的迟延未得，令人心忧；所愿意的临到，却是生命树。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 13,
    "text": "藐视训言的，必致灭亡；敬畏诫命的，必得善报。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 14,
    "text": "智慧人的法则是生命的泉源，可以使人离开死亡的网罗。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 15,
    "text": "美好的聪明使人蒙恩；犯法之人的道路却是难行。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 16,
    "text": "凡通达人都凭知识处事；愚昧人张扬自己的愚昧。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 17,
    "text": "奸恶的使者必遭害；忠信的使臣乃医人的良药。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 18,
    "text": "不受训诲的，必致贫受辱；领受责备的，必得尊荣。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 19,
    "text": "所愿的成就，心觉甘甜；远离恶事，为愚昧人所憎恶。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 20,
    "text": "与智慧人同行的，必得智慧；和愚昧人作伴的，必致灭亡。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 21,
    "text": "祸患追赶罪人；义人必得善报。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 22,
    "text": "善人给子孙遗留产业；罪人为义人积存资财。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 23,
    "text": "穷人耕种多得粮食，但因无公义，有消灭的。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 24,
    "text": "不忍用杖打儿子的，是恨恶他；疼爱儿子的，趁早管教。"
  },
  {
    "bookId": 20,
    "chapterId": 13,
    "verseId": 25,
    "text": "义人吃得饱足；恶人肚腹缺粮。"
  }
]
