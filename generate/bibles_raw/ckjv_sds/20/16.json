[
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 1,
    "text": "心中的谋算在人里头，舌头的应对由于　耶和华。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 2,
    "text": "人一切所行的，在自己眼中看为清洁；唯有　耶和华衡量心灵。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 3,
    "text": "你所作的，要交托　耶和华，你所谋的，就必成立。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 4,
    "text": "耶和华所造的，各为己用；就是恶人也为祸患的日子所造。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 5,
    "text": "凡心里骄傲的，为　耶和华所憎恶；虽然连手，他必不免受罚。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 6,
    "text": "因怜悯诚实，罪孽得赎；敬畏　耶和华的，远离恶事。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 7,
    "text": "人所行的，若蒙　耶和华喜悦，　耶和华也使他的仇敌与他和好。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 8,
    "text": "少有财利，行事公义，强如多有财利，行事不正。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 9,
    "text": "人心筹算自己的道路；唯　耶和华指引他的脚步。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 10,
    "text": "王的嘴中有神语；审判之时，他的口不致差错。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 11,
    "text": "公道的天平和秤都属　耶和华；囊中一切法码都为他所定。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 12,
    "text": "作恶，为王所憎恶，因国位是靠公义坚立。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 13,
    "text": "公义的嘴为王所喜悦；说正确话的，为王所喜爱。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 14,
    "text": "王的震怒如杀人的使者；但智慧人能止息王怒。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 15,
    "text": "王的脸光使人有生命；王的恩典好像春云时雨。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 16,
    "text": "得智慧胜过得金子！选聪明强如选银子！"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 17,
    "text": "正直人的道是远离恶事；谨守己路的，是保全性命。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 18,
    "text": "骄傲在败坏以先；狂傲的心灵在跌倒之前。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 19,
    "text": "灵里谦卑与低微人来往，强如将掳物与骄傲人同分。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 20,
    "text": "办事精明的，必得好处；倚靠　耶和华的，便为有福。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 21,
    "text": "心中有智慧，必称为通达人；嘴中的甜言，加增人的学问。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 22,
    "text": "人有智慧就有生命的泉源；愚昧人的训诲却是愚昧。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 23,
    "text": "智慧人的心教训他的口，又使他的嘴增长学问。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 24,
    "text": "良言如同蜂房，使心觉甘甜，使骨得医治。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 25,
    "text": "有一条路，人以为正，至终成为死亡之路。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 26,
    "text": "劳力人的胃口使他劳力，因为他的口腹催逼他。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 27,
    "text": "不敬虔的人图谋奸恶，嘴上彷佛有烧焦的火。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 28,
    "text": "乖僻人播散纷争；传舌的，离间密友。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 29,
    "text": "强暴人诱惑邻舍，领他走不善之道。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 30,
    "text": "眼目紧合的，图谋乖僻；移动嘴唇的，成就邪恶。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 31,
    "text": "白发是荣耀的冠冕，在公义的道上必能得着。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 32,
    "text": "不轻易发怒的，胜过勇士；治服己灵的，强如取城。"
  },
  {
    "bookId": 20,
    "chapterId": 16,
    "verseId": 33,
    "text": "签放在怀里，定事由　耶和华。"
  }
]
