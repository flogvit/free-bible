[
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 1,
    "text": "王的心在　耶和华手中，好像陇沟的水随意流转。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 2,
    "text": "人所行的，在自己眼中都看为正；唯有　耶和华衡量人心。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 3,
    "text": "行仁义公平比献祭更蒙　耶和华悦纳。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 4,
    "text": "眼高心傲，并恶人耕地，皆为罪恶。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 5,
    "text": "殷勤筹划的，足致丰裕；行事急躁的，都必缺乏。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 6,
    "text": "以撒谎之舌求财，乃取死之人反覆的妄行。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 7,
    "text": "恶人所抢夺的必将自己扫除；因他们不肯按公平行事。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 8,
    "text": "人的道路乖僻怪异；至于纯洁的人，他所作的乃是正确。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 9,
    "text": "宁可住在房顶的角上，不在宽阔的房屋与争吵的妇人同住。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 10,
    "text": "恶人的心乐人受祸；他眼并不喜悦邻舍。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 11,
    "text": "亵慢的人受刑罚，愚蒙的人就得智慧；智慧人受训诲，便得知识。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 12,
    "text": "义人智慧地思想恶人的家，知道　上帝因为恶人的邪恶而倾倒他们。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 13,
    "text": "塞耳不听穷人呼求的，他将来呼求也不蒙听允。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 14,
    "text": "暗中送的礼物挽回怒气；怀中搋的馈赠止息暴怒。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 15,
    "text": "秉公行义使义人喜乐；败坏必临到作孽之人。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 16,
    "text": "迷离通达道路的，必住在阴魂的会中。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 17,
    "text": "爱宴乐的，必致穷乏；好酒，爱膏油的，必不富足。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 18,
    "text": "恶人必作义人的赎价，犯法的人代替正直人。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 19,
    "text": "宁可住在旷野，不与争吵使气的妇人同住。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 20,
    "text": "智慧人家中积蓄宝物膏油；愚昧人随得来随花尽。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 21,
    "text": "追求公义仁慈的，就寻得生命、公义，和尊荣。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 22,
    "text": "智慧人爬上勇士的城墙，倾覆他所倚靠的坚垒。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 23,
    "text": "谨守口与舌的，就保守自己免受灾难。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 24,
    "text": "心骄气傲的人名叫亵慢，都是行事傲怒。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 25,
    "text": "懒惰人的心愿将他杀害，因为他手不肯作工。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 26,
    "text": "有终日贪得无餍的；义人施舍而不吝惜。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 27,
    "text": "恶人的祭物是可憎的；何况他存恶意来献呢？"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 28,
    "text": "作假见证的必灭亡；唯有听真情而言的，其言长存。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 29,
    "text": "恶人硬着脸面；至于正直人，他却指引他的道。"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 30,
    "text": "没有智慧、聪明、谋略能以敌挡　耶和华"
  },
  {
    "bookId": 20,
    "chapterId": 21,
    "verseId": 31,
    "text": "马是为打仗之日预备的；安稳乃在乎　耶和华。"
  }
]
