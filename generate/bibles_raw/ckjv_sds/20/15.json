[
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 1,
    "text": "回答柔和，使怒消退；言语暴戾，触动怒气。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 2,
    "text": "智慧人的舌善用知识；愚昧人的口吐出愚昧。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 3,
    "text": "耶和华的眼目无处不在；恶人善人，他都鉴察。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 4,
    "text": "温良的舌是生命树；乖谬的嘴是灵里的破口。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 5,
    "text": "愚妄人藐视父亲的训诲；领受责备的，为有见识。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 6,
    "text": "义人家中多有财宝；恶人得利反受扰害。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 7,
    "text": "智慧人的嘴播扬知识；愚昧人的心并不如此。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 8,
    "text": "恶人献祭，为　耶和华所憎恶；正直人祈祷，为他所喜悦。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 9,
    "text": "恶人的道路，为　耶和华所憎恶；追求公义的，为他所喜爱。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 10,
    "text": "舍弃正路的，必受严刑；恨恶责备的，必致死亡。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 11,
    "text": "地狱和灭亡，尚在　耶和华眼前，何况世人的心呢。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 12,
    "text": "亵慢人不爱责备他的；他也不就近智慧人。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 13,
    "text": "心中喜乐，面带笑容；心里忧愁，灵被损伤。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 14,
    "text": "聪明人心求知识；愚昧人口吃愚昧。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 15,
    "text": "困苦人的日子都是愁苦；心中欢畅的，常享丰筵。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 16,
    "text": "少有财宝，敬畏　耶和华，强如多有财宝，烦乱不安。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 17,
    "text": "吃素菜，彼此相爱，强如吃肥牛，彼此相恨。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 18,
    "text": "暴怒的人挑启争端；忍怒的人止息纷争。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 19,
    "text": "懒惰人的道像荆棘的篱笆；义人的路是平坦的大道。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 20,
    "text": "智慧子使父亲喜乐；愚昧人藐视母亲。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 21,
    "text": "无知的人以愚妄为乐；聪明的人按正直而行。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 22,
    "text": "不先商议，所谋无效；谋士众多，所谋乃成。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 23,
    "text": "口善应对，自觉喜乐；话合其时，何等美好！"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 24,
    "text": "生命的道在智慧人上头，使他远离在下的地狱。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 25,
    "text": "耶和华必拆毁骄傲人的家，却要立定寡妇的地界。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 26,
    "text": "恶人的思念为　耶和华所憎恶；纯洁人的言语乃为良言。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 27,
    "text": "贪恋财利的，扰害己家；恨恶贿赂的，必得存活。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 28,
    "text": "义人的心，思量如何回答；恶人的口吐出恶言。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 29,
    "text": "耶和华远离恶人，却听义人的祷告。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 30,
    "text": "眼有光，使心喜乐；好信息，使骨滋润。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 31,
    "text": "听从生命责备的，必常在智慧人中。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 32,
    "text": "不受训诲的，轻看自己的生命；听从责备的，却得智慧。"
  },
  {
    "bookId": 20,
    "chapterId": 15,
    "verseId": 33,
    "text": "敬畏　耶和华是智慧的训诲；尊荣以前，必有谦卑。"
  }
]
