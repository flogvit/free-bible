[
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 1,
    "text": "夏天落雪，收割时下雨，都不相宜；愚昧人得尊荣也是如此。"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 2,
    "text": "麻雀往来，燕子翻飞；这样，无故的咒诅也必不临到。"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 3,
    "text": "鞭子是为打马，辔头是为勒驴；刑杖是为打愚昧人的背。"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 4,
    "text": "不要照愚昧人的愚妄话回答他，恐怕你与他一样。"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 5,
    "text": "要照愚昧人的愚妄话回答他，免得他自以为有智慧。"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 6,
    "text": "藉愚昧人手寄信的，是砍断自己的脚，自喝损害。"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 7,
    "text": "瘸子的腿空存无用；比喻在愚昧人的口中也是如此。"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 8,
    "text": "将尊荣给愚昧人的，好像人把石子包在机弦里。"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 9,
    "text": "比喻在愚昧人的口中，好像荆棘刺入醉汉的手。"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 10,
    "text": "那至大、造作万事的　上帝报应愚昧人，也报应犯法的人。"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 11,
    "text": "愚昧人行愚妄事，行了又行，就如狗转过来吃它所吐的。"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 12,
    "text": "你见自以为有智慧的人吗？愚昧人比他更有盼望。"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 13,
    "text": "懒惰人说：道上有猛狮，街上有壮狮。"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 14,
    "text": "门在枢纽转动，懒惰人在床上也是如此。"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 15,
    "text": "懒惰人放手在怀里，就是向口撤回也以为劳乏。"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 16,
    "text": "懒惰人看自己比七个善于应对的人更有智慧。"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 17,
    "text": "过路被事激动，管理不干己的争竞，好像人揪住狗耳。"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 18,
    "text": "疯狂的人怎样抛掷火把、利箭，与死亡，"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 19,
    "text": "人欺凌邻舍，却说：「我岂不是戏耍吗？」的，也是怎样。"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 20,
    "text": "火缺了柴就必熄灭；无人传舌，争竞便止息。"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 21,
    "text": "好争竞的人煽惑争端，就如余火加炭，火上加柴一样。"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 22,
    "text": "传舌人的言语，如同损伤，深入人的心腹。"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 23,
    "text": "火热的嘴，奸恶的心，好像银渣包的瓦器。"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 24,
    "text": "怨恨人的，用嘴粉饰，心里却藏着诡诈；"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 25,
    "text": "他用甜言蜜语，你不可信他，因为他心中有七样可憎恶的。"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 26,
    "text": "怨恨为诡诈所遮掩，他的邪恶必在全会中显露。"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 27,
    "text": "挖陷坑的，自己必掉在其中；滚石头的，石头必反滚在他身上。"
  },
  {
    "bookId": 20,
    "chapterId": 26,
    "verseId": 28,
    "text": "虚谎的舌恨他所压伤的人；谄媚的口败坏人的事。"
  }
]
