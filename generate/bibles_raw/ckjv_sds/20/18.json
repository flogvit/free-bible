[
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 1,
    "text": "与众寡合的，独自寻求心愿，并以一切智慧寻找和干与事。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 2,
    "text": "愚昧人不喜爱明哲，只喜爱显露心意。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 3,
    "text": "恶人来，藐视随来；羞耻到，辱骂同到。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 4,
    "text": "人口中的言语如同深水；智慧的泉源好像涌流的河水。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 5,
    "text": "瞻徇恶人的情面，颠倒义人的案件，都为不善。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 6,
    "text": "愚昧人张嘴启争端，开口招鞭打。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 7,
    "text": "愚昧人的口自取败坏；他的嘴是他生命的网罗。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 8,
    "text": "传舌人的言语如同损伤，深入人的心腹。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 9,
    "text": "作工懈怠的，与浪费人为兄弟。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 10,
    "text": "耶和华的名是坚固台；义人奔入便得安稳。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 11,
    "text": "富足人的财物是他的坚城，在他心想，犹如高墙。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 12,
    "text": "败坏之先，人心骄傲；尊荣以前，必有谦卑。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 13,
    "text": "未曾听完先回答的，便是他的愚昧和羞辱。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 14,
    "text": "人有疾病，心能忍耐；心灵受伤，谁能承当呢？"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 15,
    "text": "聪明人的心得知识；智慧人的耳求知识。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 16,
    "text": "人的礼物为他开路，引他到高位的人面前。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 17,
    "text": "先诉情由的，似乎有理；但邻舍来到，就察出实情。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 18,
    "text": "掷签能止息争竞，也能解散强胜的人。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 19,
    "text": "兄弟结怨，劝他和好，比取坚固城还难；这样的争竞如同坚寨的门闩。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 20,
    "text": "人口中所结的果子，必充满肚腹；他嘴所出的，必使他饱足。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 21,
    "text": "生死在舌头的权下，喜爱它的，必吃它所结的果子。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 22,
    "text": "得着贤妻的，是得着好处，也是蒙了　耶和华的恩惠。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 23,
    "text": "贫穷人说哀求的话；富足人用威吓的话回答。"
  },
  {
    "bookId": 20,
    "chapterId": 18,
    "verseId": 24,
    "text": "人有朋友，必须显为友善；但有一朋友比兄弟更亲密。"
  }
]
