[
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 1,
    "text": "美名胜过大财；恩宠强如金银。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 2,
    "text": "富户穷人在世相遇，都为　耶和华所造。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 3,
    "text": "通达人见祸藏躲；愚蒙人前往受害。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 4,
    "text": "敬畏　耶和华心存谦卑，就得富有、尊荣、生命为赏赐。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 5,
    "text": "乖僻人的路上有荆棘和网罗；保守自己生命的，必要远离。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 6,
    "text": "教养孩童，使他走当行的道，就是到老他也不偏离。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 7,
    "text": "富户管辖穷人；欠债的是债主的仆人。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 8,
    "text": "撒罪孽的，必收虚空；他逞怒的杖也必废掉。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 9,
    "text": "眼目慈善的，就必蒙福，因他将食物分给穷人。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 10,
    "text": "赶出亵慢人，争端就消除；纷争和羞辱也必止息。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 11,
    "text": "喜爱清心的人因他嘴上的恩言，王必与他为友。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 12,
    "text": "耶和华的眼目眷顾聪明人，却倾败犯法的人的言语。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 13,
    "text": "懒惰人说：外头有狮子；我在街上就必被杀。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 14,
    "text": "外女的口为深坑；　耶和华所憎恶的，必陷在其中。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 15,
    "text": "愚蒙迷住孩童的心，用管教的杖可以远远赶除。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 16,
    "text": "欺压贫穷为要利己的，并送礼与富户的，都必缺乏。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 17,
    "text": "你须侧耳听受智慧人的言语，留心领会我的知识。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 18,
    "text": "你若心中存记，嘴上咬定，这便为美。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 19,
    "text": "我今日以此特特指教你，为要使你倚靠　耶和华。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 20,
    "text": "谋略和知识的美事，我岂没有写给你，"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 21,
    "text": "要使你知道真言的实理，你好将真言回覆那打发你来的人吗？"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 22,
    "text": "贫穷人，你不可因他贫穷就抢夺他的物，也不可在城门口欺压困苦人；"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 23,
    "text": "因　耶和华必为他辨屈；抢夺他的，　耶和华必夺取那人的命。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 24,
    "text": "好生气的人，不可与他结交；暴怒的人，你不可与他来往；"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 25,
    "text": "恐怕你效法他的行为，自己就陷在网罗里。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 26,
    "text": "不要与人击掌，不要为欠债的作保。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 27,
    "text": "你若没有什么偿还，何必使人夺去你睡卧的床呢？"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 28,
    "text": "你先祖所立的地界，你不可挪移。"
  },
  {
    "bookId": 20,
    "chapterId": 22,
    "verseId": 29,
    "text": "你看见办事殷勤的人吗？他必站在君王面前，必不站在下贱人面前。"
  }
]
