[
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 1,
    "text": "利慕伊勒王的言语，是他母亲教训他的预言。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 2,
    "text": "我的儿啊，我腹中生的儿啊，我许愿得的儿啊！我当怎样教训你呢？"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 3,
    "text": "不要将你的精力给妇女；也不要有败坏君王的行为。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 4,
    "text": "利慕伊勒啊，君王喝酒，君王喝酒不相宜；王子说浓酒在那里也不相宜；"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 5,
    "text": "恐怕喝了就忘记律例，颠倒一切困苦人的是非。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 6,
    "text": "可以把浓酒给将亡的人喝，把清酒给苦心的人喝，"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 7,
    "text": "让他喝了，就忘记他的贫穷，不再记念他的苦楚。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 8,
    "text": "你当为哑巴开口，为一切要被灭绝的伸冤。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 9,
    "text": "你当开口按公义判断，为困苦和穷乏的辨屈。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 10,
    "text": "才德的妇人谁能得着呢？她的价值远胜过红宝石。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 11,
    "text": "她丈夫心里倚靠她，必不缺少利益；"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 12,
    "text": "她一生使丈夫有益无损。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 13,
    "text": "她寻找羊绒和麻，甘心用手作工。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 14,
    "text": "她好像商船从远方运粮来，"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 15,
    "text": "未到黎明她就起来，把食物分给家中的人，将当作的工分派婢女。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 16,
    "text": "她想得田地就买来；用手所得之利栽种葡萄园。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 17,
    "text": "她以能力束腰，使膀臂有力。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 18,
    "text": "她觉得所经营的有利；她的烛终夜不灭。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 19,
    "text": "她手拿捻线竿，手把纺线车。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 20,
    "text": "她张手赒济困苦人，伸手帮补穷乏人。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 21,
    "text": "她不因下雪为家里的人担心，因为全家都穿着朱红衣服。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 22,
    "text": "她为自己制作绣花铺盖；她的衣服是丝绸和紫色布作的。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 23,
    "text": "她丈夫在城门口与本地的长老同坐，为众人所认识。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 24,
    "text": "她作细麻布衣裳出卖，又将腰带卖与商家。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 25,
    "text": "能力和威仪是她的衣服；她想到日后的景况就喜笑。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 26,
    "text": "她开口就发智慧；她舌上有仁慈的法则。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 27,
    "text": "她观察家务，并不吃闲饭。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 28,
    "text": "她的儿女起来称她有福；她的丈夫也称赞她，"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 29,
    "text": "说，才德的女子很多，唯独妳超越她们。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 30,
    "text": "艳丽是虚假的，美容是虚浮的；唯敬畏　耶和华的妇女必得称赞。"
  },
  {
    "bookId": 20,
    "chapterId": 31,
    "verseId": 31,
    "text": "愿她享受操作所得的成果；愿她自己所作的在城门口称赞她。"
  }
]
