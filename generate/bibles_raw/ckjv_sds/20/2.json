[
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 1,
    "text": "我儿，你若领受我的言语，存记我的命令，"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 2,
    "text": "侧耳听智慧，专心求聪明，"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 3,
    "text": "呼求明哲，扬声求聪明，"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 4,
    "text": "寻找她，如寻找银子，搜求她，如搜求隐藏的珍宝，"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 5,
    "text": "你就明白敬畏　耶和华，得以认识　上帝。"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 6,
    "text": "因为，　耶和华赐人智慧；知识和聪明都由他口而出。"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 7,
    "text": "他给义人存留真智慧；他乃行事正直之人的盾牌。"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 8,
    "text": "他要保守公平人的路，护庇他圣民的道。"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 9,
    "text": "你也必明白仁义、公平、公正、一切的善道。"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 10,
    "text": "智慧必入你心；你的魂要以知识为美。"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 11,
    "text": "谋略必护卫你；聪明必保守你，"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 12,
    "text": "要救你脱离恶人的道，脱离说乖谬话的人。"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 13,
    "text": "那等人舍弃正直的路，行走黑暗的道，"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 14,
    "text": "欢喜作恶，喜爱恶人的乖僻，"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 15,
    "text": "在他们的道中弯曲，在他们的路上偏僻。"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 16,
    "text": "智慧要救你脱离外女，就是那油嘴滑舌的外人。"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 17,
    "text": "她离弃幼年的引导，忘了　上帝的盟约。"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 18,
    "text": "她的家陷入死地；她的路偏向死人。"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 19,
    "text": "凡到她那里去的，不得转回，也得不着生命的路。"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 20,
    "text": "智慧必使你行善人的道，守义人的路。"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 21,
    "text": "正直人必在世上居住；完全人必在地上存留。"
  },
  {
    "bookId": 20,
    "chapterId": 2,
    "verseId": 22,
    "text": "唯有恶人必然剪除；犯法的，必然拔出。"
  }
]
