[
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 1,
    "text": "有块干饼，大家相安，强如祭牲满屋，大家相争。"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 2,
    "text": "智慧的仆人必管辖贻羞之子，又在众弟兄中同分产业。"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 3,
    "text": "鼎为炼银，炉为炼金；唯有　耶和华试炼人心。"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 4,
    "text": "行恶的，留心听虚假之唇；说谎的，侧耳听邪恶之舌。"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 5,
    "text": "戏笑穷人的，是辱没他的　造物主；幸灾乐祸的，必不免受罚。"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 6,
    "text": "子孙为老人的冠冕；父亲是儿女的荣耀。"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 7,
    "text": "愚顽人本不说美言，何况君王说谎话呢？"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 8,
    "text": "礼物在馈送的人眼中看为宝玉，随处转让都得顺利。"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 9,
    "text": "遮掩人过的，寻求人爱；屡次挑错的，离间密友。"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 10,
    "text": "一句责备话深入智慧人的心，强如责打愚昧人一百下。"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 11,
    "text": "恶人只寻背叛；所以必有严厉的使者奉差攻击他。"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 12,
    "text": "宁可遇见丢崽子的母熊，不可遇见正行愚妄的愚昧人。"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 13,
    "text": "以恶报善的，祸患必不离他的家。"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 14,
    "text": "纷争的起头如人将水放开；所以，在争闹之先必当罢出争竞。"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 15,
    "text": "定恶人为义的，定义人为恶的，这都为　耶和华所憎恶。"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 16,
    "text": "愚昧人既无心以求，为何手拿价银要得智慧呢？"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 17,
    "text": "朋友乃时常亲爱，兄弟为患难而生。"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 18,
    "text": "在朋友面前击掌作保乃是无知的人。"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 19,
    "text": "喜爱争竞的，是喜爱过犯；高立家门的，乃自取败坏。"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 20,
    "text": "心存邪僻的，寻不着好处；舌弄是非的，陷在祸患中。"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 21,
    "text": "生愚昧子的，必自愁苦；愚顽人的父毫无喜乐。"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 22,
    "text": "喜乐的心利如良药；忧伤的灵使骨枯干。"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 23,
    "text": "恶人将贿赂从怀中取出，为要颠倒判断。"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 24,
    "text": "明哲人面前有智慧；愚昧人眼望地极。"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 25,
    "text": "愚昧子使父亲愁烦，使生他的忧苦。"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 26,
    "text": "刑罚义人为不善，责打王子为不正。"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 27,
    "text": "有知识的，寡少言语；有聪明的，灵性温良。"
  },
  {
    "bookId": 20,
    "chapterId": 17,
    "verseId": 28,
    "text": "愚昧人若静默不言也可算为智慧；人闭嘴不说也可算为聪明。"
  }
]
