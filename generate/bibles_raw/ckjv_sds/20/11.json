[
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 1,
    "text": "诡诈的天平为　耶和华所憎恶；公平的法码为他所喜悦。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 2,
    "text": "骄傲来，羞耻也来；谦逊人却有智慧。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 3,
    "text": "正直人的纯正必引导自己；犯法的人的乖僻必毁灭自己。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 4,
    "text": "发怒的日子资财无益；唯有公义能救人脱离死亡。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 5,
    "text": "完全人的义必指引他的路；但恶人必因自己的恶跌倒。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 6,
    "text": "正直人的义必拯救自己；犯法的人必陷在自己的罪孽中。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 7,
    "text": "恶人一死，他的指望必灭绝；不义的人的盼望也必灭没。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 8,
    "text": "义人得脱离患难，有恶人来代替他。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 9,
    "text": "假善的人用口败坏邻舍；义人却因知识得救。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 10,
    "text": "义人享福，合城喜乐；恶人灭亡，人都欢呼。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 11,
    "text": "城因正直人祝福便高举，却因邪恶人的口就倾覆。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 12,
    "text": "毫无智慧的，藐视邻舍；明哲人却静默不言。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 13,
    "text": "往来传舌的，泄漏密事；灵里诚实的，遮隐事情。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 14,
    "text": "无智谋，民就败落；谋士多，人便安居。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 15,
    "text": "为外人作保的，必受亏损；恨恶击掌的，却得安稳。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 16,
    "text": "恩德的妇女得尊荣；强壮的男子得资财。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 17,
    "text": "仁慈的人善待自己；残忍的人扰害己身。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 18,
    "text": "恶人经营，得虚浮的成果；撒义种的，得实在的果效。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 19,
    "text": "恒心为义的，必得生命；追求邪恶的，必致死亡。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 20,
    "text": "心中乖僻的，为　耶和华所憎恶；行事正直的，为他所喜悦。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 21,
    "text": "恶人虽然连手，必不免受罚；义人的后裔必得拯救。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 22,
    "text": "妇女美貌而无见识，如同金器带在猪鼻上。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 23,
    "text": "义人的心愿尽得好处；恶人的指望致干忿怒。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 24,
    "text": "有施散的，却更增添；有吝惜过度的，反致穷乏。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 25,
    "text": "好施舍的，必得丰裕；滋润人的，必得滋润。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 26,
    "text": "屯谷不卖的，民必咒诅他；情愿出卖的，人必为他祝福。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 27,
    "text": "恳切求善的，就求得恩惠；唯独求恶的，恶必临到他身。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 28,
    "text": "倚仗自己财物的，必跌倒；义人必发旺，如枝条。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 29,
    "text": "扰害己家的，必承受清风；愚昧人必作慧心人的仆人。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 30,
    "text": "义人所结的果子就是生命树；赢得人的，是有智慧。"
  },
  {
    "bookId": 20,
    "chapterId": 11,
    "verseId": 31,
    "text": "看哪，义人在世尚且受报；恶人和罪人就更受报了。"
  }
]
