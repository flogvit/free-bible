[
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 1,
    "text": "喜爱训诲的，就是喜爱知识；恨恶责备的，却是畜类。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 2,
    "text": "善人必蒙　耶和华的恩惠；设恶计的人，他必定他的罪。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 3,
    "text": "人靠恶行不能坚立；义人的根必不动摇。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 4,
    "text": "才德的妇人是丈夫的冠冕；贻羞的妇人如同朽烂在她丈夫的骨中。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 5,
    "text": "义人的思念是公平；恶人的计谋是诡诈。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 6,
    "text": "恶人的言论是埋伏流人的血；正直人的口必拯救人。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 7,
    "text": "恶人倾覆，归于无有；义人的家必站得住。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 8,
    "text": "人必按自己的智慧被称赞；心中乖谬的，必被藐视。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 9,
    "text": "被人轻贱，却有仆人，强如自尊，缺少食物。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 10,
    "text": "义人顾惜他牲畜的命；恶人的怜悯也是残忍。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 11,
    "text": "耕种自己田地的，必得饱食；追随虚浮人的，却是无知。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 12,
    "text": "恶人想得坏人的网罗；义人的根得以结果。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 13,
    "text": "恶人嘴中的过错是自己的网罗；但义人必脱离患难。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 14,
    "text": "人因口所结的果子，必饱得美福；人手所作的，必为自己的回报。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 15,
    "text": "愚妄人所行的，在自己眼中看为正确；唯肯听人劝教的，是有智慧。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 16,
    "text": "愚妄人的恼怒当下显露；通达人能忍辱藏羞。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 17,
    "text": "说出真话的，显明公义；作假见证的，显出诡诈。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 18,
    "text": "有人说话如刀刺人；智慧人的舌头却为医人的良药。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 19,
    "text": "嘴吐真言，永远坚立；舌说谎话，只存片时。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 20,
    "text": "图谋恶事的，心存诡诈；劝人和睦的，便得喜乐。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 21,
    "text": "义人不遭灾害；恶人满受祸患。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 22,
    "text": "说谎言的嘴为　耶和华所憎恶；行事诚实的，为他所喜悦。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 23,
    "text": "通达人隐藏知识；愚昧人的心彰显愚昧。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 24,
    "text": "殷勤人的手必掌权；懒惰的人必服苦。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 25,
    "text": "人心忧虑，屈而不伸；一句良言，使心欢乐。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 26,
    "text": "义人比他的邻舍美好；恶人的道却诱惑他们。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 27,
    "text": "懒惰人不烤他打猎所得的；殷勤人的财物却甚宝贵。"
  },
  {
    "bookId": 20,
    "chapterId": 12,
    "verseId": 28,
    "text": "在公义的道上有生命；其路之中并无死亡。"
  }
]
