[
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 1,
    "text": "耶和华啊，求你记念我们所遭遇的事；察看我们所受的凌辱。"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 2,
    "text": "我们的产业转归外邦人，我们的房屋归与外路人。"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 3,
    "text": "我们是孤儿，是无父的，我们的母亲好像寡妇。"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 4,
    "text": "我们出钱才得喝我们的水；我们的柴是人卖给我们的。"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 5,
    "text": "逼迫直逼我们颈项；我们劳碌不得歇息。"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 6,
    "text": "我们将手交付埃及人和亚述人，为要得粮吃饱。"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 7,
    "text": "我们列祖犯罪，而今不在了；我们担当他们的罪孽。"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 8,
    "text": "仆人辖制了我们；无人救我们脱离他们的手。"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 9,
    "text": "因为旷野的刀剑，我们冒着险才得粮食。"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 10,
    "text": "因可怕的饥饿，我们的皮肤就黑如炉。"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 11,
    "text": "敌人在锡安玷污妇人，在犹大的城邑玷污处女。"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 12,
    "text": "他们吊起首领的手；也不尊敬老人的面。"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 13,
    "text": "他们拿少年人作推磨，孩童背木柴，都跌倒了。"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 14,
    "text": "老年人从城门口断绝，少年人不再作乐。"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 15,
    "text": "我们心中的快乐止息；我们跳舞变为悲哀。"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 16,
    "text": "冠冕从我们的头上落下；我们犯罪了，我们有祸了！"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 17,
    "text": "我们因这事心里发昏；因这些事，我们的眼睛昏花。"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 18,
    "text": "因为锡安山荒凉，狐狸行在其上。"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 19,
    "text": "耶和华啊，你存到永远；你的宝座存到世世代代。"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 20,
    "text": "你为何永远忘记我们，为何许久离弃我们？"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 21,
    "text": "耶和华啊，求你使我们向你回转，我们便得回转；求你复新我们的日子，像古时一样。"
  },
  {
    "bookId": 25,
    "chapterId": 5,
    "verseId": 22,
    "text": "你倒全然弃绝我们；你向我们大发烈怒。"
  }
]
