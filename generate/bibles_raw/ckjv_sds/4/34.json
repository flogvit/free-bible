[
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 1,
    "text": "耶和华晓谕摩西说："
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 2,
    "text": "你吩咐以色列人说：「你们到了迦南地，（就是归你们为业的迦南四境之地；）"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 3,
    "text": "南角要从寻的旷野，贴着以东的边界；南界要从盐海东头起，"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 4,
    "text": "绕到亚克拉滨坡的南边，接连到寻，直通到加低斯・巴尼亚的南边，又通到哈萨・亚达，接连到押们，"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 5,
    "text": "从押们转到埃及小河，直通到海为止。"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 6,
    "text": "「西边要以大海为界；这就是你们的西界。"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 7,
    "text": "「北界要从大海起，画到何珥山，"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 8,
    "text": "从何珥山划到哈马口，通到西达达，"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 9,
    "text": "又通到西斐仑，直到哈萨・以难。这要作你们的北界。"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 10,
    "text": "「你们要从哈萨・以难划到示番为东界。"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 11,
    "text": "这界要从示番下到亚延东边的利比拉，又要达到基尼烈湖的东边。"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 12,
    "text": "这界要下到约旦河，通到盐海为止。这四围的边界以内，要作你们的地。」"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 13,
    "text": "摩西吩咐以色列人说：「这地就是　耶和华吩咐你们按签给九个半支派承受为业的；"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 14,
    "text": "因为吕便支派和迦得支派按着父家受了产业，玛拿西半个支派也受了产业。"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 15,
    "text": "这两个半支派已经在靠近耶利哥、约旦河东、向日出之地受了产业。」"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 16,
    "text": "耶和华晓谕摩西说："
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 17,
    "text": "「要给你们分地为业之人的名字是祭司以利亚撒和嫩的儿子约书亚。"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 18,
    "text": "又要从每支派中选一个首领帮助他们。"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 19,
    "text": "这些人的名字：犹大支派有耶孚尼的儿子迦勒。"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 20,
    "text": "西缅支派有亚米忽的儿子示母利。"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 21,
    "text": "便雅悯支派有基斯伦的儿子以利达。"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 22,
    "text": "但支派的首领是约利的儿子布基。"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 23,
    "text": "约瑟的子孙玛拿西支派的首领是以弗的儿子汉聂。"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 24,
    "text": "以法莲支派的首领是拾弗但的儿子基母利。"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 25,
    "text": "西布伦支派的首领是帕纳的儿子以利撒番。"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 26,
    "text": "以萨迦支派的首领是阿散的儿子帕铁。"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 27,
    "text": "亚设支派的首领是示罗米的儿子亚希忽。"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 28,
    "text": "拿弗他利支派的首领是亚米忽的儿子比大黑。」"
  },
  {
    "bookId": 4,
    "chapterId": 34,
    "verseId": 29,
    "text": "这些人就是　耶和华所吩咐、在迦南地把产业分给以色列人的。"
  }
]
