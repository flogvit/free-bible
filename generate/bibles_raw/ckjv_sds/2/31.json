[
  {
    "bookId": 2,
    "chapterId": 31,
    "verseId": 1,
    "text": "耶和华晓谕摩西说："
  },
  {
    "bookId": 2,
    "chapterId": 31,
    "verseId": 2,
    "text": "「看哪，犹大支派中，户珥的孙子、乌利的儿子比撒列，我已经提他的名召他。"
  },
  {
    "bookId": 2,
    "chapterId": 31,
    "verseId": 3,
    "text": "我也以　上帝的灵充满了他，使他有智慧，有聪明，有知识，能作各样的工，"
  },
  {
    "bookId": 2,
    "chapterId": 31,
    "verseId": 4,
    "text": "能想出巧工，用金、银、铜制造各物，"
  },
  {
    "bookId": 2,
    "chapterId": 31,
    "verseId": 5,
    "text": "又能刻宝石，可以镶嵌，能雕刻木头，能作各样的工。"
  },
  {
    "bookId": 2,
    "chapterId": 31,
    "verseId": 6,
    "text": "看哪，我分派但支派中、亚希撒抹的儿子亚何利亚伯与他同工。凡心里有智慧的，我更使他们有智慧，能作我一切所吩咐的，"
  },
  {
    "bookId": 2,
    "chapterId": 31,
    "verseId": 7,
    "text": "就是会幕和法柜，并其上的施恩座，与会幕中一切的器具，"
  },
  {
    "bookId": 2,
    "chapterId": 31,
    "verseId": 8,
    "text": "桌子和它的器具，精金的烛台和它的一切器具并香坛，"
  },
  {
    "bookId": 2,
    "chapterId": 31,
    "verseId": 9,
    "text": "燔祭坛和坛的一切器具，并洗濯盆与盆座，"
  },
  {
    "bookId": 2,
    "chapterId": 31,
    "verseId": 10,
    "text": "供职的衣服，和祭司亚伦并他儿子用以供祭司职分的圣衣，"
  },
  {
    "bookId": 2,
    "chapterId": 31,
    "verseId": 11,
    "text": "膏油和供圣所用的美香；他们都要照我一切所吩咐的去作。」"
  },
  {
    "bookId": 2,
    "chapterId": 31,
    "verseId": 12,
    "text": "耶和华晓谕摩西说："
  },
  {
    "bookId": 2,
    "chapterId": 31,
    "verseId": 13,
    "text": "「你要告诉以色列人说：『你们务要守我的安息日；因为这是你我之间世世代代的证据，使你们知道我―　耶和华是叫你们成为圣的。"
  },
  {
    "bookId": 2,
    "chapterId": 31,
    "verseId": 14,
    "text": "所以你们要守安息日，以为圣日。凡干犯这日的，必要把他治死；凡在这日作工的，必从民中剪除。"
  },
  {
    "bookId": 2,
    "chapterId": 31,
    "verseId": 15,
    "text": "六日要作工，但第七天是安息日，是向　耶和华守为圣的。凡在安息日作工的，必要把他治死。』"
  },
  {
    "bookId": 2,
    "chapterId": 31,
    "verseId": 16,
    "text": "故此，以色列人要世世代代谨守安息日为永远的约。"
  },
  {
    "bookId": 2,
    "chapterId": 31,
    "verseId": 17,
    "text": "这是我和以色列人永远的证据；因为六日之内　耶和华造天地，第七天便安息舒畅。」"
  },
  {
    "bookId": 2,
    "chapterId": 31,
    "verseId": 18,
    "text": "耶和华在西奈山和摩西说完了话，就把两块法版交给他，是　上帝用指头写的石版。"
  }
]
