[
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 1,
    "text": "提幔人以利法回答说："
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 2,
    "text": "智慧人既或有益于己，人还能使　上帝有益么？"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 3,
    "text": "你为人公义，岂叫　全能者喜悦呢？你行为完全，岂能使他得利呢？"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 4,
    "text": "他岂因你敬畏他就责备你？他岂审判你吗？"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 5,
    "text": "你的罪恶岂不是大吗？你的罪孽岂不是没有穷尽吗？"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 6,
    "text": "因你无故强取你兄弟的物为当头，剥去贫寒人的衣服。"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 7,
    "text": "困乏的人，你没有给他水喝；饥饿的人，你没有给他食物。"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 8,
    "text": "有能力的人就得地土；尊贵的人也住在其中。"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 9,
    "text": "你打发寡妇空手回去，折断无父之人的膀臂。"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 10,
    "text": "因此，有网罗环绕你，有恐惧忽然使你惊惶；"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 11,
    "text": "或有黑暗蒙蔽你，并有洪水淹没你。"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 12,
    "text": "上帝岂不是在高天吗？你看星宿何其高呢！"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 13,
    "text": "你说：　上帝知道什么？他岂能穿透黑云施行审判呢？"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 14,
    "text": "密云将他遮盖，使他不能看见；他周游穹苍。"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 15,
    "text": "你有留意上古的道吗？这道是恶人所行的。"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 16,
    "text": "他们未到死期，就被砍下，根基毁坏，好像被江河冲去；"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 17,
    "text": "他们向　上帝说：离开我们吧！又说：全能者能为他们怎么行呢？"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 18,
    "text": "哪知　上帝以美物充满他们的房屋；但恶人所谋定的离我好远。"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 19,
    "text": "义人看见他们的结局就欢喜；无辜的人嗤笑他们，"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 20,
    "text": "我们的货财未被剪除，但是他们所剩的都被火烧灭。"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 21,
    "text": "你要认识　上帝，就得平安；福气也必临到你。"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 22,
    "text": "你当领受他口中的教训，将他的言语存在心里。"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 23,
    "text": "你若归向　全能者，从你帐棚中远除不义，就必得建立。"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 24,
    "text": "这样你积蓄的金子就必如尘土，俄斐的黄金也必如溪河石头；"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 25,
    "text": "全能者就必作保护你的，你也必得宝银。"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 26,
    "text": "你就要以　全能者为喜乐，向　上帝仰起脸来。"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 27,
    "text": "你要祷告他，他就听你；你也要还你的愿。"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 28,
    "text": "你定意要作何事，必然给你成就；亮光也必照耀你的路。"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 29,
    "text": "人降卑的时候，你仍可说：必得高升；谦卑的人，他必然拯救。"
  },
  {
    "bookId": 18,
    "chapterId": 22,
    "verseId": 30,
    "text": "无辜之岛，　上帝且要搭救；他因你手中清洁，必蒙拯救。"
  }
]
