[
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 1,
    "text": "约伯回答说："
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 2,
    "text": "你们搅扰我的心，用言语压碎我要到几时呢？"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 3,
    "text": "你们这十次羞辱我；你们向我装作生人也不以为耻。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 4,
    "text": "果真我有错，这错乃是在我。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 5,
    "text": "你们果然要向我夸大，以我的羞辱为证指责我，"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 6,
    "text": "就该知道是　上帝倾覆我，用网罗围绕我。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 7,
    "text": "看哪，我因委曲呼叫，却不蒙听允；我大声呼求，却不得公断。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 8,
    "text": "上帝用篱笆拦住我的道路，使我不得经过；他又使我的路径黑暗。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 9,
    "text": "他剥去我的荣光，摘去我头上的冠冕。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 10,
    "text": "他在四围灭了我，我便去了；将我的盼望如树被移去。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 11,
    "text": "他的忿怒向我发作，以我为敌人。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 12,
    "text": "他的军旅一齐上来，修筑战路攻击我，在我帐棚的四围安营。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 13,
    "text": "他把我的弟兄隔在远处，使我所认识的诚然与我生疏。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 14,
    "text": "我的亲戚与我断绝；我的密友都忘记我。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 15,
    "text": "在我家寄居的，和我的使女都以我为外人；我在他们眼中看为外邦人。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 16,
    "text": "我唤了我的仆人，他还是不回答我；我开口求他。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 17,
    "text": "我口的气味，我妻子厌恶；就是向她求从我所生的孩子，她还是憎嫌。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 18,
    "text": "小孩子藐视我；我起来，他们就嘲笑我。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 19,
    "text": "我的密友都憎恶我；我平日所爱的人向我翻脸。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 20,
    "text": "我的皮肉紧贴骨头；我只剩牙皮逃脱了。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 21,
    "text": "我朋友啊，可怜我！可怜我！因为　上帝的手攻击我。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 22,
    "text": "你们为什么彷佛　上帝逼迫我，吃我的肉还以为不足呢？"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 23,
    "text": "唯愿我的言语现在被写上！唯愿人都印录在书上！"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 24,
    "text": "用铁笔镌刻，用铅灌在磐石上，直存到永远！"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 25,
    "text": "我知道我的救赎主活着，末了之日必站立在地上。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 26,
    "text": "我这身子皮肉虽被虫所坏，我仍必在肉体之内得见　上帝。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 27,
    "text": "我的心肠在我里面虽然消灭，我自己却要见他，亲眼要看他，并不像外人。"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 28,
    "text": "你们却要说：我们为何逼迫他呢？惹事的根乃在乎我；"
  },
  {
    "bookId": 18,
    "chapterId": 19,
    "verseId": 29,
    "text": "你们就当惧怕刀剑；因为忿怒惹动刀剑的刑罚，使你们知道有审判。"
  }
]
