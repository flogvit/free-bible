[
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 1,
    "text": "拿玛人琐法回答说："
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 2,
    "text": "所以我的思念叫我回答，为此我要快说。"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 3,
    "text": "我已听见那要羞辱我的话；我悟性的灵叫我回答。"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 4,
    "text": "你岂不知亘古以来，自从人被安置在地，"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 5,
    "text": "恶人夸胜是暂时的，假善之人的喜乐不过转眼之间吗？"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 6,
    "text": "他的尊荣虽达到诸天，头虽顶到云中，"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 7,
    "text": "他终必永归灭亡，像自己的粪一样；素来见他的人要说：他在哪里呢？"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 8,
    "text": "他必飞去如梦，不再寻见，速被赶去，如夜间的异象。"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 9,
    "text": "亲眼见过他的，必不再见他；他的本处也再见不着他。"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 10,
    "text": "他的儿女要求穷人喜欢；他的手要赔还不义之财。"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 11,
    "text": "他的骨头满有青年时所犯的罪，都要和他一同躺卧在尘土中。"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 12,
    "text": "他口内虽以恶为甘甜，藏在舌头底下，"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 13,
    "text": "爱恋不舍，含在口中；"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 14,
    "text": "他的食物在肚里却要化为酸，在他里面成为虺蛇的恶毒。"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 15,
    "text": "他吞了财宝，还要吐出；　上帝要从他腹中掏出来。"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 16,
    "text": "他必吸饮虺蛇的毒气；蝮蛇的舌头也必杀他。"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 17,
    "text": "流蜜与奶油之河，他不得再见。"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 18,
    "text": "他劳碌得来的要赔还，不得吞下；要照他所得的财货赔还，不得享其中之乐。"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 19,
    "text": "因他欺压穷人，且又离弃；因他强取非自己所盖的房屋。"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 20,
    "text": "他必是贪而无厌，所喜悦的连一样也不能保守。"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 21,
    "text": "他的食物必没有剩下的，所以无一人向他求好处。"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 22,
    "text": "他在满足有余的时候，必到狭窄的地步；凡恶人都必加手在他身上。"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 23,
    "text": "他正要充满肚腹的时候，　上帝必将猛烈的忿怒降在他身上；正在他吃饭的时候，要将这忿怒像雨降在他身上。"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 24,
    "text": "他要躲避铁器；钢弓的箭要将他射透。"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 25,
    "text": "他拔刀出鞘，刀就从身上出来；发光的刀从他胆中出来，有惊惶临在他身上。"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 26,
    "text": "一切黑喑必藏在他的隐密处，人所不吹的火要把他烧灭；他帐棚中所剩下的必与他一同遭灾。"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 27,
    "text": "天要显明他的罪孽；地要兴起攻击他。"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 28,
    "text": "他的家产必然过去；　上帝发怒的日子，他的货物都被冲去。"
  },
  {
    "bookId": 18,
    "chapterId": 20,
    "verseId": 29,
    "text": "这是恶人从　上帝所得的分，是　上帝为他所定的产业。"
  }
]
