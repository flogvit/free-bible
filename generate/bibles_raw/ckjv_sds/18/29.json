[
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 1,
    "text": "约伯又接着用比喻说："
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 2,
    "text": "唯愿我的景况如从前的月份，如　上帝保守我的日子。"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 3,
    "text": "那时他的烛照在我头上；我藉他的光行过黑暗。"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 4,
    "text": "我愿如幼年的时候：那时我在帐棚中，　上帝待我有密友之情；"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 5,
    "text": "那时　全能者仍与我同在，那时我的儿女都环绕我；"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 6,
    "text": "那时我用奶油洗我的脚，磐石为我出油成河；"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 7,
    "text": "那时我出去经过城门，在街上设立自己座位！"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 8,
    "text": "少年人见我而回避，老年人也起身站立；"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 9,
    "text": "王子都停止说话，用手摀口；"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 10,
    "text": "首领静默无声，舌头贴住上膛。"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 11,
    "text": "耳朵听我的，就称我有福；眼睛看我的，都给我作证；"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 12,
    "text": "因我拯救哀求的困苦人、无人帮助的和无父的。"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 13,
    "text": "将要灭亡的祝福临到我；我也使寡妇心中欢乐。"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 14,
    "text": "我以公义为衣服，以公平为外袍和冠冕。"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 15,
    "text": "我为瞎子的眼，瘸子的脚。"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 16,
    "text": "我为穷乏人的父；素不认识的人，我查明他的案件。"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 17,
    "text": "我打破恶人的腮颊，从他牙齿中夺了所抢的。"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 18,
    "text": "我便说：我必死在家中，必增添我的日子，多如尘沙。"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 19,
    "text": "我的根长到水边；露水终夜沾在我的枝上。"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 20,
    "text": "我的荣耀在身上增新；我的弓在手中日强。"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 21,
    "text": "人听见我而仰望，静默等候我的指教。"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 22,
    "text": "我说话之后，他们就不再说；我的言语像雨露滴在他们身上。"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 23,
    "text": "他们仰望我如仰望雨，又张开口如切慕春雨。"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 24,
    "text": "我若向他们含笑，他们不敢相信；他们不使我脸上的光改变。"
  },
  {
    "bookId": 18,
    "chapterId": 29,
    "verseId": 25,
    "text": "我为他们选择道路，又坐首位；我如君王在军队中居住，又如吊丧的安慰伤心的人。"
  }
]
