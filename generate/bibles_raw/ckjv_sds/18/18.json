[
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 1,
    "text": "书亚人比勒达回答说："
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 2,
    "text": "你们言语要到几时穷尽呢？你可以注意究察，然后我们就说话。"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 3,
    "text": "我们为何算为畜生，在你眼中看作卑贱呢？"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 4,
    "text": "他在怒中将自己撕裂；难道大地为你见弃？磐石挪开原处吗？"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 5,
    "text": "恶人的亮光必要熄灭；他的火花必不照耀。"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 6,
    "text": "他帐棚中的亮光要变为黑暗；他的烛与他也必熄灭。"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 7,
    "text": "他坚强的脚步必见狭窄；自己的计谋必将他绊倒。"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 8,
    "text": "因为他被自己的脚陷入网中，走在网罗上。"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 9,
    "text": "圈套必抓住他的脚跟；强盗必胜过他。"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 10,
    "text": "网罗为他设在土内；羁绊为他藏在路上。"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 11,
    "text": "四面的惊吓要使他害怕，并且追赶他的脚跟。"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 12,
    "text": "他的力量必因饥饿衰败；毁灭要在他旁边等候。"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 13,
    "text": "他皮肤的力量要被吞吃；死亡的长子要吞吃他的力量。"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 14,
    "text": "他所倚靠的要从他帐棚拔出来，它必把他带到惊吓的王那里。"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 15,
    "text": "既没一样属他的，它就住在他的帐棚里；硫磺必撒在他所住之处。"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 16,
    "text": "下边，他的根本要枯干；上边，他的枝子要剪除。"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 17,
    "text": "他的记念在地上必然灭亡；他的名字在街上也不存留。"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 18,
    "text": "他必从光明中被撵到黑暗里，必被赶出世界。"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 19,
    "text": "在本民中必无子无孙；在他的住处也无一人存留。"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 20,
    "text": "在他以后来的要惊奇他的日子，好像以前去的受了惊骇。"
  },
  {
    "bookId": 18,
    "chapterId": 18,
    "verseId": 21,
    "text": "恶人的住处总是这样；此乃不认识　上帝之人的地步。"
  }
]
