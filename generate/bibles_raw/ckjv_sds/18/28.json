[
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 1,
    "text": "银子有矿；炼金有方。"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 2,
    "text": "铁从地里挖出；铜从石中镕化。"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 3,
    "text": "他为黑暗定界限，查究幽暗阴翳的石头和死荫，直到极处，"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 4,
    "text": "洪水从居住之处发出，过路的人也想不到众水；它们干涸，与人远离。"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 5,
    "text": "至于地，能出粮食，地内好像被火翻起来。"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 6,
    "text": "地中的石头有蓝宝石，并有金沙。"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 7,
    "text": "有一条路鸷鸟不得知道；鹰眼也未见过。"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 8,
    "text": "幼年的狮子未曾行过；猛烈的狮子也未曾经过。"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 9,
    "text": "人伸手凿开坚石，倾倒山根，"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 10,
    "text": "在磐石中凿出水道，亲眼看见各样宝物。"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 11,
    "text": "他封闭水不得滴流，使隐藏的物显露出来。"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 12,
    "text": "然而，智慧有何处可寻？聪明之处在哪里呢？"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 13,
    "text": "智慧的价值无人能知，在活人之地也无处可寻。"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 14,
    "text": "深渊说：不在我内；沧海说：不在我中。"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 15,
    "text": "智慧非用黄金可得，也不能平白银为它的价值。"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 16,
    "text": "俄斐金和贵重的红玛瑙，并蓝宝石，不足与较量；"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 17,
    "text": "黄金和水晶不足与比较；精金的器皿不足与兑换。"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 18,
    "text": "珊瑚、珍珠都不足论；智慧的价值胜过红宝石。"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 19,
    "text": "埃塞俄比亚的黄宝石不足与比较；纯金也不足与较量。"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 20,
    "text": "智慧从何处来呢？聪明之处在哪里呢？"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 21,
    "text": "是向一切有生命的眼目隐藏，向空中的飞鸟掩蔽。"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 22,
    "text": "灭没和死亡说：我们风闻其名。"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 23,
    "text": "上帝明白智慧的道路，晓得智慧的所在。"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 24,
    "text": "因他鉴察直到地极，遍观普天之下，"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 25,
    "text": "要为风定轻重，又度量诸水；"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 26,
    "text": "他为雨露定命令，为雷电定道路。"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 27,
    "text": "那时他看见智慧，而且述说；他坚定，并且查究。"
  },
  {
    "bookId": 18,
    "chapterId": 28,
    "verseId": 28,
    "text": "他对人说：看哪，敬畏　主就是智慧；远离恶便是聪明。"
  }
]
