[
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 1,
    "text": "约伯回答说："
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 2,
    "text": "我真知道是这样；但人在　上帝面前怎能成为义呢？"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 3,
    "text": "若愿意与他争辩，千中之一也不能回答。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 4,
    "text": "他心里有智慧，且大有能力。谁向　上帝刚硬而得亨通呢？"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 5,
    "text": "他发怒，把山翻倒挪移，山并不知觉。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 6,
    "text": "他使地震动，离其本位，地的柱子就摇撼。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 7,
    "text": "他吩咐日头不出来，就不出来，又封闭众星。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 8,
    "text": "他独自铺张诸天，踏在海浪之上。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 9,
    "text": "他造北斗、参星、昴星，并南方的密宫；"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 10,
    "text": "他行大事，不可测度，行奇事，不可胜数。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 11,
    "text": "他从我旁边经过，我却不看见；他在我面前行走，我倒不知觉。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 12,
    "text": "看哪，他取去，谁能阻挡？谁敢问他：你作什么？"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 13,
    "text": "若　上帝不收回他的怒气，扶助骄傲人的必屈身在他以下。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 14,
    "text": "既是这样，我怎敢回答他，怎敢选择言语与他辩论呢？"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 15,
    "text": "我虽有义，也不回答他，只要向那审判我的恳求。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 16,
    "text": "我若呼求，他应允我；我仍不信他真听我的声音。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 17,
    "text": "他用暴风折断我，无故地加增我的损伤。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 18,
    "text": "我就是喘一口气，他都不容，倒使我满心苦恼。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 19,
    "text": "若论力量，看哪，他真有能力！若论审判，谁为我定期，让我辩白呢？"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 20,
    "text": "我若自义，自己的口要定我为有罪；我若说我完全，我口必显我为弯曲。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 21,
    "text": "我虽完全，仍不知道自己的心；我轻贱我的性命。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 22,
    "text": "善恶无分，都是一样；所以我说，完全人和恶人，他都灭绝。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 23,
    "text": "若忽然遭杀害之祸，他必戏笑无辜的人遇难。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 24,
    "text": "世界交在恶人手中；蒙蔽世界审判官的脸，若不是他，是谁呢？他在哪里呢？"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 25,
    "text": "我的日子比跑信的更快，急速逃去，不见福乐。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 26,
    "text": "我的日子过去如快船，如急落抓食的鹰。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 27,
    "text": "我若说：我要忘记我的哀情，除去我的愁苦，安慰自己；"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 28,
    "text": "我因愁苦而惧怕，知道你必不以我为无辜。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 29,
    "text": "我若被定为恶人，我何必徒然劳苦呢？"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 30,
    "text": "我若用雪水洗身，使我的手未曾如此洁净，"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 31,
    "text": "你还要扔我在阱里，我的衣服都憎恶我。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 32,
    "text": "他本不像我是人，使我可以回答他，又使我们可以同听审判。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 33,
    "text": "我们中间没有听讼的人可以向我们两造按手。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 34,
    "text": "愿他把杖离开我，不使惊惶威吓我。"
  },
  {
    "bookId": 18,
    "chapterId": 9,
    "verseId": 35,
    "text": "我就说话，也不惧怕他，现在我却不是那样。"
  }
]
