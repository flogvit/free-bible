[
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 1,
    "text": "约伯回答说："
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 2,
    "text": "唯愿我的烦恼称一称，将我的灾害一起放在天平里！"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 3,
    "text": "现今都比海沙更重，所以我的言语被吞灭。"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 4,
    "text": "因　全能者的箭射入我身；其毒，我的灵喝尽了；　上帝的惊吓摆阵攻击我。"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 5,
    "text": "野驴有草岂能叫唤？牛有料岂能吼叫？"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 6,
    "text": "物淡而无盐岂可吃吗？蛋青有什么滋味呢？"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 7,
    "text": "看为可厌的食物，我心不肯挨近。"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 8,
    "text": "唯愿我得着所求的，愿　上帝赐我所切望的！"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 9,
    "text": "就是愿　上帝把我压碎，伸手将我剪除！"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 10,
    "text": "我因没有隐藏那　圣者的言语，就仍以此为安慰，在疼痛中还可忍受。"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 11,
    "text": "我有什么气力使我盼望？我有什么结局使我延长年日？"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 12,
    "text": "我的气力岂是石头的气力？我的肉身岂是铜的呢？"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 13,
    "text": "在我岂不是毫无帮助吗？智慧岂不是从我心中赶出净尽吗？"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 14,
    "text": "那受苦的人，他的朋友当以怜恤待他；唯离弃、不敬畏　全能者的，不该待他如此。"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 15,
    "text": "我的弟兄诡诈，好像溪水，又像溪水随流而去。"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 16,
    "text": "这河因结冰发黑，有雪藏在其中；"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 17,
    "text": "天气渐暖就随时消化，日头炎热便从原处干涸。"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 18,
    "text": "他们的路偏离，到荒野之地死亡。"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 19,
    "text": "提玛结伴的客旅瞻望；示巴同伙的人等候。"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 20,
    "text": "他们因失了盼望就抱愧，来到那里便蒙羞。"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 21,
    "text": "现在你们正是这样，看见我潦倒便惧怕。"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 22,
    "text": "我岂说：请你们供给我，从你们的财物中送礼物给我？"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 23,
    "text": "岂说：拯救我脱离敌人的手吗？救赎我脱离强暴人的手吗？"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 24,
    "text": "请你们教导我，我便不作声；使我明白在何事上有错。"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 25,
    "text": "正确的言语力量何其大！但你们责备是责备什么呢？"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 26,
    "text": "绝望人的讲论既然如风，你们还想要驳正言语吗？"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 27,
    "text": "你们想欺压无父的，为朋友挖坑。"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 28,
    "text": "现在请你们看看我，我若说谎，你们必以为明显。"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 29,
    "text": "请你们转意，不要以此为罪孽；请再转意，我在其中有理。"
  },
  {
    "bookId": 18,
    "chapterId": 6,
    "verseId": 30,
    "text": "我的舌上岂有不义吗？我的口里岂不辨奸恶吗？"
  }
]
