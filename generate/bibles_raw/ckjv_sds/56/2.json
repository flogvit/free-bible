[
  {
    "bookId": 56,
    "chapterId": 2,
    "verseId": 1,
    "text": "但你所讲的总要合乎那纯正的道理。"
  },
  {
    "bookId": 56,
    "chapterId": 2,
    "verseId": 2,
    "text": "劝老年人要有节制、端庄、自守，在信心、爱心、忍耐上都要纯全无疵。"
  },
  {
    "bookId": 56,
    "chapterId": 2,
    "verseId": 3,
    "text": "又劝老年妇人，行为要合乎圣善，不诬赖人，不好喝酒，用善道教训人，"
  },
  {
    "bookId": 56,
    "chapterId": 2,
    "verseId": 4,
    "text": "好指教少年妇人节制，爱丈夫，爱儿女，"
  },
  {
    "bookId": 56,
    "chapterId": 2,
    "verseId": 5,
    "text": "谨守，贞洁，料理家务，待人有恩，顺服自己的丈夫，免得　上帝的道理被亵渎。"
  },
  {
    "bookId": 56,
    "chapterId": 2,
    "verseId": 6,
    "text": "又劝少年人要谨守。"
  },
  {
    "bookId": 56,
    "chapterId": 2,
    "verseId": 7,
    "text": "你自己凡事要显出善行的榜样；在道理上要正直、端庄、真诚。"
  },
  {
    "bookId": 56,
    "chapterId": 2,
    "verseId": 8,
    "text": "言语纯全，无可指责，叫那反对的人，既无处可说你们的不是，便自觉羞愧。"
  },
  {
    "bookId": 56,
    "chapterId": 2,
    "verseId": 9,
    "text": "劝仆人要顺服自己的主人，凡事讨他的喜欢，不可顶撞他，"
  },
  {
    "bookId": 56,
    "chapterId": 2,
    "verseId": 10,
    "text": "不可私拿东西；要显为忠诚，以致凡事尊荣我们　救主　上帝的道。"
  },
  {
    "bookId": 56,
    "chapterId": 2,
    "verseId": 11,
    "text": "因为　上帝救众人的恩典已经显明予众人，"
  },
  {
    "bookId": 56,
    "chapterId": 2,
    "verseId": 12,
    "text": "教训我们除去不敬虔的心和世俗的情欲，在今世自守、公义、敬虔度日，"
  },
  {
    "bookId": 56,
    "chapterId": 2,
    "verseId": 13,
    "text": "等候那有福的盼望，并等候至大的　上帝和我们　救主耶稣　基督的荣耀显现。"
  },
  {
    "bookId": 56,
    "chapterId": 2,
    "verseId": 14,
    "text": "他为我们舍了自己，要赎我们脱离一切罪恶，又洁净我们，特作自己的子民，热心为善。"
  },
  {
    "bookId": 56,
    "chapterId": 2,
    "verseId": 15,
    "text": "这些事你要讲明，劝戒人，用各等权柄责备人；不可叫人轻看你。"
  }
]
