[
  {
    "bookId": 13,
    "chapterId": 14,
    "verseId": 1,
    "text": "推罗王希兰将香柏木运到大卫那里，又差遣使者和石匠、木匠给大卫建造宫殿。"
  },
  {
    "bookId": 13,
    "chapterId": 14,
    "verseId": 2,
    "text": "大卫就知道　耶和华坚立他作以色列王，又为自己的民以色列，使他的囯兴旺。"
  },
  {
    "bookId": 13,
    "chapterId": 14,
    "verseId": 3,
    "text": "大卫在耶路撒冷又立后妃，又生儿女。"
  },
  {
    "bookId": 13,
    "chapterId": 14,
    "verseId": 4,
    "text": "在耶路撒冷所生的众子是沙母亚、朔罢、拿单、所罗门、"
  },
  {
    "bookId": 13,
    "chapterId": 14,
    "verseId": 5,
    "text": "益辖、以利书亚、以法列、"
  },
  {
    "bookId": 13,
    "chapterId": 14,
    "verseId": 6,
    "text": "挪迦、尼斐、雅非亚、"
  },
  {
    "bookId": 13,
    "chapterId": 14,
    "verseId": 7,
    "text": "以利沙玛、比利雅大、以利法列。"
  },
  {
    "bookId": 13,
    "chapterId": 14,
    "verseId": 8,
    "text": "非利士人听见大卫受膏作以色列众人的王，非利士众人就上来寻索大卫。大卫听见，就出去迎敌。"
  },
  {
    "bookId": 13,
    "chapterId": 14,
    "verseId": 9,
    "text": "非利士人来了，布散在利乏音谷。"
  },
  {
    "bookId": 13,
    "chapterId": 14,
    "verseId": 10,
    "text": "大卫求问　上帝，说：「我可以上去攻打非利士人吗？你将他们交在我手里吗？」　耶和华说：「你可以上去，我必将他们交在你手里。」"
  },
  {
    "bookId": 13,
    "chapterId": 14,
    "verseId": 11,
    "text": "非利士人来到巴力・毗拉心，大卫在那里杀败他们。大卫说：「　上帝藉我的手冲破敌人，如同水冲去一般」；因此称那地方为巴力・毗拉心。"
  },
  {
    "bookId": 13,
    "chapterId": 14,
    "verseId": 12,
    "text": "非利士人将神像撇在那里，大卫吩咐人用火焚烧了。"
  },
  {
    "bookId": 13,
    "chapterId": 14,
    "verseId": 13,
    "text": "非利士人又布散在利乏音谷。"
  },
  {
    "bookId": 13,
    "chapterId": 14,
    "verseId": 14,
    "text": "大卫又求问　上帝。　上帝说：「不要一直地上去，要转到他们后头，从桑林对面攻打他们。"
  },
  {
    "bookId": 13,
    "chapterId": 14,
    "verseId": 15,
    "text": "你听见桑树梢上有脚步的声音，就要出战，因为　上帝已经在你前头去攻打非利士人的军队。」"
  },
  {
    "bookId": 13,
    "chapterId": 14,
    "verseId": 16,
    "text": "大卫就遵着　上帝所吩咐的，攻打非利士人的军队，从基遍直到基色。"
  },
  {
    "bookId": 13,
    "chapterId": 14,
    "verseId": 17,
    "text": "于是大卫的名传扬到列国，　耶和华使列国都惧怕他。"
  }
]
