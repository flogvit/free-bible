[
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 1,
    "text": "便雅悯的长子比拉，次子亚实别，三子亚哈拉，"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 2,
    "text": "四子挪哈，五子拉法。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 3,
    "text": "比拉的儿子是亚大、基拉、亚比忽、"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 4,
    "text": "亚比书、乃幔、亚何亚、"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 5,
    "text": "基拉、示孚汛、户兰。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 6,
    "text": "以忽的儿子作迦巴居民的族长，被迁移到玛拿辖；"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 7,
    "text": "乃幔、亚希亚、基拉也被迁移。基拉生乌撒、亚希忽。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 8,
    "text": "沙哈连休他二妻户伸和巴拉之后，在摩押地生儿养女。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 9,
    "text": "他从他的妻贺得生了约巴、洗比雅、米沙、玛拉干、"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 10,
    "text": "耶乌斯、沙迦、米玛。他这些儿子都是族长。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 11,
    "text": "他的妻户伸给他生的儿子有亚比突、以利巴力。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 12,
    "text": "以利巴力的儿子是希伯、米珊、沙麦。沙麦建立阿挪和罗德二城与其村庄。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 13,
    "text": "又有比利亚和示玛是亚雅仑居民的族长，是驱逐迦特人的。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 14,
    "text": "亚希约、沙煞、耶利末、"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 15,
    "text": "西巴第雅、亚拉得、亚得、"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 16,
    "text": "米迦勒、伊施巴、约哈都是比利亚的儿子。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 17,
    "text": "西巴第雅、米书兰、希西基、希伯、"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 18,
    "text": "伊施米莱、伊斯利亚、约巴都是以利巴力的儿子。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 19,
    "text": "雅金、细基利、撒底、"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 20,
    "text": "以利乃、洗勒太、以列、"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 21,
    "text": "亚大雅、比拉雅、申拉都是示每的儿子。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 22,
    "text": "伊施班、希伯、以列、"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 23,
    "text": "亚伯顿、细基利、哈难、"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 24,
    "text": "哈拿尼雅、以拦、安陀提雅、"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 25,
    "text": "伊弗底雅、毗努伊勒都是沙煞的儿子。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 26,
    "text": "珊示莱、示哈利、亚她利雅、"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 27,
    "text": "雅利西、以利亚、细基利都是耶罗罕的儿子。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 28,
    "text": "这些人都是按他们宗族作族长，为首领。这些人都住在耶路撒冷。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 29,
    "text": "在基遍住的有基遍的父亲耶利。他的妻名叫玛迦；"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 30,
    "text": "他长子是亚伯顿。他又生苏珥、基士、巴力、拿答、"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 31,
    "text": "基多、亚希约、撒迦、米基罗。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 32,
    "text": "米基罗生示米暗。这些人和他们的弟兄在耶路撒冷对面居住。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 33,
    "text": "尼珥生基士；基士生扫罗；扫罗生约拿单、麦基・舒亚、亚比拿达、伊施・巴力。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 34,
    "text": "约拿单的儿子是米非・波设、米非・波设生米迦。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 35,
    "text": "米迦的儿子是毗敦、米勒、他利亚、亚哈斯；"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 36,
    "text": "亚哈斯生耶何阿达；耶何阿达生亚拉篾、亚斯玛威、心利；心利生摩撒；"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 37,
    "text": "摩撒生比尼亚；比尼亚的儿子是拉法；拉法的儿子是以利亚萨；以利亚萨的儿子是亚悉。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 38,
    "text": "亚悉有六个儿子，他们的名字是亚斯利干、波基路、以实玛利、示亚利雅、俄巴底雅、哈难。这都是亚悉的儿子。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 39,
    "text": "亚悉兄弟以设的长子是乌兰，次子耶乌施，三子是以利法列。"
  },
  {
    "bookId": 13,
    "chapterId": 8,
    "verseId": 40,
    "text": "乌兰的儿子都是大能的勇士，是弓箭手，他们有许多的子孙，共一百五十名，都是便雅悯人。"
  }
]
