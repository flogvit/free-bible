[
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 1,
    "text": "ترنيمة المصاعد‎. ‎كثيرا ما ضايقوني منذ شبابي ليقل اسرائيل"
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 2,
    "text": "كثيرا ما ضايقوني منذ شبابي. لكن لم يقدروا عليّ‎."
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 3,
    "text": "‎على ظهري حرث الحرّاث. طوّلوا اتلامهم‎."
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 4,
    "text": "‎الرب صديق. قطع ربط الاشرار‎."
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 5,
    "text": "‎فليخز وليرتد الى الوراء كل مبغضي صهيون‎."
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 6,
    "text": "‎ليكونوا كعشب السطوح الذي ييبس قبل ان يقلع‎."
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 7,
    "text": "‎الذي لا يملأ الحاصد كفه منه ولا المحزم حضنه‎."
  },
  {
    "bookId": 19,
    "chapterId": 129,
    "verseId": 8,
    "text": "‎ولا يقول العابرون بركة الرب عليكم. باركناكم باسم الرب"
  }
]
