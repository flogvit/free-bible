[
  {
    "bookId": 19,
    "chapterId": 122,
    "verseId": 1,
    "text": "ترنيمة المصاعد. لداود‎. ‎فرحت بالقائلين لي الى بيت الرب نذهب‎."
  },
  {
    "bookId": 19,
    "chapterId": 122,
    "verseId": 2,
    "text": "‎تقف ارجلنا في ابوابك يا اورشليم‎."
  },
  {
    "bookId": 19,
    "chapterId": 122,
    "verseId": 3,
    "text": "‎اورشليم المبنية كمدينة متصلة كلها"
  },
  {
    "bookId": 19,
    "chapterId": 122,
    "verseId": 4,
    "text": "حيث صعدت الاسباط اسباط الرب شهادة لاسرائيل ليحمدوا اسم الرب."
  },
  {
    "bookId": 19,
    "chapterId": 122,
    "verseId": 5,
    "text": "لانه هناك استوت الكراسي للقضاء كراسي بيت داود‎."
  },
  {
    "bookId": 19,
    "chapterId": 122,
    "verseId": 6,
    "text": "‎اسالوا سلامة اورشليم. ليسترح محبوك‎."
  },
  {
    "bookId": 19,
    "chapterId": 122,
    "verseId": 7,
    "text": "‎ليكن سلام في ابراجك راحة في قصورك‎."
  },
  {
    "bookId": 19,
    "chapterId": 122,
    "verseId": 8,
    "text": "‎من اجل اخوتي واصحابي لاقولنّ سلام بك‎."
  },
  {
    "bookId": 19,
    "chapterId": 122,
    "verseId": 9,
    "text": "‎من اجل بيت الرب الهنا التمس لك خيرا"
  }
]
