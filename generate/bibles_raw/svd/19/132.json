[
  {
    "bookId": 19,
    "chapterId": 132,
    "verseId": 1,
    "text": "ترنيمة المصاعد‎. ‎اذكر يا رب داود كل ذله‎."
  },
  {
    "bookId": 19,
    "chapterId": 132,
    "verseId": 2,
    "text": "‎كيف حلف للرب نذر لعزيز يعقوب"
  },
  {
    "bookId": 19,
    "chapterId": 132,
    "verseId": 3,
    "text": "لا ادخل خيمة بيتي لا اصعد على سرير فراشي"
  },
  {
    "bookId": 19,
    "chapterId": 132,
    "verseId": 4,
    "text": "لا اعطي وسنا لعينيّ ولا نوما لاجفاني"
  },
  {
    "bookId": 19,
    "chapterId": 132,
    "verseId": 5,
    "text": "او اجد مقاما للرب مسكنا لعزيز يعقوب‎."
  },
  {
    "bookId": 19,
    "chapterId": 132,
    "verseId": 6,
    "text": "‎هوذا قد سمعنا به في افراتة. وجدناه في حقول الوعر‎."
  },
  {
    "bookId": 19,
    "chapterId": 132,
    "verseId": 7,
    "text": "‎لندخل الى مساكنه. لنسجد عند موطئ قدميه"
  },
  {
    "bookId": 19,
    "chapterId": 132,
    "verseId": 8,
    "text": "قم يا رب الى راحتك انت وتابوت عزك‎."
  },
  {
    "bookId": 19,
    "chapterId": 132,
    "verseId": 9,
    "text": "‎كهنتك يلبسون البر واتقياؤك يهتفون‎."
  },
  {
    "bookId": 19,
    "chapterId": 132,
    "verseId": 10,
    "text": "‎من اجل داود عبدك لا ترد وجه مسيحك‎."
  },
  {
    "bookId": 19,
    "chapterId": 132,
    "verseId": 11,
    "text": "‎اقسم الرب لداود بالحق لا يرجع عنه. من ثمرة بطنك اجعل على كرسيك‎."
  },
  {
    "bookId": 19,
    "chapterId": 132,
    "verseId": 12,
    "text": "‎ان حفظ بنوك عهدي وشهاداتي التي اعلمهم اياها فبنوهم ايضا الى الابد يجلسون على كرسيك‎."
  },
  {
    "bookId": 19,
    "chapterId": 132,
    "verseId": 13,
    "text": "‎لان الرب قد اختار صهيون اشتهاها مسكنا له‎."
  },
  {
    "bookId": 19,
    "chapterId": 132,
    "verseId": 14,
    "text": "‎هذه هي راحتي الى الابد ههنا اسكن لاني اشتهيتها‎."
  },
  {
    "bookId": 19,
    "chapterId": 132,
    "verseId": 15,
    "text": "‎طعامها ابارك بركة مساكينها اشبع خبزا‎."
  },
  {
    "bookId": 19,
    "chapterId": 132,
    "verseId": 16,
    "text": "‎كهنتها البس خلاصا واتقياؤها يهتفون هتافا‎."
  },
  {
    "bookId": 19,
    "chapterId": 132,
    "verseId": 17,
    "text": "‎هناك انبت قرنا لداود. رتبت سراجا لمسيحي‎."
  },
  {
    "bookId": 19,
    "chapterId": 132,
    "verseId": 18,
    "text": "‎اعداءه البس خزيا وعليه يزهر اكليله"
  }
]
