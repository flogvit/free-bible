[
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 1,
    "text": "احببت لان الرب يسمع صوتي تضرعاتي‎."
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 2,
    "text": "‎لانه امال اذنه اليّ. فادعوه مدة حياتي‎."
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 3,
    "text": "‎اكتنفتني حبال الموت اصابتني شدائد الهاوية. كابدت ضيقا وحزنا."
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 4,
    "text": "وباسم الرب دعوت آه يا رب نج نفسي‎."
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 5,
    "text": "‎الرب حنّان وصديق والهنا رحيم‎."
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 6,
    "text": "‎الرب حافظ البسطاء. تذللت فخلصني‎."
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 7,
    "text": "‎ارجعي يا نفسي الى راحتك لان الرب قد احسن اليك‎."
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 8,
    "text": "‎لانك انقذت نفسي من الموت وعيني من الدمعة ورجلي من الزلق‎."
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 9,
    "text": "‎اسلك قدام الرب في ارض الاحياء"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 10,
    "text": "آمنت لذلك تكلمت. انا تذللت جدا‎."
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 11,
    "text": "‎انا قلت في حيرتي كل انسان كاذب‎."
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 12,
    "text": "‎ماذا ارد للرب من اجل كل حسناته لي‎."
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 13,
    "text": "‎كاس الخلاص اتناول وباسم الرب ادعو‎."
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 14,
    "text": "‎اوفي نذوري للرب مقابل كل شعبه"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 15,
    "text": "عزيز في عيني الرب موت اتقيائه‎."
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 16,
    "text": "‎آه يا رب. لاني عبدك. انا عبدك ابن امتك. حللت قيودي‎."
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 17,
    "text": "‎فلك اذبح ذبيحة حمد وباسم الرب ادعو‏‎."
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 18,
    "text": "‎اوفي نذوري للرب مقابل شعبه"
  },
  {
    "bookId": 19,
    "chapterId": 116,
    "verseId": 19,
    "text": "في ديار بيت الرب في وسطك يا اورشليم. هللويا"
  }
]
