[
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 1,
    "text": "تسبيحة. مزمور لآساف‎. ‎اللهم لا تصمت لا تسكت ولا تهدأ يا الله‎."
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 2,
    "text": "‎فهوذا اعداؤك يعجون ومبغضوك قد رفعوا الراس‎."
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 3,
    "text": "‎على شعبك مكروا مؤامرة وتشاوروا على أحميائك‎."
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 4,
    "text": "‎قالوا هلم نبدهم من بين الشعوب ولا يذكر اسم اسرائيل بعد"
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 5,
    "text": "لانهم تآمروا بالقلب معا. عليك تعاهدوا عهدا‎."
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 6,
    "text": "‎خيام ادوم والاسمعيليين . موآب والهاجريون‎."
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 7,
    "text": "‎جبال وعمون وعماليق. فلسطين مع سكان صور‎."
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 8,
    "text": "‎اشور ايضا اتفق معهم. صاروا ذراعا لبني لوط. سلاه‎."
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 9,
    "text": "‎افعل بهم كما بمديان كما بسيسرا كما بيابين في وادي قيشون‎."
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 10,
    "text": "‎بادوا في عين دور. صاروا دمنا للارض‎."
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 11,
    "text": "‎اجعلهم شرفاءهم مثل غراب ومثل ذئب. ومثل زبح ومثل صلمناع كل امرائهم‎."
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 12,
    "text": "‎الذين قالوا لنمتلك لانفسنا مساكن الله"
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 13,
    "text": "يا الهي اجعلهم مثل الجل مثل القش امام الريح‎."
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 14,
    "text": "‎كنار تحرق الوعر كلهيب يشعل الجبال"
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 15,
    "text": "هكذا اطردهم بعاصفتك وبزوبعتك روعهم‎."
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 16,
    "text": "‎املأ وجوههم خزيا فيطلبوا اسمك يا رب‎."
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 17,
    "text": "‎ليخزوا ويرتاعوا الى الابد وليخجلوا ويبيدوا"
  },
  {
    "bookId": 19,
    "chapterId": 83,
    "verseId": 18,
    "text": "ويعلموا انك اسمك يهوه وحدك العلي على كل الارض"
  }
]
