[
  {
    "bookId": 19,
    "chapterId": 98,
    "verseId": 1,
    "text": "مزمور‎. ‎رنموا للرب ترنيمة جديدة لانه صنع عجائب. خلصته يمينه وذراع قدسه‎."
  },
  {
    "bookId": 19,
    "chapterId": 98,
    "verseId": 2,
    "text": "‎اعلن الرب خلاصه. لعيون الامم كشف بره‎."
  },
  {
    "bookId": 19,
    "chapterId": 98,
    "verseId": 3,
    "text": "‎ذكر رحمته وامانته لبيت اسرائيل. رأت كل اقاصي الارض خلاص الهنا"
  },
  {
    "bookId": 19,
    "chapterId": 98,
    "verseId": 4,
    "text": "اهتفي للرب يا كل الارض اهتفوا ورنموا وغنوا‎."
  },
  {
    "bookId": 19,
    "chapterId": 98,
    "verseId": 5,
    "text": "‎رنموا للرب بعود. بعود وصوت نشيد"
  },
  {
    "bookId": 19,
    "chapterId": 98,
    "verseId": 6,
    "text": "بالابواق وصوت الصور اهتفوا قدام الملك الرب‎."
  },
  {
    "bookId": 19,
    "chapterId": 98,
    "verseId": 7,
    "text": "‎ليعج البحر وملؤه المسكونة والساكنون فيها‎."
  },
  {
    "bookId": 19,
    "chapterId": 98,
    "verseId": 8,
    "text": "‎الانهار لتصفق بالايادي الجبال لترنم معا"
  },
  {
    "bookId": 19,
    "chapterId": 98,
    "verseId": 9,
    "text": "امام الرب لانه جاء ليدين الارض. يدين المسكونة بالعدل والشعوب بالاستقامة"
  }
]
