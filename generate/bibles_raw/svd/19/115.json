[
  {
    "bookId": 19,
    "chapterId": 115,
    "verseId": 1,
    "text": "ليس لنا يا رب ليس لنا لكن لاسمك اعط مجدا من اجل رحمتك من اجل امانتك‎."
  },
  {
    "bookId": 19,
    "chapterId": 115,
    "verseId": 2,
    "text": "‎لماذا يقول الامم اين هو الههم‎."
  },
  {
    "bookId": 19,
    "chapterId": 115,
    "verseId": 3,
    "text": "‎ان الهنا في السماء. كلما شاء صنع‎."
  },
  {
    "bookId": 19,
    "chapterId": 115,
    "verseId": 4,
    "text": "‎اصنامهم فضة وذهب عمل ايدي الناس‎."
  },
  {
    "bookId": 19,
    "chapterId": 115,
    "verseId": 5,
    "text": "‎لها افواه ولا تتكلم. لها اعين ولا تبصر‎."
  },
  {
    "bookId": 19,
    "chapterId": 115,
    "verseId": 6,
    "text": "‎لها آذان ولا تسمع. لها مناخر ولا تشم‎."
  },
  {
    "bookId": 19,
    "chapterId": 115,
    "verseId": 7,
    "text": "‎لها ايد ولا تلمس. لها ارجل ولا تمشي ولا تنطق بحناجرها‎."
  },
  {
    "bookId": 19,
    "chapterId": 115,
    "verseId": 8,
    "text": "‎مثلها يكون صانعوها بل كل من يتكل عليها"
  },
  {
    "bookId": 19,
    "chapterId": 115,
    "verseId": 9,
    "text": "يا اسرائيل اتكل على الرب. هو معينهم ومجنهم‎."
  },
  {
    "bookId": 19,
    "chapterId": 115,
    "verseId": 10,
    "text": "‎يا بيت هرون اتكلوا على الرب. هو معينهم ومجنهم‎."
  },
  {
    "bookId": 19,
    "chapterId": 115,
    "verseId": 11,
    "text": "‎يا متقي الرب اتكلوا على الرب. هو معينهم ومجنهم‎."
  },
  {
    "bookId": 19,
    "chapterId": 115,
    "verseId": 12,
    "text": "‎الرب قد ذكرنا فيبارك. يبارك بيت اسرائيل يبارك بيت هرون‎."
  },
  {
    "bookId": 19,
    "chapterId": 115,
    "verseId": 13,
    "text": "‎يبارك متقي الرب الصغار مع الكبار‎."
  },
  {
    "bookId": 19,
    "chapterId": 115,
    "verseId": 14,
    "text": "‎ليزد الرب عليكم. عليكم وعلى ابنائكم‎."
  },
  {
    "bookId": 19,
    "chapterId": 115,
    "verseId": 15,
    "text": "‎انتم مباركون للرب الصانع السموات والارض‎."
  },
  {
    "bookId": 19,
    "chapterId": 115,
    "verseId": 16,
    "text": "‎السموات سموات للرب. اما الارض فاعطاها لبني آدم‎."
  },
  {
    "bookId": 19,
    "chapterId": 115,
    "verseId": 17,
    "text": "‎ليس الاموات يسبحون الرب ولا من ينحدر الى ارض السكوت‎."
  },
  {
    "bookId": 19,
    "chapterId": 115,
    "verseId": 18,
    "text": "‎اما نحن فنبارك الرب من الآن والى الدهر. هللويا"
  }
]
