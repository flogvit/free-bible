[
  {
    "bookId": 19,
    "chapterId": 128,
    "verseId": 1,
    "text": "ترنيمة المصاعد‎. ‎طوبى لكل من يتقي الرب ويسلك في طرقه‎."
  },
  {
    "bookId": 19,
    "chapterId": 128,
    "verseId": 2,
    "text": "‎لانك تأكل تعب يديك. طوباك وخير لك‎."
  },
  {
    "bookId": 19,
    "chapterId": 128,
    "verseId": 3,
    "text": "‎امرأتك مثل كرمة مثمرة في جوانب بيتك. بنوك مثل غروس الزيتون حول مائدتك‎."
  },
  {
    "bookId": 19,
    "chapterId": 128,
    "verseId": 4,
    "text": "‎هكذا يبارك الرجل المتقي الرب‎."
  },
  {
    "bookId": 19,
    "chapterId": 128,
    "verseId": 5,
    "text": "‎يباركك الرب من صهيون وتبصر خير اورشليم كل ايام حياتك‎."
  },
  {
    "bookId": 19,
    "chapterId": 128,
    "verseId": 6,
    "text": "‎وترى بني بنيك. سلام على اسرائيل"
  }
]
