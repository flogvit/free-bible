[
  {
    "bookId": 19,
    "chapterId": 120,
    "verseId": 1,
    "text": "ترنيمة المصاعد‎. ‎الى الرب في ضيقي صرخت فاستجاب لي‎."
  },
  {
    "bookId": 19,
    "chapterId": 120,
    "verseId": 2,
    "text": "‎يا رب نج نفسي من شفاه الكذب من لسان غش‎."
  },
  {
    "bookId": 19,
    "chapterId": 120,
    "verseId": 3,
    "text": "‎ماذا يعطيك وماذا يزيد لك لسان الغش‎."
  },
  {
    "bookId": 19,
    "chapterId": 120,
    "verseId": 4,
    "text": "‎سهام جبار مسنونة مع جمر الرتم‎."
  },
  {
    "bookId": 19,
    "chapterId": 120,
    "verseId": 5,
    "text": "‎ويلي لغربتي في ماشك لسكني في خيام قيدار‎."
  },
  {
    "bookId": 19,
    "chapterId": 120,
    "verseId": 6,
    "text": "‎طال على نفسي سكنها مع مبغض السلام‎."
  },
  {
    "bookId": 19,
    "chapterId": 120,
    "verseId": 7,
    "text": "‎انا سلام وحينما اتكلم فهم للحرب"
  }
]
